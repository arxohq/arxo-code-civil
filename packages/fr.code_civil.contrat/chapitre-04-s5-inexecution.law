    label fr official "le dommage est une suite immédiate et directe de l'inexécution (article 1231-4)";
    label en unofficial "the harm is an immediate and direct consequence of the non-performance (Article 1231-4)";
}
pub relation clause_penale(cl: Clause, o: Obligation, m: Money) kind empirical {
