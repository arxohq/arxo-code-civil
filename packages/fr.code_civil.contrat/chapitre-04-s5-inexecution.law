// CHAPITRE IV, SECTION 5 — L'INEXÉCUTION DU CONTRAT (art. 1217 à 1231-7).
//
// Le cœur de la réforme. L'article 1217 ouvre une LISTE FERMÉE de cinq
// sanctions ; chacune a ensuite ses conditions propres, et le texte dit
// lui-même que celles qui ne sont pas incompatibles peuvent être cumulées et
// que des dommages et intérêts peuvent toujours s'y ajouter.
//
// LA LISTE EST GARDÉE PAR PAIRES. Écrire les cinq tirets en une disjonction
// `or` descendrait en règles `…/alt/N` dont le nom n'est pas stable : chaque
// tiret est donc une règle nommée, et le caractère fermé de la liste est
// éprouvé par un scénario « sanction hors liste → NEITHER ».
//
// LES POSITIONS SONT DES POSITIONS. Le droit de refuser d'exécuter (1219)
// est une LIBERTÉ — l'action est celle de son titulaire. Le pouvoir de
// résoudre le contrat par notification (1226) est un POUVOIR : il a un
// exercice nommé, une condition de validité et un effet juridique, et son
// effet est la résolution.
//
// LE TAUX LÉGAL N'EST PAS DANS LE CODE. Les articles 1231-6 et 1231-7 font
// courir l'intérêt « au taux légal » : ce taux est fixé hors du Code civil
// (Code monétaire et financier, article L. 313-2, arrêtés semestriels). Il est
// donc une entrée typée du cas. Le Code ne nomme pas non plus la méthode de
// décompte des jours : inventer ACT/365 remplacerait la norme par une
// convention — le paquet produit le point de départ et la créance d'intérêts,
// et déclare le calcul du montant comme frontière (README).

language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

use self::{
    CC_2016_ART1223,
    CC_ART1217,
    CC_ART1218,
    CC_ART1219,
    CC_ART1220,
    CC_ART1221,
    CC_ART1222,
    CC_ART1223,
    CC_ART1224,
    CC_ART1225,
    CC_ART1226,
    CC_ART1227,
    CC_ART1228,
    CC_ART1229,
    CC_ART1230,
    CC_ART1231,
    CC_ART1231_1,
    CC_ART1231_2,
    CC_ART1231_3,
    CC_ART1231_4,
    CC_ART1231_5,
    CC_ART1231_6,
    CC_ART1231_7,
    Clause,
    Contrat,
    Creance,
    Obligation,
    Personne,
    clause_du_contrat,
    creancier_de_l_obligation,
    debiteur_de_l_obligation,
    force_obligatoire,
    obligation_du_contrat,
    redaction_2016_applicable,
    redaction_2018_applicable,
    regi_par_le_droit_nouveau,
};

pub enum SanctionDeLInexecution {
    label fr official "Sanction ouverte au créancier de l'obligation inexécutée (article 1217)";
    label en unofficial "Remedy open to the creditor of the unperformed obligation (Article 1217)";
    RefusDExecuter,
    ExecutionForceeEnNature,
    ReductionDuPrix,
    Resolution,
    DommagesEtInterets
}

@source(CC_ART1231_1)
rule P3DevoirPayerLesDommages(o: Obligation, c: Contrat, creancier: Personne, debiteur: Personne, jour: Date) strict {
    label fr official "Articles 1231 et suivants. Le débiteur doit payer les dommages et intérêts dus au créancier";
    label en unofficial "Articles 1231 et seq. The debtor must pay the damages owed to the creditor";
    when dommages_et_interets_dus(o) and obligation_du_contrat(o, c)
        and creancier_de_l_obligation(o, creancier)
        and debiteur_de_l_obligation(o, debiteur)
        and mise_en_demeure_de_satisfaire_le(o, jour);
    then duty P3PositionDevoirPayerLesDommages {
        bearer debiteur;
        beneficiary creancier;
        goal achievement {
            condition dommages_et_interets_payes(o);
            window [jour, infinity];
        }
    };
}

@source(CC_ART1231_6)
rule P3DevoirPayerInteretsMoratoires(o: Obligation, c: Contrat, creancier: Personne, debiteur: Personne, jour: Date) strict {
    label fr official "Article 1231-6. Le débiteur doit payer les intérêts moratoires";
    label en unofficial "Article 1231-6. The debtor must pay default interest";
    when interets_moratoires_courent_depuis(o, jour) and obligation_du_contrat(o, c)
        and creancier_de_l_obligation(o, creancier)
        and debiteur_de_l_obligation(o, debiteur);
    then duty P3PositionDevoirPayerInteretsMoratoires {
        bearer debiteur;
        beneficiary creancier;
        goal achievement {
            condition interets_moratoires_payes(o);
            window [jour, infinity];
        }
    };
}

@source(CC_ART1231_7)
rule P3DevoirPayerInteretsCondamnation(c: Contrat, o: Obligation, creancier: Personne, debiteur: Personne, jour: Date) strict {
    label fr official "Article 1231-7. La condamnation à une indemnité emporte intérêts au taux légal";
    label en unofficial "Article 1231-7. An award of damages carries statutory interest";
    when interets_de_la_condamnation_courent_depuis(c, jour)
        and obligation_du_contrat(o, c)
        and creancier_de_l_obligation(o, creancier)
        and debiteur_de_l_obligation(o, debiteur);
    then duty P3PositionDevoirPayerInteretsCondamnation {
        bearer debiteur;
        beneficiary creancier;
        goal achievement {
            condition interets_de_condamnation_payes(c);
            window [jour, infinity];
        }
    };
}

