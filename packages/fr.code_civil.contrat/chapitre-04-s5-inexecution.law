pub relation engagement_non_execute(o: Obligation) kind empirical {
    label fr official "l'engagement n'a pas été exécuté (article 1217)";
    label en unofficial "the undertaking has not been performed (Article 1217)";
}
pub relation engagement_imparfaitement_execute(o: Obligation) kind empirical {
    label fr official "l'engagement a été imparfaitement exécuté (articles 1217 et 1223)";
    label en unofficial "the undertaking was imperfectly performed (Articles 1217 and 1223)";
}
pub relation obligation_exigible(o: Obligation) kind empirical {
    label fr official "l'obligation est exigible (article 1219)";
    label en unofficial "the obligation is due (Article 1219)";
}
pub relation evenement_echappant_au_controle_du_debiteur(o: Obligation) kind empirical {
    label fr official "un événement échappant au contrôle du débiteur empêche l'exécution de son obligation (article 1218, alinéa 1)";
    label en unofficial "an event beyond the debtor's control prevents performance of his obligation (Article 1218, paragraph 1)";
}
pub relation empechement_temporaire(o: Obligation) kind empirical {
    label fr official "l'empêchement est temporaire (article 1218, alinéa 2)";
    label en unofficial "the impediment is temporary (Article 1218, paragraph 2)";
}
pub relation empechement_definitif(o: Obligation) kind empirical {
    label fr official "l'empêchement est définitif (article 1218, alinéa 2)";
    label en unofficial "the impediment is permanent (Article 1218, paragraph 2)";
}
pub relation refus_d_executer_oppose(o: Obligation, creancier: Personne) kind empirical {
    label fr official "cette partie refuse d'exécuter son obligation (article 1219)";
    label en unofficial "this party refuses to perform its obligation (Article 1219)";
}
pub relation suspension_notifiee_dans_les_meilleurs_delais(o: Obligation) kind empirical {
    label fr official "la suspension a été notifiée dans les meilleurs délais (article 1220)";
    label en unofficial "the suspension was notified as soon as possible (Article 1220)";
}
pub relation execution_en_nature_impossible(o: Obligation) kind empirical {
    label fr official "l'exécution en nature est impossible (article 1221)";
    label en unofficial "performance in kind is impossible (Article 1221)";
}
pub relation debiteur_de_bonne_foi(o: Obligation) kind empirical {
    label fr official "le débiteur est de bonne foi (article 1221)";
    label en unofficial "the debtor is in good faith (Article 1221)";
}
pub relation execution_par_le_creancier_a_cout_raisonnable(o: Obligation) kind empirical {
    label fr official "le créancier a fait exécuter lui-même l'obligation dans un délai et à un coût raisonnables (article 1222, alinéa 1)";
    label en unofficial "the creditor had the obligation performed himself within a reasonable time and at a reasonable cost (Article 1222, paragraph 1)";
}
pub relation autorisation_prealable_du_juge_a_la_destruction(o: Obligation) kind empirical {
    label fr official "le juge a autorisé au préalable la destruction de ce qui a été fait en violation de l'obligation (article 1222, alinéa 1)";
    label en unofficial "the court gave prior authorization to destroy what was done in breach of the obligation (Article 1222, paragraph 1)";
}
pub relation sommes_engagees_par_le_creancier(o: Obligation, m: Money) kind empirical {
    key(o);
    label fr official "sommes engagées par le créancier pour l'exécution ou la destruction (article 1222, alinéa 1)";
    label en unofficial "sums spent by the creditor for the performance or the destruction (Article 1222, paragraph 1)";
}
pub relation avance_demandee_en_justice(o: Obligation) kind empirical {
    label fr official "le créancier demande en justice que le débiteur avance les sommes nécessaires (article 1222, alinéa 2)";
    label en unofficial "the creditor asks the court to order the debtor to advance the necessary sums (Article 1222, paragraph 2)";
}
pub relation prix_du_contrat(c: Contrat, m: Money) kind empirical {
    key(c);
    label fr official "prix convenu de la prestation (article 1223)";
    label en unofficial "agreed price of the performance (Article 1223)";
}
pub relation termes_de_la_reduction_de_prix(c: Contrat, numerateur: Integer, denominateur: Decimal) kind empirical {
    label fr official "termes de la fraction de réduction proportionnelle retenue pour l'exécution imparfaite (article 1223) : le Code ne donne pas la proportion, le cas la fournit";
    label en unofficial "terms of the proportional price-reduction fraction retained for the imperfect performance (Article 1223): the Code gives no proportion, the case supplies it";
}
pub relation prix_non_encore_paye(c: Contrat) kind empirical {
    label fr official "le créancier n'a pas encore payé tout ou partie de la prestation (article 1223, alinéa 1)";
    label en unofficial "the creditor has not yet paid all or part of the performance (Article 1223, paragraph 1)";
}
pub relation decision_de_reduction_notifiee(c: Contrat) kind empirical {
    label fr official "le créancier a notifié au débiteur sa décision de réduire le prix dans les meilleurs délais (article 1223)";
    label en unofficial "the creditor notified the debtor of its decision to reduce the price as soon as possible (Article 1223)";
}
pub relation acceptation_ecrite_de_la_reduction(c: Contrat) kind empirical {
    label fr official "l'acceptation par le débiteur de la décision de réduction de prix a été rédigée par écrit (article 1223, rédaction de 2018)";
    label en unofficial "the debtor's acceptance of the price-reduction decision was put in writing (Article 1223, 2018 wording)";
}
pub relation reduction_demandee_au_juge(c: Contrat) kind empirical {
    label fr official "le créancier ayant déjà payé demande au juge la réduction du prix (article 1223, rédaction de 2018)";
    label en unofficial "the creditor having already paid asks the court to reduce the price (Article 1223, 2018 wording)";
}
pub relation execution_imparfaite_acceptee(c: Contrat) kind empirical {
    label fr official "le créancier accepte une exécution imparfaite du contrat (article 1223, rédaction de 2016)";
    label en unofficial "the creditor accepts an imperfect performance of the contract (Article 1223, 2016 wording)";
}
pub relation clause_resolutoire(cl: Clause) kind empirical {
    label fr official "clause résolutoire précisant les engagements dont l'inexécution entraînera la résolution (article 1225, alinéa 1)";
    label en unofficial "termination clause specifying the undertakings whose non-performance will terminate the contract (Article 1225, paragraph 1)";
}
pub relation clause_resolutoire_vise_l_engagement(cl: Clause, o: Obligation) kind empirical {
    label fr official "la clause résolutoire vise cet engagement (article 1225, alinéa 1)";
    label en unofficial "the termination clause covers this undertaking (Article 1225, paragraph 1)";
}
pub relation mise_en_demeure_infructueuse(o: Obligation) kind empirical {
    label fr official "la mise en demeure est demeurée infructueuse (article 1225, alinéa 2)";
    label en unofficial "the notice to perform remained fruitless (Article 1225, paragraph 2)";
}
pub relation mise_en_demeure_mentionnant_la_clause_resolutoire(o: Obligation) kind empirical {
    label fr official "la mise en demeure mentionne expressément la clause résolutoire (article 1225, alinéa 2)";
    label en unofficial "the notice expressly mentions the termination clause (Article 1225, paragraph 2)";
}
pub relation dispense_conventionnelle_de_mise_en_demeure(cl: Clause) kind empirical {
    label fr official "il a été convenu que la résolution résulterait du seul fait de l'inexécution (article 1225, alinéa 2)";
    label en unofficial "it was agreed that termination would result from the mere fact of non-performance (Article 1225, paragraph 2)";
}
pub relation urgence(o: Obligation) kind empirical {
    label fr official "urgence dispensant de la mise en demeure préalable (article 1226, alinéa 1)";
    label en unofficial "urgency dispensing with the prior notice (Article 1226, paragraph 1)";
}
pub relation mise_en_demeure_de_satisfaire_le(o: Obligation, jour: Date) kind empirical {
    key(o);
    label fr official "jour de la mise en demeure adressée au débiteur défaillant de satisfaire à son engagement (articles 1226 et 1231)";
    label en unofficial "day of the notice to the defaulting debtor to satisfy his undertaking (Articles 1226 and 1231)";
}
pub relation delai_imparti_par_la_mise_en_demeure(o: Obligation, jour: Date) kind empirical {
    key(o);
    label fr official "expiration du délai imparti au débiteur par la mise en demeure (articles 1226 et 1231)";
    label en unofficial "expiry of the period allowed to the debtor by the notice (Articles 1226 and 1231)";
}
pub relation mise_en_demeure_mentionnant_le_droit_de_resoudre(o: Obligation) kind empirical {
    label fr official "la mise en demeure mentionne expressément qu'à défaut pour le débiteur de satisfaire à son obligation, le créancier sera en droit de résoudre le contrat (article 1226, alinéa 2)";
    label en unofficial "the notice expressly states that failing performance the creditor will be entitled to terminate the contract (Article 1226, paragraph 2)";
}
pub relation inexecution_persiste(o: Obligation) kind empirical {
    label fr official "l'inexécution persiste après la mise en demeure (article 1226, alinéa 3)";
    label en unofficial "the non-performance persists after the notice (Article 1226, paragraph 3)";
}
pub relation notification_de_resolution_motivee_le(c: Contrat, jour: Date) kind empirical {
