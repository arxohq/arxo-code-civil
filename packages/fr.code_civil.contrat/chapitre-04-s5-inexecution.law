    label en unofficial "day the creditor notified the debtor of the contract's termination and the reasons for it (Article 1226, paragraph 3)";
}
pub relation contestation_de_la_resolution_par_le_debiteur(c: Contrat) kind empirical {
    label fr official "le débiteur a saisi le juge pour contester la résolution (article 1226, alinéa 4)";
    label en unofficial "the debtor applied to the court to challenge the termination (Article 1226, paragraph 4)";
}
