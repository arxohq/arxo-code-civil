    label en unofficial "the exchanged performances could be useful only through the contract's complete performance (Article 1229, paragraph 3)";
}
pub relation prestations_utiles_au_fur_et_a_mesure(c: Contrat) kind empirical {
    label fr official "les prestations échangées ont trouvé leur utilité au fur et à mesure de l'exécution réciproque du contrat (article 1229, alinéa 3)";
    label en unofficial "the exchanged performances were useful as the contract was reciprocally performed (Article 1229, paragraph 3)";
}
pub relation clause_survivant_a_la_resolution(cl: Clause) kind empirical {
    label fr official "clause relative au règlement des différends, ou destinée à produire effet même en cas de résolution, telles les clauses de confidentialité et de non-concurrence (article 1230)";
    label en unofficial "clause on dispute resolution, or intended to have effect even on termination, such as confidentiality and non-competition clauses (Article 1230)";
}
pub relation inexecution_definitive(o: Obligation) kind empirical {
    label fr official "l'inexécution est définitive (articles 1231 et 1231-5, dernier alinéa)";
    label en unofficial "the non-performance is definitive (Articles 1231 and 1231-5, last paragraph)";
}
pub relation retard_dans_l_execution(o: Obligation) kind empirical {
