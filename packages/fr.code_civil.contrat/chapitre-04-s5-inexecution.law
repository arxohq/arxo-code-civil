    label fr official "la résolution est demandée en justice (article 1227)";
    label en unofficial "termination is sought in court (Article 1227)";
}
pub relation resolution_prononcee_par_le_juge_le(c: Contrat, jour: Date) kind empirical {
    key(c);
    label fr official "jour auquel le juge constate ou prononce la résolution (articles 1228 et 1229)";
    label en unofficial "day on which the court finds or pronounces the termination (Articles 1228 and 1229)";
}
pub relation execution_ordonnee_par_le_juge(c: Contrat) kind empirical {
    label fr official "le juge ordonne l'exécution du contrat, en accordant éventuellement un délai au débiteur (article 1228)";
    label en unofficial "the court orders the contract's performance, possibly allowing the debtor time (Article 1228)";
}
pub relation dommages_et_interets_seuls_alloues(c: Contrat) kind empirical {
    label fr official "le juge alloue seulement des dommages et intérêts (article 1228)";
    label en unofficial "the court awards damages only (Article 1228)";
}
pub relation date_fixee_par_la_clause_resolutoire(c: Contrat, jour: Date) kind empirical {
    key(c);
    label fr official "date de prise d'effet prévue par la clause résolutoire (article 1229, alinéa 2)";
    label en unofficial "effective date provided by the termination clause (Article 1229, paragraph 2)";
}
pub relation assignation_en_justice_le(c: Contrat, jour: Date) kind empirical {
    key(c);
    label fr official "jour de l'assignation en justice (article 1229, alinéa 2)";
    label en unofficial "day of the court summons (Article 1229, paragraph 2)";
}
pub relation prestations_utiles_seulement_par_l_execution_complete(c: Contrat) kind empirical {
