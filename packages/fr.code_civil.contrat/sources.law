// BEGIN GENERATED FRAGMENTS

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1100")
pub fragment CC_ART1100 in CC_COURANT {
    label fr official "Article 1100";
    kind article;
    locator "article/1100";
    text fr official """Article 1100
Les obligations naissent d'actes juridiques, de faits juridiques ou de l'autorité seule de la loi.
Elles peuvent naître de l'exécution volontaire ou de la promesse d'exécution d'un devoir de conscience envers autrui.
""";
    content_hash "sha256:f2ea1f8dd2675703a8febfd3f63a0c61fdfa975436d270a24f17f3ceb3b405e2";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1100_1")
pub fragment CC_ART1100_1 in CC_COURANT {
    label fr official "Article 1100-1";
    kind article;
    locator "article/1100-1";
    text fr official """Article 1100-1
Les actes juridiques sont des manifestations de volonté destinées à produire des effets de droit. Ils peuvent être conventionnels ou unilatéraux.
Ils obéissent, en tant que de raison, pour leur validité et leurs effets, aux règles qui gouvernent les contrats.
""";
    content_hash "sha256:39219b3571e869570b52963016f7031c54896b8c868f020633a02eb4503485af";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1100_2")
pub fragment CC_ART1100_2 in CC_COURANT {
    label fr official "Article 1100-2";
    kind article;
    locator "article/1100-2";
    text fr official """Article 1100-2
Les faits juridiques sont des agissements ou des événements auxquels la loi attache des effets de droit.
Les obligations qui naissent d'un fait juridique sont régies, selon le cas, par le sous-titre relatif à la responsabilité extracontractuelle ou le sous-titre relatif aux autres sources d'obligations.
""";
    content_hash "sha256:ff80821646caa2c084b97f707a508bf2c1371da15929adb84535dd0ca94bae96";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1101")
pub fragment CC_ART1101 in CC_COURANT {
    label fr official "Article 1101";
    kind article;
    locator "article/1101";
    text fr official """Article 1101
Le contrat est un accord de volontés entre deux ou plusieurs personnes destiné à créer, modifier, transmettre ou éteindre des obligations.
""";
    content_hash "sha256:b6c3a9e067a9acb3f76705c49348967d90ce97ab66b095dfb0ae56204ce9198f";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1102")
pub fragment CC_ART1102 in CC_COURANT {
    label fr official "Article 1102";
    kind article;
    locator "article/1102";
    text fr official """Article 1102
Chacun est libre de contracter ou de ne pas contracter, de choisir son cocontractant et de déterminer le contenu et la forme du contrat dans les limites fixées par la loi.
La liberté contractuelle ne permet pas de déroger aux règles qui intéressent l'ordre public.
""";
    content_hash "sha256:ba2eed59b2fa0cbd985585795338316134c14f94de76bc8ab5c4bb3f78081afa";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1103")
pub fragment CC_ART1103 in CC_COURANT {
    label fr official "Article 1103";
    kind article;
    locator "article/1103";
    text fr official """Article 1103
Les contrats légalement formés tiennent lieu de loi à ceux qui les ont faits.
""";
    content_hash "sha256:39431a9b9bbdac786d5e306cef3376161b769a0d82b524fa6f333308a9e7919c";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1104")
pub fragment CC_ART1104 in CC_COURANT {
    label fr official "Article 1104";
    kind article;
    locator "article/1104";
    text fr official """Article 1104
Les contrats doivent être négociés, formés et exécutés de bonne foi.
Cette disposition est d'ordre public.
""";
    content_hash "sha256:3d6ca14cb7247f9fae719d57b0bf4bd77b2b2df8f94302ed73c0ac4a59a4b4d4";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1105")
pub fragment CC_ART1105 in CC_COURANT {
    label fr official "Article 1105";
    kind article;
    locator "article/1105";
    text fr official """Article 1105
Les contrats, qu'ils aient ou non une dénomination propre, sont soumis à des règles générales, qui sont l'objet du présent sous-titre.
Les règles particulières à certains contrats sont établies dans les dispositions propres à chacun d'eux.
Les règles générales s'appliquent sous réserve de ces règles particulières.
""";
    content_hash "sha256:af550ce0a83f4aae412f88d6967c5d8bc2d8c63eb8859e8bf507d4e04c9caf90";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1106")
pub fragment CC_ART1106 in CC_COURANT {
    label fr official "Article 1106";
    kind article;
    locator "article/1106";
    text fr official """Article 1106
Le contrat est synallagmatique lorsque les contractants s'obligent réciproquement les uns envers les autres.
Il est unilatéral lorsqu'une ou plusieurs personnes s'obligent envers une ou plusieurs autres sans qu'il y ait d'engagement réciproque de celles-ci.
""";
    content_hash "sha256:d0f579d5672f64595e1845b3331e3244c4336b401cefe35022c74facab0176e4";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1107")
pub fragment CC_ART1107 in CC_COURANT {
    label fr official "Article 1107";
    kind article;
    locator "article/1107";
    text fr official """Article 1107
Le contrat est à titre onéreux lorsque chacune des parties reçoit de l'autre un avantage en contrepartie de celui qu'elle procure.
Il est à titre gratuit lorsque l'une des parties procure à l'autre un avantage sans attendre ni recevoir de contrepartie.
""";
    content_hash "sha256:578bb36885b4b6a87ff234f4c5c36e98bd843b54397b4da759b43832a020d5e2";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1108")
pub fragment CC_ART1108 in CC_COURANT {
    label fr official "Article 1108";
    kind article;
    locator "article/1108";
    text fr official """Article 1108
Le contrat est commutatif lorsque chacune des parties s'engage à procurer à l'autre un avantage qui est regardé comme l'équivalent de celui qu'elle reçoit.
Il est aléatoire lorsque les parties acceptent de faire dépendre les effets du contrat, quant aux avantages et aux pertes qui en résulteront, d'un événement incertain.
""";
    content_hash "sha256:8c340f6fdce308f14ee9fa7c8e8bec2773c1913683b7fe084d595875a6c634a1";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1109")
pub fragment CC_ART1109 in CC_COURANT {
    label fr official "Article 1109";
    kind article;
    locator "article/1109";
    text fr official """Article 1109
Le contrat est consensuel lorsqu'il se forme par le seul échange des consentements quel qu'en soit le mode d'expression.
Le contrat est solennel lorsque sa validité est subordonnée à des formes déterminées par la loi.
Le contrat est réel lorsque sa formation est subordonnée à la remise d'une chose.
""";
    content_hash "sha256:31d63cd53902ad4cb0a6e3515ed2c9747cf03fc0454bfec378a62fd67f08c318";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1110")
pub fragment CC_ART1110 in CC_COURANT {
    label fr official "Article 1110";
    kind article;
    locator "article/1110";
    text fr official """Article 1110
Le contrat de gré à gré est celui dont les stipulations sont négociables entre les parties.
Le contrat d'adhésion est celui qui comporte un ensemble de clauses non négociables, déterminées à l'avance par l'une des parties.
""";
    content_hash "sha256:f0b3c1e0b9ae712f15c9b1471a1fd969eb34a0cd010e575d0ab5af1b15bc68d3";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1111")
pub fragment CC_ART1111 in CC_COURANT {
    label fr official "Article 1111";
    kind article;
    locator "article/1111";
    text fr official """Article 1111
Le contrat cadre est un accord par lequel les parties conviennent des caractéristiques générales de leurs relations contractuelles futures. Des contrats d'application en précisent les modalités d'exécution.
""";
    content_hash "sha256:35f06b839e567ca54d91c7ae69bc523efc3c395ed0342cb055eecb892dfbf7d6";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1111_1")
pub fragment CC_ART1111_1 in CC_COURANT {
    label fr official "Article 1111-1";
    kind article;
    locator "article/1111-1";
    text fr official """Article 1111-1
Le contrat à exécution instantanée est celui dont les obligations peuvent s'exécuter en une prestation unique.
Le contrat à exécution successive est celui dont les obligations d'au moins une partie s'exécutent en plusieurs prestations échelonnées dans le temps.
""";
    content_hash "sha256:dded36a535d0d867e3ac10c9722879141277209cc3583cbca36e32559911a9ee";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1112")
pub fragment CC_ART1112 in CC_COURANT {
    label fr official "Article 1112";
    kind article;
    locator "article/1112";
    text fr official """Article 1112
L'initiative, le déroulement et la rupture des négociations précontractuelles sont libres. Ils doivent impérativement satisfaire aux exigences de la bonne foi.
En cas de faute commise dans les négociations, la réparation du préjudice qui en résulte ne peut avoir pour objet de compenser ni la perte des avantages attendus du contrat non conclu, ni la perte de chance d'obtenir ces avantages.
""";
    content_hash "sha256:2f3dded9fcb9be10e90d2d538045981641b5e8a04141688434050ff2107ce4f4";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1112_1")
pub fragment CC_ART1112_1 in CC_COURANT {
    label fr official "Article 1112-1";
    kind article;
    locator "article/1112-1";
    text fr official """Article 1112-1
Celle des parties qui connaît une information dont l'importance est déterminante pour le consentement de l'autre doit l'en informer dès lors que, légitimement, cette dernière ignore cette information ou fait confiance à son cocontractant.
Néanmoins, ce devoir d'information ne porte pas sur l'estimation de la valeur de la prestation.
Ont une importance déterminante les informations qui ont un lien direct et nécessaire avec le contenu du contrat ou la qualité des parties.
Il incombe à celui qui prétend qu'une information lui était due de prouver que l'autre partie la lui devait, à charge pour cette autre partie de prouver qu'elle l'a fournie.
Les parties ne peuvent ni limiter, ni exclure ce devoir.
Outre la responsabilité de celui qui en était tenu, le manquement à ce devoir d'information peut entraîner l'annulation du contrat dans les conditions prévues aux articles 1130 et suivants.
""";
    content_hash "sha256:84c48b4c88d30cb5c107d5d6403e86991f2b631e5632aab711a72f4f719f3ba3";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1112_2")
pub fragment CC_ART1112_2 in CC_COURANT {
    label fr official "Article 1112-2";
    kind article;
    locator "article/1112-2";
    text fr official """Article 1112-2
Celui qui utilise ou divulgue sans autorisation une information confidentielle obtenue à l'occasion des négociations engage sa responsabilité dans les conditions du droit commun.
""";
    content_hash "sha256:f53073686155ddbb8743f92c532f98a56c3202b5137a8639e0422097be8a5fc1";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1113")
pub fragment CC_ART1113 in CC_COURANT {
    label fr official "Article 1113";
    kind article;
    locator "article/1113";
    text fr official """Article 1113
Le contrat est formé par la rencontre d'une offre et d'une acceptation par lesquelles les parties manifestent leur volonté de s'engager.
Cette volonté peut résulter d'une déclaration ou d'un comportement non équivoque de son auteur.
""";
    content_hash "sha256:c28c399006672eef98efb1dcf259f67a9dad4a55f20e9b1b26b2d3426a20e9d2";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1114")
pub fragment CC_ART1114 in CC_COURANT {
    label fr official "Article 1114";
    kind article;
    locator "article/1114";
    text fr official """Article 1114
L'offre, faite à personne déterminée ou indéterminée, comprend les éléments essentiels du contrat envisagé et exprime la volonté de son auteur d'être lié en cas d'acceptation. A défaut, il y a seulement invitation à entrer en négociation.
""";
    content_hash "sha256:8fb2562c9936faa80dd85e101f529cbff2414624aee58554c05b56ed8f9a6bcb";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1115")
pub fragment CC_ART1115 in CC_COURANT {
    label fr official "Article 1115";
    kind article;
    locator "article/1115";
    text fr official """Article 1115
Elle peut être librement rétractée tant qu'elle n'est pas parvenue à son destinataire.
""";
    content_hash "sha256:b5a7bddbf920752efa1bcadbf046b7c42166944785b9b0f88fdb37aea86536b9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1116")
pub fragment CC_ART1116 in CC_COURANT {
    label fr official "Article 1116";
    kind article;
    locator "article/1116";
    text fr official """Article 1116
Elle ne peut être rétractée avant l'expiration du délai fixé par son auteur ou, à défaut, l'issue d'un délai raisonnable.
La rétractation de l'offre en violation de cette interdiction empêche la conclusion du contrat.
Elle engage la responsabilité extracontractuelle de son auteur dans les conditions du droit commun sans l'obliger à compenser la perte des avantages attendus du contrat.
""";
    content_hash "sha256:d36b0bbd31a11f3410075627f4c6ebef8889e9a47d9bd3a021f5c14f3e965aa6";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1117")
pub fragment CC_ART1117 in CC_COURANT {
    label fr official "Article 1117";
    kind article;
    locator "article/1117";
    text fr official """Article 1117
L'offre est caduque à l'expiration du délai fixé par son auteur ou, à défaut, à l'issue d'un délai raisonnable.
Elle l'est également en cas d'incapacité ou de décès de son auteur, ou de décès de son destinataire.
""";
    content_hash "sha256:d26a90c849d05a355fe4fa2866fe84b53a96b67e2b73aa8c6d2d3cec6ada4186";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1118")
pub fragment CC_ART1118 in CC_COURANT {
    label fr official "Article 1118";
    kind article;
    locator "article/1118";
    text fr official """Article 1118
L'acceptation est la manifestation de volonté de son auteur d'être lié dans les termes de l'offre.
Tant que l'acceptation n'est pas parvenue à l'offrant, elle peut être librement rétractée, pourvu que la rétractation parvienne à l'offrant avant l'acceptation.
L'acceptation non conforme à l'offre est dépourvue d'effet, sauf à constituer une offre nouvelle.
""";
    content_hash "sha256:98229109a6a670ec56ba514082e72a13e576a381f42a7a695e3e1926fd926ced";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1119")
pub fragment CC_ART1119 in CC_COURANT {
    label fr official "Article 1119";
    kind article;
    locator "article/1119";
    text fr official """Article 1119
Les conditions générales invoquées par une partie n'ont effet à l'égard de l'autre que si elles ont été portées à la connaissance de celle-ci et si elle les a acceptées.
En cas de discordance entre des conditions générales invoquées par l'une et l'autre des parties, les clauses incompatibles sont sans effet.
En cas de discordance entre des conditions générales et des conditions particulières, les secondes l'emportent sur les premières.
""";
    content_hash "sha256:44477dd69d09e38364d18a2a6436877c1de788b350297d289e7fcd2a877c94c9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1120")
pub fragment CC_ART1120 in CC_COURANT {
    label fr official "Article 1120";
    kind article;
    locator "article/1120";
    text fr official """Article 1120
Le silence ne vaut pas acceptation, à moins qu'il n'en résulte autrement de la loi, des usages, des relations d'affaires ou de circonstances particulières.
""";
    content_hash "sha256:6d387f2fcb8b7be9eeeb294439918e6ceaa6de0eae917a0a7c8029d6ab257ca9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1121")
pub fragment CC_ART1121 in CC_COURANT {
    label fr official "Article 1121";
    kind article;
    locator "article/1121";
    text fr official """Article 1121
Le contrat est conclu dès que l'acceptation parvient à l'offrant. Il est réputé l'être au lieu où l'acceptation est parvenue.
""";
    content_hash "sha256:963245f0684e7c346e6defc5811bd20c8a59538df4fdfe3ca7515b72698c4c92";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1122")
pub fragment CC_ART1122 in CC_COURANT {
    label fr official "Article 1122";
    kind article;
    locator "article/1122";
    text fr official """Article 1122
La loi ou le contrat peuvent prévoir un délai de réflexion, qui est le délai avant l'expiration duquel le destinataire de l'offre ne peut manifester son acceptation ou un délai de rétractation, qui est le délai avant l'expiration duquel son bénéficiaire peut rétracter son consentement.
""";
    content_hash "sha256:df91993d64224eb038612194bfafc7d24457edf9e44d01012b1875f3cf1a7c89";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1123")
pub fragment CC_ART1123 in CC_COURANT {
    label fr official "Article 1123";
    kind article;
    locator "article/1123";
    text fr official """Article 1123
Le pacte de préférence est le contrat par lequel une partie s'engage à proposer prioritairement à son bénéficiaire de traiter avec lui pour le cas où elle déciderait de contracter.
Lorsqu'un contrat est conclu avec un tiers en violation d'un pacte de préférence, le bénéficiaire peut obtenir la réparation du préjudice subi. Lorsque le tiers connaissait l'existence du pacte et l'intention du bénéficiaire de s'en prévaloir, ce dernier peut également agir en nullité ou demander au juge de le substituer au tiers dans le contrat conclu.
Le tiers peut demander par écrit au bénéficiaire de confirmer dans un délai qu'il fixe et qui doit être raisonnable, l'existence d'un pacte de préférence et s'il entend s'en prévaloir.
L'écrit mentionne qu'à défaut de réponse dans ce délai, le bénéficiaire du pacte ne pourra plus solliciter sa substitution au contrat conclu avec le tiers ou la nullité du contrat.
""";
    content_hash "sha256:3220adc8c618f1a498204f183519e30cae76f4186aa304e9421a7d00609ea7d6";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1124")
pub fragment CC_ART1124 in CC_COURANT {
    label fr official "Article 1124";
    kind article;
    locator "article/1124";
    text fr official """Article 1124
La promesse unilatérale est le contrat par lequel une partie, le promettant, accorde à l'autre, le bénéficiaire, le droit d'opter pour la conclusion d'un contrat dont les éléments essentiels sont déterminés, et pour la formation duquel ne manque que le consentement du bénéficiaire.
La révocation de la promesse pendant le temps laissé au bénéficiaire pour opter n'empêche pas la formation du contrat promis.
Le contrat conclu en violation de la promesse unilatérale avec un tiers qui en connaissait l'existence est nul.
""";
    content_hash "sha256:709451a22110630af0820460ab96f362c76305785c7a4f06f4ae08d9934f2f2c";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1125")
pub fragment CC_ART1125 in CC_COURANT {
    label fr official "Article 1125";
    kind article;
    locator "article/1125";
    text fr official """Article 1125
La voie électronique peut être utilisée pour mettre à disposition des stipulations contractuelles ou des informations sur des biens ou services.
""";
    content_hash "sha256:130c5fb82e9809528ddfdc58d53d9c3b825be0c25c5c053271643fb583ec33d0";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1126")
pub fragment CC_ART1126 in CC_COURANT {
    label fr official "Article 1126";
    kind article;
    locator "article/1126";
    text fr official """Article 1126
Les informations qui sont demandées en vue de la conclusion d'un contrat ou celles qui sont adressées au cours de son exécution peuvent être transmises par courrier électronique si leur destinataire a accepté l'usage de ce moyen.
""";
    content_hash "sha256:cf48bb2220b0bc219e3fc0f2427dc4ae69ff3d271d439329934e4d1894bc0f55";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1127")
pub fragment CC_ART1127 in CC_COURANT {
    label fr official "Article 1127";
    kind article;
    locator "article/1127";
    text fr official """Article 1127
Les informations destinées à un professionnel peuvent lui être adressées par courrier électronique, dès lors qu'il a communiqué son adresse électronique.
Si ces informations doivent être portées sur un formulaire, celui-ci est mis, par voie électronique, à la disposition de la personne qui doit le remplir.
""";
    content_hash "sha256:ac987acc4f378ff35060df8414ed0e0da2fb9c739fd172283f630390e93c1990";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1127_1")
pub fragment CC_ART1127_1 in CC_COURANT {
    label fr official "Article 1127-1";
    kind article;
    locator "article/1127-1";
    text fr official """Article 1127-1
Quiconque propose à titre professionnel, par voie électronique, la fourniture de biens ou la prestation de services, met à disposition les stipulations contractuelles applicables d'une manière qui permette leur conservation et leur reproduction.
L'auteur d'une offre reste engagé par elle tant qu'elle est accessible par voie électronique de son fait.
L'offre énonce en outre :
1° Les différentes étapes à suivre pour conclure le contrat par voie électronique ;
2° Les moyens techniques permettant au destinataire de l'offre, avant la conclusion du contrat, d'identifier d'éventuelles erreurs commises dans la saisie des données et de les corriger ;
3° Les langues proposées pour la conclusion du contrat au nombre desquelles doit figurer la langue française ;
4° Le cas échéant, les modalités d'archivage du contrat par l'auteur de l'offre et les conditions d'accès au contrat archivé ;
5° Les moyens de consulter par voie électronique les règles professionnelles et commerciales auxquelles l'auteur de l'offre entend, le cas échéant, se soumettre.
""";
    content_hash "sha256:33474b824227638807942af5dcfb33956b5c5e5d4e1a5cbc0e73e4af28421c1d";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1127_2")
pub fragment CC_ART1127_2 in CC_COURANT {
    label fr official "Article 1127-2";
    kind article;
    locator "article/1127-2";
    text fr official """Article 1127-2
Le contrat n'est valablement conclu que si le destinataire de l'offre a eu la possibilité de vérifier le détail de sa commande et son prix total et de corriger d'éventuelles erreurs avant de confirmer celle-ci pour exprimer son acceptation définitive.
L'auteur de l'offre doit accuser réception sans délai injustifié, par voie électronique, de la commande qui lui a été adressée.
La commande, la confirmation de l'acceptation de l'offre et l'accusé de réception sont considérés comme reçus lorsque les parties auxquelles ils sont adressés peuvent y avoir accès.
""";
    content_hash "sha256:3dd0700b012402bbf474dc4f16394e760623c42aa8b4c72a16b2cdb0e3b932fa";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1127_3")
pub fragment CC_ART1127_3 in CC_COURANT {
    label fr official "Article 1127-3";
    kind article;
    locator "article/1127-3";
    text fr official """Article 1127-3
Il est fait exception aux obligations visées aux 1° à 5° de l'article 1127-1 et aux deux premiers alinéas de l'article 1127-2 pour les contrats de fourniture de biens ou de prestation de services qui sont conclus exclusivement par échange de courriers électroniques.
Il peut, en outre, être dérogé aux dispositions des 1° à 5° de l'article 1127-1 et de l'article 1127-2 dans les contrats conclus entre professionnels.
""";
    content_hash "sha256:9802927c21891ab35012b47982d4e6adc52ccc7f00a87395470b9eeeeaef25bc";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1127_4")
pub fragment CC_ART1127_4 in CC_COURANT {
    label fr official "Article 1127-4";
    kind article;
    locator "article/1127-4";
    text fr official """Article 1127-4
Hors les cas prévus aux articles 1125 et 1126, la remise d'un écrit électronique est effective lorsque le destinataire, après avoir pu en prendre connaissance, en a accusé réception.
Si une disposition prévoit que l'écrit doit être lu au destinataire, la remise d'un écrit électronique à l'intéressé dans les conditions prévues au premier alinéa vaut lecture.
""";
    content_hash "sha256:222c3987028b8bb6b8070397abd0bfad8b13546bf38e96a822c64662d8a07737";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1128")
pub fragment CC_ART1128 in CC_COURANT {
    label fr official "Article 1128";
    kind article;
    locator "article/1128";
    text fr official """Article 1128
Sont nécessaires à la validité d'un contrat :
1° Le consentement des parties ;
2° Leur capacité de contracter ;
3° Un contenu licite et certain.
""";
    content_hash "sha256:400e10b5d4760818cb0a36f6840685a9820504e6900e04306fe86e74426b20a1";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1129")
pub fragment CC_ART1129 in CC_COURANT {
    label fr official "Article 1129";
    kind article;
    locator "article/1129";
    text fr official """Article 1129
Conformément à l'article 414-1, il faut être sain d'esprit pour consentir valablement à un contrat.
""";
    content_hash "sha256:3bb8e6c5f1c31fed5e67f1f0ebbafeea737e8bbb95e46e32c3a466dd322b8bc7";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1130")
pub fragment CC_ART1130 in CC_COURANT {
    label fr official "Article 1130";
    kind article;
    locator "article/1130";
    text fr official """Article 1130
L'erreur, le dol et la violence vicient le consentement lorsqu'ils sont de telle nature que, sans eux, l'une des parties n'aurait pas contracté ou aurait contracté à des conditions substantiellement différentes.
Leur caractère déterminant s'apprécie eu égard aux personnes et aux circonstances dans lesquelles le consentement a été donné.
""";
    content_hash "sha256:2b628475de4904b5a66c3347c2eb12849a37a6bdbf3fd542754e1d7fb71daf84";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1131")
pub fragment CC_ART1131 in CC_COURANT {
    label fr official "Article 1131";
    kind article;
    locator "article/1131";
    text fr official """Article 1131
Les vices du consentement sont une cause de nullité relative du contrat.
""";
    content_hash "sha256:265d9b15edda50243013b2ef90b0f60a0c5bb8d1276606d6d0c2da0b8295a519";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1132")
pub fragment CC_ART1132 in CC_COURANT {
    label fr official "Article 1132";
    kind article;
    locator "article/1132";
    text fr official """Article 1132
L'erreur de droit ou de fait, à moins qu'elle ne soit inexcusable, est une cause de nullité du contrat lorsqu'elle porte sur les qualités essentielles de la prestation due ou sur celles du cocontractant.
""";
    content_hash "sha256:a0bea4307d6bb523f6ec577bd54ea0558214db41454433cbc4bc19ecd4f25c7d";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1133")
pub fragment CC_ART1133 in CC_COURANT {
    label fr official "Article 1133";
    kind article;
    locator "article/1133";
    text fr official """Article 1133
Les qualités essentielles de la prestation sont celles qui ont été expressément ou tacitement convenues et en considération desquelles les parties ont contracté.
L'erreur est une cause de nullité qu'elle porte sur la prestation de l'une ou de l'autre partie.
L'acceptation d'un aléa sur une qualité de la prestation exclut l'erreur relative à cette qualité.
""";
    content_hash "sha256:732bb648aac8d8bafeb294530819ebfa287b286b77dd86e56309c9b19a24a241";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1134")
pub fragment CC_ART1134 in CC_COURANT {
    label fr official "Article 1134";
    kind article;
    locator "article/1134";
    text fr official """Article 1134
L'erreur sur les qualités essentielles du cocontractant n'est une cause de nullité que dans les contrats conclus en considération de la personne.
""";
    content_hash "sha256:24c8697395b57b5a0ea7880920368fdf89f26cea293023ff7d22a819f28aad7e";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1135")
pub fragment CC_ART1135 in CC_COURANT {
    label fr official "Article 1135";
    kind article;
    locator "article/1135";
    text fr official """Article 1135
L'erreur sur un simple motif, étranger aux qualités essentielles de la prestation due ou du cocontractant, n'est pas une cause de nullité, à moins que les parties n'en aient fait expressément un élément déterminant de leur consentement.
Néanmoins l'erreur sur le motif d'une libéralité, en l'absence duquel son auteur n'aurait pas disposé, est une cause de nullité.
""";
    content_hash "sha256:0c121a25c7df8c9848d418c1939760c117c5255f54c3f6fb7ca9e2416ef17661";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1136")
pub fragment CC_ART1136 in CC_COURANT {
    label fr official "Article 1136";
    kind article;
    locator "article/1136";
    text fr official """Article 1136
L'erreur sur la valeur par laquelle, sans se tromper sur les qualités essentielles de la prestation, un contractant fait seulement de celle-ci une appréciation économique inexacte, n'est pas une cause de nullité.
""";
    content_hash "sha256:4ffb0fbb3d1f94ffdb8895e46c6411d71ece232fc92d724511afe07051b7fb74";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1137")
pub fragment CC_ART1137 in CC_COURANT {
    label fr official "Article 1137";
    kind article;
    locator "article/1137";
    text fr official """Article 1137
Le dol est le fait pour un contractant d'obtenir le consentement de l'autre par des manœuvres ou des mensonges.
Constitue également un dol la dissimulation intentionnelle par l'un des contractants d'une information dont il sait le caractère déterminant pour l'autre partie.
Néanmoins, ne constitue pas un dol le fait pour une partie de ne pas révéler à son cocontractant son estimation de la valeur de la prestation.
""";
    content_hash "sha256:e097f0f3e0e27b57acd4fbaded2d05bca9f49f4a20917ca3c759cf8f69522daf";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1138")
pub fragment CC_ART1138 in CC_COURANT {
    label fr official "Article 1138";
    kind article;
    locator "article/1138";
    text fr official """Article 1138
Le dol est également constitué s'il émane du représentant, gérant d'affaires, préposé ou porte-fort du contractant.
Il l'est encore lorsqu'il émane d'un tiers de connivence.
""";
    content_hash "sha256:d4425e1217e31f0039e825ae2088d34fa4c84e7c9c0207af77604468d6500870";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1139")
pub fragment CC_ART1139 in CC_COURANT {
    label fr official "Article 1139";
    kind article;
    locator "article/1139";
    text fr official """Article 1139
L'erreur qui résulte d'un dol est toujours excusable ; elle est une cause de nullité alors même qu'elle porterait sur la valeur de la prestation ou sur un simple motif du contrat.
""";
    content_hash "sha256:c4b6fb428a26a864934ce592b8fa2bc35443e13dd20f9a3559b6d25213648ffb";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1140")
pub fragment CC_ART1140 in CC_COURANT {
    label fr official "Article 1140";
    kind article;
    locator "article/1140";
    text fr official """Article 1140
Il y a violence lorsqu'une partie s'engage sous la pression d'une contrainte qui lui inspire la crainte d'exposer sa personne, sa fortune ou celles de ses proches à un mal considérable.
""";
    content_hash "sha256:853afc0dd5227d092d358e4e3580930dc0648db239aa5689211c2f05d6544967";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1141")
pub fragment CC_ART1141 in CC_COURANT {
    label fr official "Article 1141";
    kind article;
    locator "article/1141";
    text fr official """Article 1141
La menace d'une voie de droit ne constitue pas une violence. Il en va autrement lorsque la voie de droit est détournée de son but ou lorsqu'elle est invoquée ou exercée pour obtenir un avantage manifestement excessif.
""";
    content_hash "sha256:a9ac945515bcbe010188ef66e1f1d4335394ee628a66118970864532371bda47";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1142")
pub fragment CC_ART1142 in CC_COURANT {
    label fr official "Article 1142";
    kind article;
    locator "article/1142";
    text fr official """Article 1142
La violence est une cause de nullité qu'elle ait été exercée par une partie ou par un tiers.
""";
    content_hash "sha256:afcf04cb989322dec391d940325ce6451656c6f1e41db28a88aa81e0bae62b0f";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1143")
pub fragment CC_ART1143 in CC_COURANT {
    label fr official "Article 1143";
    kind article;
    locator "article/1143";
    text fr official """Article 1143
Il y a également violence lorsqu'une partie, abusant de l'état de dépendance dans lequel se trouve son cocontractant à son égard, obtient de lui un engagement qu'il n'aurait pas souscrit en l'absence d'une telle contrainte et en tire un avantage manifestement excessif.
""";
    content_hash "sha256:00960e1dd4661c2d2ec3f7bee558cdd245e50a5c759e6599d24dedde7fe4b092";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1144")
pub fragment CC_ART1144 in CC_COURANT {
    label fr official "Article 1144";
    kind article;
    locator "article/1144";
    text fr official """Article 1144
Le délai de l'action en nullité ne court, en cas d'erreur ou de dol, que du jour où ils ont été découverts et, en cas de violence, que du jour où elle a cessé.
""";
    content_hash "sha256:103aafaa4ea3c8b7110b42889dd80259168b1c6767f3e66a61dd385932875066";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1145")
pub fragment CC_ART1145 in CC_COURANT {
    label fr official "Article 1145";
    kind article;
    locator "article/1145";
    text fr official """Article 1145
Toute personne physique peut contracter sauf en cas d'incapacité prévue par la loi.
La capacité des personnes morales est limitée par les règles applicables à chacune d'entre elles.
""";
    content_hash "sha256:dda90a2fd5a0bdb65d789c91ec89b64158cc7b70ed3330798e22ceecabd0636b";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1146")
pub fragment CC_ART1146 in CC_COURANT {
    label fr official "Article 1146";
    kind article;
    locator "article/1146";
    text fr official """Article 1146
Sont incapables de contracter, dans la mesure définie par la loi :
1° Les mineurs non émancipés ;
2° Les majeurs protégés au sens de l'article 425.
""";
    content_hash "sha256:cc43f588a7302a1d51e209ad4cf3ec07a8ef3204cc368105f7705b4c62c1ee22";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1147")
pub fragment CC_ART1147 in CC_COURANT {
    label fr official "Article 1147";
    kind article;
    locator "article/1147";
    text fr official """Article 1147
L'incapacité de contracter est une cause de nullité relative.
""";
    content_hash "sha256:49f31b2cf4eb3da7a06ead4d323715536369b6c96e7fb2d9238d846c5743f587";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1148")
pub fragment CC_ART1148 in CC_COURANT {
    label fr official "Article 1148";
    kind article;
    locator "article/1148";
    text fr official """Article 1148
Toute personne incapable de contracter peut néanmoins accomplir seule les actes courants autorisés par la loi ou l'usage, pourvu qu'ils soient conclus à des conditions normales.
""";
    content_hash "sha256:753a04ad9a443b52531964b5c37b622681aba4897e250164b7c611fc67f0da1d";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1149")
pub fragment CC_ART1149 in CC_COURANT {
    label fr official "Article 1149";
    kind article;
    locator "article/1149";
    text fr official """Article 1149
Les actes courants accomplis par le mineur peuvent être annulés pour simple lésion. Toutefois, la nullité n'est pas encourue lorsque la lésion résulte d'un événement imprévisible.
La simple déclaration de majorité faite par le mineur ne fait pas obstacle à l'annulation.
Le mineur ne peut se soustraire aux engagements qu'il a pris dans l'exercice de sa profession.
""";
    content_hash "sha256:33b9919ecff3a6edd574492d79604253d6df75bc3dfa369e6a891ef6507f7d1f";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1150")
pub fragment CC_ART1150 in CC_COURANT {
    label fr official "Article 1150";
    kind article;
    locator "article/1150";
    text fr official """Article 1150
Les actes accomplis par les majeurs protégés sont régis par les articles 435,465 et 494-9 sans préjudice des articles 1148,1151 et 1352-4.
""";
    content_hash "sha256:071fbf329956fe2ea32bcf720b3c2cff2a0f18ec4e217b8765a27a85cdc34664";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1151")
pub fragment CC_ART1151 in CC_COURANT {
    label fr official "Article 1151";
    kind article;
    locator "article/1151";
    text fr official """Article 1151
Le contractant capable peut faire obstacle à l'action en nullité engagée contre lui en établissant que l'acte était utile à la personne protégée et exempt de lésion ou qu'il a profité à celle-ci.
Il peut aussi opposer à l'action en nullité la confirmation de l'acte par son cocontractant devenu ou redevenu capable.
""";
    content_hash "sha256:cc6cf6d550fd65e7a5cf5f5304d0ef8ed935284369722692f720b449278eb587";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1152")
pub fragment CC_ART1152 in CC_COURANT {
    label fr official "Article 1152";
    kind article;
    locator "article/1152";
    text fr official """Article 1152
La prescription de l'action court :
1° A l'égard des actes faits par un mineur, du jour de la majorité ou de l'émancipation ;
2° A l'égard des actes faits par un majeur protégé, du jour où il en a eu connaissance alors qu'il était en situation de les refaire valablement ;
3° A l'égard des héritiers de la personne en tutelle ou en curatelle ou de la personne faisant l'objet d'une habilitation familiale, du jour du décès si elle n'a commencé à courir auparavant.
""";
    content_hash "sha256:8198c854c92dabde10ef51a1e829f6f63dd2f063992b07033b1856fe331e528a";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1153")
pub fragment CC_ART1153 in CC_COURANT {
    label fr official "Article 1153";
    kind article;
    locator "article/1153";
    text fr official """Article 1153
Le représentant légal, judiciaire ou conventionnel n'est fondé à agir que dans la limite des pouvoirs qui lui ont été conférés.
""";
    content_hash "sha256:ec8b16079e9332c1a45162423049b6a1790c24c02125a277d2a18311319a4fe8";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1154")
pub fragment CC_ART1154 in CC_COURANT {
    label fr official "Article 1154";
    kind article;
    locator "article/1154";
    text fr official """Article 1154
Lorsque le représentant agit dans la limite de ses pouvoirs au nom et pour le compte du représenté, celui-ci est seul tenu de l'engagement ainsi contracté.
Lorsque le représentant déclare agir pour le compte d'autrui mais contracte en son propre nom, il est seul engagé à l'égard du cocontractant.
""";
    content_hash "sha256:1f09b11c59458120e716dc8acbc3298d6356fc215da98bd7abc380180fb188ab";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1155")
pub fragment CC_ART1155 in CC_COURANT {
    label fr official "Article 1155";
    kind article;
    locator "article/1155";
    text fr official """Article 1155
Lorsque le pouvoir du représentant est défini en termes généraux, il ne couvre que les actes conservatoires et d'administration.
Lorsque le pouvoir est spécialement déterminé, le représentant ne peut accomplir que les actes pour lesquels il est habilité et ceux qui en sont l'accessoire.
""";
    content_hash "sha256:3843d00d655c550676e6c53b4fed385a9a00b9c4fe288462ca55bd5b1e71c79c";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1156")
pub fragment CC_ART1156 in CC_COURANT {
    label fr official "Article 1156";
    kind article;
    locator "article/1156";
    text fr official """Article 1156
L'acte accompli par un représentant sans pouvoir ou au-delà de ses pouvoirs est inopposable au représenté, sauf si le tiers contractant a légitimement cru en la réalité des pouvoirs du représentant, notamment en raison du comportement ou des déclarations du représenté.
Lorsqu'il ignorait que l'acte était accompli par un représentant sans pouvoir ou au-delà de ses pouvoirs, le tiers contractant peut en invoquer la nullité.
L'inopposabilité comme la nullité de l'acte ne peuvent plus être invoquées dès lors que le représenté l'a ratifié.
""";
    content_hash "sha256:485120ed6e32865b32958c9b610ab09be5d76e7fb8bb78ff1d57e4b515321046";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1157")
pub fragment CC_ART1157 in CC_COURANT {
    label fr official "Article 1157";
    kind article;
    locator "article/1157";
    text fr official """Article 1157
Lorsque le représentant détourne ses pouvoirs au détriment du représenté, ce dernier peut invoquer la nullité de l'acte accompli si le tiers avait connaissance du détournement ou ne pouvait l'ignorer.
""";
    content_hash "sha256:ff5aad784090eaae1eb2f39e4c606acc5ca75fd847f67985268c292aed4cdde9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1158")
pub fragment CC_ART1158 in CC_COURANT {
    label fr official "Article 1158";
    kind article;
    locator "article/1158";
    text fr official """Article 1158
Le tiers qui doute de l'étendue du pouvoir du représentant conventionnel à l'occasion d'un acte qu'il s'apprête à conclure, peut demander par écrit au représenté de lui confirmer, dans un délai qu'il fixe et qui doit être raisonnable, que le représentant est habilité à conclure cet acte.
L'écrit mentionne qu'à défaut de réponse dans ce délai, le représentant est réputé habilité à conclure cet acte.
""";
    content_hash "sha256:ac5ed84374d864f11f41448973b39b213ed847c8b85528db223c2187d6da5d39";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1159")
pub fragment CC_ART1159 in CC_COURANT {
    label fr official "Article 1159";
    kind article;
    locator "article/1159";
    text fr official """Article 1159
L'établissement d'une représentation légale ou judiciaire dessaisit pendant sa durée le représenté des pouvoirs transférés au représentant.
La représentation conventionnelle laisse au représenté l'exercice de ses droits.
""";
    content_hash "sha256:010bf208080a580514b8d48071101d88cf6851f907fb64a9b8f48bc67e7e5253";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1160")
pub fragment CC_ART1160 in CC_COURANT {
    label fr official "Article 1160";
    kind article;
    locator "article/1160";
    text fr official """Article 1160
Les pouvoirs du représentant cessent s'il est atteint d'une incapacité ou frappé d'une interdiction.
""";
    content_hash "sha256:7a2e1bbf3d4bb661564bce8b5607b7ea8e53cacb5e4b8acf678a1de303b5aa16";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1161")
pub fragment CC_ART1161 in CC_COURANT {
    label fr official "Article 1161";
    kind article;
    locator "article/1161";
    text fr official """Article 1161
En matière de représentation des personnes physiques, un représentant ne peut agir pour le compte de plusieurs parties au contrat en opposition d'intérêts ni contracter pour son propre compte avec le représenté.
En ces cas, l'acte accompli est nul à moins que la loi ne l'autorise ou que le représenté ne l'ait autorisé ou ratifié.
""";
    content_hash "sha256:69f6efe51d253bd3835730568052fa414310cbcebcfcde243f50a91bb736ee3e";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1162")
pub fragment CC_ART1162 in CC_COURANT {
    label fr official "Article 1162";
    kind article;
    locator "article/1162";
    text fr official """Article 1162
Le contrat ne peut déroger à l'ordre public ni par ses stipulations, ni par son but, que ce dernier ait été connu ou non par toutes les parties.
""";
    content_hash "sha256:60fa736f209b685a404d45b835e6a819d6af556eca264e3460d79a5d648f8c2a";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1163")
pub fragment CC_ART1163 in CC_COURANT {
    label fr official "Article 1163";
    kind article;
    locator "article/1163";
    text fr official """Article 1163
L'obligation a pour objet une prestation présente ou future.
Celle-ci doit être possible et déterminée ou déterminable.
La prestation est déterminable lorsqu'elle peut être déduite du contrat ou par référence aux usages ou aux relations antérieures des parties, sans qu'un nouvel accord des parties soit nécessaire.
""";
    content_hash "sha256:cb50add3fe5165e6b3ced2f90898374dc9b43dc26e974bfca59edf192bea64eb";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1164")
pub fragment CC_ART1164 in CC_COURANT {
    label fr official "Article 1164";
    kind article;
    locator "article/1164";
    text fr official """Article 1164
Dans les contrats cadre, il peut être convenu que le prix sera fixé unilatéralement par l'une des parties, à charge pour elle d'en motiver le montant en cas de contestation.
En cas d'abus dans la fixation du prix, le juge peut être saisi d'une demande tendant à obtenir des dommages et intérêts et le cas échéant la résolution du contrat.
""";
    content_hash "sha256:de4c7efc9d55bc0d677b013df0d2ff58c936e78364f9f611c488b92fefa8d1dc";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1165")
pub fragment CC_ART1165 in CC_COURANT {
    label fr official "Article 1165";
    kind article;
    locator "article/1165";
    text fr official """Article 1165
Dans les contrats de prestation de service, à défaut d'accord des parties avant leur exécution, le prix peut être fixé par le créancier, à charge pour lui d'en motiver le montant en cas de contestation.
En cas d'abus dans la fixation du prix, le juge peut être saisi d'une demande tendant à obtenir des dommages et intérêts et, le cas échéant, la résolution du contrat.
""";
    content_hash "sha256:1b303c4c2a8b396e0ba0b7fec2580e559ee6b979cc3d9971575da44333c358d2";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1166")
pub fragment CC_ART1166 in CC_COURANT {
    label fr official "Article 1166";
    kind article;
    locator "article/1166";
    text fr official """Article 1166
Lorsque la qualité de la prestation n'est pas déterminée ou déterminable en vertu du contrat, le débiteur doit offrir une prestation de qualité conforme aux attentes légitimes des parties en considération de sa nature, des usages et du montant de la contrepartie.
""";
    content_hash "sha256:275b09739d98ee2562feef66e7ac7249048d21a7aa17b5d634054f211789d1af";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1167")
pub fragment CC_ART1167 in CC_COURANT {
    label fr official "Article 1167";
    kind article;
    locator "article/1167";
    text fr official """Article 1167
Lorsque le prix ou tout autre élément du contrat doit être déterminé par référence à un indice qui n'existe pas ou a cessé d'exister ou d'être accessible, celui-ci est remplacé par l'indice qui s'en rapproche le plus.
""";
    content_hash "sha256:d0dd871943304b6e3952be9124b3a7465f6ab2723616020317efa4d38a4e088d";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1168")
pub fragment CC_ART1168 in CC_COURANT {
    label fr official "Article 1168";
    kind article;
    locator "article/1168";
    text fr official """Article 1168
Dans les contrats synallagmatiques, le défaut d'équivalence des prestations n'est pas une cause de nullité du contrat, à moins que la loi n'en dispose autrement.
""";
    content_hash "sha256:9a719fecdb90c0a60f689f4f9643f46cdc743d17e1779120b19caf2f24e3de3c";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1169")
pub fragment CC_ART1169 in CC_COURANT {
    label fr official "Article 1169";
    kind article;
    locator "article/1169";
    text fr official """Article 1169
Un contrat à titre onéreux est nul lorsque, au moment de sa formation, la contrepartie convenue au profit de celui qui s'engage est illusoire ou dérisoire.
""";
    content_hash "sha256:f5d73275a54d93d6dbd3447554237ab652935907a102c6c23f404eda587b0330";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1170")
pub fragment CC_ART1170 in CC_COURANT {
    label fr official "Article 1170";
    kind article;
    locator "article/1170";
    text fr official """Article 1170
Toute clause qui prive de sa substance l'obligation essentielle du débiteur est réputée non écrite.
""";
    content_hash "sha256:e2ec950b98649a397721d0b98f1deeeb274f0eaebdfb30def7333a4633f5a1d4";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1171")
pub fragment CC_ART1171 in CC_COURANT {
    label fr official "Article 1171";
    kind article;
    locator "article/1171";
    text fr official """Article 1171
Dans un contrat d'adhésion, toute clause non négociable, déterminée à l'avance par l'une des parties, qui crée un déséquilibre significatif entre les droits et obligations des parties au contrat est réputée non écrite.
L'appréciation du déséquilibre significatif ne porte ni sur l'objet principal du contrat ni sur l'adéquation du prix à la prestation.
""";
    content_hash "sha256:00b7169431072c3634c6809379761844f1c435009a11f05b96f66c4713f4dd3e";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1172")
pub fragment CC_ART1172 in CC_COURANT {
    label fr official "Article 1172";
    kind article;
    locator "article/1172";
    text fr official """Article 1172
Les contrats sont par principe consensuels.
Par exception, la validité des contrats solennels est subordonnée à l'observation de formes déterminées par la loi à défaut de laquelle le contrat est nul, sauf possible régularisation.
En outre, la loi subordonne la formation de certains contrats à la remise d'une chose.
""";
    content_hash "sha256:973d1e9c4beb99290bd1d692689c89d9cfa0e7426abddda9dfba477370f92b71";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1173")
pub fragment CC_ART1173 in CC_COURANT {
    label fr official "Article 1173";
    kind article;
    locator "article/1173";
    text fr official """Article 1173
Les formes exigées aux fins de preuve ou d'opposabilité sont sans effet sur la validité des contrats.
""";
    content_hash "sha256:008d6b02c1aa8803dc7ee5dc3ace5339a21b24d1a934c1ac9417c649b0542503";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1174")
pub fragment CC_ART1174 in CC_COURANT {
    label fr official "Article 1174";
    kind article;
    locator "article/1174";
    text fr official """Article 1174
Lorsqu'un écrit est exigé pour la validité d'un contrat, il peut être établi et conservé sous forme électronique dans les conditions prévues aux articles 1366 et 1367 et, lorsqu'un acte authentique est requis, au deuxième alinéa de l'article 1369.
Lorsqu'est exigée une mention écrite de la main même de celui qui s'oblige, ce dernier peut l'apposer sous forme électronique si les conditions de cette apposition sont de nature à garantir qu'elle ne peut être effectuée que par lui-même.
""";
    content_hash "sha256:438de93bf7ed45b5dfd8115b5bb298e05c76069fe48aa9c914cb09d460dbc003";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1175")
pub fragment CC_ART1175 in CC_COURANT {
    label fr official "Article 1175";
    kind article;
    locator "article/1175";
    text fr official """Article 1175
Il est fait exception aux dispositions de l'article précédent pour les actes sous signature privée relatifs au droit de la famille et des successions, sauf les conventions sous signature privée contresignées par avocats en présence des parties et déposées au rang des minutes d'un notaire selon les modalités prévues aux articles 229-1 à 229-4 ou à l'article 298.
""";
    content_hash "sha256:c0834ab433a9747ce1413db91a05775392585247d7e093a2a2df39708703a9bc";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1176")
pub fragment CC_ART1176 in CC_COURANT {
    label fr official "Article 1176";
    kind article;
    locator "article/1176";
    text fr official """Article 1176
Lorsque l'écrit sur papier est soumis à des conditions particulières de lisibilité ou de présentation, l'écrit électronique doit répondre à des exigences équivalentes.
L'exigence d'un formulaire détachable est satisfaite par un procédé électronique qui permet d'accéder au formulaire et de le renvoyer par la même voie.
""";
    content_hash "sha256:bd9833f61889ae7af3b24d32fbfee54757f0b72b00c4b4b625c974a9a1309ea6";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1177")
pub fragment CC_ART1177 in CC_COURANT {
    label fr official "Article 1177";
    kind article;
    locator "article/1177";
    text fr official """Article 1177
L'exigence d'un envoi en plusieurs exemplaires est réputée satisfaite par voie électronique si l'écrit peut être imprimé par le destinataire.
""";
    content_hash "sha256:dbc89985098ef4a83763be7628f47c98116ddfaf384b400e0f69e87dde817c15";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1178")
pub fragment CC_ART1178 in CC_COURANT {
    label fr official "Article 1178";
    kind article;
    locator "article/1178";
    text fr official """Article 1178
Un contrat qui ne remplit pas les conditions requises pour sa validité est nul. La nullité doit être prononcée par le juge, à moins que les parties ne la constatent d'un commun accord.
Le contrat annulé est censé n'avoir jamais existé.
Les prestations exécutées donnent lieu à restitution dans les conditions prévues aux articles 1352 à 1352-9.
Indépendamment de l'annulation du contrat, la partie lésée peut demander réparation du dommage subi dans les conditions du droit commun de la responsabilité extracontractuelle.
""";
    content_hash "sha256:33997b180c9552932afc13382a7b8f7df808c6551ad726004ca2ddcc66c9fb72";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1179")
pub fragment CC_ART1179 in CC_COURANT {
    label fr official "Article 1179";
    kind article;
    locator "article/1179";
    text fr official """Article 1179
La nullité est absolue lorsque la règle violée a pour objet la sauvegarde de l'intérêt général.
Elle est relative lorsque la règle violée a pour seul objet la sauvegarde d'un intérêt privé.
""";
    content_hash "sha256:66a969c6a6bcca85ac7ec3ac785e89d5efc8f134e1ce939f6851999c3d8f1018";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1180")
pub fragment CC_ART1180 in CC_COURANT {
    label fr official "Article 1180";
    kind article;
    locator "article/1180";
    text fr official """Article 1180
La nullité absolue peut être demandée par toute personne justifiant d'un intérêt, ainsi que par le ministère public.
Elle ne peut être couverte par la confirmation du contrat.
""";
    content_hash "sha256:253ce02a14694e1ef5e49c58557d428d94307cf8157eb20f7898461692f3351f";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1181")
pub fragment CC_ART1181 in CC_COURANT {
    label fr official "Article 1181";
    kind article;
    locator "article/1181";
    text fr official """Article 1181
La nullité relative ne peut être demandée que par la partie que la loi entend protéger.
Elle peut être couverte par la confirmation.
Si l'action en nullité relative a plusieurs titulaires, la renonciation de l'un n'empêche pas les autres d'agir.
""";
    content_hash "sha256:4cdde7c64f9a8034200283cc0c12fa2766f316bca3bdd5b2fc8827e558629e6e";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1182")
pub fragment CC_ART1182 in CC_COURANT {
    label fr official "Article 1182";
    kind article;
    locator "article/1182";
    text fr official """Article 1182
La confirmation est l'acte par lequel celui qui pourrait se prévaloir de la nullité y renonce. Cet acte mentionne l'objet de l'obligation et le vice affectant le contrat.
La confirmation ne peut intervenir qu'après la conclusion du contrat.
L'exécution volontaire du contrat, en connaissance de la cause de nullité, vaut confirmation. En cas de violence, la confirmation ne peut intervenir qu'après que la violence a cessé.
La confirmation emporte renonciation aux moyens et exceptions qui pouvaient être opposés, sans préjudice néanmoins des droits des tiers.
""";
    content_hash "sha256:c974462e10c01721d51aee08c21fa48c96414ac22f42b0494558c60a095a29d9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1183")
pub fragment CC_ART1183 in CC_COURANT {
    label fr official "Article 1183";
    kind article;
    locator "article/1183";
    text fr official """Article 1183
Une partie peut demander par écrit à celle qui pourrait se prévaloir de la nullité soit de confirmer le contrat soit d'agir en nullité dans un délai de six mois à peine de forclusion. La cause de la nullité doit avoir cessé.
L'écrit mentionne expressément qu'à défaut d'action en nullité exercée avant l'expiration du délai de six mois, le contrat sera réputé confirmé.
""";
    content_hash "sha256:07ec8221b98821e515db97d35eb04b5bb7f31ac1c5476ba05edf2d7bb223a381";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1184")
pub fragment CC_ART1184 in CC_COURANT {
    label fr official "Article 1184";
    kind article;
    locator "article/1184";
    text fr official """Article 1184
Lorsque la cause de nullité n'affecte qu'une ou plusieurs clauses du contrat, elle n'emporte nullité de l'acte tout entier que si cette ou ces clauses ont constitué un élément déterminant de l'engagement des parties ou de l'une d'elles.
Le contrat est maintenu lorsque la loi répute la clause non écrite, ou lorsque les fins de la règle méconnue exigent son maintien.
""";
    content_hash "sha256:0b38310548a5c40ee5b70530c7022aa55259e66ff21b35f003850ce605cc0853";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1185")
pub fragment CC_ART1185 in CC_COURANT {
    label fr official "Article 1185";
    kind article;
    locator "article/1185";
    text fr official """Article 1185
L'exception de nullité ne se prescrit pas si elle se rapporte à un contrat qui n'a reçu aucune exécution.
""";
    content_hash "sha256:8cfa9b77739e80a257db474d23bb9152f7b45670702271edb254964a57120c66";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1186")
pub fragment CC_ART1186 in CC_COURANT {
    label fr official "Article 1186";
    kind article;
    locator "article/1186";
    text fr official """Article 1186
Un contrat valablement formé devient caduc si l'un de ses éléments essentiels disparaît.
Lorsque l'exécution de plusieurs contrats est nécessaire à la réalisation d'une même opération et que l'un d'eux disparaît, sont caducs les contrats dont l'exécution est rendue impossible par cette disparition et ceux pour lesquels l'exécution du contrat disparu était une condition déterminante du consentement d'une partie.
La caducité n'intervient toutefois que si le contractant contre lequel elle est invoquée connaissait l'existence de l'opération d'ensemble lorsqu'il a donné son consentement.
""";
    content_hash "sha256:70fab7be626475be07779037cb0ca60cdb00b407e6b20b3eb58db70f5ea39587";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1187")
pub fragment CC_ART1187 in CC_COURANT {
    label fr official "Article 1187";
    kind article;
    locator "article/1187";
    text fr official """Article 1187
La caducité met fin au contrat.
Elle peut donner lieu à restitution dans les conditions prévues aux articles 1352 à 1352-9.
""";
    content_hash "sha256:907d8dce33a7330376c125113849bc13ed21cc2b8eaa1c0014a710a6a21fbc05";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1188")
pub fragment CC_ART1188 in CC_COURANT {
    label fr official "Article 1188";
    kind article;
    locator "article/1188";
    text fr official """Article 1188
Le contrat s'interprète d'après la commune intention des parties plutôt qu'en s'arrêtant au sens littéral de ses termes.
Lorsque cette intention ne peut être décelée, le contrat s'interprète selon le sens que lui donnerait une personne raisonnable placée dans la même situation.
""";
    content_hash "sha256:1368de1c6973076f8c7f0d10c3bde47cb7834c522b99777ca148925e394009bc";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1189")
pub fragment CC_ART1189 in CC_COURANT {
    label fr official "Article 1189";
    kind article;
    locator "article/1189";
    text fr official """Article 1189
Toutes les clauses d'un contrat s'interprètent les unes par rapport aux autres, en donnant à chacune le sens qui respecte la cohérence de l'acte tout entier.
Lorsque, dans l'intention commune des parties, plusieurs contrats concourent à une même opération, ils s'interprètent en fonction de celle-ci.
""";
    content_hash "sha256:07dcdb76f9e44963d54291d8851017f0df792b95ff5424b2742886cbd9cdf9e5";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1190")
pub fragment CC_ART1190 in CC_COURANT {
    label fr official "Article 1190";
    kind article;
    locator "article/1190";
    text fr official """Article 1190
Dans le doute, le contrat de gré à gré s'interprète contre le créancier et en faveur du débiteur, et le contrat d'adhésion contre celui qui l'a proposé.
""";
    content_hash "sha256:f2959f5d30e4b750169f3b26c262293700d3d3aa055dfe70c01d3963696a435b";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1191")
pub fragment CC_ART1191 in CC_COURANT {
    label fr official "Article 1191";
    kind article;
    locator "article/1191";
    text fr official """Article 1191
Lorsqu'une clause est susceptible de deux sens, celui qui lui confère un effet l'emporte sur celui qui ne lui en fait produire aucun.
""";
    content_hash "sha256:d9cd7e7cf92330d698bf81c91f10b94de35712446885dcf1b48bb70c67ee9c57";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1192")
pub fragment CC_ART1192 in CC_COURANT {
    label fr official "Article 1192";
    kind article;
    locator "article/1192";
    text fr official """Article 1192
On ne peut interpréter les clauses claires et précises à peine de dénaturation.
""";
    content_hash "sha256:0e9fe58a0cd377f00965f29a3d64c35875b6e05b6b181e9bad75e48a0cf54565";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1193")
pub fragment CC_ART1193 in CC_COURANT {
    label fr official "Article 1193";
    kind article;
    locator "article/1193";
    text fr official """Article 1193
Les contrats ne peuvent être modifiés ou révoqués que du consentement mutuel des parties, ou pour les causes que la loi autorise.
""";
    content_hash "sha256:ac1a2926a87ca2232841009a5229e86067c6ff70be1e42bed4c3d75f1a746965";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1194")
pub fragment CC_ART1194 in CC_COURANT {
    label fr official "Article 1194";
    kind article;
    locator "article/1194";
    text fr official """Article 1194
Les contrats obligent non seulement à ce qui y est exprimé, mais encore à toutes les suites que leur donnent l'équité, l'usage ou la loi.
""";
    content_hash "sha256:bc917ec91646d63813eae72974e4ae035d37a749875d40a4e9abc9dd88f905de";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1195")
pub fragment CC_ART1195 in CC_COURANT {
    label fr official "Article 1195";
    kind article;
    locator "article/1195";
    text fr official """Article 1195
Si un changement de circonstances imprévisible lors de la conclusion du contrat rend l'exécution excessivement onéreuse pour une partie qui n'avait pas accepté d'en assumer le risque, celle-ci peut demander une renégociation du contrat à son cocontractant. Elle continue à exécuter ses obligations durant la renégociation.
En cas de refus ou d'échec de la renégociation, les parties peuvent convenir de la résolution du contrat, à la date et aux conditions qu'elles déterminent, ou demander d'un commun accord au juge de procéder à son adaptation. A défaut d'accord dans un délai raisonnable, le juge peut, à la demande d'une partie, réviser le contrat ou y mettre fin, à la date et aux conditions qu'il fixe.
""";
    content_hash "sha256:f52183efb4cbffbed5bf0be7d6ed836355d13439e44c5b467134001a296abdff";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1196")
pub fragment CC_ART1196 in CC_COURANT {
    label fr official "Article 1196";
    kind article;
    locator "article/1196";
    text fr official """Article 1196
Dans les contrats ayant pour objet l'aliénation de la propriété ou la cession d'un autre droit, le transfert s'opère lors de la conclusion du contrat.
Ce transfert peut être différé par la volonté des parties, la nature des choses ou par l'effet de la loi.
Le transfert de propriété emporte transfert des risques de la chose. Toutefois le débiteur de l'obligation de délivrer en retrouve la charge à compter de sa mise en demeure, conformément à l'article 1344-2 et sous réserve des règles prévues à l'article 1351-1.
""";
    content_hash "sha256:165721e42786212b358d2f51be684f849ff7c68e9542ea4d8b020bafabbb4919";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1197")
pub fragment CC_ART1197 in CC_COURANT {
    label fr official "Article 1197";
    kind article;
    locator "article/1197";
    text fr official """Article 1197
L'obligation de délivrer la chose emporte obligation de la conserver jusqu'à la délivrance, en y apportant tous les soins d'une personne raisonnable.
""";
    content_hash "sha256:be513571788547f40f2a00269fc725d81301107ddcf2def444819a288967f789";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1198")
pub fragment CC_ART1198 in CC_COURANT {
    label fr official "Article 1198";
    kind article;
    locator "article/1198";
    text fr official """Article 1198
Lorsque deux acquéreurs successifs d'un même meuble corporel tiennent leur droit d'une même personne, celui qui a pris possession de ce meuble en premier est préféré, même si son droit est postérieur, à condition qu'il soit de bonne foi.
Lorsque deux acquéreurs successifs de droits portant sur un même immeuble tiennent leur droit d'une même personne, celui qui a, le premier, publié son titre d'acquisition passé en la forme authentique au fichier immobilier est préféré, même si son droit est postérieur, à condition qu'il soit de bonne foi.
""";
    content_hash "sha256:f2c0aa6a45574ca09fbb85e1d3534e54621bb080f411302819310f6125d1f7e3";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1199")
pub fragment CC_ART1199 in CC_COURANT {
    label fr official "Article 1199";
    kind article;
    locator "article/1199";
    text fr official """Article 1199
Le contrat ne crée d'obligations qu'entre les parties.
Les tiers ne peuvent ni demander l'exécution du contrat ni se voir contraints de l'exécuter, sous réserve des dispositions de la présente section et de celles du chapitre III du titre IV.
""";
    content_hash "sha256:b137d83381fa1d69583e90ad09ab063616161efe912c27150f9f6702e654349a";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1200")
pub fragment CC_ART1200 in CC_COURANT {
    label fr official "Article 1200";
    kind article;
    locator "article/1200";
    text fr official """Article 1200
Les tiers doivent respecter la situation juridique créée par le contrat.
Ils peuvent s'en prévaloir notamment pour apporter la preuve d'un fait.
""";
    content_hash "sha256:a71adcd9ba28a37399dc530a745b5873c7c3322b3274f7c707d7cef5c8242bf9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1201")
pub fragment CC_ART1201 in CC_COURANT {
    label fr official "Article 1201";
    kind article;
    locator "article/1201";
    text fr official """Article 1201
Lorsque les parties ont conclu un contrat apparent qui dissimule un contrat occulte, ce dernier, appelé aussi contre-lettre, produit effet entre les parties. Il n'est pas opposable aux tiers, qui peuvent néanmoins s'en prévaloir.
""";
    content_hash "sha256:c13ff3f80fd5c27e72d3411d6bcc1c0936e7094685cb77a0d763d15aa5a4753a";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1202")
pub fragment CC_ART1202 in CC_COURANT {
    label fr official "Article 1202";
    kind article;
    locator "article/1202";
    text fr official """Article 1202
Est nulle toute contre-lettre ayant pour objet une augmentation du prix stipulé dans le traité de cession d'un office ministériel.
Est également nul tout contrat ayant pour but de dissimuler une partie du prix, lorsqu'elle porte sur une vente d'immeubles, une cession de fonds de commerce ou de clientèle, une cession d'un droit à un bail, ou le bénéfice d'une promesse de bail portant sur tout ou partie d'un immeuble et tout ou partie de la soulte d'un échange ou d'un partage comprenant des biens immeubles, un fonds de commerce ou une clientèle.
""";
    content_hash "sha256:2e31aa577715145214318b2c5cb7e137bcf27b2f9cf9df3012731eb873cd7303";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1203")
pub fragment CC_ART1203 in CC_COURANT {
    label fr official "Article 1203";
    kind article;
    locator "article/1203";
    text fr official """Article 1203
On ne peut s'engager en son propre nom que pour soi-même.
""";
    content_hash "sha256:24977b6d247a1151ed35b183bfacfd73e99e3dc94474dc4858186878a2d92b4c";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1204")
pub fragment CC_ART1204 in CC_COURANT {
    label fr official "Article 1204";
    kind article;
    locator "article/1204";
    text fr official """Article 1204
On peut se porter fort en promettant le fait d'un tiers.
Le promettant est libéré de toute obligation si le tiers accomplit le fait promis. Dans le cas contraire, il peut être condamné à des dommages et intérêts.
Lorsque le porte-fort a pour objet la ratification d'un engagement, celui-ci est rétroactivement validé à la date à laquelle le porte-fort a été souscrit.
""";
    content_hash "sha256:b84ea5de23e6aa08c397952884aa763aa56395bf7f0e97c05b0f8ac55abe3790";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1205")
pub fragment CC_ART1205 in CC_COURANT {
    label fr official "Article 1205";
    kind article;
    locator "article/1205";
    text fr official """Article 1205
On peut stipuler pour autrui.
L'un des contractants, le stipulant, peut faire promettre à l'autre, le promettant, d'accomplir une prestation au profit d'un tiers, le bénéficiaire. Ce dernier peut être une personne future mais doit être précisément désigné ou pouvoir être déterminé lors de l'exécution de la promesse.
""";
    content_hash "sha256:da0be96a6339c132df25651f811385b4c330b14071043ea71dfc44d84594415a";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1206")
pub fragment CC_ART1206 in CC_COURANT {
    label fr official "Article 1206";
    kind article;
    locator "article/1206";
    text fr official """Article 1206
Le bénéficiaire est investi d'un droit direct à la prestation contre le promettant dès la stipulation.
Néanmoins le stipulant peut librement révoquer la stipulation tant que le bénéficiaire ne l'a pas acceptée.
La stipulation devient irrévocable au moment où l'acceptation parvient au stipulant ou au promettant.
""";
    content_hash "sha256:4b1a0476b352441454e5f2f30b0facce5d1e69dc0369e891a8d7789d7d412591";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1207")
pub fragment CC_ART1207 in CC_COURANT {
    label fr official "Article 1207";
    kind article;
    locator "article/1207";
    text fr official """Article 1207
La révocation ne peut émaner que du stipulant ou, après son décès, de ses héritiers. Ces derniers ne peuvent y procéder qu'à l'expiration d'un délai de trois mois à compter du jour où ils ont mis le bénéficiaire en demeure de l'accepter.
Si elle n'est pas assortie de la désignation d'un nouveau bénéficiaire, la révocation profite, selon le cas, au stipulant ou à ses héritiers.
La révocation produit effet dès lors que le tiers bénéficiaire ou le promettant en a eu connaissance.
Lorsqu'elle est faite par testament, elle prend effet au moment du décès.
Le tiers initialement désigné est censé n'avoir jamais bénéficié de la stipulation faite à son profit.
""";
    content_hash "sha256:96a32b191f661d9c453f82891fa3ea0bd4263b18713e3c03bc04ca03182eb865";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1208")
pub fragment CC_ART1208 in CC_COURANT {
    label fr official "Article 1208";
    kind article;
    locator "article/1208";
    text fr official """Article 1208
L'acceptation peut émaner du bénéficiaire ou, après son décès, de ses héritiers. Elle peut être expresse ou tacite. Elle peut intervenir même après le décès du stipulant ou du promettant.
""";
    content_hash "sha256:6a89ed4fdf3b9c56fc2fc98b1c4ebede4ba7783c20fb5b15f842fbe2cbbbc1df";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1209")
pub fragment CC_ART1209 in CC_COURANT {
    label fr official "Article 1209";
    kind article;
    locator "article/1209";
    text fr official """Article 1209
Le stipulant peut lui-même exiger du promettant l'exécution de son engagement envers le bénéficiaire.
""";
    content_hash "sha256:0734fe5aeb68a64e8bcf4d2cabdfdb4cc21970d01f7a63bb34bc4ebd45e42dfd";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1210")
pub fragment CC_ART1210 in CC_COURANT {
    label fr official "Article 1210";
    kind article;
    locator "article/1210";
    text fr official """Article 1210
Les engagements perpétuels sont prohibés.
Chaque contractant peut y mettre fin dans les conditions prévues pour le contrat à durée indéterminée.
""";
    content_hash "sha256:62714934662a5c92fa56325a4bea573bb862951c2bdcc254b361d5235bc4eb0b";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1211")
pub fragment CC_ART1211 in CC_COURANT {
    label fr official "Article 1211";
    kind article;
    locator "article/1211";
    text fr official """Article 1211
Lorsque le contrat est conclu pour une durée indéterminée, chaque partie peut y mettre fin à tout moment, sous réserve de respecter le délai de préavis contractuellement prévu ou, à défaut, un délai raisonnable.
""";
    content_hash "sha256:b3c80e980ba10ecde065cc7eff996fd5d4699e8e1d4c6ea7d729e15597c753bc";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1212")
pub fragment CC_ART1212 in CC_COURANT {
    label fr official "Article 1212";
    kind article;
    locator "article/1212";
    text fr official """Article 1212
Lorsque le contrat est conclu pour une durée déterminée, chaque partie doit l'exécuter jusqu'à son terme.
Nul ne peut exiger le renouvellement du contrat.
""";
    content_hash "sha256:b5a882bcb902b40d1f39e24ace2f04320821f3981513596fe0453d3b3b65f3d6";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1213")
pub fragment CC_ART1213 in CC_COURANT {
    label fr official "Article 1213";
    kind article;
    locator "article/1213";
    text fr official """Article 1213
Le contrat peut être prorogé si les contractants en manifestent la volonté avant son expiration. La prorogation ne peut porter atteinte aux droits des tiers.
""";
    content_hash "sha256:c65f358750cad70ac436f53a647c17e61c76f4752e6134a2375dae6dd406cbcb";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1214")
pub fragment CC_ART1214 in CC_COURANT {
    label fr official "Article 1214";
    kind article;
    locator "article/1214";
    text fr official """Article 1214
Le contrat à durée déterminée peut être renouvelé par l'effet de la loi ou par l'accord des parties.
Le renouvellement donne naissance à un nouveau contrat dont le contenu est identique au précédent mais dont la durée est indéterminée.
""";
    content_hash "sha256:e5cd87d1b4800595aa472e6362e92464d7f02dd132c7b8e095ef0ef899d6b6b3";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1215")
pub fragment CC_ART1215 in CC_COURANT {
    label fr official "Article 1215";
    kind article;
    locator "article/1215";
    text fr official """Article 1215
Lorsqu'à l'expiration du terme d'un contrat conclu à durée déterminée, les contractants continuent d'en exécuter les obligations, il y a tacite reconduction. Celle-ci produit les mêmes effets que le renouvellement du contrat.
""";
    content_hash "sha256:bcbc50a941d2cff26afeb6f1cf27aed7debee21139b9010ff3e890aee53d3d48";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1216")
pub fragment CC_ART1216 in CC_COURANT {
    label fr official "Article 1216";
    kind article;
    locator "article/1216";
    text fr official """Article 1216
Un contractant, le cédant, peut céder sa qualité de partie au contrat à un tiers, le cessionnaire, avec l'accord de son cocontractant, le cédé.
Cet accord peut être donné par avance, notamment dans le contrat conclu entre les futurs cédant et cédé, auquel cas la cession produit effet à l'égard du cédé lorsque le contrat conclu entre le cédant et le cessionnaire lui est notifié ou lorsqu'il en prend acte.
La cession doit être constatée par écrit, à peine de nullité.
""";
    content_hash "sha256:9b3cbd637261c1877881929abdfc13d2e237ee2029e180f215511dc4469bed9f";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1216_1")
pub fragment CC_ART1216_1 in CC_COURANT {
    label fr official "Article 1216-1";
    kind article;
    locator "article/1216-1";
    text fr official """Article 1216-1
Si le cédé y a expressément consenti, la cession de contrat libère le cédant pour l'avenir.
A défaut, et sauf clause contraire, le cédant est tenu solidairement à l'exécution du contrat.
""";
    content_hash "sha256:575f95765c562b4643272a57ed39240ebeca6f01be258372e53cd028121971c9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1216_2")
pub fragment CC_ART1216_2 in CC_COURANT {
    label fr official "Article 1216-2";
    kind article;
    locator "article/1216-2";
    text fr official """Article 1216-2
Le cessionnaire peut opposer au cédé les exceptions inhérentes à la dette, telles que la nullité, l'exception d'inexécution, la résolution ou la compensation de dettes connexes. Il ne peut lui opposer les exceptions personnelles au cédant.
Le cédé peut opposer au cessionnaire toutes les exceptions qu'il aurait pu opposer au cédant.
""";
    content_hash "sha256:10c7391a372f95ba1eede6af372d8a5aeb80eaf352e394ca76948804ae452ff7";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1216_3")
pub fragment CC_ART1216_3 in CC_COURANT {
    label fr official "Article 1216-3";
    kind article;
    locator "article/1216-3";
    text fr official """Article 1216-3
Si le cédant n'est pas libéré par le cédé, les sûretés qui ont pu être consenties subsistent. Dans le cas contraire, les sûretés consenties par le cédant ou par des tiers ne subsistent qu'avec leur accord.
Si le cédant est libéré, ses codébiteurs solidaires restent tenus déduction faite de sa part dans la dette.
""";
    content_hash "sha256:8f86e1596355f19a21e2abc0d379568a13c6e6956c6288d7ec02dd8b3dd4a097";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1217")
pub fragment CC_ART1217 in CC_COURANT {
    label fr official "Article 1217";
    kind article;
    locator "article/1217";
    text fr official """Article 1217
La partie envers laquelle l'engagement n'a pas été exécuté, ou l'a été imparfaitement, peut :
- refuser d'exécuter ou suspendre l'exécution de sa propre obligation ;
- poursuivre l'exécution forcée en nature de l'obligation ;
- obtenir une réduction du prix ;
- provoquer la résolution du contrat ;
- demander réparation des conséquences de l'inexécution.
Les sanctions qui ne sont pas incompatibles peuvent être cumulées ; des dommages et intérêts peuvent toujours s'y ajouter.
""";
    content_hash "sha256:8b7e1a606a737ba82cb4d300bfbead0768d773aafb75b621c21cf72602d65d62";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1218")
pub fragment CC_ART1218 in CC_COURANT {
    label fr official "Article 1218";
    kind article;
    locator "article/1218";
    text fr official """Article 1218
Il y a force majeure en matière contractuelle lorsqu'un événement échappant au contrôle du débiteur, qui ne pouvait être raisonnablement prévu lors de la conclusion du contrat et dont les effets ne peuvent être évités par des mesures appropriées, empêche l'exécution de son obligation par le débiteur.
Si l'empêchement est temporaire, l'exécution de l'obligation est suspendue à moins que le retard qui en résulterait ne justifie la résolution du contrat. Si l'empêchement est définitif, le contrat est résolu de plein droit et les parties sont libérées de leurs obligations dans les conditions prévues aux articles 1351 et 1351-1.
""";
    content_hash "sha256:1fcdfca1c9dd05252770d82a1123fbec46b5395f6238885c9323c1657ae2b1e9";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1219")
pub fragment CC_ART1219 in CC_COURANT {
    label fr official "Article 1219";
    kind article;
    locator "article/1219";
    text fr official """Article 1219
Une partie peut refuser d'exécuter son obligation, alors même que celle-ci est exigible, si l'autre n'exécute pas la sienne et si cette inexécution est suffisamment grave.
""";
    content_hash "sha256:a1fa898ba1b8b23798b1ebbbe1a244ffe5db867bf9b7a8242776a3556a372ee1";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1220")
pub fragment CC_ART1220 in CC_COURANT {
    label fr official "Article 1220";
    kind article;
    locator "article/1220";
    text fr official """Article 1220
Une partie peut suspendre l'exécution de son obligation dès lors qu'il est manifeste que son cocontractant ne s'exécutera pas à l'échéance et que les conséquences de cette inexécution sont suffisamment graves pour elle. Cette suspension doit être notifiée dans les meilleurs délais.
""";
    content_hash "sha256:e54863c47855ea869d858d2a24696c4c01ed90bb526fee764c8cb2caaaab0486";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1221")
pub fragment CC_ART1221 in CC_COURANT {
    label fr official "Article 1221";
    kind article;
    locator "article/1221";
    text fr official """Article 1221
Le créancier d'une obligation peut, après mise en demeure, en poursuivre l'exécution en nature sauf si cette exécution est impossible ou s'il existe une disproportion manifeste entre son coût pour le débiteur de bonne foi et son intérêt pour le créancier.
""";
    content_hash "sha256:475ba9c80345117f00c050f924a8eb7f13b36263ddd5fd1673a812ac82aff4d7";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1222")
pub fragment CC_ART1222 in CC_COURANT {
    label fr official "Article 1222";
    kind article;
    locator "article/1222";
    text fr official """Article 1222
Après mise en demeure, le créancier peut aussi, dans un délai et à un coût raisonnables, faire exécuter lui-même l'obligation ou, sur autorisation préalable du juge, détruire ce qui a été fait en violation de celle-ci. Il peut demander au débiteur le remboursement des sommes engagées à cette fin.
Il peut aussi demander en justice que le débiteur avance les sommes nécessaires à cette exécution ou à cette destruction.
""";
    content_hash "sha256:7fdc53d1e25749d26c14d3c7630d010e81ef897fd6c94e219807933a9e2f652b";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1223")
pub fragment CC_ART1223 in CC_COURANT {
    label fr official "Article 1223";
    kind article;
    locator "article/1223";
    text fr official """Article 1223
En cas d'exécution imparfaite de la prestation, le créancier peut, après mise en demeure et s'il n'a pas encore payé tout ou partie de la prestation, notifier dans les meilleurs délais au débiteur sa décision d'en réduire de manière proportionnelle le prix. L'acceptation par le débiteur de la décision de réduction de prix du créancier doit être rédigée par écrit. Si le créancier a déjà payé, à défaut d'accord entre les parties, il peut demander au juge la réduction de prix.
""";
    content_hash "sha256:d58793dc793bc26dd04e9622f79caa15b7f1e3d065f2f3289112a0fcc7a4c103";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1224")
pub fragment CC_ART1224 in CC_COURANT {
    label fr official "Article 1224";
    kind article;
    locator "article/1224";
    text fr official """Article 1224
La résolution résulte soit de l'application d'une clause résolutoire soit, en cas d'inexécution suffisamment grave, d'une notification du créancier au débiteur ou d'une décision de justice.
""";
    content_hash "sha256:f4279bf37c79bf7589d99511fe216503103395c0184df447d7cb57804b8d0a38";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1225")
pub fragment CC_ART1225 in CC_COURANT {
    label fr official "Article 1225";
    kind article;
    locator "article/1225";
    text fr official """Article 1225
La clause résolutoire précise les engagements dont l'inexécution entraînera la résolution du contrat.
La résolution est subordonnée à une mise en demeure infructueuse, s'il n'a pas été convenu que celle-ci résulterait du seul fait de l'inexécution. La mise en demeure ne produit effet que si elle mentionne expressément la clause résolutoire.
""";
    content_hash "sha256:12272cdb90355cdcc5ce864870ab948fa975c5fdfafa4cdb7b173c535efae279";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1226")
pub fragment CC_ART1226 in CC_COURANT {
    label fr official "Article 1226";
    kind article;
    locator "article/1226";
    text fr official """Article 1226
Le créancier peut, à ses risques et périls, résoudre le contrat par voie de notification. Sauf urgence, il doit préalablement mettre en demeure le débiteur défaillant de satisfaire à son engagement dans un délai raisonnable.
La mise en demeure mentionne expressément qu'à défaut pour le débiteur de satisfaire à son obligation, le créancier sera en droit de résoudre le contrat.
Lorsque l'inexécution persiste, le créancier notifie au débiteur la résolution du contrat et les raisons qui la motivent.
Le débiteur peut à tout moment saisir le juge pour contester la résolution. Le créancier doit alors prouver la gravité de l'inexécution.
""";
    content_hash "sha256:076bd623d24e03522b0820a16ecee0d60586e6e39cbf60d58b20b7167c18b744";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1227")
pub fragment CC_ART1227 in CC_COURANT {
    label fr official "Article 1227";
    kind article;
    locator "article/1227";
    text fr official """Article 1227
La résolution peut, en toute hypothèse, être demandée en justice.
""";
    content_hash "sha256:5c0c2e21a3ff9419c26f2d869df340a58c2cc701eecbbd4caf0e3b26a3066825";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1228")
pub fragment CC_ART1228 in CC_COURANT {
    label fr official "Article 1228";
    kind article;
    locator "article/1228";
    text fr official """Article 1228
Le juge peut, selon les circonstances, constater ou prononcer la résolution ou ordonner l'exécution du contrat, en accordant éventuellement un délai au débiteur, ou allouer seulement des dommages et intérêts.
""";
    content_hash "sha256:a8859feb7e43fe47402be801eb2c77904afcd4877330ea120c212dabcb1d50e3";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1229")
pub fragment CC_ART1229 in CC_COURANT {
    label fr official "Article 1229";
    kind article;
    locator "article/1229";
    text fr official """Article 1229
La résolution met fin au contrat.
La résolution prend effet, selon les cas, soit dans les conditions prévues par la clause résolutoire, soit à la date de la réception par le débiteur de la notification faite par le créancier, soit à la date fixée par le juge ou, à défaut, au jour de l'assignation en justice.
Lorsque les prestations échangées ne pouvaient trouver leur utilité que par l'exécution complète du contrat résolu, les parties doivent restituer l'intégralité de ce qu'elles se sont procuré l'une à l'autre. Lorsque les prestations échangées ont trouvé leur utilité au fur et à mesure de l'exécution réciproque du contrat, il n'y a pas lieu à restitution pour la période antérieure à la dernière prestation n'ayant pas reçu sa contrepartie ; dans ce cas, la résolution est qualifiée de résiliation.
Les restitutions ont lieu dans les conditions prévues aux articles 1352 à 1352-9.
""";
    content_hash "sha256:f11ed5f2dd3ece5fa37e6b5b425e3079f5c2d34a6bddfe5205fb2812ca120696";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1230")
pub fragment CC_ART1230 in CC_COURANT {
    label fr official "Article 1230";
    kind article;
    locator "article/1230";
    text fr official """Article 1230
La résolution n'affecte ni les clauses relatives au règlement des différends, ni celles destinées à produire effet même en cas de résolution, telles les clauses de confidentialité et de non-concurrence.
""";
    content_hash "sha256:26819896c9f8b91b5c498374df7cc54140c454889cc332fdff9fb3985b71ee39";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231")
pub fragment CC_ART1231 in CC_COURANT {
    label fr official "Article 1231";
    kind article;
    locator "article/1231";
    text fr official """Article 1231
A moins que l'inexécution soit définitive, les dommages et intérêts ne sont dus que si le débiteur a préalablement été mis en demeure de s'exécuter dans un délai raisonnable.
""";
    content_hash "sha256:aa4237667183a428b2a8c39c194751d92cc6afe12e69da803e1aa4e0eb7845f5";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231_1")
pub fragment CC_ART1231_1 in CC_COURANT {
    label fr official "Article 1231-1";
    kind article;
    locator "article/1231-1";
    text fr official """Article 1231-1
Le débiteur est condamné, s'il y a lieu, au paiement de dommages et intérêts soit à raison de l'inexécution de l'obligation, soit à raison du retard dans l'exécution, s'il ne justifie pas que l'exécution a été empêchée par la force majeure.
""";
    content_hash "sha256:a6ee4adfc7c3bf94715f1b3b2027ca5070d75f5935935cba420fdafdf0df85da";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231_2")
pub fragment CC_ART1231_2 in CC_COURANT {
    label fr official "Article 1231-2";
    kind article;
    locator "article/1231-2";
    text fr official """Article 1231-2
Les dommages et intérêts dus au créancier sont, en général, de la perte qu'il a faite et du gain dont il a été privé, sauf les exceptions et modifications ci-après.
""";
    content_hash "sha256:765844550242558798916137dcdfa6562f39fb21e17bc3cd0dce33ec9c432964";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231_3")
pub fragment CC_ART1231_3 in CC_COURANT {
    label fr official "Article 1231-3";
    kind article;
    locator "article/1231-3";
    text fr official """Article 1231-3
Le débiteur n'est tenu que des dommages et intérêts qui ont été prévus ou qui pouvaient être prévus lors de la conclusion du contrat, sauf lorsque l'inexécution est due à une faute lourde ou dolosive.
""";
    content_hash "sha256:eb57fb3c2ea74293e2fd5038a99c721ecac07d1bb8fbb669a1079050900bee4b";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231_4")
pub fragment CC_ART1231_4 in CC_COURANT {
    label fr official "Article 1231-4";
    kind article;
    locator "article/1231-4";
    text fr official """Article 1231-4
Dans le cas même où l'inexécution du contrat résulte d'une faute lourde ou dolosive, les dommages et intérêts ne comprennent que ce qui est une suite immédiate et directe de l'inexécution.
""";
    content_hash "sha256:c4e6a26efddd160c1f0f2dc25c2a0e9e80490472e80cc5a00c0eaaf6aedde549";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231_5")
pub fragment CC_ART1231_5 in CC_COURANT {
    label fr official "Article 1231-5";
    kind article;
    locator "article/1231-5";
    text fr official """Article 1231-5
Lorsque le contrat stipule que celui qui manquera de l'exécuter paiera une certaine somme à titre de dommages et intérêts, il ne peut être alloué à l'autre partie une somme plus forte ni moindre.
Néanmoins, le juge peut, même d'office, modérer ou augmenter la pénalité ainsi convenue si elle est manifestement excessive ou dérisoire.
Lorsque l'engagement a été exécuté en partie, la pénalité convenue peut être diminuée par le juge, même d'office, à proportion de l'intérêt que l'exécution partielle a procuré au créancier, sans préjudice de l'application de l'alinéa précédent.
Toute stipulation contraire aux deux alinéas précédents est réputée non écrite.
Sauf inexécution définitive, la pénalité n'est encourue que lorsque le débiteur est mis en demeure.
""";
    content_hash "sha256:c6cfa91207c8efd14a40f591f2f2b70ffe294b651dec6de797305b4ac2a30c39";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231_6")
pub fragment CC_ART1231_6 in CC_COURANT {
    label fr official "Article 1231-6";
    kind article;
    locator "article/1231-6";
    text fr official """Article 1231-6
Les dommages et intérêts dus à raison du retard dans le paiement d'une obligation de somme d'argent consistent dans l'intérêt au taux légal, à compter de la mise en demeure.
Ces dommages et intérêts sont dus sans que le créancier soit tenu de justifier d'aucune perte.
Le créancier auquel son débiteur en retard a causé, par sa mauvaise foi, un préjudice indépendant de ce retard, peut obtenir des dommages et intérêts distincts de l'intérêt moratoire.
""";
    content_hash "sha256:08aa1186f67083b2c2ac270a8cc9249e8625fa2aebeb7bd4584f91af03ab5e8a";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_ART1231_7")
pub fragment CC_ART1231_7 in CC_COURANT {
    label fr official "Article 1231-7";
    kind article;
    locator "article/1231-7";
    text fr official """Article 1231-7
En toute matière, la condamnation à une indemnité emporte intérêts au taux légal même en l'absence de demande ou de disposition spéciale du jugement. Sauf disposition contraire de la loi, ces intérêts courent à compter du prononcé du jugement à moins que le juge n'en décide autrement.
En cas de confirmation pure et simple par le juge d'appel d'une décision allouant une indemnité en réparation d'un dommage, celle-ci porte de plein droit intérêt au taux légal à compter du jugement de première instance. Dans les autres cas, l'indemnité allouée en appel porte intérêt à compter de la décision d'appel. Le juge d'appel peut toujours déroger aux dispositions du présent alinéa.
""";
    content_hash "sha256:4177ab1a01b56becdcfd3e09d4d51d9e9842d21ee056d94e4ef3d8470a1cc08b";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_2016_ART1110")
pub fragment CC_2016_ART1110 in CC_REDACTION_2016 {
    label fr official "Article 1110";
    kind article;
    locator "article/1110";
    text fr official """Article 1110
Le contrat de gré à gré est celui dont les stipulations sont librement négociées entre les parties.
Le contrat d'adhésion est celui dont les conditions générales, soustraites à la négociation, sont déterminées à l'avance par l'une des parties.
""";
    content_hash "sha256:dc10535c03cc8b11911ae85842c1cbf0b85f50d09f041ee936680c8404248857";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_2016_ART1117")
pub fragment CC_2016_ART1117 in CC_REDACTION_2016 {
    label fr official "Article 1117";
    kind article;
    locator "article/1117";
    text fr official """Article 1117
L'offre est caduque à l'expiration du délai fixé par son auteur ou, à défaut, à l'issue d'un délai raisonnable.
Elle l'est également en cas d'incapacité ou de décès de son auteur.
""";
    content_hash "sha256:57dc9dc284e38b79bde069952c549f5bcc13456299c342eda2fc0a717aedb66a";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_2016_ART1137")
pub fragment CC_2016_ART1137 in CC_REDACTION_2016 {
    label fr official "Article 1137";
    kind article;
    locator "article/1137";
    text fr official """Article 1137
Le dol est le fait pour un contractant d'obtenir le consentement de l'autre par des manœuvres ou des mensonges.
Constitue également un dol la dissimulation intentionnelle par l'un des contractants d'une information dont il sait le caractère déterminant pour l'autre partie.
""";
    content_hash "sha256:04a0718891ee4d7b4d6a57b7d656ee014fb3739893a132b31885ef9710c85580";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_2016_ART1145")
pub fragment CC_2016_ART1145 in CC_REDACTION_2016 {
    label fr official "Article 1145";
    kind article;
    locator "article/1145";
    text fr official """Article 1145
Toute personne physique peut contracter sauf en cas d'incapacité prévue par la loi.
La capacité des personnes morales est limitée aux actes utiles à la réalisation de leur objet tel que défini par leurs statuts et aux actes qui leur sont accessoires, dans le respect des règles applicables à chacune d'entre elles.
""";
    content_hash "sha256:c3dd3ef600b1684a88961fa4652040da03ad4a430efbc791b5226482d3906949";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_2016_ART1161")
pub fragment CC_2016_ART1161 in CC_REDACTION_2016 {
    label fr official "Article 1161";
    kind article;
    locator "article/1161";
    text fr official """Article 1161
Un représentant ne peut agir pour le compte des deux parties au contrat ni contracter pour son propre compte avec le représenté.
En ces cas, l'acte accompli est nul à moins que la loi ne l'autorise ou que le représenté ne l'ait autorisé ou ratifié.
""";
    content_hash "sha256:260c4bb45579945af8b320c0063af581d57e5012eb401f75317310074c017a33";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_2016_ART1171")
pub fragment CC_2016_ART1171 in CC_REDACTION_2016 {
    label fr official "Article 1171";
    kind article;
    locator "article/1171";
    text fr official """Article 1171
Dans un contrat d'adhésion, toute clause qui crée un déséquilibre significatif entre les droits et obligations des parties au contrat est réputée non écrite.
L'appréciation du déséquilibre significatif ne porte ni sur l'objet principal du contrat ni sur l'adéquation du prix à la prestation.
""";
    content_hash "sha256:79fef3dab39b5d17ef87ef4706fe9bf90efb7cb3f8fc5da226fbeb20445f8f86";
}

@id("urn:fr:corpus:clir:code-civil-contrat#CC_2016_ART1223")
pub fragment CC_2016_ART1223 in CC_REDACTION_2016 {
    label fr official "Article 1223";
    kind article;
    locator "article/1223";
    text fr official """Article 1223
Le créancier peut, après mise en demeure, accepter une exécution imparfaite du contrat et solliciter une réduction proportionnelle du prix.
S'il n'a pas encore payé, le créancier notifie sa décision de réduire le prix dans les meilleurs délais.
""";
    content_hash "sha256:a385cc00c25c165877fb2574f38c3e211e8f312753cb5eec21278b8ed8c67898";
}

// END GENERATED FRAGMENTS
