language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1124 al. 3 : le contrat conclu en violation de la promesse avec un tiers qui en connaissait l'existence est nul.
test "urn:query:fr-code-civil-contrat-f15-contrat-avec-tiers-de-mauvaise-foi-nul" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:f15"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:f15:promesse"), @2019-01-01) { origin case_input; }
        assert "f3": promesse_unilaterale(entity_ref("urn:fr:cc:contrat:f15:promesse"), entity_ref("urn:fr:cc:contrat:f15:promettant"), entity_ref("urn:fr:cc:contrat:f15:beneficiaire")) { origin case_input; }
        assert "f4": contrat_conclu_avec_un_tiers_en_violation_de_la_promesse(entity_ref("urn:fr:cc:contrat:f15"), entity_ref("urn:fr:cc:contrat:f15:promesse"), entity_ref("urn:fr:cc:contrat:f15:tiers")) { origin case_input; }
        assert "f5": tiers_connaissait_la_promesse(entity_ref("urn:fr:cc:contrat:f15"), entity_ref("urn:fr:cc:contrat:f15:tiers")) { origin case_input; }
    }
    evaluate truth(contrat_avec_le_tiers_nul(entity_ref("urn:fr:cc:contrat:f15")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ContratAvecLeTiersNul);
}
