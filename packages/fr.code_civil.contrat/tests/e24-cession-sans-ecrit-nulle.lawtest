language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1216 al. 3 : la cession de contrat doit être constatée par écrit, à peine de nullité.
test "urn:query:fr-code-civil-contrat-e24-cession-sans-ecrit-nulle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e24"), @2019-03-01) { origin case_input; }
        assert "f2": cession_du_contrat(entity_ref("urn:fr:cc:contrat:e24:cess"), entity_ref("urn:fr:cc:contrat:e24")) { origin case_input; }
        assert "f3": cedant(entity_ref("urn:fr:cc:contrat:e24:cess"), entity_ref("urn:fr:cc:contrat:e24:p1")) { origin case_input; }
        assert "f4": cessionnaire(entity_ref("urn:fr:cc:contrat:e24:cess"), entity_ref("urn:fr:cc:contrat:e24:p2")) { origin case_input; }
        assert "f5": cede(entity_ref("urn:fr:cc:contrat:e24:cess"), entity_ref("urn:fr:cc:contrat:e24:cede")) { origin case_input; }
        assert "f6": accord_du_cede(entity_ref("urn:fr:cc:contrat:e24:cess")) { origin case_input; }
    }
    evaluate truth(cession_nulle_faute_d_ecrit(entity_ref("urn:fr:cc:contrat:e24:cess")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CessionNulleFauteDEcrit);

    evaluate truth(cession_valable(entity_ref("urn:fr:cc:contrat:e24:cess")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
