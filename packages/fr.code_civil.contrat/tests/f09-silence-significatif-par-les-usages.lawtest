language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1120 : lorsque les usages en disposent autrement, le silence n'est pas privé d'effet.
test "urn:query:fr-code-civil-contrat-f09-silence-significatif-par-les-usages" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:f09"), @2019-03-01) { origin case_input; }
        assert "f2": offre_du_contrat(entity_ref("urn:fr:cc:contrat:f09:offre"), entity_ref("urn:fr:cc:contrat:f09")) { origin case_input; }
        assert "f3": offre_comprend_les_elements_essentiels(entity_ref("urn:fr:cc:contrat:f09:offre")) { origin case_input; }
        assert "f4": volonte_d_etre_lie(entity_ref("urn:fr:cc:contrat:f09:offre")) { origin case_input; }
        assert "f5": auteur_de_l_offre(entity_ref("urn:fr:cc:contrat:f09:offre"), entity_ref("urn:fr:cc:contrat:f09:offrant")) { origin case_input; }
        assert "f6": acceptation_par_le_silence(entity_ref("urn:fr:cc:contrat:f09:offre")) { origin case_input; }
        assert "f7": silence_significatif_par_la_loi_l_usage_ou_les_circonstances(entity_ref("urn:fr:cc:contrat:f09:offre")) { origin case_input; }
    }
    evaluate truth(silence_ne_vaut_pas_acceptation(entity_ref("urn:fr:cc:contrat:f09:offre")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
