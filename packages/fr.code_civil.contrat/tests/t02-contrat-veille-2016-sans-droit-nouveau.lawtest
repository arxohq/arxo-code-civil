language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Ord. 2016-131 art. 9 : le même contrat du 30 septembre 2016 n'est pas régi par la rédaction nouvelle.
test "urn:query:fr-code-civil-contrat-t02-contrat-veille-2016-sans-droit-nouveau" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t02"), @2016-09-30) { origin case_input; }
    }
    evaluate truth(regi_par_le_droit_nouveau(entity_ref("urn:fr:cc:contrat:t02")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
