language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1231-6 al. 1 et 2 : le retard de paiement d'une somme d'argent fait courir l'intérêt au taux légal — entrée typée du cas — à compter de la mise en demeure du 1er février 2020, sans justifier d'aucune perte.
test "urn:query:fr-code-civil-contrat-i33-interets-moratoires-depuis-la-mise-en-demeure" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i33"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i33"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i33"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i33")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i33")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i33")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i33"), entity_ref("urn:fr:cc:contrat:i33:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i33:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i33"), entity_ref("urn:fr:cc:contrat:i33:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i33"), entity_ref("urn:fr:cc:contrat:i33:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i33:o"), entity_ref("urn:fr:cc:contrat:i33")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i33:o"), entity_ref("urn:fr:cc:contrat:i33:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i33:o"), entity_ref("urn:fr:cc:contrat:i33:debiteur")) { origin case_input; }
        assert "f14": obligation_de_somme_d_argent(entity_ref("urn:fr:cc:contrat:i33:o"), entity_ref("urn:fr:cc:contrat:i33:creance")) { origin case_input; }
        assert "f15": retard_dans_l_execution(entity_ref("urn:fr:cc:contrat:i33:o")) { origin case_input; }
        assert "f16": taux_legal_applicable(entity_ref("urn:fr:cc:contrat:i33:o"), 0.0476) { origin case_input; }
        assert "f17": mise_en_demeure_de_satisfaire_le(entity_ref("urn:fr:cc:contrat:i33:o"), @2020-02-01) { origin case_input; }
    }
    evaluate truth(interets_moratoires_courent_depuis(entity_ref("urn:fr:cc:contrat:i33:o"), @2020-02-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InteretsMoratoiresDepuisLaMiseEnDemeure);

    evaluate truth(interets_dus_sans_justifier_d_une_perte(entity_ref("urn:fr:cc:contrat:i33:o")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InteretsDusSansPerte);
}
