language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1112-1 al. 1 : l'information ayant été fournie, l'obligation d'informer est exécutée.
test "urn:query:fr-code-civil-contrat-p02-devoir-d-information-execute" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:p02"), @2019-03-01) { origin case_input; }
        assert "f2": information_du_contrat(entity_ref("urn:fr:cc:contrat:p02:info"), entity_ref("urn:fr:cc:contrat:p02")) { origin case_input; }
        assert "f3": information_connue_de(entity_ref("urn:fr:cc:contrat:p02:info"), entity_ref("urn:fr:cc:contrat:p02:vendeur")) { origin case_input; }
        assert "f4": information_legitimement_ignoree_par(entity_ref("urn:fr:cc:contrat:p02:info"), entity_ref("urn:fr:cc:contrat:p02:acheteur")) { origin case_input; }
        assert "f5": information_d_importance_determinante(entity_ref("urn:fr:cc:contrat:p02:info"), entity_ref("urn:fr:cc:contrat:p02:acheteur")) { origin adjudicated; }
        assert "f6": information_fournie(entity_ref("urn:fr:cc:contrat:p02:info"), entity_ref("urn:fr:cc:contrat:p02:vendeur")) { origin case_input; }
    }
    evaluate positions();
    expect position(InformerLeCocontractant, SATISFIED);
}
