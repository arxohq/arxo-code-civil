language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1196 al. 2 : le transfert différé par la volonté des parties n'opère pas à la conclusion.
test "urn:query:fr-code-civil-contrat-e07-transfert-differe" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e07"), @2019-03-01) { origin case_input; }
        assert "f2": contrat_d_alienation_ou_de_cession_de_droit(entity_ref("urn:fr:cc:contrat:e07")) { origin case_input; }
        assert "f3": transfert_differe(entity_ref("urn:fr:cc:contrat:e07")) { origin case_input; }
    }
    evaluate truth(transfert_de_propriete_a_la_conclusion(entity_ref("urn:fr:cc:contrat:e07")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;

    evaluate truth(transfert_de_propriete_reporte(entity_ref("urn:fr:cc:contrat:e07")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(TransfertDiffere);
}
