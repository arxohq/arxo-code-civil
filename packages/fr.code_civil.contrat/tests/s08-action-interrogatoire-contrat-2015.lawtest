language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Ord. 2016-131 art. 9 : l'article 1183 s'applique dès l'entrée en vigueur, même au contrat de 2015 — l'échéance se calcule pareillement.
test "urn:query:fr-code-civil-contrat-s08-action-interrogatoire-contrat-2015" {
    given {
        context { deadline_policy CC_CONTRAT_MOIS; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:s08"), @2015-06-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:s08"), "1183") { origin case_input; }
        assert "f3": demande_ecrite_de_prendre_parti_le(entity_ref("urn:fr:cc:contrat:s08"), @2020-01-31) { origin case_input; }
        assert "f4": cause_de_la_nullite_cessee(entity_ref("urn:fr:cc:contrat:s08")) { origin case_input; }
    }
    evaluate truth(echeance_de_l_action_interrogatoire(entity_ref("urn:fr:cc:contrat:s08"), @2020-07-31));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
