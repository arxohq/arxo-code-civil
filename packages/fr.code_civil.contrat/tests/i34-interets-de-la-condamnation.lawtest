language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1231-7 al. 1 : la condamnation à une indemnité emporte intérêts au taux légal à compter du prononcé du jugement, ici le 4 juin 2021.
test "urn:query:fr-code-civil-contrat-i34-interets-de-la-condamnation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i34"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i34"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i34"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i34")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i34")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i34")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i34"), entity_ref("urn:fr:cc:contrat:i34:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i34:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i34"), entity_ref("urn:fr:cc:contrat:i34:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i34"), entity_ref("urn:fr:cc:contrat:i34:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i34:o"), entity_ref("urn:fr:cc:contrat:i34")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i34:o"), entity_ref("urn:fr:cc:contrat:i34:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i34:o"), entity_ref("urn:fr:cc:contrat:i34:debiteur")) { origin case_input; }
        assert "f14": taux_legal_applicable(entity_ref("urn:fr:cc:contrat:i34:o"), 0.0476) { origin case_input; }
        assert "f15": condamnation_a_une_indemnite_le(entity_ref("urn:fr:cc:contrat:i34"), @2021-06-04) { origin case_input; }
    }
    evaluate truth(interets_de_la_condamnation_courent_depuis(entity_ref("urn:fr:cc:contrat:i34"), @2021-06-04));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InteretsDeLaCondamnationDesLeProncee);
}
