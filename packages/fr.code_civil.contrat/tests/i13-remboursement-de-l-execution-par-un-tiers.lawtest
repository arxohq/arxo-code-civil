language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1222 al. 1 : après mise en demeure, le créancier qui a fait exécuter l'obligation dans un délai et à un coût raisonnables peut en demander le remboursement — 4 000 EUR engagés.
test "urn:query:fr-code-civil-contrat-i13-remboursement-de-l-execution-par-un-tiers" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i13"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i13"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i13"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i13")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i13")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i13")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i13"), entity_ref("urn:fr:cc:contrat:i13:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i13:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i13"), entity_ref("urn:fr:cc:contrat:i13:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i13"), entity_ref("urn:fr:cc:contrat:i13:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i13:o"), entity_ref("urn:fr:cc:contrat:i13")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i13:o"), entity_ref("urn:fr:cc:contrat:i13:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i13:o"), entity_ref("urn:fr:cc:contrat:i13:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:i13:o")) { origin case_input; }
        assert "f15": mise_en_demeure_de_satisfaire_le(entity_ref("urn:fr:cc:contrat:i13:o"), @2020-02-01) { origin case_input; }
        assert "f16": execution_par_le_creancier_a_cout_raisonnable(entity_ref("urn:fr:cc:contrat:i13:o")) { origin case_input; }
        assert "f17": sommes_engagees_par_le_creancier(entity_ref("urn:fr:cc:contrat:i13:o"), 4000 EUR) { origin case_input; }
    }
    evaluate truth(remboursement_des_sommes_engagees(entity_ref("urn:fr:cc:contrat:i13:o"), 4000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RemboursementDeLExecutionParUnTiers);
}
