language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1226 al. 3 et 4, §127 : le créancier notifie la résolution alors que l'inexécution ne persiste plus — le pouvoir demeure, son exercice est invalide et l'effet ne se produit pas.
test "urn:query:fr-code-civil-contrat-p05-pouvoir-exerce-sans-inexecution-persistante" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:p05"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:p05"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:p05"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:p05")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:p05")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:p05")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:p05"), entity_ref("urn:fr:cc:contrat:p05:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:p05:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:p05"), entity_ref("urn:fr:cc:contrat:p05:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:p05"), entity_ref("urn:fr:cc:contrat:p05:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:p05:o"), entity_ref("urn:fr:cc:contrat:p05")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:p05:o"), entity_ref("urn:fr:cc:contrat:p05:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:p05:o"), entity_ref("urn:fr:cc:contrat:p05:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:p05:o")) { origin case_input; }
        assert "f15": mise_en_demeure_de_satisfaire_le(entity_ref("urn:fr:cc:contrat:p05:o"), @2020-02-01) { origin case_input; }
        assert "f16": delai_raisonnable_de_la_mise_en_demeure_1226(entity_ref("urn:fr:cc:contrat:p05:o")) { origin adjudicated; }
        assert "f17": mise_en_demeure_mentionnant_le_droit_de_resoudre(entity_ref("urn:fr:cc:contrat:p05:o")) { origin case_input; }
        assert "f18": notification_de_resolution_adressee(entity_ref("urn:fr:cc:contrat:p05"), entity_ref("urn:fr:cc:contrat:p05:creancier")) { origin case_input; }
    }
    evaluate positions();
    expect position(ResoudreParNotification, ACTIVE);
    expect issue(POWER_INVALID_EXERCISE);

    evaluate truth(contrat_resolu_par_notification(entity_ref("urn:fr:cc:contrat:p05")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
