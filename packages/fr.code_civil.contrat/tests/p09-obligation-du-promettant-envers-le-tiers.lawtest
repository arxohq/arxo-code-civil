language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1206 al. 1, §122 : le droit direct du bénéficiaire a pour corrélat l'obligation du promettant d'accomplir la prestation à son profit.
test "urn:query:fr-code-civil-contrat-p09-obligation-du-promettant-envers-le-tiers" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:p09"), @2019-03-01) { origin case_input; }
        assert "f2": stipulation_pour_autrui(entity_ref("urn:fr:cc:contrat:p09:s"), entity_ref("urn:fr:cc:contrat:p09"), entity_ref("urn:fr:cc:contrat:p09:stipulant"), entity_ref("urn:fr:cc:contrat:p09:promettant"), entity_ref("urn:fr:cc:contrat:p09:beneficiaire")) { origin case_input; }
        assert "f3": beneficiaire_precisement_designe_ou_determinable(entity_ref("urn:fr:cc:contrat:p09:s")) { origin case_input; }
    }
    evaluate positions();
    expect position(AccomplirLaPrestationAuProfitDuTiers, ACTIVE);
}
