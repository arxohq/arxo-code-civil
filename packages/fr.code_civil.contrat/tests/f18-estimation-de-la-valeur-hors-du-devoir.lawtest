language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1112-1 al. 2 : le devoir d'information ne porte pas sur l'estimation de la valeur de la prestation, même d'importance déterminante.
test "urn:query:fr-code-civil-contrat-f18-estimation-de-la-valeur-hors-du-devoir" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:f18"), @2019-03-01) { origin case_input; }
        assert "f2": information_du_contrat(entity_ref("urn:fr:cc:contrat:f18:info"), entity_ref("urn:fr:cc:contrat:f18")) { origin case_input; }
        assert "f3": information_connue_de(entity_ref("urn:fr:cc:contrat:f18:info"), entity_ref("urn:fr:cc:contrat:f18:vendeur")) { origin case_input; }
        assert "f4": information_legitimement_ignoree_par(entity_ref("urn:fr:cc:contrat:f18:info"), entity_ref("urn:fr:cc:contrat:f18:acheteur")) { origin case_input; }
        assert "f5": information_d_importance_determinante(entity_ref("urn:fr:cc:contrat:f18:info"), entity_ref("urn:fr:cc:contrat:f18:acheteur")) { origin adjudicated; }
        assert "f6": information_porte_sur_l_estimation_de_la_valeur(entity_ref("urn:fr:cc:contrat:f18:info")) { origin case_input; }
    }
    evaluate truth(devoir_d_information_ecarte(entity_ref("urn:fr:cc:contrat:f18:info")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EstimationDeLaValeurHorsDuDevoir);

    evaluate truth(devoir_d_information_du(entity_ref("urn:fr:cc:contrat:f18:info"), entity_ref("urn:fr:cc:contrat:f18:vendeur"), entity_ref("urn:fr:cc:contrat:f18:acheteur")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
