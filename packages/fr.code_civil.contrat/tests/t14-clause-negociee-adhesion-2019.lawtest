language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1171, rédaction de 2018 : en 2019, seule la clause non négociable est visée — la clause négociée échappe au texte.
test "urn:query:fr-code-civil-contrat-t14-clause-negociee-adhesion-2019" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t14"), @2019-04-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:t14"), @2019-04-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:t14"), "1110") { origin case_input; }
        assert "f4": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:t14"), "1171") { origin case_input; }
        assert "f5": clause_du_contrat(entity_ref("urn:fr:cc:contrat:t14:clause"), entity_ref("urn:fr:cc:contrat:t14")) { origin case_input; }
        assert "f6": desequilibre_significatif(entity_ref("urn:fr:cc:contrat:t14:clause")) { origin adjudicated; }
        assert "f7": ensemble_de_clauses_non_negociables_predeterminees(entity_ref("urn:fr:cc:contrat:t14")) { origin case_input; }
    }
    evaluate truth(clause_reputee_non_ecrite(entity_ref("urn:fr:cc:contrat:t14:clause")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
