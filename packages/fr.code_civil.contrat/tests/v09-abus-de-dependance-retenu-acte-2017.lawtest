language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1143, interprétatif (loi 2018-287 art. 16 I) : sa rédaction ratifiée vaut pour l'acte de 2017 ; l'avantage manifestement excessif retenu, la violence est constituée.
test "urn:query:fr-code-civil-contrat-v09-abus-de-dependance-retenu-acte-2017" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v09"), @2017-05-01) { origin case_input; }
        assert "f2": etat_de_dependance(entity_ref("urn:fr:cc:contrat:v09"), entity_ref("urn:fr:cc:contrat:v09:p1"), entity_ref("urn:fr:cc:contrat:v09:p2")) { origin case_input; }
        assert "f3": engagement_non_souscrit_sans_la_contrainte(entity_ref("urn:fr:cc:contrat:v09"), entity_ref("urn:fr:cc:contrat:v09:p1")) { origin case_input; }
        assert "f4": avantage_manifestement_excessif_1143(entity_ref("urn:fr:cc:contrat:v09"), entity_ref("urn:fr:cc:contrat:v09:p2")) { origin adjudicated; }
    }
    evaluate truth(vice_du_consentement(entity_ref("urn:fr:cc:contrat:v09"), entity_ref("urn:fr:cc:contrat:v09:p1"), Violence));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(AbusDeLEtatDeDependance);
}
