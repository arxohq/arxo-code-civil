language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1204 al. 2 : dans le cas contraire, le promettant peut être condamné à des dommages et intérêts.
test "urn:query:fr-code-civil-contrat-e11-porte-fort-tenu-de-dommages-et-interets" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": porte_fort(entity_ref("urn:fr:cc:contrat:e11:s"), entity_ref("urn:fr:cc:contrat:e11:p1"), entity_ref("urn:fr:cc:contrat:e11:tiers")) { origin case_input; }
    }
    evaluate truth(promettant_tenu_de_dommages_et_interets(entity_ref("urn:fr:cc:contrat:e11:s"), entity_ref("urn:fr:cc:contrat:e11:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PortefortTenuDeDommagesEtInterets);
}
