language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1180 al. 1 : la nullité absolue peut être demandée par le ministère public.
test "urn:query:fr-code-civil-contrat-s11-nullite-absolue-demandable-par-le-ministere-public" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:s11"), @2019-03-01) { origin case_input; }
        assert "f2": regle_violee_protege_l_interet_general(entity_ref("urn:fr:cc:contrat:s11")) { origin case_input; }
        assert "f3": ministere_public(entity_ref("urn:fr:cc:contrat:s11:p1")) { origin case_input; }
    }
    evaluate truth(nullite_demandable_par(entity_ref("urn:fr:cc:contrat:s11"), entity_ref("urn:fr:cc:contrat:s11:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(NulliteAbsolueDemandableParLeMinisterePublic);
}
