language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1199 et 1200 : le contrat ne crée d'obligations qu'entre les parties, mais les tiers doivent respecter la situation juridique qu'il crée.
test "urn:query:fr-code-civil-contrat-e09-effet-relatif-du-contrat" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e09"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:e09"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:e09"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:e09")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:e09")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:e09")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:e09"), entity_ref("urn:fr:cc:contrat:e09:p1")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:e09:p1")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:e09"), entity_ref("urn:fr:cc:contrat:e09:p1")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:e09"), entity_ref("urn:fr:cc:contrat:e09:p1")) { origin case_input; }
        assert "f11": tiers_au_contrat(entity_ref("urn:fr:cc:contrat:e09"), entity_ref("urn:fr:cc:contrat:e09:tiers")) { origin case_input; }
    }
    evaluate truth(effet_relatif_du_contrat(entity_ref("urn:fr:cc:contrat:e09"), entity_ref("urn:fr:cc:contrat:e09:tiers")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EffetRelatifDuContrat);

    evaluate truth(situation_juridique_opposable_aux_tiers(entity_ref("urn:fr:cc:contrat:e09"), entity_ref("urn:fr:cc:contrat:e09:tiers")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(OpposabiliteAuxTiers);
}
