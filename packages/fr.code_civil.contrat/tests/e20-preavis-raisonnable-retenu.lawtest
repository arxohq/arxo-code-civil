language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1211 : le juge fixe l'issue du délai raisonnable au 1er avril 2020 ; la résiliation du 10 avril est régulière.
test "urn:query:fr-code-civil-contrat-e20-preavis-raisonnable-retenu" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e20"), @2019-03-01) { origin case_input; }
        assert "f2": duree_du_contrat(entity_ref("urn:fr:cc:contrat:e20"), DureeIndeterminee) { origin case_input; }
        assert "f3": resiliation_notifiee_le(entity_ref("urn:fr:cc:contrat:e20"), entity_ref("urn:fr:cc:contrat:e20:p1"), @2020-04-10) { origin case_input; }
        assert "f4": delai_de_preavis_raisonnable_expire_le_1211(entity_ref("urn:fr:cc:contrat:e20"), @2020-04-01) { origin adjudicated; }
    }
    evaluate truth(resiliation_reguliere(entity_ref("urn:fr:cc:contrat:e20"), entity_ref("urn:fr:cc:contrat:e20:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ResiliationAvecPreavisRaisonnable);
}
