language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1183 al. 1 : demande du 31 août 2020 ; six mois plus tard, février 2021 n'a pas de 31 — l'échéance tombe au dernier jour du mois, le 28 février 2021.
test "urn:query:fr-code-civil-contrat-s02-echeance-fin-de-mois" {
    given {
        context { deadline_policy CC_CONTRAT_MOIS; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:s02"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:s02"), "1183") { origin case_input; }
        assert "f3": demande_ecrite_de_prendre_parti_le(entity_ref("urn:fr:cc:contrat:s02"), @2020-08-31) { origin case_input; }
        assert "f4": cause_de_la_nullite_cessee(entity_ref("urn:fr:cc:contrat:s02")) { origin case_input; }
    }
    evaluate truth(echeance_de_l_action_interrogatoire(entity_ref("urn:fr:cc:contrat:s02"), @2021-02-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
