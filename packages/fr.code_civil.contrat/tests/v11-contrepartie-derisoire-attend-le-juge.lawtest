language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1169, canal §47.3 : le caractère illusoire ou dérisoire de la contrepartie est une appréciation du juge.
test "urn:query:fr-code-civil-contrat-v11-contrepartie-derisoire-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v11"), @2019-03-01) { origin case_input; }
        assert "f2": contrat_a_titre_onereux(entity_ref("urn:fr:cc:contrat:v11")) { origin case_input; }
    }
    evaluate truth(cause_de_nullite(entity_ref("urn:fr:cc:contrat:v11"), Relative));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(contrepartie_illusoire_ou_derisoire, Court);
}
