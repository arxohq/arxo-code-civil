language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1223, rédaction de l'ordonnance de 2016 : pour l'acte de 2017, le créancier accepte l'exécution imparfaite et sollicite la réduction — même quart, mêmes 250,00 EUR.
test "urn:query:fr-code-civil-contrat-i16-reduction-du-prix-sollicitee-2017" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i16"), @2017-05-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i16"), @2017-05-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i16"), "1223") { origin case_input; }
        assert "f4": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i16:o"), entity_ref("urn:fr:cc:contrat:i16")) { origin case_input; }
        assert "f5": engagement_imparfaitement_execute(entity_ref("urn:fr:cc:contrat:i16:o")) { origin case_input; }
        assert "f6": mise_en_demeure_de_satisfaire_le(entity_ref("urn:fr:cc:contrat:i16:o"), @2020-02-01) { origin case_input; }
        assert "f7": prix_du_contrat(entity_ref("urn:fr:cc:contrat:i16"), 1000 EUR) { origin case_input; }
        assert "f8": termes_de_la_reduction_de_prix(entity_ref("urn:fr:cc:contrat:i16"), 1, 4.0) { origin case_input; }
        assert "f9": execution_imparfaite_acceptee(entity_ref("urn:fr:cc:contrat:i16")) { origin case_input; }
    }
    evaluate truth(reduction_de_prix(entity_ref("urn:fr:cc:contrat:i16"), 250 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ReductionDuPrixSollicitee2016);
}
