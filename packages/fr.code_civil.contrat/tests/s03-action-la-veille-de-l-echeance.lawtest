language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1183 : action en nullité exercée le 30 juillet 2020, veille de l'échéance — elle est dans le délai.
test "urn:query:fr-code-civil-contrat-s03-action-la-veille-de-l-echeance" {
    given {
        context { deadline_policy CC_CONTRAT_MOIS; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:s03"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:s03"), "1183") { origin case_input; }
        assert "f3": demande_ecrite_de_prendre_parti_le(entity_ref("urn:fr:cc:contrat:s03"), @2020-01-31) { origin case_input; }
        assert "f4": cause_de_la_nullite_cessee(entity_ref("urn:fr:cc:contrat:s03")) { origin case_input; }
        assert "f5": action_en_nullite_exercee_le(entity_ref("urn:fr:cc:contrat:s03"), @2020-07-30) { origin case_input; }
    }
    evaluate truth(action_en_nullite_exercee_dans_le_delai(entity_ref("urn:fr:cc:contrat:s03")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ActionExerceeDansLeDelai);
}
