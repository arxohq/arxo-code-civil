language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1195 al. 1, §122 : la partie qui demande la renégociation continue à exécuter ses obligations durant celle-ci — devoir de MAINTIEN, actif pendant la renégociation.
test "urn:query:fr-code-civil-contrat-p10-obligation-d-executer-pendant-la-renegociation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:p10"), @2019-03-01) { origin case_input; }
        assert "f2": partie_au_contrat(entity_ref("urn:fr:cc:contrat:p10"), entity_ref("urn:fr:cc:contrat:p10:p1")) { origin case_input; }
        assert "f3": changement_de_circonstances(entity_ref("urn:fr:cc:contrat:p10"), entity_ref("urn:fr:cc:contrat:p10:p1")) { origin case_input; }
        assert "f4": changement_imprevisible_lors_de_la_conclusion(entity_ref("urn:fr:cc:contrat:p10")) { origin adjudicated; }
        assert "f5": execution_excessivement_onereuse(entity_ref("urn:fr:cc:contrat:p10"), entity_ref("urn:fr:cc:contrat:p10:p1")) { origin adjudicated; }
        assert "f6": renegociation_demandee(entity_ref("urn:fr:cc:contrat:p10"), entity_ref("urn:fr:cc:contrat:p10:p1")) { origin case_input; }
        assert "f7": execution_poursuivie_pendant_la_renegociation(entity_ref("urn:fr:cc:contrat:p10"), entity_ref("urn:fr:cc:contrat:p10:p1")) { origin case_input; }
    }
    evaluate positions();
    expect position(ExecuterPendantLaRenegociation, ACTIVE);
}
