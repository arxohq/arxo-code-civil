language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Ord. 2016-131 art. 9, troisième phrase : l'article 1183 s'applique dès l'entrée en vigueur, même au contrat de 2015.
test "urn:query:fr-code-civil-contrat-t10-1183-immediat-contrat-2015" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t10"), @2015-06-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:t10"), "1183") { origin case_input; }
    }
    evaluate truth(article_applicable_des_2016(entity_ref("urn:fr:cc:contrat:t10"), "1183"));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ArticleApplicableDesLEntreeEnVigueur);
}
