language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1219, §122 : le droit de refuser d'exécuter est une LIBERTÉ — son action est celle de son titulaire, le créancier de l'obligation inexécutée.
test "urn:query:fr-code-civil-contrat-p03-liberte-de-refuser-d-executer" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:p03"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:p03"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:p03"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:p03")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:p03")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:p03")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:p03"), entity_ref("urn:fr:cc:contrat:p03:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:p03:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:p03"), entity_ref("urn:fr:cc:contrat:p03:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:p03"), entity_ref("urn:fr:cc:contrat:p03:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:p03:autre"), entity_ref("urn:fr:cc:contrat:p03")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:p03:autre"), entity_ref("urn:fr:cc:contrat:p03:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:p03:autre"), entity_ref("urn:fr:cc:contrat:p03:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:p03:autre")) { origin case_input; }
        assert "f15": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:p03:o"), entity_ref("urn:fr:cc:contrat:p03")) { origin case_input; }
        assert "f16": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:p03:o"), entity_ref("urn:fr:cc:contrat:p03:creancier")) { origin case_input; }
        assert "f17": obligation_exigible(entity_ref("urn:fr:cc:contrat:p03:o")) { origin case_input; }
        assert "f18": inexecution_suffisamment_grave_1219(entity_ref("urn:fr:cc:contrat:p03:autre")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(RefuserDExecuterSonObligation, ACTIVE);
}
