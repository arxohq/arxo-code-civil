language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CONTRELETTREENTRELESPARTIES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:contrelettreentrelesparties:v0")) { origin case_input; }
        assert "cat-1": contrat_apparent(entity_ref("urn:law:catalog:contrelettreentrelesparties:v0"), entity_ref("urn:law:catalog:contrelettreentrelesparties:v1")) { origin case_input; }
    }
    evaluate truth(contre_lettre_produit_effet_entre_les_parties(entity_ref("urn:law:catalog:contrelettreentrelesparties:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CONTRELETTREINOPPOSABLEAUXTIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:contrelettreinopposableauxtiers:v0")) { origin case_input; }
        assert "cat-1": contrat_apparent(entity_ref("urn:law:catalog:contrelettreinopposableauxtiers:v0"), entity_ref("urn:law:catalog:contrelettreinopposableauxtiers:v1")) { origin case_input; }
        assert "cat-2": tiers_au_contrat(entity_ref("urn:law:catalog:contrelettreinopposableauxtiers:v0"), entity_ref("urn:law:catalog:contrelettreinopposableauxtiers:v2")) { origin case_input; }
    }
    evaluate truth(contre_lettre_inopposable_aux_tiers(entity_ref("urn:law:catalog:contrelettreinopposableauxtiers:v1"), entity_ref("urn:law:catalog:contrelettreinopposableauxtiers:v2")));
    expect truth_status == TRUE_ONLY;
}
