language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DIVULGATIONDINFORMATIONCONFIDENTIELLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": negociation_du_contrat(entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v1"), entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v2")) { origin case_input; }
        assert "cat-1": information_divulguee_sans_autorisation(entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v0"), entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v3")) { origin case_input; }
        assert "cat-2": information_confidentielle(entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v0"), entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v1")) { origin case_input; }
        assert "cat-3": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v2")) { origin case_input; }
    }
    evaluate truth(responsabilite_pour_information_confidentielle(entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v0"), entity_ref("urn:law:catalog:divulgationdinformationconfidentielle:v3")));
    expect truth_status == TRUE_ONLY;
}
