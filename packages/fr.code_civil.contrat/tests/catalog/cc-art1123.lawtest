language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-REPARATIONDUBENEFICIAIREDUPACTE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v0")) { origin case_input; }
        assert "cat-1": pacte_de_preference(entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v1"), entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v2"), entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v3")) { origin case_input; }
        assert "cat-2": contrat_conclu_avec_un_tiers_en_violation_du_pacte(entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v0"), entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v1"), entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v4")) { origin case_input; }
    }
    evaluate truth(reparation_du_beneficiaire_du_pacte(entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v1"), entity_ref("urn:law:catalog:reparationdubeneficiairedupacte:v2")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SUBSTITUTIONOUNULLITEOUVERTE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:substitutionounulliteouverte:v0")) { origin case_input; }
        assert "cat-1": pacte_de_preference(entity_ref("urn:law:catalog:substitutionounulliteouverte:v1"), entity_ref("urn:law:catalog:substitutionounulliteouverte:v2"), entity_ref("urn:law:catalog:substitutionounulliteouverte:v3")) { origin case_input; }
        assert "cat-2": tiers_connaissait_le_pacte_et_l_intention(entity_ref("urn:law:catalog:substitutionounulliteouverte:v0"), entity_ref("urn:law:catalog:substitutionounulliteouverte:v4")) { origin case_input; }
        assert "cat-3": contrat_conclu_avec_un_tiers_en_violation_du_pacte(entity_ref("urn:law:catalog:substitutionounulliteouverte:v0"), entity_ref("urn:law:catalog:substitutionounulliteouverte:v1"), entity_ref("urn:law:catalog:substitutionounulliteouverte:v4")) { origin case_input; }
    }
    evaluate truth(substitution_ou_nullite_ouverte_au_beneficiaire(entity_ref("urn:law:catalog:substitutionounulliteouverte:v1"), entity_ref("urn:law:catalog:substitutionounulliteouverte:v2")));
    expect truth_status == TRUE_ONLY;
}
