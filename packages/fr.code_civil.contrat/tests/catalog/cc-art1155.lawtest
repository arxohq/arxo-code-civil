language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-POUVOIRGENERALCOUVRELESACTESDADMINISTRATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:pouvoirgeneralcouvrelesactesdadministration:v1")) { origin case_input; }
        assert "cat-1": acte_conservatoire_ou_d_administration(entity_ref("urn:law:catalog:pouvoirgeneralcouvrelesactesdadministration:v1")) { origin case_input; }
        assert "cat-2": representation_pour_le_contrat(entity_ref("urn:law:catalog:pouvoirgeneralcouvrelesactesdadministration:v0"), entity_ref("urn:law:catalog:pouvoirgeneralcouvrelesactesdadministration:v1")) { origin case_input; }
        assert "cat-3": pouvoir_defini_en_termes_generaux(entity_ref("urn:law:catalog:pouvoirgeneralcouvrelesactesdadministration:v0")) { origin case_input; }
    }
    evaluate truth(acte_couvert_par_le_pouvoir(entity_ref("urn:law:catalog:pouvoirgeneralcouvrelesactesdadministration:v0"), entity_ref("urn:law:catalog:pouvoirgeneralcouvrelesactesdadministration:v1")));
    expect truth_status == TRUE_ONLY;
}
