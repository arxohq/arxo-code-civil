language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-STIPULANTEXIGELEXECUTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": stipulation_pour_autrui(entity_ref("urn:law:catalog:stipulantexigelexecution:v0"), entity_ref("urn:law:catalog:stipulantexigelexecution:v1"), entity_ref("urn:law:catalog:stipulantexigelexecution:v2"), entity_ref("urn:law:catalog:stipulantexigelexecution:v3"), entity_ref("urn:law:catalog:stipulantexigelexecution:v4")) { origin case_input; }
        assert "cat-1": exigence_du_stipulant(entity_ref("urn:law:catalog:stipulantexigelexecution:v0")) { origin case_input; }
    }
    evaluate truth(execution_exigible_par_le_stipulant(entity_ref("urn:law:catalog:stipulantexigelexecution:v0"), entity_ref("urn:law:catalog:stipulantexigelexecution:v2")));
    expect truth_status == TRUE_ONLY;
}
