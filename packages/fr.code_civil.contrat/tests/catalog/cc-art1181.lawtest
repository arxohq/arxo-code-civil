language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RENONCIATIONDUNTITULAIRESANSEFFETSURLESAUTRES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cause_de_nullite(entity_ref("urn:law:catalog:renonciationduntitulairesanseffetsurlesautres:v0"), Relative) { origin case_input; }
        assert "cat-1": renonciation_d_un_titulaire_de_l_action(entity_ref("urn:law:catalog:renonciationduntitulairesanseffetsurlesautres:v0"), entity_ref("urn:law:catalog:renonciationduntitulairesanseffetsurlesautres:v1")) { origin case_input; }
    }
    evaluate truth(action_des_autres_titulaires_maintenue(entity_ref("urn:law:catalog:renonciationduntitulairesanseffetsurlesautres:v0")));
    expect truth_status == TRUE_ONLY;
}
