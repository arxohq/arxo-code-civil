language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-AVANCEDESSOMMESNECESSAIRES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": avance_demandee_en_justice(entity_ref("urn:law:catalog:avancedessommesnecessaires:v0")) { origin case_input; }
        assert "cat-1": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:avancedessommesnecessaires:v1")) { origin case_input; }
        assert "cat-2": engagement_non_execute(entity_ref("urn:law:catalog:avancedessommesnecessaires:v0")) { origin case_input; }
        assert "cat-3": mise_en_demeure_de_satisfaire_le(entity_ref("urn:law:catalog:avancedessommesnecessaires:v0"), @2026-01-15) { origin case_input; }
        assert "cat-4": obligation_du_contrat(entity_ref("urn:law:catalog:avancedessommesnecessaires:v0"), entity_ref("urn:law:catalog:avancedessommesnecessaires:v1")) { origin case_input; }
    }
    evaluate truth(avance_des_sommes_ordonnable(entity_ref("urn:law:catalog:avancedessommesnecessaires:v0")));
    expect truth_status == TRUE_ONLY;
}
