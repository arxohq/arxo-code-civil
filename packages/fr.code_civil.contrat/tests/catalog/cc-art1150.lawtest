language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ACTESDESMAJEURSPROTEGESRENVOYES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v0")) { origin case_input; }
        assert "cat-1": majeur_protege(entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v1")) { origin case_input; }
        assert "cat-2": acte_du_majeur_protege_regi_par_les_articles_speciaux(entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v0"), entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v1")) { origin case_input; }
        assert "cat-3": partie_au_contrat(entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v0"), entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v1")) { origin case_input; }
    }
    evaluate truth(acte_du_majeur_protege_renvoye(entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v0"), entity_ref("urn:law:catalog:actesdesmajeursprotegesrenvoyes:v1")));
    expect truth_status == TRUE_ONLY;
}
