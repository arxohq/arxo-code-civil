language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CHARGEDELAPREUVEDELAGRAVITE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": contestation_de_la_resolution_par_le_debiteur(entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v0")) { origin case_input; }
        assert "cat-1": contrat_resolu(entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v0")) { origin case_input; }
        assert "cat-2": creancier_de_l_obligation(entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v1"), entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v2")) { origin case_input; }
        assert "cat-3": obligation_du_contrat(entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v1"), entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v0")) { origin case_input; }
    }
    evaluate truth(charge_de_prouver_la_gravite(entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v0"), entity_ref("urn:law:catalog:chargedelapreuvedelagravite:v2")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-RESOLUTIONPARNOTIFICATIONENCASDURGENCE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": engagement_non_execute(entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v1")) { origin case_input; }
        assert "cat-1": urgence(entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v1")) { origin case_input; }
        assert "cat-2": force_obligatoire(entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v0")) { origin case_input; }
        assert "cat-3": creancier_de_l_obligation(entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v1"), entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v2")) { origin case_input; }
        assert "cat-4": obligation_du_contrat(entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v1"), entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v0")) { origin case_input; }
    }
    evaluate truth(notification_de_resolution(entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v0"), entity_ref("urn:law:catalog:resolutionparnotificationencasdurgence:v2")));
    expect truth_status == TRUE_ONLY;
}
