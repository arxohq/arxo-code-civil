language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DETOURNEMENTDEPOUVOIRSCONNUDUTIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": represente(entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v0"), entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v2")) { origin case_input; }
        assert "cat-1": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v1")) { origin case_input; }
        assert "cat-2": tiers_connaissait_le_detournement(entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v1"), entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v3")) { origin case_input; }
        assert "cat-3": representation_pour_le_contrat(entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v0"), entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v1")) { origin case_input; }
        assert "cat-4": partie_au_contrat(entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v1"), entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v3")) { origin case_input; }
        assert "cat-5": detournement_de_pouvoirs(entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v0")) { origin case_input; }
    }
    evaluate truth(nullite_pour_detournement_de_pouvoirs(entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v1"), entity_ref("urn:law:catalog:detournementdepouvoirsconnudutiers:v2")));
    expect truth_status == TRUE_ONLY;
}
