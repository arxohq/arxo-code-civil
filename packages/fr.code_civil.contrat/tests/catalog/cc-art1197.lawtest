language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-OBLIGATIONDECONSERVERJUSQUALADELIVRANCE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:obligationdeconserverjusqualadelivrance:v0")) { origin case_input; }
        assert "cat-1": chose_conservee_avec_les_soins_d_une_personne_raisonnable(entity_ref("urn:law:catalog:obligationdeconserverjusqualadelivrance:v1")) { origin case_input; }
        assert "cat-2": obligation_de_delivrer(entity_ref("urn:law:catalog:obligationdeconserverjusqualadelivrance:v1"), entity_ref("urn:law:catalog:obligationdeconserverjusqualadelivrance:v0")) { origin case_input; }
    }
    evaluate truth(obligation_de_conserver_respectee(entity_ref("urn:law:catalog:obligationdeconserverjusqualadelivrance:v1")));
    expect truth_status == TRUE_ONLY;
}
