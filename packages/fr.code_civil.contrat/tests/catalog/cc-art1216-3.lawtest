language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CODEBITEURSTENUSDEDUCTIONFAITE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": codebiteur_solidaire_du_cedant(entity_ref("urn:law:catalog:codebiteurstenusdeductionfaite:v0"), entity_ref("urn:law:catalog:codebiteurstenusdeductionfaite:v2")) { origin case_input; }
        assert "cat-1": cedant_libere(entity_ref("urn:law:catalog:codebiteurstenusdeductionfaite:v0"), entity_ref("urn:law:catalog:codebiteurstenusdeductionfaite:v1")) { origin case_input; }
    }
    evaluate truth(codebiteurs_tenus_deduction_faite_de_la_part_du_cedant(entity_ref("urn:law:catalog:codebiteurstenusdeductionfaite:v0"), entity_ref("urn:law:catalog:codebiteurstenusdeductionfaite:v2")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SURETESETEINTESFAUTEDACCORD" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cedant_libere(entity_ref("urn:law:catalog:sureteseteintesfautedaccord:v0"), entity_ref("urn:law:catalog:sureteseteintesfautedaccord:v1")) { origin case_input; }
        assert "cat-1": surete_consentie_par_le_cedant_ou_un_tiers(entity_ref("urn:law:catalog:sureteseteintesfautedaccord:v0")) { origin case_input; }
    }
    evaluate truth(surete_eteinte(entity_ref("urn:law:catalog:sureteseteintesfautedaccord:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SURETESMAINTENUESPARACCORDDUGARANT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": accord_du_garant_au_maintien(entity_ref("urn:law:catalog:suretesmaintenuesparaccorddugarant:v0")) { origin case_input; }
        assert "cat-1": cedant_libere(entity_ref("urn:law:catalog:suretesmaintenuesparaccorddugarant:v0"), entity_ref("urn:law:catalog:suretesmaintenuesparaccorddugarant:v1")) { origin case_input; }
        assert "cat-2": surete_consentie_par_le_cedant_ou_un_tiers(entity_ref("urn:law:catalog:suretesmaintenuesparaccorddugarant:v0")) { origin case_input; }
    }
    evaluate truth(surete_maintenue(entity_ref("urn:law:catalog:suretesmaintenuesparaccorddugarant:v0")));
    expect truth_status == TRUE_ONLY;
}
