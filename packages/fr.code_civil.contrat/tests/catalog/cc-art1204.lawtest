language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RATIFICATIONRETROACTIVE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": porte_fort(entity_ref("urn:law:catalog:ratificationretroactive:v0"), entity_ref("urn:law:catalog:ratificationretroactive:v1"), entity_ref("urn:law:catalog:ratificationretroactive:v2")) { origin case_input; }
        assert "cat-1": engagement_ratifie_par_le_tiers(entity_ref("urn:law:catalog:ratificationretroactive:v0")) { origin case_input; }
        assert "cat-2": porte_fort_de_ratification(entity_ref("urn:law:catalog:ratificationretroactive:v0"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(engagement_valide_retroactivement(entity_ref("urn:law:catalog:ratificationretroactive:v0"), @2026-01-15));
    expect truth_status == TRUE_ONLY;
}
