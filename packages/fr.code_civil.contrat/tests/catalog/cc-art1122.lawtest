language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ACCEPTATIONAVANTLEDELAIDEREFLEXION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:acceptationavantledelaidereflexion:v0")) { origin case_input; }
        assert "cat-1": acceptation_manifestee_le(entity_ref("urn:law:catalog:acceptationavantledelaidereflexion:v0"), @2026-01-14) { origin case_input; }
        assert "cat-2": delai_de_reflexion_prevu(entity_ref("urn:law:catalog:acceptationavantledelaidereflexion:v0"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(acceptation_prematuree(entity_ref("urn:law:catalog:acceptationavantledelaidereflexion:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-FACULTEDERETRACTATIONOUVERTE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:facultederetractationouverte:v0")) { origin case_input; }
        assert "cat-1": delai_de_retractation_prevu(entity_ref("urn:law:catalog:facultederetractationouverte:v0"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(faculte_de_retractation_ouverte(entity_ref("urn:law:catalog:facultederetractationouverte:v0"), @2026-01-15));
    expect truth_status == TRUE_ONLY;
}
