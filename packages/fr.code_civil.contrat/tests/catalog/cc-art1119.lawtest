language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CLAUSESINCOMPATIBLESSANSEFFET" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:clausesincompatiblessanseffet:v0")) { origin case_input; }
        assert "cat-1": clauses_incompatibles(entity_ref("urn:law:catalog:clausesincompatiblessanseffet:v1"), entity_ref("urn:law:catalog:clausesincompatiblessanseffet:v2")) { origin case_input; }
        assert "cat-2": clause_du_contrat(entity_ref("urn:law:catalog:clausesincompatiblessanseffet:v1"), entity_ref("urn:law:catalog:clausesincompatiblessanseffet:v0")) { origin case_input; }
    }
    evaluate truth(clause_sans_effet(entity_ref("urn:law:catalog:clausesincompatiblessanseffet:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CONDITIONSGENERALESOPPOSABLES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:conditionsgeneralesopposables:v0")) { origin case_input; }
        assert "cat-1": conditions_generales_acceptees_par(entity_ref("urn:law:catalog:conditionsgeneralesopposables:v1"), entity_ref("urn:law:catalog:conditionsgeneralesopposables:v3")) { origin case_input; }
        assert "cat-2": partie_au_contrat(entity_ref("urn:law:catalog:conditionsgeneralesopposables:v0"), entity_ref("urn:law:catalog:conditionsgeneralesopposables:v3")) { origin case_input; }
        assert "cat-3": conditions_generales_invoquees_par(entity_ref("urn:law:catalog:conditionsgeneralesopposables:v0"), entity_ref("urn:law:catalog:conditionsgeneralesopposables:v2"), entity_ref("urn:law:catalog:conditionsgeneralesopposables:v1")) { origin case_input; }
        assert "cat-4": conditions_generales_portees_a_la_connaissance_de(entity_ref("urn:law:catalog:conditionsgeneralesopposables:v1"), entity_ref("urn:law:catalog:conditionsgeneralesopposables:v3")) { origin case_input; }
    }
    evaluate truth(conditions_generales_opposables(entity_ref("urn:law:catalog:conditionsgeneralesopposables:v1"), entity_ref("urn:law:catalog:conditionsgeneralesopposables:v3")));
    expect truth_status == TRUE_ONLY;
}
