language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-OBLIGATIONSDELOFFREELECTRONIQUE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": offre_du_contrat(entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v0"), entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v1")) { origin case_input; }
        assert "cat-1": mentions_de_l_offre_electronique_completes(entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v0")) { origin case_input; }
        assert "cat-2": offre_electronique_accessible(entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v0")) { origin case_input; }
        assert "cat-3": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v1")) { origin case_input; }
        assert "cat-4": offre_par_voie_electronique(entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v0")) { origin case_input; }
        assert "cat-5": stipulations_mises_a_disposition_conservables(entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v0")) { origin case_input; }
    }
    evaluate truth(obligations_de_l_offre_electronique_respectees(entity_ref("urn:law:catalog:obligationsdeloffreelectronique:v0")));
    expect truth_status == TRUE_ONLY;
}
