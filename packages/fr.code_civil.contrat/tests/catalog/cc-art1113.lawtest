language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RENCONTREDELOFFREETDELACCEPTATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": offre_du_contrat(entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v0"), entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v1")) { origin case_input; }
        assert "cat-1": regi_par_le_droit_nouveau(entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v1")) { origin case_input; }
        assert "cat-2": volonte_de_s_engager_manifestee(entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v0")) { origin case_input; }
        assert "cat-3": acceptation_parvenue_a_l_offrant_le(entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v0"), @2026-01-15) { origin case_input; }
        assert "cat-4": acceptation_conforme_a_l_offre(entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v0")) { origin case_input; }
        assert "cat-5": offre_valable(entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v0")) { origin case_input; }
    }
    evaluate truth(rencontre_de_l_offre_et_de_l_acceptation(entity_ref("urn:law:catalog:rencontredeloffreetdelacceptation:v1")));
    expect truth_status == TRUE_ONLY;
}
