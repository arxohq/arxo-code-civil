language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RISQUESRETOMBESSURLEDEBITEURMISENDEMEURE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": obligation_de_delivrer(entity_ref("urn:law:catalog:risquesretombessurledebiteurmisendemeure:v1"), entity_ref("urn:law:catalog:risquesretombessurledebiteurmisendemeure:v0")) { origin case_input; }
        assert "cat-1": debiteur_de_l_obligation(entity_ref("urn:law:catalog:risquesretombessurledebiteurmisendemeure:v1"), entity_ref("urn:law:catalog:risquesretombessurledebiteurmisendemeure:v2")) { origin case_input; }
        assert "cat-2": mise_en_demeure_du_debiteur_le(entity_ref("urn:law:catalog:risquesretombessurledebiteurmisendemeure:v1"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(risques_retombes_sur_le_debiteur_mis_en_demeure(entity_ref("urn:law:catalog:risquesretombessurledebiteurmisendemeure:v1"), entity_ref("urn:law:catalog:risquesretombessurledebiteurmisendemeure:v2")));
    expect truth_status == TRUE_ONLY;
}
