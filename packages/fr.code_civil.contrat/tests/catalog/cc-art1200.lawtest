language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-TIERSSEPREVAUTDUCONTRAT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": force_obligatoire(entity_ref("urn:law:catalog:tiersseprevautducontrat:v0")) { origin case_input; }
        assert "cat-1": tiers_invoque_le_contrat_comme_preuve_d_un_fait(entity_ref("urn:law:catalog:tiersseprevautducontrat:v0"), entity_ref("urn:law:catalog:tiersseprevautducontrat:v1")) { origin case_input; }
        assert "cat-2": tiers_au_contrat(entity_ref("urn:law:catalog:tiersseprevautducontrat:v0"), entity_ref("urn:law:catalog:tiersseprevautducontrat:v1")) { origin case_input; }
    }
    evaluate truth(contrat_invocable_comme_preuve_par_le_tiers(entity_ref("urn:law:catalog:tiersseprevautducontrat:v0"), entity_ref("urn:law:catalog:tiersseprevautducontrat:v1")));
    expect truth_status == TRUE_ONLY;
}
