language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RETRACTATIONENGAGELARESPONSABILITE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": auteur_de_l_offre(entity_ref("urn:law:catalog:retractationengagelaresponsabilite:v0"), entity_ref("urn:law:catalog:retractationengagelaresponsabilite:v1")) { origin case_input; }
        assert "cat-1": retractation_interdite_de_l_offre(entity_ref("urn:law:catalog:retractationengagelaresponsabilite:v0")) { origin case_input; }
    }
    evaluate truth(responsabilite_extracontractuelle_de_l_offrant(entity_ref("urn:law:catalog:retractationengagelaresponsabilite:v0"), entity_ref("urn:law:catalog:retractationengagelaresponsabilite:v1")));
    expect truth_status == TRUE_ONLY;
}
