language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1213 : le contrat peut être prorogé si les contractants en manifestent la volonté avant son expiration — ici le 1er décembre pour un terme au 31 décembre.
test "urn:query:fr-code-civil-contrat-e22-prorogation-avant-l-expiration" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e22"), @2019-03-01) { origin case_input; }
        assert "f2": terme_du_contrat(entity_ref("urn:fr:cc:contrat:e22"), @2020-12-31) { origin case_input; }
        assert "f3": volonte_de_proroger_manifestee_le(entity_ref("urn:fr:cc:contrat:e22"), @2020-12-01) { origin case_input; }
    }
    evaluate truth(contrat_proroge(entity_ref("urn:fr:cc:contrat:e22")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ProrogationAvantExpiration);
}
