language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1211, canal §47.3 : à défaut de préavis contractuel, le délai raisonnable est une appréciation du juge.
test "urn:query:fr-code-civil-contrat-e19-preavis-raisonnable-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e19"), @2019-03-01) { origin case_input; }
        assert "f2": duree_du_contrat(entity_ref("urn:fr:cc:contrat:e19"), DureeIndeterminee) { origin case_input; }
        assert "f3": resiliation_notifiee_le(entity_ref("urn:fr:cc:contrat:e19"), entity_ref("urn:fr:cc:contrat:e19:p1"), @2020-04-10) { origin case_input; }
    }
    evaluate truth(resiliation_reguliere(entity_ref("urn:fr:cc:contrat:e19"), entity_ref("urn:fr:cc:contrat:e19:p1")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(delai_de_preavis_raisonnable_expire_le_1211, Court);
}
