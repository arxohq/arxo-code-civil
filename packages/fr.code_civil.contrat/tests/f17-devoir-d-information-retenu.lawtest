language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1112-1 al. 1 : le juge retient l'importance déterminante ; l'acheteur l'ignorait légitimement — le vendeur doit l'informer.
test "urn:query:fr-code-civil-contrat-f17-devoir-d-information-retenu" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:f17"), @2019-03-01) { origin case_input; }
        assert "f2": information_du_contrat(entity_ref("urn:fr:cc:contrat:f17:info"), entity_ref("urn:fr:cc:contrat:f17")) { origin case_input; }
        assert "f3": information_connue_de(entity_ref("urn:fr:cc:contrat:f17:info"), entity_ref("urn:fr:cc:contrat:f17:vendeur")) { origin case_input; }
        assert "f4": information_legitimement_ignoree_par(entity_ref("urn:fr:cc:contrat:f17:info"), entity_ref("urn:fr:cc:contrat:f17:acheteur")) { origin case_input; }
        assert "f5": information_d_importance_determinante(entity_ref("urn:fr:cc:contrat:f17:info"), entity_ref("urn:fr:cc:contrat:f17:acheteur")) { origin adjudicated; }
    }
    evaluate truth(devoir_d_information_du(entity_ref("urn:fr:cc:contrat:f17:info"), entity_ref("urn:fr:cc:contrat:f17:vendeur"), entity_ref("urn:fr:cc:contrat:f17:acheteur")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DevoirDInformation);
    expect judgment_requests(0);
}
