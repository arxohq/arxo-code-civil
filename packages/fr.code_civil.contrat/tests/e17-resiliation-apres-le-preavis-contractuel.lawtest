language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1211 : le préavis contractuel expirant le 1er avril 2020, la résiliation du 10 avril le respecte.
test "urn:query:fr-code-civil-contrat-e17-resiliation-apres-le-preavis-contractuel" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e17"), @2019-03-01) { origin case_input; }
        assert "f2": duree_du_contrat(entity_ref("urn:fr:cc:contrat:e17"), DureeIndeterminee) { origin case_input; }
        assert "f3": resiliation_notifiee_le(entity_ref("urn:fr:cc:contrat:e17"), entity_ref("urn:fr:cc:contrat:e17:p1"), @2020-04-10) { origin case_input; }
        assert "f4": preavis_contractuel_expirant_le(entity_ref("urn:fr:cc:contrat:e17"), @2020-04-01) { origin case_input; }
    }
    evaluate truth(resiliation_reguliere(entity_ref("urn:fr:cc:contrat:e17"), entity_ref("urn:fr:cc:contrat:e17:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ResiliationAvecPreavisContractuel);
}
