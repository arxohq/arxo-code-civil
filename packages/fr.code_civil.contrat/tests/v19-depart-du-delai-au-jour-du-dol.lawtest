language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1144 : le délai de l'action en nullité ne court, en cas de dol, que du jour où il a été découvert — ici le 4 mai 2020.
test "urn:query:fr-code-civil-contrat-v19-depart-du-delai-au-jour-du-dol" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v19"), @2019-03-01) { origin case_input; }
        assert "f2": dol_decouvert_le(entity_ref("urn:fr:cc:contrat:v19"), @2020-05-04) { origin case_input; }
    }
    evaluate truth(point_de_depart_de_l_action_en_nullite(entity_ref("urn:fr:cc:contrat:v19"), @2020-05-04));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DepartDuDelaiDol);
}
