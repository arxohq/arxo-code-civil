language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1195 al. 1 : les deux appréciations retenues et le risque non accepté — la partie atteinte peut demander une renégociation.
test "urn:query:fr-code-civil-contrat-e03-imprevision-renegociation-ouverte" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e03"), @2019-03-01) { origin case_input; }
        assert "f2": partie_au_contrat(entity_ref("urn:fr:cc:contrat:e03"), entity_ref("urn:fr:cc:contrat:e03:p1")) { origin case_input; }
        assert "f3": changement_de_circonstances(entity_ref("urn:fr:cc:contrat:e03"), entity_ref("urn:fr:cc:contrat:e03:p1")) { origin case_input; }
        assert "f4": changement_imprevisible_lors_de_la_conclusion(entity_ref("urn:fr:cc:contrat:e03")) { origin adjudicated; }
        assert "f5": execution_excessivement_onereuse(entity_ref("urn:fr:cc:contrat:e03"), entity_ref("urn:fr:cc:contrat:e03:p1")) { origin adjudicated; }
    }
    evaluate truth(renegociation_ouverte(entity_ref("urn:fr:cc:contrat:e03"), entity_ref("urn:fr:cc:contrat:e03:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ImprevisionOuvreLaRenegociation);
    expect judgment_requests(0);
}
