language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1204 al. 2 : le promettant est libéré de toute obligation si le tiers accomplit le fait promis.
test "urn:query:fr-code-civil-contrat-e10-porte-fort-libere-par-l-accomplissement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": porte_fort(entity_ref("urn:fr:cc:contrat:e10:s"), entity_ref("urn:fr:cc:contrat:e10:p1"), entity_ref("urn:fr:cc:contrat:e10:tiers")) { origin case_input; }
        assert "f2": fait_promis_accompli_par_le_tiers(entity_ref("urn:fr:cc:contrat:e10:s")) { origin case_input; }
    }
    evaluate truth(promettant_libere(entity_ref("urn:fr:cc:contrat:e10:s"), entity_ref("urn:fr:cc:contrat:e10:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PortefortLibereParLAccomplissement);
}
