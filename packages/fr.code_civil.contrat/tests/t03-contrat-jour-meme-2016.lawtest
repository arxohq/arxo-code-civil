language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Ord. 2016-131 art. 9 : contrat conclu le 1er octobre 2016, jour de l'entrée en vigueur — rédaction nouvelle.
test "urn:query:fr-code-civil-contrat-t03-contrat-jour-meme-2016" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t03"), @2016-10-01) { origin case_input; }
    }
    evaluate truth(regi_par_le_droit_nouveau(entity_ref("urn:fr:cc:contrat:t03")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ContratRegiParLeDroitNouveau);
}
