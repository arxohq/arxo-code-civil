language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1112-1 al. 1 et 3, canal §47.3 : l'importance déterminante de l'information est une appréciation adressée au juge.
test "urn:query:fr-code-civil-contrat-f16-devoir-d-information-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:f16"), @2019-03-01) { origin case_input; }
        assert "f2": information_du_contrat(entity_ref("urn:fr:cc:contrat:f16:info"), entity_ref("urn:fr:cc:contrat:f16")) { origin case_input; }
        assert "f3": information_connue_de(entity_ref("urn:fr:cc:contrat:f16:info"), entity_ref("urn:fr:cc:contrat:f16:vendeur")) { origin case_input; }
        assert "f4": information_legitimement_ignoree_par(entity_ref("urn:fr:cc:contrat:f16:info"), entity_ref("urn:fr:cc:contrat:f16:acheteur")) { origin case_input; }
    }
    evaluate truth(devoir_d_information_du(entity_ref("urn:fr:cc:contrat:f16:info"), entity_ref("urn:fr:cc:contrat:f16:vendeur"), entity_ref("urn:fr:cc:contrat:f16:acheteur")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(information_d_importance_determinante, Court);
}
