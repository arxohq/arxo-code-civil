language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1195 al. 1 : la partie qui avait accepté d'assumer le risque du changement ne peut pas demander la renégociation.
test "urn:query:fr-code-civil-contrat-e04-imprevision-risque-accepte" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e04"), @2019-03-01) { origin case_input; }
        assert "f2": partie_au_contrat(entity_ref("urn:fr:cc:contrat:e04"), entity_ref("urn:fr:cc:contrat:e04:p1")) { origin case_input; }
        assert "f3": changement_de_circonstances(entity_ref("urn:fr:cc:contrat:e04"), entity_ref("urn:fr:cc:contrat:e04:p1")) { origin case_input; }
        assert "f4": changement_imprevisible_lors_de_la_conclusion(entity_ref("urn:fr:cc:contrat:e04")) { origin adjudicated; }
        assert "f5": execution_excessivement_onereuse(entity_ref("urn:fr:cc:contrat:e04"), entity_ref("urn:fr:cc:contrat:e04:p1")) { origin adjudicated; }
        assert "f6": risque_du_changement_accepte(entity_ref("urn:fr:cc:contrat:e04"), entity_ref("urn:fr:cc:contrat:e04:p1")) { origin case_input; }
    }
    evaluate truth(renegociation_ouverte(entity_ref("urn:fr:cc:contrat:e04"), entity_ref("urn:fr:cc:contrat:e04:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
