language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Ord. 2016-131 art. 9 : contrat conclu le 2 octobre 2016 — rédaction nouvelle, pas de frontière.
test "urn:query:fr-code-civil-contrat-t04-contrat-lendemain-2016" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t04"), @2016-10-02) { origin case_input; }
    }
    evaluate truth(regime_anterieur_non_formalise(entity_ref("urn:fr:cc:contrat:t04")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
