language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1210 : les engagements perpétuels sont prohibés.
test "urn:query:fr-code-civil-contrat-e16-engagements-perpetuels-prohibes" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e16"), @2019-03-01) { origin case_input; }
        assert "f2": engagement_perpetuel(entity_ref("urn:fr:cc:contrat:e16")) { origin case_input; }
    }
    evaluate truth(engagement_perpetuel_prohibe(entity_ref("urn:fr:cc:contrat:e16")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EngagementsPerpetuelsProhibes);
}
