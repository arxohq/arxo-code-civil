language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1137 al. 2, rédaction de 2016 : la dissimulation intentionnelle de l'estimation de la valeur est un dol pour l'acte de 2017 — l'exception de l'alinéa 3 n'existe pas encore.
test "urn:query:fr-code-civil-contrat-t11-reticence-sur-la-valeur-2017-dol" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t11"), @2017-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:t11"), @2017-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:t11"), "1137") { origin case_input; }
        assert "f4": dissimulation_intentionnelle(entity_ref("urn:fr:cc:contrat:t11"), entity_ref("urn:fr:cc:contrat:t11:info"), entity_ref("urn:fr:cc:contrat:t11:vendeur"), entity_ref("urn:fr:cc:contrat:t11:acheteur")) { origin case_input; }
        assert "f5": information_porte_sur_l_estimation_de_la_valeur(entity_ref("urn:fr:cc:contrat:t11:info")) { origin case_input; }
        assert "f6": caractere_determinant_du_vice(entity_ref("urn:fr:cc:contrat:t11"), entity_ref("urn:fr:cc:contrat:t11:acheteur")) { origin adjudicated; }
    }
    evaluate truth(vice_du_consentement(entity_ref("urn:fr:cc:contrat:t11"), entity_ref("urn:fr:cc:contrat:t11:acheteur"), Dol));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DolParDissimulationIntentionnelle2016);
}
