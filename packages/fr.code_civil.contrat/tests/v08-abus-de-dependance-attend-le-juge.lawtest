language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1143, canal §47.3 : l'avantage « manifestement excessif » tiré de l'abus de dépendance est une appréciation du juge.
test "urn:query:fr-code-civil-contrat-v08-abus-de-dependance-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v08"), @2017-05-01) { origin case_input; }
        assert "f2": etat_de_dependance(entity_ref("urn:fr:cc:contrat:v08"), entity_ref("urn:fr:cc:contrat:v08:p1"), entity_ref("urn:fr:cc:contrat:v08:p2")) { origin case_input; }
        assert "f3": engagement_non_souscrit_sans_la_contrainte(entity_ref("urn:fr:cc:contrat:v08"), entity_ref("urn:fr:cc:contrat:v08:p1")) { origin case_input; }
    }
    evaluate truth(vice_du_consentement(entity_ref("urn:fr:cc:contrat:v08"), entity_ref("urn:fr:cc:contrat:v08:p1"), Violence));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(avantage_manifestement_excessif_1143, Court);
}
