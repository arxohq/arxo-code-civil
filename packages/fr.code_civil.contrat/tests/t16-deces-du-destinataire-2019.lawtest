language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1117 al. 2, rédaction de 2018 : le décès du destinataire rend l'offre caduque pour un acte de 2019.
test "urn:query:fr-code-civil-contrat-t16-deces-du-destinataire-2019" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t16"), @2019-02-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:t16"), @2019-02-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:t16"), "1117") { origin case_input; }
        assert "f4": offre_du_contrat(entity_ref("urn:fr:cc:contrat:t16:offre"), entity_ref("urn:fr:cc:contrat:t16")) { origin case_input; }
        assert "f5": deces_du_destinataire_de_l_offre(entity_ref("urn:fr:cc:contrat:t16:offre")) { origin case_input; }
    }
    evaluate truth(offre_caduque(entity_ref("urn:fr:cc:contrat:t16:offre")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CaduciteParDecesDuDestinataire2018);
}
