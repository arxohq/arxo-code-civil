language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1221, canal §47.3 : la disproportion manifeste entre le coût pour le débiteur de bonne foi et l'intérêt du créancier, retenue par le juge, écarte l'exécution en nature.
test "urn:query:fr-code-civil-contrat-i11-disproportion-manifeste-ecarte-l-execution" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i11"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i11"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i11"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i11")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i11")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i11")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i11"), entity_ref("urn:fr:cc:contrat:i11:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i11:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i11"), entity_ref("urn:fr:cc:contrat:i11:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i11"), entity_ref("urn:fr:cc:contrat:i11:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i11:o"), entity_ref("urn:fr:cc:contrat:i11")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i11:o"), entity_ref("urn:fr:cc:contrat:i11:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i11:o"), entity_ref("urn:fr:cc:contrat:i11:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:i11:o")) { origin case_input; }
        assert "f15": mise_en_demeure_de_satisfaire_le(entity_ref("urn:fr:cc:contrat:i11:o"), @2020-02-01) { origin case_input; }
        assert "f16": debiteur_de_bonne_foi(entity_ref("urn:fr:cc:contrat:i11:o")) { origin case_input; }
        assert "f17": disproportion_manifeste(entity_ref("urn:fr:cc:contrat:i11:o")) { origin adjudicated; }
    }
    evaluate truth(execution_forcee_en_nature_refusee(entity_ref("urn:fr:cc:contrat:i11:o")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DisproportionManifesteEcarteLExecution);

    evaluate truth(execution_forcee_en_nature_ouverte(entity_ref("urn:fr:cc:contrat:i11:o")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
