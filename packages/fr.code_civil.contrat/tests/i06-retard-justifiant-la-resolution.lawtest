language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1218 al. 2 : le retard résultant de la suspension justifiant la résolution, le contrat est résolu malgré le caractère temporaire de l'empêchement.
test "urn:query:fr-code-civil-contrat-i06-retard-justifiant-la-resolution" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i06"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i06"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i06"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i06")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i06")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i06")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i06"), entity_ref("urn:fr:cc:contrat:i06:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i06:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i06"), entity_ref("urn:fr:cc:contrat:i06:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i06"), entity_ref("urn:fr:cc:contrat:i06:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i06:o"), entity_ref("urn:fr:cc:contrat:i06")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i06:o"), entity_ref("urn:fr:cc:contrat:i06:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i06:o"), entity_ref("urn:fr:cc:contrat:i06:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:i06:o")) { origin case_input; }
        assert "f15": evenement_echappant_au_controle_du_debiteur(entity_ref("urn:fr:cc:contrat:i06:o")) { origin case_input; }
        assert "f16": evenement_non_raisonnablement_previsible(entity_ref("urn:fr:cc:contrat:i06:o")) { origin adjudicated; }
        assert "f17": effets_non_evitables_par_des_mesures_appropriees(entity_ref("urn:fr:cc:contrat:i06:o")) { origin adjudicated; }
        assert "f18": empechement_temporaire(entity_ref("urn:fr:cc:contrat:i06:o")) { origin case_input; }
        assert "f19": retard_justifiant_la_resolution(entity_ref("urn:fr:cc:contrat:i06:o")) { origin adjudicated; }
    }
    evaluate truth(contrat_resolu_de_plein_droit(entity_ref("urn:fr:cc:contrat:i06")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ResolutionParLeRetardTemporaire);

    evaluate truth(execution_suspendue(entity_ref("urn:fr:cc:contrat:i06:o")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
