language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1148 : l'incapable peut accomplir seul les actes courants autorisés par l'usage, conclus à des conditions normales — l'incapacité ne vicie alors pas le contrat. Tête commune (D-15) : les autres causes de nullité restent ouvertes.
test "urn:query:fr-code-civil-contrat-v18-acte-courant-de-l-incapable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v18"), @2019-03-01) { origin case_input; }
        assert "f2": partie_au_contrat(entity_ref("urn:fr:cc:contrat:v18"), entity_ref("urn:fr:cc:contrat:v18:p1")) { origin case_input; }
        assert "f3": mineur_non_emancipe(entity_ref("urn:fr:cc:contrat:v18:p1")) { origin case_input; }
        assert "f4": acte_courant_autorise_par_la_loi_ou_l_usage(entity_ref("urn:fr:cc:contrat:v18")) { origin case_input; }
        assert "f5": conditions_normales(entity_ref("urn:fr:cc:contrat:v18")) { origin case_input; }
    }
    evaluate truth(acte_courant_valablement_accompli(entity_ref("urn:fr:cc:contrat:v18"), entity_ref("urn:fr:cc:contrat:v18:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ActeCourantDeLIncapable);

    evaluate truth(cause_de_nullite(entity_ref("urn:fr:cc:contrat:v18"), Relative));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(contrepartie_illusoire_ou_derisoire, Court);
}
