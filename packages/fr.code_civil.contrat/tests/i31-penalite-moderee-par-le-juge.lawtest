language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1231-5 al. 2, canal §47.3 : la pénalité retenue comme manifestement excessive est modérée par le juge à 1 500 EUR.
test "urn:query:fr-code-civil-contrat-i31-penalite-moderee-par-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i31"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i31"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i31"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i31")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i31")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i31")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i31"), entity_ref("urn:fr:cc:contrat:i31:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i31:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i31"), entity_ref("urn:fr:cc:contrat:i31:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i31"), entity_ref("urn:fr:cc:contrat:i31:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i31:o"), entity_ref("urn:fr:cc:contrat:i31")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i31:o"), entity_ref("urn:fr:cc:contrat:i31:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i31:o"), entity_ref("urn:fr:cc:contrat:i31:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:i31:o")) { origin case_input; }
        assert "f15": clause_penale(entity_ref("urn:fr:cc:contrat:i31:clause"), entity_ref("urn:fr:cc:contrat:i31:o"), 5000 EUR) { origin case_input; }
        assert "f16": mise_en_demeure_de_satisfaire_le(entity_ref("urn:fr:cc:contrat:i31:o"), @2020-02-01) { origin case_input; }
        assert "f17": penalite_manifestement_excessive_ou_derisoire(entity_ref("urn:fr:cc:contrat:i31:clause")) { origin adjudicated; }
        assert "f18": penalite_moderee_ou_augmentee_par_le_juge(entity_ref("urn:fr:cc:contrat:i31:clause"), 1500 EUR) { origin adjudicated; }
    }
    evaluate truth(penalite_due(entity_ref("urn:fr:cc:contrat:i31:clause"), 1500 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PenaliteModereeOuAugmentee);

    evaluate truth(penalite_due(entity_ref("urn:fr:cc:contrat:i31:clause"), 5000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
