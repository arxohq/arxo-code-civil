language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1117 al. 2, rédaction de 2016 : le décès du destinataire ne rend pas l'offre caduque pour un acte de 2017 ; tête commune (D-15) : la caducité par délai raisonnable reste une question ouverte au juge.
test "urn:query:fr-code-civil-contrat-t15-deces-du-destinataire-2017" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:t15"), @2017-02-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:t15"), @2017-02-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:t15"), "1117") { origin case_input; }
        assert "f4": offre_du_contrat(entity_ref("urn:fr:cc:contrat:t15:offre"), entity_ref("urn:fr:cc:contrat:t15")) { origin case_input; }
        assert "f5": deces_du_destinataire_de_l_offre(entity_ref("urn:fr:cc:contrat:t15:offre")) { origin case_input; }
    }
    evaluate truth(offre_caduque(entity_ref("urn:fr:cc:contrat:t15:offre")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(delai_raisonnable_de_caducite_expire_le_1117, Court);
}
