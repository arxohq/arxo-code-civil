language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1158 al. 1, canal §47.3 : le délai fixé par le tiers « doit être raisonnable » — question au juge.
test "urn:query:fr-code-civil-contrat-v25-1158-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v25"), @2015-06-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:v25"), "1158") { origin case_input; }
        assert "f3": representation_pour_le_contrat(entity_ref("urn:fr:cc:contrat:v25:r"), entity_ref("urn:fr:cc:contrat:v25")) { origin case_input; }
        assert "f4": representation_conventionnelle(entity_ref("urn:fr:cc:contrat:v25:r")) { origin case_input; }
        assert "f5": representant(entity_ref("urn:fr:cc:contrat:v25:r"), entity_ref("urn:fr:cc:contrat:v25:p1")) { origin case_input; }
        assert "f6": represente(entity_ref("urn:fr:cc:contrat:v25:r"), entity_ref("urn:fr:cc:contrat:v25:p2")) { origin case_input; }
        assert "f7": demande_ecrite_de_confirmation_du_pouvoir(entity_ref("urn:fr:cc:contrat:v25:r"), entity_ref("urn:fr:cc:contrat:v25:tiers"), @2017-09-30) { origin case_input; }
        assert "f8": mention_de_l_habilitation_reputee(entity_ref("urn:fr:cc:contrat:v25:r")) { origin case_input; }
    }
    evaluate truth(representant_repute_habilite(entity_ref("urn:fr:cc:contrat:v25:r")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(delai_de_la_demande_raisonnable_1158, Court);
}
