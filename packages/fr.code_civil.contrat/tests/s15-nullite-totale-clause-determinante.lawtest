language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1184 al. 1 : la clause viciée ayant constitué un élément déterminant de l'engagement, la nullité atteint l'acte tout entier.
test "urn:query:fr-code-civil-contrat-s15-nullite-totale-clause-determinante" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:s15"), @2019-03-01) { origin case_input; }
        assert "f2": cause_de_nullite_limitee_a_des_clauses(entity_ref("urn:fr:cc:contrat:s15"), entity_ref("urn:fr:cc:contrat:s15:clause")) { origin case_input; }
        assert "f3": clause_element_determinant_de_l_engagement(entity_ref("urn:fr:cc:contrat:s15:clause")) { origin case_input; }
    }
    evaluate truth(nullite_totale(entity_ref("urn:fr:cc:contrat:s15")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(NulliteTotaleParClauseDeterminante);
}
