language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1152, 1° : à l'égard des actes faits par un mineur, la prescription court du jour de la majorité — ici le 1er juillet 2021.
test "urn:query:fr-code-civil-contrat-v20-depart-du-delai-a-la-majorite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v20"), @2019-03-01) { origin case_input; }
        assert "f2": partie_au_contrat(entity_ref("urn:fr:cc:contrat:v20"), entity_ref("urn:fr:cc:contrat:v20:p1")) { origin case_input; }
        assert "f3": mineur_non_emancipe(entity_ref("urn:fr:cc:contrat:v20:p1")) { origin case_input; }
        assert "f4": majorite_ou_emancipation_le(entity_ref("urn:fr:cc:contrat:v20:p1"), @2021-07-01) { origin case_input; }
    }
    evaluate truth(point_de_depart_de_l_action_en_nullite(entity_ref("urn:fr:cc:contrat:v20"), @2021-07-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DepartDuDelaiMineur);
}
