language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1145 al. 2, rédaction de 2018 : la capacité de la personne morale n'est plus limitée à son objet mais par les règles qui lui sont applicables — acte de 2019.
test "urn:query:fr-code-civil-contrat-v30-capacite-de-la-personne-morale-2019" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v30"), @2019-02-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:v30"), @2019-02-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:v30"), "1145") { origin case_input; }
        assert "f4": partie_au_contrat(entity_ref("urn:fr:cc:contrat:v30"), entity_ref("urn:fr:cc:contrat:v30:p1")) { origin case_input; }
        assert "f5": personne_morale(entity_ref("urn:fr:cc:contrat:v30:p1")) { origin case_input; }
        assert "f6": regles_propres_a_la_personne_morale_respectees(entity_ref("urn:fr:cc:contrat:v30"), entity_ref("urn:fr:cc:contrat:v30:p1")) { origin case_input; }
    }
    evaluate truth(capacite_de_contracter(entity_ref("urn:fr:cc:contrat:v30"), entity_ref("urn:fr:cc:contrat:v30:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CapaciteDeLaPersonneMorale2018);
}
