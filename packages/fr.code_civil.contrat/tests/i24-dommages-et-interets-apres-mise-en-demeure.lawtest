language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1231 et 1231-1 : la mise en demeure dans un délai retenu comme raisonnable étant faite et la force majeure n'étant pas justifiée, des dommages et intérêts sont dus.
test "urn:query:fr-code-civil-contrat-i24-dommages-et-interets-apres-mise-en-demeure" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i24"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i24"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i24"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i24")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i24")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i24")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i24"), entity_ref("urn:fr:cc:contrat:i24:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i24:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i24"), entity_ref("urn:fr:cc:contrat:i24:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i24"), entity_ref("urn:fr:cc:contrat:i24:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i24:o"), entity_ref("urn:fr:cc:contrat:i24")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i24:o"), entity_ref("urn:fr:cc:contrat:i24:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i24:o"), entity_ref("urn:fr:cc:contrat:i24:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:i24:o")) { origin case_input; }
        assert "f15": mise_en_demeure_de_satisfaire_le(entity_ref("urn:fr:cc:contrat:i24:o"), @2020-02-01) { origin case_input; }
        assert "f16": delai_imparti_par_la_mise_en_demeure(entity_ref("urn:fr:cc:contrat:i24:o"), @2020-03-01) { origin case_input; }
        assert "f17": delai_raisonnable_de_la_mise_en_demeure_1231(entity_ref("urn:fr:cc:contrat:i24:o")) { origin adjudicated; }
    }
    evaluate truth(dommages_et_interets_dus(entity_ref("urn:fr:cc:contrat:i24:o")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DommagesEtInteretsPourInexecution);
}
