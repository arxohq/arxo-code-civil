language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1169 : la contrepartie retenue comme dérisoire au moment de la formation rend nul le contrat à titre onéreux.
test "urn:query:fr-code-civil-contrat-v12-contrepartie-derisoire-retenue" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v12"), @2019-03-01) { origin case_input; }
        assert "f2": contrat_a_titre_onereux(entity_ref("urn:fr:cc:contrat:v12")) { origin case_input; }
        assert "f3": contrepartie_illusoire_ou_derisoire(entity_ref("urn:fr:cc:contrat:v12")) { origin adjudicated; }
    }
    evaluate truth(cause_de_nullite(entity_ref("urn:fr:cc:contrat:v12"), Relative));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ContrepartieIllusoireOuDerisoire);
}
