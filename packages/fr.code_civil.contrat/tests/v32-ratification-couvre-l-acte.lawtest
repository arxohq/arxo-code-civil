language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1156 al. 3 : l'inopposabilité comme la nullité ne peuvent plus être invoquées dès lors que le représenté a ratifié l'acte.
test "urn:query:fr-code-civil-contrat-v32-ratification-couvre-l-acte" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v32"), @2019-03-01) { origin case_input; }
        assert "f2": representation_pour_le_contrat(entity_ref("urn:fr:cc:contrat:v32:r"), entity_ref("urn:fr:cc:contrat:v32")) { origin case_input; }
        assert "f3": representant(entity_ref("urn:fr:cc:contrat:v32:r"), entity_ref("urn:fr:cc:contrat:v32:p1")) { origin case_input; }
        assert "f4": represente(entity_ref("urn:fr:cc:contrat:v32:r"), entity_ref("urn:fr:cc:contrat:v32:p2")) { origin case_input; }
        assert "f5": partie_au_contrat(entity_ref("urn:fr:cc:contrat:v32"), entity_ref("urn:fr:cc:contrat:v32:tiers")) { origin case_input; }
        assert "f6": acte_ratifie_par_le_represente(entity_ref("urn:fr:cc:contrat:v32")) { origin case_input; }
    }
    evaluate truth(acte_inopposable_au_represente(entity_ref("urn:fr:cc:contrat:v32"), entity_ref("urn:fr:cc:contrat:v32:p2")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;

    evaluate truth(nullite_couverte_par_la_ratification(entity_ref("urn:fr:cc:contrat:v32")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RatificationCouvreLActe);
}
