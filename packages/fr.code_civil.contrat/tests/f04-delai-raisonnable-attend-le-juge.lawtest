language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1116 al. 1, canal §47.3 : sans délai fixé, l'issue du délai raisonnable est une question adressée au juge.
test "urn:query:fr-code-civil-contrat-f04-delai-raisonnable-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:f04"), @2019-03-01) { origin case_input; }
        assert "f2": offre_du_contrat(entity_ref("urn:fr:cc:contrat:f04:offre"), entity_ref("urn:fr:cc:contrat:f04")) { origin case_input; }
        assert "f3": offre_comprend_les_elements_essentiels(entity_ref("urn:fr:cc:contrat:f04:offre")) { origin case_input; }
        assert "f4": volonte_d_etre_lie(entity_ref("urn:fr:cc:contrat:f04:offre")) { origin case_input; }
        assert "f5": auteur_de_l_offre(entity_ref("urn:fr:cc:contrat:f04:offre"), entity_ref("urn:fr:cc:contrat:f04:offrant")) { origin case_input; }
        assert "f6": retractation_de_l_offre_le(entity_ref("urn:fr:cc:contrat:f04:offre"), @2019-03-15) { origin case_input; }
    }
    evaluate truth(retractation_interdite_de_l_offre(entity_ref("urn:fr:cc:contrat:f04:offre")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(delai_raisonnable_de_l_offre_expire_le_1116, Court);
}
