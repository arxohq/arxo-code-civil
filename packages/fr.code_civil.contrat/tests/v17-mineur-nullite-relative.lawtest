language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1146, 1° et 1147 : le mineur non émancipé est incapable de contracter et l'incapacité est une cause de nullité relative.
test "urn:query:fr-code-civil-contrat-v17-mineur-nullite-relative" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v17"), @2019-03-01) { origin case_input; }
        assert "f2": partie_au_contrat(entity_ref("urn:fr:cc:contrat:v17"), entity_ref("urn:fr:cc:contrat:v17:p1")) { origin case_input; }
        assert "f3": mineur_non_emancipe(entity_ref("urn:fr:cc:contrat:v17:p1")) { origin case_input; }
    }
    evaluate truth(cause_de_nullite(entity_ref("urn:fr:cc:contrat:v17"), Relative));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(IncapaciteCauseDeNulliteRelative);
}
