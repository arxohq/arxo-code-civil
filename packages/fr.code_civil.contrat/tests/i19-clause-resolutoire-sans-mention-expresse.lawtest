language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1225 al. 2 : la mise en demeure ne produit effet que si elle mentionne expressément la clause résolutoire — sans cette mention, la résolution n'est pas acquise par la clause.
test "urn:query:fr-code-civil-contrat-i19-clause-resolutoire-sans-mention-expresse" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:i19"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:i19"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:i19"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:i19")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:i19")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:i19")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:i19"), entity_ref("urn:fr:cc:contrat:i19:creancier")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:i19:creancier")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:i19"), entity_ref("urn:fr:cc:contrat:i19:creancier")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:i19"), entity_ref("urn:fr:cc:contrat:i19:creancier")) { origin case_input; }
        assert "f11": obligation_du_contrat(entity_ref("urn:fr:cc:contrat:i19:o"), entity_ref("urn:fr:cc:contrat:i19")) { origin case_input; }
        assert "f12": creancier_de_l_obligation(entity_ref("urn:fr:cc:contrat:i19:o"), entity_ref("urn:fr:cc:contrat:i19:creancier")) { origin case_input; }
        assert "f13": debiteur_de_l_obligation(entity_ref("urn:fr:cc:contrat:i19:o"), entity_ref("urn:fr:cc:contrat:i19:debiteur")) { origin case_input; }
        assert "f14": engagement_non_execute(entity_ref("urn:fr:cc:contrat:i19:o")) { origin case_input; }
        assert "f15": clause_du_contrat(entity_ref("urn:fr:cc:contrat:i19:clause"), entity_ref("urn:fr:cc:contrat:i19")) { origin case_input; }
        assert "f16": clause_resolutoire(entity_ref("urn:fr:cc:contrat:i19:clause")) { origin case_input; }
        assert "f17": clause_resolutoire_vise_l_engagement(entity_ref("urn:fr:cc:contrat:i19:clause"), entity_ref("urn:fr:cc:contrat:i19:o")) { origin case_input; }
        assert "f18": inexecution_suffisamment_grave_1224(entity_ref("urn:fr:cc:contrat:i19:o")) { origin adjudicated; }
        assert "f19": mise_en_demeure_infructueuse(entity_ref("urn:fr:cc:contrat:i19:o")) { origin case_input; }
    }
    evaluate truth(resolution_par_clause_acquise(entity_ref("urn:fr:cc:contrat:i19"), entity_ref("urn:fr:cc:contrat:i19:clause")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
