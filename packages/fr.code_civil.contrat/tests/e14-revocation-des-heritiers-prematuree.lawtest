language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1207 al. 1 : mise en demeure d'accepter le 1er mars 2020, délai de trois mois — la révocation du 15 mai 2020 est prématurée.
test "urn:query:fr-code-civil-contrat-e14-revocation-des-heritiers-prematuree" {
    given {
        context { deadline_policy CC_CONTRAT_MOIS; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e14"), @2019-03-01) { origin case_input; }
        assert "f2": stipulation_pour_autrui(entity_ref("urn:fr:cc:contrat:e14:s"), entity_ref("urn:fr:cc:contrat:e14"), entity_ref("urn:fr:cc:contrat:e14:p1"), entity_ref("urn:fr:cc:contrat:e14:p2"), entity_ref("urn:fr:cc:contrat:e14:beneficiaire")) { origin case_input; }
        assert "f3": beneficiaire_precisement_designe_ou_determinable(entity_ref("urn:fr:cc:contrat:e14:s")) { origin case_input; }
        assert "f4": mise_en_demeure_d_accepter_le(entity_ref("urn:fr:cc:contrat:e14:s"), @2020-03-01) { origin case_input; }
        assert "f5": heritier_du_stipulant(entity_ref("urn:fr:cc:contrat:e14:s"), entity_ref("urn:fr:cc:contrat:e14:heritier")) { origin case_input; }
        assert "f6": revocation_par_les_heritiers_le(entity_ref("urn:fr:cc:contrat:e14:s"), @2020-05-15) { origin case_input; }
    }
    evaluate truth(echeance_de_la_mise_en_demeure_d_accepter(entity_ref("urn:fr:cc:contrat:e14:s"), @2020-06-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EcheanceDeLaMiseEnDemeureDAccepter);

    evaluate truth(revocation_des_heritiers_prematuree(entity_ref("urn:fr:cc:contrat:e14:s")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RevocationDesHeritiersPrematuree);
}
