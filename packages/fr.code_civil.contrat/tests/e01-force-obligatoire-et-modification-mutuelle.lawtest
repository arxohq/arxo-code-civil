language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1103 et 1193 : le contrat légalement formé tient lieu de loi aux parties et ne peut être modifié que de leur consentement mutuel.
test "urn:query:fr-code-civil-contrat-e01-force-obligatoire-et-modification-mutuelle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e01"), @2019-03-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:e01"), @2019-03-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:e01"), "1145") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:e01")) { origin case_input; }
        assert "f5": prestation_possible(entity_ref("urn:fr:cc:contrat:e01")) { origin case_input; }
        assert "f6": prestation_determinee(entity_ref("urn:fr:cc:contrat:e01")) { origin case_input; }
        assert "f7": partie_au_contrat(entity_ref("urn:fr:cc:contrat:e01"), entity_ref("urn:fr:cc:contrat:e01:p1")) { origin case_input; }
        assert "f8": personne_physique(entity_ref("urn:fr:cc:contrat:e01:p1")) { origin case_input; }
        assert "f9": consentement_donne_par(entity_ref("urn:fr:cc:contrat:e01"), entity_ref("urn:fr:cc:contrat:e01:p1")) { origin case_input; }
        assert "f10": sain_d_esprit(entity_ref("urn:fr:cc:contrat:e01"), entity_ref("urn:fr:cc:contrat:e01:p1")) { origin case_input; }
        assert "f11": consentement_mutuel_a_la_modification(entity_ref("urn:fr:cc:contrat:e01")) { origin case_input; }
    }
    evaluate truth(force_obligatoire(entity_ref("urn:fr:cc:contrat:e01")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ForceObligatoireDuContrat);

    evaluate truth(contrat_modifiable_ou_revocable(entity_ref("urn:fr:cc:contrat:e01")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ModificationParConsentementMutuel);
}
