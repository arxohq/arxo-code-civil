language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1136 : l'appréciation économique inexacte de la prestation, sans erreur sur ses qualités essentielles, n'est pas une cause de nullité.
test "urn:query:fr-code-civil-contrat-v07-erreur-sur-la-valeur-indifferente" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:v07"), @2019-03-01) { origin case_input; }
        assert "f2": erreur_sur_la_valeur(entity_ref("urn:fr:cc:contrat:v07"), entity_ref("urn:fr:cc:contrat:v07:p1")) { origin case_input; }
    }
    evaluate truth(erreur_indifferente(entity_ref("urn:fr:cc:contrat:v07"), entity_ref("urn:fr:cc:contrat:v07:p1")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ErreurSurLaValeurIndifferente);
}
