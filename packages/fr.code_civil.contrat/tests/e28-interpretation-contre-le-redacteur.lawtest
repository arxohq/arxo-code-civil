language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1190 : dans le doute, le contrat d'adhésion s'interprète contre celui qui l'a proposé.
test "urn:query:fr-code-civil-contrat-e28-interpretation-contre-le-redacteur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:e28"), @2019-04-01) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:e28"), @2019-04-01) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:e28"), "1110") { origin case_input; }
        assert "f4": accord_de_volontes(entity_ref("urn:fr:cc:contrat:e28")) { origin case_input; }
        assert "f5": ensemble_de_clauses_non_negociables_predeterminees(entity_ref("urn:fr:cc:contrat:e28")) { origin case_input; }
        assert "f6": clause_litigieuse(entity_ref("urn:fr:cc:contrat:e28:clause"), entity_ref("urn:fr:cc:contrat:e28")) { origin case_input; }
        assert "f7": clause_du_contrat(entity_ref("urn:fr:cc:contrat:e28:clause"), entity_ref("urn:fr:cc:contrat:e28")) { origin case_input; }
        assert "f8": contrat_propose_par(entity_ref("urn:fr:cc:contrat:e28"), entity_ref("urn:fr:cc:contrat:e28:p1")) { origin case_input; }
        assert "f9": doute_sur_le_sens_de_la_clause(entity_ref("urn:fr:cc:contrat:e28:clause")) { origin adjudicated; }
    }
    evaluate truth(directive_d_interpretation(entity_ref("urn:fr:cc:contrat:e28"), ContreCeluiQuiLAProposee));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DouteContreLeRedacteurDansLAdhesion);
}
