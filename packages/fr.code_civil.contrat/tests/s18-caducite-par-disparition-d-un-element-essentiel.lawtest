language "law.core" version "0.2";
package fr.code_civil.contrat version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrat";

// Art. 1186 al. 1 et 1187 al. 1 : le contrat valablement formé devient caduc si l'un de ses éléments essentiels disparaît, et la caducité met fin au contrat.
test "urn:query:fr-code-civil-contrat-s18-caducite-par-disparition-d-un-element-essentiel" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:contrat:s18"), @2019-03-01) { origin case_input; }
        assert "f2": prestation_possible(entity_ref("urn:fr:cc:contrat:s18")) { origin case_input; }
        assert "f3": prestation_determinee(entity_ref("urn:fr:cc:contrat:s18")) { origin case_input; }
        assert "f4": partie_au_contrat(entity_ref("urn:fr:cc:contrat:s18"), entity_ref("urn:fr:cc:contrat:s18:p1")) { origin case_input; }
        assert "f5": personne_physique(entity_ref("urn:fr:cc:contrat:s18:p1")) { origin case_input; }
        assert "f6": consentement_donne_par(entity_ref("urn:fr:cc:contrat:s18"), entity_ref("urn:fr:cc:contrat:s18:p1")) { origin case_input; }
        assert "f7": sain_d_esprit(entity_ref("urn:fr:cc:contrat:s18"), entity_ref("urn:fr:cc:contrat:s18:p1")) { origin case_input; }
        assert "f8": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:contrat:s18"), @2019-03-01) { origin case_input; }
        assert "f9": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:contrat:s18"), "1145") { origin case_input; }
        assert "f10": element_essentiel_disparu(entity_ref("urn:fr:cc:contrat:s18")) { origin case_input; }
    }
    evaluate truth(contrat_caduc(entity_ref("urn:fr:cc:contrat:s18")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CaduciteParDisparitionDUnElementEssentiel);

    evaluate truth(contrat_prend_fin_par_caducite(entity_ref("urn:fr:cc:contrat:s18")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CaduciteMetFinAuContrat);
}
