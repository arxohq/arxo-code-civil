// CHAPITRE VIII — DONATIONS PAR CONTRAT DE MARIAGE ET ENTRE ÉPOUX (1081 à 1099-1).

language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

use self::{
    CC_ART1081,
    CC_ART1082,
    CC_ART1083,
    CC_ART1084,
    CC_ART1085,
    CC_ART1086,
    CC_ART1087,
    CC_ART1088,
    CC_ART1089,
    CC_ART1090,
    CC_ART1091,
    CC_ART1092,
    CC_ART1093,
    CC_ART1094,
    CC_ART1094_1,
    CC_ART1094_3,
    CC_ART1095,
    CC_ART1096,
    CC_ART1098,
    CC_ART1099,
    CC_ART1099_1,
    Liberalite,
};

pub relation donation_mariage_biens_presents(l: Liberalite) kind empirical { label fr official "une donation de biens présents est faite par contrat de mariage"; label en unofficial "a gift of present property is made by marriage contract"; }
pub relation regles_generales_donation_applicables(l: Liberalite) kind derived { label fr official "règles générales des donations applicables"; label en unofficial "general gift rules apply"; }
pub relation donation_mariage_biens_futurs_tiers(l: Liberalite) kind empirical { label fr official "un tiers donne par contrat de mariage des biens futurs aux époux ou enfants à naître"; label en unofficial "a third party gives future property by marriage contract to spouses or future children"; }
pub relation donation_mariage_biens_futurs_admise(l: Liberalite) kind derived { label fr official "donation matrimoniale de biens futurs admise"; label en unofficial "marital gift of future property permitted"; }
pub relation donateur_dispose_gratuitement_objets_donation_mariage(l: Liberalite) kind empirical { label fr official "le donateur dispose gratuitement des objets compris dans la donation matrimoniale"; label en unofficial "the donor gratuitously disposes of objects included in the marital gift"; }
pub relation disposition_gratuite_interdite_sauf_modique(l: Liberalite) kind derived { label fr official "disposition gratuite interdite sauf somme modique"; label en unofficial "gratuitous disposition prohibited except for a modest amount"; }
pub relation donation_mariage_presents_futurs_etat_dettes_annexe(l: Liberalite) kind empirical { label fr official "la donation matrimoniale de biens présents et futurs annexe l'état des dettes"; label en unofficial "the marital gift of present and future property annexes a statement of debts"; }
pub relation choix_donataire_limite_biens_presents(l: Liberalite) kind derived { label fr official "choix du donataire de s'en tenir aux biens présents"; label en unofficial "donee may elect to retain only present property"; }
pub relation etat_dettes_non_annexe(l: Liberalite) kind empirical { label fr official "l'état des dettes n'est pas annexé à la donation de biens présents et futurs"; label en unofficial "the statement of debts is not annexed to the gift of present and future property"; }
pub relation acceptation_ou_repudiation_pour_tout(l: Liberalite) kind derived { label fr official "acceptation ou répudiation de la donation pour le tout"; label en unofficial "acceptance or disclaimer of the gift as a whole"; }
pub relation conditions_donation_mariage_depend_volonte(l: Liberalite) kind empirical { label fr official "la donation matrimoniale comporte les conditions et charges permises"; label en unofficial "the marital gift includes permitted conditions and charges"; }
pub relation conditions_donation_mariage_a_executer_ou_renoncer(l: Liberalite) kind derived { label fr official "conditions à exécuter sauf renonciation à la donation"; label en unofficial "conditions must be performed unless the gift is disclaimed"; }
pub relation defaut_acceptation_invoque_donation_mariage(l: Liberalite) kind empirical { label fr official "le défaut d'acceptation est invoqué contre une donation matrimoniale"; label en unofficial "lack of acceptance is invoked against a marital gift"; }
pub relation defaut_acceptation_inoperant(l: Liberalite) kind derived { label fr official "défaut d'acceptation inopérant"; label en unofficial "lack of acceptance has no effect"; }
pub relation mariage_ne_suit_pas(l: Liberalite) kind empirical { label fr official "le mariage en faveur duquel la donation est faite ne s'ensuit pas"; label en unofficial "the marriage for which the gift was made does not occur"; }
pub relation donation_mariage_caduque(l: Liberalite) kind derived { label fr official "donation en faveur du mariage caduque"; label en unofficial "gift in contemplation of marriage lapsed"; }
pub relation donateur_survit_epoux_et_posterite(l: Liberalite) kind empirical { label fr official "le donateur survit à l'époux donataire et à sa postérité"; label en unofficial "the donor survives the donee spouse and descendants"; }
pub relation donation_reductible_portion_disponible(l: Liberalite) kind derived { label fr official "donation réductible à la portion disponible"; label en unofficial "gift reducible to the disposable portion"; }
pub relation donation_reciproque_contrat_mariage(l: Liberalite) kind empirical { label fr official "les époux se consentent une donation par contrat de mariage"; label en unofficial "the spouses make a gift to each other by marriage contract"; }
pub relation donation_entre_epoux_admise(l: Liberalite) kind derived { label fr official "donation entre époux admise dans les limites légales"; label en unofficial "interspousal gift permitted within statutory limits"; }
pub relation condition_survie_non_exprimee(l: Liberalite) kind empirical { label fr official "la condition de survie du donataire n'est pas exprimée"; label en unofficial "survival of the donee is not expressed as a condition"; }
pub relation donation_non_conditionnelle_survie(l: Liberalite) kind derived { label fr official "donation non présumée conditionnelle à la survie"; label en unofficial "gift not presumed conditional on survival"; }
pub relation donation_futurs_entre_epoux_mariage(l: Liberalite) kind empirical { label fr official "une donation de biens futurs est faite entre époux par contrat de mariage"; label en unofficial "a gift of future property is made between spouses by marriage contract"; }
pub relation donation_non_transmissible_enfants_predeces(l: Liberalite) kind derived { label fr official "donation non transmissible aux enfants en cas de prédécès du donataire"; label en unofficial "gift not transmissible to children if the donee predeceases"; }
pub relation conjoint_sans_descendant_gratifie(l: Liberalite) kind empirical { label fr official "le conjoint est gratifié en l'absence de descendant"; label en unofficial "the spouse benefits where there is no descendant"; }
pub relation disponible_etranger_au_conjoint(l: Liberalite) kind derived { label fr official "quotité disponible envers un étranger transmissible au conjoint"; label en unofficial "share disposable to a stranger transferable to the spouse"; }
pub relation conjoint_avec_descendants_gratifie(l: Liberalite) kind empirical { label fr official "le conjoint est gratifié en présence de descendants"; label en unofficial "the spouse benefits where descendants exist"; }
pub relation options_quotite_speciale_conjoint(l: Liberalite) kind derived { label fr official "options de quotité spéciale entre époux ouvertes"; label en unofficial "special interspousal disposable-share options available"; }
pub relation descendants_exigent_inventaire_usufruit(l: Liberalite) kind empirical { label fr official "les descendants exigent les garanties d'inventaire liées à l'usufruit"; label en unofficial "descendants require inventory safeguards attached to usufruct"; }
pub relation garanties_usufruit_exigibles(l: Liberalite) kind derived { label fr official "garanties d'inventaire et d'emploi exigibles"; label en unofficial "inventory and investment safeguards enforceable"; }
pub relation mineur_donne_conjoint_avec_consentements(l: Liberalite) kind empirical { label fr official "le mineur donne à son conjoint avec les consentements requis pour le mariage"; label en unofficial "a minor gives to the spouse with consents required for marriage"; }
pub relation donation_mineur_conjoint_admise(l: Liberalite) kind derived { label fr official "donation du mineur au conjoint admise dans les limites du majeur"; label en unofficial "minor's gift to spouse permitted within adult limits"; }
pub relation donation_biens_futurs_pendant_mariage(l: Liberalite) kind empirical { label fr official "une donation de biens futurs est faite entre époux pendant le mariage"; label en unofficial "a gift of future property is made between spouses during marriage"; }
pub relation donation_entre_epoux_revocable(l: Liberalite) kind derived { label fr official "donation entre époux révocable"; label en unofficial "interspousal gift revocable"; }
pub relation enfant_non_commun_substitue_abandon_usufruit(l: Liberalite) kind empirical { label fr official "un enfant non commun substitue l'abandon de son usufruit à la libéralité au conjoint"; label en unofficial "a non-common child substitutes surrender of usufruct for the gift to the spouse"; }
pub relation substitution_abandon_usufruit_admise(l: Liberalite) kind derived { label fr official "substitution par abandon d'usufruit admise"; label en unofficial "substitution by surrender of usufruct permitted"; }
pub relation donation_indirecte_epoux_depasse_limite(l: Liberalite) kind empirical { label fr official "une donation indirecte entre époux dépasse la limite permise"; label en unofficial "an indirect interspousal gift exceeds the permitted limit"; }
pub relation donation_indirecte_excessive_interdite(l: Liberalite) kind derived { label fr official "donation indirecte excessive interdite"; label en unofficial "excessive indirect gift prohibited"; }
pub relation deniers_donnes_pour_acquisition(l: Liberalite) kind empirical { label fr official "un époux donne des deniers à l'autre pour acquérir un bien"; label en unofficial "one spouse gives money to the other to acquire property"; }
pub relation donation_porte_sur_deniers(l: Liberalite) kind derived { label fr official "donation portant sur les deniers et créance de valeur actuelle"; label en unofficial "gift concerns the money with a claim measured by current value"; }

@source(CC_ART1081) rule BiensPresentsReglesGenerales(l: Liberalite) strict { label fr official "Article 1081. La donation matrimoniale de biens présents suit les règles générales"; label en unofficial "Article 1081. A marital gift of present property follows the general rules"; when donation_mariage_biens_presents(l); then regles_generales_donation_applicables(l); }
@source(CC_ART1082) rule BiensFutursParTiers(l: Liberalite) strict { label fr official "Article 1082. Un tiers peut donner par contrat de mariage les biens futurs prévus aux époux et enfants"; label en unofficial "Article 1082. A third party may give specified future property by marriage contract to spouses and children"; when donation_mariage_biens_futurs_tiers(l); then donation_mariage_biens_futurs_admise(l); }
pub relation donner_biens_futurs_mariage_1082(l: Liberalite) kind empirical { label fr official "le tiers donne les biens futurs prévus par le contrat de mariage"; label en unofficial "the third party gives the future property specified in the marriage contract"; }
@source(CC_ART1082)
rule PositionPouvoirDonnerBiensFutursMariage(l: Liberalite) strict {
    label fr official "Article 1082. Le tiers peut donner les biens futurs prévus";
    label en unofficial "Article 1082. A third party may give the specified future property";
    when donation_mariage_biens_futurs_tiers(l) and donner_biens_futurs_mariage_1082(l);
    then liberty PouvoirDonnerBiensFutursMariage {
        holder entity_ref("urn:fr:cc:liberalites:tiers");
        action donner_biens_futurs_mariage_1082(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1083) rule IrrevocabiliteObjets(l: Liberalite) strict { label fr official "Article 1083. Le donateur ne peut plus disposer gratuitement des objets, sauf sommes modiques"; label en unofficial "Article 1083. The donor may no longer dispose gratuitously of the objects except modest amounts"; when donateur_dispose_gratuitement_objets_donation_mariage(l); then disposition_gratuite_interdite_sauf_modique(l); }
pub relation disposer_gratuitement_objets_1083(l: Liberalite) kind empirical {
    label fr official "le donateur dispose gratuitement des objets de la donation matrimoniale";
    label en unofficial "the donor gratuitously disposes of the marital-gift objects";
}
@source(CC_ART1083)
rule PositionInterdictionDisposerObjetsDonationMariage(l: Liberalite) strict {
    label fr official "Article 1083. Le donateur ne peut disposer gratuitement des objets donnés";
    label en unofficial "Article 1083. The donor may not gratuitously dispose of the donated objects";
    when donateur_dispose_gratuitement_objets_donation_mariage(l);
    then prohibition InterdictionDisposerObjetsDonationMariage {
        bearer entity_ref("urn:fr:cc:liberalites:donateur");
        action disposer_gratuitement_objets_1083(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1083)
rule MaintenanceInterdictionDisposerObjetsDonationMariage(l: Liberalite) strict {
    label fr official "Article 1083. Maintenir l'interdiction de disposer gratuitement des objets donnés";
    label en unofficial "Article 1083. Maintain the prohibition on gratuitously disposing of donated objects";
    when donateur_dispose_gratuitement_objets_donation_mariage(l);
    then duty MaintenanceInterdictionDisposerObjetsDonationMariageDuty {
        bearer entity_ref("urn:fr:cc:liberalites:donateur");
        goal maintenance {
            condition not disposer_gratuitement_objets_1083(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART1084) rule EtatDettesAnnexeChoix(l: Liberalite) strict { label fr official "Article 1084. L'état des dettes annexé permet au donataire de s'en tenir aux biens présents"; label en unofficial "Article 1084. An annexed debt statement permits the donee to retain only present property"; when donation_mariage_presents_futurs_etat_dettes_annexe(l); then choix_donataire_limite_biens_presents(l); }
pub relation choisir_biens_presents_1084(l: Liberalite) kind empirical { label fr official "le donataire s'en tient aux biens présents"; label en unofficial "the donee retains only present property"; }
@source(CC_ART1084)
rule PositionPouvoirChoisirBiensPresents(l: Liberalite) strict {
    label fr official "Article 1084. Le donataire peut s'en tenir aux biens présents";
    label en unofficial "Article 1084. The donee may retain only present property";
    when donation_mariage_presents_futurs_etat_dettes_annexe(l) and choisir_biens_presents_1084(l);
    then liberty PouvoirChoisirBiensPresents {
        holder entity_ref("urn:fr:cc:liberalites:donataire");
        action choisir_biens_presents_1084(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1085) rule SansEtatToutOuRien(l: Liberalite) strict { label fr official "Article 1085. Sans état annexé, la donation est acceptée ou répudiée pour le tout"; label en unofficial "Article 1085. Without an annexed statement, the gift is accepted or disclaimed as a whole"; when etat_dettes_non_annexe(l); then acceptation_ou_repudiation_pour_tout(l); }
pub relation accepter_ou_repudier_tout_1085(l: Liberalite) kind empirical { label fr official "le donataire accepte ou répudie la donation pour le tout"; label en unofficial "the donee accepts or disclaims the gift as a whole"; }
@source(CC_ART1085)
rule PositionPouvoirAccepterOuRepudierTout(l: Liberalite) strict {
    label fr official "Article 1085. Le donataire peut accepter ou répudier pour le tout";
    label en unofficial "Article 1085. The donee may accept or disclaim the whole gift";
    when etat_dettes_non_annexe(l) and accepter_ou_repudier_tout_1085(l);
    then liberty PouvoirAccepterOuRepudierTout {
        holder entity_ref("urn:fr:cc:liberalites:donataire");
        action accepter_ou_repudier_tout_1085(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1086) rule ConditionsOuRenonciation(l: Liberalite) strict { label fr official "Article 1086. Le donataire exécute les conditions matrimoniales ou renonce"; label en unofficial "Article 1086. The donee performs marital-gift conditions or disclaims"; when conditions_donation_mariage_depend_volonte(l); then conditions_donation_mariage_a_executer_ou_renoncer(l); }
pub relation executer_conditions_ou_renoncer_1086(l: Liberalite) kind empirical {
    label fr official "le donataire exécute les conditions matrimoniales ou renonce à la donation";
    label en unofficial "the donee performs the marital-gift conditions or disclaims the gift";
}
@source(CC_ART1086)
rule PositionDevoirExecuterConditionsOuRenoncer(l: Liberalite) strict {
    label fr official "Article 1086. Le donataire doit exécuter les conditions ou renoncer";
    label en unofficial "Article 1086. The donee must perform the conditions or disclaim";
    when conditions_donation_mariage_depend_volonte(l);
    then duty DevoirExecuterConditionsOuRenoncer {
        bearer entity_ref("urn:fr:cc:liberalites:donataire");
        goal achievement {
            condition executer_conditions_ou_renoncer_1086(l);
            window [@2005-01-01, infinity);
        };
    };
}
@source(CC_ART1087) rule AcceptationNonRequise(l: Liberalite) strict { label fr official "Article 1087. La donation matrimoniale ne peut être annulée pour défaut d'acceptation"; label en unofficial "Article 1087. A marital gift may not be annulled for lack of acceptance"; when defaut_acceptation_invoque_donation_mariage(l); then defaut_acceptation_inoperant(l); }
pub relation opposer_defaut_acceptation_1087(l: Liberalite) kind empirical { label fr official "une partie oppose le défaut d'acceptation"; label en unofficial "a party invokes lack of acceptance"; }
@source(CC_ART1087)
rule PositionInterdictionAnnulerDefautAcceptation(l: Liberalite) strict {
    label fr official "Article 1087. La donation matrimoniale ne peut être annulée pour défaut d'acceptation";
    label en unofficial "Article 1087. A marital gift may not be annulled for lack of acceptance";
    when defaut_acceptation_invoque_donation_mariage(l);
    then prohibition InterdictionAnnulerDefautAcceptation {
        bearer entity_ref("urn:fr:cc:liberalites:partie");
        action opposer_defaut_acceptation_1087(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1087)
rule MaintenanceInterdictionAnnulerDefautAcceptation(l: Liberalite) strict {
    label fr official "Article 1087. Maintenir l'interdiction d'annuler pour défaut d'acceptation";
    label en unofficial "Article 1087. Maintain the prohibition on annulment for lack of acceptance";
    when defaut_acceptation_invoque_donation_mariage(l);
    then duty MaintenanceInterdictionAnnulerDefautAcceptationDuty {
        bearer entity_ref("urn:fr:cc:liberalites:partie");
        goal maintenance {
            condition not opposer_defaut_acceptation_1087(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART1088) rule MariageNonSuiviCaducite(l: Liberalite) strict { label fr official "Article 1088. La donation en faveur du mariage est caduque si le mariage ne s'ensuit pas"; label en unofficial "Article 1088. A gift in contemplation of marriage lapses if the marriage does not occur"; when mariage_ne_suit_pas(l); then donation_mariage_caduque(l); }
@source(CC_ART1089) rule SurvieDonateurCaducite(l: Liberalite) strict { label fr official "Article 1089. La donation devient caduque si le donateur survit au donataire et à sa postérité"; label en unofficial "Article 1089. The gift lapses if the donor survives the donee and descendants"; when donateur_survit_epoux_et_posterite(l); then donation_mariage_caduque(l); }
@source(CC_ART1090) rule ReductionDonationContratMariage(l: Liberalite) strict { label fr official "Article 1090. La donation par contrat de mariage est réductible à la portion disponible"; label en unofficial "Article 1090. A marriage-contract gift is reducible to the disposable portion"; when donation_mariage_biens_presents(l); then donation_reductible_portion_disponible(l); }
@source(CC_ART1091) rule DonationsReciproquesEpoux(l: Liberalite) strict { label fr official "Article 1091. Les époux peuvent se donner par contrat de mariage sous les limites suivantes"; label en unofficial "Article 1091. Spouses may make marriage-contract gifts to each other subject to following limits"; when donation_reciproque_contrat_mariage(l); then donation_entre_epoux_admise(l); }
pub relation consentir_donation_reciproque_1091(l: Liberalite) kind empirical { label fr official "les époux consentent une donation réciproque"; label en unofficial "the spouses consent to a reciprocal gift"; }
@source(CC_ART1091)
rule PositionPouvoirConsentirDonationReciproque(l: Liberalite) strict {
    label fr official "Article 1091. Les époux peuvent consentir une donation réciproque";
    label en unofficial "Article 1091. Spouses may make a reciprocal gift";
    when donation_reciproque_contrat_mariage(l) and consentir_donation_reciproque_1091(l);
    then liberty PouvoirConsentirDonationReciproque {
        holder entity_ref("urn:fr:cc:liberalites:epoux");
        action consentir_donation_reciproque_1091(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1092) rule PasConditionSurviePresumee(l: Liberalite) strict { label fr official "Article 1092. La donation de biens présents n'est pas présumée sous condition de survie"; label en unofficial "Article 1092. A gift of present property is not presumed conditional on survival"; when condition_survie_non_exprimee(l); then donation_non_conditionnelle_survie(l); }
@source(CC_ART1093) rule BiensFutursNonTransmissibles(l: Liberalite) strict { label fr official "Article 1093. La donation de biens futurs n'est pas transmise aux enfants si le donataire prédécède"; label en unofficial "Article 1093. A gift of future property does not pass to children if the donee predeceases"; when donation_futurs_entre_epoux_mariage(l); then donation_non_transmissible_enfants_predeces(l); }
@source(CC_ART1094) rule ConjointSansDescendant(l: Liberalite) strict { label fr official "Article 1094. Sans descendant, le conjoint peut recevoir ce qui serait disponible envers un étranger"; label en unofficial "Article 1094. Without descendants, the spouse may receive what would be disposable to a stranger"; when conjoint_sans_descendant_gratifie(l); then disponible_etranger_au_conjoint(l); }
pub relation recevoir_disponible_conjoint_1094(l: Liberalite) kind empirical { label fr official "le conjoint reçoit la quotité disponible envers un étranger"; label en unofficial "the spouse receives the share disposable to a stranger"; }
@source(CC_ART1094)
rule PositionPouvoirRecevoirDisponibleConjoint(l: Liberalite) strict {
    label fr official "Article 1094. Le conjoint peut recevoir la quotité disponible";
    label en unofficial "Article 1094. The spouse may receive the disposable share";
    when conjoint_sans_descendant_gratifie(l) and recevoir_disponible_conjoint_1094(l);
    then liberty PouvoirRecevoirDisponibleConjoint {
        holder entity_ref("urn:fr:cc:liberalites:conjoint");
        action recevoir_disponible_conjoint_1094(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1094_1) rule OptionsConjointAvecDescendants(l: Liberalite) strict { label fr official "Article 1094-1. Avec descendants, le conjoint dispose des options spéciales de propriété et d'usufruit"; label en unofficial "Article 1094-1. With descendants, the spouse has special ownership and usufruct options"; when conjoint_avec_descendants_gratifie(l); then options_quotite_speciale_conjoint(l); }
pub relation choisir_option_conjoint_1094_1(l: Liberalite) kind empirical { label fr official "le conjoint choisit une option spéciale de propriété ou d'usufruit"; label en unofficial "the spouse chooses a special ownership or usufruct option"; }
@source(CC_ART1094_1)
rule PositionPouvoirChoisirOptionConjoint(l: Liberalite) strict {
    label fr official "Article 1094-1. Le conjoint peut choisir une option spéciale";
    label en unofficial "Article 1094-1. The spouse may choose a special option";
    when conjoint_avec_descendants_gratifie(l) and choisir_option_conjoint_1094_1(l);
    then liberty PouvoirChoisirOptionConjoint {
        holder entity_ref("urn:fr:cc:liberalites:conjoint");
        action choisir_option_conjoint_1094_1(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1094_3) rule GarantiesUsufruitDescendants(l: Liberalite) strict { label fr official "Article 1094-3. Les descendants peuvent exiger inventaire, état, emploi ou dépôt pour l'usufruit"; label en unofficial "Article 1094-3. Descendants may require inventory, statement, investment or deposit safeguards for usufruct"; when descendants_exigent_inventaire_usufruit(l); then garanties_usufruit_exigibles(l); }
pub relation exiger_garanties_usufruit_1094_3(l: Liberalite) kind empirical {
    label fr official "les descendants exigent les garanties de l'usufruit";
    label en unofficial "the descendants require usufruct safeguards";
}
@source(CC_ART1094_3)
rule PositionPouvoirExigerGarantiesUsufruit(l: Liberalite) strict {
    label fr official "Article 1094-3. Les descendants peuvent exiger les garanties de l'usufruit";
    label en unofficial "Article 1094-3. Descendants may require usufruct safeguards";
    when descendants_exigent_inventaire_usufruit(l)
        and exiger_garanties_usufruit_1094_3(l);
    then liberty PouvoirExigerGarantiesUsufruit {
        holder entity_ref("urn:fr:cc:liberalites:descendants");
        action exiger_garanties_usufruit_1094_3(l);
        window [@2005-01-01, infinity);
    };
}
@source(CC_ART1095) rule DonationMineurConjoint(l: Liberalite) strict { label fr official "Article 1095. Le mineur peut donner au conjoint avec les consentements requis"; label en unofficial "Article 1095. A minor may give to the spouse with required consents"; when mineur_donne_conjoint_avec_consentements(l); then donation_mineur_conjoint_admise(l); }
pub relation donner_mineur_au_conjoint_1095(l: Liberalite) kind empirical { label fr official "le mineur donne au conjoint avec les consentements requis"; label en unofficial "the minor gives to the spouse with the required consents"; }
@source(CC_ART1095)
rule PositionPouvoirDonnerMineurAuConjoint(l: Liberalite) strict {
    label fr official "Article 1095. Le mineur peut donner au conjoint";
    label en unofficial "Article 1095. A minor may give to the spouse";
    when mineur_donne_conjoint_avec_consentements(l) and donner_mineur_au_conjoint_1095(l);
    then liberty PouvoirDonnerMineurAuConjoint {
        holder entity_ref("urn:fr:cc:liberalites:mineur");
        action donner_mineur_au_conjoint_1095(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1096) rule RevocabiliteBiensFutursEpoux(l: Liberalite) strict { label fr official "Article 1096. La donation de biens futurs entre époux pendant le mariage est toujours révocable"; label en unofficial "Article 1096. A gift of future property between spouses during marriage is always revocable"; when donation_biens_futurs_pendant_mariage(l); then donation_entre_epoux_revocable(l); }
pub relation revoquer_donation_futurs_1096(l: Liberalite) kind empirical { label fr official "un époux révoque la donation de biens futurs pendant le mariage"; label en unofficial "a spouse revokes the gift of future property during marriage"; }
@source(CC_ART1096)
rule PositionPouvoirRevoquerDonationFuturs(l: Liberalite) strict {
    label fr official "Article 1096. L'époux peut révoquer la donation de biens futurs";
    label en unofficial "Article 1096. The spouse may revoke the gift of future property";
    when donation_biens_futurs_pendant_mariage(l) and revoquer_donation_futurs_1096(l);
    then liberty PouvoirRevoquerDonationFuturs {
        holder entity_ref("urn:fr:cc:liberalites:epoux-donateur");
        action revoquer_donation_futurs_1096(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1098) rule SubstitutionUsufruitEnfantNonCommun(l: Liberalite) strict { label fr official "Article 1098. L'enfant non commun peut substituer l'abandon de son usufruit à la libéralité au conjoint"; label en unofficial "Article 1098. A non-common child may substitute surrender of usufruct for the gift to the spouse"; when enfant_non_commun_substitue_abandon_usufruit(l); then substitution_abandon_usufruit_admise(l); }
pub relation substituer_abandon_usufruit_1098(l: Liberalite) kind empirical { label fr official "l'enfant non commun substitue l'abandon de son usufruit à la libéralité"; label en unofficial "the non-common child substitutes surrender of usufruct for the gift"; }
@source(CC_ART1098)
rule PositionPouvoirSubstituerAbandonUsufruit(l: Liberalite) strict {
    label fr official "Article 1098. L'enfant non commun peut substituer l'abandon de son usufruit";
    label en unofficial "Article 1098. The non-common child may substitute surrender of usufruct";
    when enfant_non_commun_substitue_abandon_usufruit(l) and substituer_abandon_usufruit_1098(l);
    then liberty PouvoirSubstituerAbandonUsufruit {
        holder entity_ref("urn:fr:cc:liberalites:enfant-non-commun");
        action substituer_abandon_usufruit_1098(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1099) rule LimiteDonationIndirecte(l: Liberalite) strict { label fr official "Article 1099. Les donations indirectes entre époux ne peuvent dépasser les limites légales"; label en unofficial "Article 1099. Indirect gifts between spouses may not exceed statutory limits"; when donation_indirecte_epoux_depasse_limite(l); then donation_indirecte_excessive_interdite(l); }
pub relation consentir_donation_indirecte_excessive_1099(l: Liberalite) kind empirical {
    label fr official "un époux consent une donation indirecte dépassant les limites légales";
    label en unofficial "a spouse makes an indirect gift exceeding statutory limits";
}
@source(CC_ART1099)
rule PositionInterdictionDonationIndirecteExcessive(l: Liberalite) strict {
    label fr official "Article 1099. Les époux ne peuvent consentir une donation indirecte au-delà des limites légales";
    label en unofficial "Article 1099. Spouses may not make an indirect gift beyond statutory limits";
    when donation_indirecte_epoux_depasse_limite(l);
    then prohibition InterdictionDonationIndirecteExcessive {
        bearer entity_ref("urn:fr:cc:liberalites:epoux-donateur");
        action consentir_donation_indirecte_excessive_1099(l);
        window [@2005-01-01, infinity);
    };
}
@source(CC_ART1099)
rule MaintenanceInterdictionDonationIndirecteExcessive(l: Liberalite) strict {
    label fr official "Article 1099. Maintenir l'interdiction de dépasser les limites des donations indirectes";
    label en unofficial "Article 1099. Maintain the prohibition on exceeding indirect-gift limits";
    when donation_indirecte_epoux_depasse_limite(l);
    then duty MaintenanceInterdictionDonationIndirecteExcessiveDuty {
        bearer entity_ref("urn:fr:cc:liberalites:epoux-donateur");
        goal maintenance {
            condition not consentir_donation_indirecte_excessive_1099(l);
            window [@2005-01-01, infinity);
        };
    };
}
@source(CC_ART1099_1) rule DonationDeniersPourAcquisition(l: Liberalite) strict { label fr official "Article 1099-1. La donation porte sur les deniers et la restitution suit la valeur actuelle du bien"; label en unofficial "Article 1099-1. The gift concerns the money and restitution follows the property's current value"; when deniers_donnes_pour_acquisition(l); then donation_porte_sur_deniers(l); }
