// CHAPITRE VII — LIBÉRALITÉS-PARTAGES (1075 à 1080).

language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

use self::{
    CC_ART1075,
    CC_ART1075_1,
    CC_ART1075_2,
    CC_ART1075_3,
    CC_ART1075_4,
    CC_ART1075_5,
    CC_ART1076,
    CC_ART1076_1,
    CC_ART1077,
    CC_ART1077_1,
    CC_ART1077_2,
    CC_ART1078,
    CC_ART1078_1,
    CC_ART1078_10,
    CC_ART1078_2,
    CC_ART1078_3,
    CC_ART1078_4,
    CC_ART1078_5,
    CC_ART1078_6,
    CC_ART1078_7,
    CC_ART1078_8,
    CC_ART1078_9,
    CC_ART1079,
    CC_ART1080,
    Liberalite,
};

pub relation partage_anticipe_entre_successibles(l: Liberalite) kind empirical { label fr official "le disposant répartit par avance ses biens entre successibles"; label en unofficial "the donor distributes property in advance among successors"; }
pub relation liberalite_partage_valable(l: Liberalite) kind derived { label fr official "libéralité-partage valable quant à la règle contrôlée"; label en unofficial "partition gift valid under the checked rule"; }
pub relation descendants_degres_differents_allotis(l: Liberalite) kind empirical { label fr official "des descendants de degrés différents sont allotis"; label en unofficial "descendants of different degrees receive allotments"; }
pub relation entreprise_ou_droits_sociaux_partages_avec_tiers(l: Liberalite) kind empirical { label fr official "une entreprise ou des droits sociaux sont partagés avec les donataires et d'autres personnes"; label en unofficial "a business or company interests are partitioned among donees and other persons"; }
pub relation action_complement_lesion_contre_partage(l: Liberalite) kind empirical { label fr official "une action en complément pour lésion vise une libéralité-partage"; label en unofficial "an action to supplement for lesion targets a partition gift"; }
pub relation action_lesion_irrecevable(l: Liberalite) kind derived { label fr official "action en complément pour lésion irrecevable"; label en unofficial "action to supplement for lesion unavailable"; }
pub relation soulte_charge_donataire(l: Liberalite) kind empirical { label fr official "une soulte est mise à la charge d'un donataire"; label en unofficial "an equalization payment is imposed on a donee"; }
pub relation regle_article_828_applicable(l: Liberalite) kind derived { label fr official "règle de l'article 828 applicable à la soulte"; label en unofficial "Article 828 rule applies to the equalization payment"; }
pub relation biens_omis_du_partage_au_deces(l: Liberalite) kind empirical { label fr official "des biens laissés au décès ont été omis du partage"; label en unofficial "property left at death was omitted from the partition"; }
pub relation biens_omis_partages_selon_loi(l: Liberalite) kind derived { label fr official "biens omis attribués ou partagés selon la loi"; label en unofficial "omitted property allocated or partitioned by law"; }
pub relation donation_partage_biens_presents(l: Liberalite) kind empirical { label fr official "la donation-partage porte seulement sur des biens présents"; label en unofficial "the partition gift concerns present property only"; }
pub relation donation_partage_conjointe_enfant_non_commun(l: Liberalite) kind empirical { label fr official "une donation-partage conjointe allotit un enfant non commun du chef de son auteur"; label en unofficial "a joint partition gift allots a non-common child through that child's parent"; }
pub relation allotissement_enfant_non_commun_admis(l: Liberalite) kind derived { label fr official "allotissement de l'enfant non commun admis dans les limites légales"; label en unofficial "allotment to the non-common child permitted within statutory limits"; }
pub relation bien_recu_partage_anticipe(l: Liberalite) kind empirical { label fr official "un héritier réservataire présomptif reçoit un bien par partage anticipé"; label en unofficial "a presumptive forced heir receives property by advance partition"; }
pub relation imputation_sur_reserve(l: Liberalite) kind derived { label fr official "imputation sur la part de réserve sauf stipulation hors part"; label en unofficial "charged to the forced share absent an express extra-share term"; }
pub relation heritier_non_concourant_ou_lot_insuffisant(l: Liberalite) kind empirical { label fr official "un réservataire n'a pas concouru ou a reçu un lot inférieur à sa réserve"; label en unofficial "a forced heir did not participate or received less than the forced share"; }
pub relation biens_libres_insuffisants_completer_reserve(l: Liberalite) kind empirical { label fr official "les biens hors partage sont insuffisants pour compléter la réserve"; label en unofficial "property outside the partition is insufficient to complete the forced share"; }
pub relation action_reduction_partage_ouverte(l: Liberalite) kind derived { label fr official "action en réduction de la donation-partage ouverte"; label en unofficial "action to reduce the partition gift available"; }
pub relation deces_disposant_partage_le(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date du décès ouvrant l'action contre le partage"; label en unofficial "date of death opening the action against the partition"; }
pub relation action_reduction_partage_le(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date de l'action en réduction de la donation-partage"; label en unofficial "date of the action to reduce the partition gift"; }
pub relation action_reduction_partage_dans_cinq_ans(l: Liberalite) kind derived { label fr official "action en réduction exercée dans les cinq ans"; label en unofficial "reduction action exercised within five years"; }
pub relation tous_reservataires_allotis_acceptent_sans_usufruit_argent(l: Liberalite) kind empirical { label fr official "tous les réservataires sont allotis et acceptent sans réserve d'usufruit sur une somme"; label en unofficial "all forced heirs receive and accept allotments without reserved usufruct over money"; }
pub relation evaluation_au_jour_donation_partage(l: Liberalite) kind derived { label fr official "évaluation au jour de la donation-partage"; label en unofficial "valuation at the date of the partition gift"; }
pub relation donation_anterieure_incorporee_partage(l: Liberalite) kind empirical { label fr official "une donation antérieure est incorporée au partage"; label en unofficial "an earlier gift is incorporated into the partition"; }
pub relation meme_date_evaluation_incorporation(l: Liberalite) kind derived { label fr official "même date d'évaluation pour la donation incorporée"; label en unofficial "same valuation date for the incorporated gift"; }
pub relation donation_hors_part_incorporee_reserve(l: Liberalite) kind empirical { label fr official "les parties incorporent une donation hors part et l'imputent sur la réserve"; label en unofficial "the parties incorporate an extra-share gift and charge it to the forced share"; }
pub relation incorporation_conventionnelle_valable(l: Liberalite) kind derived { label fr official "incorporation conventionnelle valable"; label en unofficial "contractual incorporation valid"; }
pub relation convention_incorporation_sans_nouvelle_donation(l: Liberalite) kind empirical { label fr official "la convention d'incorporation est conclue sans nouvelle donation"; label en unofficial "the incorporation agreement is made without a new gift"; }
pub relation convention_est_partage_non_liberalite(l: Liberalite) kind derived { label fr official "convention qualifiée de partage et non de libéralité entre héritiers"; label en unofficial "agreement treated as partition rather than gift among heirs"; }
pub relation enfant_consente_descendants_allotis_place(l: Liberalite) kind empirical { label fr official "un enfant consent à l'allotissement de ses descendants à sa place"; label en unofficial "a child consents to descendants receiving allotments in that child's place"; }
pub relation allotissement_transgenerationnel_admis(l: Liberalite) kind derived { label fr official "allotissement transgénérationnel admis"; label en unofficial "transgenerational allotment permitted"; }
pub relation consentements_acte_non_vicies(l: Liberalite) kind empirical { label fr official "le renonçant et ses descendants consentent dans l'acte sans vice"; label en unofficial "the relinquishing child and descendants consent in the instrument without defect"; }
pub relation partage_par_souche(l: Liberalite) kind derived { label fr official "partage par souche"; label en unofficial "partition by branch"; }
pub relation conventions_incorporation_transgenerationnelles(l: Liberalite) kind empirical { label fr official "le partage transgénérationnel comporte des conventions d'incorporation"; label en unofficial "the transgenerational partition includes incorporation agreements"; }
pub relation conventions_transgenerationnelles_admises(l: Liberalite) kind derived { label fr official "conventions d'incorporation transgénérationnelles admises"; label en unofficial "transgenerational incorporation agreements permitted"; }
pub relation biens_recus_meme_souche(l: Liberalite) kind empirical { label fr official "des membres d'une même souche ont reçu des biens par partage anticipé"; label en unofficial "members of the same branch received property by advance partition"; }
pub relation imputation_globale_par_souche(l: Liberalite) kind derived { label fr official "imputation globale sur la réserve de la souche puis la quotité disponible"; label en unofficial "aggregate charge to the branch's forced share then disposable share"; }
pub relation succession_enfant_ayant_consenti(l: Liberalite) kind empirical { label fr official "la succession de l'enfant ayant consenti à l'allotissement s'ouvre"; label en unofficial "the estate of the child who consented to the allotment opens"; }
pub relation biens_traites_tenus_auteur_direct(l: Liberalite) kind derived { label fr official "biens traités comme tenus de l'auteur direct"; label en unofficial "property treated as derived from the direct parent"; }
pub relation nouvelle_donation_partage_incorpore_biens(l: Liberalite) kind empirical { label fr official "une nouvelle donation-partage incorpore les biens antérieurement reçus"; label en unofficial "a new partition gift incorporates previously received property"; }
pub relation regle_succession_enfant_ecartee(l: Liberalite) kind derived { label fr official "règle de traitement dans la succession de l'enfant écartée"; label en unofficial "rule for treatment in the child's estate displaced"; }
pub relation testament_partage_invoque(l: Liberalite) kind empirical { label fr official "un bénéficiaire invoque un testament-partage"; label en unofficial "a beneficiary invokes a testamentary partition"; }
pub relation nouveau_partage_interdit(l: Liberalite) kind derived { label fr official "renonciation au testament pour réclamer un nouveau partage interdite"; label en unofficial "disclaiming the will to seek a new partition prohibited"; }
pub relation lot_testament_partage_inferieur_reserve(l: Liberalite) kind empirical { label fr official "le lot du testament-partage est inférieur à la réserve"; label en unofficial "the testamentary-partition allotment is below the forced share"; }

@source(CC_ART1075) rule FormesLiberalitePartage(l: Liberalite) strict { label fr official "Article 1075. Le partage anticipé suit les formes de la donation-partage ou du testament-partage"; label en unofficial "Article 1075. Advance partition follows the forms for partition gifts or testamentary partitions"; when partage_anticipe_entre_successibles(l); then liberalite_partage_valable(l); }
@source(CC_ART1075_1) rule DescendantsDegresDifferents(l: Liberalite) strict { label fr official "Article 1075-1. Des descendants de degrés différents peuvent être allotis"; label en unofficial "Article 1075-1. Descendants of different degrees may receive allotments"; when descendants_degres_differents_allotis(l); then liberalite_partage_valable(l); }
@source(CC_ART1075_2) rule EntrepriseAvecAutresPersonnes(l: Liberalite) strict { label fr official "Article 1075-2. L'entreprise peut être répartie avec les donataires et d'autres personnes sous les conditions légales"; label en unofficial "Article 1075-2. A business may be partitioned among donees and other persons under statutory conditions"; when entreprise_ou_droits_sociaux_partages_avec_tiers(l); then liberalite_partage_valable(l); }
pub relation partager_entreprise_tiers_1075_2(l: Liberalite) kind empirical { label fr official "les parties partagent l'entreprise avec les donataires et des tiers"; label en unofficial "the parties partition the business with donees and third parties"; }
@source(CC_ART1075_2)
rule PositionPouvoirPartagerEntrepriseTiers(l: Liberalite) strict {
    label fr official "Article 1075-2. Les parties peuvent partager l'entreprise avec des tiers";
    label en unofficial "Article 1075-2. The parties may partition the business with third parties";
    when entreprise_ou_droits_sociaux_partages_avec_tiers(l) and partager_entreprise_tiers_1075_2(l);
    then liberty PouvoirPartagerEntrepriseTiers {
        holder entity_ref("urn:fr:cc:liberalites:parties-au-partage");
        action partager_entreprise_tiers_1075_2(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1075_3) rule PasActionLesion(l: Liberalite) strict { label fr official "Article 1075-3. L'action en complément pour lésion n'est pas ouverte contre les libéralités-partages"; label en unofficial "Article 1075-3. An action to supplement for lesion is unavailable against partition gifts"; when action_complement_lesion_contre_partage(l); then action_lesion_irrecevable(l); }
pub relation agir_en_complement_lesion_1075_3(l: Liberalite) kind empirical {
    label fr official "le bénéficiaire agit en complément pour lésion contre une libéralité-partage";
    label en unofficial "the beneficiary brings a lesion-complement action against a partition gift";
}
@source(CC_ART1075_3)
rule PositionInterdictionAgirComplementLesion(l: Liberalite) strict {
    label fr official "Article 1075-3. Le bénéficiaire ne peut agir en complément pour lésion";
    label en unofficial "Article 1075-3. The beneficiary may not bring a lesion-complement action";
    when action_complement_lesion_contre_partage(l);
    then prohibition InterdictionAgirComplementLesion {
        bearer entity_ref("urn:fr:cc:liberalites:beneficiaire");
        action agir_en_complement_lesion_1075_3(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1075_3)
rule MaintenanceInterdictionAgirComplementLesion(l: Liberalite) strict {
    label fr official "Article 1075-3. Maintenir l'interdiction d'agir en complément pour lésion";
    label en unofficial "Article 1075-3. Maintain the prohibition on bringing a lesion-complement action";
    when action_complement_lesion_contre_partage(l);
    then duty MaintenanceInterdictionAgirComplementLesionDuty {
        bearer entity_ref("urn:fr:cc:liberalites:beneficiaire");
        goal maintenance {
            condition not agir_en_complement_lesion_1075_3(l);
            window [@2007-01-01, infinity);
        };
    };
}
@source(CC_ART1075_4) rule SoulteArticle828(l: Liberalite) strict { label fr official "Article 1075-4. L'article 828 s'applique aux soultes malgré convention contraire"; label en unofficial "Article 1075-4. Article 828 applies to equalization payments despite contrary agreement"; when soulte_charge_donataire(l); then regle_article_828_applicable(l); }
@source(CC_ART1075_5) rule BiensOmisSelonLoi(l: Liberalite) strict { label fr official "Article 1075-5. Les biens omis sont attribués ou partagés selon la loi"; label en unofficial "Article 1075-5. Omitted property is allocated or partitioned by law"; when biens_omis_du_partage_au_deces(l); then biens_omis_partages_selon_loi(l); }
@source(CC_ART1076) rule BiensPresentsSeulement(l: Liberalite) strict { label fr official "Article 1076. La donation-partage porte sur des biens présents"; label en unofficial "Article 1076. A partition gift concerns present property"; when donation_partage_biens_presents(l); then liberalite_partage_valable(l); }
@source(CC_ART1076_1) rule EnfantNonCommun(l: Liberalite) strict { label fr official "Article 1076-1. L'enfant non commun peut être alloti du chef de son auteur dans les limites prévues"; label en unofficial "Article 1076-1. A non-common child may receive an allotment through that child's parent within prescribed limits"; when donation_partage_conjointe_enfant_non_commun(l); then allotissement_enfant_non_commun_admis(l); }
pub relation recevoir_allotissement_enfant_non_commun_1076_1(l: Liberalite) kind empirical {
    label fr official "l'enfant non commun reçoit un allotissement du chef de son auteur";
    label en unofficial "the non-common child receives an allotment through that child's parent";
}
@source(CC_ART1076_1)
rule PositionPouvoirRecevoirAllotissementEnfantNonCommun(l: Liberalite) strict {
    label fr official "Article 1076-1. L'enfant non commun peut être alloti du chef de son auteur";
    label en unofficial "Article 1076-1. The non-common child may receive an allotment through the parent";
    when donation_partage_conjointe_enfant_non_commun(l)
        and recevoir_allotissement_enfant_non_commun_1076_1(l);
    then liberty PouvoirRecevoirAllotissementEnfantNonCommun {
        holder entity_ref("urn:fr:cc:liberalites:enfant-non-commun");
        action recevoir_allotissement_enfant_non_commun_1076_1(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1077) rule ImputationPartageAnticipe(l: Liberalite) strict { label fr official "Article 1077. Le bien reçu s'impute sur la réserve sauf donation expressément hors part"; label en unofficial "Article 1077. Property received is charged to the forced share absent an express extra-share gift"; when bien_recu_partage_anticipe(l); then imputation_sur_reserve(l); }
@source(CC_ART1077_1) rule ReductionLotInsuffisant(l: Liberalite) strict { label fr official "Article 1077-1. Le réservataire absent ou insuffisamment alloti peut agir si les biens libres ne complètent pas sa réserve"; label en unofficial "Article 1077-1. An absent or under-allotted forced heir may act if free property cannot complete the forced share"; when heritier_non_concourant_ou_lot_insuffisant(l) and biens_libres_insuffisants_completer_reserve(l); then action_reduction_partage_ouverte(l); }
pub relation exercer_action_reduction_partage_1077_1(l: Liberalite) kind empirical {
    label fr official "le réservataire exerce l'action en réduction du partage";
    label en unofficial "the forced heir exercises the partition-reduction action";
}
@source(CC_ART1077_1)
rule PositionPouvoirExercerActionReductionPartage(l: Liberalite) strict {
    label fr official "Article 1077-1. Le réservataire peut exercer l'action en réduction";
    label en unofficial "Article 1077-1. The forced heir may exercise the reduction action";
    when heritier_non_concourant_ou_lot_insuffisant(l)
        and biens_libres_insuffisants_completer_reserve(l)
        and exercer_action_reduction_partage_1077_1(l);
    then liberty PouvoirExercerActionReductionPartage {
        holder entity_ref("urn:fr:cc:liberalites:heritier-reservataire");
        action exercer_action_reduction_partage_1077_1(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1077_2) rule ReductionPartageCinqAns(l: Liberalite, deces: Date, saisine: Date) strict { label fr official "Article 1077-2. L'action en réduction du partage se prescrit par cinq ans à compter du décès pertinent"; label en unofficial "Article 1077-2. The action to reduce a partition is time-barred five years after the relevant death"; when deces_disposant_partage_le(l, deces) and action_reduction_partage_le(l, saisine) and saisine <= add_calendar_period(deces, 5 calendar_year); then action_reduction_partage_dans_cinq_ans(l); }
@source(CC_ART1078) rule EvaluationJourPartage(l: Liberalite) strict { label fr official "Article 1078. Sous les conditions légales, les biens sont évalués au jour de la donation-partage"; label en unofficial "Article 1078. Under statutory conditions, property is valued at the date of the partition gift"; when tous_reservataires_allotis_acceptent_sans_usufruit_argent(l); then evaluation_au_jour_donation_partage(l); }
@source(CC_ART1078_1) rule DonationAnterieureMemeDate(l: Liberalite) strict { label fr official "Article 1078-1. La donation antérieure incorporée suit la date d'évaluation du partage"; label en unofficial "Article 1078-1. An incorporated earlier gift follows the partition's valuation date"; when donation_anterieure_incorporee_partage(l); then meme_date_evaluation_incorporation(l); }
@source(CC_ART1078_2) rule IncorporationHorsPart(l: Liberalite) strict { label fr official "Article 1078-2. Les parties peuvent incorporer une donation hors part et l'imputer sur la réserve"; label en unofficial "Article 1078-2. The parties may incorporate an extra-share gift and charge it to the forced share"; when donation_hors_part_incorporee_reserve(l); then incorporation_conventionnelle_valable(l); }
@source(CC_ART1078_3) rule IncorporationSansNouvelleDonation(l: Liberalite) strict { label fr official "Article 1078-3. L'incorporation sans nouvelle donation est un partage, non une libéralité entre héritiers"; label en unofficial "Article 1078-3. Incorporation without a new gift is a partition, not a gift among heirs"; when convention_incorporation_sans_nouvelle_donation(l); then convention_est_partage_non_liberalite(l); }
@source(CC_ART1078_4) rule AllotissementDescendantsPlaceEnfant(l: Liberalite) strict { label fr official "Article 1078-4. Un enfant peut consentir à l'allotissement de ses descendants à sa place"; label en unofficial "Article 1078-4. A child may consent to descendants receiving allotments in that child's place"; when enfant_consente_descendants_allotis_place(l); then allotissement_transgenerationnel_admis(l); }
pub relation consentir_allotissement_descendants_1078_4(l: Liberalite) kind empirical {
    label fr official "l'enfant consent à l'allotissement de ses descendants à sa place";
    label en unofficial "the child consents to descendants receiving an allotment in the child's place";
}
@source(CC_ART1078_4)
rule PositionPouvoirConsentirAllotissementDescendants(l: Liberalite) strict {
    label fr official "Article 1078-4. L'enfant peut consentir à l'allotissement de ses descendants";
    label en unofficial "Article 1078-4. The child may consent to descendants receiving an allotment";
    when enfant_consente_descendants_allotis_place(l)
        and consentir_allotissement_descendants_1078_4(l);
    then liberty PouvoirConsentirAllotissementDescendants {
        holder entity_ref("urn:fr:cc:liberalites:enfant");
        action consentir_allotissement_descendants_1078_4(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1078_5) rule ConsentementsTransgenerationnels(l: Liberalite) strict { label fr official "Article 1078-5. La donation-partage transgénérationnelle requiert les consentements non viciés dans l'acte"; label en unofficial "Article 1078-5. A transgenerational partition gift requires untainted consents in the instrument"; when consentements_acte_non_vicies(l); then liberalite_partage_valable(l); }
pub relation recueillir_consentements_transgenerationnels_1078_5(l: Liberalite) kind empirical {
    label fr official "le disposant recueille les consentements non viciés dans l'acte";
    label en unofficial "the donor obtains untainted consents in the instrument";
}
pub relation donation_partage_avec_renonciation_enfant(l: Liberalite) kind empirical { label fr official "une donation-partage comporte la renonciation d'un enfant à tout ou partie de ses droits au profit de ses descendants"; label en unofficial "a partition-gift includes a child's renunciation of all or part of their rights in favour of their descendants"; }
@source(CC_ART1078_5)
rule PositionDevoirRecueillirConsentementsTransgenerationnels(l: Liberalite) strict {
    label fr official "Article 1078-5. Le disposant doit recueillir les consentements non viciés";
    label en unofficial "Article 1078-5. The donor must obtain untainted consents";
    when donation_partage_avec_renonciation_enfant(l);
    then duty DevoirRecueillirConsentementsTransgenerationnels {
        bearer entity_ref("urn:fr:cc:liberalites:disposant");
        goal achievement {
            condition recueillir_consentements_transgenerationnels_1078_5(l);
            window [@2007-01-01, infinity);
        };
    };
}
@source(CC_ART1078_6) rule PartageParSouche(l: Liberalite) strict { label fr official "Article 1078-6. Le concours de degrés différents entraîne un partage par souche"; label en unofficial "Article 1078-6. Participation by different degrees results in partition by branch"; when descendants_degres_differents_allotis(l); then partage_par_souche(l); }
@source(CC_ART1078_7) rule ConventionsTransgenerationnelles(l: Liberalite) strict { label fr official "Article 1078-7. Le partage entre degrés différents peut comporter les conventions d'incorporation"; label en unofficial "Article 1078-7. A partition among different degrees may include incorporation agreements"; when conventions_incorporation_transgenerationnelles(l); then conventions_transgenerationnelles_admises(l); }
pub relation stipuler_conventions_incorporation_1078_7(l: Liberalite) kind empirical {
    label fr official "les parties stipulent des conventions d'incorporation transgénérationnelles";
    label en unofficial "the parties stipulate transgenerational incorporation agreements";
}
@source(CC_ART1078_7)
rule PositionPouvoirStipulerConventionsIncorporation(l: Liberalite) strict {
    label fr official "Article 1078-7. Les parties peuvent stipuler des conventions d'incorporation";
    label en unofficial "Article 1078-7. The parties may stipulate incorporation agreements";
    when conventions_incorporation_transgenerationnelles(l)
        and stipuler_conventions_incorporation_1078_7(l);
    then liberty PouvoirStipulerConventionsIncorporation {
        holder entity_ref("urn:fr:cc:liberalites:parties");
        action stipuler_conventions_incorporation_1078_7(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1078_8) rule ImputationParSouche(l: Liberalite) strict { label fr official "Article 1078-8. Les biens d'une souche s'imputent ensemble sur sa réserve puis la quotité disponible"; label en unofficial "Article 1078-8. Property of one branch is charged together to its forced share then the disposable share"; when biens_recus_meme_souche(l); then imputation_globale_par_souche(l); }
@source(CC_ART1078_9) rule TraitementCommeAuteurDirect(l: Liberalite) strict { label fr official "Article 1078-9. Dans la succession de l'enfant consentant, les biens sont traités comme tenus de lui"; label en unofficial "Article 1078-9. In the consenting child's estate, property is treated as derived from that child"; when succession_enfant_ayant_consenti(l); then biens_traites_tenus_auteur_direct(l); }
@source(CC_ART1078_10) rule NouvelleDonationEcarteRegle(l: Liberalite) strict { label fr official "Article 1078-10. Une nouvelle donation-partage incorporant les biens écarte la règle précédente"; label en unofficial "Article 1078-10. A new partition gift incorporating the property displaces the preceding rule"; when nouvelle_donation_partage_incorpore_biens(l); then regle_succession_enfant_ecartee(l); }
@source(CC_ART1079) rule TestamentPartageSansNouveauPartage(l: Liberalite) strict { label fr official "Article 1079. Le bénéficiaire ne peut écarter le testament-partage pour réclamer un nouveau partage"; label en unofficial "Article 1079. A beneficiary may not set aside the testamentary partition to seek a new partition"; when testament_partage_invoque(l); then nouveau_partage_interdit(l); }
pub relation reclamer_nouveau_partage_1079(l: Liberalite) kind empirical {
    label fr official "le bénéficiaire réclame un nouveau partage malgré le testament-partage";
    label en unofficial "the beneficiary seeks a new partition despite the testamentary partition";
}
@source(CC_ART1079)
rule PositionInterdictionReclamerNouveauPartage(l: Liberalite) strict {
    label fr official "Article 1079. Le bénéficiaire ne peut réclamer un nouveau partage";
    label en unofficial "Article 1079. The beneficiary may not seek a new partition";
    when testament_partage_invoque(l);
    then prohibition InterdictionReclamerNouveauPartage {
        bearer entity_ref("urn:fr:cc:liberalites:beneficiaire");
        action reclamer_nouveau_partage_1079(l);
        window [@2006-01-01, infinity);
    };
}
@source(CC_ART1079)
rule MaintenanceInterdictionReclamerNouveauPartage(l: Liberalite) strict {
    label fr official "Article 1079. Maintenir l'interdiction de réclamer un nouveau partage";
    label en unofficial "Article 1079. Maintain the prohibition on seeking a new partition";
    when testament_partage_invoque(l);
    then duty MaintenanceInterdictionReclamerNouveauPartageDuty {
        bearer entity_ref("urn:fr:cc:liberalites:beneficiaire");
        goal maintenance {
            condition not reclamer_nouveau_partage_1079(l);
            window [@2006-01-01, infinity);
        };
    };
}
@source(CC_ART1080) rule ReductionTestamentPartage(l: Liberalite) strict { label fr official "Article 1080. Le bénéficiaire insuffisamment alloti peut exercer l'action en réduction"; label en unofficial "Article 1080. An under-allotted beneficiary may bring the reduction action"; when lot_testament_partage_inferieur_reserve(l); then action_reduction_partage_ouverte(l); }
pub relation exercer_action_reduction_testament_1080(l: Liberalite) kind empirical {
    label fr official "le bénéficiaire exerce l'action en réduction du testament-partage";
    label en unofficial "the beneficiary exercises the testamentary-partition reduction action";
}
@source(CC_ART1080)
rule PositionPouvoirExercerActionReductionTestament(l: Liberalite) strict {
    label fr official "Article 1080. Le bénéficiaire peut exercer l'action en réduction";
    label en unofficial "Article 1080. The beneficiary may exercise the reduction action";
    when lot_testament_partage_inferieur_reserve(l)
        and exercer_action_reduction_testament_1080(l);
    then liberty PouvoirExercerActionReductionTestament {
        holder entity_ref("urn:fr:cc:liberalites:beneficiaire");
        action exercer_action_reduction_testament_1080(l);
        window [@2007-01-01, infinity);
    };
}
