language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-POSITIONPOUVOIRCHOISIRREDUCTIONNATURE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": choisir_reduction_nature_924_1(entity_ref("urn:law:catalog:positionpouvoirchoisirreductionnature:v0")) { origin case_input; }
        assert "cat-1": bien_appartient_encore_au_gratifie_et_reste_libre(entity_ref("urn:law:catalog:positionpouvoirchoisirreductionnature:v0")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(PouvoirChoisirReductionNature, ACTIVE);
}
