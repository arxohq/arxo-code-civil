language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ALIENATIONAUSUCCESSIBLEIMPUTEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": autre_successible_direct_n_a_pas_consenti(entity_ref("urn:law:catalog:alienationausuccessibleimputee:v0")) { origin case_input; }
        assert "cat-1": alienation_a_successible_direct_avec_rente_ou_usufruit(entity_ref("urn:law:catalog:alienationausuccessibleimputee:v0")) { origin case_input; }
    }
    evaluate truth(imputation_sur_quotite_ouverte(entity_ref("urn:law:catalog:alienationausuccessibleimputee:v0")));
    expect truth_status == TRUE_ONLY;
}
