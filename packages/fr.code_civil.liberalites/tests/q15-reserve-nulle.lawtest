language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Art. 912 : la réserve est le complément : 0 / 1.
test "urn:query:fr-code-civil-liberalites-q15-reserve-nulle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_LIBERALITES_CALENDRIER; }
        assert "f1": fr.code_civil.successions::defunt(entity_ref("urn:fr:cc:liberalites:q3c:S"), entity_ref("urn:fr:cc:liberalites:q3c:D")) { origin case_input; }
        assert "f2": fr.code_civil.successions::ouverte_le(entity_ref("urn:fr:cc:liberalites:q3c:S"), @2026-03-01) { origin case_input; }
        assert "f3": fr.code_civil.successions::famille(entity_ref("urn:fr:cc:liberalites:q3c:S"), entity_ref("urn:fr:cc:liberalites:q3c:F")) { origin case_input; }
        assert "f4": biens_existants_au_deces(entity_ref("urn:fr:cc:liberalites:q3c:S"), 100000 EUR) { origin case_input; }
    }
    evaluate truth(reserve_globale(entity_ref("urn:fr:cc:liberalites:q3c:S"), 0 / 1));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
