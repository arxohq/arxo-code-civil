test "CC07-U01-graduelle" { given { context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Paris"; } assert "c": charge_conserver_transmettre_second_gratifie(entity_ref("urn:cc07:u01:l")) { origin case_input; } } evaluate truth(liberalite_graduelle(entity_ref("urn:cc07:u01:l"))); expect truth_status == TRUE_ONLY; expect applied(DefinitionLiberaliteGraduelle); }
