test "CC07-G01-definition-donation" {
 given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
  assert "d": depouillement_actuel_et_irrevocable(entity_ref("urn:cc07:g01:l")) { origin case_input; }
  assert "a": donation_acceptee(entity_ref("urn:cc07:g01:l")) { origin case_input; }
 }
 evaluate truth(donation_entre_vifs_qualifiee(entity_ref("urn:cc07:g01:l")));
 expect evaluation_status == COMPUTED; expect truth_status == TRUE_ONLY; expect applied(DefinitionDonationEntreVifs);
}

