language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Art. 923 : deux donations à la même date : frontière déclarée.
test "urn:query:fr-code-civil-liberalites-q19-donations-de-meme-date-frontiere" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_LIBERALITES_CALENDRIER; }
        assert "f1": fr.code_civil.successions::defunt(entity_ref("urn:fr:cc:liberalites:q5:S"), entity_ref("urn:fr:cc:liberalites:q5:D")) { origin case_input; }
        assert "f2": fr.code_civil.successions::ouverte_le(entity_ref("urn:fr:cc:liberalites:q5:S"), @2026-03-01) { origin case_input; }
        assert "f3": fr.code_civil.successions::famille(entity_ref("urn:fr:cc:liberalites:q5:S"), entity_ref("urn:fr:cc:liberalites:q5:F")) { origin case_input; }
        assert "f4": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q5:F"), entity_ref("urn:fr:cc:liberalites:q5:D"), entity_ref("urn:fr:cc:liberalites:q5:C1")) { origin case_input; }
        assert "f5": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q5:S"), entity_ref("urn:fr:cc:liberalites:q5:C1")) { origin case_input; }
        assert "f6": biens_existants_au_deces(entity_ref("urn:fr:cc:liberalites:q5:S"), 100000 EUR) { origin case_input; }
        assert "f7": liberalite_du_defunt(entity_ref("urn:fr:cc:liberalites:q5:S"), entity_ref("urn:fr:cc:liberalites:q5:A")) { origin case_input; }
        assert "f8": nature(entity_ref("urn:fr:cc:liberalites:q5:A"), DonationEntreVifs) { origin case_input; }
        assert "f9": gratifie(entity_ref("urn:fr:cc:liberalites:q5:A"), entity_ref("urn:fr:cc:liberalites:q5:TA")) { origin case_input; }
        assert "f10": valeur_reunie(entity_ref("urn:fr:cc:liberalites:q5:A"), 80000 EUR) { origin case_input; }
        assert "f11": date_de_la_donation(entity_ref("urn:fr:cc:liberalites:q5:A"), @2010-01-15) { origin case_input; }
        assert "f12": hors_part_successorale(entity_ref("urn:fr:cc:liberalites:q5:A")) { origin case_input; }
        assert "f13": liberalite_du_defunt(entity_ref("urn:fr:cc:liberalites:q5:S"), entity_ref("urn:fr:cc:liberalites:q5:B")) { origin case_input; }
        assert "f14": nature(entity_ref("urn:fr:cc:liberalites:q5:B"), DonationEntreVifs) { origin case_input; }
        assert "f15": gratifie(entity_ref("urn:fr:cc:liberalites:q5:B"), entity_ref("urn:fr:cc:liberalites:q5:TB")) { origin case_input; }
        assert "f16": valeur_reunie(entity_ref("urn:fr:cc:liberalites:q5:B"), 50000 EUR) { origin case_input; }
        assert "f17": date_de_la_donation(entity_ref("urn:fr:cc:liberalites:q5:B"), @2010-01-15) { origin case_input; }
        assert "f18": hors_part_successorale(entity_ref("urn:fr:cc:liberalites:q5:B")) { origin case_input; }
    }
    evaluate truth(donations_de_meme_date(entity_ref("urn:fr:cc:liberalites:q5:S"), @2010-01-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DonationsDeMemeDate);
}
