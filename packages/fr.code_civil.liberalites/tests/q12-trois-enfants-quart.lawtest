language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Art. 913 : trois enfants ou plus, le quart.
test "urn:query:fr-code-civil-liberalites-q12-trois-enfants-quart" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_LIBERALITES_CALENDRIER; }
        assert "f1": fr.code_civil.successions::defunt(entity_ref("urn:fr:cc:liberalites:q3:S"), entity_ref("urn:fr:cc:liberalites:q3:D")) { origin case_input; }
        assert "f2": fr.code_civil.successions::ouverte_le(entity_ref("urn:fr:cc:liberalites:q3:S"), @2026-03-01) { origin case_input; }
        assert "f3": fr.code_civil.successions::famille(entity_ref("urn:fr:cc:liberalites:q3:S"), entity_ref("urn:fr:cc:liberalites:q3:F")) { origin case_input; }
        assert "f4": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q3:F"), entity_ref("urn:fr:cc:liberalites:q3:D"), entity_ref("urn:fr:cc:liberalites:q3:C1")) { origin case_input; }
        assert "f5": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q3:F"), entity_ref("urn:fr:cc:liberalites:q3:D"), entity_ref("urn:fr:cc:liberalites:q3:C2")) { origin case_input; }
        assert "f6": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q3:F"), entity_ref("urn:fr:cc:liberalites:q3:D"), entity_ref("urn:fr:cc:liberalites:q3:C3")) { origin case_input; }
        assert "f7": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q3:S"), entity_ref("urn:fr:cc:liberalites:q3:C1")) { origin case_input; }
        assert "f8": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q3:S"), entity_ref("urn:fr:cc:liberalites:q3:C2")) { origin case_input; }
        assert "f9": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q3:S"), entity_ref("urn:fr:cc:liberalites:q3:C3")) { origin case_input; }
        assert "f10": biens_existants_au_deces(entity_ref("urn:fr:cc:liberalites:q3:S"), 100000 EUR) { origin case_input; }
    }
    evaluate truth(quotite_disponible(entity_ref("urn:fr:cc:liberalites:q3:S"), 1 / 4));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(QuotiteTroisEnfantsOuPlus);
}
