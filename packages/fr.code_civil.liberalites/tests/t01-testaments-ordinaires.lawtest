test "CC07-T01-volonte-testamentaire" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "v": volonte_testamentaire_manifestee(entity_ref("urn:cc07:t01:l")) { origin case_input; } } evaluate truth(disposition_testamentaire_valable(entity_ref("urn:cc07:t01:l"))); expect truth_status == TRUE_ONLY; expect applied(VolonteTestamentaireQuelleQueSoitDenomination); }
