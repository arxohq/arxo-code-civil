language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Art. 913 al. 2 : le renonçant non représenté n est pas compris : un enfant, moitié.
test "urn:query:fr-code-civil-liberalites-q20-renoncant-non-compte" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_LIBERALITES_CALENDRIER; }
        assert "f1": fr.code_civil.successions::defunt(entity_ref("urn:fr:cc:liberalites:q6:S"), entity_ref("urn:fr:cc:liberalites:q6:D")) { origin case_input; }
        assert "f2": fr.code_civil.successions::ouverte_le(entity_ref("urn:fr:cc:liberalites:q6:S"), @2026-03-01) { origin case_input; }
        assert "f3": fr.code_civil.successions::famille(entity_ref("urn:fr:cc:liberalites:q6:S"), entity_ref("urn:fr:cc:liberalites:q6:F")) { origin case_input; }
        assert "f4": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q6:F"), entity_ref("urn:fr:cc:liberalites:q6:D"), entity_ref("urn:fr:cc:liberalites:q6:C1")) { origin case_input; }
        assert "f5": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q6:F"), entity_ref("urn:fr:cc:liberalites:q6:D"), entity_ref("urn:fr:cc:liberalites:q6:C2")) { origin case_input; }
        assert "f6": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q6:S"), entity_ref("urn:fr:cc:liberalites:q6:C1")) { origin case_input; }
        assert "f7": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q6:S"), entity_ref("urn:fr:cc:liberalites:q6:C2")) { origin case_input; }
        assert "f8": fr.code_civil.successions::renonce(entity_ref("urn:fr:cc:liberalites:q6:S"), entity_ref("urn:fr:cc:liberalites:q6:C2")) { origin case_input; }
        assert "f9": biens_existants_au_deces(entity_ref("urn:fr:cc:liberalites:q6:S"), 100000 EUR) { origin case_input; }
    }
    evaluate truth(quotite_disponible(entity_ref("urn:fr:cc:liberalites:q6:S"), 1 / 2));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
