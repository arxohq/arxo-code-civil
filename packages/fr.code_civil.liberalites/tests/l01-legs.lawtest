test "CC07-L01-cantonnement" { given { context { legal_time @2026-09-17; decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; timezone "Europe/Paris"; } assert "h": succession_acceptee_par_heritier_legal(entity_ref("urn:cc07:l01:l")) { origin case_input; } assert "c": legataire_cantonne_emolument(entity_ref("urn:cc07:l01:l")) { origin case_input; } } evaluate truth(cantonnement_non_liberalite(entity_ref("urn:cc07:l01:l"))); expect truth_status == TRUE_ONLY; expect applied(CantonnementDuLegataire); }
