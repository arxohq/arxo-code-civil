language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Art. 913 al. 2, 913-1 : le renonçant représenté est compris : deux enfants, un tiers.
test "urn:query:fr-code-civil-liberalites-q21-renoncant-represente-compte" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_LIBERALITES_CALENDRIER; }
        assert "f1": fr.code_civil.successions::defunt(entity_ref("urn:fr:cc:liberalites:q7:S"), entity_ref("urn:fr:cc:liberalites:q7:D")) { origin case_input; }
        assert "f2": fr.code_civil.successions::ouverte_le(entity_ref("urn:fr:cc:liberalites:q7:S"), @2026-03-01) { origin case_input; }
        assert "f3": fr.code_civil.successions::famille(entity_ref("urn:fr:cc:liberalites:q7:S"), entity_ref("urn:fr:cc:liberalites:q7:F")) { origin case_input; }
        assert "f4": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q7:F"), entity_ref("urn:fr:cc:liberalites:q7:D"), entity_ref("urn:fr:cc:liberalites:q7:C1")) { origin case_input; }
        assert "f5": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q7:F"), entity_ref("urn:fr:cc:liberalites:q7:D"), entity_ref("urn:fr:cc:liberalites:q7:C2")) { origin case_input; }
        assert "f6": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q7:F"), entity_ref("urn:fr:cc:liberalites:q7:C2"), entity_ref("urn:fr:cc:liberalites:q7:G")) { origin case_input; }
        assert "f7": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q7:S"), entity_ref("urn:fr:cc:liberalites:q7:C1")) { origin case_input; }
        assert "f8": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q7:S"), entity_ref("urn:fr:cc:liberalites:q7:C2")) { origin case_input; }
        assert "f9": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q7:S"), entity_ref("urn:fr:cc:liberalites:q7:G")) { origin case_input; }
        assert "f10": fr.code_civil.successions::renonce(entity_ref("urn:fr:cc:liberalites:q7:S"), entity_ref("urn:fr:cc:liberalites:q7:C2")) { origin case_input; }
        assert "f11": biens_existants_au_deces(entity_ref("urn:fr:cc:liberalites:q7:S"), 120000 EUR) { origin case_input; }
    }
    evaluate truth(quotite_disponible(entity_ref("urn:fr:cc:liberalites:q7:S"), 1 / 3));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
