language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Art. 919-1 : donation en avancement de part successorale : imputation non formalisée (frontière).
test "urn:query:fr-code-civil-liberalites-q22-avancement-de-part-frontiere" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_LIBERALITES_CALENDRIER; }
        assert "f1": fr.code_civil.successions::defunt(entity_ref("urn:fr:cc:liberalites:q8:S"), entity_ref("urn:fr:cc:liberalites:q8:D")) { origin case_input; }
        assert "f2": fr.code_civil.successions::ouverte_le(entity_ref("urn:fr:cc:liberalites:q8:S"), @2026-03-01) { origin case_input; }
        assert "f3": fr.code_civil.successions::famille(entity_ref("urn:fr:cc:liberalites:q8:S"), entity_ref("urn:fr:cc:liberalites:q8:F")) { origin case_input; }
        assert "f4": fr.code_civil.successions::filiation(entity_ref("urn:fr:cc:liberalites:q8:F"), entity_ref("urn:fr:cc:liberalites:q8:D"), entity_ref("urn:fr:cc:liberalites:q8:C1")) { origin case_input; }
        assert "f5": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q8:S"), entity_ref("urn:fr:cc:liberalites:q8:C1")) { origin case_input; }
        assert "f6": biens_existants_au_deces(entity_ref("urn:fr:cc:liberalites:q8:S"), 100000 EUR) { origin case_input; }
        assert "f7": liberalite_du_defunt(entity_ref("urn:fr:cc:liberalites:q8:S"), entity_ref("urn:fr:cc:liberalites:q8:A")) { origin case_input; }
        assert "f8": nature(entity_ref("urn:fr:cc:liberalites:q8:A"), DonationEntreVifs) { origin case_input; }
        assert "f9": gratifie(entity_ref("urn:fr:cc:liberalites:q8:A"), entity_ref("urn:fr:cc:liberalites:q8:C1")) { origin case_input; }
        assert "f10": valeur_reunie(entity_ref("urn:fr:cc:liberalites:q8:A"), 80000 EUR) { origin case_input; }
        assert "f11": date_de_la_donation(entity_ref("urn:fr:cc:liberalites:q8:A"), @2010-01-15) { origin case_input; }
    }
    evaluate truth(imputation_non_formalisee(entity_ref("urn:fr:cc:liberalites:q8:S"), entity_ref("urn:fr:cc:liberalites:q8:A")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ImputationNonFormalisee);
}
