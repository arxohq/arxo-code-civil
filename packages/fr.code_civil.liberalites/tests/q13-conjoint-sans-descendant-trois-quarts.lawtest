language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

// Art. 914-1 : conjoint survivant non divorcé, sans descendant : trois quarts.
test "urn:query:fr-code-civil-liberalites-q13-conjoint-sans-descendant-trois-quarts" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_LIBERALITES_CALENDRIER; }
        assert "f1": fr.code_civil.successions::defunt(entity_ref("urn:fr:cc:liberalites:q3b:S"), entity_ref("urn:fr:cc:liberalites:q3b:D")) { origin case_input; }
        assert "f2": fr.code_civil.successions::ouverte_le(entity_ref("urn:fr:cc:liberalites:q3b:S"), @2026-03-01) { origin case_input; }
        assert "f3": fr.code_civil.successions::famille(entity_ref("urn:fr:cc:liberalites:q3b:S"), entity_ref("urn:fr:cc:liberalites:q3b:F")) { origin case_input; }
        assert "f4": fr.code_civil.successions::mariage(entity_ref("urn:fr:cc:liberalites:q3b:F"), entity_ref("urn:fr:cc:liberalites:q3b:D"), entity_ref("urn:fr:cc:liberalites:q3b:E")) { origin case_input; }
        assert "f5": fr.code_civil.successions::existe_a_l_ouverture(entity_ref("urn:fr:cc:liberalites:q3b:S"), entity_ref("urn:fr:cc:liberalites:q3b:E")) { origin case_input; }
        assert "f6": biens_existants_au_deces(entity_ref("urn:fr:cc:liberalites:q3b:S"), 100000 EUR) { origin case_input; }
    }
    evaluate truth(quotite_disponible(entity_ref("urn:fr:cc:liberalites:q3b:S"), 3 / 4));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(QuotiteAvecConjointSansDescendant);
}
