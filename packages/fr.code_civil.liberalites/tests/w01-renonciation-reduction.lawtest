language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

test "CC07-W01-renonciation-acceptee" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "s": succession_non_ouverte(entity_ref("urn:cc07:w01:r")) { origin case_input; } assert "h": renoncant_reservataire_presomptif(entity_ref("urn:cc07:w01:r")) { origin case_input; } assert "b": beneficiaire_determine_de_la_renonciation(entity_ref("urn:cc07:w01:r")) { origin case_input; } assert "a": renonciation_acceptee_par_le_futur_defunt(entity_ref("urn:cc07:w01:r")) { origin case_input; } } evaluate truth(renonciation_engage(entity_ref("urn:cc07:w01:r"))); expect truth_status == TRUE_ONLY; expect applied(RenonciationEngageApresAcceptation); }
test "CC07-W02-forme-authentique" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "f": acte_authentique_specifique_deux_notaires(entity_ref("urn:cc07:w02:r")) { origin case_input; } } evaluate truth(renonciation_valable(entity_ref("urn:cc07:w02:r"))); expect truth_status == TRUE_ONLY; expect applied(FormeAuthentiqueValide); }
test "CC07-W03-consentement-vicie" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "v": consentement_du_renoncant_vicie(entity_ref("urn:cc07:w03:r")) { origin case_input; } } evaluate truth(renonciation_nulle(entity_ref("urn:cc07:w03:r"))); expect truth_status == TRUE_ONLY; expect applied(ViceDuConsentementRendNulle); }
test "CC07-W04-effet-limite" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "a": atteinte_a_la_reserve(entity_ref("urn:cc07:w04:r"), 1 / 4) { origin case_input; } assert "v": fraction_visee_par_renonciation(entity_ref("urn:cc07:w04:r"), 1 / 2) { origin case_input; } } evaluate truth(effet_de_la_renonciation(entity_ref("urn:cc07:w04:r"), 1 / 4)); expect truth_status == TRUE_ONLY; expect applied(EffetLimiteALAtteinte); }
