// CHAPITRE VI — LIBÉRALITÉS GRADUELLES ET RÉSIDUELLES (1048 à 1061).

language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

use self::{
    CC_ART1048,
    CC_ART1049,
    CC_ART1050,
    CC_ART1051,
    CC_ART1052,
    CC_ART1053,
    CC_ART1054,
    CC_ART1055,
    CC_ART1056,
    CC_ART1057,
    CC_ART1058,
    CC_ART1059,
    CC_ART1060,
    CC_ART1061,
    Liberalite,
};

pub relation charge_conserver_transmettre_second_gratifie(l: Liberalite) kind empirical { label fr official "la libéralité impose de conserver puis transmettre à un second gratifié désigné"; label en unofficial "the gift requires preservation and later transfer to a named second beneficiary"; }
pub relation liberalite_graduelle(l: Liberalite) kind derived { label fr official "libéralité graduelle"; label en unofficial "successive gift"; }
pub relation biens_identifiables_subsistent_en_nature(l: Liberalite) kind empirical { label fr official "les biens sont identifiables et subsistent en nature à la transmission"; label en unofficial "the property is identifiable and remains in kind at transfer"; }
pub relation effet_graduelle_sur_biens_subsistants(l: Liberalite) kind derived { label fr official "effet de la libéralité graduelle sur les biens subsistants et subrogés"; label en unofficial "effect of the successive gift on remaining and substituted property"; }
pub relation deces_du_greve(l: Liberalite) kind empirical { label fr official "le grevé est décédé"; label en unofficial "the first beneficiary has died"; }
pub relation droits_second_gratifie_ouverts(l: Liberalite) kind derived { label fr official "droits du second gratifié ouverts"; label en unofficial "second beneficiary's rights opened"; }
pub relation second_gratifie_tient_droits_du_disposant(l: Liberalite) kind derived { label fr official "second gratifié réputé tenir ses droits du disposant"; label en unofficial "second beneficiary deemed to derive rights from the donor"; }
pub relation garanties_suretes_prescrites_disposant(l: Liberalite) kind empirical { label fr official "le disposant prescrit des garanties ou sûretés"; label en unofficial "the donor prescribes guarantees or security"; }
pub relation garanties_execution_charge_exigibles(l: Liberalite) kind derived { label fr official "garanties d'exécution de la charge exigibles"; label en unofficial "security for performance of the burden is enforceable"; }
pub relation charge_au_dela_premier_degre(l: Liberalite) kind empirical { label fr official "la charge est stipulée au-delà du premier degré"; label en unofficial "the burden is stipulated beyond the first degree"; }
pub relation charge_limitee_premier_degre(l: Liberalite) kind derived { label fr official "charge valable au premier degré seulement"; label en unofficial "burden valid only at the first degree"; }
pub relation greve_heritier_reservataire(l: Liberalite) kind empirical { label fr official "le grevé est héritier réservataire"; label en unofficial "the first beneficiary is a forced heir"; }
pub relation charge_limitee_quotite_disponible(l: Liberalite) kind derived { label fr official "charge limitée à la quotité disponible sans consentement contraire"; label en unofficial "burden limited to the disposable share absent contrary consent"; }
pub relation connaissance_testament_le(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date de connaissance du testament par le légataire"; label en unofficial "date the legatee learned of the will"; }
pub relation demande_liberation_charge_le(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date de demande de libération de la charge"; label en unofficial "date of the request to release the burden"; }
pub relation demande_liberation_dans_un_an(l: Liberalite) kind derived { label fr official "demande de libération de la réserve dans l'année"; label en unofficial "request to release the forced share within one year"; }
pub relation second_gratifie_pas_encore_accepte(l: Liberalite) kind empirical { label fr official "le second gratifié n'a pas encore notifié son acceptation"; label en unofficial "the second beneficiary has not yet notified acceptance"; }
pub relation revocation_envers_second_gratifie_possible(l: Liberalite) kind derived { label fr official "révocation possible envers le second gratifié"; label en unofficial "revocation possible as against the second beneficiary"; }
pub relation second_gratifie_predecede_ou_renonce(l: Liberalite) kind empirical { label fr official "le second gratifié prédécède ou renonce"; label en unofficial "the second beneficiary predeceases or disclaims"; }
pub relation biens_depend_succession_du_greve(l: Liberalite) kind derived { label fr official "biens dépendant de la succession du grevé sauf clause contraire"; label en unofficial "property falls into the first beneficiary's estate absent contrary terms"; }
pub relation appel_a_recueillir_subsistant(l: Liberalite) kind empirical { label fr official "une personne est appelée à recueillir ce qui subsistera au décès du premier gratifié"; label en unofficial "a person is called to receive what remains at the first beneficiary's death"; }
pub relation liberalite_residuelle(l: Liberalite) kind derived { label fr official "libéralité résiduelle"; label en unofficial "residual gift"; }
pub relation biens_residuels_alienes(l: Liberalite) kind empirical { label fr official "les biens résiduels ont été aliénés par le premier gratifié"; label en unofficial "the residual property was alienated by the first beneficiary"; }
pub relation aucun_report_sur_prix_ou_remploi(l: Liberalite) kind derived { label fr official "absence de report sur le prix ou les biens acquis"; label en unofficial "no tracing into proceeds or replacement property"; }
pub relation premier_gratifie_dispose_testament_biens_residuels(l: Liberalite) kind empirical { label fr official "le premier gratifié dispose par testament des biens résiduels"; label en unofficial "the first beneficiary disposes of residual property by will"; }
pub relation disposition_residuelle_interdite(l: Liberalite) kind derived { label fr official "disposition testamentaire des biens résiduels interdite"; label en unofficial "testamentary disposition of residual property prohibited"; }
pub relation gestion_premier_gratifie(l: Liberalite) kind empirical { label fr official "le premier gratifié gère les biens résiduels"; label en unofficial "the first beneficiary manages the residual property"; }
pub relation aucun_compte_gestion_du(l: Liberalite) kind derived { label fr official "aucun compte de gestion dû au disposant ou à ses héritiers"; label en unofficial "no management account owed to the donor or heirs"; }
pub relation regles_graduelles_etendues_residuelles(l: Liberalite) kind derived { label fr official "règles désignées des libéralités graduelles applicables aux résiduelles"; label en unofficial "specified successive-gift rules apply to residual gifts"; }

@source(CC_ART1048) rule DefinitionLiberaliteGraduelle(l: Liberalite) strict { label fr official "Article 1048. La charge de conserver puis transmettre à un second gratifié forme une libéralité graduelle"; label en unofficial "Article 1048. A burden to preserve and later transfer to a second beneficiary forms a successive gift"; when charge_conserver_transmettre_second_gratifie(l); then liberalite_graduelle(l); }
@source(CC_ART1049) rule BiensSubsistantsGraduelle(l: Liberalite) strict { label fr official "Article 1049. La libéralité graduelle porte sur les biens identifiables subsistants et certaines valeurs subrogées"; label en unofficial "Article 1049. A successive gift operates on identifiable remaining property and certain substituted securities"; when liberalite_graduelle(l) and biens_identifiables_subsistent_en_nature(l); then effet_graduelle_sur_biens_subsistants(l); }
@source(CC_ART1050) rule OuvertureDroitsSecond(l: Liberalite) strict { label fr official "Article 1050. Les droits du second gratifié s'ouvrent au décès du grevé"; label en unofficial "Article 1050. The second beneficiary's rights open at the first beneficiary's death"; when liberalite_graduelle(l) and deces_du_greve(l); then droits_second_gratifie_ouverts(l); }
@source(CC_ART1051) rule DroitsTenusDuDisposant(l: Liberalite) strict { label fr official "Article 1051. Le second gratifié tient ses droits du disposant"; label en unofficial "Article 1051. The second beneficiary derives rights from the donor"; when droits_second_gratifie_ouverts(l); then second_gratifie_tient_droits_du_disposant(l); }
@source(CC_ART1052) rule GarantiesDuDisposant(l: Liberalite) strict { label fr official "Article 1052. Le disposant peut prescrire les garanties de bonne exécution"; label en unofficial "Article 1052. The donor may prescribe security for due performance"; when garanties_suretes_prescrites_disposant(l); then garanties_execution_charge_exigibles(l); }
pub relation prescrire_garanties_execution_1052(l: Liberalite) kind empirical {
    label fr official "le disposant prescrit des garanties de bonne exécution";
    label en unofficial "the donor prescribes security for due performance";
}
@source(CC_ART1052)
rule PositionPouvoirPrescrireGarantiesExecution(l: Liberalite) strict {
    label fr official "Article 1052. Le disposant peut prescrire des garanties de bonne exécution";
    label en unofficial "Article 1052. The donor may prescribe security for due performance";
    when garanties_suretes_prescrites_disposant(l)
        and prescrire_garanties_execution_1052(l);
    then liberty PouvoirPrescrireGarantiesExecution {
        holder entity_ref("urn:fr:cc:liberalites:disposant");
        action prescrire_garanties_execution_1052(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1053) rule UnSeulDegre(l: Liberalite) strict { label fr official "Article 1053. La charge stipulée au-delà du premier degré n'est valable qu'au premier"; label en unofficial "Article 1053. A burden stipulated beyond the first degree is valid only at the first"; when charge_au_dela_premier_degre(l); then charge_limitee_premier_degre(l); }
pub relation stipuler_charge_au_dela_premier_degre_1053(l: Liberalite) kind empirical {
    label fr official "le disposant stipule une charge au-delà du premier degré";
    label en unofficial "the donor stipulates a burden beyond the first degree";
}
@source(CC_ART1053)
rule PositionInterdictionStipulerChargeAuDelaPremierDegre(l: Liberalite) strict {
    label fr official "Article 1053. Le disposant ne peut stipuler une charge au-delà du premier degré";
    label en unofficial "Article 1053. The donor may not stipulate a burden beyond the first degree";
    when charge_au_dela_premier_degre(l);
    then prohibition InterdictionStipulerChargeAuDelaPremierDegre {
        bearer entity_ref("urn:fr:cc:liberalites:disposant");
        action stipuler_charge_au_dela_premier_degre_1053(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1053)
rule MaintenanceInterdictionStipulerChargeAuDelaPremierDegre(l: Liberalite) strict {
    label fr official "Article 1053. Maintenir l'interdiction de stipuler une charge au-delà du premier degré";
    label en unofficial "Article 1053. Maintain the prohibition on stipulating a burden beyond the first degree";
    when charge_au_dela_premier_degre(l);
    then duty MaintenanceInterdictionStipulerChargeAuDelaPremierDegreDuty {
        bearer entity_ref("urn:fr:cc:liberalites:disposant");
        goal maintenance {
            condition not stipuler_charge_au_dela_premier_degre_1053(l);
            window [@2007-01-01, infinity);
        };
    };
}
@source(CC_ART1054) { rule ReserveGreveProtegee(l: Liberalite) strict { label fr official "Article 1054. Pour un grevé réservataire, la charge est limitée à la quotité disponible sans consentement"; label en unofficial "Article 1054. For a forced-heir first beneficiary, the burden is limited to the disposable share absent consent"; when greve_heritier_reservataire(l); then charge_limitee_quotite_disponible(l); } rule LiberationReserveUnAn(l: Liberalite, connaissance: Date, demande: Date) strict { label fr official "Article 1054. Le légataire demande dans l'année la libération de sa réserve"; label en unofficial "Article 1054. The legatee requests release of the forced share within one year"; when connaissance_testament_le(l, connaissance) and demande_liberation_charge_le(l, demande) and demande <= add_calendar_period(connaissance, 1 calendar_year); then demande_liberation_dans_un_an(l); } }
pub relation stipuler_charge_au_dela_quotite_1054(l: Liberalite) kind empirical {
    label fr official "le disposant stipule une charge au-delà de la quotité disponible sans consentement";
    label en unofficial "the donor stipulates a burden beyond the disposable share without consent";
}
@source(CC_ART1054)
rule PositionInterdictionStipulerChargeAuDelaQuotite(l: Liberalite) strict {
    label fr official "Article 1054. Le disposant ne peut dépasser la quotité disponible sans consentement";
    label en unofficial "Article 1054. The donor may not exceed the disposable share without consent";
    when greve_heritier_reservataire(l);
    then prohibition InterdictionStipulerChargeAuDelaQuotite {
        bearer entity_ref("urn:fr:cc:liberalites:disposant");
        action stipuler_charge_au_dela_quotite_1054(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1054)
rule MaintenanceInterdictionStipulerChargeAuDelaQuotite(l: Liberalite) strict {
    label fr official "Article 1054. Maintenir l'interdiction de dépasser la quotité disponible";
    label en unofficial "Article 1054. Maintain the prohibition on exceeding the disposable share";
    when greve_heritier_reservataire(l);
    then duty MaintenanceInterdictionStipulerChargeAuDelaQuotiteDuty {
        bearer entity_ref("urn:fr:cc:liberalites:disposant");
        goal maintenance {
            condition not stipuler_charge_au_dela_quotite_1054(l);
            window [@2007-01-01, infinity);
        };
    };
}
pub relation demander_liberation_reserve_1054(l: Liberalite) kind empirical {
    label fr official "le légataire demande la libération de sa réserve";
    label en unofficial "the legatee requests release of the forced share";
}
@source(CC_ART1054)
rule PositionPouvoirDemanderLiberationReserve(l: Liberalite, connaissance: Date, demande: Date) strict {
    label fr official "Article 1054. Le légataire peut demander dans l'année la libération de sa réserve";
    label en unofficial "Article 1054. The legatee may request release of the forced share within one year";
    when connaissance_testament_le(l, connaissance)
        and demande_liberation_charge_le(l, demande)
        and demande <= add_calendar_period(connaissance, 1 calendar_year)
        and demander_liberation_reserve_1054(l);
    then liberty PouvoirDemanderLiberationReserve {
        holder entity_ref("urn:fr:cc:liberalites:legataire");
        action demander_liberation_reserve_1054(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1055) rule RevocationAvantAcceptationSecond(l: Liberalite) strict { label fr official "Article 1055. La donation graduelle est révocable envers le second gratifié avant notification de son acceptation"; label en unofficial "Article 1055. A successive gift is revocable against the second beneficiary before notice of acceptance"; when liberalite_graduelle(l) and second_gratifie_pas_encore_accepte(l); then revocation_envers_second_gratifie_possible(l); }
pub relation revoquer_donation_avant_acceptation_1055(l: Liberalite) kind empirical {
    label fr official "le disposant révoque la donation graduelle avant acceptation du second gratifié";
    label en unofficial "the donor revokes the successive gift before the second beneficiary accepts";
}
@source(CC_ART1055)
rule PositionPouvoirRevoquerAvantAcceptation(l: Liberalite) strict {
    label fr official "Article 1055. Le disposant peut révoquer avant acceptation du second gratifié";
    label en unofficial "Article 1055. The donor may revoke before the second beneficiary accepts";
    when liberalite_graduelle(l)
        and second_gratifie_pas_encore_accepte(l)
        and revoquer_donation_avant_acceptation_1055(l);
    then liberty PouvoirRevoquerAvantAcceptation {
        holder entity_ref("urn:fr:cc:liberalites:disposant");
        action revoquer_donation_avant_acceptation_1055(l);
        window [@2007-01-01, infinity);
    };
}
@source(CC_ART1056) rule PredecesOuRenonciationSecond(l: Liberalite) strict { label fr official "Article 1056. Au prédécès ou à la renonciation du second, les biens dépendent de la succession du grevé sauf clause contraire"; label en unofficial "Article 1056. On predecease or disclaimer by the second beneficiary, property falls into the first beneficiary's estate absent contrary terms"; when second_gratifie_predecede_ou_renonce(l); then biens_depend_succession_du_greve(l); }
@source(CC_ART1057) rule DefinitionLiberaliteResiduelle(l: Liberalite) strict { label fr official "Article 1057. L'appel à recueillir ce qui subsistera forme une libéralité résiduelle"; label en unofficial "Article 1057. A call to receive what remains forms a residual gift"; when appel_a_recueillir_subsistant(l); then liberalite_residuelle(l); }
@source(CC_ART1058) rule PasReportResiduel(l: Liberalite) strict { label fr official "Article 1058. L'aliénation des biens résiduels ne reporte pas les droits sur le prix ou le remploi"; label en unofficial "Article 1058. Alienation of residual property does not trace rights into proceeds or replacement property"; when liberalite_residuelle(l) and biens_residuels_alienes(l); then aucun_report_sur_prix_ou_remploi(l); }
@source(CC_ART1059) rule TestamentResiduelInterdit(l: Liberalite) strict { label fr official "Article 1059. Le premier gratifié ne peut disposer par testament des biens résiduels"; label en unofficial "Article 1059. The first beneficiary may not dispose of residual property by will"; when liberalite_residuelle(l) and premier_gratifie_dispose_testament_biens_residuels(l); then disposition_residuelle_interdite(l); }
pub relation disposer_testament_biens_residuels_1059(l: Liberalite) kind empirical {
    label fr official "le premier gratifié dispose par testament des biens résiduels";
    label en unofficial "the first beneficiary disposes of residual property by will";
}
@source(CC_ART1059)
rule PositionInterdictionDisposerBiensResiduel(l: Liberalite) strict {
    label fr official "Article 1059. Le premier gratifié ne peut disposer par testament des biens résiduels";
    label en unofficial "Article 1059. The first beneficiary may not dispose of residual property by will";
    when liberalite_residuelle(l);
    then prohibition InterdictionDisposerBiensResiduel {
        bearer entity_ref("urn:fr:cc:liberalites:premier-gratifie");
        action disposer_testament_biens_residuels_1059(l);
        window [@2006-01-01, infinity);
    };
}
@source(CC_ART1059)
rule MaintenanceInterdictionDisposerBiensResiduel(l: Liberalite) strict {
    label fr official "Article 1059. Maintenir l'interdiction de disposer des biens résiduels par testament";
    label en unofficial "Article 1059. Maintain the prohibition on disposing of residual property by will";
    when liberalite_residuelle(l);
    then duty MaintenanceInterdictionDisposerBiensResiduelDuty {
        bearer entity_ref("urn:fr:cc:liberalites:premier-gratifie");
        goal maintenance {
            condition not disposer_testament_biens_residuels_1059(l);
            window [@2006-01-01, infinity);
        };
    };
}
@source(CC_ART1060) rule PasCompteGestion(l: Liberalite) strict { label fr official "Article 1060. Le premier gratifié ne rend pas compte de sa gestion"; label en unofficial "Article 1060. The first beneficiary need not account for management"; when liberalite_residuelle(l) and gestion_premier_gratifie(l); then aucun_compte_gestion_du(l); }
pub relation ne_pas_rendre_compte_gestion_1060(l: Liberalite) kind empirical { label fr official "le premier gratifié ne rend pas compte de sa gestion"; label en unofficial "the first beneficiary does not render an account of management"; }
@source(CC_ART1060)
rule PositionPouvoirNePasRendreCompteGestion(l: Liberalite) strict {
    label fr official "Article 1060. Le premier gratifié peut ne pas rendre compte de sa gestion";
    label en unofficial "Article 1060. The first beneficiary may refrain from accounting for management";
    when liberalite_residuelle(l) and gestion_premier_gratifie(l)
        and ne_pas_rendre_compte_gestion_1060(l);
    then liberty PouvoirNePasRendreCompteGestion {
        holder entity_ref("urn:fr:cc:liberalites:premier-gratifie");
        action ne_pas_rendre_compte_gestion_1060(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1061) rule RenvoiReglesGraduelles(l: Liberalite) strict { label fr official "Article 1061. Les règles désignées des libéralités graduelles s'appliquent aux résiduelles"; label en unofficial "Article 1061. The specified successive-gift rules apply to residual gifts"; when liberalite_residuelle(l); then regles_graduelles_etendues_residuelles(l); }
