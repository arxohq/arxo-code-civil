// CHAPITRE V — TESTAMENTS SPÉCIAUX ET TESTAMENTS À L'ÉTRANGER (981 à 1001).

language "law.core" version "0.2";
package fr.code_civil.liberalites version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-liberalites";

use self::{
    CC_ART1000,
    CC_ART1001,
    CC_ART981,
    CC_ART982,
    CC_ART983,
    CC_ART984,
    CC_ART985,
    CC_ART986,
    CC_ART987,
    CC_ART988,
    CC_ART989,
    CC_ART990,
    CC_ART991,
    CC_ART992,
    CC_ART993,
    CC_ART994,
    CC_ART995,
    CC_ART996,
    CC_ART997,
    CC_ART998,
    CC_ART999,
    Liberalite,
    disposition_testamentaire_valable,
    liberalite_nulle,
};

pub relation testateur_militaire_marin_ou_suite_armee(l: Liberalite) kind empirical { label fr official "le testateur est militaire, marin de l'État ou employé à la suite des armées"; label en unofficial "the testator is military personnel, a state sailor or attached to the armed forces"; }
pub relation testament_militaire_recu_par_autorite_et_temoins_requis(l: Liberalite) kind empirical { label fr official "le testament militaire est reçu par l'autorité et les témoins requis"; label en unofficial "the military will is received by the required authority and witnesses"; }
pub relation prisonnier_chez_ennemi(l: Liberalite) kind empirical { label fr official "le testateur est prisonnier chez l'ennemi"; label en unofficial "the testator is a prisoner of the enemy"; }
pub relation malade_ou_blesse_hopital_militaire(l: Liberalite) kind empirical { label fr official "le testateur est malade ou blessé dans une formation sanitaire militaire"; label en unofficial "the testator is ill or wounded in a military medical facility"; }
pub relation testament_recu_medecin_chef_et_gestionnaire_ou_temoins(l: Liberalite) kind empirical { label fr official "le testament est reçu par le médecin-chef avec le gestionnaire ou deux témoins"; label en unofficial "the will is received by the chief physician with the administrator or two witnesses"; }
pub relation double_original_ou_expedition_justifiee(l: Liberalite) kind empirical { label fr official "deux originaux sont établis ou une expédition justifiée remplace le second"; label en unofficial "two originals are made or a justified copy replaces the second"; }
pub relation testament_special_valable(l: Liberalite) kind derived { label fr official "testament spécial valable à la date d'appréciation"; label en unofficial "special will valid on the assessment date"; }
pub relation liberte_formes_ordinaires_le(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date à laquelle le testateur retrouve la liberté d'employer les formes ordinaires"; label en unofficial "date on which the testator regains freedom to use ordinary forms"; }
pub relation communications_retablies_le(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date du rétablissement des communications"; label en unofficial "date communications were restored"; }
pub relation debarquement_possible_formes_ordinaires_le(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date du débarquement en un lieu permettant les formes ordinaires"; label en unofficial "date of disembarkation at a place permitting ordinary forms"; }
pub relation date_appreciation_testament(l: Liberalite, jour: Date) kind empirical { key(l); label fr official "date d'appréciation de la validité du testament"; label en unofficial "date on which validity of the will is assessed"; }
pub relation nouveau_voyage_ou_situation_speciale_avant_echeance(l: Liberalite) kind empirical { label fr official "une nouvelle situation spéciale ou un nouveau voyage commence avant l'échéance"; label en unofficial "a new special situation or voyage begins before expiry"; }
pub relation lieu_isole_par_maladie_contagieuse(l: Liberalite) kind empirical { label fr official "le lieu est privé de toute communication par maladie contagieuse"; label en unofficial "the place has no communication because of contagious disease"; }
pub relation testament_recu_juge_ou_officier_municipal_deux_temoins(l: Liberalite) kind empirical { label fr official "le testament est reçu par le juge ou l'officier municipal avec deux témoins"; label en unofficial "the will is received by the judge or municipal officer with two witnesses"; }
pub relation ile_sans_office_notarial_et_communications_impossibles(l: Liberalite) kind empirical { label fr official "l'île française est sans office notarial et sans communication possible"; label en unofficial "the French island has no notarial office and communication is impossible"; }
pub relation voyage_maritime_sans_communication_ou_notariat_consulaire(l: Liberalite) kind empirical { label fr official "le voyage maritime ne permet ni communication terrestre ni fonction notariale consulaire"; label en unofficial "the sea voyage permits neither land communication nor consular notarial service"; }
pub relation testament_maritime_recu_autorite_et_deux_temoins(l: Liberalite) kind empirical { label fr official "le testament maritime est reçu par l'autorité de bord compétente avec deux témoins"; label en unofficial "the maritime will is received by the competent shipboard authority with two witnesses"; }
pub relation depot_consulaire_ou_ministeriel_effectue(l: Liberalite) kind empirical { label fr official "les originaux ou l'expédition ont été remis au consulat ou déposés au ministère compétent"; label en unofficial "the originals or copy were delivered to the consulate or deposited with the competent ministry"; }
pub relation remise_mentionnee_livre_de_bord(l: Liberalite) kind empirical { label fr official "la remise est mentionnée au livre de bord"; label en unofficial "delivery is entered in the ship's log"; }
pub relation legs_au_profit_officier_non_parent(l: Liberalite) kind empirical { label fr official "le testament maritime gratifie un officier du bâtiment qui n'est ni parent ni allié"; label en unofficial "the maritime will benefits a ship's officer who is not a relative or in-law"; }
pub relation lecture_regle_expiration_mentionnee(l: Liberalite) kind empirical { label fr official "la règle d'expiration applicable est lue et cette lecture est mentionnée"; label en unofficial "the applicable expiry rule is read and the reading is recorded"; }
pub relation signatures_speciales_conformes(l: Liberalite) kind empirical { label fr official "le testateur, l'autorité instrumentaire et les témoins requis signent"; label en unofficial "the testator, receiving authority and required witnesses sign"; }
pub relation impossibilite_signature_et_cause_mentionnees(l: Liberalite) kind empirical { label fr official "l'impossibilité de signer et sa cause sont mentionnées, avec au moins un témoin signataire"; label en unofficial "inability to sign and its cause are recorded, with at least one witness signing"; }
pub relation francais_testant_a_etranger_forme_locale_ou_olographe(l: Liberalite) kind empirical { label fr official "le Français à l'étranger teste selon l'article 970 ou selon la forme authentique locale"; label en unofficial "a French national abroad makes a will under Article 970 or the local authentic form"; }
pub relation testament_etranger_enregistre_domicile_et_situation(l: Liberalite) kind empirical { label fr official "le testament étranger est enregistré au domicile requis et, pour l'immeuble, au lieu de situation"; label en unofficial "the foreign will is registered at the required domicile and, for immovables, at their location"; }
pub relation formalite_testamentaire_omise(l: Liberalite) kind empirical { label fr official "une formalité imposée par les sections des testaments est omise"; label en unofficial "a formality required by the sections on wills is omitted"; }

@source(CC_ART981) { rule TestamentMilitaireAutoriteCompetente(l: Liberalite) strict { label fr official "Article 981, alinéas 1 et 2. Le testament militaire est reçu par l'autorité compétente avec les témoins requis"; label en unofficial "Article 981, paragraphs 1 and 2. A military will is received by the competent authority with required witnesses"; when testateur_militaire_marin_ou_suite_armee(l) and testament_militaire_recu_par_autorite_et_temoins_requis(l); then testament_special_valable(l); } rule PrisonnierMemeFaculte(l: Liberalite) strict { label fr official "Article 981, alinéa 3. Le prisonnier chez l'ennemi bénéficie de la même faculté"; label en unofficial "Article 981, paragraph 3. A prisoner of the enemy has the same facility"; when prisonnier_chez_ennemi(l) and testament_militaire_recu_par_autorite_et_temoins_requis(l); then testament_special_valable(l); } }
pub relation recevoir_testament_militaire_981(l: Liberalite) kind empirical { label fr official "l'autorité reçoit le testament militaire avec les témoins requis"; label en unofficial "the authority receives the military will with required witnesses"; }
@source(CC_ART981)
rule PositionDevoirRecevoirTestamentMilitaire(l: Liberalite) strict {
    label fr official "Article 981. L'autorité doit recevoir le testament militaire";
    label en unofficial "Article 981. The authority must receive the military will";
    when testateur_militaire_marin_ou_suite_armee(l);
    then duty DevoirRecevoirTestamentMilitaire {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-militaire");
        goal achievement {
            condition recevoir_testament_militaire_981(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART982) rule TestamentHopitalMilitaire(l: Liberalite) strict { label fr official "Article 982. Le malade ou blessé en formation militaire teste devant le médecin-chef et le gestionnaire ou deux témoins"; label en unofficial "Article 982. An ill or wounded person in a military facility makes a will before the chief physician and administrator or two witnesses"; when malade_ou_blesse_hopital_militaire(l) and testament_recu_medecin_chef_et_gestionnaire_ou_temoins(l); then testament_special_valable(l); }
pub relation recevoir_testament_hopital_982(l: Liberalite) kind empirical { label fr official "le médecin-chef reçoit le testament avec le gestionnaire ou les témoins requis"; label en unofficial "the chief physician receives the will with the administrator or required witnesses"; }
@source(CC_ART982)
rule PositionDevoirRecevoirTestamentHopital(l: Liberalite) strict {
    label fr official "Article 982. Le médecin-chef doit recevoir le testament";
    label en unofficial "Article 982. The chief physician must receive the will";
    when malade_ou_blesse_hopital_militaire(l);
    then duty DevoirRecevoirTestamentHopital {
        bearer entity_ref("urn:fr:cc:liberalites:medecin-chef");
        goal achievement {
            condition recevoir_testament_hopital_982(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART983) rule DoubleOriginalMilitaire(l: Liberalite) strict { label fr official "Article 983. Le testament militaire est établi en deux originaux ou avec une expédition substitutive justifiée"; label en unofficial "Article 983. A military will is made in two originals or with a justified substitute copy"; when testament_militaire_recu_par_autorite_et_temoins_requis(l) and double_original_ou_expedition_justifiee(l); then testament_special_valable(l); }
pub relation etablir_double_original_militaire_983(l: Liberalite) kind empirical { label fr official "l'autorité établit deux originaux du testament militaire"; label en unofficial "the authority makes two originals of the military will"; }
@source(CC_ART983)
rule PositionDevoirEtablirDoubleOriginalMilitaire(l: Liberalite) strict {
    label fr official "Article 983. L'autorité doit établir deux originaux";
    label en unofficial "Article 983. The authority must make two originals";
    when testament_militaire_recu_par_autorite_et_temoins_requis(l);
    then duty DevoirEtablirDoubleOriginalMilitaire {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-militaire");
        goal achievement { condition etablir_double_original_militaire_983(l); window [@1804-01-01, infinity); };
    };
}
@source(CC_ART984) { rule TestamentMilitaireSixMois(l: Liberalite, retour: Date, examen: Date) strict { label fr official "Article 984. Le testament spécial demeure valable pendant six mois après le retour aux formes ordinaires"; label en unofficial "Article 984. The special will remains valid for six months after return to ordinary forms"; when liberte_formes_ordinaires_le(l, retour) and date_appreciation_testament(l, examen) and examen <= add_calendar_period(retour, 6 calendar_month); then testament_special_valable(l); } rule NouvelleSituationProlonge(l: Liberalite) strict { label fr official "Article 984. Une nouvelle situation spéciale avant l'échéance prolonge la validité"; label en unofficial "Article 984. A new special situation before expiry extends validity"; when nouveau_voyage_ou_situation_speciale_avant_echeance(l); then testament_special_valable(l); } }
@source(CC_ART985) rule TestamentMaladieContagieuse(l: Liberalite) strict { label fr official "Article 985. Dans un lieu isolé par maladie contagieuse, le juge ou l'officier municipal reçoit le testament avec deux témoins"; label en unofficial "Article 985. In a place isolated by contagious disease, the judge or municipal officer receives the will with two witnesses"; when lieu_isole_par_maladie_contagieuse(l) and testament_recu_juge_ou_officier_municipal_deux_temoins(l); then testament_special_valable(l); }
pub relation recevoir_testament_isolement_985(l: Liberalite) kind empirical { label fr official "le juge ou l'officier municipal reçoit le testament avec deux témoins"; label en unofficial "the judge or municipal officer receives the will with two witnesses"; }
@source(CC_ART985)
rule PositionDevoirRecevoirTestamentIsolement(l: Liberalite) strict {
    label fr official "Article 985. Le juge ou l'officier municipal doit recevoir le testament";
    label en unofficial "Article 985. The judge or municipal officer must receive the will";
    when lieu_isole_par_maladie_contagieuse(l);
    then duty DevoirRecevoirTestamentIsolement {
        bearer entity_ref("urn:fr:cc:liberalites:juge-ou-officier");
        goal achievement {
            condition recevoir_testament_isolement_985(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART986) rule TestamentIleSansNotaire(l: Liberalite) strict { label fr official "Article 986. Sur une île sans notaire et sans communication, le testament suit la forme de l'article 985"; label en unofficial "Article 986. On an island without a notary and without communication, the will follows Article 985 form"; when ile_sans_office_notarial_et_communications_impossibles(l) and testament_recu_juge_ou_officier_municipal_deux_temoins(l); then testament_special_valable(l); }
@source(CC_ART987) rule TestamentIsolementSixMois(l: Liberalite, retour: Date, examen: Date) strict { label fr official "Article 987. Le testament d'isolement demeure valable six mois après le rétablissement des communications"; label en unofficial "Article 987. An isolation will remains valid for six months after communications are restored"; when communications_retablies_le(l, retour) and date_appreciation_testament(l, examen) and examen <= add_calendar_period(retour, 6 calendar_month); then testament_special_valable(l); }
@source(CC_ART988) rule TestamentMaritimeRecu(l: Liberalite) strict { label fr official "Article 988. En voyage sans communication ou notariat consulaire, l'autorité de bord reçoit le testament avec deux témoins"; label en unofficial "Article 988. During a voyage without communication or consular notarial service, the shipboard authority receives the will with two witnesses"; when voyage_maritime_sans_communication_ou_notariat_consulaire(l) and testament_maritime_recu_autorite_et_deux_temoins(l); then testament_special_valable(l); }
pub relation recevoir_testament_maritime_988(l: Liberalite) kind empirical { label fr official "l'autorité de bord reçoit le testament maritime avec deux témoins"; label en unofficial "the shipboard authority receives the maritime will with two witnesses"; }
@source(CC_ART988)
rule PositionDevoirRecevoirTestamentMaritime(l: Liberalite) strict {
    label fr official "Article 988. L'autorité de bord doit recevoir le testament maritime";
    label en unofficial "Article 988. The shipboard authority must receive the maritime will";
    when voyage_maritime_sans_communication_ou_notariat_consulaire(l);
    then duty DevoirRecevoirTestamentMaritime {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-de-bord");
        goal achievement {
            condition recevoir_testament_maritime_988(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART989) rule TestamentOfficierDeBord(l: Liberalite) strict { label fr official "Article 989. Le testament de l'officier de bord est reçu par son remplaçant dans l'ordre du service"; label en unofficial "Article 989. A shipboard officer's will is received by the next officer in service order"; when voyage_maritime_sans_communication_ou_notariat_consulaire(l) and testament_maritime_recu_autorite_et_deux_temoins(l); then testament_special_valable(l); }
pub relation recevoir_testament_officier_989(l: Liberalite) kind empirical { label fr official "le remplaçant reçoit le testament de l'officier de bord"; label en unofficial "the successor officer receives the shipboard officer's will"; }
pub relation testateur_officier_ou_commandant_du_bord(l: Liberalite) kind empirical { label fr official "le testateur est l'officier d'administration, le commandant, le capitaine, maître, patron ou second du bâtiment"; label en unofficial "the testator is the administrative officer, commander, captain, master, skipper or second of the vessel"; }
@source(CC_ART989)
rule PositionDevoirRecevoirTestamentOfficier(l: Liberalite) strict {
    label fr official "Article 989. Le remplaçant doit recevoir le testament de l'officier";
    label en unofficial "Article 989. The successor officer must receive the officer's will";
    when voyage_maritime_sans_communication_ou_notariat_consulaire(l) and testateur_officier_ou_commandant_du_bord(l);
    then duty DevoirRecevoirTestamentOfficier {
        bearer entity_ref("urn:fr:cc:liberalites:officier-remplacant");
        goal achievement {
            condition recevoir_testament_officier_989(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART990) rule DoubleOriginalMaritime(l: Liberalite) strict { label fr official "Article 990. Le testament maritime est établi en deux originaux ou avec une expédition substitutive justifiée"; label en unofficial "Article 990. A maritime will is made in two originals or with a justified substitute copy"; when testament_maritime_recu_autorite_et_deux_temoins(l) and double_original_ou_expedition_justifiee(l); then testament_special_valable(l); }
pub relation etablir_double_original_maritime_990(l: Liberalite) kind empirical { label fr official "le testament maritime est établi en deux originaux ou avec une expédition justifiée"; label en unofficial "the maritime will is made in two originals or with a justified copy"; }
@source(CC_ART990)
rule PositionDevoirEtablirDoubleOriginalMaritime(l: Liberalite) strict {
    label fr official "Article 990. L'autorité doit établir deux originaux du testament maritime";
    label en unofficial "Article 990. The authority must make two originals of the maritime will";
    when testament_maritime_recu_autorite_et_deux_temoins(l);
    then duty DevoirEtablirDoubleOriginalMaritime {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-de-bord");
        goal achievement {
            condition etablir_double_original_maritime_990(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART991, CC_ART992) rule DepotTestamentMaritime(l: Liberalite) strict { label fr official "Articles 991 et 992. Les originaux ou l'expédition sont remis au consulat ou au ministère compétent"; label en unofficial "Articles 991 and 992. The originals or copy are delivered to the consulate or competent ministry"; when depot_consulaire_ou_ministeriel_effectue(l); then testament_special_valable(l); }
pub relation deposer_testament_maritime_991_992(l: Liberalite) kind empirical { label fr official "l'autorité dépose les originaux ou l'expédition au consulat ou au ministère"; label en unofficial "the authority deposits the originals or copy with the consulate or ministry"; }
@source(CC_ART991, CC_ART992)
rule PositionDevoirDeposerTestamentMaritime(l: Liberalite) strict {
    label fr official "Articles 991 et 992. L'autorité doit déposer le testament maritime";
    label en unofficial "Articles 991 and 992. The authority must deposit the maritime will";
    when testament_maritime_recu_autorite_et_deux_temoins(l);
    then duty DevoirDeposerTestamentMaritime {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-de-bord");
        goal achievement {
            condition deposer_testament_maritime_991_992(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART993) rule MentionLivreDeBord(l: Liberalite) strict { label fr official "Article 993. La remise du testament est mentionnée au livre de bord"; label en unofficial "Article 993. Delivery of the will is entered in the ship's log"; when remise_mentionnee_livre_de_bord(l); then testament_special_valable(l); }
pub relation mentionner_remise_livre_bord_993(l: Liberalite) kind empirical { label fr official "l'autorité mentionne la remise du testament au livre de bord"; label en unofficial "the authority records delivery of the will in the ship's log"; }
@source(CC_ART993)
rule PositionDevoirMentionnerRemiseLivre(l: Liberalite) strict {
    label fr official "Article 993. L'autorité doit mentionner la remise au livre de bord";
    label en unofficial "Article 993. The authority must record delivery in the ship's log";
    when testament_maritime_recu_autorite_et_deux_temoins(l);
    then duty DevoirMentionnerRemiseLivre {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-de-bord");
        goal achievement {
            condition mentionner_remise_livre_bord_993(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART994) { rule TestamentMaritimeSixMois(l: Liberalite, debarquement: Date, examen: Date) strict { label fr official "Article 994, alinéa 1. Le testament maritime demeure valable jusqu'à six mois après le débarquement permettant les formes ordinaires"; label en unofficial "Article 994, paragraph 1. A maritime will remains valid through six months after disembarkation permitting ordinary forms"; when debarquement_possible_formes_ordinaires_le(l, debarquement) and date_appreciation_testament(l, examen) and examen <= add_calendar_period(debarquement, 6 calendar_month); then testament_special_valable(l); } rule NouveauVoyageProlonge(l: Liberalite) strict { label fr official "Article 994, alinéa 2. Un nouveau voyage avant l'échéance prolonge la validité"; label en unofficial "Article 994, paragraph 2. A new voyage before expiry extends validity"; when nouveau_voyage_ou_situation_speciale_avant_echeance(l); then testament_special_valable(l); } }
@source(CC_ART995) rule LegsOfficierNonParentNul(l: Liberalite) strict { label fr official "Article 995. Le legs maritime à un officier non parent ni allié est nul, quelle que soit la forme"; label en unofficial "Article 995. A maritime legacy to an officer who is not a relative or in-law is void whatever the form"; when legs_au_profit_officier_non_parent(l); then liberalite_nulle(l); }
pub relation consentir_legs_officier_non_parent_995(l: Liberalite) kind empirical { label fr official "le testateur consent un legs maritime à un officier non parent ou allié"; label en unofficial "the testator makes a maritime legacy to a non-relative officer"; }
@source(CC_ART995)
rule PositionInterdictionLegsOfficierNonParent(l: Liberalite) strict {
    label fr official "Article 995. Le testateur ne peut léguer à un officier non parent";
    label en unofficial "Article 995. The testator may not make a legacy to a non-relative officer";
    when legs_au_profit_officier_non_parent(l);
    then prohibition InterdictionLegsOfficierNonParent {
        bearer entity_ref("urn:fr:cc:liberalites:testateur");
        action consentir_legs_officier_non_parent_995(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART995)
rule PositionDevoirMaintenirInterdictionLegsOfficier(l: Liberalite) strict {
    label fr official "Article 995. Devoir de maintenir l'interdiction du legs à l'officier";
    label en unofficial "Article 995. Duty to maintain the prohibition on a legacy to an officer";
    when legs_au_profit_officier_non_parent(l);
    then duty MaintenirInterdictionLegsOfficier {
        bearer entity_ref("urn:fr:cc:liberalites:testateur");
        goal achievement { condition consentir_legs_officier_non_parent_995(l); window [@1804-01-01, infinity); };
    };
}
@source(CC_ART996) rule LectureRegleExpiration(l: Liberalite) strict { label fr official "Article 996. La règle d'expiration applicable est lue au testateur et la lecture est mentionnée"; label en unofficial "Article 996. The applicable expiry rule is read to the testator and the reading is recorded"; when lecture_regle_expiration_mentionnee(l); then testament_special_valable(l); }
pub relation lire_regle_expiration_996(l: Liberalite) kind empirical { label fr official "l'autorité lit et mentionne la règle d'expiration applicable"; label en unofficial "the authority reads and records the applicable expiry rule"; }
pub relation testament_special_a_recevoir(l: Liberalite) kind empirical { label fr official "un testament militaire, d'hôpital, d'isolement ou maritime est à recevoir"; label en unofficial "a military, hospital, isolation or maritime will is to be received"; }
@source(CC_ART996)
rule PositionDevoirLireRegleExpiration(l: Liberalite) strict {
    label fr official "Article 996. L'autorité doit lire la règle d'expiration";
    label en unofficial "Article 996. The authority must read the expiry rule";
    when testament_special_a_recevoir(l);
    then duty DevoirLireRegleExpiration {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-instrumentaire");
        goal achievement {
            condition lire_regle_expiration_996(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART997) rule SignaturesTestamentSpecial(l: Liberalite) strict { label fr official "Article 997. Le testateur, l'autorité instrumentaire et les témoins signent"; label en unofficial "Article 997. The testator, receiving authority and witnesses sign"; when signatures_speciales_conformes(l); then testament_special_valable(l); }
pub relation signer_testament_special_997(l: Liberalite) kind empirical { label fr official "le testateur, l'autorité et les témoins signent le testament spécial"; label en unofficial "the testator, authority and witnesses sign the special will"; }
@source(CC_ART997)
rule PositionDevoirSignerTestamentSpecial(l: Liberalite) strict {
    label fr official "Article 997. Les personnes requises doivent signer le testament";
    label en unofficial "Article 997. The required persons must sign the will";
    when testament_special_a_recevoir(l);
    then duty DevoirSignerTestamentSpecial {
        bearer entity_ref("urn:fr:cc:liberalites:signataires-requis");
        goal achievement {
            condition signer_testament_special_997(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART998) rule MentionImpossibiliteSigner(l: Liberalite) strict { label fr official "Article 998. L'impossibilité de signer et sa cause sont mentionnées et au moins un témoin signe"; label en unofficial "Article 998. Inability to sign and its cause are recorded and at least one witness signs"; when impossibilite_signature_et_cause_mentionnees(l); then testament_special_valable(l); }
pub relation mentionner_impossibilite_signature_998(l: Liberalite) kind empirical { label fr official "l'autorité mentionne l'impossibilité de signer et sa cause"; label en unofficial "the authority records inability to sign and its cause"; }
pub relation testateur_declare_ne_pouvoir_ou_savoir_signer(l: Liberalite) kind empirical { label fr official "le testateur déclare qu'il ne peut ou ne sait signer"; label en unofficial "the testator declares that he cannot or does not know how to sign"; }
@source(CC_ART998)
rule PositionDevoirMentionnerImpossibiliteSignature(l: Liberalite) strict {
    label fr official "Article 998. L'autorité doit mentionner l'impossibilité de signer";
    label en unofficial "Article 998. The authority must record inability to sign";
    when testament_special_a_recevoir(l) and testateur_declare_ne_pouvoir_ou_savoir_signer(l);
    then duty DevoirMentionnerImpossibiliteSignature {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-instrumentaire");
        goal achievement {
            condition mentionner_impossibilite_signature_998(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART999) rule FrancaisTestantAEtranger(l: Liberalite) strict { label fr official "Article 999. Le Français à l'étranger peut tester par écrit privé olographe ou par acte authentique local"; label en unofficial "Article 999. A French national abroad may make a holographic private will or a local authentic will"; when francais_testant_a_etranger_forme_locale_ou_olographe(l); then disposition_testamentaire_valable(l); }
pub relation tester_francais_etranger_999(l: Liberalite) kind empirical { label fr official "le Français à l'étranger teste selon une forme admise"; label en unofficial "the French national abroad makes a will in an admitted form"; }
@source(CC_ART999)
rule PositionPouvoirTesterFrancaisEtranger(l: Liberalite) strict {
    label fr official "Article 999. Le Français à l'étranger peut tester";
    label en unofficial "Article 999. A French national abroad may make a will";
    when francais_testant_a_etranger_forme_locale_ou_olographe(l)
        and tester_francais_etranger_999(l);
    then liberty PouvoirTesterFrancaisEtranger {
        holder entity_ref("urn:fr:cc:liberalites:francais-etranger");
        action tester_francais_etranger_999(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1000) rule EnregistrementTestamentEtranger(l: Liberalite) strict { label fr official "Article 1000. Le testament étranger est enregistré au domicile requis et, pour les immeubles français, au lieu de situation"; label en unofficial "Article 1000. A foreign will is registered at the required domicile and, for French immovables, at their location"; when testament_etranger_enregistre_domicile_et_situation(l); then disposition_testamentaire_valable(l); }
pub relation enregistrer_testament_etranger_1000(l: Liberalite) kind empirical { label fr official "le testament étranger est enregistré au domicile requis et au lieu de situation"; label en unofficial "the foreign will is registered at the required domicile and location"; }
pub relation testament_fait_en_pays_etranger(l: Liberalite) kind empirical { label fr official "un testament a été fait en pays étranger et doit être exécuté sur des biens situés en France"; label en unofficial "a will was made abroad and is to be executed on property located in France"; }
@source(CC_ART1000)
rule PositionDevoirEnregistrerTestamentEtranger(l: Liberalite) strict {
    label fr official "Article 1000. Le testament étranger doit être enregistré";
    label en unofficial "Article 1000. The foreign will must be registered";
    when testament_fait_en_pays_etranger(l);
    then duty DevoirEnregistrerTestamentEtranger {
        bearer entity_ref("urn:fr:cc:liberalites:autorite-enregistrement");
        goal achievement {
            condition enregistrer_testament_etranger_1000(l);
            window [@1804-01-01, infinity);
        };
    };
}
@source(CC_ART1001) rule OmissionFormalitesRendNul(l: Liberalite) strict { label fr official "Article 1001. L'omission d'une formalité imposée aux testaments entraîne la nullité"; label en unofficial "Article 1001. Omission of a required testamentary formality entails nullity"; when formalite_testamentaire_omise(l); then liberalite_nulle(l); }
pub relation omettre_formalite_testamentaire_1001(l: Liberalite) kind empirical { label fr official "une partie omet une formalité testamentaire imposée"; label en unofficial "a party omits a required testamentary formality"; }
@source(CC_ART1001)
rule PositionInterdictionOmettreFormaliteTestamentaire(l: Liberalite) strict {
    label fr official "Article 1001. Une partie ne peut omettre une formalité testamentaire";
    label en unofficial "Article 1001. A party may not omit a required testamentary formality";
    when formalite_testamentaire_omise(l);
    then prohibition InterdictionOmettreFormaliteTestamentaire {
        bearer entity_ref("urn:fr:cc:liberalites:partie");
        action omettre_formalite_testamentaire_1001(l);
        window [@1804-01-01, infinity);
    };
}
@source(CC_ART1001)
rule PositionDevoirMaintenirFormaliteTestamentaire(l: Liberalite) strict {
    label fr official "Article 1001. Devoir de maintenir les formalités testamentaires";
    label en unofficial "Article 1001. Duty to maintain testamentary formalities";
    when formalite_testamentaire_omise(l);
    then duty MaintenirFormaliteTestamentaire {
        bearer entity_ref("urn:fr:cc:liberalites:partie");
        goal achievement { condition omettre_formalite_testamentaire_1001(l); window [@1804-01-01, infinity); };
    };
}
