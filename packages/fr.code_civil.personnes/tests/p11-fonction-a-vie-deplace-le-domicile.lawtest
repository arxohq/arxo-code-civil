language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 107 : l acceptation de fonctions à vie emporte translation immédiate du domicile.
test "urn:query:fr-code-civil-personnes-p11-fonction-a-vie-deplace-le-domicile" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:pers:g:p"), @1980-01-01) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:pers:g:p"), @2026-03-15) { origin case_input; }
        assert "f3": fonction_a_vie_exercee_a(entity_ref("urn:fr:cc:pers:g:p"), entity_ref("urn:fr:cc:pers:g:paris")) { origin case_input; }
    }
    evaluate truth(domicile(entity_ref("urn:fr:cc:pers:g:p"), entity_ref("urn:fr:cc:pers:g:paris")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DomicileDesFonctionsAVie);
}
