language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 413-2 : l émancipation judiciaire suppose seize ans révolus ; à quinze ans, la condition d âge n est pas remplie.
test "urn:query:fr-code-civil-personnes-p03-seize-ans-requis" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:pers:e:p"), @2010-06-01) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:pers:e:p"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(age_requis_pour_l_emancipation(entity_ref("urn:fr:cc:pers:e:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
