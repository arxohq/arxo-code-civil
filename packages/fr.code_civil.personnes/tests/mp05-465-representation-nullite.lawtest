language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 465(3): omission of required representation is void without proof of loss.
test "urn:query:fr-code-civil-personnes-mp05-465-representation-nullite" {
    given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; } assert "f1": categorie_acte_465(entity_ref("urn:fr:cc:personnes:mp05:a"), RepresentationRequise) { origin adjudicated; } }
    evaluate truth(sanction_nullite_de_plein_droit(entity_ref("urn:fr:cc:personnes:mp05:a")));
    expect truth_status == TRUE_ONLY;
    expect applied(RepresentationOmissionNullite);
}
