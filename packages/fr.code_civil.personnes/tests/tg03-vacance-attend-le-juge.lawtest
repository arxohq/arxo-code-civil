language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 411: vacancy depends on the court's finding that guardianship cannot be organized.
test "urn:query:fr-code-civil-personnes-tg03-vacance-attend-le-juge" {
    given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; } }
    evaluate truth(tutelle_vacante(entity_ref("urn:fr:cc:personnes:tg03:p")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(impossibilite_d_organiser_la_tutelle, Court);
}
