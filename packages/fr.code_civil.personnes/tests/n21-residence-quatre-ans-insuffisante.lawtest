language "law.core" version "0.2"; package fr.code_civil.personnes version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-personnes";
// Article 21-7: four years of residence since age eleven do not satisfy the five-year threshold.
test "urn:query:fr-cc-personnes-n21" { given { context { decision_time @2026-01-01T09:00:00Z; knowledge_time @2026-01-01T09:00:00Z; legal_time @2026-01-01; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; } assert "f1": ne_en_france(entity_ref("urn:fr:cc:n21:p")) { origin case_input; } assert "f2": ne_le(entity_ref("urn:fr:cc:n21:p"), @2008-01-01) { origin case_input; } assert "f3": date_d_appreciation(entity_ref("urn:fr:cc:n21:p"), @2026-01-01) { origin case_input; } assert "f4": annees_residence_france_depuis_onze_ans(entity_ref("urn:fr:cc:n21:p"), 4) { origin case_input; } } evaluate truth(acquisition_a_majorite_admissible(entity_ref("urn:fr:cc:n21:p"))); expect truth_status == NEITHER; }
