language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 128 : le jugement déclaratif transcrit le 12 janvier 2026 emporte les effets du décès à partir de cette date.
test "urn:query:fr-code-civil-personnes-p21-effets-du-deces-depuis-la-transcription" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": jugement_declaratif_transcrit_le(entity_ref("urn:fr:cc:pers:d2:p"), @2026-01-12) { origin case_input; }
    }
    evaluate truth(effets_du_deces(entity_ref("urn:fr:cc:pers:d2:p"), @2026-01-12));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
