language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 108-2 : le mineur non émancipé est domicilié chez le parent avec lequel il réside.
test "urn:query:fr-code-civil-personnes-p08-domicile-du-mineur" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:pers:d:enfant"), @2015-01-01) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:pers:d:enfant"), @2026-03-15) { origin case_input; }
        assert "f3": parent_de(entity_ref("urn:fr:cc:pers:d:mere"), entity_ref("urn:fr:cc:pers:d:enfant")) { origin case_input; }
        assert "f4": reside_avec(entity_ref("urn:fr:cc:pers:d:enfant"), entity_ref("urn:fr:cc:pers:d:mere")) { origin case_input; }
        assert "f5": principal_etablissement(entity_ref("urn:fr:cc:pers:d:mere"), entity_ref("urn:fr:cc:pers:d:lyon")) { origin case_input; }
    }
    evaluate truth(domicile(entity_ref("urn:fr:cc:pers:d:enfant"), entity_ref("urn:fr:cc:pers:d:lyon")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DomicileDuMineurNonEmancipe);
}
