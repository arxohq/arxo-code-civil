language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DECHARGEAPRESCINQANS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": titulaire_non_excepte_article_453(entity_ref("urn:law:catalog:dechargeaprescinqans:v0"), entity_ref("urn:law:catalog:dechargeaprescinqans:v1")) { origin case_input; }
        assert "cat-1": charge_exercee_depuis_cinq_ans(entity_ref("urn:law:catalog:dechargeaprescinqans:v0"), entity_ref("urn:law:catalog:dechargeaprescinqans:v1")) { origin case_input; }
    }
    evaluate truth(decharge_charge_protection_admissible(entity_ref("urn:law:catalog:dechargeaprescinqans:v0"), entity_ref("urn:law:catalog:dechargeaprescinqans:v1")));
    expect truth_status == TRUE_ONLY;
}
