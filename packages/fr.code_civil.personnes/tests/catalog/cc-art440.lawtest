language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CURATELLEADMISSIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": sauvegarde_insuffisante_440(entity_ref("urn:law:catalog:curatelleadmissible:v0")) { origin case_input; }
        assert "cat-1": condition_de_protection_remplie(entity_ref("urn:law:catalog:curatelleadmissible:v0")) { origin case_input; }
        assert "cat-2": besoin_assistance_continue_440(entity_ref("urn:law:catalog:curatelleadmissible:v0")) { origin case_input; }
    }
    evaluate truth(curatelle_admissible(entity_ref("urn:law:catalog:curatelleadmissible:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-TUTELLEMAJEURADMISSIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": curatelle_insuffisante_440(entity_ref("urn:law:catalog:tutellemajeuradmissible:v0")) { origin case_input; }
        assert "cat-1": condition_de_protection_remplie(entity_ref("urn:law:catalog:tutellemajeuradmissible:v0")) { origin case_input; }
        assert "cat-2": besoin_representation_continue_440(entity_ref("urn:law:catalog:tutellemajeuradmissible:v0")) { origin case_input; }
    }
    evaluate truth(tutelle_majeur_admissible(entity_ref("urn:law:catalog:tutellemajeuradmissible:v0")));
    expect truth_status == TRUE_ONLY;
}
