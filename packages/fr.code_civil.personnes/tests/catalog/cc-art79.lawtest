language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DECESSANSCONJOINT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": deces_mention_identite_defunt(entity_ref("urn:law:catalog:decessansconjoint:v0")) { origin case_input; }
        assert "cat-1": deces_mention_parents(entity_ref("urn:law:catalog:decessansconjoint:v0")) { origin case_input; }
        assert "cat-2": deces_mention_declarant(entity_ref("urn:law:catalog:decessansconjoint:v0")) { origin case_input; }
        assert "cat-3": deces_mention_jour_heure_lieu(entity_ref("urn:law:catalog:decessansconjoint:v0")) { origin case_input; }
        assert "cat-4": deces_mention_partenaire_satisfaite(entity_ref("urn:law:catalog:decessansconjoint:v0")) { origin case_input; }
    }
    evaluate truth(manque_conjoint_defunt(entity_ref("urn:law:catalog:decessansconjoint:v0")));
    expect truth_status == TRUE_ONLY;
}

