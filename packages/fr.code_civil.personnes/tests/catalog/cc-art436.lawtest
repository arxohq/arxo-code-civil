language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CONTINUATIONMANDATADMINISTRATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": personne_sous_sauvegarde(entity_ref("urn:law:catalog:continuationmandatadministration:v0")) { origin case_input; }
        assert "cat-1": mandat_administration_anterieur(entity_ref("urn:law:catalog:continuationmandatadministration:v0")) { origin case_input; }
    }
    evaluate truth(mandat_administration_continue(entity_ref("urn:law:catalog:continuationmandatadministration:v0")));
    expect truth_status == TRUE_ONLY;
}
