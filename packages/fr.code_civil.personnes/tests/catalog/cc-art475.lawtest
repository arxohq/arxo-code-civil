language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-REPRESENTATIONJUDICIAIRETUTELLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": action_judiciaire_du_protege(entity_ref("urn:law:catalog:representationjudiciairetutelle:v0"), entity_ref("urn:law:catalog:representationjudiciairetutelle:v1")) { origin case_input; }
        assert "cat-1": personne_en_tutelle(entity_ref("urn:law:catalog:representationjudiciairetutelle:v1")) { origin case_input; }
        assert "cat-2": autorisation_juge_droits_extrapatrimoniaux(entity_ref("urn:law:catalog:representationjudiciairetutelle:v0")) { origin case_input; }
    }
    evaluate truth(representation_judiciaire_tuteur_admissible(entity_ref("urn:law:catalog:representationjudiciairetutelle:v0")));
    expect truth_status == TRUE_ONLY;
}
