language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DECLARATIONENFANTTROUVE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": enfant_nouveau_ne_trouve(entity_ref("urn:law:catalog:declarationenfanttrouve:v0"), entity_ref("urn:law:catalog:declarationenfanttrouve:v1")) { origin case_input; }
        assert "cat-1": enfant_remis_officier_avec_objets(entity_ref("urn:law:catalog:declarationenfanttrouve:v0"), entity_ref("urn:law:catalog:declarationenfanttrouve:v1")) { origin case_input; }
    }
    evaluate truth(declaration_enfant_trouvee_conforme(entity_ref("urn:law:catalog:declarationenfanttrouve:v0")));
    expect truth_status == TRUE_ONLY;
}
