language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DROITDUMINEURDETREENTENDU" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": discernement_du_mineur(entity_ref("urn:law:catalog:droitdumineurdetreentendu:v0")) { origin case_input; }
        assert "cat-1": mineur(entity_ref("urn:law:catalog:droitdumineurdetreentendu:v0")) { origin case_input; }
        assert "cat-2": demande_a_etre_entendu(entity_ref("urn:law:catalog:droitdumineurdetreentendu:v0")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(EtreEntenduDansLaProcedure, ACTIVE);
}

// 
test "CATALOG-INFORMATIONDUMINEURSURLAUDITION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": mineur(entity_ref("urn:law:catalog:informationdumineursurlaudition:v0")) { origin case_input; }
    }
    evaluate truth(mineur_informe_du_droit_audition(entity_ref("urn:law:catalog:informationdumineursurlaudition:v0")));
    expect truth_status == TRUE_ONLY;
}
