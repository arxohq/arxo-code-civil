language "law.core" version "0.2"; package fr.code_civil.personnes version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-personnes";
test "urn:query:fr-cc-personnes-n01" { given { context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; } assert "f1": parent_francais(entity_ref("urn:fr:cc:n01:parent"), entity_ref("urn:fr:cc:n01:enfant")) { origin case_input; } } evaluate truth(nationalite_francaise(entity_ref("urn:fr:cc:n01:enfant"))); expect truth_status == TRUE_ONLY; expect applied(Article18Nationalite); }
