language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 413-1 : le mineur est émancipé de plein droit par le mariage.
test "urn:query:fr-code-civil-personnes-p05-emancipation-par-le-mariage" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:pers:e3:p"), @2009-06-01) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:pers:e3:p"), @2026-03-15) { origin case_input; }
        assert "f3": marie(entity_ref("urn:fr:cc:pers:e3:p")) { origin case_input; }
    }
    evaluate truth(emancipe(entity_ref("urn:fr:cc:pers:e3:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EmancipationParLeMariage);
}
