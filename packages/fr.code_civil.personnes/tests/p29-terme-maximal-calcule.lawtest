language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 441 al. 1 : ouverte le 1er février 2024, la mesure ne peut aller au-delà du 1er février 2029.
test "urn:query:fr-code-civil-personnes-p29-terme-maximal-calcule" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:pers:t:p"), @1950-04-04) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:pers:t:p"), @2026-03-15) { origin case_input; }
        assert "f3": alteration_medicalement_constatee(entity_ref("urn:fr:cc:pers:t:p")) { origin adjudicated; }
        assert "f4": mesure_demandee_pour(entity_ref("urn:fr:cc:pers:t:m"), entity_ref("urn:fr:cc:pers:t:p")) { origin case_input; }
        assert "f5": mesure_ouverte_le(entity_ref("urn:fr:cc:pers:t:m"), @2024-02-01) { origin case_input; }
    }
    evaluate truth(expiration_maximale_le(entity_ref("urn:fr:cc:pers:t:m"), @2029-02-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ExpirationMaximaleCinqAns);
}
