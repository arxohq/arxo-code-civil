language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Arts. 393 and 414: majority ends the minor's guardianship.
test "urn:query:fr-code-civil-personnes-tg02-fin-tutelle-a-la-majorite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:personnes:tg02:p"), @2008-09-16) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:personnes:tg02:p"), @2026-09-16) { origin case_input; }
    }
    evaluate truth(tutelle_mineur_terminee(entity_ref("urn:fr:cc:personnes:tg02:p")));
    expect truth_status == TRUE_ONLY;
    expect applied(FinTutelleParMajorite);
}
