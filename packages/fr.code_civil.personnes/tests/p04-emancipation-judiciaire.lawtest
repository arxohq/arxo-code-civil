language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 413-2 : seize ans révolus et décision du juge — le mineur est émancipé.
test "urn:query:fr-code-civil-personnes-p04-emancipation-judiciaire" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:pers:e2:p"), @2009-06-01) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:pers:e2:p"), @2026-03-15) { origin case_input; }
        assert "f3": emancipation_prononcee_le(entity_ref("urn:fr:cc:pers:e2:p"), @2026-02-01) { origin adjudicated; }
    }
    evaluate truth(emancipe(entity_ref("urn:fr:cc:pers:e2:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EmancipationJudiciaire);
}
