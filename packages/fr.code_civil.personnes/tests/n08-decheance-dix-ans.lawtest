language "law.core" version "0.2"; package fr.code_civil.personnes version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-personnes";
test "urn:query:fr-cc-personnes-n08" { given { context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; } assert "f1": acquisition_nationalite_francaise_le(entity_ref("urn:fr:cc:n08:p"), @2010-01-01) { origin adjudicated; } assert "f2": fait_decheance_commis_le(entity_ref("urn:fr:cc:n08:p"), @2020-01-01) { origin adjudicated; } assert "f3": decheance_prononcee_le(entity_ref("urn:fr:cc:n08:p"), @2030-01-01) { origin adjudicated; } } evaluate truth(decheance_dans_fenetres_legales(entity_ref("urn:fr:cc:n08:p"))); expect truth_status == TRUE_ONLY; expect applied(DecheanceDixAns); }
