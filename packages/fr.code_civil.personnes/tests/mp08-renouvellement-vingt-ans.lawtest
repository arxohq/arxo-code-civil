language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 442: specially reasoned renewal on concurring medical opinion reaches at most twenty years.
test "urn:query:fr-code-civil-personnes-mp08-renouvellement-vingt-ans" {
    given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; } assert "f1": mesure_renouvelee_le(entity_ref("urn:fr:cc:personnes:mp08:m"), @2026-03-01) { origin adjudicated; } assert "f2": avis_conforme_du_medecin_sur_l_absence_d_amelioration(entity_ref("urn:fr:cc:personnes:mp08:m")) { origin adjudicated; } }
    evaluate truth(renouvellement_expire_le(entity_ref("urn:fr:cc:personnes:mp08:m"), @2046-03-01));
    expect truth_status == TRUE_ONLY;
    expect applied(TermeRenouvellementVingtAns);
}
