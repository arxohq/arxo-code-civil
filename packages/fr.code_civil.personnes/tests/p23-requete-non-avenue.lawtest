language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 126 : la requête est non avenue lorsque l absent reparaît avant le jugement.
test "urn:query:fr-code-civil-personnes-p23-requete-non-avenue" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": requete_en_declaration_d_absence_le(entity_ref("urn:fr:cc:pers:e4:p"), @2025-11-01) { origin case_input; }
        assert "f2": reparu_le(entity_ref("urn:fr:cc:pers:e4:p"), @2026-01-05) { origin case_input; }
    }
    evaluate truth(requete_non_avenue(entity_ref("urn:fr:cc:pers:e4:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
