language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 125 : le jugement déclaratif est rendu un an au moins après la publication des extraits.
test "urn:query:fr-code-civil-personnes-p17-jugement-un-an-apres-la-publication" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": extraits_publies_le(entity_ref("urn:fr:cc:pers:a:p"), @2025-09-01) { origin case_input; }
    }
    evaluate truth(jugement_declaratif_possible_le(entity_ref("urn:fr:cc:pers:a:p"), @2026-09-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
