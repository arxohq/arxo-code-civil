language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 388 et 414 : né le 15 mars 2008, apprécié le 2026-03-15 — majeur.
test "urn:query:fr-code-civil-personnes-p01-dix-huit-ans-jour-meme" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:pers:m:p"), @2008-03-15) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:pers:m:p"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(majeur(entity_ref("urn:fr:cc:pers:m:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(Majeur);
}
