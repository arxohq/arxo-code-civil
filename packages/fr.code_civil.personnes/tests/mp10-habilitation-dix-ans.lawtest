language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 494-6: general family authorization is capped at ten years absent the special medical route.
test "urn:query:fr-code-civil-personnes-mp10-habilitation-dix-ans" {
    given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; } assert "f1": habilitation_ordonnee_le(entity_ref("urn:fr:cc:personnes:mp10:h"), @2026-03-01) { origin adjudicated; } }
    evaluate truth(habilitation_expire_le(entity_ref("urn:fr:cc:personnes:mp10:h"), @2036-03-01));
    expect truth_status == TRUE_ONLY;
    expect applied(HabilitationGeneraleDixAns);
}
