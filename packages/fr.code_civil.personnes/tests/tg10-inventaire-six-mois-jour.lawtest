language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 503: six calendar months from 10 January expire on 10 July.
test "urn:query:fr-code-civil-personnes-tg10-inventaire-six-mois-jour" {
    given {
        context { decision_time @2026-07-10T09:00:00Z; knowledge_time @2026-07-10T09:00:00Z; legal_time @2026-07-10; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": ouverture_tutelle_gestion(entity_ref("urn:fr:cc:personnes:tg10:m"), entity_ref("urn:fr:cc:personnes:tg10:p"), entity_ref("urn:fr:cc:personnes:tg10:t"), @2026-01-10) { origin adjudicated; }
    }
    evaluate truth(echeance_inventaire_autres_biens(entity_ref("urn:fr:cc:personnes:tg10:m"), @2026-07-10));
    expect truth_status == TRUE_ONLY;
    expect applied(EcheanceInventaireAutresBiens);
}
