language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 122 al. 2 : sans jugement de présomption, vingt ans depuis la disparition du 3 mai 2004 — le 3 mai 2024.
test "urn:query:fr-code-civil-personnes-p15-vingt-ans-sans-jugement" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": a_cesse_de_paraitre_le(entity_ref("urn:fr:cc:pers:b:p"), @2004-05-03) { origin case_input; }
    }
    evaluate truth(declaration_d_absence_possible_le(entity_ref("urn:fr:cc:pers:b:p"), @2024-05-03));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(VingtAnsSansJugementDePresomption);
}
