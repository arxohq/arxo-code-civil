language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 118 : le présumé absent qui reparaît — la présomption tombe.
test "urn:query:fr-code-civil-personnes-p18-retour-met-fin-a-la-presomption" {
    given {
        context { decision_time @2026-03-15T09:00:00Z; knowledge_time @2026-03-15T09:00:00Z; legal_time @2026-03-15; timezone "Europe/Paris"; deadline_policy CC_PERSONNES_CALENDRIER; }
        assert "f1": presomption_d_absence_constatee_le(entity_ref("urn:fr:cc:pers:a:p"), @2015-06-01) { origin adjudicated; }
        assert "f2": reparu_le(entity_ref("urn:fr:cc:pers:a:p"), @2026-01-10) { origin case_input; }
    }
    evaluate truth(presomption_d_absence(entity_ref("urn:fr:cc:pers:a:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
