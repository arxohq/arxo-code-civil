language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

// Art. 459: a favorable judicial assessment exposes the person's liberty as a position.
test "urn:query:fr-code-civil-personnes-mp12-decisions-personnelles-position" {
    given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; } assert "f1": etat_permet_decision_personnelle_459(entity_ref("urn:fr:cc:personnes:mp12:p")) { origin adjudicated; } }
    evaluate positions();
    expect position(PrendreSesDecisionsPersonnelles, ACTIVE);
}

test "urn:query:fr-code-civil-personnes-mp12-decisions-personnelles-position-second" {
    given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; } assert "f1": etat_permet_decision_personnelle_459(entity_ref("urn:fr:cc:personnes:mp12:p2")) { origin adjudicated; } }
    evaluate positions();
    expect position(PrendreSesDecisionsPersonnelles, ACTIVE);
}
