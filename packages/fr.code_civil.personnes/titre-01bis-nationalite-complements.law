pub entity DemandeNationalite { label fr official "demande ou déclaration de nationalité"; label en unofficial "nationality application or declaration"; }
pub entity ContexteTerritorial { label fr official "contexte territorial d'application des règles de nationalité"; label en unofficial "territorial context for applying nationality rules"; }

pub relation demande_nationalite_de(p: Personne, d: DemandeNationalite) kind empirical { key(d); label fr official "demande de nationalité présentée par la personne"; label en unofficial "nationality application made by the person"; }
pub relation modification_territoriale_par_acte_constitutionnel_ou_traite(c: ContexteTerritorial) kind empirical { label fr official "une modification territoriale résulte d'un acte de l'autorité pris selon la Constitution et les lois ou d'un traité"; label en unofficial "a territorial change results from a public-authority act under the Constitution and statutes or from a treaty"; }
pub relation modification_integree_a_la_determination_du_territoire(c: ContexteTerritorial) kind derived { label fr official "la modification est prise en compte pour déterminer le territoire français"; label en unofficial "the change is taken into account when determining French territory"; }
pub relation application_titre_nationalite_outre_mer(c: ContexteTerritorial) kind empirical { label fr official "le titre de la nationalité est appliqué dans une collectivité ultramarine concernée"; label en unofficial "the nationality title is applied in a relevant overseas collectivity"; }
pub relation termes_tribunal_premiere_instance_substitues(c: ContexteTerritorial) kind derived { label fr official "les termes tribunal de première instance remplacent tribunal de grande instance"; label en unofficial "the words court of first instance replace regional court"; }
pub relation termes_collectivite_ou_nouvelle_caledonie_substitues(c: ContexteTerritorial) kind derived { label fr official "collectivité ou Nouvelle-Calédonie remplace département aux articles 21-28 et 21-29"; label en unofficial "collectivity or New Caledonia replaces department in Articles 21-28 and 21-29"; }
pub relation contre_valeur_euro_en_monnaie_locale_etablie(c: ContexteTerritorial) kind empirical { label fr official "la contre-valeur locale de l'euro est établie"; label en unofficial "the local-currency equivalent of the euro has been established"; }
pub relation sanction_article_68_prononcee_en_monnaie_locale(c: ContexteTerritorial) kind derived { label fr official "la sanction de l'article 68 est prononcée en monnaie locale selon la contre-valeur de l'euro"; label en unofficial "the Article 68 penalty is imposed in local currency using the euro equivalent"; }
pub relation demande_souscrite_le(d: DemandeNationalite, jour: Date) kind empirical { key(d); label fr official "jour de souscription ou de réception de la demande"; label en unofficial "date the application was made or received"; }
pub relation demandeur_reside_en_france_depuis_dix_ans(d: DemandeNationalite) kind empirical { label fr official "le demandeur justifie dix ans de résidence habituelle en France"; label en unofficial "the applicant proves ten years' habitual residence in France"; }
pub relation delai_decision_nationalite_expire_le(d: DemandeNationalite, jour: Date) kind derived { key(d); label fr official "terme du délai de réponse à la demande de nationalité"; label en unofficial "deadline for deciding the nationality application"; }
pub relation prolongation_motivee_unique(d: DemandeNationalite) kind empirical { label fr official "une unique prolongation motivée a été décidée"; label en unofficial "one reasoned extension was decided"; }
pub relation parents_inconnus(p: Personne) kind empirical { label fr official "les parents de l'enfant sont inconnus"; label en unofficial "the child's parents are unknown"; }
pub relation parents_apatrides(p: Personne) kind empirical { label fr official "les parents de l'enfant sont apatrides"; label en unofficial "the child's parents are stateless"; }
pub relation aucune_nationalite_parentale_transmissible(p: Personne) kind empirical { label fr official "aucune loi étrangère ne permet la transmission d'une nationalité parentale"; label en unofficial "no foreign law permits transmission of a parent's nationality"; }
pub relation acte_naissance_article_58(p: Personne) kind empirical { label fr official "l'acte de naissance de l'enfant a été dressé selon l'article 58"; label en unofficial "the child's birth record was made under Article 58"; }
pub relation presume_ne_en_france(p: Personne) kind derived { label fr official "l'enfant est présumé né en France"; label en unofficial "the child is presumed born in France"; }
pub relation filiation_etablie_pendant_minorite(p: Personne) kind empirical { label fr official "la filiation a été établie pendant la minorité"; label en unofficial "filiation was established during minority"; }
pub relation filiation_produit_effet_nationalite(p: Personne) kind derived { label fr official "la filiation produit effet sur la nationalité"; label en unofficial "filiation affects nationality"; }
pub relation nationalite_etrangere_par_filiation_prouvee(p: Personne) kind empirical { label fr official "une nationalité étrangère par filiation est prouvée"; label en unofficial "foreign nationality by descent is proved"; }
pub relation engagement_armee_francaise(p: Personne) kind empirical { label fr official "la personne a contracté un engagement dans les armées françaises"; label en unofficial "the person enlisted in the French armed forces"; }
pub relation faculte_repudiation_perdue(p: Personne) kind derived { label fr official "la faculté de répudier la nationalité est perdue"; label en unofficial "the right to disclaim nationality is lost"; }
pub relation enfant_agent_diplomatique_etranger(p: Personne) kind empirical { label fr official "l'enfant est né en France d'un agent diplomatique ou consul étranger"; label en unofficial "the child was born in France to a foreign diplomatic or consular agent"; }
pub relation acquisition_volontaire_21_11_ouverte(p: Personne) kind derived { label fr official "l'acquisition volontaire selon l'article 21-11 reste ouverte"; label en unofficial "voluntary acquisition under Article 21-11 remains available"; }
pub relation adoption_simple_de(p: Personne) kind empirical { label fr official "la personne fait l'objet d'une adoption simple"; label en unofficial "the person is subject to simple adoption"; }
pub relation mariage_annule_de_bonne_foi(p: Personne) kind empirical { label fr official "le mariage a été annulé mais le conjoint l'avait contracté de bonne foi"; label en unofficial "the marriage was annulled but the spouse entered it in good faith"; }
pub relation declaration_nationalite_maintenue(p: Personne) kind derived { label fr official "la déclaration de nationalité demeure efficace"; label en unofficial "the nationality declaration remains effective"; }
pub relation nationalite_enfants_inchangee(p: Personne) kind derived { label fr official "la nationalité des enfants reste inchangée"; label en unofficial "the children's nationality remains unchanged"; }
pub relation age_au_moins_soixante_cinq_ans(p: Personne) kind derived { label fr official "la personne a au moins soixante-cinq ans"; label en unofficial "the person is at least sixty-five"; }
pub relation residence_france_depuis_vingt_cinq_ans(p: Personne) kind empirical { label fr official "la personne réside régulièrement en France depuis au moins vingt-cinq ans"; label en unofficial "the person has lawfully resided in France for at least twenty-five years"; }
pub relation ascendant_direct_ressortissant_francais(p: Personne) kind empirical { label fr official "la personne est l'ascendant direct d'un ressortissant français"; label en unofficial "the person is a direct ascendant of a French national"; }
pub relation declaration_ascendant_admissible(p: Personne) kind derived { label fr official "la déclaration de l'ascendant est admissible"; label en unofficial "the ascendant's declaration is admissible"; }
pub relation reside_en_france_depuis_six_ans(p: Personne) kind empirical { label fr official "la personne réside habituellement en France depuis l'âge de six ans"; label en unofficial "the person has habitually resided in France since age six"; }
pub relation scolarite_obligatoire_en_france(p: Personne) kind empirical { label fr official "la scolarité obligatoire a été suivie en France dans un établissement contrôlé"; label en unofficial "compulsory schooling was completed in France at a supervised institution"; }
pub relation frere_ou_soeur_francais_21_7_ou_21_11(p: Personne) kind empirical { label fr official "un frère ou une sœur a acquis la nationalité selon l'article 21-7 ou 21-11"; label en unofficial "a sibling acquired nationality under Article 21-7 or 21-11"; }
pub relation declaration_fratrie_admissible(p: Personne) kind derived { label fr official "la déclaration fondée sur la fratrie est admissible"; label en unofficial "the sibling-based declaration is admissible"; }
pub relation reside_en_france_au_decret(p: Personne) kind empirical { label fr official "la personne réside en France lors de la signature du décret"; label en unofficial "the person resides in France when the decree is signed"; }
pub relation condition_residence_naturalisation_satisfaite(p: Personne) kind derived { label fr official "la condition de résidence au décret est satisfaite"; label en unofficial "the residence-at-decree condition is met"; }
pub relation langue_francaise_maternelle(p: Personne) kind empirical { label fr official "le français est la langue maternelle de la personne"; label en unofficial "French is the person's mother tongue"; }
pub relation scolarisation_francaise_cinq_ans(p: Personne) kind empirical { label fr official "la personne justifie cinq années de scolarisation en français"; label en unofficial "the person proves five years of French-language schooling"; }
pub relation dispense_stage_linguistique(p: Personne) kind derived { label fr official "la personne bénéficie de la dispense de stage linguistique"; label en unofficial "the person qualifies for the linguistic residence waiver"; }
pub relation parent_devenu_francais_et_cinq_ans_residence(p: Personne) kind empirical { label fr official "un parent est devenu français et le mineur a résidé cinq ans avec lui"; label en unofficial "a parent became French and the minor lived with that parent for five years"; }
pub relation condition_age_naturalisation_satisfaite(p: Personne) kind derived { label fr official "la condition d'âge de naturalisation est satisfaite"; label en unofficial "the naturalization age condition is met"; }
pub relation perte_nationalite_effective(p: Personne) kind empirical { label fr official "la perte de nationalité a pris effet"; label en unofficial "loss of nationality took effect"; }
pub relation droits_attaches_nationalite_perdus(p: Personne) kind derived { label fr official "les droits attachés à la qualité de Français sont perdus"; label en unofficial "rights attached to French nationality are lost"; }
pub relation autre_nationalite_conservee(p: Personne) kind empirical { label fr official "la personne conserve une autre nationalité"; label en unofficial "the person retains another nationality"; }
pub relation decheance_sans_apatridie_admissible(p: Personne) kind derived { label fr official "la déchéance ne rend pas la personne apatride"; label en unofficial "deprivation does not make the person stateless"; }
pub relation qualite_francais_etablie_posterieurement(p: Personne) kind empirical { label fr official "la qualité de Français a été établie après la naissance"; label en unofficial "French status was established after birth"; }
pub relation francais_repute_depuis_naissance(p: Personne) kind derived { label fr official "la personne est réputée française depuis sa naissance"; label en unofficial "the person is deemed French from birth"; }
pub relation mariage_avec_etranger(p: Personne) kind empirical { label fr official "la personne française épouse un étranger"; label en unofficial "the French person marries a foreign national"; }
pub relation nationalite_inchangee_par_mariage(p: Personne) kind derived { label fr official "le mariage ne modifie pas de plein droit la nationalité"; label en unofficial "marriage does not automatically change nationality"; }
pub relation declaration_nationalite_souscrite_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour de souscription de la déclaration de nationalité"; label en unofficial "date the nationality declaration was made"; }
pub relation nationalite_acquise_le(p: Personne, jour: Date) kind derived { key(p); label fr official "jour où la nationalité est acquise par déclaration"; label en unofficial "date nationality is acquired by declaration"; }
pub relation refugie_ou_apatride(p: Personne) kind empirical { label fr official "la personne est réfugiée politique ou apatride"; label en unofficial "the person is a political refugee or stateless"; }
pub relation residence_reguliere_quinze_ans(p: Personne) kind empirical { label fr official "la personne réside régulièrement en France depuis quinze ans"; label en unofficial "the person has lawfully resided in France for fifteen years"; }
pub relation dispense_connaissance_langue(p: Personne) kind derived { label fr official "la condition de connaissance de la langue ne s'applique pas"; label en unofficial "the language-knowledge requirement does not apply"; }
pub relation condamnation_emprisonnement_ferme_mois(p: Personne, n: Integer) kind empirical { key(p); label fr official "durée en mois de la condamnation ferme"; label en unofficial "length in months of the unsuspended prison sentence"; }
pub relation acquisition_nationalite_interdite(p: Personne) kind derived { label fr official "l'acquisition ou la réintégration est interdite"; label en unofficial "acquisition or restoration is prohibited"; }
pub relation acquisition_nationalite_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour d'acquisition de la nationalité française"; label en unofficial "date French nationality was acquired"; }
pub relation ceremonie_accueil_due_le(p: Personne, jour: Date) kind derived { key(p); label fr official "terme de six mois de la cérémonie d'accueil"; label en unofficial "six-month deadline for the citizenship ceremony"; }
pub relation meme_residence_parent_devenu_francais(p: Personne) kind empirical { label fr official "l'enfant mineur réside avec le parent devenu français"; label en unofficial "the minor child resides with the parent who became French"; }
pub relation nom_enfant_mentionne_decret_ou_declaration(p: Personne) kind empirical { label fr official "le nom de l'enfant figure au décret ou à la déclaration du parent"; label en unofficial "the child's name appears in the parent's decree or declaration"; }
pub relation obligations_service_national_regulieres(p: Personne) kind empirical { label fr official "la personne est en règle avec ses obligations du service national"; label en unofficial "the person complies with national-service obligations"; }
pub relation perte_par_declaration_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour de la déclaration de perte de nationalité"; label en unofficial "date of the declaration of loss of nationality"; }
pub relation perte_par_decret_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour du décret de perte de nationalité"; label en unofficial "date of the nationality-loss decree"; }
pub relation perte_par_jugement_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour fixé par le jugement de perte"; label en unofficial "date fixed by the loss judgment"; }
pub relation perte_nationalite_prend_effet_le(p: Personne, jour: Date) kind derived { key(p); label fr official "date légale d'effet de la perte de nationalité"; label en unofficial "legal effective date of loss of nationality"; }
pub relation reintegration_demandee(p: Personne) kind empirical { label fr official "la personne demande sa réintégration dans la nationalité"; label en unofficial "the person applies for restoration of nationality"; }
pub relation reintegration_sans_age_ni_stage(p: Personne) kind derived { label fr official "la réintégration est ouverte sans condition d'âge ni de stage"; label en unofficial "restoration is available without age or residence-period conditions"; }
pub relation decision_nationalite_defavorable(d: DemandeNationalite) kind empirical { label fr official "la décision déclare la demande irrecevable, l'ajourne ou la rejette"; label en unofficial "the decision declares the application inadmissible, postpones or rejects it"; }
pub relation decision_nationalite_motivee(d: DemandeNationalite) kind empirical { label fr official "la décision défavorable est motivée"; label en unofficial "the adverse decision gives reasons"; }
pub relation decision_defavorable_conforme(d: DemandeNationalite) kind derived { label fr official "la décision défavorable satisfait à l'obligation de motivation"; label en unofficial "the adverse decision complies with the duty to give reasons"; }
pub relation decret_nationalite_publie_le(d: DemandeNationalite, jour: Date) kind empirical { key(d); label fr official "jour de publication du décret de nationalité"; label en unofficial "publication date of the nationality decree"; }
pub relation fraude_decouverte_le(d: DemandeNationalite, jour: Date) kind empirical { key(d); label fr official "jour de découverte du mensonge ou de la fraude"; label en unofficial "date falsehood or fraud was discovered"; }
pub relation retrait_decret_expire_le(d: DemandeNationalite, jour: Date) kind derived { key(d); label fr official "terme du délai de retrait du décret"; label en unofficial "deadline for withdrawing the decree"; }
pub relation action_declaratoire_nationalite(p: Personne) kind empirical { label fr official "la personne agit pour faire décider sa qualité ou non-qualité de Français"; label en unofficial "the person seeks a declaration of French status or its absence"; }
pub relation action_nationalite_recevable(p: Personne) kind derived { label fr official "l'action déclaratoire de nationalité est recevable"; label en unofficial "the nationality-status action is admissible"; }
pub relation certificat_nationalite_refuse(p: Personne) kind empirical { label fr official "la délivrance du certificat de nationalité a été refusée"; label en unofficial "delivery of a nationality certificate was refused"; }
pub relation saisine_tribunal_certificat_admissible(p: Personne) kind derived { label fr official "la saisine du tribunal pour le certificat est admissible"; label en unofficial "application to the court concerning the certificate is admissible"; }
pub relation parent_acquiert_nationalite_pendant_minorite(p: Personne) kind empirical { label fr official "un parent acquiert la nationalité française pendant la minorité de l'enfant"; label en unofficial "a parent acquires French nationality during the child's minority"; }
pub relation liens_manifestes_avec_france(p: Personne) kind empirical { label fr official "la personne conserve des liens culturels, professionnels, économiques ou familiaux manifestes avec la France"; label en unofficial "the person retains manifest cultural, professional, economic or family ties with France"; }
pub relation reclamation_nationalite_21_14_admissible(p: Personne) kind derived { label fr official "la réclamation de nationalité de l'article 21-14 est admissible"; label en unofficial "the Article 21-14 nationality claim is available"; }
pub relation etranger_militaire_blesse_en_mission(p: Personne) kind empirical { label fr official "l'étranger engagé dans les armées françaises a été blessé en mission et demande la nationalité"; label en unofficial "the foreign enlistee was wounded on mission and requests nationality"; }
pub relation decret_naturalisation_accorde(p: Personne) kind empirical { label fr official "un décret de naturalisation a été accordé à la demande de l'étranger"; label en unofficial "a naturalization decree was granted on the foreign national's application"; }
pub relation etranger_francophone_action_emerite(p: Personne) kind empirical { label fr official "l'étranger francophone contribue par une action émérite au rayonnement de la France"; label en unofficial "the French-speaking foreign national contributes outstandingly to France's influence"; }
pub relation naturalisation_sur_proposition_affaires_etrangeres_admissible(p: Personne) kind derived { label fr official "la naturalisation sur proposition du ministre des affaires étrangères est admissible"; label en unofficial "naturalization on the foreign minister's proposal is available"; }
pub relation bonnes_vie_et_moeurs(p: Personne) kind empirical { label fr official "la personne est de bonnes vie et mœurs"; label en unofficial "the person is of good character"; }
pub relation condition_moralite_naturalisation_satisfaite(p: Personne) kind derived { label fr official "la condition de moralité de naturalisation est satisfaite"; label en unofficial "the naturalization good-character condition is met"; }
pub relation assimilation_communaute_francaise_constatee(p: Personne) kind empirical { label fr official "l'assimilation à la communauté française et le niveau de langue sont constatés"; label en unofficial "assimilation into the French community and language level are established"; }
pub relation condition_assimilation_satisfaite(p: Personne) kind derived { label fr official "la condition d'assimilation est satisfaite"; label en unofficial "the assimilation condition is met"; }
pub relation sejour_assimile_article_21_26(p: Personne) kind empirical { label fr official "le séjour appartient à l'un des quatre cas fermés assimilés à la résidence en France"; label en unofficial "the stay belongs to one of the four closed cases treated as residence in France"; }
pub relation residence_france_assimilee(p: Personne) kind derived { label fr official "le séjour est assimilé à la résidence en France"; label en unofficial "the stay is treated as residence in France"; }
pub relation droits_et_obligations_nationalite_applicables(p: Personne) kind derived { label fr official "tous les droits et obligations attachés à la qualité de Français sont applicables"; label en unofficial "all rights and duties attached to French nationality apply"; }
pub relation enfant_marie(p: Personne) kind empirical { label fr official "l'enfant mineur est marié"; label en unofficial "the minor child is married"; }
pub relation effet_collectif_exclu(p: Personne) kind derived { label fr official "l'effet collectif de l'article 22-1 est exclu"; label en unofficial "the collective effect under Article 22-1 is excluded"; }
pub relation demande_nationalite_etrangere_deposee_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour du dépôt de la demande de nationalité étrangère"; label en unofficial "date the foreign-nationality application was filed"; }
pub relation declaration_perte_dans_fenetre(p: Personne) kind derived { label fr official "la déclaration de perte est dans sa fenêtre légale"; label en unofficial "the loss declaration falls within its statutory window"; }
pub relation nationalite_conjoint_etranger_acquise_et_menage_etranger(p: Personne) kind empirical { label fr official "le conjoint français a acquis la nationalité étrangère du conjoint et le ménage réside à l'étranger"; label en unofficial "the French spouse acquired the foreign spouse's nationality and the household resides abroad"; }
pub relation absence_possession_etat_et_residence_demi_siecle(p: Personne) kind empirical { label fr official "la personne et ses ascendants sont sans possession d'état ni résidence en France depuis un demi-siècle"; label en unofficial "the person and ancestors lack French status and residence in France for half a century"; }
pub relation perte_judiciaire_admissible(p: Personne) kind derived { label fr official "la constatation judiciaire de perte est admissible"; label en unofficial "judicial declaration of loss is available"; }
pub relation emploi_etranger_maintenu_apres_injonction(p: Personne) kind empirical { label fr official "l'emploi ou concours étranger est maintenu après injonction gouvernementale"; label en unofficial "foreign employment or assistance continues after a government order"; }
pub relation delai_injonction_jours(p: Personne, n: Integer) kind empirical { key(p); label fr official "durée en jours du délai fixé par l'injonction"; label en unofficial "length in days of the period fixed by the order"; }
pub relation injonction_activite_etrangere_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour de l'injonction de cesser l'activité étrangère"; label en unofficial "date of the order to stop the foreign activity"; }
pub relation terme_injonction_activite_etrangere_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "terme fixé par l'injonction de cesser l'activité étrangère"; label en unofficial "deadline fixed by the order to stop the foreign activity"; }
pub relation perte_pour_activite_etrangere_admissible(p: Personne) kind derived { label fr official "la perte pour maintien d'une activité étrangère est admissible"; label en unofficial "loss for continuing foreign activity is available"; }
pub relation reintegration_par_declaration_admissible(p: Personne) kind derived { label fr official "la réintégration par déclaration est admissible"; label en unofficial "restoration by declaration is available"; }
pub relation enfant_moins_dix_huit_du_reintegre(p: Personne) kind empirical { label fr official "l'enfant de la personne réintégrée a moins de dix-huit ans et satisfait l'article 22-1"; label en unofficial "the restored person's child is under eighteen and meets Article 22-1"; }
pub relation reintegration_etendue_enfant(p: Personne) kind derived { label fr official "la réintégration produit effet à l'égard de l'enfant"; label en unofficial "restoration takes effect for the child"; }
pub relation decret_nationalite_prend_effet_le(d: DemandeNationalite, jour: Date) kind derived { key(d); label fr official "date d'effet non rétroactive du décret"; label en unofficial "non-retroactive effective date of the decree"; }
pub relation contestation_nationalite_personne_physique(p: Personne) kind empirical { label fr official "une contestation porte sur la nationalité d'une personne physique"; label en unofficial "a dispute concerns a natural person's nationality"; }
pub relation juridiction_civile_seule_competente(p: Personne) kind derived { label fr official "la juridiction civile de droit commun est seule compétente"; label en unofficial "the ordinary civil court has exclusive jurisdiction"; }
pub relation jugement_nationalite_rendu(p: Personne) kind empirical { label fr official "un jugement de droit commun est rendu en matière de nationalité"; label en unofficial "an ordinary-court nationality judgment was given"; }
pub relation jugement_nationalite_opposable_a_tous(p: Personne) kind derived { label fr official "le jugement de nationalité produit effet à l'égard de tous"; label en unofficial "the nationality judgment has effect against everyone"; }
pub relation toutes_conditions_nationalite_prouvees(p: Personne) kind empirical { label fr official "toutes les conditions légales de la nationalité sont prouvées"; label en unofficial "all statutory nationality conditions are proved"; }
pub relation preuve_nationalite_satisfaite(p: Personne) kind derived { label fr official "la preuve de la nationalité est satisfaite"; label en unofficial "proof of nationality is satisfied"; }
pub relation possession_etat_constante_parent_et_enfant(p: Personne) kind empirical { label fr official "l'intéressé et le parent transmetteur ont une possession d'état constante de Français"; label en unofficial "the person and transmitting parent have constant possession of French status"; }
pub relation preuve_filiation_nationalite_presumee(p: Personne) kind derived { label fr official "la nationalité par filiation est présumée établie"; label en unofficial "nationality by descent is presumed established"; }
pub relation ascendants_etranger_demi_siecle_sans_possession_etat(p: Personne) kind empirical { label fr official "les ascendants sont établis à l'étranger depuis plus d'un demi-siècle sans possession d'état"; label en unofficial "the ancestors have lived abroad for over half a century without possession of French status"; }
pub relation preuve_filiation_irrecevable(p: Personne) kind derived { label fr official "la preuve de nationalité par filiation est irrecevable"; label en unofficial "proof of nationality by descent is inadmissible"; }
pub relation aucune_condition_qualite_francais(p: Personne) kind empirical { label fr official "aucune condition légale de la qualité de Français n'est remplie"; label en unofficial "no statutory condition for French status is met"; }
pub relation preuve_extraneite_satisfaite(p: Personne) kind derived { label fr official "la preuve de l'extranéité est satisfaite"; label en unofficial "proof of foreign status is satisfied"; }
pub relation certificat_indique_base_legale_et_documents(p: Personne) kind empirical { label fr official "le certificat indique la base légale et les documents établissant la nationalité"; label en unofficial "the certificate states the legal basis and supporting documents"; }
pub relation certificat_nationalite_fait_foi(p: Personne) kind derived { label fr official "le certificat de nationalité fait foi jusqu'à preuve contraire"; label en unofficial "the nationality certificate is authoritative until rebutted"; }
pub relation identite_adresse_beneficiaire_ceremonie_communiquees(p: Personne) kind empirical { label fr official "l'identité et l'adresse du bénéficiaire de la cérémonie sont communiquées au maire"; label en unofficial "the ceremony beneficiary's identity and address are sent to the mayor"; }
pub relation maire_peut_organiser_ceremonie(p: Personne) kind derived { label fr official "le maire peut être autorisé à organiser la cérémonie d'accueil"; label en unofficial "the mayor may be authorized to hold the citizenship ceremony"; }
pub relation comportement_national_etranger_et_nationalite_etrangere(p: Personne) kind empirical { label fr official "la personne se comporte comme le national d'un pays dont elle possède la nationalité"; label en unofficial "the person acts as a national of a country whose nationality the person holds"; }
pub relation perte_article_23_7_admissible(p: Personne) kind derived { label fr official "la perte par décret de l'article 23-7 est admissible"; label en unofficial "loss by decree under Article 23-7 is available"; }
pub relation declaration_nationalite_enregistree_autorite_competente(p: Personne) kind empirical { label fr official "la déclaration de nationalité est enregistrée par l'autorité compétente selon son lieu et son fondement"; label en unofficial "the nationality declaration is registered by the authority competent for its place and ground"; }
pub relation declaration_nationalite_valable(p: Personne) kind derived { label fr official "la déclaration de nationalité satisfait à l'enregistrement requis à peine de nullité"; label en unofficial "the nationality declaration meets the registration requirement on pain of nullity"; }
pub relation acte_nationalite_a_mentionner_naissance(p: Personne) kind empirical { label fr official "un acte, certificat ou jugement relatif à la nationalité doit être mentionné sur l'acte de naissance"; label en unofficial "a nationality instrument, certificate or judgment must be noted on the birth record"; }
pub relation mention_nationalite_marginale_requise(p: Personne) kind derived { label fr official "une mention relative à la nationalité doit être portée en marge"; label en unofficial "a nationality note must be entered in the margin"; }
pub relation francais_statut_commun_algerie_1962(p: Personne) kind empirical { label fr official "la personne française de statut civil de droit commun était domiciliée en Algérie lors de l'autodétermination"; label en unofficial "the French person under ordinary civil status was domiciled in Algeria at self-determination"; }
pub relation nationalite_francaise_conservee(p: Personne) kind derived { label fr official "la nationalité française est conservée de plein droit"; label en unofficial "French nationality is automatically retained"; }
pub relation ne_algerie_avant_22_juillet_1962_possession_etat(p: Personne) kind empirical { label fr official "la personne de statut commun est née en Algérie avant le 22 juillet 1962 et possède constamment l'état de Français"; label en unofficial "the ordinary-status person was born in Algeria before 22 July 1962 and constantly possessed French status"; }
pub relation domicilie_ancien_territoire_independance_sans_autre_nationalite(p: Personne) kind empirical { label fr official "la personne était domiciliée dans l'ancien territoire à l'indépendance et aucune autre nationalité ne lui a été conférée"; label en unofficial "the person was domiciled in the former territory at independence and received no other nationality"; }
pub relation ancien_parlementaire_reinstalle_france(p: Personne) kind empirical { label fr official "l'ancien membre d'une assemblée de la République ayant perdu la nationalité a établi son domicile en France"; label en unofficial "the former member of a Republic assembly who lost nationality established domicile in France"; }
pub relation reintegration_simple_declaration_admissible(p: Personne) kind derived { label fr official "la réintégration par simple déclaration est admissible"; label en unofficial "restoration by simple declaration is available"; }
pub relation declaration_reintegration_ancien_parlementaire(p: Personne) kind empirical { label fr official "la personne souscrit la déclaration de réintégration d'ancien parlementaire"; label en unofficial "the person makes the former-member restoration declaration"; }
pub relation declaration_reintegration_personnelle_admissible(p: Personne) kind derived { label fr official "la déclaration personnelle de réintégration est admissible dès dix-huit ans"; label en unofficial "the personal restoration declaration is available from age eighteen"; }
pub relation convention_internationale_prevoit_changement_nationalite(p: Personne) kind empirical { label fr official "la convention internationale prévoit expressément le changement de nationalité"; label en unofficial "the international convention expressly provides for the nationality change"; }
pub relation changement_nationalite_conventionnel_admissible(p: Personne) kind derived { label fr official "le changement de nationalité fondé sur la convention est admissible"; label en unofficial "the convention-based nationality change is available"; }
pub relation conditions_loi_14_octobre_1814_satisfaites(p: Personne) kind empirical { label fr official "la personne domiciliée dans un territoire rétrocédé satisfait à la loi du 14 octobre 1814"; label en unofficial "the person domiciled in a retroceded territory meets the Act of 14 October 1814"; }
pub relation acquisition_historique_nationalite_admissible(p: Personne) kind derived { label fr official "l'acquisition historique de nationalité est admissible"; label en unofficial "historical acquisition of nationality is available"; }
pub relation declaration_outre_mer_recue_president_ou_juge(p: Personne) kind empirical { label fr official "la déclaration est reçue par le président du tribunal de première instance ou le juge de la section détachée"; label en unofficial "the declaration is received by the first-instance court president or detached-section judge"; }
pub relation autorite_reception_declaration_competente(p: Personne) kind derived { label fr official "l'autorité dérogatoire est compétente pour recevoir la déclaration"; label en unofficial "the special authority is competent to receive the declaration"; }
pub relation mineur_a_entree_vigueur_loi_nationalite(p: Personne) kind empirical { label fr official "la personne était mineure à l'entrée en vigueur de la loi nouvelle de nationalité d'origine"; label en unofficial "the person was a minor when the new original-nationality law entered into force"; }
pub relation loi_nouvelle_nationalite_applicable(p: Personne) kind derived { label fr official "la loi nouvelle de nationalité d'origine est applicable"; label en unofficial "the new original-nationality law applies"; }
pub relation acte_ou_fait_nationalite_le(p: Personne, jour: Date) kind empirical { key(p); label fr official "jour de l'acte ou du fait auquel la loi attache acquisition ou perte"; label en unofficial "date of the act or fact to which law attaches acquisition or loss"; }
pub relation loi_nationalite_applicable_au_jour(p: Personne, jour: Date) kind derived { key(p); label fr official "date de détermination de la loi applicable à l'acquisition ou la perte"; label en unofficial "date determining the law applicable to acquisition or loss"; }
pub relation territoire_dans_definition_france(p: Personne) kind empirical { label fr official "le lieu relève du territoire métropolitain, ultramarin, de Nouvelle-Calédonie ou des terres australes"; label en unofficial "the place is within metropolitan or overseas France, New Caledonia or the southern lands"; }
pub relation lieu_compte_comme_france(p: Personne) kind derived { label fr official "le lieu compte comme étant en France pour le titre de la nationalité"; label en unofficial "the place counts as France for the nationality title"; }
pub relation majorite_selon_loi_francaise(p: Personne) kind derived { label fr official "la majorité et la minorité sont déterminées par la loi française"; label en unofficial "majority and minority are determined by French law"; }
pub relation national_etat_cedant_domicilie_territoire_annexe(p: Personne) kind empirical { label fr official "le national de l'Etat cédant est domicilié dans le territoire annexé au transfert de souveraineté"; label en unofficial "the ceding State national is domiciled in annexed territory at transfer of sovereignty"; }
pub relation francais_domicilie_territoire_cede(p: Personne) kind empirical { label fr official "le Français est domicilié dans le territoire cédé au transfert de souveraineté"; label en unofficial "the French national is domiciled in ceded territory at transfer of sovereignty"; }
pub relation nationalite_francaise_perdue_transfert(p: Personne) kind derived { label fr official "la nationalité française est perdue par l'effet de la cession territoriale"; label en unofficial "French nationality is lost through territorial cession"; }
pub relation option_nationalite_instituee_dans_pays(p: Personne) kind empirical { label fr official "l'option de nationalité est instituée dans le pays contractant concerné"; label en unofficial "the nationality option is instituted in the relevant contracting country"; }
pub relation forme_option_regie_par_loi_pays(p: Personne) kind derived { label fr official "la forme de l'option est régie par la loi du pays où elle est instituée"; label en unofficial "the option's form is governed by the law of the country where instituted"; }
pub relation nationalites_existantes_et_renoncees_indiquees(p: Personne) kind empirical { label fr official "la personne indique les nationalités possédées, conservées et abandonnées lors de l'acquisition"; label en unofficial "the person states held, retained and renounced nationalities upon acquisition"; }
pub relation obligation_declaration_plurinationalite_satisfaite(p: Personne) kind derived { label fr official "l'obligation d'indiquer les autres nationalités est satisfaite"; label en unofficial "the duty to state other nationalities is satisfied"; }
pub relation ancienne_qualite_francais_prouvee(p: Personne) kind empirical { label fr official "la personne établit avoir possédé la qualité de Français"; label en unofficial "the person proves former French status"; }
pub relation reintegration_par_decret_ou_declaration_ouverte(p: Personne) kind derived { label fr official "la réintégration par décret ou déclaration est ouverte"; label en unofficial "restoration by decree or declaration is open"; }
pub relation declaration_recue_selon_categorie_26(p: Personne) kind empirical { label fr official "la déclaration est reçue par l'autorité correspondant à sa catégorie de l'article 26"; label en unofficial "the declaration is received by the authority matching its Article 26 category"; }
pub relation recepisse_declaration_nationalite_du(p: Personne) kind derived { label fr official "un récépissé de déclaration de nationalité doit être délivré"; label en unofficial "a nationality-declaration receipt must be issued"; }
pub relation interesse_entendu_ou_appele_avant_decret_perte(p: Personne) kind empirical { label fr official "l'intéressé est entendu ou appelé à présenter ses observations avant perte ou déchéance"; label en unofficial "the person is heard or invited to comment before loss or deprivation"; }
pub relation procedure_decret_perte_respectee(p: Personne) kind derived { label fr official "la procédure contradictoire du décret de perte est respectée"; label en unofficial "the adversarial procedure for the loss decree is respected"; }
pub relation mentions_nationalite_portees_copies_extraits(p: Personne) kind empirical { label fr official "les mentions de nationalité sont portées d'office sur les copies et extraits requis"; label en unofficial "nationality notes are entered automatically on required copies and extracts"; }
pub relation publicite_mentions_nationalite_conforme(p: Personne) kind derived { label fr official "la publicité des mentions de nationalité est conforme"; label en unofficial "publication of nationality notes complies"; }
pub relation administration_requiert_action_procureur(p: Personne) kind empirical { label fr official "une administration ou un tiers ayant soulevé l'exception requiert l'action du procureur"; label en unofficial "an authority or third party raising the issue requires prosecutorial action"; }
pub relation procureur_tenu_agir_nationalite(p: Personne) kind derived { label fr official "le procureur est tenu d'agir en matière de nationalité"; label en unofficial "the prosecutor is required to act in nationality proceedings"; }
pub relation demande_certificat_avec_justification_nationalite(p: Personne) kind empirical { label fr official "la personne demande un certificat en justifiant sa nationalité"; label en unofficial "the person requests a certificate and proves nationality"; }
pub relation greffe_seul_habilite_certificat(p: Personne) kind derived { label fr official "le directeur des services de greffe est seul habilité à délivrer le certificat"; label en unofficial "the judicial-registry director alone may issue the certificate"; }
pub relation president_ou_juge_seul_habilite_certificat(p: Personne) kind derived { label fr official "le président ou le juge local est seul habilité à délivrer le certificat outre-mer"; label en unofficial "the local president or judge alone may issue the overseas certificate"; }
pub relation originaire_republique_1960_domicilie_territoire_independant(p: Personne) kind empirical { label fr official "la personne originaire de la République de 1960 était domiciliée dans le territoire lors de l'indépendance"; label en unofficial "the person originating in the 1960 Republic was domiciled in the territory at independence"; }
pub relation demande_certificat_outre_mer_justifiee(p: Personne) kind empirical { label fr official "la demande ultramarine de certificat justifie la nationalité française"; label en unofficial "the overseas certificate application proves French nationality"; }

@source(CC_ART17_6)
rule DeterminationTerritoireFrancais(c: ContexteTerritorial) strict {
    label fr official "Article 17-6. Toute modification issue d'un acte constitutionnel ou légal de l'autorité publique ou d'un traité est prise en compte pour déterminer le territoire français";
    label en unofficial "Article 17-6. Every territorial change resulting from a constitutional or statutory public-authority act or treaty is taken into account when determining French territory";
    when modification_territoriale_par_acte_constitutionnel_ou_traite(c);
    then modification_integree_a_la_determination_du_territoire(c);
}

@source(CC_ART17_3)
rule DemandeNationaliteDesSeizeAns(p: Personne, naissance: Date, jour: Date) defeasible { label fr official "Article 17-3. La demande peut être faite sans autorisation dès seize ans"; label en unofficial "Article 17-3. An application may be made without authorization from age sixteen"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(naissance, 16 calendar_year); then renonciation_irrevocable_a_seize_ans(p); }

@source(CC_ART19)
rule NationaliteEnfantParentsInconnus(p: Personne) strict { label fr official "Article 19. L'enfant né en France de parents inconnus est français"; label en unofficial "Article 19. A France-born child of unknown parents is French"; when ne_en_france(p) and parents_inconnus(p); then nationalite_francaise(p); }

@source(CC_ART19_1) {
  rule NationaliteEnfantParentsApatrides(p: Personne) strict { label fr official "Article 19-1, 1°. L'enfant né en France de parents apatrides est français"; label en unofficial "Article 19-1(1). A France-born child of stateless parents is French"; when ne_en_france(p) and parents_apatrides(p); then nationalite_francaise(p); }
  rule NationaliteSansTransmissionEtrangere(p: Personne) strict { label fr official "Article 19-1, 2°. L'enfant né en France sans nationalité parentale transmissible est français"; label en unofficial "Article 19-1(2). A France-born child with no transmissible parental nationality is French"; when ne_en_france(p) and aucune_nationalite_parentale_transmissible(p); then nationalite_francaise(p); }
}

@source(CC_ART19_2)
rule PresomptionNaissanceFrance(p: Personne) strict { label fr official "Article 19-2. L'acte dressé selon l'article 58 fait présumer la naissance en France"; label en unofficial "Article 19-2. A record made under Article 58 creates a presumption of birth in France"; when acte_naissance_article_58(p); then presume_ne_en_france(p); }

@source(CC_ART20_1)
rule EffetFiliationPendantMinorite(p: Personne) strict { label fr official "Article 20-1. Seule la filiation établie durant la minorité produit effet sur la nationalité"; label en unofficial "Article 20-1. Only filiation established during minority affects nationality"; when filiation_etablie_pendant_minorite(p); then filiation_produit_effet_nationalite(p); }

@source(CC_ART20_3)
rule RepudiationAvecNationaliteEtrangere(p: Personne) defeasible { label fr official "Article 20-3. La répudiation exige la preuve d'une nationalité étrangère par filiation"; label en unofficial "Article 20-3. Disclaimer requires proof of foreign nationality by descent"; when nationalite_etrangere_par_filiation_prouvee(p); then renonciation_nationalite_admissible(p); }

@source(CC_ART20_4)
rule EngagementMilitaireEteintRepudiation(p: Personne) strict { label fr official "Article 20-4. L'engagement dans les armées françaises fait perdre la faculté de répudiation"; label en unofficial "Article 20-4. Enlistment in the French armed forces ends the right to disclaim"; when engagement_armee_francaise(p); then faculte_repudiation_perdue(p); }

@source(CC_ART20_5)
rule AcquisitionVolontaireEnfantDiplomate(p: Personne) strict { label fr official "Article 20-5. L'enfant d'un agent diplomatique étranger conserve l'accès volontaire de l'article 21-11"; label en unofficial "Article 20-5. A foreign diplomat's child retains voluntary access under Article 21-11"; when enfant_agent_diplomatique_etranger(p); then acquisition_volontaire_21_11_ouverte(p); }

@source(CC_ART21)
rule AdoptionSimpleSansEffetAutomatique(p: Personne) strict { label fr official "Article 21. L'adoption simple n'emporte pas de plein droit la nationalité"; label en unofficial "Article 21. Simple adoption does not automatically confer nationality"; when adoption_simple_de(p); then acquisition_volontaire_21_11_ouverte(p); }

@source(CC_ART21_5)
rule BonneFoiMaintientDeclaration(p: Personne) strict { label fr official "Article 21-5. L'annulation du mariage ne rend pas caduque la déclaration du conjoint de bonne foi"; label en unofficial "Article 21-5. Annulment does not invalidate the good-faith spouse's declaration"; when mariage_annule_de_bonne_foi(p); then declaration_nationalite_maintenue(p); }

@source(CC_ART21_6)
rule AnnulationMariageSansEffetEnfants(p: Personne) strict { label fr official "Article 21-6. L'annulation du mariage est sans effet sur la nationalité des enfants"; label en unofficial "Article 21-6. Annulment has no effect on the children's nationality"; when mariage_annule_de_bonne_foi(p); then nationalite_enfants_inchangee(p); }

@source(CC_ART21_9)
rule MineurEngageAcquiertNationalite(p: Personne) strict { label fr official "Article 21-9. Le mineur né en France et régulièrement engagé acquiert la nationalité à son incorporation"; label en unofficial "Article 21-9. A France-born minor who lawfully enlists acquires nationality on enlistment"; when ne_en_france(p) and engagement_armee_francaise(p); then nationalite_francaise(p); }

@source(CC_ART21_10)
rule Article21_11OuvertEnfantDiplomate(p: Personne) strict { label fr official "Article 21-10. L'enfant d'un diplomate étranger peut acquérir volontairement selon l'article 21-11"; label en unofficial "Article 21-10. A foreign diplomat's child may acquire voluntarily under Article 21-11"; when enfant_agent_diplomatique_etranger(p); then acquisition_volontaire_21_11_ouverte(p); }

@source(CC_ART21_13_1)
rule DeclarationAscendantSoixanteCinqAns(p: Personne, naissance: Date, jour: Date) strict { label fr official "Article 21-13-1. Soixante-cinq ans, vingt-cinq ans de résidence et ascendance directe ouvrent la déclaration"; label en unofficial "Article 21-13-1. Age sixty-five, twenty-five years' residence and direct ascent open the declaration"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(naissance, 65 calendar_year) and residence_france_depuis_vingt_cinq_ans(p) and ascendant_direct_ressortissant_francais(p); then declaration_ascendant_admissible(p); }

@source(CC_ART21_13_2)
rule DeclarationFratrieMajorite(p: Personne, naissance: Date, jour: Date) strict { label fr official "Article 21-13-2. A la majorité, résidence depuis six ans, scolarité française et frère ou sœur français ouvrent la déclaration"; label en unofficial "Article 21-13-2. At majority, residence since six, French schooling and a French sibling open the declaration"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(naissance, 18 calendar_year) and reside_en_france_depuis_six_ans(p) and scolarite_obligatoire_en_france(p) and frere_ou_soeur_francais_21_7_ou_21_11(p); then declaration_fratrie_admissible(p); }

@source(CC_ART21_16)
rule ResidenceAuDecretNaturalisation(p: Personne) strict { label fr official "Article 21-16. La naturalisation exige la résidence en France lors de la signature du décret"; label en unofficial "Article 21-16. Naturalization requires residence in France when the decree is signed"; when reside_en_france_au_decret(p); then condition_residence_naturalisation_satisfaite(p); }

@source(CC_ART21_20) {
  rule DispenseStageLangueMaternelle(p: Personne) strict { label fr official "Article 21-20. La langue française maternelle ouvre la dispense de stage dans l'entité culturelle et linguistique française"; label en unofficial "Article 21-20. French as a mother tongue opens the residence waiver within the French linguistic community"; when langue_francaise_maternelle(p); then dispense_stage_linguistique(p); }
  rule DispenseStageCinqAnsScolarite(p: Personne) strict { label fr official "Article 21-20. Cinq années de scolarisation en français ouvrent la dispense de stage"; label en unofficial "Article 21-20. Five years of French-language schooling open the residence waiver"; when scolarisation_francaise_cinq_ans(p); then dispense_stage_linguistique(p); }
}

@source(CC_ART21_22) {
  rule AgeDixHuitAnsNaturalisation(p: Personne, naissance: Date, jour: Date) strict { label fr official "Article 21-22. La condition ordinaire de naturalisation est dix-huit ans"; label en unofficial "Article 21-22. The ordinary naturalization age is eighteen"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(naissance, 18 calendar_year); then condition_age_naturalisation_satisfaite(p); }
  rule ExceptionMineurParentNaturalise(p: Personne) strict { label fr official "Article 21-22. Le mineur resté étranger satisfait l'exception après cinq ans de résidence avec le parent devenu français"; label en unofficial "Article 21-22. A remaining foreign minor meets the exception after five years with the naturalized parent"; when parent_devenu_francais_et_cinq_ans_residence(p); then condition_age_naturalisation_satisfaite(p); }
}

@source(CC_ART21_25_1) {
  rule DelaiDecisionDixHuitMois(d: DemandeNationalite, depot: Date) defeasible { label fr official "Article 21-25-1. La réponse intervient au plus tard dix-huit mois après réception"; label en unofficial "Article 21-25-1. A decision is due no later than eighteen months after receipt"; when demande_souscrite_le(d, depot) and not_known(demandeur_reside_en_france_depuis_dix_ans(d)) and not_known(prolongation_motivee_unique(d)); then delai_decision_nationalite_expire_le(d, add_calendar_period(depot, 18 calendar_month)); }
  rule DelaiDecisionDouzeMois(d: DemandeNationalite, depot: Date) defeasible { label fr official "Article 21-25-1. Dix ans de résidence réduisent le délai à douze mois"; label en unofficial "Article 21-25-1. Ten years' residence reduces the deadline to twelve months"; when demande_souscrite_le(d, depot) and demandeur_reside_en_france_depuis_dix_ans(d) and not_known(prolongation_motivee_unique(d)); then delai_decision_nationalite_expire_le(d, add_calendar_period(depot, 12 calendar_month)); }
  rule ProlongationVingtEtUnMois(d: DemandeNationalite, depot: Date) defeasible { label fr official "Article 21-25-1. L'unique prolongation motivée porte le délai ordinaire à vingt et un mois"; label en unofficial "Article 21-25-1. The single reasoned extension brings the ordinary deadline to twenty-one months"; when demande_souscrite_le(d, depot) and not_known(demandeur_reside_en_france_depuis_dix_ans(d)) and prolongation_motivee_unique(d); then delai_decision_nationalite_expire_le(d, add_calendar_period(depot, 21 calendar_month)); }
  rule ProlongationQuinzeMois(d: DemandeNationalite, depot: Date) strict { label fr official "Article 21-25-1. Pour dix ans de résidence, l'unique prolongation porte le délai à quinze mois"; label en unofficial "Article 21-25-1. With ten years' residence, the single extension brings the deadline to fifteen months"; when demande_souscrite_le(d, depot) and demandeur_reside_en_france_depuis_dix_ans(d) and prolongation_motivee_unique(d); then delai_decision_nationalite_expire_le(d, add_calendar_period(depot, 15 calendar_month)); }
}

@source(CC_ART23_3)
rule PerteEmportePerteDroits(p: Personne) strict { label fr official "Article 23-3. La perte de la nationalité emporte perte des droits attachés à la qualité de Français"; label en unofficial "Article 23-3. Loss of nationality entails loss of rights attached to French status"; when perte_nationalite_effective(p); then droits_attaches_nationalite_perdus(p); }

@source(CC_ART25)
rule DecheanceExclutApatridie(p: Personne) strict { label fr official "Article 25. La déchéance n'est admissible que si elle ne rend pas la personne apatride"; label en unofficial "Article 25. Deprivation is available only if it does not make the person stateless"; when autre_nationalite_conservee(p); then decheance_sans_apatridie_admissible(p); }

@source(CC_ART20)
rule NationaliteReputeeDepuisNaissance(p: Personne) strict { label fr official "Article 20. L'enfant français est réputé l'avoir été dès sa naissance"; label en unofficial "Article 20. A French child is deemed to have been French from birth"; when qualite_francais_etablie_posterieurement(p); then francais_repute_depuis_naissance(p); }

@source(CC_ART21_1)
rule MariageSansEffetAutomatique(p: Personne) strict { label fr official "Article 21-1. Le mariage n'exerce de plein droit aucun effet sur la nationalité"; label en unofficial "Article 21-1. Marriage has no automatic effect on nationality"; when mariage_avec_etranger(p); then nationalite_inchangee_par_mariage(p); }

@source(CC_ART21_3)
rule EffetDeclarationAuJourSouscription(p: Personne, jour: Date, enregistrement: Date) strict { label fr official "Article 21-3. La déclaration enregistrée produit acquisition au jour de sa souscription"; label en unofficial "Article 21-3. A registered declaration produces acquisition on the date it was made"; when declaration_nationalite_souscrite_le(p, jour) and declaration_nationalite_enregistree_le(p, enregistrement); then nationalite_acquise_le(p, jour); }

@source(CC_ART21_24_1)
rule DispenseLangueRefugieSoixanteDixAns(p: Personne, naissance: Date, jour: Date) strict { label fr official "Article 21-24-1. Le réfugié ou apatride de plus de soixante-dix ans résidant depuis quinze ans est dispensé de langue"; label en unofficial "Article 21-24-1. A refugee or stateless person over seventy with fifteen years' residence is exempt from the language requirement"; when refugie_ou_apatride(p) and residence_reguliere_quinze_ans(p) and ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(naissance, 70 calendar_year); then dispense_connaissance_langue(p); }

@source(CC_ART21_27)
rule CondamnationSixMoisInterditAcquisition(p: Personne, n: Integer) strict { label fr official "Article 21-27. Une peine ferme d'au moins six mois interdit acquisition ou réintégration"; label en unofficial "Article 21-27. An unsuspended sentence of at least six months bars acquisition or restoration"; when condamnation_emprisonnement_ferme_mois(p, n) and n >= 6; then acquisition_nationalite_interdite(p); }

@source(CC_ART21_28)
rule CeremonieAccueilSixMois(p: Personne, acquisition: Date) strict { label fr official "Article 21-28. La cérémonie d'accueil est organisée dans les six mois de l'acquisition"; label en unofficial "Article 21-28. The citizenship ceremony is held within six months of acquisition"; when acquisition_nationalite_le(p, acquisition); then ceremonie_accueil_due_le(p, add_calendar_period(acquisition, 6 calendar_month)); }

@source(CC_ART22_1)
rule EffetCollectifEnfantMineur(p: Personne) strict { label fr official "Article 22-1. L'enfant mineur résidant avec le parent devenu français et nommé dans l'acte devient français"; label en unofficial "Article 22-1. A minor residing with the newly French parent and named in the instrument becomes French"; when meme_residence_parent_devenu_francais(p) and nom_enfant_mentionne_decret_ou_declaration(p); then nationalite_francaise(p); }

@source(CC_ART22_3)
rule RepudiationEnfantEffetCollectif(p: Personne, naissance: Date, jour: Date) strict { label fr official "Article 22-3. L'enfant né hors de France peut répudier entre six mois avant et douze mois après sa majorité"; label en unofficial "Article 22-3. A foreign-born child may disclaim from six months before to twelve months after majority"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(add_calendar_period(naissance, 17 calendar_year), 6 calendar_month) and jour <= add_calendar_period(naissance, 19 calendar_year); then renonciation_nationalite_admissible(p); }

@source(CC_ART23_2)
rule DeclarationPerteAvantTrenteCinqAns(p: Personne, naissance: Date, jour: Date) strict { label fr official "Article 23-2. Avant trente-cinq ans, la déclaration de perte exige la régularité au service national"; label en unofficial "Article 23-2. Before age thirty-five, a loss declaration requires compliance with national service"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour < add_calendar_period(naissance, 35 calendar_year) and obligations_service_national_regulieres(p); then perte_nationalite_declaree(p); }

@source(CC_ART23_9) {
  rule EffetPerteAcquisitionEtrangere(p: Personne, jour: Date) strict { label fr official "Article 23-9, 1°. La perte prend effet au jour de l'acquisition étrangère"; label en unofficial "Article 23-9(1). Loss takes effect on the date foreign nationality is acquired"; when acquisition_nationalite_etrangere_le(p, jour); then perte_nationalite_prend_effet_le(p, jour); }
  rule EffetPerteDeclaration(p: Personne, jour: Date) strict { label fr official "Article 23-9, 2°. La perte prend effet au jour de la déclaration"; label en unofficial "Article 23-9(2). Loss takes effect on the declaration date"; when perte_par_declaration_le(p, jour); then perte_nationalite_prend_effet_le(p, jour); }
  rule EffetPerteDecret(p: Personne, jour: Date) strict { label fr official "Article 23-9, 3°. La perte prend effet au jour du décret"; label en unofficial "Article 23-9(3). Loss takes effect on the decree date"; when perte_par_decret_le(p, jour); then perte_nationalite_prend_effet_le(p, jour); }
  rule EffetPerteJugement(p: Personne, jour: Date) strict { label fr official "Article 23-9, 4°. La perte prend effet au jour fixé par le jugement"; label en unofficial "Article 23-9(4). Loss takes effect on the date fixed by judgment"; when perte_par_jugement_le(p, jour); then perte_nationalite_prend_effet_le(p, jour); }
}

@source(CC_ART24_1)
rule ReintegrationSansAgeNiStage(p: Personne) strict { label fr official "Article 24-1. La réintégration par décret est ouverte à tout âge et sans stage"; label en unofficial "Article 24-1. Restoration by decree is available at any age and without a residence period"; when reintegration_demandee(p); then reintegration_sans_age_ni_stage(p); }

@source(CC_ART26_5)
rule EffetDeclarationEnregistree(p: Personne, jour: Date, enregistrement: Date) strict { label fr official "Article 26-5. La déclaration enregistrée prend effet à sa date de souscription"; label en unofficial "Article 26-5. A registered declaration takes effect on the date it was made"; when declaration_nationalite_souscrite_le(p, jour) and declaration_nationalite_enregistree_le(p, enregistrement); then nationalite_acquise_le(p, jour); }

@source(CC_ART27)
rule MotivationDecisionDefavorable(d: DemandeNationalite) strict { label fr official "Article 27. Toute décision défavorable en matière de nationalité doit être motivée"; label en unofficial "Article 27. Every adverse nationality decision must give reasons"; when decision_nationalite_defavorable(d) and decision_nationalite_motivee(d); then decision_defavorable_conforme(d); }

@source(CC_ART27_2) {
  rule RetraitDeuxAnsPublication(d: DemandeNationalite, pubjour: Date) defeasible { label fr official "Article 27-2. Le retrait pour défaut de condition intervient dans les deux ans de la publication"; label en unofficial "Article 27-2. Withdrawal for unmet conditions occurs within two years of publication"; when decret_nationalite_publie_le(d, pubjour); then retrait_decret_expire_le(d, add_calendar_period(pubjour, 2 calendar_year)); }
  rule RetraitDeuxAnsDecouverteFraude(d: DemandeNationalite, decouverte: Date) strict { label fr official "Article 27-2. En cas de fraude, le délai court deux ans de sa découverte"; label en unofficial "Article 27-2. In case of fraud, the two-year period runs from discovery"; when fraude_decouverte_le(d, decouverte); then retrait_decret_expire_le(d, add_calendar_period(decouverte, 2 calendar_year)); }
}

@source(CC_ART29_3)
rule DroitActionDeclaratoireNationalite(p: Personne) strict { label fr official "Article 29-3. Toute personne peut agir pour faire décider sa qualité ou non-qualité de Français"; label en unofficial "Article 29-3. Any person may seek a declaration of French status or its absence"; when action_declaratoire_nationalite(p); then action_nationalite_recevable(p); }

@source(CC_ART31_3)
rule RecoursRefusCertificat(p: Personne) strict { label fr official "Article 31-3. Le refus du certificat ouvre la saisine du tribunal judiciaire"; label en unofficial "Article 31-3. Refusal of a certificate opens an application to the judicial court"; when certificat_nationalite_refuse(p); then saisine_tribunal_certificat_admissible(p); }

@source(CC_ART19_4)
rule RepudiationArticle19_4(p: Personne, naissance: Date, jour: Date) defeasible { label fr official "Article 19-4. L'enfant d'un seul parent né en France peut répudier dans la fenêtre de majorité sauf acquisition parentale"; label en unofficial "Article 19-4. A child of one France-born parent may disclaim in the majority window absent parental acquisition"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(add_calendar_period(naissance, 17 calendar_year), 6 calendar_month) and jour <= add_calendar_period(naissance, 19 calendar_year) and not_known(parent_acquiert_nationalite_pendant_minorite(p)); then renonciation_nationalite_admissible(p); }

@source(CC_ART21_14)
rule ReclamationAvecLiensFrance(p: Personne) strict { label fr official "Article 21-14. La perte antérieure et les liens manifestes avec la France ouvrent la déclaration"; label en unofficial "Article 21-14. Prior loss and manifest ties with France open the declaration"; when perte_nationalite_effective(p) and liens_manifestes_avec_france(p); then reclamation_nationalite_21_14_admissible(p); }

@source(CC_ART21_14_1)
rule NationaliteMilitaireBlesse(p: Personne) strict { label fr official "Article 21-14-1. L'étranger engagé blessé en mission reçoit la nationalité par décret sur sa demande"; label en unofficial "Article 21-14-1. A foreign enlistee wounded on mission receives nationality by decree on request"; when etranger_militaire_blesse_en_mission(p); then nationalite_francaise(p); }

@source(CC_ART21_15)
rule EffetDecretNaturalisation(p: Personne) strict { label fr official "Article 21-15. La naturalisation accordée par décret emporte acquisition"; label en unofficial "Article 21-15. Naturalization granted by decree entails acquisition"; when decret_naturalisation_accorde(p); then nationalite_francaise(p); }

@source(CC_ART21_21)
rule NaturalisationFrancophoneEmerite(p: Personne) strict { label fr official "Article 21-21. L'action émérite du francophone ouvre la proposition de naturalisation"; label en unofficial "Article 21-21. Outstanding action by a French speaker opens proposed naturalization"; when etranger_francophone_action_emerite(p); then naturalisation_sur_proposition_affaires_etrangeres_admissible(p); }

@source(CC_ART21_23)
rule MoralitesNaturalisation(p: Personne) defeasible { label fr official "Article 21-23. Les bonnes vie et mœurs sans condamnation de l'article 21-27 satisfont la condition"; label en unofficial "Article 21-23. Good character without an Article 21-27 conviction meets the condition"; when bonnes_vie_et_moeurs(p) and not_known(acquisition_nationalite_interdite(p)); then condition_moralite_naturalisation_satisfaite(p); }

@source(CC_ART21_24)
rule AssimilationNaturalisation(p: Personne) strict { label fr official "Article 21-24. L'assimilation et le niveau de langue requis satisfont la condition de naturalisation"; label en unofficial "Article 21-24. Required assimilation and language level meet the naturalization condition"; when assimilation_communaute_francaise_constatee(p); then condition_assimilation_satisfaite(p); }

@source(CC_ART21_26)
rule AssimilationResidenceFrance(p: Personne) strict { label fr official "Article 21-26. Les quatre séjours fermés sont assimilés à la résidence en France"; label en unofficial "Article 21-26. The four closed categories of stay are treated as residence in France"; when sejour_assimile_article_21_26(p); then residence_france_assimilee(p); }

@source(CC_ART22)
rule DroitsObligationsApresAcquisition(p: Personne, jour: Date) strict { label fr official "Article 22. Dès l'acquisition, tous les droits et obligations attachés à la qualité de Français s'appliquent"; label en unofficial "Article 22. From acquisition, all rights and duties attached to French status apply"; when acquisition_nationalite_le(p, jour); then droits_et_obligations_nationalite_applicables(p); }

@source(CC_ART22_2)
rule EnfantMarieSansEffetCollectif(p: Personne) strict { label fr official "Article 22-2. L'effet collectif de l'article 22-1 ne s'applique pas à l'enfant marié"; label en unofficial "Article 22-2. Article 22-1's collective effect does not apply to a married child"; when enfant_marie(p); then effet_collectif_exclu(p); }

@source(CC_ART23_1)
rule FenetreDeclarationPerte(p: Personne, depot: Date, acquisition: Date, jour: Date) strict { label fr official "Article 23-1. La déclaration de perte est ouverte du dépôt de la demande étrangère jusqu'à un an après acquisition"; label en unofficial "Article 23-1. The loss declaration is open from filing the foreign application until one year after acquisition"; when demande_nationalite_etrangere_deposee_le(p, depot) and acquisition_nationalite_etrangere_le(p, acquisition) and date_d_appreciation(p, jour) and jour >= depot and jour <= add_calendar_period(acquisition, 1 calendar_year); then declaration_perte_dans_fenetre(p); }

@source(CC_ART23_5)
rule RepudiationConjointEtranger(p: Personne) strict { label fr official "Article 23-5. La nationalité du conjoint acquise et la résidence du ménage à l'étranger ouvrent la répudiation"; label en unofficial "Article 23-5. Acquiring the spouse's nationality and household residence abroad open disclaimer"; when nationalite_conjoint_etranger_acquise_et_menage_etranger(p); then renonciation_nationalite_admissible(p); }

@source(CC_ART23_6)
rule PerteJudiciaireDemiSiecle(p: Personne) strict { label fr official "Article 23-6. L'absence de possession d'état et de résidence pendant un demi-siècle ouvre la perte judiciaire"; label en unofficial "Article 23-6. Lack of status and residence for half a century opens judicial loss"; when absence_possession_etat_et_residence_demi_siecle(p); then perte_judiciaire_admissible(p); }

@source(CC_ART23_8)
rule PerteActiviteEtrangere(p: Personne, injonction: Date, terme: Date) strict { label fr official "Article 23-8. Le maintien de l'activité étrangère après injonction de quinze jours à deux mois ouvre la perte"; label en unofficial "Article 23-8. Continuing foreign activity after a fifteen-day to two-month order opens loss"; when emploi_etranger_maintenu_apres_injonction(p) and injonction_activite_etrangere_le(p, injonction) and terme_injonction_activite_etrangere_le(p, terme) and terme >= add_calendar_period(injonction, 15 calendar_day) and terme <= add_calendar_period(injonction, 2 calendar_month); then perte_pour_activite_etrangere_admissible(p); }

@source(CC_ART24_2)
rule ReintegrationDeclarationLiensFrance(p: Personne) defeasible { label fr official "Article 24-2. La perte par mariage ou acquisition étrangère et les liens manifestes ouvrent la réintégration par déclaration"; label en unofficial "Article 24-2. Loss through marriage or foreign acquisition and manifest ties open restoration by declaration"; when perte_nationalite_effective(p) and liens_manifestes_avec_france(p) and not_known(acquisition_nationalite_interdite(p)); then reintegration_par_declaration_admissible(p); }

@source(CC_ART24_3)
rule EffetReintegrationEnfant(p: Personne) strict { label fr official "Article 24-3. La réintégration produit effet pour l'enfant de moins de dix-huit ans dans les conditions de l'article 22-1"; label en unofficial "Article 24-3. Restoration affects a child under eighteen under Article 22-1 conditions"; when enfant_moins_dix_huit_du_reintegre(p); then reintegration_etendue_enfant(p); }

@source(CC_ART27_1)
rule NonRetroactiviteDecretNationalite(d: DemandeNationalite, pubjour: Date) strict { label fr official "Article 27-1. Le décret de nationalité n'a pas d'effet rétroactif et prend effet à sa publication"; label en unofficial "Article 27-1. A nationality decree is non-retroactive and takes effect on publication"; when decret_nationalite_publie_le(d, pubjour); then decret_nationalite_prend_effet_le(d, pubjour); }

@source(CC_ART29)
rule CompetenceExclusiveNationalite(p: Personne) strict { label fr official "Article 29. La juridiction civile de droit commun connaît seule des contestations de nationalité"; label en unofficial "Article 29. The ordinary civil court alone hears nationality disputes"; when contestation_nationalite_personne_physique(p); then juridiction_civile_seule_competente(p); }

@source(CC_ART29_5)
rule EffetErgaOmnesJugementNationalite(p: Personne) strict { label fr official "Article 29-5. Le jugement de nationalité produit effet même envers les non-parties"; label en unofficial "Article 29-5. A nationality judgment has effect even against non-parties"; when jugement_nationalite_rendu(p); then jugement_nationalite_opposable_a_tous(p); }

@source(CC_ART30_1)
rule PreuveToutesConditionsNationalite(p: Personne) strict { label fr official "Article 30-1. Hors déclaration ou décret, la preuve exige toutes les conditions légales"; label en unofficial "Article 30-1. Outside declaration or decree, proof requires all statutory conditions"; when toutes_conditions_nationalite_prouvees(p); then preuve_nationalite_satisfaite(p); }

@source(CC_ART30_2)
rule PresomptionFiliationPossessionEtat(p: Personne) strict { label fr official "Article 30-2. La possession d'état constante de l'intéressé et du parent fait présumer la nationalité par filiation"; label en unofficial "Article 30-2. Constant possession of status by the person and parent presumes nationality by descent"; when possession_etat_constante_parent_et_enfant(p); then preuve_filiation_nationalite_presumee(p); }

@source(CC_ART30_3)
rule IrrecevabilitePreuveFiliationDemiSiecle(p: Personne) strict { label fr official "Article 30-3. Un demi-siècle à l'étranger sans possession d'état rend la preuve par filiation irrecevable"; label en unofficial "Article 30-3. Half a century abroad without possession of status makes descent proof inadmissible"; when ascendants_etranger_demi_siecle_sans_possession_etat(p); then preuve_filiation_irrecevable(p); }

@source(CC_ART30_4)
rule PreuveExtraneiteAucuneCondition(p: Personne) strict { label fr official "Article 30-4. L'extranéité se prouve par l'absence de toute condition de la qualité de Français"; label en unofficial "Article 30-4. Foreign status is proved by absence of every condition for French status"; when aucune_condition_qualite_francais(p); then preuve_extraneite_satisfaite(p); }

@source(CC_ART31_2)
rule ForceProbanteCertificatNationalite(p: Personne) strict { label fr official "Article 31-2. Le certificat indiquant la base légale et les documents fait foi jusqu'à preuve contraire"; label en unofficial "Article 31-2. A certificate stating the legal basis and documents is authoritative until rebutted"; when certificat_indique_base_legale_et_documents(p); then certificat_nationalite_fait_foi(p); }

@source(CC_ART21_29)
rule CommunicationMaireCeremonie(p: Personne) strict { label fr official "Article 21-29. La communication de l'identité et de l'adresse permet d'autoriser le maire à organiser la cérémonie"; label en unofficial "Article 21-29. Sending identity and address permits authorizing the mayor to hold the ceremony"; when identite_adresse_beneficiaire_ceremonie_communiquees(p); then maire_peut_organiser_ceremonie(p); }

@source(CC_ART23_7)
rule PerteComportementNationalEtranger(p: Personne) strict { label fr official "Article 23-7. Le comportement de national étranger assorti de cette nationalité ouvre la perte par décret"; label en unofficial "Article 23-7. Acting as a foreign national while holding that nationality opens loss by decree"; when comportement_national_etranger_et_nationalite_etrangere(p); then perte_article_23_7_admissible(p); }

@source(CC_ART26_1)
rule EnregistrementDeclarationNationalite(p: Personne) strict { label fr official "Article 26-1. L'enregistrement par l'autorité compétente conditionne la validité de la déclaration"; label en unofficial "Article 26-1. Registration by the competent authority conditions declaration validity"; when declaration_nationalite_enregistree_autorite_competente(p); then declaration_nationalite_valable(p); }

@source(CC_ART28)
rule MentionMarginaleNationalite(p: Personne) strict { label fr official "Article 28. Les actes, certificats et jugements relatifs à la nationalité sont mentionnés sur l'acte de naissance"; label en unofficial "Article 28. Nationality instruments, certificates and judgments are noted on the birth record"; when acte_nationalite_a_mentionner_naissance(p); then mention_nationalite_marginale_requise(p); }

@source(CC_ART32_1)
rule ConservationFrancaisAlgerieStatutCommun(p: Personne) strict { label fr official "Article 32-1. Le Français de statut commun domicilié en Algérie conserve sa nationalité"; label en unofficial "Article 32-1. A French ordinary-status person domiciled in Algeria retains nationality"; when francais_statut_commun_algerie_1962(p); then nationalite_francaise_conservee(p); }

@source(CC_ART32_2)
rule PreuveFrancaisNeAlgerie(p: Personne) strict { label fr official "Article 32-2. La naissance en Algérie avant le 22 juillet 1962 et la possession d'état constante établissent la nationalité"; label en unofficial "Article 32-2. Birth in Algeria before 22 July 1962 and constant possession of status establish nationality"; when ne_algerie_avant_22_juillet_1962_possession_etat(p); then preuve_nationalite_satisfaite(p); }

@source(CC_ART32_3)
rule ConservationAncienTerritoire(p: Personne) strict { label fr official "Article 32-3. Le domicilié de l'ancien territoire conserve la nationalité si aucune autre ne lui est conférée"; label en unofficial "Article 32-3. A resident of the former territory retains nationality if no other nationality is conferred"; when domicilie_ancien_territoire_independance_sans_autre_nationalite(p); then nationalite_francaise_conservee(p); }

@source(CC_ART32_4)
rule ReintegrationAncienParlementaire(p: Personne) strict { label fr official "Article 32-4. L'ancien parlementaire réinstallé en France peut être réintégré par simple déclaration"; label en unofficial "Article 32-4. A former member of parliament resettled in France may be restored by simple declaration"; when ancien_parlementaire_reinstalle_france(p); then reintegration_simple_declaration_admissible(p); }

@source(CC_ART32_5)
rule DeclarationReintegrationDixHuitAns(p: Personne, naissance: Date, jour: Date) strict { label fr official "Article 32-5. La déclaration personnelle de réintégration est ouverte dès dix-huit ans"; label en unofficial "Article 32-5. The personal restoration declaration is open from age eighteen"; when declaration_reintegration_ancien_parlementaire(p) and ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(naissance, 18 calendar_year); then declaration_reintegration_personnelle_admissible(p); }

@source(CC_ART17_10)
rule AcquisitionTerritoiresRetrocedes(p: Personne) strict { label fr official "Article 17-10. Le transfert en France depuis les territoires rétrocédés exige les conditions de la loi du 14 octobre 1814"; label en unofficial "Article 17-10. Transfer to France from retroceded territories requires the conditions of the Act of 14 October 1814"; when conditions_loi_14_octobre_1814_satisfaites(p); then acquisition_historique_nationalite_admissible(p); }

@source(CC_ART17_11)
rule ChangementConventionExpresse(p: Personne) strict { label fr official "Article 17-11. Une convention internationale ne change la nationalité que si elle le prévoit expressément"; label en unofficial "Article 17-11. An international convention changes nationality only if it expressly so provides"; when convention_internationale_prevoit_changement_nationalite(p); then changement_nationalite_conventionnel_admissible(p); }

@source(CC_ART33_1)
rule ReceptionDeclarationOutreMer(p: Personne) strict { label fr official "Article 33-1. Le président ou juge local reçoit la déclaration à la place du greffe judiciaire"; label en unofficial "Article 33-1. The local president or judge receives the declaration instead of the judicial registry"; when declaration_outre_mer_recue_president_ou_juge(p); then autorite_reception_declaration_competente(p); }

@source(CC_ART17_1)
rule ApplicationLoiNouvelleMineur(p: Personne) strict { label fr official "Article 17-1. La loi nouvelle d'attribution d'origine s'applique aux personnes encore mineures à son entrée en vigueur"; label en unofficial "Article 17-1. A new original-nationality law applies to persons still minors on entry into force"; when mineur_a_entree_vigueur_loi_nationalite(p); then loi_nouvelle_nationalite_applicable(p); }

@source(CC_ART17_2)
rule LoiAuTempsActeOuFait(p: Personne, jour: Date) strict { label fr official "Article 17-2. L'acquisition et la perte sont régies par la loi au temps de l'acte ou du fait"; label en unofficial "Article 17-2. Acquisition and loss are governed by law at the time of the act or fact"; when acte_ou_fait_nationalite_le(p, jour); then loi_nationalite_applicable_au_jour(p, jour); }

@source(CC_ART17_4)
rule DefinitionTerritorialeFrance(p: Personne) strict { label fr official "Article 17-4. Le territoire métropolitain, ultramarin, calédonien et austral compte comme la France"; label en unofficial "Article 17-4. Metropolitan, overseas, New Caledonian and southern territory counts as France"; when territoire_dans_definition_france(p); then lieu_compte_comme_france(p); }

@source(CC_ART17_5)
rule MajoriteSelonLoiFrancaise(p: Personne) strict { label fr official "Article 17-5. Majorité et minorité s'entendent selon la loi française"; label en unofficial "Article 17-5. Majority and minority are understood under French law"; when ressortissant_francais(p); then majorite_selon_loi_francaise(p); }

@source(CC_ART17_8) {
  rule AcquisitionTerritoireAnnexe(p: Personne) strict { label fr official "Article 17-8. Le national cédant domicilié dans le territoire annexé acquiert la nationalité française"; label en unofficial "Article 17-8. A ceding-State national domiciled in annexed territory acquires French nationality"; when national_etat_cedant_domicilie_territoire_annexe(p); then nationalite_francaise(p); }
  rule PerteTerritoireCede(p: Personne) strict { label fr official "Article 17-8. Le Français domicilié dans le territoire cédé perd la nationalité"; label en unofficial "Article 17-8. A French national domiciled in ceded territory loses nationality"; when francais_domicilie_territoire_cede(p); then nationalite_francaise_perdue_transfert(p); }
}

@source(CC_ART17_12)
rule FormeOptionLoiPays(p: Personne) strict { label fr official "Article 17-12. La forme de l'option est régie par la loi du pays où elle est instituée"; label en unofficial "Article 17-12. The form of an option is governed by the law of the country where it is instituted"; when option_nationalite_instituee_dans_pays(p); then forme_option_regie_par_loi_pays(p); }

@source(CC_ART21_27_1)
rule DeclarationAutresNationalites(p: Personne) strict { label fr official "Article 21-27-1. Lors de l'acquisition, l'intéressé indique les nationalités possédées, conservées et abandonnées"; label en unofficial "Article 21-27-1. On acquisition, the person states held, retained and renounced nationalities"; when nationalites_existantes_et_renoncees_indiquees(p); then obligation_declaration_plurinationalite_satisfaite(p); }

@source(CC_ART24)
rule OuvertureReintegration(p: Personne) strict { label fr official "Article 24. La preuve de l'ancienne qualité de Français ouvre la réintégration par décret ou déclaration"; label en unofficial "Article 24. Proof of former French status opens restoration by decree or declaration"; when ancienne_qualite_francais_prouvee(p); then reintegration_par_decret_ou_declaration_ouverte(p); }

@source(CC_ART26)
rule ReceptionEtRecepisseDeclaration(p: Personne) strict { label fr official "Article 26. La réception par l'autorité de la catégorie et la remise des pièces ouvrent le récépissé"; label en unofficial "Article 26. Receipt by the category authority and submission of documents open the receipt"; when declaration_recue_selon_categorie_26(p); then recepisse_declaration_nationalite_du(p); }

@source(CC_ART27_3)
rule ContradictoireAvantPerte(p: Personne) strict { label fr official "Article 27-3. La perte ou déchéance par décret exige que l'intéressé soit entendu ou appelé"; label en unofficial "Article 27-3. Loss or deprivation by decree requires the person to be heard or invited"; when interesse_entendu_ou_appele_avant_decret_perte(p); then procedure_decret_perte_respectee(p); }

@source(CC_ART28_1)
rule MentionsNationaliteCopiesExtraits(p: Personne) strict { label fr official "Article 28-1. Les mentions de nationalité sont portées sur les copies et extraits selon leur catégorie"; label en unofficial "Article 28-1. Nationality notes are entered on copies and extracts according to category"; when mentions_nationalite_portees_copies_extraits(p); then publicite_mentions_nationalite_conforme(p); }

@source(CC_ART29_4)
rule ActionObligatoireProcureur(p: Personne) strict { label fr official "Article 29-4. La réquisition d'une administration ou d'un tiers oblige le procureur à agir"; label en unofficial "Article 29-4. A request by an authority or third party requires the prosecutor to act"; when administration_requiert_action_procureur(p); then procureur_tenu_agir_nationalite(p); }

@source(CC_ART31)
rule CompetenceDelivranceCertificat(p: Personne) strict { label fr official "Article 31. Le greffe judiciaire est seul habilité à délivrer le certificat au demandeur justifiant sa nationalité"; label en unofficial "Article 31. The judicial registry alone may issue the certificate to an applicant proving nationality"; when demande_certificat_avec_justification_nationalite(p); then greffe_seul_habilite_certificat(p); }

@source(CC_ART32)
rule ConservationNationaliteTerritoireIndependant(p: Personne) strict { label fr official "Article 32. Les originaires de la République de 1960 domiciliés dans le territoire à l'indépendance conservent la nationalité"; label en unofficial "Article 32. Persons originating in the 1960 Republic and domiciled in the territory at independence retain nationality"; when originaire_republique_1960_domicilie_territoire_independant(p); then nationalite_francaise_conservee(p); }

@source(CC_ART33_2)
rule CertificatOutreMerPresidentOuJuge(p: Personne) strict { label fr official "Article 33-2. Le président ou juge local est seul habilité à délivrer le certificat ultramarin"; label en unofficial "Article 33-2. The local president or judge alone may issue the overseas certificate"; when demande_certificat_outre_mer_justifiee(p); then president_ou_juge_seul_habilite_certificat(p); }

@source(CC_ART33)
rule TerminologieJuridictionOutreMer(c: ContexteTerritorial) strict {
    label fr official "Article 33, 1°. Pour l'application ultramarine du titre, tribunal de première instance remplace tribunal de grande instance";
    label en unofficial "Article 33(1). For overseas application of the title, court of first instance replaces regional court";
    when application_titre_nationalite_outre_mer(c);
    then termes_tribunal_premiere_instance_substitues(c);
}

@source(CC_ART33)
rule TerminologieCollectiviteOutreMer(c: ContexteTerritorial) strict {
    label fr official "Article 33, 2°. Aux articles 21-28 et 21-29, collectivité ou Nouvelle-Calédonie remplace département";
    label en unofficial "Article 33(2). In Articles 21-28 and 21-29, collectivity or New Caledonia replaces department";
    when application_titre_nationalite_outre_mer(c);
    then termes_collectivite_ou_nouvelle_caledonie_substitues(c);
}

@source(CC_ART33)
rule SanctionPecuniaireOutreMer(c: ContexteTerritorial) strict {
    label fr official "Article 33. La sanction pécuniaire de l'article 68 est prononcée en monnaie locale selon la contre-valeur de l'euro";
    label en unofficial "Article 33. The monetary penalty under Article 68 is imposed in local currency using the euro equivalent";
    when application_titre_nationalite_outre_mer(c) and contre_valeur_euro_en_monnaie_locale_etablie(c);
    then sanction_article_68_prononcee_en_monnaie_locale(c);
}
