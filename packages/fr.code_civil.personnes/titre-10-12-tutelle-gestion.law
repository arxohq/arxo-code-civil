// TITRES X ET XII — TUTELLE DU MINEUR ET GESTION DU PATRIMOINE.
//
// Les décisions du juge et du conseil de famille entrent avec une origine
// juridictionnelle. Le paquet exécute leurs conditions légales, leurs effets,
// les délais et les positions du tuteur ; il ne choisit pas à leur place.

language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

use self::{
    CC_ART388,
    CC_ART388_1,
    CC_ART388_1_1,
    CC_ART388_1_2,
    CC_ART388_2,
    CC_ART391,
    CC_ART392,
    CC_ART393,
    CC_ART394,
    CC_ART395,
    CC_ART396,
    CC_ART397,
    CC_ART398,
    CC_ART399,
    CC_ART400,
    CC_ART401,
    CC_ART402,
    CC_ART403,
    CC_ART404,
    CC_ART405,
    CC_ART406,
    CC_ART407,
    CC_ART408,
    CC_ART408_1,
    CC_ART409,
    CC_ART410,
    CC_ART411,
    CC_ART411_1,
    CC_ART412,
    CC_ART413,
    CC_ART413_2,
    CC_ART413_3,
    CC_ART413_4,
    CC_ART413_5,
    CC_ART413_6,
    CC_ART413_7,
    CC_ART413_8,
    CC_ART496,
    CC_ART497,
    CC_ART498,
    CC_ART499,
    CC_ART500,
    CC_ART501,
    CC_ART502,
    CC_ART503,
    CC_ART504,
    CC_ART505,
    CC_ART506,
    CC_ART507,
    CC_ART507_1,
    CC_ART507_2,
    CC_ART508,
    CC_ART509,
    CC_ART510,
    CC_ART511,
    CC_ART512,
    CC_ART513,
    CC_ART513_1,
    CC_ART514,
    CC_ART515,
    MesureDeProtection,
    Personne,
    age_requis_pour_l_emancipation,
    capable_comme_un_majeur,
    date_d_appreciation,
    decede_le,
    emancipe,
    majeur,
    mesure_demandee_pour,
    mesure_ouverte,
    mineur,
    mineur_non_emancipe,
    ne_le,
    parent_de,
    subroge_surveille_et_informe_juge,
    tutelle_ouverte,
    tuteur_de,
};

pub entity ChargeTutelaire {
    label fr official "charge tutélaire d'un mineur";
    label en unofficial "guardianship office for a minor";
}
pub entity ConseilDeFamille {
    label fr official "conseil de famille de la tutelle";
    label en unofficial "family council for the guardianship";
}
pub entity ActeDeGestion {
    label fr official "acte relatif à la gestion du patrimoine protégé";
    label en unofficial "act concerning management of the protected estate";
}
pub entity CompteDeGestion {
    label fr official "compte de gestion de la tutelle";
    label en unofficial "guardianship management account";
}

// Entrées juridictionnelles et matérielles du titre X.
pub external judgment relation discernement_du_mineur(p: Personne) {
    authority Court;
    label fr official "le mineur est capable de discernement (article 388-1)";
    label en unofficial "the minor is capable of discernment (Article 388-1)";
}
pub external judgment relation interet_du_mineur_388_1(p: Personne) {
    authority Court;
    label fr official "l'intérêt du mineur commande son audition par une personne désignée (article 388-1)";
    label en unofficial "the minor's interests require hearing by an appointed person (Article 388-1)";
}
pub external judgment relation opposition_d_interets_du_mineur(p: Personne, representant: Personne) {
    authority Court;
    label fr official "les intérêts du mineur sont en opposition avec ceux de son représentant (article 388-2)";
    label en unofficial "the minor's interests conflict with those of the representative (Article 388-2)";
}
pub external judgment relation cause_grave_ou_urgence_391(p: Personne) {
    authority Court;
    label fr official "une cause grave ou l'urgence justifie l'ouverture judiciaire de la tutelle (article 391)";
    label en unofficial "serious grounds or urgency justify judicial opening of guardianship (Article 391)";
}
pub external judgment relation cause_de_retrait_de_charge_tutelaire(c: ChargeTutelaire) {
    authority Court;
    label fr official "une cause de retrait de la charge tutélaire est établie (article 396)";
    label en unofficial "a ground for removing the guardianship office is established (Article 396)";
}
pub external judgment relation changement_important_396(c: ChargeTutelaire) {
    authority Court;
    label fr official "un changement important justifie le remplacement du titulaire (article 396)";
    label en unofficial "a material change justifies replacement of the office holder (Article 396)";
}
pub external judgment relation urgence_397(p: Personne) {
    authority Court;
    label fr official "l'urgence commande une mesure provisoire dans l'intérêt du mineur (article 397)";
    label en unofficial "urgency requires an interim measure in the minor's interests (Article 397)";
}
pub external judgment relation interet_du_mineur_399(p: Personne, membre: Personne) {
    authority Court;
    label fr official "le choix de ce membre sert l'intérêt du mineur (article 399)";
    label en unofficial "selecting this member serves the minor's interests (Article 399)";
}
pub external judgment relation interet_du_mineur_403(p: Personne, tuteur: Personne) {
    authority Court;
    label fr official "l'intérêt du mineur commande d'écarter le tuteur choisi par le parent (article 403)";
    label en unofficial "the minor's interests require setting aside the guardian chosen by the parent (Article 403)";
}
pub external judgment relation pluralite_de_tuteurs_appropriee(p: Personne) {
    authority Court;
    label fr official "la situation du mineur et son patrimoine justifient plusieurs tuteurs (article 405)";
    label en unofficial "the minor's situation and estate justify multiple guardians (Article 405)";
}
pub external judgment relation impossibilite_d_organiser_la_tutelle(p: Personne) {
    authority Court;
    label fr official "il est impossible d'organiser la tutelle avec un conseil de famille ou d'admettre l'enfant comme pupille de l'Etat (article 411)";
    label en unofficial "guardianship cannot be organized with a family council and the child cannot be admitted as a ward of the State (Article 411)";
}

pub relation examen_osseux_ordonne(p: Personne) kind empirical { label fr official "un examen osseux a été ordonné pour déterminer l'âge"; label en unofficial "a bone examination was ordered to determine age"; }
pub relation accord_examen_osseux(p: Personne) kind empirical { label fr official "l'intéressé a consenti à l'examen osseux"; label en unofficial "the person consented to the bone examination"; }
pub relation documents_identite_valables(p: Personne) kind empirical { label fr official "la personne dispose de documents d'identité valables"; label en unofficial "the person has valid identity documents"; }
pub relation age_allegue_vraisemblable(p: Personne) kind empirical { label fr official "l'âge allégué est vraisemblable"; label en unofficial "the alleged age is credible"; }
pub relation marge_erreur_precisee(p: Personne) kind empirical { label fr official "la conclusion de l'examen précise sa marge d'erreur"; label en unofficial "the examination conclusion states its margin of error"; }
pub relation demande_a_etre_entendu(p: Personne) kind empirical { label fr official "le mineur demande à être entendu"; label en unofficial "the minor asks to be heard"; }
pub relation mineur_informe_du_droit_audition(p: Personne) kind empirical { label fr official "le mineur a été informé de son droit à l'audition et à un avocat"; label en unofficial "the minor was informed of the right to be heard and assisted by counsel"; }
pub relation autorisation_administration_entreprise(p: Personne) kind empirical { label fr official "les administrateurs légaux ont autorisé les actes d'administration de l'entreprise par écrit avec leur liste"; label en unofficial "the legal administrators authorized the business administration acts in writing with their list"; }
pub relation administrateur_ad_hoc_designe(p: Personne, a: Personne) kind empirical { label fr official "un administrateur ad hoc indépendant a été désigné au mineur"; label en unofficial "an independent ad hoc administrator was appointed for the minor"; }
pub relation devoir_designer_administrateur_ad_hoc(p: Personne, a: Personne) kind empirical { label fr official "l'administrateur ad hoc indépendant doit être désigné"; label en unofficial "an independent ad hoc administrator must be appointed"; }
pub relation acte_disposition_pendant_demande(p: Personne, administrateur: Personne) kind empirical { label fr official "l'administrateur accomplit un acte de disposition pendant la demande"; label en unofficial "the administrator performs a disposition during the application"; }
pub relation acte_disposition_interdit_pendant_demande(p: Personne, administrateur: Personne) kind empirical { label fr official "l'acte de disposition est interdit pendant la demande"; label en unofficial "the disposition is prohibited during the application"; }
pub relation exercer_charge_tutelaire_interdite(p: Personne) kind empirical { label fr official "la personne exerce une charge tutélaire interdite"; label en unofficial "the person exercises a prohibited guardianship office"; }
pub relation devoir_organiser_tutelle(p: Personne) kind empirical { label fr official "la famille et la collectivité organisent la tutelle"; label en unofficial "the family and community organize guardianship"; }
pub relation organiser_conseil_famille(p: Personne) kind empirical { label fr official "le conseil de famille est organisé pour la tutelle"; label en unofficial "a family council is organized for guardianship"; }
pub relation composer_conseil_famille(c: ConseilDeFamille) kind empirical { label fr official "le conseil de famille comprend au moins quatre membres"; label en unofficial "the family council has at least four members"; }
pub relation exercer_action_responsabilite_tutelle(p: Personne) kind empirical { label fr official "la personne exerce l'action en responsabilité tutélaire"; label en unofficial "the person brings the guardianship liability action"; }
pub relation demander_emancipation_conseil(p: Personne) kind empirical { label fr official "le conseil de famille demande l'émancipation"; label en unofficial "the family council requests emancipation"; }
pub relation exercer_commerce_emancipe(p: Personne) kind empirical { label fr official "le mineur émancipé exerce le commerce autorisé"; label en unofficial "the emancipated minor carries on authorized trade"; }
pub relation demander_emancipation_judiciaire(p: Personne) kind empirical { label fr official "les père ou mère demandent l'émancipation judiciaire"; label en unofficial "a parent requests judicial emancipation"; }
pub relation accomplir_acte_vie_civile_emancipe(p: Personne) kind empirical { label fr official "le mineur émancipé accomplit un acte de la vie civile"; label en unofficial "the emancipated minor performs a civil-life act"; }
pub relation emancipation_ecarte_responsabilite_parentale(p: Personne) kind empirical { label fr official "l'émancipation écarte la responsabilité parentale de plein droit"; label en unofficial "emancipation excludes parents' strict liability"; }
pub relation adopter_deliberation_par_vote(c: ConseilDeFamille) kind empirical { label fr official "le conseil adopte la délibération par vote"; label en unofficial "the council adopts the resolution by vote"; }
pub relation designer_tuteur_par_conseil(p: Personne, tuteur: Personne) kind empirical { label fr official "le conseil désigne le tuteur"; label en unofficial "the council appoints the guardian"; }
pub relation informer_cotuteur_decision(p: Personne, tuteur: Personne) kind empirical { label fr official "le tuteur informe les autres tuteurs de sa décision"; label en unofficial "the guardian informs the other guardians of the decision"; }
pub relation autoriser_gestion_biens_conseil(p: Personne) kind empirical { label fr official "le conseil autorise la gestion des biens"; label en unofficial "the council authorizes estate management"; }
pub relation demander_nullite_deliberation(c: ConseilDeFamille, demandeur: Personne) kind empirical { label fr official "la personne demande la nullité de la délibération"; label en unofficial "the person seeks annulment of the resolution"; }
pub relation respecter_choix_tuteur(p: Personne, tuteur: Personne) kind empirical { label fr official "le choix du tuteur est respecté"; label en unofficial "the guardian choice is respected"; }
pub relation transmettre_charge_tutelaire(c: ChargeTutelaire, titulaire: Personne) kind empirical { label fr official "la charge tutélaire est transmise au successeur"; label en unofficial "the guardianship office is transferred to a successor"; }
pub relation charge_tutelaire_intransmissible(c: ChargeTutelaire) kind empirical { label fr official "la charge tutélaire est personnelle et intransmissible"; label en unofficial "the guardianship office is personal and non-transferable"; }
pub relation devoir_designer_subroge(p: Personne, subroge: Personne) kind empirical { label fr official "un subrogé tuteur doit être désigné"; label en unofficial "a deputy guardian must be appointed"; }
pub relation repondre_dommage_charge(c: ChargeTutelaire, titulaire: Personne) kind empirical { label fr official "l'organe répond du dommage causé par sa faute"; label en unofficial "the office holder answers for damage caused by fault"; }
pub relation tutelle_ouverte_par_decision(p: Personne) kind empirical { label fr official "le juge a décidé d'ouvrir la tutelle"; label en unofficial "the judge decided to open guardianship"; }
pub relation administration_legale_substituee(p: Personne) kind empirical { label fr official "le juge a substitué l'administration légale à la tutelle après reconnaissance"; label en unofficial "the judge substituted legal administration after recognition"; }
pub relation mainlevee_tutelle_mineur(p: Personne) kind empirical { label fr official "un jugement définitif a donné mainlevée de la tutelle du mineur"; label en unofficial "a final judgment discharged the minor's guardianship"; }
pub relation membre_du_conseil(c: ConseilDeFamille, p: Personne) kind empirical { label fr official "la personne est membre du conseil de famille"; label en unofficial "the person is a member of the family council"; }
pub relation nombre_de_membres(c: ConseilDeFamille, n: Integer) kind empirical { key(c); label fr official "nombre des membres du conseil de famille, hors juge"; label en unofficial "number of family council members, excluding the judge"; }
pub relation deliberation_adoptee(c: ConseilDeFamille) kind empirical { label fr official "la délibération a obtenu la majorité des voix avec voix prépondérante du juge en cas de partage"; label en unofficial "the resolution received a majority, with the judge's casting vote on a tie"; }
pub relation autorisation_conseil_entreprise(p: Personne) kind empirical { label fr official "le conseil de famille a autorisé par écrit les actes d'administration de l'entreprise"; label en unofficial "the family council authorized the business administration acts in writing"; }
pub relation deliberation_du(c: ConseilDeFamille, jour: Date) kind empirical { key(c); label fr official "jour de la délibération du conseil de famille"; label en unofficial "date of the family council resolution"; }
pub relation deliberation_obtenue_par_dol_fraude_ou_formalite_omise(c: ConseilDeFamille) kind empirical { label fr official "la délibération a été surprise par dol ou fraude ou omet une formalité substantielle"; label en unofficial "the resolution was procured by deceit or fraud or omitted a substantive formality"; }
pub relation parent_dernier_vivant_a_choisi_tuteur(p: Personne, tuteur: Personne) kind empirical { label fr official "le dernier parent vivant ayant conservé l'autorité a choisi le tuteur par testament ou déclaration notariée"; label en unofficial "the last surviving parent retaining authority chose the guardian by will or notarized declaration"; }
pub relation tuteur_testamentaire_absent_ou_fonctions_cessent(p: Personne) kind empirical { label fr official "aucun tuteur testamentaire n'existe ou ses fonctions ont cessé"; label en unofficial "there is no testamentary guardian or that guardian's functions ended"; }
pub relation tuteur_designe_par_conseil(p: Personne, tuteur: Personne) kind empirical { label fr official "le conseil de famille a désigné ce tuteur"; label en unofficial "the family council appointed this guardian"; }
pub relation titulaire_charge(c: ChargeTutelaire, p: Personne) kind empirical { key(c); label fr official "titulaire de la charge tutélaire"; label en unofficial "holder of the guardianship office"; }
pub relation charge_concerne_tuteur_ou_subroge(c: ChargeTutelaire) kind empirical { label fr official "la charge concerne le tuteur ou le subrogé tuteur"; label en unofficial "the office concerns the guardian or deputy guardian"; }
pub relation titulaire_entendu_avant_retrait(c: ChargeTutelaire) kind empirical { label fr official "le titulaire a été entendu ou appelé avant le retrait"; label en unofficial "the holder was heard or summoned before removal"; }
pub relation subroge_tuteur_de(subroge: Personne, protege: Personne) kind empirical { label fr official "subrogé tuteur de la personne protégée"; label en unofficial "deputy guardian of the protected person"; }
pub relation charge_tutelaire_interdite(p: Personne) kind derived { label fr official "la personne ne peut exercer une charge tutélaire"; label en unofficial "the person may not hold a guardianship office"; }
pub relation conseil_de_famille_requis(p: Personne) kind derived { label fr official "la tutelle doit être organisée avec un conseil de famille"; label en unofficial "guardianship must be organized with a family council"; }
pub relation conseil_de_famille_conforme(c: ConseilDeFamille) kind derived { label fr official "le conseil de famille compte au moins quatre membres"; label en unofficial "the family council has at least four members"; }
pub relation competence_du_conseil_de_famille(p: Personne) kind derived { label fr official "le conseil de famille règle l'entretien, l'éducation et les autorisations de gestion"; label en unofficial "the family council determines maintenance, education and management authorizations"; }
pub relation deliberation_valable(c: ConseilDeFamille) kind derived { label fr official "la délibération est adoptée conformément à la règle de vote"; label en unofficial "the resolution was adopted under the voting rule"; }
pub relation deliberation_nulle(c: ConseilDeFamille) kind derived { label fr official "la délibération du conseil de famille est nulle"; label en unofficial "the family council resolution is void"; }
pub relation action_nullite_deliberation_expire_le(c: ConseilDeFamille, jour: Date) kind derived { key(c); label fr official "terme de deux ans de l'action en nullité de la délibération"; label en unofficial "end of the two-year action to annul the resolution"; }
pub relation charge_retirable_ou_remplacable(c: ChargeTutelaire) kind derived { label fr official "la charge tutélaire peut être retirée ou son titulaire remplacé"; label en unofficial "the guardianship office may be removed or its holder replaced"; }
pub relation tutelle_mineur_terminee(p: Personne) kind derived { label fr official "la tutelle du mineur a pris fin"; label en unofficial "the minor's guardianship ended"; }
pub relation tutelle_vacante(p: Personne) kind derived { label fr official "la tutelle est vacante et déférée à la collectivité publique compétente"; label en unofficial "guardianship is vacant and referred to the competent public authority"; }
pub relation action_responsabilite_tutelle_expire_le(p: Personne, jour: Date) kind derived { key(p); label fr official "terme de cinq ans de l'action en responsabilité relative à la tutelle du mineur"; label en unofficial "end of the five-year action concerning minor guardianship liability"; }
pub relation compte_du_au_mineur_emancipe(p: Personne) kind derived { label fr official "le compte de tutelle doit être rendu au mineur émancipé"; label en unofficial "the guardianship account is due to the emancipated minor"; }
pub relation capacite_emancipee_limitee_pour_mariage_ou_adoption(p: Personne) kind derived { label fr official "l'émancipation ne dispense pas des règles du mariage ou de l'adoption"; label en unofficial "emancipation does not displace marriage or adoption rules"; }
pub relation responsabilite_parentale_de_plein_droit_ecartee(p: Personne) kind derived { label fr official "la seule qualité de parent n'emporte plus responsabilité de plein droit après l'émancipation"; label en unofficial "parenthood alone no longer entails strict liability after emancipation"; }
pub relation commercant_autorise(p: Personne) kind empirical { label fr official "le mineur émancipé a reçu l'autorisation judiciaire d'être commerçant"; label en unofficial "the emancipated minor received judicial authorization to trade"; }

@source(CC_ART388) {
    rule ExamenOsseuxEncadre(p: Personne) defeasible { label fr official "Article 388, alinéa 2. L'examen osseux exige une décision judiciaire, l'accord de l'intéressé, l'absence de documents valables et un âge allégué non vraisemblable"; label en unofficial "Article 388, paragraph 2. Bone examination requires a judicial decision, consent, no valid documents and an implausible alleged age"; when examen_osseux_ordonne(p) and accord_examen_osseux(p) and not_known(documents_identite_valables(p)) and not_known(age_allegue_vraisemblable(p)); then marge_erreur_precisee(p); }
    rule DouteProfiteAuMineur(p: Personne) defeasible { label fr official "Article 388, alinéa 3. Le doute sur l'âge profite à l'intéressé"; label en unofficial "Article 388, paragraph 3. Doubt as to age benefits the person"; when examen_osseux_ordonne(p) and marge_erreur_precisee(p); then mineur(p); }
}

@source(CC_ART388_1) {
    rule DroitDuMineurDEtreEntendu(p: Personne) defeasible { label fr official "Article 388-1. Le mineur capable de discernement qui le demande est entendu de droit"; label en unofficial "Article 388-1. A discerning minor who asks to be heard is entitled to a hearing"; when mineur(p) and discernement_du_mineur(p) and demande_a_etre_entendu(p); then liberty EtreEntenduDansLaProcedure { holder p; action demande_a_etre_entendu(p); window [@2007-01-01, infinity); }; }
    rule InformationDuMineurSurLAudition(p: Personne) defeasible { label fr official "Article 388-1, alinéa 4. Le juge s'assure que le mineur est informé de son droit à être entendu et assisté"; label en unofficial "Article 388-1, paragraph 4. The judge ensures that the minor is informed of the right to be heard and assisted"; when mineur(p); then mineur_informe_du_droit_audition(p); }
}

@source(CC_ART388_1_1)
rule RepresentationLegaleDuMineur(p: Personne, administrateur: Personne) defeasible { label fr official "Article 388-1-1. L'administrateur légal représente le mineur dans les actes de la vie civile"; label en unofficial "Article 388-1-1. The legal administrator represents the minor in civil acts"; when parent_de(administrateur, p) and mineur_non_emancipe(p); then tuteur_de(administrateur, p); }
pub relation representer_mineur(p: Personne, administrateur: Personne) kind empirical { label fr official "l'administrateur représente le mineur dans les actes de la vie civile"; label en unofficial "the administrator represents the minor in civil acts"; }
pub relation administrateur_legal_du_mineur(p: Personne, administrateur: Personne) kind empirical { label fr official "la personne est l'administrateur légal du mineur"; label en unofficial "the person is the minor's legal administrator"; }
@source(CC_ART388_1_1)
rule PositionDevoirRepresenterMineur(p: Personne, administrateur: Personne) strict {
    label fr official "Article 388-1-1. L'administrateur légal doit représenter le mineur";
    label en unofficial "Article 388-1-1. The legal administrator must represent the minor";
    when administrateur_legal_du_mineur(p, administrateur);
    then duty DevoirRepresenterMineur {
        bearer administrateur;
        goal achievement {
            condition representer_mineur(p, administrateur);
            window [@2007-01-01, infinity];
        };
    };
}

@source(CC_ART388_1_2) {
    rule AgeRequisPourActesAdministrationEntreprise(p: Personne, naissance: Date, jour: Date) defeasible { label fr official "Article 388-1-2. Seize ans révolus sont requis pour être autorisé à administrer seul l'entreprise"; label en unofficial "Article 388-1-2. Sixteen full years are required for authorization to administer the business alone"; when ne_le(p, naissance) and date_d_appreciation(p, jour) and jour >= add_calendar_period(naissance, 16 calendar_year); then age_requis_pour_l_emancipation(p); }
    rule AutorisationActesAdministrationEntreprise(p: Personne) defeasible { label fr official "Article 388-1-2. L'autorisation écrite et sa liste permettent au mineur les seuls actes d'administration"; label en unofficial "Article 388-1-2. Written authorization and its list permit only administration acts"; when mineur(p) and age_requis_pour_l_emancipation(p) and autorisation_administration_entreprise(p); then capable_comme_un_majeur(p); }
}

@source(CC_ART388_1_2)
rule PositionPouvoirAdministrerEntreprise(p: Personne) strict {
    label fr official "Article 388-1-2. Le mineur autorisé peut accomplir seul les actes d'administration de l'entreprise";
    label en unofficial "Article 388-1-2. An authorized minor may perform enterprise administration acts alone";
    when capable_comme_un_majeur(p) and autorisation_administration_entreprise(p);
    then liberty PouvoirAdministrerEntreprise {
        holder p;
        action autorisation_administration_entreprise(p);
        window [@2016-02-01, infinity);
    };
}

@source(CC_ART388_2)
rule AdministrateurAdHocDuMineur(p: Personne, representant: Personne, ad_hoc: Personne) defeasible { label fr official "Article 388-2. L'opposition d'intérêts impose la désignation d'un administrateur ad hoc indépendant"; label en unofficial "Article 388-2. A conflict of interests requires an independent ad hoc administrator"; when opposition_d_interets_du_mineur(p, representant) and administrateur_ad_hoc_designe(p, ad_hoc); then tuteur_de(ad_hoc, p); }
pub relation administrateur_ad_hoc_pourvu(p: Personne) kind derived { label fr official "un administrateur ad hoc a été désigné pour représenter le mineur"; label en unofficial "an ad hoc administrator was appointed to represent the minor"; }
@source(CC_ART388_2)
rule AdministrateurAdHocPourvu(p: Personne, a: Personne) strict { label fr official "Article 388-2. Le mineur est pourvu d'un administrateur ad hoc lorsqu'un administrateur a été désigné"; label en unofficial "Article 388-2. The minor has an ad hoc administrator once one has been appointed"; when administrateur_ad_hoc_designe(p, a); then administrateur_ad_hoc_pourvu(p); }
@source(CC_ART388_2)
rule PositionDevoirDesignerAdministrateurAdHoc(p: Personne) strict {
    label fr official "Article 388-2. Un administrateur ad hoc indépendant doit être désigné";
    label en unofficial "Article 388-2. An independent ad hoc administrator must be appointed";
    when opposition_d_interets_du_mineur(p, _);
    then duty DevoirDesignerAdministrateurAdHoc {
        bearer entity_ref("urn:fr:cc:personnes:autorite-tutelle");
        beneficiary p;
        goal achievement {
            condition administrateur_ad_hoc_pourvu(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART391) {
    rule OuvertureJudiciaireDeLaTutelle(p: Personne) defeasible { label fr official "Article 391. En cas d'administration légale, le juge peut ouvrir la tutelle pour cause grave"; label en unofficial "Article 391. Under legal administration, the judge may open guardianship for serious grounds"; when cause_grave_ou_urgence_391(p) and tutelle_ouverte_par_decision(p); then tutelle_ouverte(p); }
    rule InterdictionActeDispositionPendantDemande(p: Personne, administrateur: Personne) defeasible { label fr official "Article 391. De la demande au jugement définitif, l'administrateur légal ne peut accomplir d'acte de disposition sauf urgence"; label en unofficial "Article 391. From the application to final judgment, the legal administrator may not make a disposition absent urgency"; when parent_de(administrateur, p) and tutelle_ouverte_par_decision(p) and not_known(cause_grave_ou_urgence_391(p)); then charge_tutelaire_interdite(administrateur); }
}

@source(CC_ART391)
rule PositionInterdictionActeDispositionPendantDemande(p: Personne, administrateur: Personne) strict {
    label fr official "Article 391. L'administrateur ne peut accomplir un acte de disposition pendant la demande";
    label en unofficial "Article 391. The administrator may not perform a disposition during the application";
    when acte_disposition_interdit_pendant_demande(p, administrateur);
    then prohibition InterdictionActeDispositionDemande {
        bearer administrateur;
        action acte_disposition_pendant_demande(p, administrateur);
        window [@2009-01-01, infinity);
    };
}
@source(CC_ART391)
rule MaintenanceInterdictionActeDispositionDemande(p: Personne, administrateur: Personne) strict {
    label fr official "Maintenir l'interdiction InterdictionActeDispositionDemande";
    label en unofficial "Maintain prohibition InterdictionActeDispositionDemande";
    when acte_disposition_interdit_pendant_demande(p, administrateur);
    then duty MaintenanceInterdictionActeDispositionDemandeDuty {
        bearer administrateur;
        goal maintenance {
            condition not acte_disposition_pendant_demande(p, administrateur);
            window [@1804-03-21, infinity);
        };
    };
}


@source(CC_ART392)
rule SubstitutionAdministrationLegale(p: Personne) defeasible { label fr official "Article 392. La décision de substitution met fin à la tutelle au profit de l'administration légale"; label en unofficial "Article 392. The substitution decision ends guardianship in favor of legal administration"; when administration_legale_substituee(p); then tutelle_mineur_terminee(p); }
pub relation executer_fin_tutelle_substitution(p: Personne) kind empirical { label fr official "la tutelle prend fin par substitution de l'administration légale"; label en unofficial "guardianship ends by substitution of legal administration"; }
@source(CC_ART392)
rule PositionDevoirExecuterFinTutelleSubstitution(p: Personne) strict {
    label fr official "Article 392. La tutelle doit prendre fin en cas de substitution";
    label en unofficial "Article 392. Guardianship must end in case of substitution";
    when administration_legale_substituee(p);
    then duty DevoirExecuterFinTutelleSubstitution {
        bearer entity_ref("urn:fr:cc:personnes:juge-tutelles");
        goal achievement {
            condition executer_fin_tutelle_substitution(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART393) {
    rule FinTutelleParEmancipation(p: Personne) defeasible { label fr official "Article 393. La tutelle prend fin à l'émancipation"; label en unofficial "Article 393. Guardianship ends on emancipation"; when emancipe(p); then tutelle_mineur_terminee(p); }
    rule FinTutelleParMajorite(p: Personne) defeasible { label fr official "Article 393. La tutelle prend fin à la majorité"; label en unofficial "Article 393. Guardianship ends at majority"; when majeur(p); then tutelle_mineur_terminee(p); }
    rule FinTutelleParMainlevee(p: Personne) defeasible { label fr official "Article 393. La tutelle prend fin par jugement définitif de mainlevée"; label en unofficial "Article 393. Guardianship ends by a final discharge judgment"; when mainlevee_tutelle_mineur(p); then tutelle_mineur_terminee(p); }
    rule FinTutelleParDeces(p: Personne, jour: Date) defeasible { label fr official "Article 393. La tutelle prend fin au décès"; label en unofficial "Article 393. Guardianship ends on death"; when decede_le(p, jour); then tutelle_mineur_terminee(p); }
}
pub relation executer_fin_tutelle_mineur(p: Personne) kind empirical { label fr official "la tutelle du mineur prend fin dans un cas légal"; label en unofficial "the minor's guardianship ends in a statutory case"; }
@source(CC_ART393)
rule PositionDevoirExecuterFinTutelleMineur(p: Personne) strict {
    label fr official "Article 393. La tutelle du mineur doit prendre fin dans les cas légaux";
    label en unofficial "Article 393. The minor's guardianship must end in the statutory cases";
    when tutelle_mineur_terminee(p);
    then duty DevoirExecuterFinTutelleMineur {
        bearer entity_ref("urn:fr:cc:personnes:juge-tutelles");
        goal achievement {
            condition executer_fin_tutelle_mineur(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART394)
rule ChargePubliqueDeTutelle(p: Personne) defeasible { label fr official "Article 394. La tutelle est une charge publique et un devoir des familles et de la collectivité"; label en unofficial "Article 394. Guardianship is a public office and a duty of families and the public community"; when tutelle_ouverte(p); then conseil_de_famille_requis(p); }
@source(CC_ART394)
rule PositionDevoirOrganiserTutelle(p: Personne) strict {
    label fr official "Article 394. La tutelle doit être organisée par la famille et la collectivité";
    label en unofficial "Article 394. Guardianship must be organized by the family and community";
    when tutelle_ouverte(p);
    then duty DevoirOrganiserTutelle {
        bearer entity_ref("urn:fr:cc:personnes:famille-et-collectivite");
        goal achievement {
            condition devoir_organiser_tutelle(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART395) {
    rule MineurNonEmancipeInapteACharge(p: Personne) defeasible { label fr official "Article 395, 1°. Le mineur non émancipé ne peut exercer une charge tutélaire, sauf pour son enfant"; label en unofficial "Article 395(1). An unemancipated minor cannot hold a guardianship office, save for the minor's child"; when mineur_non_emancipe(p); then charge_tutelaire_interdite(p); }
    rule MajeurProtegeInapteACharge(p: Personne, m: MesureDeProtection) defeasible { label fr official "Article 395, 2°. Le majeur protégé ne peut exercer une charge tutélaire"; label en unofficial "Article 395(2). A protected adult cannot hold a guardianship office"; when mesure_demandee_pour(m, p) and mesure_ouverte(m); then charge_tutelaire_interdite(p); }
}

@source(CC_ART395)
rule PositionInterdictionExercerChargeTutelaire(p: Personne) strict {
    label fr official "Article 395. La personne inapte ne peut exercer une charge tutélaire";
    label en unofficial "Article 395. An ineligible person may not hold a guardianship office";
    when charge_tutelaire_interdite(p);
    then prohibition InterdictionExercerChargeTutelaire {
        bearer p;
        action exercer_charge_tutelaire_interdite(p);
        window [@2009-01-01, infinity);
    };
}
@source(CC_ART395)
rule MaintenanceInterdictionExercerChargeTutelaire(p: Personne) strict {
    label fr official "Maintenir l'interdiction InterdictionExercerChargeTutelaire";
    label en unofficial "Maintain prohibition InterdictionExercerChargeTutelaire";
    when charge_tutelaire_interdite(p);
    then duty MaintenanceInterdictionExercerChargeTutelaireDuty {
        bearer p;
        goal maintenance {
            condition not exercer_charge_tutelaire_interdite(p);
            window [@1804-03-21, infinity);
        };
    };
}


@source(CC_ART396) {
    rule RetraitChargeTutelaire(c: ChargeTutelaire) defeasible { label fr official "Article 396. Une cause établie permet le retrait de la charge"; label en unofficial "Article 396. An established ground permits removal from office"; when cause_de_retrait_de_charge_tutelaire(c); then charge_retirable_ou_remplacable(c); }
    rule RemplacementChargeTutelaire(c: ChargeTutelaire) defeasible { label fr official "Article 396. Un changement important permet le remplacement"; label en unofficial "Article 396. A material change permits replacement"; when changement_important_396(c); then charge_retirable_ou_remplacable(c); }
}

@source(CC_ART397)
rule AuditionAvantRetrait(c: ChargeTutelaire) defeasible { label fr official "Article 397. La charge ne peut être retirée qu'après audition ou convocation de son titulaire"; label en unofficial "Article 397. The office may be removed only after its holder is heard or summoned"; when charge_retirable_ou_remplacable(c) and titulaire_entendu_avant_retrait(c); then deliberation_valable(entity_ref("urn:fr:cc:personnes:conseil-retrait")); }
pub relation entendre_titulaire_charge(c: ChargeTutelaire) kind empirical { label fr official "le titulaire de la charge est entendu ou convoqué"; label en unofficial "the office holder is heard or summoned"; }
@source(CC_ART397)
rule PositionDevoirEntendreTitulaireCharge(c: ChargeTutelaire, p: Personne) strict {
    label fr official "Article 397. Le titulaire doit être entendu ou convoqué avant le retrait";
    label en unofficial "Article 397. The office holder must be heard or summoned before removal";
    when titulaire_charge(c, p) and charge_retirable_ou_remplacable(c);
    then duty DevoirEntendreTitulaireCharge {
        bearer p;
        goal achievement {
            condition entendre_titulaire_charge(c);
            window [@1965-07-15, infinity];
        };
    };
}

@source(CC_ART398)
rule ConseilDeFamilleRequis(p: Personne) defeasible { label fr official "Article 398. Sauf vacance, la tutelle est organisée avec un conseil de famille"; label en unofficial "Article 398. Except in vacancy, guardianship is organized with a family council"; when tutelle_ouverte(p) and not_known(tutelle_vacante(p)); then conseil_de_famille_requis(p); }
@source(CC_ART398)
rule PositionDevoirOrganiserConseilFamille(p: Personne) strict {
    label fr official "Article 398. La tutelle doit être organisée avec un conseil de famille";
    label en unofficial "Article 398. Guardianship must be organized with a family council";
    when conseil_de_famille_requis(p);
    then duty DevoirOrganiserConseilFamille {
        bearer entity_ref("urn:fr:cc:personnes:autorite-tutelle");
        goal achievement {
            condition organiser_conseil_famille(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART399)
rule CompositionMinimaleConseilDeFamille(c: ConseilDeFamille, n: Integer) defeasible { label fr official "Article 399. Le conseil de famille comprend au moins quatre membres, tuteur et subrogé compris, juge exclu"; label en unofficial "Article 399. The family council has at least four members including guardian and deputy, excluding the judge"; when nombre_de_membres(c, n) and n >= 4; then conseil_de_famille_conforme(c); }
pub relation conseil_de_famille_constitue(c: ConseilDeFamille) kind empirical { label fr official "le juge des tutelles a constitué le conseil de famille pour la durée de la tutelle"; label en unofficial "the guardianship judge constituted the family council for the duration of the guardianship"; }
@source(CC_ART399)
rule PositionDevoirComposerConseilFamille(c: ConseilDeFamille) strict {
    label fr official "Article 399. Le conseil de famille doit comprendre au moins quatre membres";
    label en unofficial "Article 399. The family council must have at least four members";
    when conseil_de_famille_constitue(c);
    then duty DevoirComposerConseilFamille {
        bearer entity_ref("urn:fr:cc:personnes:autorite-tutelle");
        goal achievement {
            condition composer_conseil_famille(c);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART400)
rule VoteDuConseilDeFamille(c: ConseilDeFamille) defeasible { label fr official "Article 400. Les délibérations sont adoptées par vote, la voix du juge étant prépondérante en cas de partage"; label en unofficial "Article 400. Resolutions are adopted by vote, with the judge's casting vote on a tie"; when deliberation_adoptee(c); then deliberation_valable(c); }
@source(CC_ART400)
rule PositionDevoirAdopterDeliberationParVote(c: ConseilDeFamille) strict {
    label fr official "Article 400. La délibération doit être adoptée par vote";
    label en unofficial "Article 400. The resolution must be adopted by vote";
    when deliberation_du(c, _);
    then duty DevoirAdopterDeliberationParVote {
        bearer entity_ref("urn:fr:cc:personnes:conseil-famille");
        goal achievement {
            condition adopter_deliberation_par_vote(c);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART401) {
    rule PouvoirsDuConseilDeFamille(p: Personne) defeasible { label fr official "Article 401. Le conseil règle l'entretien et l'éducation et autorise la gestion des biens"; label en unofficial "Article 401. The council determines maintenance and education and authorizes estate management"; when conseil_de_famille_requis(p); then competence_du_conseil_de_famille(p); }
    rule AutorisationEntrepriseASeizeAns(p: Personne) defeasible { label fr official "Article 401. Le conseil peut autoriser par écrit le mineur de seize ans à accomplir les actes d'administration listés"; label en unofficial "Article 401. The council may authorize in writing a sixteen-year-old minor to perform listed administration acts"; when age_requis_pour_l_emancipation(p) and autorisation_conseil_entreprise(p); then capable_comme_un_majeur(p); }
}
@source(CC_ART401)
rule PositionDevoirAutoriserGestionBiens(p: Personne) strict {
    label fr official "Article 401. La gestion des biens doit être autorisée par le conseil";
    label en unofficial "Article 401. Estate management must be authorized by the council";
    when competence_du_conseil_de_famille(p);
    then duty DevoirAutoriserGestionBiens {
        bearer entity_ref("urn:fr:cc:personnes:conseil-famille");
        goal achievement {
            condition autoriser_gestion_biens_conseil(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART402) {
    rule NulliteDeliberationConseil(c: ConseilDeFamille) defeasible { label fr official "Article 402. Dol, fraude ou omission d'une formalité substantielle rendent la délibération nulle"; label en unofficial "Article 402. Deceit, fraud or omission of a substantive formality makes the resolution void"; when deliberation_obtenue_par_dol_fraude_ou_formalite_omise(c); then deliberation_nulle(c); }
    rule DelaiNulliteDeliberation(c: ConseilDeFamille, jour: Date) defeasible { label fr official "Article 402. L'action en nullité se prescrit par deux ans depuis la délibération"; label en unofficial "Article 402. The action to annul is limited to two years from the resolution"; when deliberation_du(c, jour); then action_nullite_deliberation_expire_le(c, add_calendar_period(jour, 2 calendar_year)); }
}
@source(CC_ART402)
rule PositionPouvoirDemanderNulliteDeliberation(c: ConseilDeFamille, demandeur: Personne) strict {
    label fr official "Article 402. La personne peut demander la nullité de la délibération";
    label en unofficial "Article 402. A person may seek annulment of the resolution";
    when demander_nullite_deliberation(c, demandeur);
    then liberty PouvoirDemanderNulliteDeliberation {
        holder demandeur;
        action demander_nullite_deliberation(c, demandeur);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART403)
rule ChoixDuTuteurParLeDernierParent(p: Personne, tuteur: Personne) defeasible { label fr official "Article 403. Le choix testamentaire ou notarié du dernier parent s'impose, sauf intérêt contraire du mineur"; label en unofficial "Article 403. The last parent's testamentary or notarized choice binds unless the minor's interests require otherwise"; when parent_dernier_vivant_a_choisi_tuteur(p, tuteur) and not_known(interet_du_mineur_403(p, tuteur)); then tuteur_de(tuteur, p); }
@source(CC_ART403)
rule PositionDevoirRespecterChoixTuteur(p: Personne, tuteur: Personne) strict {
    label fr official "Article 403. Le choix du tuteur doit être respecté sauf intérêt contraire du mineur";
    label en unofficial "Article 403. The guardian choice must be respected unless contrary to the minor's interests";
    when parent_dernier_vivant_a_choisi_tuteur(p, tuteur);
    then duty DevoirRespecterChoixTuteur {
        bearer entity_ref("urn:fr:cc:personnes:conseil-famille");
        beneficiary p;
        goal achievement {
            condition respecter_choix_tuteur(p, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART404)
rule DesignationDuTuteurParLeConseil(p: Personne, tuteur: Personne) defeasible { label fr official "Article 404. A défaut de tuteur testamentaire, le conseil de famille désigne le tuteur"; label en unofficial "Article 404. In the absence of a testamentary guardian, the family council appoints the guardian"; when tuteur_testamentaire_absent_ou_fonctions_cessent(p) and tuteur_designe_par_conseil(p, tuteur); then tuteur_de(tuteur, p); }
pub relation tutelle_pourvue_d_un_tuteur_par_conseil(p: Personne) kind derived { label fr official "le conseil de famille a désigné un tuteur au mineur"; label en unofficial "the family council appointed a guardian for the minor"; }
@source(CC_ART404)
rule TutellePourvueParConseil(p: Personne, tuteur: Personne) strict { label fr official "Article 404. Le mineur est pourvu d'un tuteur lorsque le conseil de famille en a désigné un"; label en unofficial "Article 404. The minor has a guardian once the family council has appointed one"; when designer_tuteur_par_conseil(p, tuteur); then tutelle_pourvue_d_un_tuteur_par_conseil(p); }
@source(CC_ART404)
rule PositionDevoirDesignerTuteurParConseil(p: Personne) strict {
    label fr official "Article 404. Le conseil de famille doit désigner le tuteur";
    label en unofficial "Article 404. The family council must appoint the guardian";
    when tuteur_testamentaire_absent_ou_fonctions_cessent(p);
    then duty DevoirDesignerTuteurParConseil {
        bearer entity_ref("urn:fr:cc:personnes:conseil-famille");
        beneficiary p;
        goal achievement {
            condition tutelle_pourvue_d_un_tuteur_par_conseil(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART405)
rule PluraliteEtIndependanceDesTuteurs(p: Personne) defeasible { label fr official "Article 405. Le conseil peut désigner plusieurs tuteurs et répartir les fonctions ; ils s'informent de leurs décisions"; label en unofficial "Article 405. The council may appoint multiple guardians and divide functions; they inform each other of decisions"; when pluralite_de_tuteurs_appropriee(p); then conseil_de_famille_requis(p); }
pub relation plusieurs_tuteurs_exercent_en_commun(p: Personne, tuteur: Personne) kind empirical { label fr official "plusieurs tuteurs, dont ce tuteur, exercent en commun la mesure de protection"; label en unofficial "several guardians, including this one, jointly exercise the protection measure"; }
@source(CC_ART405)
rule PositionDevoirInformerCotuteur(p: Personne, tuteur: Personne) strict {
    label fr official "Article 405. Les tuteurs doivent s'informer de leurs décisions";
    label en unofficial "Article 405. The guardians must inform each other of their decisions";
    when plusieurs_tuteurs_exercent_en_commun(p, tuteur);
    then duty DevoirInformerCotuteur {
        bearer tuteur;
        goal achievement {
            condition informer_cotuteur_decision(p, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART406)
rule DureeDeLaChargeDuTuteur(c: ChargeTutelaire, p: Personne, tuteur: Personne) defeasible { label fr official "Article 406. Le tuteur est désigné pour la durée de la tutelle"; label en unofficial "Article 406. The guardian is appointed for the duration of guardianship"; when titulaire_charge(c, tuteur) and tuteur_de(tuteur, p) and tutelle_ouverte(p); then conseil_de_famille_requis(p); }
pub relation respecter_duree_charge_tutelle(c: ChargeTutelaire, p: Personne, tuteur: Personne) kind empirical { label fr official "la désignation du tuteur respecte la durée de la tutelle"; label en unofficial "the guardian appointment respects the duration of guardianship"; }
@source(CC_ART406)
rule PositionDevoirRespecterDureeChargeTutelle(c: ChargeTutelaire, p: Personne, tuteur: Personne) strict {
    label fr official "Article 406. La désignation du tuteur doit couvrir la durée de la tutelle";
    label en unofficial "Article 406. The guardian appointment must cover the duration of guardianship";
    when tuteur_designe_par_conseil(p, tuteur) and titulaire_charge(c, tuteur);
    then duty DevoirRespecterDureeChargeTutelle {
        bearer tuteur;
        beneficiary p;
        goal achievement {
            condition respecter_duree_charge_tutelle(c, p, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART407)
rule ChargeTutelairePersonnelleEtIntransmissible(c: ChargeTutelaire, titulaire: Personne) defeasible { label fr official "Article 407. La charge tutélaire est personnelle et ne se transmet pas aux héritiers"; label en unofficial "Article 407. The guardianship office is personal and does not pass to heirs"; when titulaire_charge(c, titulaire); then charge_concerne_tuteur_ou_subroge(c); }
@source(CC_ART407)
rule PositionInterdictionTransmettreChargeTutelaire(c: ChargeTutelaire, titulaire: Personne) strict {
    label fr official "Article 407. La charge tutélaire ne peut être transmise";
    label en unofficial "Article 407. The guardianship office may not be transferred";
    when titulaire_charge(c, titulaire) and charge_tutelaire_intransmissible(c);
    then prohibition InterdictionTransmettreChargeTutelaire {
        bearer titulaire;
        action transmettre_charge_tutelaire(c, titulaire);
        window [@2009-01-01, infinity);
    };
}
@source(CC_ART407)
rule MaintenanceInterdictionTransmettreChargeTutelaire(c: ChargeTutelaire, titulaire: Personne) strict {
    label fr official "Maintenir l'interdiction InterdictionTransmettreChargeTutelaire";
    label en unofficial "Maintain prohibition InterdictionTransmettreChargeTutelaire";
    when titulaire_charge(c, titulaire) and charge_tutelaire_intransmissible(c);
    then duty MaintenanceInterdictionTransmettreChargeTutelaireDuty {
        bearer titulaire;
        goal maintenance {
            condition not transmettre_charge_tutelaire(c, titulaire);
            window [@1804-03-21, infinity);
        };
    };
}


pub relation tuteur_prend_soin_du_mineur_et_le_represente(tuteur: Personne, protege: Personne) kind empirical { label fr official "le tuteur prend soin de la personne du mineur et le représente dans les actes de la vie civile"; label en unofficial "the guardian cares for the minor and represents the minor in civil acts"; }
@source(CC_ART408) {
    rule DevoirDePrendreSoinDuMineur(p: Personne, tuteur: Personne) defeasible { label fr official "Article 408. Le tuteur prend soin du mineur et le représente dans les actes de la vie civile"; label en unofficial "Article 408. The guardian cares for the minor and represents the minor in civil acts"; when tuteur_de(tuteur, p) and mineur_non_emancipe(p); then duty PrendreSoinEtRepresenterLeMineur { bearer tuteur; beneficiary p; maintain tuteur_prend_soin_du_mineur_et_le_represente(tuteur, p) during [@2009-01-01, infinity); }; }
    rule DevoirDeGererEtRendreCompte(p: Personne, tuteur: Personne) defeasible { label fr official "Article 408. Le tuteur gère les biens du mineur et rend compte conformément au titre XII"; label en unofficial "Article 408. The guardian manages the minor's estate and accounts under Title XII"; when tuteur_de(tuteur, p) and mineur_non_emancipe(p); then compte_du_au_mineur_emancipe(p); }
}

@source(CC_ART408_1)
rule TransfertFiduciaireDuMineurInterdit(p: Personne, tuteur: Personne) defeasible { label fr official "Article 408-1. Les biens ou droits du mineur ne peuvent être transférés dans un patrimoine fiduciaire"; label en unofficial "Article 408-1. A minor's assets or rights may not be transferred into a trust estate"; when tuteur_de(tuteur, p) and mineur_non_emancipe(p); then prohibition TransfererBiensMineurEnFiducie { bearer tuteur; action autorisation_administration_entreprise(p); window [@2009-01-01, infinity); }; }
@source(CC_ART408_1)
rule MaintenanceTransfererBiensMineurEnFiducie(p: Personne, tuteur: Personne) strict {
    label fr official "Maintenir l'interdiction TransfererBiensMineurEnFiducie";
    label en unofficial "Maintain prohibition TransfererBiensMineurEnFiducie";
    when tuteur_de(tuteur, p) and mineur_non_emancipe(p);
    then duty MaintenanceTransfererBiensMineurEnFiducieDuty {
        bearer tuteur;
        goal maintenance {
            condition not autorisation_administration_entreprise(p);
            window [@1804-03-21, infinity);
        };
    };
}


@source(CC_ART409)
rule SubrogeTuteurObligatoire(p: Personne, subroge: Personne) defeasible { label fr official "Article 409. La tutelle comporte un subrogé tuteur dont la charge cesse avec celle du tuteur"; label en unofficial "Article 409. Guardianship includes a deputy guardian whose office ends with the guardian's"; when subroge_tuteur_de(subroge, p); then conseil_de_famille_requis(p); }
pub relation subroge_tuteur_pourvu(p: Personne) kind derived { label fr official "un subrogé tuteur est en fonction pour la tutelle"; label en unofficial "a deputy guardian is in office for the guardianship"; }
@source(CC_ART409)
rule SubrogeTuteurPourvu(p: Personne, subroge: Personne) strict { label fr official "Article 409. La tutelle est pourvue d'un subrogé tuteur lorsqu'un subrogé est en fonction"; label en unofficial "Article 409. Guardianship is provided with a deputy guardian once one is in office"; when subroge_tuteur_de(subroge, p); then subroge_tuteur_pourvu(p); }
@source(CC_ART409)
rule PositionDevoirDesignerSubroge(p: Personne) strict {
    label fr official "Article 409. La tutelle doit comporter un subrogé tuteur";
    label en unofficial "Article 409. Guardianship must include a deputy guardian";
    when tutelle_ouverte(p);
    then duty DevoirDesignerSubroge {
        bearer entity_ref("urn:fr:cc:personnes:conseil-famille");
        beneficiary p;
        goal achievement {
            condition subroge_tuteur_pourvu(p);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART410)
rule DevoirsDuSubrogeTuteur(p: Personne, subroge: Personne) defeasible { label fr official "Article 410. Le subrogé surveille la mission, représente en cas d'opposition et alerte sans délai le juge"; label en unofficial "Article 410. The deputy supervises, represents on conflict and promptly alerts the judge"; when subroge_tuteur_de(subroge, p); then duty SurveillerLaMissionTutelaire { bearer subroge; beneficiary p; maintain subroge_surveille_et_informe_juge(p) during [@2009-01-01, infinity); }; }

@source(CC_ART411)
rule TutelleVacante(p: Personne) defeasible { label fr official "Article 411. L'impossibilité d'organiser la tutelle entraîne sa vacance et son renvoi à la collectivité publique"; label en unofficial "Article 411. Inability to organize guardianship makes it vacant and refers it to the public authority"; when impossibilite_d_organiser_la_tutelle(p); then tutelle_vacante(p); }

pub relation titulaire_defere_et_communique(c: ChargeTutelaire, titulaire: Personne) kind empirical { label fr official "l'organe tutélaire défère aux convocations et communique les informations requises"; label en unofficial "the guardianship body attends summonses and provides the requested information"; }
@source(CC_ART411_1)
rule DevoirDeCooperationTutelaire(c: ChargeTutelaire, titulaire: Personne) defeasible { label fr official "Article 411-1. Les organes tutélaires doivent déférer aux convocations et communiquer les informations requises"; label en unofficial "Article 411-1. Guardianship bodies must attend summonses and provide requested information"; when titulaire_charge(c, titulaire); then duty CoopererAvecLaSurveillanceTutelaire { bearer titulaire; maintain titulaire_defere_et_communique(c, titulaire) during [@2009-01-01, infinity); }; }

@source(CC_ART412)
rule ResponsabiliteDesOrganesDeTutelle(c: ChargeTutelaire, titulaire: Personne) defeasible { label fr official "Article 412. Tout organe répond du dommage causé par sa faute dans l'exercice de sa fonction"; label en unofficial "Article 412. Every body is liable for damage caused by fault in office"; when titulaire_charge(c, titulaire) and cause_de_retrait_de_charge_tutelaire(c); then charge_retirable_ou_remplacable(c); }
pub relation dommage_cause_par_faute_dans_la_charge(c: ChargeTutelaire) kind empirical { label fr official "l'organe de la tutelle a causé un dommage par une faute commise dans l'exercice de sa fonction"; label en unofficial "the guardianship body caused damage by a fault committed in the exercise of its office"; }
@source(CC_ART412)
rule PositionDevoirRepondreDommageCharge(c: ChargeTutelaire, titulaire: Personne) strict {
    label fr official "Article 412. L'organe doit répondre du dommage causé par sa faute";
    label en unofficial "Article 412. The office holder must answer for damage caused by fault";
    when titulaire_charge(c, titulaire) and dommage_cause_par_faute_dans_la_charge(c);
    then duty DevoirRepondreDommageCharge {
        bearer titulaire;
        goal achievement {
            condition repondre_dommage_charge(c, titulaire);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART413)
rule PrescriptionResponsabiliteTutelleMineur(p: Personne, jour: Date) defeasible { label fr official "Article 413. L'action en responsabilité se prescrit par cinq ans depuis la majorité ou la fin anticipée de la mesure"; label en unofficial "Article 413. The liability action is limited to five years from majority or earlier termination"; when date_d_appreciation(p, jour) and majeur(p); then action_responsabilite_tutelle_expire_le(p, add_calendar_period(jour, 5 calendar_year)); }
@source(CC_ART413)
rule PositionPouvoirActionResponsabiliteTutelle(p: Personne) strict {
    label fr official "Article 413. La personne peut exercer l'action en responsabilité tutélaire";
    label en unofficial "Article 413. A person may bring the guardianship liability action";
    when exercer_action_responsabilite_tutelle(p);
    then liberty PouvoirActionResponsabiliteTutelle {
        holder p;
        action exercer_action_responsabilite_tutelle(p);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART413_2)
rule PositionPouvoirDemanderEmancipationJudiciaire(p: Personne) strict {
    label fr official "Article 413-2. Les père ou mère peuvent demander l'émancipation judiciaire";
    label en unofficial "Article 413-2. A parent may request judicial emancipation";
    when demander_emancipation_judiciaire(p);
    then liberty PouvoirDemanderEmancipationJudiciaire {
        holder entity_ref("urn:fr:cc:personnes:parent");
        action demander_emancipation_judiciaire(p);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART413_3)
rule EmancipationDemandeeParConseilDeFamille(p: Personne) defeasible { label fr official "Article 413-3. Le conseil de famille peut demander l'émancipation du mineur sans père ni mère"; label en unofficial "Article 413-3. The family council may seek emancipation of an orphaned minor"; when conseil_de_famille_requis(p) and age_requis_pour_l_emancipation(p); then compte_du_au_mineur_emancipe(p); }
@source(CC_ART413_3)
rule PositionPouvoirDemanderEmancipationConseil(p: Personne) strict {
    label fr official "Article 413-3. Le conseil de famille peut demander l'émancipation";
    label en unofficial "Article 413-3. The family council may request emancipation";
    when demander_emancipation_conseil(p);
    then liberty PouvoirDemanderEmancipationConseil {
        holder entity_ref("urn:fr:cc:personnes:conseil-famille");
        action demander_emancipation_conseil(p);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART413_4)
rule ConvocationDuConseilPourEmancipation(p: Personne) defeasible { label fr official "Article 413-4. Un membre du conseil ou le mineur peut demander sa convocation en vue de l'émancipation"; label en unofficial "Article 413-4. A council member or the minor may request a meeting about emancipation"; when conseil_de_famille_requis(p) and age_requis_pour_l_emancipation(p); then liberty DemanderConvocationPourEmancipation { holder p; action demande_a_etre_entendu(p); window [@1965-07-15, infinity); }; }

@source(CC_ART413_5)
rule CompteRenduAuMineurEmancipe(p: Personne) defeasible { label fr official "Article 413-5. Le compte de tutelle est rendu au mineur émancipé selon l'article 514"; label en unofficial "Article 413-5. The guardianship account is rendered to the emancipated minor under Article 514"; when emancipe(p); then compte_du_au_mineur_emancipe(p); }

@source(CC_ART413_6)
rule ExceptionsALaCapaciteDuMineurEmancipe(p: Personne) defeasible { label fr official "Article 413-6, alinéa 2. Pour le mariage et l'adoption, le mineur émancipé suit les règles du mineur"; label en unofficial "Article 413-6, paragraph 2. For marriage and adoption, an emancipated minor follows the rules for minors"; when emancipe(p); then capacite_emancipee_limitee_pour_mariage_ou_adoption(p); }
@source(CC_ART413_6)
rule PositionPouvoirAccomplirActeVieCivileEmancipe(p: Personne) strict {
    label fr official "Article 413-6. Le mineur émancipé peut accomplir les actes de la vie civile";
    label en unofficial "Article 413-6. An emancipated minor may perform civil-life acts";
    when accomplir_acte_vie_civile_emancipe(p);
    then liberty PouvoirAccomplirActeVieCivileEmancipe {
        holder p;
        action accomplir_acte_vie_civile_emancipe(p);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART413_7)
rule FinResponsabiliteParentaleDePleinDroit(p: Personne) defeasible { label fr official "Article 413-7, alinéa 2. Les parents ne répondent plus de plein droit du dommage causé après l'émancipation"; label en unofficial "Article 413-7, paragraph 2. Parents are no longer strictly liable for damage caused after emancipation"; when emancipe(p); then responsabilite_parentale_de_plein_droit_ecartee(p); }
@source(CC_ART413_7)
rule PositionImmuniteResponsabiliteParentale(p: Personne) strict {
    label fr official "Article 413-7. L'émancipation protège le mineur contre la responsabilité parentale de plein droit";
    label en unofficial "Article 413-7. Emancipation protects the minor from parents' strict liability";
    when emancipation_ecarte_responsabilite_parentale(p);
    then immunity ImmuniteResponsabiliteParentale {
        holder p;
        against entity_ref("urn:fr:cc:personnes:parent");
        protected_effect responsabilite_parentale_de_plein_droit_ecartee(p);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART413_8)
rule AutorisationCommercantMineurEmancipe(p: Personne) defeasible { label fr official "Article 413-8. Le mineur émancipé peut être commerçant sur autorisation judiciaire"; label en unofficial "Article 413-8. An emancipated minor may trade with judicial authorization"; when emancipe(p) and commercant_autorise(p); then capable_comme_un_majeur(p); }
@source(CC_ART413_8)
rule PositionPouvoirExercerCommerceEmancipe(p: Personne) strict {
    label fr official "Article 413-8. Le mineur émancipé peut exercer le commerce autorisé";
    label en unofficial "Article 413-8. An emancipated minor may carry on authorized trade";
    when exercer_commerce_emancipe(p);
    then liberty PouvoirExercerCommerceEmancipe {
        holder p;
        action exercer_commerce_emancipe(p);
        window [@2009-01-01, infinity);
    };
}

// Gestion du patrimoine : entrées et résultats temporels.
pub relation ouverture_tutelle_gestion(m: MesureDeProtection, p: Personne, tuteur: Personne, jour: Date) kind empirical { key(m); label fr official "ouverture de la tutelle patrimoniale, personne protégée, tuteur et date"; label en unofficial "opening of estate guardianship, protected person, guardian and date"; }
pub relation acte_conservatoire_ou_administration(a: ActeDeGestion) kind empirical { label fr official "l'acte est conservatoire ou d'administration"; label en unofficial "the act is preservative or administrative"; }
pub relation acte_de_disposition(a: ActeDeGestion) kind empirical { label fr official "l'acte est un acte de disposition selon le décret"; label en unofficial "the act is a disposition under the decree"; }
pub relation autorisation_acte_de_gestion(a: ActeDeGestion) kind empirical { label fr official "le conseil de famille ou le juge a autorisé l'acte"; label en unofficial "the family council or judge authorized the act"; }
pub relation alerter_juge_atteinte(p: Personne, tiers: Personne) kind empirical { label fr official "le tiers avise le juge de l'atteinte aux intérêts de la personne"; label en unofficial "the third party informs the judge of the threat to the person's interests"; }
pub relation demander_autorisation_acte_tuteur(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "le tuteur demande l'autorisation de l'acte"; label en unofficial "the guardian asks for authorization of the act"; }
pub relation acte_de_disposition_par(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "l'acte de disposition est accompli par le tuteur"; label en unofficial "the guardian performs the disposition"; }
pub relation accomplir_acte_gestion_seul(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "le tuteur accomplit seul l'acte conservatoire ou d'administration"; label en unofficial "the guardian performs the preservative or administration act alone"; }
pub relation obtenir_approbation_transaction(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "le tuteur obtient l'approbation de la transaction ou du compromis"; label en unofficial "the guardian obtains approval of the settlement or compromise"; }
pub relation acquerir_ou_louer_bien(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "le tuteur acquiert ou prend à bail le bien"; label en unofficial "the guardian purchases or leases the property"; }
pub relation obtenir_autorisation_partage(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "le tuteur obtient l'autorisation et l'approbation du partage"; label en unofficial "the guardian obtains authorization and approval for the division"; }
pub relation etablir_compte_annuel_tuteur(m: MesureDeProtection, tuteur: Personne) kind empirical { label fr official "le tuteur établit le compte annuel de gestion"; label en unofficial "the guardian prepares the annual management account"; }
pub relation exercer_action_reddition_comptes(m: MesureDeProtection, demandeur: Personne) kind empirical { label fr official "la personne exerce l'action relative aux comptes de tutelle"; label en unofficial "the person brings the action concerning guardianship accounts"; }
pub relation soumettre_compte_mineur(m: MesureDeProtection, tuteur: Personne) kind empirical { label fr official "le tuteur soumet le compte du mineur à la vérification"; label en unofficial "the guardian submits the minor's account for review"; }
pub relation soumettre_compte_majeur(m: MesureDeProtection, tuteur: Personne) kind empirical { label fr official "le tuteur soumet le compte du majeur à la vérification"; label en unofficial "the guardian submits the adult's account for review"; }
pub relation demander_dispense_compte(m: MesureDeProtection, juge: Personne) kind empirical { label fr official "le juge accorde la dispense de compte"; label en unofficial "the judge grants the account exemption"; }
pub relation accomplir_acte_interdit_tuteur(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "le tuteur accomplit l'acte interdit"; label en unofficial "the guardian performs the prohibited act"; }
pub relation acte_interdit_tuteur(a: ActeDeGestion) kind empirical { label fr official "l'acte relève d'une catégorie interdite au tuteur"; label en unofficial "the act belongs to a category prohibited to the guardian"; }
pub relation acte_interdit_par_tuteur(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "l'acte relève d'une catégorie interdite pour ce tuteur"; label en unofficial "the act belongs to a category prohibited for this guardian"; }
pub relation fin_mission_tuteur_le(tuteur: Personne, jour: Date) kind empirical { key(tuteur); label fr official "jour de la fin de la mission du tuteur"; label en unofficial "date the guardian's mission ended"; }
pub relation budget_tutelle_arrete(m: MesureDeProtection) kind empirical { label fr official "le budget annuel de la tutelle a été arrêté et communiqué"; label en unofficial "the annual guardianship budget was set and communicated"; }
pub relation inventaire_meubles_transmis(m: MesureDeProtection) kind empirical { label fr official "l'inventaire des biens meubles corporels a été transmis"; label en unofficial "the inventory of tangible movables was transmitted"; }
pub relation inventaire_autres_biens_transmis(m: MesureDeProtection) kind empirical { label fr official "l'inventaire des autres biens a été transmis avec le budget prévisionnel"; label en unofficial "the inventory of other assets was transmitted with the forecast budget"; }
pub relation compte_gestion_etabli(m: MesureDeProtection) kind empirical { label fr official "le compte annuel de gestion et ses justificatifs ont été établis"; label en unofficial "the annual management account and supporting documents were prepared"; }
pub relation compte_fin_mission_remis(m: MesureDeProtection) kind empirical { label fr official "les cinq derniers comptes, le compte final et les pièces ont été remis"; label en unofficial "the last five accounts, final account and records were delivered"; }
pub relation echeance_inventaire_meubles(m: MesureDeProtection, jour: Date) kind derived { key(m); label fr official "échéance de trois mois pour l'inventaire des meubles corporels"; label en unofficial "three-month deadline for tangible movables inventory"; }
pub relation echeance_inventaire_autres_biens(m: MesureDeProtection, jour: Date) kind derived { key(m); label fr official "échéance de six mois pour l'inventaire des autres biens"; label en unofficial "six-month deadline for other assets inventory"; }
pub relation echeance_compte_annuel(m: MesureDeProtection, jour: Date) kind derived { key(m); label fr official "échéance annuelle du compte de gestion"; label en unofficial "annual management-account deadline"; }
pub relation echeance_remise_fin_mission(m: MesureDeProtection, jour: Date) kind derived { key(m); label fr official "échéance de trois mois pour la remise des comptes de fin de mission"; label en unofficial "three-month deadline for delivery of end-of-mission accounts"; }
pub relation action_reddition_expire_le(m: MesureDeProtection, jour: Date) kind derived { key(m); label fr official "terme de cinq ans de l'action en reddition de comptes"; label en unofficial "end of the five-year accounting action"; }
pub relation dispense_judiciaire_de_compte(m: MesureDeProtection) kind derived { label fr official "le juge a dispensé le tuteur de l'approbation ou de l'établissement du compte"; label en unofficial "the judge exempted the guardian from approval or preparation of the account"; }
pub relation acte_de_gestion_permis(a: ActeDeGestion) kind derived { label fr official "l'acte de gestion peut être accompli par le tuteur"; label en unofficial "the management act may be performed by the guardian"; }
pub relation acte_de_gestion_interdit(a: ActeDeGestion) kind derived { label fr official "l'acte de gestion est interdit au tuteur"; label en unofficial "the management act is prohibited to the guardian"; }

pub relation gestion_prudente_du_patrimoine_protege(m: MesureDeProtection) kind empirical { label fr official "le tuteur gère le patrimoine avec des soins prudents, diligents et avisés, dans le seul intérêt de la personne protégée"; label en unofficial "the guardian manages the estate prudently, diligently and solely in the protected person's interest"; }
@source(CC_ART496)
rule RepresentationPatrimonialeDuTuteur(m: MesureDeProtection, p: Personne, tuteur: Personne, jour: Date) defeasible { label fr official "Article 496. Le tuteur représente la personne protégée et doit gérer avec prudence, diligence et dans son seul intérêt"; label en unofficial "Article 496. The guardian represents the protected person and must manage prudently, diligently and solely in that person's interest"; when ouverture_tutelle_gestion(m, p, tuteur, jour); then duty GererPrudemmentLePatrimoine { bearer tuteur; beneficiary p; maintain gestion_prudente_du_patrimoine_protege(m) during [@2009-01-01, infinity); }; }

pub relation subroge_atteste_les_operations_au_juge(m: MesureDeProtection) kind empirical { label fr official "le subrogé tuteur atteste auprès du juge le bon déroulement des opérations obligatoires"; label en unofficial "the deputy guardian certifies to the judge the proper performance of the mandatory operations"; }
@source(CC_ART497)
rule AttestationDuSubrogeTuteur(m: MesureDeProtection, p: Personne, subroge: Personne, tuteur: Personne, jour: Date) defeasible { label fr official "Article 497. Le subrogé tuteur atteste au juge le bon déroulement des opérations obligatoires"; label en unofficial "Article 497. The deputy guardian certifies proper performance of mandatory operations to the judge"; when ouverture_tutelle_gestion(m, p, tuteur, jour) and subroge_tuteur_de(subroge, p); then duty AttesterLesOperationsDuTuteur { bearer subroge; beneficiary p; maintain subroge_atteste_les_operations_au_juge(m) during [@2009-01-01, infinity); }; }

pub relation capitaux_verses_sur_compte_au_seul_nom_du_protege(m: MesureDeProtection) kind empirical { label fr official "les capitaux sont versés sur un compte ouvert au seul nom de la personne protégée et mentionnant la tutelle"; label en unofficial "the capital is paid into an account in the protected person's sole name stating the guardianship"; }
@source(CC_ART498)
rule VersementDesCapitauxSurCompteProtege(m: MesureDeProtection, p: Personne, tuteur: Personne, jour: Date) defeasible { label fr official "Article 498. Les capitaux sont versés sur un compte au seul nom de la personne et mentionnant la tutelle"; label en unofficial "Article 498. Capital is paid into an account solely in the protected person's name and stating the guardianship"; when ouverture_tutelle_gestion(m, p, tuteur, jour); then duty VerserCapitauxSurCompteProtege { bearer tuteur; beneficiary p; maintain capitaux_verses_sur_compte_au_seul_nom_du_protege(m) during [@2009-01-01, infinity); }; }

@source(CC_ART499)
rule AlerteDuJugeParLesTiers(m: MesureDeProtection, p: Personne, tuteur: Personne, jour: Date) defeasible { label fr official "Article 499. Le tiers qui connaît une atteinte manifeste aux intérêts de la personne en avise le juge"; label en unofficial "Article 499. A third party aware of a manifest threat to the protected person's interests informs the judge"; when ouverture_tutelle_gestion(m, p, tuteur, jour) and interet_du_mineur_388_1(p); then acte_de_gestion_interdit(entity_ref("urn:fr:cc:personnes:acte-compromettant")); }
pub relation atteinte_manifeste_connue_du_tiers(p: Personne, tiers: Personne) kind empirical { label fr official "le tiers a connaissance, à l'occasion de l'emploi des capitaux, d'actes ou omissions qui compromettent manifestement l'intérêt de la personne protégée"; label en unofficial "the third party learns, on the occasion of investing the capital, of acts or omissions manifestly compromising the protected person's interest"; }
@source(CC_ART499)
rule PositionDevoirAlerterJugeInteretsPersonne(p: Personne, tiers: Personne) strict {
    label fr official "Article 499. Le tiers doit aviser le juge de l'atteinte aux intérêts de la personne";
    label en unofficial "Article 499. The third party must inform the judge of the threat to the person's interests";
    when atteinte_manifeste_connue_du_tiers(p, tiers);
    then duty DevoirAlerterJugeInteretsPersonne {
        bearer tiers;
        beneficiary p;
        goal achievement {
            condition alerter_juge_atteinte(p, tiers);
            window [@2009-01-01, infinity];
        };
    };
}

// Ст. 500: опекун утверждает бюджет и сообщает о нём — разовое действие,
// поэтому цель achieve, а не maintain (удержание до infinity SATISFIED не даёт).
@source(CC_ART500)
rule BudgetAnnuelDeLaTutelle(m: MesureDeProtection, p: Personne, tuteur: Personne, jour: Date) defeasible { label fr official "Article 500. Le tuteur arrête le budget annuel et en informe le conseil de famille ou le juge"; label en unofficial "Article 500. The guardian sets the annual budget and informs the family council or judge"; when ouverture_tutelle_gestion(m, p, tuteur, jour); then duty ArreterEtCommuniquerLeBudget { bearer tuteur; beneficiary p; achieve budget_tutelle_arrete(m) during [jour, infinity); }; }

pub relation capitaux_employes_selon_la_decision(m: MesureDeProtection) kind empirical { label fr official "les fonds sont employés ou remployés dans le délai et selon les modalités de la décision"; label en unofficial "the funds are invested or reinvested within the period and as the decision provides"; }
@source(CC_ART501)
rule EmploiEtRemploiDesCapitaux(m: MesureDeProtection, p: Personne, tuteur: Personne, jour: Date) defeasible { label fr official "Article 501. Le tuteur emploie ou remploie les fonds dans le délai et selon les modalités de la décision"; label en unofficial "Article 501. The guardian invests or reinvests funds within the period and according to the decision"; when ouverture_tutelle_gestion(m, p, tuteur, jour); then duty EmployerLesCapitauxSelonLaDecision { bearer tuteur; beneficiary p; maintain capitaux_employes_selon_la_decision(m) during [jour, infinity); }; }

@source(CC_ART502)
rule AutorisationDesActesDuTuteur(a: ActeDeGestion) defeasible { label fr official "Article 502. Le conseil ou le juge statue sur les autorisations des actes que le tuteur ne peut accomplir seul"; label en unofficial "Article 502. The council or judge decides authorizations for acts the guardian cannot perform alone"; when acte_de_disposition(a) and autorisation_acte_de_gestion(a); then acte_de_gestion_permis(a); }
@source(CC_ART502)
rule PositionPouvoirDemanderAutorisationActeTuteur(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Article 502. Le tuteur peut demander l'autorisation de l'acte";
    label en unofficial "Article 502. The guardian may request authorization for the act";
    when demander_autorisation_acte_tuteur(a, tuteur);
    then liberty PouvoirDemanderAutorisationActeTuteur {
        holder tuteur;
        action demander_autorisation_acte_tuteur(a, tuteur);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART503) {
    rule EcheanceInventaireMeubles(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date) defeasible { label fr official "Article 503. L'inventaire des meubles corporels est transmis dans les trois mois de l'ouverture"; label en unofficial "Article 503. The tangible movables inventory is transmitted within three months of opening"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture); then echeance_inventaire_meubles(m, add_calendar_period(ouverture, 3 calendar_month)); }
    rule EcheanceInventaireAutresBiens(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date) defeasible { label fr official "Article 503. L'inventaire des autres biens et le budget prévisionnel sont transmis dans les six mois"; label en unofficial "Article 503. The other-assets inventory and forecast budget are transmitted within six months"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture); then echeance_inventaire_autres_biens(m, add_calendar_period(ouverture, 6 calendar_month)); }
    rule DevoirInventaireMeubles(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, limite: Date) defeasible { label fr official "Article 503. Le tuteur doit transmettre l'inventaire mobilier avant son échéance"; label en unofficial "Article 503. The guardian must transmit the movables inventory by its deadline"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and echeance_inventaire_meubles(m, limite); then duty TransmettreInventaireMeubles { bearer tuteur; beneficiary p; achieve inventaire_meubles_transmis(m) during (ouverture, limite); }; }
    rule DevoirInventaireAutresBiens(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, limite: Date) defeasible { label fr official "Article 503. Le tuteur doit transmettre l'inventaire des autres biens avant son échéance"; label en unofficial "Article 503. The guardian must transmit the other-assets inventory by its deadline"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and echeance_inventaire_autres_biens(m, limite); then duty TransmettreInventaireAutresBiens { bearer tuteur; beneficiary p; achieve inventaire_autres_biens_transmis(m) during (ouverture, limite); }; }
}

@source(CC_ART504)
rule ActesConservatoiresEtAdministrationDuTuteur(a: ActeDeGestion) defeasible { label fr official "Article 504. Le tuteur accomplit seul les actes conservatoires et d'administration nécessaires"; label en unofficial "Article 504. The guardian performs necessary preservative and administration acts alone"; when acte_conservatoire_ou_administration(a); then acte_de_gestion_permis(a); }
@source(CC_ART504)
rule PositionPouvoirAccomplirActeGestionSeul(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Article 504. Le tuteur peut accomplir seul l'acte conservatoire ou d'administration";
    label en unofficial "Article 504. The guardian may perform the preservative or administration act alone";
    when accomplir_acte_gestion_seul(a, tuteur);
    then liberty PouvoirAccomplirActeGestionSeul {
        holder tuteur;
        action accomplir_acte_gestion_seul(a, tuteur);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART505)
rule AutorisationDesActesDeDisposition(a: ActeDeGestion) defeasible { label fr official "Article 505. Un acte de disposition exige l'autorisation du conseil de famille ou du juge"; label en unofficial "Article 505. A disposition requires authorization by the family council or judge"; when acte_de_disposition(a) and autorisation_acte_de_gestion(a); then acte_de_gestion_permis(a); }
@source(CC_ART505)
rule PositionDevoirObtenirAutorisationActeDisposition(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Article 505. Le tuteur doit obtenir l'autorisation de l'acte de disposition";
    label en unofficial "Article 505. The guardian must obtain authorization for the disposition";
    when acte_de_disposition_par(a, tuteur);
    then duty DevoirObtenirAutorisationActeDisposition {
        bearer tuteur;
        goal achievement {
            condition autorisation_acte_de_gestion(a);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART506)
rule ApprobationTransactionOuCompromis(a: ActeDeGestion) defeasible { label fr official "Article 506. La transaction ou le compromis exige l'approbation préalable du conseil ou du juge"; label en unofficial "Article 506. A settlement or arbitration agreement requires prior approval by the council or judge"; when autorisation_acte_de_gestion(a); then acte_de_gestion_permis(a); }
pub relation transaction_ou_compromis_au_nom_du_protege(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "le tuteur transige ou compromet au nom de la personne protégée"; label en unofficial "the guardian settles or submits to arbitration on behalf of the protected person"; }
@source(CC_ART506)
rule PositionDevoirObtenirApprobationTransaction(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Article 506. Le tuteur doit obtenir l'approbation préalable de la transaction ou du compromis";
    label en unofficial "Article 506. The guardian must obtain prior approval of the settlement or compromise";
    when transaction_ou_compromis_au_nom_du_protege(a, tuteur);
    then duty DevoirObtenirApprobationTransaction {
        bearer tuteur;
        goal achievement {
            condition obtenir_approbation_transaction(a, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART507)
rule PartageAmiableAutorise(a: ActeDeGestion) defeasible { label fr official "Article 507. Le partage amiable avec opposition d'intérêts et l'état liquidatif exigent autorisation et approbation"; label en unofficial "Article 507. An agreed division involving conflict and the liquidation statement require authorization and approval"; when acte_de_disposition(a) and autorisation_acte_de_gestion(a); then acte_de_gestion_permis(a); }
pub relation partage_avec_opposition_d_interets(a: ActeDeGestion, tuteur: Personne) kind empirical { label fr official "un partage est fait à l'égard de la personne protégée en cas d'opposition d'intérêts avec la personne chargée de la mesure"; label en unofficial "a division is made for the protected person where interests conflict with the person in charge of the measure"; }
@source(CC_ART507)
rule PositionDevoirObtenirAutorisationPartage(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Article 507. Le tuteur doit obtenir l'autorisation et l'approbation du partage";
    label en unofficial "Article 507. The guardian must obtain authorization and approval for the division";
    when partage_avec_opposition_d_interets(a, tuteur);
    then duty DevoirObtenirAutorisationPartage {
        bearer tuteur;
        goal achievement {
            condition obtenir_autorisation_partage(a, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART507_1)
rule AcceptationOuRenonciationSuccessionProtegee(a: ActeDeGestion) defeasible { label fr official "Article 507-1. L'acceptation pure et simple ou la renonciation à la succession exige l'attestation ou l'autorisation prévue"; label en unofficial "Article 507-1. Unconditional acceptance or renunciation of an estate requires the prescribed certificate or authorization"; when acte_de_disposition(a) and autorisation_acte_de_gestion(a); then acte_de_gestion_permis(a); }

@source(CC_ART507_2)
rule RevocationRenonciationSuccessionProtegee(a: ActeDeGestion) defeasible { label fr official "Article 507-2. La renonciation peut être révoquée par le tuteur autorisé ou par la personne redevenue capable"; label en unofficial "Article 507-2. Renunciation may be revoked by the authorized guardian or the person restored to capacity"; when autorisation_acte_de_gestion(a); then acte_de_gestion_permis(a); }

@source(CC_ART508)
rule AcquisitionExceptionnelleParLeTuteur(a: ActeDeGestion) defeasible { label fr official "Article 508. L'acquisition ou le bail par le tuteur est exceptionnel, autorisé et réputé en opposition d'intérêts"; label en unofficial "Article 508. Purchase or lease by the guardian is exceptional, authorized and deemed conflicted"; when acte_de_disposition(a) and autorisation_acte_de_gestion(a); then acte_de_gestion_permis(a); }
@source(CC_ART508)
rule PositionDevoirAutoriserAcquisitionOuBail(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Article 508. Le tuteur doit obtenir l'autorisation de l'acquisition ou du bail";
    label en unofficial "Article 508. The guardian must obtain authorization for the purchase or lease";
    when acquerir_ou_louer_bien(a, tuteur);
    then duty DevoirAutoriserAcquisitionOuBail {
        bearer tuteur;
        goal achievement {
            condition autorisation_acte_de_gestion(a);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART509)
rule ActesInterditsAuTuteur(a: ActeDeGestion) defeasible { label fr official "Article 509. Les cinq catégories énumérées d'actes sont interdites au tuteur même avec autorisation"; label en unofficial "Article 509. The five listed categories of acts are prohibited even with authorization"; when acte_de_disposition(a) and not_known(autorisation_acte_de_gestion(a)); then acte_de_gestion_interdit(a); }
@source(CC_ART509)
rule PositionInterdictionActeTuteur(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Article 509. Le tuteur ne peut accomplir l'acte interdit";
    label en unofficial "Article 509. The guardian may not perform the prohibited act";
    when acte_interdit_par_tuteur(a, tuteur);
    then prohibition InterdictionActeTuteur {
        bearer tuteur;
        action accomplir_acte_interdit_tuteur(a, tuteur);
        window [@2009-01-01, infinity);
    };
}
@source(CC_ART509)
rule MaintenanceInterdictionActeTuteur(a: ActeDeGestion, tuteur: Personne) strict {
    label fr official "Maintenir l'interdiction InterdictionActeTuteur";
    label en unofficial "Maintain prohibition InterdictionActeTuteur";
    when acte_interdit_par_tuteur(a, tuteur);
    then duty MaintenanceInterdictionActeTuteurDuty {
        bearer tuteur;
        goal maintenance {
            condition not accomplir_acte_interdit_tuteur(a, tuteur);
            window [@1804-03-21, infinity);
        };
    };
}

@source(CC_ART510) {
    rule EcheanceCompteAnnuel(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date) defeasible { label fr official "Article 510. Le compte de gestion et ses justificatifs sont établis chaque année"; label en unofficial "Article 510. The management account and records are prepared every year"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture); then echeance_compte_annuel(m, add_calendar_period(ouverture, 1 calendar_year)); }
    rule CompteAnnuelDeGestion(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, limite: Date) defeasible { label fr official "Article 510. Le tuteur doit établir le compte annuel, assurer sa confidentialité et le communiquer aux destinataires légaux"; label en unofficial "Article 510. The guardian must prepare the annual account, keep it confidential and deliver it to statutory recipients"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and echeance_compte_annuel(m, limite); then duty EtablirCompteAnnuelDeGestion { bearer tuteur; beneficiary p; achieve compte_gestion_etabli(m) during (ouverture, limite); }; }
}
@source(CC_ART510)
rule PositionDevoirEtablirCompteAnnuel(m: MesureDeProtection, tuteur: Personne) strict {
    label fr official "Article 510. Le tuteur doit établir le compte annuel de gestion";
    label en unofficial "Article 510. The guardian must prepare the annual management account";
    when ouverture_tutelle_gestion(m, _, tuteur, _);
    then duty DevoirEtablirCompteAnnuel {
        bearer tuteur;
        goal achievement {
            condition etablir_compte_annuel_tuteur(m, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART511)
rule VerificationAnnuelleCompteMineur(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, limite: Date) defeasible { label fr official "Article 511. Pour le mineur, le compte annuel est soumis au greffe après vérification du subrogé"; label en unofficial "Article 511. For a minor, the annual account is filed with the registry after deputy review"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and mineur(p) and echeance_compte_annuel(m, limite); then duty SoumettreCompteMineurAVerification { bearer tuteur; beneficiary p; achieve compte_gestion_etabli(m) during (ouverture, limite); }; }
@source(CC_ART511)
rule PositionDevoirSoumettreCompteMineur(m: MesureDeProtection, tuteur: Personne, p: Personne) strict {
    label fr official "Article 511. Le tuteur doit soumettre le compte du mineur à la vérification";
    label en unofficial "Article 511. The guardian must submit the minor's account for review";
    when ouverture_tutelle_gestion(m, p, tuteur, _) and mineur_non_emancipe(p);
    then duty DevoirSoumettreCompteMineur {
        bearer tuteur;
        goal achievement {
            condition soumettre_compte_mineur(m, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART512)
rule VerificationAnnuelleCompteMajeur(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, limite: Date) defeasible { label fr official "Article 512. Pour le majeur, le compte est vérifié et approuvé annuellement par l'organe désigné"; label en unofficial "Article 512. For an adult, the account is annually reviewed and approved by the appointed body"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and majeur(p) and echeance_compte_annuel(m, limite); then duty SoumettreCompteMajeurAVerification { bearer tuteur; beneficiary p; achieve compte_gestion_etabli(m) during (ouverture, limite); }; }
@source(CC_ART512)
rule PositionDevoirSoumettreCompteMajeur(m: MesureDeProtection, tuteur: Personne, p: Personne) strict {
    label fr official "Article 512. Le tuteur doit soumettre le compte du majeur à la vérification";
    label en unofficial "Article 512. The guardian must submit the adult's account for review";
    when ouverture_tutelle_gestion(m, p, tuteur, _) and majeur(p);
    then duty DevoirSoumettreCompteMajeur {
        bearer tuteur;
        goal achievement {
            condition soumettre_compte_majeur(m, tuteur);
            window [@2009-01-01, infinity];
        };
    };
}

@source(CC_ART513)
rule DispenseJudiciaireDeCompte(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date) defeasible { label fr official "Article 513. La dispense décidée par le juge écarte l'approbation et, dans les cas prévus, l'établissement du compte"; label en unofficial "Article 513. A judicial exemption displaces approval and, where provided, preparation of the account"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and interet_du_mineur_388_1(p); then dispense_judiciaire_de_compte(m); }
@source(CC_ART513)
rule PositionPouvoirDemanderDispenseCompte(m: MesureDeProtection, juge: Personne) strict {
    label fr official "Article 513. Le juge peut accorder une dispense de compte";
    label en unofficial "Article 513. The judge may grant an account exemption";
    when demander_dispense_compte(m, juge);
    then liberty PouvoirDemanderDispenseCompte {
        holder juge;
        action demander_dispense_compte(m, juge);
        window [@2009-01-01, infinity);
    };
}

@source(CC_ART513_1)
rule VerificationEtDepotDuCompte(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, limite: Date) defeasible { label fr official "Article 513-1. La personne chargée de vérifier garde le compte confidentiel et en verse un exemplaire sans délai au dossier"; label en unofficial "Article 513-1. The reviewer keeps the account confidential and promptly files a copy in the court record"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and echeance_compte_annuel(m, limite); then duty VerifierEtDeposerLeCompte { bearer tuteur; beneficiary p; achieve compte_gestion_etabli(m) during (ouverture, limite); }; }

@source(CC_ART514) {
    rule EcheanceRemiseFinMission(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, fin: Date) defeasible { label fr official "Article 514. Les comptes de fin de mission sont remis dans les trois mois de la fin"; label en unofficial "Article 514. End-of-mission accounts are delivered within three months after the mission ends"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and fin_mission_tuteur_le(tuteur, fin); then echeance_remise_fin_mission(m, add_calendar_period(fin, 3 calendar_month)); }
    rule CompteDeFinDeMission(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, fin: Date, limite: Date) defeasible { label fr official "Article 514. Le tuteur ou ses héritiers remettent les cinq derniers comptes, le compte final et les pièces dans les trois mois"; label en unofficial "Article 514. The guardian or heirs deliver the last five accounts, final account and records within three months"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and fin_mission_tuteur_le(tuteur, fin) and echeance_remise_fin_mission(m, limite); then duty RemettreComptesDeFinDeMission { bearer tuteur; beneficiary p; achieve compte_fin_mission_remis(m) during (fin, limite); }; }
}

@source(CC_ART515)
rule PrescriptionRedditionDeComptes(m: MesureDeProtection, p: Personne, tuteur: Personne, ouverture: Date, fin: Date) defeasible { label fr official "Article 515. L'action relative aux faits de la tutelle se prescrit par cinq ans à compter de la fin de la mesure"; label en unofficial "Article 515. An action concerning guardianship facts is limited to five years from the end of the measure"; when ouverture_tutelle_gestion(m, p, tuteur, ouverture) and fin_mission_tuteur_le(tuteur, fin); then action_reddition_expire_le(m, add_calendar_period(fin, 5 calendar_year)); }
@source(CC_ART515)
rule PositionPouvoirActionRedditionComptes(m: MesureDeProtection, demandeur: Personne) strict {
    label fr official "Article 515. La personne peut exercer l'action relative aux comptes de tutelle";
    label en unofficial "Article 515. A person may bring the action concerning guardianship accounts";
    when exercer_action_reddition_comptes(m, demandeur);
    then liberty PouvoirActionRedditionComptes {
        holder demandeur;
        action exercer_action_reddition_comptes(m, demandeur);
        window [@2009-01-01, infinity);
    };
}
