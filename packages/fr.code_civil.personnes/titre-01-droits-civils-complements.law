// TITRE Ier — COMPLÉMENTS EXÉCUTABLES.
// Les faits matériels viennent du dossier. Les appréciations confiées au juge
// restent des jugements externes ; les interdictions et listes fermées du Code
// sont, elles, abaissées ici.

language "law.core" version "0.2";
package fr.code_civil.personnes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-personnes";

use self::{
    CC_ART10,
    CC_ART11,
    CC_ART16,
    CC_ART16_11,
    CC_ART16_12,
    CC_ART16_13,
    CC_ART16_14,
    CC_ART16_1_1,
    CC_ART16_2,
    CC_ART16_4,
    CC_ART16_6,
    CC_ART16_8,
    CC_ART16_8_1,
    CC_ART16_9,
    CC_ART7,
    CC_ART8,
    CC_ART9,
    CC_ART9_1,
    ConventionCorporelle,
    InterventionMedicale,
    Personne,
};

pub entity RestesHumains { label fr official "restes humains ou cendres"; label en unofficial "human remains or ashes"; }
pub entity DonCorporel { label fr official "don d'un élément ou produit du corps"; label en unofficial "donation of bodily material"; }
pub entity ExamenBiologique { label fr official "examen biologique ou génétique"; label en unofficial "biological or genetic examination"; }

pub relation ressortissant_francais(p: Personne) kind empirical { label fr official "la personne est ressortissante française"; label en unofficial "the person is a French national"; }
pub relation jouit_des_droits_civils(p: Personne) kind derived { label fr official "la personne jouit des droits civils"; label en unofficial "the person enjoys civil rights"; }
pub relation requis_legalement_de_concourir_a_la_justice(p: Personne) kind empirical { label fr official "la personne est légalement requise de concourir à la justice"; label en unofficial "the person is legally required to assist justice"; }
pub relation motif_legitime_de_refus(p: Personne) kind empirical { label fr official "la personne dispose d'un motif légitime de refus"; label en unofficial "the person has a legitimate reason to refuse"; }
pub relation concours_a_la_justice_exigible(p: Personne) kind derived { label fr official "le concours de la personne à la justice est exigible"; label en unofficial "the person's assistance to justice is required"; }
pub relation restes_traites_avec_respect(r: RestesHumains) kind empirical { label fr official "les restes sont traités avec respect, dignité et décence"; label en unofficial "the remains are treated with respect, dignity and decency"; }
pub relation protection_post_mortem_respectee(r: RestesHumains) kind derived { label fr official "la protection du corps après la mort est respectée"; label en unofficial "post-mortem protection of the body is respected"; }
pub relation atteinte_illicite_au_corps(i: InterventionMedicale) kind empirical { label fr official "une atteinte illicite au corps ou à ses éléments est constatée"; label en unofficial "an unlawful interference with the body or its elements is established"; }
pub relation mesure_preventive_corporelle_admissible(i: InterventionMedicale) kind derived { label fr official "une mesure judiciaire de prévention ou de cessation est admissible"; label en unofficial "a judicial preventive or cessation measure is available"; }
pub relation pratique_eugenique(i: InterventionMedicale) kind empirical { label fr official "l'intervention organise une sélection eugénique des personnes"; label en unofficial "the intervention organizes eugenic selection"; }
pub relation clonage_reproductif(i: InterventionMedicale) kind empirical { label fr official "l'intervention vise la naissance d'un enfant génétiquement identique"; label en unofficial "the intervention seeks the birth of a genetically identical child"; }
pub relation modification_genetique_descendance(i: InterventionMedicale) kind empirical { label fr official "l'intervention modifie les caractères génétiques de la descendance"; label en unofficial "the intervention alters descendants' genetic characteristics"; }
pub relation intervention_genetique_interdite(i: InterventionMedicale) kind derived { label fr official "l'intervention génétique est interdite"; label en unofficial "the genetic intervention is prohibited"; }
pub relation remuneration_experimentation_ou_prelevement(d: DonCorporel) kind empirical { label fr official "une rémunération est allouée pour expérimentation, prélèvement ou collecte"; label en unofficial "payment is made for experimentation, removal or collection"; }
pub relation remuneration_corporelle_interdite(d: DonCorporel) kind derived { label fr official "la rémunération corporelle est interdite"; label en unofficial "payment for bodily material is prohibited"; }
pub relation divulgation_identites_donneur_receveur(d: DonCorporel) kind empirical { label fr official "les identités du donneur et du receveur sont divulguées"; label en unofficial "donor and recipient identities are disclosed"; }
pub relation necessite_therapeutique_identification(d: DonCorporel) kind empirical { label fr official "une nécessité thérapeutique justifie l'accès médical aux identités"; label en unofficial "therapeutic necessity justifies medical access to identities"; }
pub relation divulgation_identites_interdite(d: DonCorporel) kind derived { label fr official "la divulgation croisée des identités est interdite"; label en unofficial "cross-disclosure of identities is prohibited"; }
pub relation discrimination_genetique_subie(p: Personne) kind empirical { label fr official "la personne subit une discrimination fondée sur ses caractéristiques génétiques"; label en unofficial "the person suffers discrimination based on genetic characteristics"; }
pub relation discrimination_genetique_interdite(p: Personne) kind derived { label fr official "la discrimination génétique est interdite"; label en unofficial "genetic discrimination is prohibited"; }
pub relation imagerie_finalite_medicale_recherche_ou_expertise(e: ExamenBiologique) kind empirical { label fr official "l'imagerie a une finalité médicale, scientifique ou d'expertise judiciaire admise"; label en unofficial "the imaging has an admitted medical, research or judicial-expert purpose"; }
pub relation consentement_ecrit_prealable_eclaire(e: ExamenBiologique) kind empirical { label fr official "le consentement écrit, préalable et éclairé a été recueilli"; label en unofficial "prior informed written consent was obtained"; }
pub relation imagerie_cerebrale_admissible(e: ExamenBiologique) kind derived { label fr official "l'imagerie cérébrale satisfait aux conditions civiles"; label en unofficial "brain imaging meets civil-law conditions"; }
pub relation atteinte_vie_privee(p: Personne) kind empirical { label fr official "une atteinte à l'intimité de la vie privée est établie"; label en unofficial "an interference with private life is established"; }
pub relation mesure_cessation_vie_privee_admissible(p: Personne) kind derived { label fr official "une mesure judiciaire propre à faire cesser l'atteinte est admissible"; label en unofficial "a judicial measure to stop the interference is available"; }
pub relation presente_publiquement_coupable_avant_condamnation(p: Personne) kind empirical { label fr official "la personne est publiquement présentée coupable avant toute condamnation"; label en unofficial "the person is publicly presented as guilty before conviction"; }
pub relation rectification_presomption_innocence_admissible(p: Personne) kind derived { label fr official "une rectification ou un communiqué peut faire cesser l'atteinte à la présomption d'innocence"; label en unofficial "a correction or statement may stop the interference with presumed innocence"; }
pub relation atteinte_dignite_personne(p: Personne) kind empirical { label fr official "une atteinte à la dignité de la personne est commise"; label en unofficial "an interference with human dignity is committed"; }
pub relation atteinte_dignite_interdite(p: Personne) kind derived { label fr official "l'atteinte à la dignité est interdite"; label en unofficial "interference with dignity is prohibited"; }
pub enum FinaliteEmpreinteGenetique { label fr official "finalités fermées de l'identification génétique"; label en unofficial "closed purposes for genetic identification"; ProcedureJudiciaire, MedicaleOuRecherche, IdentifierDefunt, Defense, Antidopage }
pub relation identification_genetique_finalite(e: ExamenBiologique, f: FinaliteEmpreinteGenetique) kind empirical { key(e); label fr official "finalité légale de l'identification génétique"; label en unofficial "statutory purpose of genetic identification"; }
pub relation identification_genetique_admissible(e: ExamenBiologique) kind derived { label fr official "l'identification génétique poursuit une finalité fermée admise"; label en unofficial "genetic identification pursues an admitted closed-list purpose"; }
pub relation operateur_police_scientifique_ou_agree(p: Personne) kind empirical { label fr official "l'opérateur est un service de police scientifique ou une personne agréée"; label en unofficial "the operator is a forensic-police service or an approved person"; }
pub relation operateur_identification_habilite(p: Personne) kind derived { label fr official "l'opérateur est habilité à procéder à l'identification génétique"; label en unofficial "the operator is authorized to carry out genetic identification"; }
pub relation exercice_droits_politiques(p: Personne) kind empirical { label fr official "la personne exerce ou non ses droits politiques"; label en unofficial "the person exercises or does not exercise political rights"; }
pub relation exercice_droits_civils_independant(p: Personne) kind derived { label fr official "l'exercice des droits civils est indépendant des droits politiques"; label en unofficial "exercise of civil rights is independent of political rights"; }
pub relation traite_reciprocite_droits_civils(p: Personne) kind empirical { label fr official "un traité accorde réciproquement aux Français les droits civils de l'Etat de l'étranger"; label en unofficial "a treaty reciprocally grants French nationals the foreign national's State civil rights"; }
pub relation etranger_jouit_droits_civils_reciproques(p: Personne) kind derived { label fr official "l'étranger jouit en France des droits civils réciproques"; label en unofficial "the foreign national enjoys reciprocal civil rights in France"; }
pub relation majeur_ne_don_tiers_demande_acces(p: Personne) kind empirical { label fr official "la personne majeure née d'un don avec tiers demande les données prévues par le code de la santé publique"; label en unofficial "an adult born from third-party donation requests data provided by the Public Health Code"; }
pub relation acces_donnees_donneur_admissible(p: Personne) kind derived { label fr official "l'accès aux données non identifiantes ou à l'identité du donneur est admissible"; label en unofficial "access to non-identifying data or donor identity is available"; }
pub relation convention_deroge_chapitre_corps(c: ConventionCorporelle) kind empirical { label fr official "une convention prétend déroger aux dispositions du chapitre relatif au corps humain"; label en unofficial "an agreement purports to derogate from the chapter on the human body"; }
pub relation derogation_chapitre_corps_inopposable(c: ConventionCorporelle) kind derived { label fr official "la dérogation conventionnelle aux dispositions d'ordre public est inopposable"; label en unofficial "contractual derogation from mandatory provisions is ineffective"; }

@source(CC_ART8)
rule JouissanceDroitsCivils(p: Personne) strict { label fr official "Article 8. Tout Français jouit des droits civils"; label en unofficial "Article 8. Every French national enjoys civil rights"; when ressortissant_francais(p); then jouit_des_droits_civils(p); }

@source(CC_ART10)
rule ConcoursObligatoireJustice(p: Personne) defeasible { label fr official "Article 10. La personne légalement requise concourt à la manifestation de la vérité sauf motif légitime"; label en unofficial "Article 10. A person lawfully required assists the ascertainment of truth absent a legitimate reason"; when requis_legalement_de_concourir_a_la_justice(p) and not_known(motif_legitime_de_refus(p)); then concours_a_la_justice_exigible(p); }

@source(CC_ART16_1_1)
rule RespectRestesHumains(r: RestesHumains) strict { label fr official "Article 16-1-1. Les restes et les cendres sont traités avec respect, dignité et décence"; label en unofficial "Article 16-1-1. Remains and ashes are treated with respect, dignity and decency"; when restes_traites_avec_respect(r); then protection_post_mortem_respectee(r); }

@source(CC_ART16_2)
rule MesureContreAtteinteIlliciteAuCorps(i: InterventionMedicale) defeasible { label fr official "Article 16-2. Une atteinte illicite au corps ouvre la mesure judiciaire propre à l'empêcher ou la faire cesser"; label en unofficial "Article 16-2. Unlawful interference with the body permits a judicial preventive or cessation measure"; when atteinte_illicite_au_corps(i); then mesure_preventive_corporelle_admissible(i); }

@source(CC_ART16_4) {
  rule InterdictionEugenisme(i: InterventionMedicale) strict { label fr official "Article 16-4. La pratique eugénique organisant la sélection des personnes est interdite"; label en unofficial "Article 16-4. Eugenic selection of persons is prohibited"; when pratique_eugenique(i); then intervention_genetique_interdite(i); }
  rule InterdictionClonageReproductif(i: InterventionMedicale) strict { label fr official "Article 16-4. Le clonage reproductif est interdit"; label en unofficial "Article 16-4. Reproductive cloning is prohibited"; when clonage_reproductif(i); then intervention_genetique_interdite(i); }
  rule InterdictionModificationDescendance(i: InterventionMedicale) strict { label fr official "Article 16-4. La modification génétique de la descendance est interdite hors prévention, diagnostic ou traitement"; label en unofficial "Article 16-4. Germline genetic alteration is prohibited outside prevention, diagnosis or treatment"; when modification_genetique_descendance(i); then intervention_genetique_interdite(i); }
}

@source(CC_ART16_6)
rule InterdictionRemunerationCorporelle(d: DonCorporel) strict { label fr official "Article 16-6. Aucune rémunération n'est allouée pour expérimentation, prélèvement ou collecte"; label en unofficial "Article 16-6. No payment is made for experimentation, removal or collection"; when remuneration_experimentation_ou_prelevement(d); then remuneration_corporelle_interdite(d); }

@source(CC_ART16_8)
rule SecretDonneurReceveur(d: DonCorporel) defeasible { label fr official "Article 16-8. Les identités du donneur et du receveur ne sont pas divulguées hors nécessité thérapeutique médicale"; label en unofficial "Article 16-8. Donor and recipient identities are not disclosed outside medical therapeutic necessity"; when divulgation_identites_donneur_receveur(d) and not_known(necessite_therapeutique_identification(d)); then divulgation_identites_interdite(d); }

@source(CC_ART16_13)
rule InterdictionDiscriminationGenetique(p: Personne) strict { label fr official "Article 16-13. Nul ne peut subir une discrimination en raison de ses caractéristiques génétiques"; label en unofficial "Article 16-13. No one may suffer discrimination based on genetic characteristics"; when discrimination_genetique_subie(p); then discrimination_genetique_interdite(p); }

@source(CC_ART16_14)
rule ConditionsImagerieCerebrale(e: ExamenBiologique) strict { label fr official "Article 16-14. L'imagerie cérébrale exige une finalité admise et un consentement écrit préalable"; label en unofficial "Article 16-14. Brain imaging requires an admitted purpose and prior written consent"; when imagerie_finalite_medicale_recherche_ou_expertise(e) and consentement_ecrit_prealable_eclaire(e); then imagerie_cerebrale_admissible(e); }

@source(CC_ART9)
rule ProtectionViePrivee(p: Personne) strict { label fr official "Article 9. L'atteinte à la vie privée ouvre les mesures propres à l'empêcher ou la faire cesser"; label en unofficial "Article 9. Interference with private life opens measures to prevent or stop it"; when atteinte_vie_privee(p); then mesure_cessation_vie_privee_admissible(p); }

@source(CC_ART9_1)
rule ProtectionPresomptionInnocence(p: Personne) strict { label fr official "Article 9-1. La présentation publique comme coupable avant condamnation ouvre rectification ou communiqué"; label en unofficial "Article 9-1. Public presentation as guilty before conviction opens correction or a public statement"; when presente_publiquement_coupable_avant_condamnation(p); then rectification_presomption_innocence_admissible(p); }

@source(CC_ART16)
rule InterdictionAtteinteDignite(p: Personne) strict { label fr official "Article 16. La loi interdit toute atteinte à la dignité de la personne"; label en unofficial "Article 16. The law prohibits any interference with human dignity"; when atteinte_dignite_personne(p); then atteinte_dignite_interdite(p); }

@source(CC_ART16_11) {
  rule IdentificationProcedureJudiciaire(e: ExamenBiologique) strict { label fr official "Article 16-11, 1°. L'identification génétique est admise dans une procédure judiciaire"; label en unofficial "Article 16-11(1). Genetic identification is admitted in judicial proceedings"; when identification_genetique_finalite(e, ProcedureJudiciaire); then identification_genetique_admissible(e); }
  rule IdentificationMedicaleOuRecherche(e: ExamenBiologique) strict { label fr official "Article 16-11, 2°. L'identification génétique est admise à des fins médicales ou scientifiques"; label en unofficial "Article 16-11(2). Genetic identification is admitted for medical or research purposes"; when identification_genetique_finalite(e, MedicaleOuRecherche); then identification_genetique_admissible(e); }
  rule IdentificationDefunt(e: ExamenBiologique) strict { label fr official "Article 16-11, 3°. L'identification génétique est admise pour identifier une personne décédée inconnue"; label en unofficial "Article 16-11(3). Genetic identification is admitted to identify an unknown deceased person"; when identification_genetique_finalite(e, IdentifierDefunt); then identification_genetique_admissible(e); }
  rule IdentificationDefense(e: ExamenBiologique) strict { label fr official "Article 16-11, 4°. L'identification génétique est admise dans le cas prévu par le code de la défense"; label en unofficial "Article 16-11(4). Genetic identification is admitted in the defense-code case"; when identification_genetique_finalite(e, Defense); then identification_genetique_admissible(e); }
  rule IdentificationAntidopage(e: ExamenBiologique) strict { label fr official "Article 16-11, 5°. L'identification génétique est admise pour la lutte contre le dopage"; label en unofficial "Article 16-11(5). Genetic identification is admitted for anti-doping purposes"; when identification_genetique_finalite(e, Antidopage); then identification_genetique_admissible(e); }
}

@source(CC_ART16_12)
rule OperateurIdentificationGenetique(p: Personne) strict { label fr official "Article 16-12. Seuls les services scientifiques et personnes agréées sont habilités"; label en unofficial "Article 16-12. Only forensic services and approved persons are authorized"; when operateur_police_scientifique_ou_agree(p); then operateur_identification_habilite(p); }

@source(CC_ART7)
rule IndependanceDroitsCivilsPolitiques(p: Personne) strict { label fr official "Article 7. L'exercice des droits civils est indépendant de celui des droits politiques"; label en unofficial "Article 7. Exercise of civil rights is independent of political rights"; when exercice_droits_politiques(p); then exercice_droits_civils_independant(p); }

@source(CC_ART11)
rule ReciprociteDroitsCivilsEtranger(p: Personne) strict { label fr official "Article 11. L'étranger jouit des droits civils accordés réciproquement par traité"; label en unofficial "Article 11. A foreign national enjoys civil rights reciprocally granted by treaty"; when traite_reciprocite_droits_civils(p); then etranger_jouit_droits_civils_reciproques(p); }

@source(CC_ART16_8_1)
rule AccesDonneurPersonneMajeure(p: Personne) strict { label fr official "Article 16-8-1. La personne majeure née d'un don peut demander les données du tiers donneur prévues par le code de la santé publique"; label en unofficial "Article 16-8-1. An adult born from donation may request donor data provided by the Public Health Code"; when majeur_ne_don_tiers_demande_acces(p); then acces_donnees_donneur_admissible(p); }

@source(CC_ART16_9)
rule OrdrePublicCorpsHumain(c: ConventionCorporelle) strict { label fr official "Article 16-9. Les dispositions du chapitre sont d'ordre public"; label en unofficial "Article 16-9. The chapter's provisions are mandatory law"; when convention_deroge_chapitre_corps(c); then derogation_chapitre_corps_inopposable(c); }
