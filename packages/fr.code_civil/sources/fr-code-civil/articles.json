      "declared": {
        "2223": {
          "status": "SOURCE_ONLY",
          "reason": "Renvoi : « les dispositions du présent titre ne font pas obstacle à l'application des règles spéciales prévues par d'autres lois ». L'article ne pose aucune condition propre ; les délais spéciaux relèvent des lois qui les édictent (SOURCES.json, external). Frontière de renvoi."
        },
        "2255": {
          "status": "SOURCE_ONLY",
          "reason": "Définition de la possession (« la détention ou la jouissance d'une chose ou d'un droit que nous tenons ou que nous exerçons par nous-mêmes, ou par un autre ») : ses éléments sont repris comme entrées de cas et exécutés aux articles 2256 à 2278. Frontière d'énoncé définitoire."
        },
        "2258": {
          "status": "SOURCE_ONLY",
          "reason": "Définition de la prescription acquisitive (« un moyen d'acquérir un bien ou un droit par l'effet de la possession ») : exécutée à travers ses conditions et délais, articles 2260 à 2277. Frontière d'énoncé définitoire."
        },
        "2259": {
          "status": "SOURCE_ONLY",
          "reason": "Renvoi d'application : les articles 2221, 2222 et les chapitres III et IV du titre XX s'appliquent à la prescription acquisitive ; ces règles sont exécutées au titre XX sur l'action (Causa) et ne se dédoublent pas ici sur la possession. Frontière de renvoi."
        }
      }
