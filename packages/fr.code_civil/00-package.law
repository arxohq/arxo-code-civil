// CODE CIVIL — axe temporel de la prescription extinctive pour la démo OECD.
//
// Le monument de 1804 reste dans `fr.code_civil_1804`. Ce paquet distinct
// porte les versions officielles LEGI avant/après la loi n° 2008-561 et la
// loi de réforme elle-même, et depuis la seconde vague (17 septembre 2026) les
// titres XX et XXI du livre III en entier : 57 articles exécutables sur 61
// (21-prescription-seconde-vague.law, 22-possession.law). Les autres livres
// du Code sont dans les paquets `fr.code_civil.*` (docs/foundations/fr-code-civil/).

language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";
import doctrine.ius_privatum version "0.1.0";

// Source, éditions, publications et fragments : 01-sources.law (généré).

type Persona = doctrine.ius_privatum::Persona;
type Causa = doctrine.ius_privatum::Causa;
