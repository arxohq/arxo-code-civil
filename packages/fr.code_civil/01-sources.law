// BEGIN GENERATED FRAGMENTS

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2219")
pub fragment CC_POST_ART2219 in CC_POST_2008 {
    label fr official "Article 2219";
    kind article;
    locator "article/2219";
    text fr official """Article 2219
La prescription extinctive est un mode d'extinction d'un droit résultant de l'inaction de son titulaire pendant un certain laps de temps.
""";
    content_hash "sha256:0b7ecca0ee814319db91d174578fb164b2ac80bbd82794ff733b36bd4f55401a";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2220")
pub fragment CC_POST_ART2220 in CC_POST_2008 {
    label fr official "Article 2220";
    kind article;
    locator "article/2220";
    text fr official """Article 2220
Les délais de forclusion ne sont pas, sauf dispositions contraires prévues par la loi, régis par le présent titre.
""";
    content_hash "sha256:b77692b2f616cfc3e5da7a5c469573dfb1ed2c4e174ed6e13078f777cf1bceef";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2221")
pub fragment CC_POST_ART2221 in CC_POST_2008 {
    label fr official "Article 2221";
    kind article;
    locator "article/2221";
    text fr official """Article 2221
La prescription extinctive est soumise à la loi régissant le droit qu'elle affecte.
""";
    content_hash "sha256:355a18eb571d8df3d5c1ab0eaf3acc2de63da1d787487d1635419efdd5651d7b";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2222")
pub fragment CC_POST_ART2222 in CC_POST_2008 {
    label fr official "Article 2222";
    kind article;
    locator "article/2222";
    text fr official """Article 2222
La loi qui allonge la durée d'une prescription ou d'un délai de forclusion est sans effet sur une prescription ou une forclusion acquise. Elle s'applique lorsque le délai de prescription ou le délai de forclusion n'était pas expiré à la date de son entrée en vigueur. Il est alors tenu compte du délai déjà écoulé.
En cas de réduction de la durée du délai de prescription ou du délai de forclusion, ce nouveau délai court à compter du jour de l'entrée en vigueur de la loi nouvelle, sans que la durée totale puisse excéder la durée prévue par la loi antérieure.
""";
    content_hash "sha256:622d03bacc2e42a854b0b90c309ba1c19e2246ac5eae5ec8ea38fef860c55e0e";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2223")
pub fragment CC_POST_ART2223 in CC_POST_2008 {
    label fr official "Article 2223";
    kind article;
    locator "article/2223";
    text fr official """Article 2223
Les dispositions du présent titre ne font pas obstacle à l'application des règles spéciales prévues par d'autres lois.
""";
    content_hash "sha256:716837220ea08479a2fdf54022fb324796bb5f041df84ac20fee5a714b494247";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2224")
pub fragment CC_POST_ART2224 in CC_POST_2008 {
    label fr official "Article 2224";
    kind article;
    locator "article/2224";
    text fr official """Article 2224
Les actions personnelles ou mobilières se prescrivent par cinq ans à compter du jour où le titulaire d'un droit a connu ou aurait dû connaître les faits lui permettant de l'exercer.
""";
    content_hash "sha256:672b74a19b0ebe429181790cbe798f0f53e22cb2eeb8706cded06dbf5a40c629";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2225")
pub fragment CC_POST_ART2225 in CC_POST_2008 {
    label fr official "Article 2225";
    kind article;
    locator "article/2225";
    text fr official """Article 2225
L'action en responsabilité dirigée contre les personnes ayant représenté ou assisté les parties en justice, y compris à raison de la perte ou de la destruction des pièces qui leur ont été confiées, se prescrit par cinq ans à compter de la fin de leur mission.
""";
    content_hash "sha256:352e6e95bbbd0915d3b615cb6e4b2ce2e7fbf26274b47a4c1f9e0edc14a8d67d";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2226")
pub fragment CC_POST_ART2226 in CC_POST_2008 {
    label fr official "Article 2226";
    kind article;
    locator "article/2226";
    text fr official """Article 2226
L'action en responsabilité née à raison d'un événement ayant entraîné un dommage corporel, engagée par la victime directe ou indirecte des préjudices qui en résultent, se prescrit par dix ans à compter de la date de la consolidation du dommage initial ou aggravé.
Toutefois, en cas de préjudice causé par des tortures ou des actes de barbarie, ou par des violences ou des agressions sexuelles commises contre un mineur, l'action en responsabilité civile est prescrite par vingt ans.
""";
    content_hash "sha256:982b92729bccfba2091a5e23af53d79e3b2e1967513c0be96b961565fed1e483";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2226_1")
pub fragment CC_POST_ART2226_1 in CC_POST_2008 {
    label fr official "Article 2226-1";
    kind article;
    locator "article/2226-1";
    text fr official """Article 2226-1
L'action en responsabilité tendant à la réparation du préjudice écologique réparable en application du chapitre III du sous-titre II du titre III du présent livre se prescrit par dix ans à compter du jour où le titulaire de l'action a connu ou aurait dû connaître la manifestation du préjudice écologique.
""";
    content_hash "sha256:1e63ee04eb51d3666b0ac874a4c912e1e299bb847154cc47fdd40e6b63ee60ed";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2227")
pub fragment CC_POST_ART2227 in CC_POST_2008 {
    label fr official "Article 2227";
    kind article;
    locator "article/2227";
    text fr official """Article 2227
Le droit de propriété est imprescriptible. Sous cette réserve, les actions réelles immobilières se prescrivent par trente ans à compter du jour où le titulaire d'un droit a connu ou aurait dû connaître les faits lui permettant de l'exercer.
""";
    content_hash "sha256:0746eace721ce2652293358c06de5ca9bdc6b10f587990aa2b5b4e9b667ccfd8";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2228")
pub fragment CC_POST_ART2228 in CC_POST_2008 {
    label fr official "Article 2228";
    kind article;
    locator "article/2228";
    text fr official """Article 2228
La prescription se compte par jours, et non par heures.
""";
    content_hash "sha256:dd06365b6b1300407fadd02ddc12c5220fd9139343f3ce91809ff20bf62588a6";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2229")
pub fragment CC_POST_ART2229 in CC_POST_2008 {
    label fr official "Article 2229";
    kind article;
    locator "article/2229";
    text fr official """Article 2229
Elle est acquise lorsque le dernier jour du terme est accompli.
""";
    content_hash "sha256:28578b7da1445ef66f205effb784bcc5dae77310d748b2ae6ccebd52a8ca3009";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2230")
pub fragment CC_POST_ART2230 in CC_POST_2008 {
    label fr official "Article 2230";
    kind article;
    locator "article/2230";
    text fr official """Article 2230
La suspension de la prescription en arrête temporairement le cours sans effacer le délai déjà couru.
""";
    content_hash "sha256:95b2928ad14c37044ed7a7435791766bdd790caa9d89909d5a3ccd25f5a307e2";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2231")
pub fragment CC_POST_ART2231 in CC_POST_2008 {
    label fr official "Article 2231";
    kind article;
    locator "article/2231";
    text fr official """Article 2231
L'interruption efface le délai de prescription acquis. Elle fait courir un nouveau délai de même durée que l'ancien.
""";
    content_hash "sha256:36c1dd29c857728fd634077c84a7f30f3ed1557fe546ee982a5d6703b50d3c1b";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2232")
pub fragment CC_POST_ART2232 in CC_POST_2008 {
    label fr official "Article 2232";
    kind article;
    locator "article/2232";
    text fr official """Article 2232
Le report du point de départ, la suspension ou l'interruption de la prescription ne peut avoir pour effet de porter le délai de la prescription extinctive au-delà de vingt ans à compter du jour de la naissance du droit.
Le premier alinéa n'est pas applicable dans les cas mentionnés aux articles 2226, 2226-1, 2227, 2233 et 2236, au premier alinéa de l'article 2241 et à l'article 2244. Il ne s'applique pas non plus aux actions relatives à l'état des personnes.
""";
    content_hash "sha256:b1a33bf6d27cec1af359949222bf7220bc63bc536ae53eb79e94833b5d293e0b";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2233")
pub fragment CC_POST_ART2233 in CC_POST_2008 {
    label fr official "Article 2233";
    kind article;
    locator "article/2233";
    text fr official """Article 2233
La prescription ne court pas :
1° A l'égard d'une créance qui dépend d'une condition, jusqu'à ce que la condition arrive ;
2° A l'égard d'une action en garantie, jusqu'à ce que l'éviction ait lieu ;
3° A l'égard d'une créance à terme, jusqu'à ce que ce terme soit arrivé.
""";
    content_hash "sha256:4b6aa3b7f3b2fc0ad5cd26148ff08021ad06ce8553a79370f16043d6f11b8386";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2234")
pub fragment CC_POST_ART2234 in CC_POST_2008 {
    label fr official "Article 2234";
    kind article;
    locator "article/2234";
    text fr official """Article 2234
La prescription ne court pas ou est suspendue contre celui qui est dans l'impossibilité d'agir par suite d'un empêchement résultant de la loi, de la convention ou de la force majeure.
""";
    content_hash "sha256:7ab6a40bc3620209336b71c147afcae8e5afadbd91ec87509576b45490e727e4";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2235")
pub fragment CC_POST_ART2235 in CC_POST_2008 {
    label fr official "Article 2235";
    kind article;
    locator "article/2235";
    text fr official """Article 2235
Elle ne court pas ou est suspendue contre les mineurs non émancipés et les majeurs en tutelle, sauf pour les actions en paiement ou en répétition des salaires, arrérages de rente, pensions alimentaires, loyers, fermages, charges locatives, intérêts des sommes prêtées et, généralement, les actions en paiement de tout ce qui est payable par années ou à des termes périodiques plus courts.
""";
    content_hash "sha256:6c5a6e110ff5528cf7d3f8d396433a8aa69842d1c0b71036344ac76f4ba8408d";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2236")
pub fragment CC_POST_ART2236 in CC_POST_2008 {
    label fr official "Article 2236";
    kind article;
    locator "article/2236";
    text fr official """Article 2236
Elle ne court pas ou est suspendue entre époux, ainsi qu'entre partenaires liés par un pacte civil de solidarité.
""";
    content_hash "sha256:07a76db8cade5b3c0b083be124fb7eff86b4fad9e450b2ad5f459485845fc94a";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2237")
pub fragment CC_POST_ART2237 in CC_POST_2008 {
    label fr official "Article 2237";
    kind article;
    locator "article/2237";
    text fr official """Article 2237
Elle ne court pas ou est suspendue contre l'héritier acceptant à concurrence de l'actif net, à l'égard des créances qu'il a contre la succession.
""";
    content_hash "sha256:b369f85cbb8d41966f60a7bc79663e602e038f74a24618da084e165aa436e47d";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2238")
pub fragment CC_POST_ART2238 in CC_POST_2008 {
    label fr official "Article 2238";
    kind article;
    locator "article/2238";
    text fr official """Article 2238
La prescription est suspendue à compter du jour où, après la survenance d'un litige, les parties conviennent de recourir à la médiation ou à la conciliation ou, à défaut d'accord écrit, à compter du jour de la première réunion de médiation ou de conciliation. La prescription est également suspendue à compter de la conclusion d'une convention de procédure participative ou à compter de l'accord du débiteur constaté par l'huissier de justice pour participer à la procédure prévue à l'article L. 125-1 du code des procédures civiles d'exécution.
Le délai de prescription recommence à courir, pour une durée qui ne peut être inférieure à six mois, à compter de la date à laquelle soit l'une des parties ou les deux, soit le médiateur ou le conciliateur déclarent que la médiation ou la conciliation est terminée. En cas de convention de procédure participative, le délai de prescription recommence à courir à compter du terme de la convention, pour une durée qui ne peut être inférieure à six mois. En cas d'échec de la procédure prévue au même article, le délai de prescription recommence à courir à compter de la date du refus du débiteur, constaté par l'huissier, pour une durée qui ne peut être inférieure à six mois.
""";
    content_hash "sha256:7de68d6ed845bcd95c5ca76851b7d5c42c0b755a0f7a53080cbbcbb127ac61f7";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2239")
pub fragment CC_POST_ART2239 in CC_POST_2008 {
    label fr official "Article 2239";
    kind article;
    locator "article/2239";
    text fr official """Article 2239
La prescription est également suspendue lorsque le juge fait droit à une demande de mesure d'instruction présentée avant tout procès.
Le délai de prescription recommence à courir, pour une durée qui ne peut être inférieure à six mois, à compter du jour où la mesure a été exécutée.
""";
    content_hash "sha256:9e742ac71c8ecd1fe04db3e3bfceb323387b9b856a4882cc1429615d47e89d12";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2240")
pub fragment CC_POST_ART2240 in CC_POST_2008 {
    label fr official "Article 2240";
    kind article;
    locator "article/2240";
    text fr official """Article 2240
La reconnaissance par le débiteur du droit de celui contre lequel il prescrivait interrompt le délai de prescription.
""";
    content_hash "sha256:bcbc62c22dfea1a50b6c3e815a86f7439e20b605b079443342cb7537b70af985";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2241")
pub fragment CC_POST_ART2241 in CC_POST_2008 {
    label fr official "Article 2241";
    kind article;
    locator "article/2241";
    text fr official """Article 2241
La demande en justice, même en référé, interrompt le délai de prescription ainsi que le délai de forclusion.
Il en est de même lorsqu'elle est portée devant une juridiction incompétente ou lorsque l'acte de saisine de la juridiction est annulé par l'effet d'un vice de procédure.
""";
    content_hash "sha256:8ce0e76eed4ba2464036a5bd87aa39dbac9fd33d20a8b6954a892c0c4e34f991";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2242")
pub fragment CC_POST_ART2242 in CC_POST_2008 {
    label fr official "Article 2242";
    kind article;
    locator "article/2242";
    text fr official """Article 2242
L'interruption résultant de la demande en justice produit ses effets jusqu'à l'extinction de l'instance.
""";
    content_hash "sha256:7ef69c6f2e5b34f1cca1ae8ad134aea9259137417aa9bd99588d3e6d5c6ca7b7";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2243")
pub fragment CC_POST_ART2243 in CC_POST_2008 {
    label fr official "Article 2243";
    kind article;
    locator "article/2243";
    text fr official """Article 2243
L'interruption est non avenue si le demandeur se désiste de sa demande ou laisse périmer l'instance, ou si sa demande est définitivement rejetée.
""";
    content_hash "sha256:72faca5c70ec9019c55f62ceb8e9174c78f2beab54a4cc5d3d316ba88d0a9d3f";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2244")
pub fragment CC_POST_ART2244 in CC_POST_2008 {
    label fr official "Article 2244";
    kind article;
    locator "article/2244";
    text fr official """Article 2244
Le délai de prescription ou le délai de forclusion est également interrompu par une mesure conservatoire prise en application du code des procédures civiles d'exécution ou un acte d'exécution forcée.
""";
    content_hash "sha256:0e0c34051d82f5648ce12982c39ceeb3ab0300e5a410f5a0124a487d63b1413a";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2245")
pub fragment CC_POST_ART2245 in CC_POST_2008 {
    label fr official "Article 2245";
    kind article;
    locator "article/2245";
    text fr official """Article 2245
L'interpellation faite à l'un des débiteurs solidaires par une demande en justice ou par un acte d'exécution forcée ou la reconnaissance par le débiteur du droit de celui contre lequel il prescrivait interrompt le délai de prescription contre tous les autres, même contre leurs héritiers.
En revanche, l'interpellation faite à l'un des héritiers d'un débiteur solidaire ou la reconnaissance de cet héritier n'interrompt pas le délai de prescription à l'égard des autres cohéritiers, même en cas de créance hypothécaire, si l'obligation est divisible. Cette interpellation ou cette reconnaissance n'interrompt le délai de prescription, à l'égard des autres codébiteurs, que pour la part dont cet héritier est tenu.
Pour interrompre le délai de prescription pour le tout, à l'égard des autres codébiteurs, il faut l'interpellation faite à tous les héritiers du débiteur décédé ou la reconnaissance de tous ces héritiers.
""";
    content_hash "sha256:fbf626b3e5e07745e0a17fb106143a2917f10a618971dc2b6057e96607dd7208";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2246")
pub fragment CC_POST_ART2246 in CC_POST_2008 {
    label fr official "Article 2246";
    kind article;
    locator "article/2246";
    text fr official """Article 2246
L'interpellation faite au débiteur principal ou sa reconnaissance interrompt le délai de prescription contre la caution.
""";
    content_hash "sha256:064f22d29c9432e0e354f69c307c208633bae14692ad63762bb8a3b236160883";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2247")
pub fragment CC_POST_ART2247 in CC_POST_2008 {
    label fr official "Article 2247";
    kind article;
    locator "article/2247";
    text fr official """Article 2247
Les juges ne peuvent pas suppléer d'office le moyen résultant de la prescription.
""";
    content_hash "sha256:a18dd9dadb0bb1fc68552217c3f373532f093a2d16695cc3dad79ce441336a81";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2248")
pub fragment CC_POST_ART2248 in CC_POST_2008 {
    label fr official "Article 2248";
    kind article;
    locator "article/2248";
    text fr official """Article 2248
Sauf renonciation, la prescription peut être opposée en tout état de cause, même devant la cour d'appel.
""";
    content_hash "sha256:f7bc70dcb198d1cd1c6e97c9aeab2fbd00c0474aa5e765bbd2885e4297fb2b3c";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2249")
pub fragment CC_POST_ART2249 in CC_POST_2008 {
    label fr official "Article 2249";
    kind article;
    locator "article/2249";
    text fr official """Article 2249
Le paiement effectué pour éteindre une dette ne peut être répété au seul motif que le délai de prescription était expiré.
""";
    content_hash "sha256:fbad06e9a158d590c8b1b19ffb6199d40690fe662d6b2b4e6962505c2f8c8976";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2250")
pub fragment CC_POST_ART2250 in CC_POST_2008 {
    label fr official "Article 2250";
    kind article;
    locator "article/2250";
    text fr official """Article 2250
Seule une prescription acquise est susceptible de renonciation.
""";
    content_hash "sha256:4a00c79028b81d2ec3806580d9d0539c093491e8e871424bc515331381bf75a2";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2251")
pub fragment CC_POST_ART2251 in CC_POST_2008 {
    label fr official "Article 2251";
    kind article;
    locator "article/2251";
    text fr official """Article 2251
La renonciation à la prescription est expresse ou tacite.
La renonciation tacite résulte de circonstances établissant sans équivoque la volonté de ne pas se prévaloir de la prescription.
""";
    content_hash "sha256:c06deede76508ef92a1ca273541caf8f2cd6b2e87287508331d0afd93b34ffb9";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2252")
pub fragment CC_POST_ART2252 in CC_POST_2008 {
    label fr official "Article 2252";
    kind article;
    locator "article/2252";
    text fr official """Article 2252
Celui qui ne peut exercer par lui-même ses droits ne peut renoncer seul à la prescription acquise.
""";
    content_hash "sha256:459ce8187a5fc88c8790357dc34955345bace629708886d857106114a524a1da";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2253")
pub fragment CC_POST_ART2253 in CC_POST_2008 {
    label fr official "Article 2253";
    kind article;
    locator "article/2253";
    text fr official """Article 2253
Les créanciers, ou toute autre personne ayant intérêt à ce que la prescription soit acquise, peuvent l'opposer ou l'invoquer lors même que le débiteur y renonce.
""";
    content_hash "sha256:e450b16d43b2a844fb67759f6523a826ee9c3f203761094ca16955dcfce6fb7f";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2254")
pub fragment CC_POST_ART2254 in CC_POST_2008 {
    label fr official "Article 2254";
    kind article;
    locator "article/2254";
    text fr official """Article 2254
La durée de la prescription peut être abrégée ou allongée par accord des parties. Elle ne peut toutefois être réduite à moins d'un an ni étendue à plus de dix ans.
Les parties peuvent également, d'un commun accord, ajouter aux causes de suspension ou d'interruption de la prescription prévues par la loi.
Les dispositions des deux alinéas précédents ne sont pas applicables aux actions en paiement ou en répétition des salaires, arrérages de rente, pensions alimentaires, loyers, fermages, charges locatives, intérêts des sommes prêtées et, généralement, aux actions en paiement de tout ce qui est payable par années ou à des termes périodiques plus courts.
""";
    content_hash "sha256:1bcf2306b31308409bfdfa8f0353823ef870a049a3a1ff1acf5d9a032e93428a";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2255")
pub fragment CC_POST_ART2255 in CC_POST_2008 {
    label fr official "Article 2255";
    kind article;
    locator "article/2255";
    text fr official """Article 2255
La possession est la détention ou la jouissance d'une chose ou d'un droit que nous tenons ou que nous exerçons par nous-mêmes, ou par un autre qui la tient ou qui l'exerce en notre nom.
""";
    content_hash "sha256:680831f50bd7bcddd3a1faf92506397274ae039f2a19ee22a7a0c1e52edba646";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2256")
pub fragment CC_POST_ART2256 in CC_POST_2008 {
    label fr official "Article 2256";
    kind article;
    locator "article/2256";
    text fr official """Article 2256
On est toujours présumé posséder pour soi, et à titre de propriétaire, s'il n'est prouvé qu'on a commencé à posséder pour un autre.
""";
    content_hash "sha256:d8b2e22c48313f393bddf9255ffce4fa2d22a79396d7f200fb17fd73e1207579";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2257")
pub fragment CC_POST_ART2257 in CC_POST_2008 {
    label fr official "Article 2257";
    kind article;
    locator "article/2257";
    text fr official """Article 2257
Quand on a commencé à posséder pour autrui, on est toujours présumé posséder au même titre, s'il n'y a preuve du contraire.
""";
    content_hash "sha256:adb9d109206c37d714fa748ee6b9795cf04cf340bc1068b2d5fa2954b3bde36b";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2258")
pub fragment CC_POST_ART2258 in CC_POST_2008 {
    label fr official "Article 2258";
    kind article;
    locator "article/2258";
    text fr official """Article 2258
La prescription acquisitive est un moyen d'acquérir un bien ou un droit par l'effet de la possession sans que celui qui l'allègue soit obligé d'en rapporter un titre ou qu'on puisse lui opposer l'exception déduite de la mauvaise foi.
""";
    content_hash "sha256:d4070293fc904458a27be2325e8dbdeec1ffe6af75bb379c4b1c7f0a47894700";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2259")
pub fragment CC_POST_ART2259 in CC_POST_2008 {
    label fr official "Article 2259";
    kind article;
    locator "article/2259";
    text fr official """Article 2259
Sont applicables à la prescription acquisitive les articles 2221 et 2222, et les chapitres III et IV du titre XX du présent livre sous réserve des dispositions du présent chapitre.
""";
    content_hash "sha256:30b1fec40071618702f059cf6dbf5b4cab0e2de599dec2cca2b26bd1b40a0cf9";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2260")
pub fragment CC_POST_ART2260 in CC_POST_2008 {
    label fr official "Article 2260";
    kind article;
    locator "article/2260";
    text fr official """Article 2260
On ne peut prescrire les biens ou les droits qui ne sont point dans le commerce.
""";
    content_hash "sha256:dfa7ef11a81566b2acb97729d72bad61bf08ac853d9c6f96913d45ac761e6963";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2261")
pub fragment CC_POST_ART2261 in CC_POST_2008 {
    label fr official "Article 2261";
    kind article;
    locator "article/2261";
    text fr official """Article 2261
Pour pouvoir prescrire, il faut une possession continue et non interrompue, paisible, publique, non équivoque, et à titre de propriétaire.
""";
    content_hash "sha256:3aefa722963b312e3cb456241e4c92f4ebe976d6e59451c007dd822098bf2cbe";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2262")
pub fragment CC_POST_ART2262 in CC_POST_2008 {
    label fr official "Article 2262";
    kind article;
    locator "article/2262";
    text fr official """Article 2262
Les actes de pure faculté et ceux de simple tolérance ne peuvent fonder ni possession ni prescription.
""";
    content_hash "sha256:3437e63007b43bfad843246d6b27770ffd761880e8aaa699f3d535a2f5cf8cb2";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2263")
pub fragment CC_POST_ART2263 in CC_POST_2008 {
    label fr official "Article 2263";
    kind article;
    locator "article/2263";
    text fr official """Article 2263
Les actes de violence ne peuvent fonder non plus une possession capable d'opérer la prescription.
La possession utile ne commence que lorsque la violence a cessé.
""";
    content_hash "sha256:3ff4f30562dc9c4457fdd9ea7c6656ad56ca28b23612f8c917653e131ee9baac";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2264")
pub fragment CC_POST_ART2264 in CC_POST_2008 {
    label fr official "Article 2264";
    kind article;
    locator "article/2264";
    text fr official """Article 2264
Le possesseur actuel qui prouve avoir possédé anciennement est présumé avoir possédé dans le temps intermédiaire, sauf la preuve contraire.
""";
    content_hash "sha256:99ab84ca5706930310463fcea519db1cb4f5665a1a3cd0f0c90308c566a03faa";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2265")
pub fragment CC_POST_ART2265 in CC_POST_2008 {
    label fr official "Article 2265";
    kind article;
    locator "article/2265";
    text fr official """Article 2265
Pour compléter la prescription, on peut joindre à sa possession celle de son auteur, de quelque manière qu'on lui ait succédé, soit à titre universel ou particulier, soit à titre lucratif ou onéreux.
""";
    content_hash "sha256:18d1b5f889c39b94b7e6ea9ad0618f453e4ed3406e3079150397bf50a47c318e";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2266")
pub fragment CC_POST_ART2266 in CC_POST_2008 {
    label fr official "Article 2266";
    kind article;
    locator "article/2266";
    text fr official """Article 2266
Ceux qui possèdent pour autrui ne prescrivent jamais par quelque laps de temps que ce soit.
Ainsi, le locataire, le dépositaire, l'usufruitier et tous autres qui détiennent précairement le bien ou le droit du propriétaire ne peuvent le prescrire.
""";
    content_hash "sha256:27bc126fe24e31356770d9c1a2fff5e177d714924fd5f9bcd84a8732988eaf05";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2267")
pub fragment CC_POST_ART2267 in CC_POST_2008 {
    label fr official "Article 2267";
    kind article;
    locator "article/2267";
    text fr official """Article 2267
Les héritiers de ceux qui tenaient le bien ou le droit à quelqu'un des titres désignés par l'article précédent ne peuvent non plus prescrire.
""";
    content_hash "sha256:d5595165523634d373d9f2ef79f3b0b37ab77ff70679bec87896648e2172ce8e";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2268")
pub fragment CC_POST_ART2268 in CC_POST_2008 {
    label fr official "Article 2268";
    kind article;
    locator "article/2268";
    text fr official """Article 2268
Néanmoins, les personnes énoncées dans les articles 2266 et 2267 peuvent prescrire, si le titre de leur possession se trouve interverti, soit par une cause venant d'un tiers, soit par la contradiction qu'elles ont opposée au droit du propriétaire.
""";
    content_hash "sha256:9006b98b7350fc0322e04a0d3918f855ff4a1e8f32b94f349df31cecc4b540b7";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2269")
pub fragment CC_POST_ART2269 in CC_POST_2008 {
    label fr official "Article 2269";
    kind article;
    locator "article/2269";
    text fr official """Article 2269
Ceux à qui les locataires, dépositaires, usufruitiers et autres détenteurs précaires ont transmis le bien ou le droit par un titre translatif de propriété peuvent la prescrire.
""";
    content_hash "sha256:47027fad56aaf64b70eaeb19f7d3df804c7070ac4d6f72e51805fea742f87956";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2270")
pub fragment CC_POST_ART2270 in CC_POST_2008 {
    label fr official "Article 2270";
    kind article;
    locator "article/2270";
    text fr official """Article 2270
On ne peut pas prescrire contre son titre, en ce sens que l'on ne peut point se changer à soi-même la cause et le principe de sa possession.
""";
    content_hash "sha256:7d33d67752729dec51473303668bd4436cc7eb3f73760302c9cfc95843ec7116";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2271")
pub fragment CC_POST_ART2271 in CC_POST_2008 {
    label fr official "Article 2271";
    kind article;
    locator "article/2271";
    text fr official """Article 2271
La prescription acquisitive est interrompue lorsque le possesseur d'un bien est privé pendant plus d'un an de la jouissance de ce bien soit par le propriétaire, soit même par un tiers.
""";
    content_hash "sha256:a064540337f6129624a8fe1a270c8399bce4b30e46f03d2314886ee24ca9b25e";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2272")
pub fragment CC_POST_ART2272 in CC_POST_2008 {
    label fr official "Article 2272";
    kind article;
    locator "article/2272";
    text fr official """Article 2272
Le délai de prescription requis pour acquérir la propriété immobilière est de trente ans.
Toutefois, celui qui acquiert de bonne foi et par juste titre un immeuble en prescrit la propriété par dix ans.
""";
    content_hash "sha256:da3b7ea80ea4a817cd72a92cd738aeaf3555e5044e6a404962dea6bcf3f41afa";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2273")
pub fragment CC_POST_ART2273 in CC_POST_2008 {
    label fr official "Article 2273";
    kind article;
    locator "article/2273";
    text fr official """Article 2273
Le titre nul par défaut de forme ne peut servir de base à la prescription de dix ans.
""";
    content_hash "sha256:a57ab155e8671c5207ba28b44aa40f895d23db6aa8c71a2d9afc92ce625aa3e6";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2274")
pub fragment CC_POST_ART2274 in CC_POST_2008 {
    label fr official "Article 2274";
    kind article;
    locator "article/2274";
    text fr official """Article 2274
La bonne foi est toujours présumée, et c'est à celui qui allègue la mauvaise foi à la prouver.
""";
    content_hash "sha256:3dc694fe033993d0a643975ac4cfadd7942b08f291c4de67d496166ebebd09d4";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2275")
pub fragment CC_POST_ART2275 in CC_POST_2008 {
    label fr official "Article 2275";
    kind article;
    locator "article/2275";
    text fr official """Article 2275
Il suffit que la bonne foi ait existé au moment de l'acquisition.
""";
    content_hash "sha256:de7a17902f34758ea7680e8527ff395aca18dd7d17a3809045112fe1821a26d6";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2276")
pub fragment CC_POST_ART2276 in CC_POST_2008 {
    label fr official "Article 2276";
    kind article;
    locator "article/2276";
    text fr official """Article 2276
En fait de meubles, la possession vaut titre.
Néanmoins, celui qui a perdu ou auquel il a été volé une chose peut la revendiquer pendant trois ans à compter du jour de la perte ou du vol, contre celui dans les mains duquel il la trouve ; sauf à celui-ci son recours contre celui duquel il la tient.
""";
    content_hash "sha256:da41b300ef6e00965a6e7a014ca9b33670d8d3825b6392c657f4d09b233c2e2a";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2277")
pub fragment CC_POST_ART2277 in CC_POST_2008 {
    label fr official "Article 2277";
    kind article;
    locator "article/2277";
    text fr official """Article 2277
Si le possesseur actuel de la chose volée ou perdue l'a achetée dans une foire ou dans un marché, ou dans une vente publique, ou d'un marchand vendant des choses pareilles, le propriétaire originaire ne peut se la faire rendre qu'en remboursant au possesseur le prix qu'elle lui a coûté.
Le bailleur qui revendique, en vertu de l'article 2332, les meubles déplacés sans son consentement et qui ont été achetés dans les mêmes conditions doit également rembourser à l'acheteur le prix qu'ils lui ont coûté.
""";
    content_hash "sha256:9d853b1c6c2836ccbf951442c89570368459c139afe23d01774381aa444a915f";
}

@id("urn:fr:corpus:clir:code-civil#CC_POST_ART2278")
pub fragment CC_POST_ART2278 in CC_POST_2008 {
    label fr official "Article 2278";
    kind article;
    locator "article/2278";
    text fr official """Article 2278
La possession est protégée, sans avoir égard au fond du droit, contre le trouble qui l'affecte ou la menace.
La protection possessoire est pareillement accordée au détenteur contre tout autre que celui de qui il tient ses droits.
""";
    content_hash "sha256:6ce130da78286e0f2f547936245bdbc468bce7adc14ae58de41d657042a0dfb6";
}

@id("urn:fr:corpus:clir:code-civil#CC_PRE_ART2248")
pub fragment CC_PRE_ART2248 in CC_PRE_2008 {
    label fr official "Article 2248";
    kind article;
    locator "article/2248";
    text fr official """Article 2248
La prescription est interrompue par la reconnaissance que le débiteur ou le possesseur fait du droit de celui contre lequel il prescrivait.
""";
    content_hash "sha256:f17c31ca6554200ef8050077f99df8599fe0e71713f8396c024206e4b9bd617c";
}

@id("urn:fr:corpus:clir:code-civil#CC_PRE_ART2251")
pub fragment CC_PRE_ART2251 in CC_PRE_2008 {
    label fr official "Article 2251";
    kind article;
    locator "article/2251";
    text fr official """Article 2251
La prescription court contre toutes personnes, à moins qu'elles ne soient dans quelque exception établie par une loi.
""";
    content_hash "sha256:9b969d3ba3cf73f46491e36ac0a64f03b3b156530ae2f8165f2e62bd45c03d14";
}

@id("urn:fr:corpus:clir:code-civil#CC_PRE_ART2261")
pub fragment CC_PRE_ART2261 in CC_PRE_2008 {
    label fr official "Article 2261";
    kind article;
    locator "article/2261";
    text fr official """Article 2261
Elle est acquise lorsque le dernier jour du terme est accompli.
""";
    content_hash "sha256:450dfa785108cc8faf57e4650b8cbf02e83918e1f90aa265f6754091aeaa7f97";
}

@id("urn:fr:corpus:clir:code-civil#CC_PRE_ART2262")
pub fragment CC_PRE_ART2262 in CC_PRE_2008 {
    label fr official "Article 2262";
    kind article;
    locator "article/2262";
    text fr official """Article 2262
Toutes les actions, tant réelles que personnelles, sont prescrites par trente ans, sans que celui qui allègue cette prescription soit obligé d'en rapporter un titre ou qu'on puisse lui opposer l'exception déduite de la mauvaise foi.
""";
    content_hash "sha256:60c9dc81968e9d4b845ed63625dea0f2fb0bee0e7c0ca1ec469600946e09dde4";
}

@id("urn:fr:corpus:clir:code-civil#REFORM_ART26")
pub fragment REFORM_ART26 in REFORM_2008 {
    label fr official "Article 26";
    kind article;
    locator "article/26";
    text fr official """Article 26
I. ― Les dispositions de la présente loi qui allongent la durée d'une prescription s'appliquent lorsque le délai de prescription n'était pas expiré à la date de son entrée en vigueur. Il est alors tenu compte du délai déjà écoulé. II. ― Les dispositions de la présente loi qui réduisent la durée de la prescription s'appliquent aux prescriptions à compter du jour de l'entrée en vigueur de la présente loi, sans que la durée totale puisse excéder la durée prévue par la loi antérieure. III. ― Lorsqu'une instance a été introduite avant l'entrée en vigueur de la présente loi, l'action est poursuivie et jugée conformément à la loi ancienne. Cette loi s'applique également en appel et en cassation. La présente loi sera exécutée comme loi de l'Etat.
""";
    content_hash "sha256:c1689fa967d154889a7d99967b408a25ac651a778819c920a074cfc835e00bf2";
}

// END GENERATED FRAGMENTS
