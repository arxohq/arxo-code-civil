language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2236 : action entre époux, mariage dissous le 1er septembre 2024.
test "urn:query:fr-code-civil-p16-report-entre-epoux" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": action_entre_epoux_ou_partenaires(entity_ref("urn:fr:cc:presc:p16")) { origin case_input; }
        assert "f2": union_dissoute_le(entity_ref("urn:fr:cc:presc:p16"), @2024-09-01) { origin case_input; }
    }
    evaluate truth(point_de_depart_reporte_au(entity_ref("urn:fr:cc:presc:p16"), @2024-09-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ReportEntreEpouxEtPartenaires);
}
