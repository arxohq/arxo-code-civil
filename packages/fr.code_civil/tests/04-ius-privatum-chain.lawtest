language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

test "oecd-same-debt-comparative-chain" {
    given {
        context { decision_time @2015-01-01T12:00:00Z; knowledge_time @2015-01-01T12:00:00Z; legal_time @2015-01-01; timezone "UTC"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "cc-t4-due": creance_exigible_depuis(entity_ref("urn:fr:oecd:debt:2000"), @2000-01-01) { origin case_input; }
        assert "cc-t4-action": action_introduite_le(entity_ref("urn:fr:oecd:debt:2000"), @2015-01-01) { origin case_input; }
        assert "cc-t4-clean": prescription_non_interrompue(entity_ref("urn:fr:oecd:debt:2000")) { origin case_input; }
        assert "cc-t4-petitio": doctrine.ius_privatum::petitio(entity_ref("urn:fr:oecd:debt:2000"), entity_ref("urn:fr:oecd:creditor"), entity_ref("urn:fr:oecd:debtor")) { origin case_input; }
    }
    evaluate truth(doctrine.ius_privatum::remedium_exclusum(entity_ref("urn:fr:oecd:creditor"), entity_ref("urn:fr:oecd:debtor"), entity_ref("urn:fr:oecd:debt:2000")));
    expect truth_status == TRUE_ONLY;
}
