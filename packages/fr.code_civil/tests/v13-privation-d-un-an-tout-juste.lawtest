language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2271 : privé du 1er janvier 2010 au 1er janvier 2011 — un an tout juste, pas plus.
test "urn:query:fr-code-civil-v13-privation-d-un-an-tout-juste" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v13"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v13"), entity_ref("urn:fr:cc:presc:v13:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v13"), @1990-04-01) { origin case_input; }
        assert "f4": privation_de_jouissance(entity_ref("urn:fr:cc:presc:v13"), @2010-01-01, @2011-01-01) { origin adjudicated; }
    }
    evaluate truth(prescription_acquisitive_interrompue(entity_ref("urn:fr:cc:presc:v13")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
