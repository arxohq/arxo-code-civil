language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2232 : action le 1er janvier 2020, dernier jour des vingt ans.
test "urn:query:fr-code-civil-p18-delai-butoir-le-jour-meme" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": naissance_du_droit_le(entity_ref("urn:fr:cc:presc:p18"), @2000-01-01) { origin case_input; }
        assert "f2": nature_de_l_action(entity_ref("urn:fr:cc:presc:p18"), ActionPersonnelleOuMobiliere) { origin case_input; }
        assert "f3": action_introduite_le(entity_ref("urn:fr:cc:presc:p18"), @2020-01-01) { origin case_input; }
    }
    evaluate truth(action_prescrite_par_le_delai_butoir(entity_ref("urn:fr:cc:presc:p18")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
