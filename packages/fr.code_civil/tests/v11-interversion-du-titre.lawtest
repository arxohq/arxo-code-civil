language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2268 : le titre du détenteur a été interverti par la contradiction opposée au propriétaire.
test "urn:query:fr-code-civil-v11-interversion-du-titre" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v11"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v11"), entity_ref("urn:fr:cc:presc:v11:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v11"), @1990-04-01) { origin case_input; }
        assert "f4": detenteur_precaire(entity_ref("urn:fr:cc:presc:v11"), Locataire) { origin case_input; }
        assert "f5": titre_interverti(entity_ref("urn:fr:cc:presc:v11")) { origin adjudicated; }
    }
    evaluate truth(peut_prescrire_malgre_la_precarite(entity_ref("urn:fr:cc:presc:v11")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InterversionDuTitre);
}
