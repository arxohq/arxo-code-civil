language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2227 : le droit de propriété est imprescriptible.
test "urn:query:fr-code-civil-p11-propriete-imprescriptible" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p11"), ActionEnRevendicationDeLaPropriete) { origin case_input; }
    }
    evaluate truth(propriete_imprescriptible(entity_ref("urn:fr:cc:presc:p11")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ProprieteImprescriptible);
}
