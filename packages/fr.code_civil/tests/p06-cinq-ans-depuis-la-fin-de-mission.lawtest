language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2225 : mission achevée le 15 mars 2020 — échéance le 15 mars 2025.
test "urn:query:fr-code-civil-p06-cinq-ans-depuis-la-fin-de-mission" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p06"), ActionContreAuxiliaireDeJustice) { origin case_input; }
        assert "f2": fin_de_mission_le(entity_ref("urn:fr:cc:presc:p06"), @2020-03-15) { origin case_input; }
    }
    evaluate truth(echeance_prescription_le(entity_ref("urn:fr:cc:presc:p06"), @2025-03-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CinqAnsDepuisLaFinDeMission);
}
