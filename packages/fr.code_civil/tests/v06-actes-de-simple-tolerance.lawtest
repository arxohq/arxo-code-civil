language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2262 : des actes de simple tolérance ne fondent pas la possession.
test "urn:query:fr-code-civil-v06-actes-de-simple-tolerance" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v06"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v06"), entity_ref("urn:fr:cc:presc:v06:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v06"), @1990-04-01) { origin case_input; }
        assert "f4": possession_continue_et_non_interrompue(entity_ref("urn:fr:cc:presc:v06")) { origin adjudicated; }
        assert "f5": possession_paisible(entity_ref("urn:fr:cc:presc:v06")) { origin adjudicated; }
        assert "f6": possession_publique(entity_ref("urn:fr:cc:presc:v06")) { origin adjudicated; }
        assert "f7": possession_non_equivoque(entity_ref("urn:fr:cc:presc:v06")) { origin adjudicated; }
        assert "f8": actes_de_pure_faculte_ou_de_simple_tolerance(entity_ref("urn:fr:cc:presc:v06")) { origin adjudicated; }
    }
    evaluate truth(possession_utile(entity_ref("urn:fr:cc:presc:v06")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
