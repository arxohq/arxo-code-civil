language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2235 : titulaire né le 12 avril 2008 — la prescription ne court qu'à compter du 12 avril 2026.
test "urn:query:fr-code-civil-p14-report-jusqu-a-la-majorite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": titulaire_mineur_ne_le(entity_ref("urn:fr:cc:presc:p14"), @2008-04-12) { origin case_input; }
    }
    evaluate truth(point_de_depart_reporte_au(entity_ref("urn:fr:cc:presc:p14"), @2026-04-12));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ReportJusquALaMajorite);
}
