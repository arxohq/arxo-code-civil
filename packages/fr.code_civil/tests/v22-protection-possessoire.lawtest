language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2278, alinéa 1 : la possession est protégée contre le trouble d'un voisin.
test "urn:query:fr-code-civil-v22-protection-possessoire" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v22"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v22"), entity_ref("urn:fr:cc:presc:v22:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v22"), @1990-04-01) { origin case_input; }
        assert "f4": trouble_a_la_possession(entity_ref("urn:fr:cc:presc:v22"), entity_ref("urn:fr:cc:presc:v22:voisin")) { origin adjudicated; }
    }
    evaluate truth(protection_possessoire(entity_ref("urn:fr:cc:presc:v22"), entity_ref("urn:fr:cc:presc:v22:voisin")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ProtectionDeLaPossession);
}
