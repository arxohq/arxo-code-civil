language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2277 : chose volée achetée 850 EUR au marché — restitution contre remboursement.
test "urn:query:fr-code-civil-v21-remboursement-du-prix-au-marche" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v21"), Meuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v21"), entity_ref("urn:fr:cc:presc:v21:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v21"), @2024-02-01) { origin case_input; }
        assert "f4": chose_perdue_ou_volee_le(entity_ref("urn:fr:cc:presc:v21"), @2023-05-20) { origin adjudicated; }
        assert "f5": revendication_formee_le(entity_ref("urn:fr:cc:presc:v21"), @2025-01-15) { origin case_input; }
        assert "f6": achetee_en_foire_marche_vente_publique_ou_chez_un_marchand(entity_ref("urn:fr:cc:presc:v21")) { origin case_input; }
        assert "f7": prix_paye(entity_ref("urn:fr:cc:presc:v21"), 850 EUR) { origin case_input; }
    }
    evaluate truth(restitution_contre_remboursement_du_prix(entity_ref("urn:fr:cc:presc:v21"), 850 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RemboursementDuPrixAuPossesseur);
}
