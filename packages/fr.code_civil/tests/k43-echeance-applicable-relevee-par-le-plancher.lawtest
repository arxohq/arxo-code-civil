language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// K4 : art. 2225 échoit le 15 mars 2025 ; médiation close le 31 octobre 2025 — plancher 30 avril 2026.
test "urn:query:fr-code-civil-k43-echeance-applicable-relevee-par-le-plancher" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:k43"), ActionContreAuxiliaireDeJustice) { origin case_input; }
        assert "f2": fin_de_mission_le(entity_ref("urn:fr:cc:presc:k43"), @2020-03-15) { origin case_input; }
        assert "f3": mediation_terminee_le(entity_ref("urn:fr:cc:presc:k43"), @2025-10-31) { origin case_input; }
    }
    evaluate truth(date_d_echeance_applicable_le(entity_ref("urn:fr:cc:presc:k43"), @2026-04-30));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DateApplicableSansButoirOpposable);
}
