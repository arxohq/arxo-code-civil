language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2265 : le possesseur joint la possession de son auteur, commencée le 15 juin 1995.
test "urn:query:fr-code-civil-v09-jonction-des-possessions" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v09"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v09"), entity_ref("urn:fr:cc:presc:v09:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v09"), @2010-01-01) { origin case_input; }
        assert "f4": succede_a_la_possession_de(entity_ref("urn:fr:cc:presc:v09"), entity_ref("urn:fr:cc:presc:v09:auteur")) { origin case_input; }
        assert "f5": possession_commencee_le(entity_ref("urn:fr:cc:presc:v09:auteur"), @1995-06-15) { origin case_input; }
    }
    evaluate truth(debut_de_la_possession_utile_le(entity_ref("urn:fr:cc:presc:v09"), @1995-06-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(JonctionDesPossessions);
}
