language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2256 : on est présumé posséder pour soi et à titre de propriétaire.
test "urn:query:fr-code-civil-v01-presume-posseder-pour-soi" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v01"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v01"), entity_ref("urn:fr:cc:presc:v01:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v01"), @1990-04-01) { origin case_input; }
    }
    evaluate truth(presume_posseder_a_titre_de_proprietaire(entity_ref("urn:fr:cc:presc:v01")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PresomptionDePossederPourSoi);
}
