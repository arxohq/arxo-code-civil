language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2233, 1°, et 2224 : condition arrivée le 10 mai 2021, faits connus dès 2020 — échéance le 10 mai 2026.
test "urn:query:fr-code-civil-p12-report-jusqu-a-la-condition" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p12"), ActionPersonnelleOuMobiliere) { origin case_input; }
        assert "f2": condition_realisee_le(entity_ref("urn:fr:cc:presc:p12"), @2021-05-10) { origin case_input; }
        assert "f3": titulaire_connait_les_faits_le(entity_ref("urn:fr:cc:presc:p12"), @2020-01-01) { origin case_input; }
    }
    evaluate truth(echeance_prescription_le(entity_ref("urn:fr:cc:presc:p12"), @2026-05-10));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EcheanceQuinquennaleDepuisLeReport);
}
