language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2233, 3°, et 2224 : terme arrivé le 1er juin 2021, faits connus le 1er mars 2022 — échéance le 1er mars 2027.
test "urn:query:fr-code-civil-p13-connaissance-posterieure-au-terme" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p13"), ActionPersonnelleOuMobiliere) { origin case_input; }
        assert "f2": terme_arrive_le(entity_ref("urn:fr:cc:presc:p13"), @2021-06-01) { origin case_input; }
        assert "f3": titulaire_connait_les_faits_le(entity_ref("urn:fr:cc:presc:p13"), @2022-03-01) { origin case_input; }
    }
    evaluate truth(echeance_prescription_le(entity_ref("urn:fr:cc:presc:p13"), @2027-03-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EcheanceQuinquennaleDepuisLaConnaissancePosterieure);
}
