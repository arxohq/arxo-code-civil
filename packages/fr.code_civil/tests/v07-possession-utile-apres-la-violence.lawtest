language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2263 : la violence a cessé le 1er mars 2001 — la possession utile commence ce jour.
test "urn:query:fr-code-civil-v07-possession-utile-apres-la-violence" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v07"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v07"), entity_ref("urn:fr:cc:presc:v07:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v07"), @1990-04-01) { origin case_input; }
        assert "f4": violence_cessee_le(entity_ref("urn:fr:cc:presc:v07"), @2001-03-01) { origin adjudicated; }
    }
    evaluate truth(debut_de_la_possession_utile_le(entity_ref("urn:fr:cc:presc:v07"), @2001-03-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DebutDeLaPossessionUtileApresLaViolence);
}
