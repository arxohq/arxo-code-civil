language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2220 : la loi soumet ce délai de forclusion au titre XX.
test "urn:query:fr-code-civil-p02-forclusion-avec-renvoi-legal" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": delai_de_forclusion(entity_ref("urn:fr:cc:presc:p02")) { origin case_input; }
        assert "f2": renvoi_legal_au_titre_xx(entity_ref("urn:fr:cc:presc:p02")) { origin case_input; }
    }
    evaluate truth(hors_du_regime_de_la_prescription(entity_ref("urn:fr:cc:presc:p02")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
