language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

test "oecd-current-interruption-restarts-five-years" {
    given {
        context { decision_time @2015-01-01T12:00:00Z; knowledge_time @2015-01-01T12:00:00Z; legal_time @2015-01-01; timezone "UTC"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "cc-t2-due": creance_exigible_depuis(entity_ref("urn:fr:oecd:debt:interrupted"), @2000-01-01) { origin case_input; }
        assert "cc-t2-recognition": reconnaissance_du_debiteur_le(entity_ref("urn:fr:oecd:debt:interrupted"), @2012-01-01) { origin case_input; }
        assert "cc-t2-action": action_introduite_le(entity_ref("urn:fr:oecd:debt:interrupted"), @2015-01-01) { origin case_input; }
    }
    evaluate truth(action_prescrite_le(entity_ref("urn:fr:oecd:debt:interrupted"), @2015-01-01));
    expect truth_status == FALSE_ONLY;
}
