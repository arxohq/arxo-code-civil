language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2253 : le créancier du débiteur oppose la prescription malgré la renonciation.
test "urn:query:fr-code-civil-p34-creancier-oppose-la-prescription" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": tiers_interesse_a_la_prescription(entity_ref("urn:fr:cc:presc:p34"), entity_ref("urn:fr:cc:presc:p34:creancier")) { origin case_input; }
    }
    evaluate truth(prescription_invocable_par_le_tiers(entity_ref("urn:fr:cc:presc:p34"), entity_ref("urn:fr:cc:presc:p34:creancier")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(TiersInteresseOpposeLaPrescription);
}
