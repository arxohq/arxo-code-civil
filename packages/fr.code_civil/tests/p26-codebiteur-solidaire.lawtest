language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2245 : la reconnaissance de l'un des débiteurs solidaires interrompt contre l'autre.
test "urn:query:fr-code-civil-p26-codebiteur-solidaire" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": reconnaissance_du_debiteur_le(entity_ref("urn:fr:cc:presc:p26:a"), @2022-05-05) { origin case_input; }
        assert "f2": obligation_solidaire_avec(entity_ref("urn:fr:cc:presc:p26:a"), entity_ref("urn:fr:cc:presc:p26:b")) { origin case_input; }
    }
    evaluate truth(prescription_interrompue_le(entity_ref("urn:fr:cc:presc:p26:b"), @2022-05-05));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InterruptionContreLesCodebiteursSolidaires);
}
