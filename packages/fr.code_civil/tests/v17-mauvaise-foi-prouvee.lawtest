language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2274 et 2275 : la mauvaise foi au jour de l'acquisition est prouvée.
test "urn:query:fr-code-civil-v17-mauvaise-foi-prouvee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v17"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v17"), entity_ref("urn:fr:cc:presc:v17:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v17"), @2012-09-01) { origin case_input; }
        assert "f4": mauvaise_foi_prouvee_a_l_acquisition(entity_ref("urn:fr:cc:presc:v17")) { origin adjudicated; }
    }
    evaluate truth(bonne_foi_retenue(entity_ref("urn:fr:cc:presc:v17")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
