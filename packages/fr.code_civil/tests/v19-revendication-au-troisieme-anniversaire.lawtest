language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2276, alinéa 2 : vol le 20 mai 2023, revendication le 20 mai 2026.
test "urn:query:fr-code-civil-v19-revendication-au-troisieme-anniversaire" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v19"), Meuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v19"), entity_ref("urn:fr:cc:presc:v19:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v19"), @2024-02-01) { origin case_input; }
        assert "f4": chose_perdue_ou_volee_le(entity_ref("urn:fr:cc:presc:v19"), @2023-05-20) { origin adjudicated; }
        assert "f5": revendication_formee_le(entity_ref("urn:fr:cc:presc:v19"), @2026-05-20) { origin case_input; }
    }
    evaluate truth(revendication_recevable(entity_ref("urn:fr:cc:presc:v19")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RevendicationDansLesTroisAns);
}
