language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2221 : la prescription suit la loi du droit qu'elle affecte.
test "urn:query:fr-code-civil-p03-loi-de-la-prescription" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": loi_regissant_le_droit(entity_ref("urn:fr:cc:presc:p03"), "loi française") { origin case_input; }
    }
    evaluate truth(loi_de_la_prescription(entity_ref("urn:fr:cc:presc:p03"), "loi française"));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(LoiDeLaPrescription);
}
