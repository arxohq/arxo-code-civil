language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2247 : l'action est prescrite mais personne ne l'oppose — le juge ne la supplée pas.
test "urn:query:fr-code-civil-p28-prescription-non-invoquee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p28"), ActionContreAuxiliaireDeJustice) { origin case_input; }
        assert "f2": fin_de_mission_le(entity_ref("urn:fr:cc:presc:p28"), @2015-01-10) { origin case_input; }
        assert "f3": action_introduite_le(entity_ref("urn:fr:cc:presc:p28"), @2020-06-01) { origin case_input; }
    }
    evaluate truth(demande_rejetee_pour_prescription(entity_ref("urn:fr:cc:presc:p28")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
