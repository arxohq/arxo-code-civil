language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2254 : douze mois, la borne basse est permise.
test "urn:query:fr-code-civil-p35-duree-conventionnelle-d-un-an" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": duree_conventionnelle_en_mois(entity_ref("urn:fr:cc:presc:p35"), 12) { origin case_input; }
    }
    evaluate truth(amenagement_conventionnel_valable(entity_ref("urn:fr:cc:presc:p35")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DureeConventionnelleDansLesBornes);
}
