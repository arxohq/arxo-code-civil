language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2226-1 : manifestation connue le 1er juillet 2018 — échéance le 1er juillet 2028.
test "urn:query:fr-code-civil-p09-dix-ans-prejudice-ecologique" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p09"), PrejudiceEcologique) { origin case_input; }
        assert "f2": connaissance_du_prejudice_ecologique_le(entity_ref("urn:fr:cc:presc:p09"), @2018-07-01) { origin case_input; }
    }
    evaluate truth(echeance_prescription_le(entity_ref("urn:fr:cc:presc:p09"), @2028-07-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DixAnsPourLePrejudiceEcologique);
}
