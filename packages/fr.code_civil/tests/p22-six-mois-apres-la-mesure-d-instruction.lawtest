language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2239 : mesure exécutée le 15 janvier 2025 — pas d'expiration avant le 15 juillet 2025.
test "urn:query:fr-code-civil-p22-six-mois-apres-la-mesure-d-instruction" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": mesure_d_instruction_executee_le(entity_ref("urn:fr:cc:presc:p22"), @2025-01-15) { origin case_input; }
    }
    evaluate truth(echeance_minimale_le(entity_ref("urn:fr:cc:presc:p22"), @2025-07-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(SixMoisApresLaMesureDInstruction);
}
