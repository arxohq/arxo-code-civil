language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2256 : il est prouvé qu'il a commencé à posséder pour autrui.
test "urn:query:fr-code-civil-v02-possession-commencee-pour-autrui" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": chose_possedee(entity_ref("urn:fr:cc:presc:v02"), Immeuble) { origin case_input; }
        assert "f2": possesseur(entity_ref("urn:fr:cc:presc:v02"), entity_ref("urn:fr:cc:presc:v02:pers")) { origin case_input; }
        assert "f3": possession_commencee_le(entity_ref("urn:fr:cc:presc:v02"), @1990-04-01) { origin case_input; }
        assert "f4": commence_a_posseder_pour_autrui(entity_ref("urn:fr:cc:presc:v02")) { origin adjudicated; }
    }
    evaluate truth(presume_posseder_a_titre_de_proprietaire(entity_ref("urn:fr:cc:presc:v02")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
