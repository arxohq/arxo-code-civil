language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

test "oecd-current-suspension-from-transition-start" {
    given {
        context { decision_time @2015-01-01T12:00:00Z; knowledge_time @2015-01-01T12:00:00Z; legal_time @2015-01-01; timezone "UTC"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "cc-t3-due": creance_exigible_depuis(entity_ref("urn:fr:oecd:debt:suspended"), @2000-01-01) { origin case_input; }
        assert "cc-t3-suspension": prescription_suspendue_des_le_depart_jusquau(entity_ref("urn:fr:oecd:debt:suspended"), @2008-06-19, @2010-06-19) { origin case_input; }
        assert "cc-t3-action": action_introduite_le(entity_ref("urn:fr:oecd:debt:suspended"), @2015-01-01) { origin case_input; }
    }
    evaluate truth(action_prescrite_le(entity_ref("urn:fr:oecd:debt:suspended"), @2015-01-01));
    expect truth_status == FALSE_ONLY;
}
