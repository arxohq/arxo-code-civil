language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2226 : dommage corporel consolidé le 30 novembre 2019 — échéance le 30 novembre 2029.
test "urn:query:fr-code-civil-p07-dix-ans-depuis-la-consolidation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p07"), DommageCorporel) { origin case_input; }
        assert "f2": consolidation_du_dommage_le(entity_ref("urn:fr:cc:presc:p07"), @2019-11-30) { origin adjudicated; }
    }
    evaluate truth(echeance_prescription_le(entity_ref("urn:fr:cc:presc:p07"), @2029-11-30));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DixAnsDepuisLaConsolidation);
}
