language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2220 : un délai de forclusion n'est pas régi par le titre XX.
test "urn:query:fr-code-civil-p01-forclusion-hors-du-titre" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": delai_de_forclusion(entity_ref("urn:fr:cc:presc:p01")) { origin case_input; }
    }
    evaluate truth(hors_du_regime_de_la_prescription(entity_ref("urn:fr:cc:presc:p01")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ForclusionHorsDuTitre);
}
