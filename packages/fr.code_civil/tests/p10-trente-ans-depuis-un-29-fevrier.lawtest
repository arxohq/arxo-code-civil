language "law.core" version "0.2";
package fr.code_civil version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil";

// Art. 2227 : faits connus le 29 février 2000 — le 29 février 2030 n'existe pas, l'échéance tombe le 28 février 2030.
test "urn:query:fr-code-civil-p10-trente-ans-depuis-un-29-fevrier" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
        assert "f1": nature_de_l_action(entity_ref("urn:fr:cc:presc:p10"), ActionReelleImmobiliere) { origin case_input; }
        assert "f2": titulaire_connait_les_faits_le(entity_ref("urn:fr:cc:presc:p10"), @2000-02-29) { origin case_input; }
    }
    evaluate truth(echeance_prescription_le(entity_ref("urn:fr:cc:presc:p10"), @2030-02-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(TrenteAnsPourLesActionsReellesImmobilieres);
}
