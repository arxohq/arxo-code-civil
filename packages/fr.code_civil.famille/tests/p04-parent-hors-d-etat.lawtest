language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 373 : le parent hors d état de manifester sa volonté est privé de l exercice.
test "urn:query:fr-code-civil-famille-p04-parent-hors-d-etat" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:fam:u:enfant"), @2020-01-10) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:fam:u:enfant"), @2026-06-01) { origin case_input; }
        assert "f3": filiation_etablie_le(entity_ref("urn:fr:cc:fam:u:mere"), entity_ref("urn:fr:cc:fam:u:enfant"), @2020-01-10) { origin case_input; }
        assert "f4": hors_d_etat_de_manifester_sa_volonte(entity_ref("urn:fr:cc:fam:u:mere")) { origin adjudicated; }
    }
    evaluate truth(exercice_de_l_autorite(entity_ref("urn:fr:cc:fam:u:mere"), entity_ref("urn:fr:cc:fam:u:enfant")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
