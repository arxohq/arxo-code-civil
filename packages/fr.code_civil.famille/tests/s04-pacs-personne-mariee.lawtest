language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 515-2 2° : l un des partenaires est marié — empêchement.
test "urn:query:fr-code-civil-famille-s04-pacs-personne-mariee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": partenaires(entity_ref("urn:fr:cc:fam:bb:pacs"), entity_ref("urn:fr:cc:fam:bb:a"), entity_ref("urn:fr:cc:fam:bb:b")) { origin case_input; }
        assert "f2": mariage_anterieur_non_dissous(entity_ref("urn:fr:cc:fam:bb:a")) { origin case_input; }
    }
    evaluate truth(empechement_au_pacs(entity_ref("urn:fr:cc:fam:bb:pacs")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
