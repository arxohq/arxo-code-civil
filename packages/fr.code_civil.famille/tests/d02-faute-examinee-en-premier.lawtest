language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 246 : demandes concurrentes — la faute est examinée en premier.
test "urn:query:fr-code-civil-famille-d02-faute-examinee-en-premier" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": demande_pour_faute(entity_ref("urn:fr:cc:fam:k:m")) { origin case_input; }
        assert "f2": demande_pour_alteration(entity_ref("urn:fr:cc:fam:k:m")) { origin case_input; }
    }
    evaluate truth(faute_examinee_en_premier(entity_ref("urn:fr:cc:fam:k:m")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
