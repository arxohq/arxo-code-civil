language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 515-2 1° : oncle et nièce, troisième degré inclus — empêchement.
test "urn:query:fr-code-civil-famille-s02-pacs-oncle-et-niece" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": graphe_familial(entity_ref("urn:fr:cc:fam:z:F")) { origin case_input; }
        assert "f2": filiation_etablie(entity_ref("urn:fr:cc:fam:z:F"), entity_ref("urn:fr:cc:fam:z:g"), entity_ref("urn:fr:cc:fam:z:oncle")) { origin case_input; }
        assert "f3": filiation_etablie(entity_ref("urn:fr:cc:fam:z:F"), entity_ref("urn:fr:cc:fam:z:g"), entity_ref("urn:fr:cc:fam:z:p")) { origin case_input; }
        assert "f4": filiation_etablie(entity_ref("urn:fr:cc:fam:z:F"), entity_ref("urn:fr:cc:fam:z:p"), entity_ref("urn:fr:cc:fam:z:niece")) { origin case_input; }
        assert "f5": partenaires(entity_ref("urn:fr:cc:fam:z:pacs"), entity_ref("urn:fr:cc:fam:z:oncle"), entity_ref("urn:fr:cc:fam:z:niece")) { origin case_input; }
    }
    evaluate truth(empechement_au_pacs(entity_ref("urn:fr:cc:fam:z:pacs")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EmpechementCollaterauxJusquAuTroisiemeDegre);
}
