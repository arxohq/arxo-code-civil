language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 515-12 : demande en divorce déposée durant le délai — prolongation possible.
test "urn:query:fr-code-civil-famille-s07-prolongation-par-la-demande-en-divorce" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": ordonnance_notifiee_le(entity_ref("urn:fr:cc:fam:dd:o"), @2026-01-31) { origin case_input; }
        assert "f2": demande_en_divorce_pendant_l_ordonnance(entity_ref("urn:fr:cc:fam:dd:o")) { origin case_input; }
    }
    evaluate truth(prolongation_possible(entity_ref("urn:fr:cc:fam:dd:o")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
