language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 161 à 163 : les cousins germains (quatrième degré) ne sont pas visés — pas d empêchement.
test "urn:query:fr-code-civil-famille-m07-cousins-germains-permis" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": graphe_familial(entity_ref("urn:fr:cc:fam:f:F")) { origin case_input; }
        assert "f2": filiation_etablie(entity_ref("urn:fr:cc:fam:f:F"), entity_ref("urn:fr:cc:fam:f:g"), entity_ref("urn:fr:cc:fam:f:p1")) { origin case_input; }
        assert "f3": filiation_etablie(entity_ref("urn:fr:cc:fam:f:F"), entity_ref("urn:fr:cc:fam:f:g"), entity_ref("urn:fr:cc:fam:f:p2")) { origin case_input; }
        assert "f4": filiation_etablie(entity_ref("urn:fr:cc:fam:f:F"), entity_ref("urn:fr:cc:fam:f:p1"), entity_ref("urn:fr:cc:fam:f:c1")) { origin case_input; }
        assert "f5": filiation_etablie(entity_ref("urn:fr:cc:fam:f:F"), entity_ref("urn:fr:cc:fam:f:p2"), entity_ref("urn:fr:cc:fam:f:c2")) { origin case_input; }
        assert "f6": epoux(entity_ref("urn:fr:cc:fam:f:m"), entity_ref("urn:fr:cc:fam:f:c1"), entity_ref("urn:fr:cc:fam:f:c2")) { origin case_input; }
    }
    evaluate truth(empechement_de_parente(entity_ref("urn:fr:cc:fam:f:m")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
