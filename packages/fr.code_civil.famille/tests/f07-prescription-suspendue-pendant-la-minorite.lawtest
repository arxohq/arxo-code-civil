language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 321 : né le 1er mars 2010, privé de l état à cinq ans — action jusqu à ses vingt-huit ans, le 1er mars 2038.
test "urn:query:fr-code-civil-famille-f07-prescription-suspendue-pendant-la-minorite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": naissance_le(entity_ref("urn:fr:cc:fam:o:e"), @2010-03-01) { origin case_input; }
        assert "f2": prive_de_l_etat_le(entity_ref("urn:fr:cc:fam:o:e"), @2015-03-01) { origin case_input; }
    }
    evaluate truth(action_en_filiation_prescrite_le(entity_ref("urn:fr:cc:fam:o:e"), @2038-03-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PrescriptionDixAnsApresLaMajorite);
}
