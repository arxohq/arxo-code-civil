language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 371-1 : l enfant majeur n est plus sous l autorité parentale.
test "urn:query:fr-code-civil-famille-p05-fin-a-la-majorite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:fam:v:enfant"), @2000-01-10) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:fam:v:enfant"), @2026-06-01) { origin case_input; }
        assert "f3": filiation_etablie_le(entity_ref("urn:fr:cc:fam:v:mere"), entity_ref("urn:fr:cc:fam:v:enfant"), @2000-01-10) { origin case_input; }
    }
    evaluate truth(autorite_parentale(entity_ref("urn:fr:cc:fam:v:mere"), entity_ref("urn:fr:cc:fam:v:enfant")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
