language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 144, 146, 147, 161 à 163 : âge, consentement libre, aucun empêchement — conditions réunies.
test "urn:query:fr-code-civil-famille-m09-conditions-reunies" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": epoux(entity_ref("urn:fr:cc:fam:h:m"), entity_ref("urn:fr:cc:fam:h:a"), entity_ref("urn:fr:cc:fam:h:b")) { origin case_input; }
        assert "f2": ne_le(entity_ref("urn:fr:cc:fam:h:a"), @1990-01-01) { origin case_input; }
        assert "f3": date_d_appreciation(entity_ref("urn:fr:cc:fam:h:a"), @2026-06-01) { origin case_input; }
        assert "f4": ne_le(entity_ref("urn:fr:cc:fam:h:b"), @1992-01-01) { origin case_input; }
        assert "f5": date_d_appreciation(entity_ref("urn:fr:cc:fam:h:b"), @2026-06-01) { origin case_input; }
        assert "f6": consentement_libre(entity_ref("urn:fr:cc:fam:h:m"), entity_ref("urn:fr:cc:fam:h:a")) { origin case_input; }
        assert "f7": consentement_libre(entity_ref("urn:fr:cc:fam:h:m"), entity_ref("urn:fr:cc:fam:h:b")) { origin case_input; }
    }
    evaluate truth(conditions_du_mariage_reunies(entity_ref("urn:fr:cc:fam:h:m")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ConditionsReunies);
}
