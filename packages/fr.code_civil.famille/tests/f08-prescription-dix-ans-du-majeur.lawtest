language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 321 : privé de l état à trente ans, le 1er mars 2020 — action jusqu au 1er mars 2030.
test "urn:query:fr-code-civil-famille-f08-prescription-dix-ans-du-majeur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": naissance_le(entity_ref("urn:fr:cc:fam:o2:e"), @1990-03-01) { origin case_input; }
        assert "f2": prive_de_l_etat_le(entity_ref("urn:fr:cc:fam:o2:e"), @2020-03-01) { origin case_input; }
    }
    evaluate truth(action_en_filiation_prescrite_le(entity_ref("urn:fr:cc:fam:o2:e"), @2030-03-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PrescriptionDixAnsDepuisLaPrivation);
}
