language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 372 al. 3 : la déclaration conjointe rétablit l exercice commun.
test "urn:query:fr-code-civil-famille-p03-declaration-conjointe" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": ne_le(entity_ref("urn:fr:cc:fam:u:enfant"), @2020-01-10) { origin case_input; }
        assert "f2": date_d_appreciation(entity_ref("urn:fr:cc:fam:u:enfant"), @2026-06-01) { origin case_input; }
        assert "f3": filiation_etablie_le(entity_ref("urn:fr:cc:fam:u:mere"), entity_ref("urn:fr:cc:fam:u:enfant"), @2020-01-10) { origin case_input; }
        assert "f4": filiation_etablie_le(entity_ref("urn:fr:cc:fam:u:pere"), entity_ref("urn:fr:cc:fam:u:enfant"), @2021-03-01) { origin case_input; }
        assert "f5": declaration_conjointe_d_exercice_commun(entity_ref("urn:fr:cc:fam:u:pere"), entity_ref("urn:fr:cc:fam:u:enfant")) { origin case_input; }
    }
    evaluate truth(exercice_de_l_autorite(entity_ref("urn:fr:cc:fam:u:pere"), entity_ref("urn:fr:cc:fam:u:enfant")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
