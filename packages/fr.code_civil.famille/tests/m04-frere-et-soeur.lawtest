language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 162 : mariage entre frère et sœur, lu dans le graphe — prohibé.
test "urn:query:fr-code-civil-famille-m04-frere-et-soeur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": graphe_familial(entity_ref("urn:fr:cc:fam:d:F")) { origin case_input; }
        assert "f2": filiation_etablie(entity_ref("urn:fr:cc:fam:d:F"), entity_ref("urn:fr:cc:fam:d:pere"), entity_ref("urn:fr:cc:fam:d:x")) { origin case_input; }
        assert "f3": filiation_etablie(entity_ref("urn:fr:cc:fam:d:F"), entity_ref("urn:fr:cc:fam:d:mere"), entity_ref("urn:fr:cc:fam:d:x")) { origin case_input; }
        assert "f4": filiation_etablie(entity_ref("urn:fr:cc:fam:d:F"), entity_ref("urn:fr:cc:fam:d:pere"), entity_ref("urn:fr:cc:fam:d:y")) { origin case_input; }
        assert "f5": filiation_etablie(entity_ref("urn:fr:cc:fam:d:F"), entity_ref("urn:fr:cc:fam:d:mere"), entity_ref("urn:fr:cc:fam:d:y")) { origin case_input; }
        assert "f6": epoux(entity_ref("urn:fr:cc:fam:d:m"), entity_ref("urn:fr:cc:fam:d:x"), entity_ref("urn:fr:cc:fam:d:y")) { origin case_input; }
    }
    evaluate truth(empechement_de_parente(entity_ref("urn:fr:cc:fam:d:m")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ProhibitionEntreFrereEtSoeur);
}
