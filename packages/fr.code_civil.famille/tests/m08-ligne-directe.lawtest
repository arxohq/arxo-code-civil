language "law.core" version "0.2";
package fr.code_civil.famille version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-famille";

// Art. 161 : aïeul et petit-enfant, ligne directe — prohibé.
test "urn:query:fr-code-civil-famille-m08-ligne-directe" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_FAMILLE_CALENDRIER; }
        assert "f1": graphe_familial(entity_ref("urn:fr:cc:fam:g:F")) { origin case_input; }
        assert "f2": filiation_etablie(entity_ref("urn:fr:cc:fam:g:F"), entity_ref("urn:fr:cc:fam:g:aieul"), entity_ref("urn:fr:cc:fam:g:p")) { origin case_input; }
        assert "f3": filiation_etablie(entity_ref("urn:fr:cc:fam:g:F"), entity_ref("urn:fr:cc:fam:g:p"), entity_ref("urn:fr:cc:fam:g:petit")) { origin case_input; }
        assert "f4": epoux(entity_ref("urn:fr:cc:fam:g:m"), entity_ref("urn:fr:cc:fam:g:aieul"), entity_ref("urn:fr:cc:fam:g:petit")) { origin case_input; }
    }
    evaluate truth(empechement_de_parente(entity_ref("urn:fr:cc:fam:g:m")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
