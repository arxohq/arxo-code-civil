// LIVRE IV, TITRE II, SOUS-TITRE Ier : DISPOSITIONS GÉNÉRALES DES SÛRETÉS
// RÉELLES (articles 2323 à 2326).
//
// SÛRETÉ RÉELLE POUR AUTRUI (2325). Lorsque la sûreté est constituée par un
// tiers, le créancier n'a d'action que sur le bien affecté et le tiers reçoit
// la protection de la caution : mise en garde (2299), information annuelle et
// de la défaillance (2302 à 2304), bénéfice de discussion (2305, 2305-1),
// recours et subrogation (2308 à 2312), décharge pour perte de subrogation
// (2314). Le paquet nomme ces renvois article par article ; les devoirs
// d'information eux-mêmes sont exécutés sur le cautionnement (module
// `titre-01-cautionnement-information.law`) — leur extension à la sûreté
// réelle pour autrui est déclarée, non recalculée (frontière, README).

language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

use self::{
    Bien,
    CC_ART2323,
    CC_ART2324,
    CC_ART2325,
    CC_ART2326,
    Personne,
    SureteReelle,
};

// --- Entrées du cas ------------------------------------------------------------------------

pub relation surete_reelle_constituee(s: SureteReelle, creancier_p: Personne, constituant: Personne, b: Bien) kind empirical {
    key(s);
    label fr official "sûreté réelle : affectation d'un bien au paiement préférentiel ou exclusif du créancier (article 2323)";
    label en unofficial "real security: an asset assigned to the creditor's preferential or exclusive payment (Article 2323)";
}
pub relation surete_accordee_par_la_loi(s: SureteReelle) kind empirical {
    label fr official "la sûreté est accordée par la loi à raison de la qualité de la créance (article 2324)";
    label en unofficial "the security is granted by law because of the nature of the claim (Article 2324)";
}
pub relation surete_accordee_par_jugement(s: SureteReelle) kind empirical {
    label fr official "la sûreté est accordée par un jugement à titre conservatoire (article 2324)";
    label en unofficial "the security is granted by a judgment as a protective measure (Article 2324)";
}
pub relation surete_accordee_par_convention(s: SureteReelle) kind empirical {
    label fr official "la sûreté est accordée par une convention (article 2324)";
    label en unofficial "the security is granted by agreement (Article 2324)";
}
pub relation porte_sur_des_meubles(s: SureteReelle) kind empirical {
    label fr official "la sûreté porte sur des biens meubles (article 2324)";
    label en unofficial "the security bears on movables (Article 2324)";
}
pub relation porte_sur_des_immeubles(s: SureteReelle) kind empirical {
    label fr official "la sûreté porte sur des biens immeubles (article 2324)";
    label en unofficial "the security bears on immovables (Article 2324)";
}
pub relation porte_sur_la_generalite_des_biens(s: SureteReelle) kind empirical {
    label fr official "la sûreté porte sur la généralité des meubles et des immeubles, ou des seuls meubles, ou des seuls immeubles (article 2324)";
    label en unofficial "the security bears on all movables and immovables, or on all movables, or on all immovables (Article 2324)";
}
pub relation porte_sur_des_biens_determines(s: SureteReelle) kind empirical {
    label fr official "la sûreté ne porte que sur des biens déterminés ou déterminables (article 2324)";
    label en unofficial "the security bears only on determined or determinable assets (Article 2324)";
}
pub relation surete_constituee_par_un_tiers(s: SureteReelle, tiers: Personne) kind empirical {
    label fr official "la sûreté réelle conventionnelle est constituée par un tiers (article 2325)";
    label en unofficial "the contractual real security is created by a third party (Article 2325)";
}
pub relation pouvoirs_sous_signature_privee(s: SureteReelle) kind empirical {
    label fr official "la sûreté est constituée en vertu de pouvoirs résultant de délibérations ou délégations établies sous signatures privées (article 2326)";
    label en unofficial "the security is created under powers from resolutions or delegations made under private signature (Article 2326)";
}
pub relation constituant_personne_morale_de_droit_prive(s: SureteReelle) kind empirical {
    label fr official "le constituant est une personne morale de droit privé (article 2326)";
    label en unofficial "the grantor is a private-law legal person (Article 2326)";
}
pub relation acte_authentique_requis(s: SureteReelle) kind empirical {
    label fr official "la constitution de la sûreté doit être faite par acte authentique (article 2326)";
    label en unofficial "the security must be created by notarial deed (Article 2326)";
}

// --- Conclusions ---------------------------------------------------------------------------

pub relation affectation_au_paiement_preferentiel(s: SureteReelle, b: Bien) kind derived {
    label fr official "le bien est affecté au paiement préférentiel ou exclusif du créancier (article 2323)";
    label en unofficial "the asset is assigned to the creditor's preferential or exclusive payment (Article 2323)";
}
pub relation surete_legale(s: SureteReelle) kind derived {
    label fr official "sûreté réelle légale (article 2324)";
    label en unofficial "statutory real security (Article 2324)";
}
pub relation surete_judiciaire(s: SureteReelle) kind derived {
    label fr official "sûreté réelle judiciaire (article 2324)";
    label en unofficial "judicial real security (Article 2324)";
}
pub relation surete_conventionnelle(s: SureteReelle) kind derived {
    label fr official "sûreté réelle conventionnelle (article 2324)";
    label en unofficial "contractual real security (Article 2324)";
}
pub relation surete_mobiliere(s: SureteReelle) kind derived {
    label fr official "sûreté réelle mobilière (article 2324)";
    label en unofficial "movable real security (Article 2324)";
}
pub relation surete_immobiliere(s: SureteReelle) kind derived {
    label fr official "sûreté réelle immobilière (article 2324)";
    label en unofficial "immovable real security (Article 2324)";
}
pub relation surete_generale(s: SureteReelle) kind derived {
    label fr official "sûreté réelle générale (article 2324)";
    label en unofficial "general real security (Article 2324)";
}
pub relation surete_speciale(s: SureteReelle) kind derived {
    label fr official "sûreté réelle spéciale (article 2324)";
    label en unofficial "special real security (Article 2324)";
}
pub relation action_limitee_au_bien_affecte(s: SureteReelle, tiers: Personne) kind derived {
    label fr official "la sûreté étant constituée par un tiers, le créancier n'a d'action que sur le bien affecté en garantie (article 2325)";
    label en unofficial "the security being created by a third party, the creditor may proceed only against the asset given as security (Article 2325)";
}
pub relation protection_de_la_caution_etendue(s: SureteReelle, article: Text) kind derived {
    label fr official "l'article du cautionnement désigné est applicable au tiers constituant d'une sûreté réelle pour autrui (article 2325)";
    label en unofficial "the designated suretyship article applies to the third party granting real security for another (Article 2325)";
}
pub relation constitution_sous_signature_privee_admise(s: SureteReelle) kind derived {
    label fr official "la sûreté peut être constituée en vertu de pouvoirs sous signatures privées, alors même que sa constitution doit l'être par acte authentique (article 2326)";
    label en unofficial "the security may be created under powers given by private signature, even though its creation requires a notarial deed (Article 2326)";
}

// --- Règles --------------------------------------------------------------------------------

@source(CC_ART2323)
rule AffectationAuPaiementPreferentiel(s: SureteReelle, c: Personne, p: Personne, b: Bien) strict {
    label fr official "Article 2323. La sûreté réelle est l'affectation d'un bien ou d'un ensemble de biens, présents ou futurs, au paiement préférentiel ou exclusif du créancier";
    label en unofficial "Article 2323. A real security is the assignment of an asset or set of assets, present or future, to the creditor's preferential or exclusive payment";
    when surete_reelle_constituee(s, c, p, b);
    then affectation_au_paiement_preferentiel(s, b);
}

@source(CC_ART2324) {
    rule SureteLegale(s: SureteReelle, b: Bien) strict {
        label fr official "Article 2324. La sûreté réelle est légale lorsqu'elle est accordée par la loi à raison de la qualité de la créance";
        label en unofficial "Article 2324. A real security is statutory where the law grants it because of the nature of the claim";
        when affectation_au_paiement_preferentiel(s, b) and surete_accordee_par_la_loi(s);
        then surete_legale(s);
    }
    rule SureteJudiciaire(s: SureteReelle, b: Bien) strict {
        label fr official "Article 2324. Elle est judiciaire lorsqu'elle est accordée par un jugement à titre conservatoire";
        label en unofficial "Article 2324. It is judicial where a judgment grants it as a protective measure";
        when affectation_au_paiement_preferentiel(s, b) and surete_accordee_par_jugement(s);
        then surete_judiciaire(s);
    }
    rule SureteConventionnelle(s: SureteReelle, b: Bien) strict {
        label fr official "Article 2324. Elle est conventionnelle lorsqu'elle est accordée par une convention";
        label en unofficial "Article 2324. It is contractual where an agreement grants it";
        when affectation_au_paiement_preferentiel(s, b) and surete_accordee_par_convention(s);
        then surete_conventionnelle(s);
    }
    rule SureteMobiliere(s: SureteReelle, b: Bien) strict {
        label fr official "Article 2324. Elle est mobilière lorsqu'elle porte sur des biens meubles";
        label en unofficial "Article 2324. It is movable where it bears on movables";
        when affectation_au_paiement_preferentiel(s, b) and porte_sur_des_meubles(s);
        then surete_mobiliere(s);
    }
    rule SureteImmobiliere(s: SureteReelle, b: Bien) strict {
        label fr official "Article 2324. Elle est immobilière lorsqu'elle porte sur des biens immeubles";
        label en unofficial "Article 2324. It is immovable where it bears on immovables";
        when affectation_au_paiement_preferentiel(s, b) and porte_sur_des_immeubles(s);
        then surete_immobiliere(s);
    }
    rule SureteGenerale(s: SureteReelle, b: Bien) strict {
        label fr official "Article 2324. Elle est générale lorsqu'elle porte sur la généralité des meubles et des immeubles, ou des seuls meubles, ou des seuls immeubles";
        label en unofficial "Article 2324. It is general where it bears on all movables and immovables, or all movables, or all immovables";
        when affectation_au_paiement_preferentiel(s, b) and porte_sur_la_generalite_des_biens(s);
        then surete_generale(s);
    }
    rule SureteSpeciale(s: SureteReelle, b: Bien) strict {
        label fr official "Article 2324. Elle est spéciale lorsqu'elle ne porte que sur des biens déterminés ou déterminables";
        label en unofficial "Article 2324. It is special where it bears only on determined or determinable assets";
        when affectation_au_paiement_preferentiel(s, b) and porte_sur_des_biens_determines(s);
        then surete_speciale(s);
    }
}

@source(CC_ART2325) {
    rule ActionLimiteeAuBien(s: SureteReelle, t: Personne) strict {
        label fr official "Article 2325. Lorsque la sûreté réelle conventionnelle est constituée par un tiers, le créancier n'a d'action que sur le bien affecté en garantie";
        label en unofficial "Article 2325. Where the contractual real security is created by a third party, the creditor may proceed only against the asset given as security";
        when surete_conventionnelle(s) and surete_constituee_par_un_tiers(s, t);
        then action_limitee_au_bien_affecte(s, t);
    }
    rule ProtectionMiseEnGardeEtendue(s: SureteReelle, t: Personne) strict {
        label fr official "Article 2325. Les dispositions de l'article 2299 (mise en garde) sont alors applicables";
        label en unofficial "Article 2325. Article 2299 (duty to warn) then applies";
        when action_limitee_au_bien_affecte(s, t);
        then protection_de_la_caution_etendue(s, "2299");
    }
    rule ProtectionInformationEtendue(s: SureteReelle, t: Personne) strict {
        label fr official "Article 2325. Les dispositions des articles 2302 à 2305-1 (information annuelle, information de la défaillance, sous-caution, bénéfice de discussion) sont alors applicables";
        label en unofficial "Article 2325. Articles 2302 to 2305-1 (annual information, default information, sub-surety, benefit of discussion) then apply";
        when action_limitee_au_bien_affecte(s, t);
        then protection_de_la_caution_etendue(s, "2302-2305-1");
    }
    rule ProtectionRecoursEtendue(s: SureteReelle, t: Personne) strict {
        label fr official "Article 2325. Les dispositions des articles 2308 à 2312 (recours et subrogation) sont alors applicables";
        label en unofficial "Article 2325. Articles 2308 to 2312 (recourse and subrogation) then apply";
        when action_limitee_au_bien_affecte(s, t);
        then protection_de_la_caution_etendue(s, "2308-2312");
    }
    rule ProtectionDechargeEtendue(s: SureteReelle, t: Personne) strict {
        label fr official "Article 2325. Les dispositions de l'article 2314 (décharge pour perte de subrogation) sont alors applicables";
        label en unofficial "Article 2325. Article 2314 (discharge for loss of subrogation) then applies";
        when action_limitee_au_bien_affecte(s, t);
        then protection_de_la_caution_etendue(s, "2314");
    }
}

@source(CC_ART2326)
rule PouvoirsSousSignaturePrivee(s: SureteReelle) strict {
    label fr official "Article 2326. Une sûreté réelle peut être constituée sur les biens d'une personne morale de droit privé en vertu de pouvoirs sous signatures privées, alors même que la constitution de la sûreté doit l'être par acte authentique";
    label en unofficial "Article 2326. A real security may be created over a private-law legal person's assets under powers given by private signature, even though the security itself must be created by notarial deed";
    when constituant_personne_morale_de_droit_prive(s) and pouvoirs_sous_signature_privee(s) and acte_authentique_requis(s);
    then constitution_sous_signature_privee_admise(s);
}
