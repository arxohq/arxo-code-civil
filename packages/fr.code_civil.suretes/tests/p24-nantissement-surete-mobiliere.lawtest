language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2329, 3° : le nantissement de meubles incorporels est une sûreté sur les meubles.
test "urn:query:fr-code-civil-suretes-p24-nantissement-surete-mobiliere" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:p24:S"), NantissementDeMeublesIncorporels) { origin case_input; }
    }
    evaluate truth(surete_sur_les_meubles(entity_ref("urn:fr:cc:suretes:p24:S")));
    expect truth_status == TRUE_ONLY;
}
