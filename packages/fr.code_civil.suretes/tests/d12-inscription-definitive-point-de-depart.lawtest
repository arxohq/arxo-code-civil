language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2432 : inscription provisoire en 2020, définitive le 1er mars 2021, échéance indéterminée — cinquante ans depuis le 1er mars 2021.
test "urn:query:fr-code-civil-suretes-d12-inscription-definitive-point-de-depart" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": inscription_de(entity_ref("urn:fr:cc:suretes:d12:I"), entity_ref("urn:fr:cc:suretes:d12:S")) { origin case_input; }
        assert "f2": inscription_prise_le(entity_ref("urn:fr:cc:suretes:d12:I"), @2020-05-15) { origin case_input; }
        assert "f3": inscription_definitive_le(entity_ref("urn:fr:cc:suretes:d12:I"), @2021-03-01) { origin case_input; }
        assert "f4": echeance_indeterminee(entity_ref("urn:fr:cc:suretes:d12:I"), entity_ref("urn:fr:cc:suretes:d12:C")) { origin case_input; }
    }
    evaluate truth(date_extreme_d_effet(entity_ref("urn:fr:cc:suretes:d12:I"), @2071-03-01));
    expect truth_status == TRUE_ONLY;
    expect applied(PointDeDepartInscriptionDefinitive);
}
