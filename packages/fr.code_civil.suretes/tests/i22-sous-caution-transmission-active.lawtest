language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2304 : la caution reçoit l'information le 15 mars 2023 ; elle doit la transmettre à la sous-caution personne physique jusqu'au 15 avril.
test "urn:query:fr-code-civil-suretes-i22-sous-caution-transmission-active" {
    // E-0212: статус позиции берётся на decision_time; ожидание писалось на дату
    // legal_time, поэтому момент решения и знания выровнен с ней.
    given {
        context { decision_time @2023-03-20T09:00:00Z; knowledge_time @2023-03-20T09:00:00Z; legal_time @2023-03-20; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i22:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:i22:K"), entity_ref("urn:fr:cc:suretes:i22:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:i22:K"), entity_ref("urn:fr:cc:suretes:i22:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:i22:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:i22:B")) { origin case_input; }
        assert "f6": information_recue_par_la_caution_le(entity_ref("urn:fr:cc:suretes:i22:K"), @2023-03-15) { origin case_input; }
        assert "f7": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i22:S"), @2022-04-01) { origin case_input; }
        assert "f8": sous_cautionnement(entity_ref("urn:fr:cc:suretes:i22:S"), entity_ref("urn:fr:cc:suretes:i22:K")) { origin case_input; }
        assert "f9": caution(entity_ref("urn:fr:cc:suretes:i22:S"), entity_ref("urn:fr:cc:suretes:i22:Q")) { origin case_input; }
        assert "f10": est_personne_physique(entity_ref("urn:fr:cc:suretes:i22:Q")) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirDeTransmettreALaSousCaution, ACTIVE);
}
