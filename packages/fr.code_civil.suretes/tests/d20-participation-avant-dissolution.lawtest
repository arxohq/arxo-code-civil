language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2394, al. 2 : inscription prise en 2022, avant la dissolution, immeubles existants — effet au 30 juin 2023.
test "urn:query:fr-code-civil-suretes-d20-participation-avant-dissolution" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": hypotheque(entity_ref("urn:fr:cc:suretes:d20:S"), entity_ref("urn:fr:cc:suretes:d20:B"), entity_ref("urn:fr:cc:suretes:d20:P")) { origin case_input; }
        assert "f2": espece_d_hypotheque(entity_ref("urn:fr:cc:suretes:d20:S"), Legale) { origin case_input; }
        assert "f3": hypotheque_legale_generale(entity_ref("urn:fr:cc:suretes:d20:S"), EntreEpoux) { origin case_input; }
        assert "f4": stipulation_de_participation_aux_acquets(entity_ref("urn:fr:cc:suretes:d20:S")) { origin case_input; }
        assert "f5": dissolution_du_regime_le(entity_ref("urn:fr:cc:suretes:d20:S"), @2023-06-30) { origin case_input; }
        assert "f6": inscription_de_l_hypotheque_le(entity_ref("urn:fr:cc:suretes:d20:S"), @2022-01-10) { origin case_input; }
        assert "f7": immeubles_existants_a_la_dissolution(entity_ref("urn:fr:cc:suretes:d20:S")) { origin case_input; }
    }
    evaluate truth(effet_de_l_inscription_a_compter_du(entity_ref("urn:fr:cc:suretes:d20:S"), @2023-06-30));
    expect truth_status == TRUE_ONLY;
    expect applied(EffetDiffereALaDissolution);
}
