language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2302 : précédente information le 1er mars 2022, nouvelle le 10 avril 2023 ; échus dans la période : 30 juin et 31 décembre 2022 (100 + 100) ; hors période : 28 février 2022 et 30 avril 2023 — 200 EUR déchus.
test "urn:query:fr-code-civil-suretes-i06-decheance-des-interets-2302" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2023-05-01; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i06:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:i06:K"), entity_ref("urn:fr:cc:suretes:i06:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:i06:K"), entity_ref("urn:fr:cc:suretes:i06:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:i06:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:i06:B")) { origin case_input; }
        assert "f6": arrete_annuel(entity_ref("urn:fr:cc:suretes:i06:K"), @2022-12-31) { origin case_input; }
        assert "f7": information_annuelle_communiquee_le(entity_ref("urn:fr:cc:suretes:i06:K"), @2022-12-31, @2023-04-10) { origin case_input; }
        assert "f8": rappel_du_terme_ou_de_la_faculte_de_resiliation(entity_ref("urn:fr:cc:suretes:i06:K"), @2022-12-31) { origin case_input; }
        assert "f9": precedente_information_le(entity_ref("urn:fr:cc:suretes:i06:K"), @2022-12-31, @2022-03-01) { origin case_input; }
        assert "f10": echeance_accessoire(entity_ref("urn:fr:cc:suretes:i06:K"), entity_ref("urn:fr:cc:suretes:i06:E0")) { origin case_input; }
        assert "f11": echue_le(entity_ref("urn:fr:cc:suretes:i06:E0"), @2022-02-28) { origin case_input; }
        assert "f12": montant_de_l_echeance(entity_ref("urn:fr:cc:suretes:i06:E0"), 50 EUR) { origin case_input; }
        assert "f13": echeance_accessoire(entity_ref("urn:fr:cc:suretes:i06:K"), entity_ref("urn:fr:cc:suretes:i06:E1")) { origin case_input; }
        assert "f14": echue_le(entity_ref("urn:fr:cc:suretes:i06:E1"), @2022-06-30) { origin case_input; }
        assert "f15": montant_de_l_echeance(entity_ref("urn:fr:cc:suretes:i06:E1"), 100 EUR) { origin case_input; }
        assert "f16": echeance_accessoire(entity_ref("urn:fr:cc:suretes:i06:K"), entity_ref("urn:fr:cc:suretes:i06:E2")) { origin case_input; }
        assert "f17": echue_le(entity_ref("urn:fr:cc:suretes:i06:E2"), @2022-12-31) { origin case_input; }
        assert "f18": montant_de_l_echeance(entity_ref("urn:fr:cc:suretes:i06:E2"), 100 EUR) { origin case_input; }
        assert "f19": echeance_accessoire(entity_ref("urn:fr:cc:suretes:i06:K"), entity_ref("urn:fr:cc:suretes:i06:E3")) { origin case_input; }
        assert "f20": echue_le(entity_ref("urn:fr:cc:suretes:i06:E3"), @2023-04-30) { origin case_input; }
        assert "f21": montant_de_l_echeance(entity_ref("urn:fr:cc:suretes:i06:E3"), 100 EUR) { origin case_input; }
    }
    evaluate truth(interets_et_penalites_dechus(entity_ref("urn:fr:cc:suretes:i06:K"), 200 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(TotalDesInteretsDechus);
}
