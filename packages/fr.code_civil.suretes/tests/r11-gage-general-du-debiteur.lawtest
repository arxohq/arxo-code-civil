language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2284 : qui s'est obligé personnellement répond sur tous ses biens.
test "urn:query:fr-code-civil-suretes-r11-gage-general-du-debiteur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": engagement_personnel(entity_ref("urn:fr:cc:suretes:r11:P"), entity_ref("urn:fr:cc:suretes:r11:C")) { origin case_input; }
    }
    evaluate truth(droit_de_gage_general(entity_ref("urn:fr:cc:suretes:r11:C"), entity_ref("urn:fr:cc:suretes:r11:P")));
    expect truth_status == TRUE_ONLY;
}
