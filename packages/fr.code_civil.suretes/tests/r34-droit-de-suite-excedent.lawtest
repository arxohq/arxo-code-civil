language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2458 : prix 250 000, dette hypothécaire 180 000 — 70 000 EUR au tiers acquéreur.
test "urn:query:fr-code-civil-suretes-r34-droit-de-suite-excedent" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": immeuble_aliene_a_un_tiers(entity_ref("urn:fr:cc:suretes:r34:S"), entity_ref("urn:fr:cc:suretes:r34:T")) { origin case_input; }
        assert "f2": dette_hypothecaire(entity_ref("urn:fr:cc:suretes:r34:S"), 180000 EUR) { origin case_input; }
        assert "f3": prix_de_vente_de_l_immeuble(entity_ref("urn:fr:cc:suretes:r34:S"), 250000 EUR) { origin case_input; }
    }
    evaluate truth(excedent_du_prix_au_tiers_acquereur(entity_ref("urn:fr:cc:suretes:r34:S"), 70000 EUR));
    expect truth_status == TRUE_ONLY;
}
