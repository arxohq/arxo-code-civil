language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-INCORPORATIONSEPARABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": clause_de_reserve_de_propriete(entity_ref("urn:law:catalog:incorporationseparable:v0"), entity_ref("urn:law:catalog:incorporationseparable:v1")) { origin case_input; }
        assert "cat-1": incorpore_a_un_autre_bien(entity_ref("urn:law:catalog:incorporationseparable:v0")) { origin case_input; }
        assert "cat-2": separable_sans_dommage(entity_ref("urn:law:catalog:incorporationseparable:v0")) { origin case_input; }
    }
    evaluate truth(droits_maintenus_malgre_l_incorporation(entity_ref("urn:law:catalog:incorporationseparable:v0")));
    expect truth_status == TRUE_ONLY;
}
