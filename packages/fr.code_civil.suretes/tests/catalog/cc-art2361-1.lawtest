language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-NANTISSEMENTANTERIEUR" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": nantissement_de(entity_ref("urn:law:catalog:nantissementanterieur:v0"), entity_ref("urn:law:catalog:nantissementanterieur:v2")) { origin case_input; }
        assert "cat-1": date_de_l_acte(entity_ref("urn:law:catalog:nantissementanterieur:v1"), @2026-01-14) { origin case_input; }
        assert "cat-2": nantissement_de(entity_ref("urn:law:catalog:nantissementanterieur:v1"), entity_ref("urn:law:catalog:nantissementanterieur:v2")) { origin case_input; }
        assert "cat-3": date_de_l_acte(entity_ref("urn:law:catalog:nantissementanterieur:v0"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(nantissement_anterieur(entity_ref("urn:law:catalog:nantissementanterieur:v0"), entity_ref("urn:law:catalog:nantissementanterieur:v1")));
    expect truth_status == TRUE_ONLY;
}
