language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DECHEANCEOUCOMPLEMENT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": obligation_de_conservation_meconnue(entity_ref("urn:law:catalog:decheanceoucomplement:v0")) { origin case_input; }
        assert "cat-1": nature_de_la_surete(entity_ref("urn:law:catalog:decheanceoucomplement:v0"), GageDeMeublesCorporels) { origin case_input; }
    }
    evaluate truth(decheance_du_terme_ou_complement_de_gage(entity_ref("urn:law:catalog:decheanceoucomplement:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-RESTITUTIONPOURCONFUSION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": restitution_ouverte_pour_confusion(entity_ref("urn:law:catalog:restitutionpourconfusion:v0")) { origin case_input; }
    }
    evaluate truth(restitution_pour_defaut_de_conservation(entity_ref("urn:law:catalog:restitutionpourconfusion:v0")));
    expect truth_status == TRUE_ONLY;
}
