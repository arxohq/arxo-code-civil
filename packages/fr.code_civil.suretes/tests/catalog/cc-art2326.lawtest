language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-POUVOIRSSOUSSIGNATUREPRIVEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": pouvoirs_sous_signature_privee(entity_ref("urn:law:catalog:pouvoirssoussignatureprivee:v0")) { origin case_input; }
        assert "cat-1": constituant_personne_morale_de_droit_prive(entity_ref("urn:law:catalog:pouvoirssoussignatureprivee:v0")) { origin case_input; }
        assert "cat-2": acte_authentique_requis(entity_ref("urn:law:catalog:pouvoirssoussignatureprivee:v0")) { origin case_input; }
    }
    evaluate truth(constitution_sous_signature_privee_admise(entity_ref("urn:law:catalog:pouvoirssoussignatureprivee:v0")));
    expect truth_status == TRUE_ONLY;
}
