language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-GAGISTEASSIMILE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": immeuble_par_destination_gage(entity_ref("urn:law:catalog:gagisteassimile:v0")) { origin case_input; }
    }
    evaluate truth(gagiste_assimile_a_un_creancier_inscrit(entity_ref("urn:law:catalog:gagisteassimile:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SURENCHEREDUGAGISTESANSEFFET" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": immeuble_par_destination_gage(entity_ref("urn:law:catalog:surencheredugagistesanseffet:v0")) { origin case_input; }
        assert "cat-1": surenchere_du_gagiste(entity_ref("urn:law:catalog:surencheredugagistesanseffet:v0")) { origin case_input; }
        assert "cat-2": surenchere_de_l_hypothecaire(entity_ref("urn:law:catalog:surencheredugagistesanseffet:v0")) { origin case_input; }
    }
    evaluate truth(surenchere_du_gagiste_sans_effet(entity_ref("urn:law:catalog:surencheredugagistesanseffet:v0")));
    expect truth_status == TRUE_ONLY;
}
