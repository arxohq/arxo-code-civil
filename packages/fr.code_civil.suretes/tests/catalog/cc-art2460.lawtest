language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RECOURSDUTIERSACQUEREUR" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": droit_de_suite_hypothecaire(entity_ref("urn:law:catalog:recoursdutiersacquereur:v0"), entity_ref("urn:law:catalog:recoursdutiersacquereur:v1")) { origin case_input; }
        assert "cat-1": tiers_a_paye_ou_subi_la_saisie(entity_ref("urn:law:catalog:recoursdutiersacquereur:v0")) { origin case_input; }
    }
    evaluate truth(recours_du_tiers_acquereur(entity_ref("urn:law:catalog:recoursdutiersacquereur:v0")));
    expect truth_status == TRUE_ONLY;
}
