language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CONSERVATEURLEPLUSRECENT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": classe_de_preference(entity_ref("urn:law:catalog:conservateurleplusrecent:v0"), 1) { origin case_input; }
        assert "cat-1": collocation_dans(entity_ref("urn:law:catalog:conservateurleplusrecent:v0"), entity_ref("urn:law:catalog:conservateurleplusrecent:v2")) { origin case_input; }
        assert "cat-2": date_utile(entity_ref("urn:law:catalog:conservateurleplusrecent:v0"), @2026-01-16) { origin case_input; }
        assert "cat-3": privilege_special_du_conservateur(entity_ref("urn:law:catalog:conservateurleplusrecent:v0")) { origin case_input; }
        assert "cat-4": collocation_dans(entity_ref("urn:law:catalog:conservateurleplusrecent:v1"), entity_ref("urn:law:catalog:conservateurleplusrecent:v2")) { origin case_input; }
        assert "cat-5": privilege_special_du_conservateur(entity_ref("urn:law:catalog:conservateurleplusrecent:v1")) { origin case_input; }
        assert "cat-6": date_utile(entity_ref("urn:law:catalog:conservateurleplusrecent:v1"), @2026-01-15) { origin case_input; }
        assert "cat-7": classe_de_preference(entity_ref("urn:law:catalog:conservateurleplusrecent:v1"), 1) { origin case_input; }
    }
    evaluate truth(precede(entity_ref("urn:law:catalog:conservateurleplusrecent:v0"), entity_ref("urn:law:catalog:conservateurleplusrecent:v1")));
    expect truth_status == TRUE_ONLY;
}
