language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-BENEFICESCONSERVESDISCUSSION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": caution_personne_physique(entity_ref("urn:law:catalog:beneficesconservesdiscussion:v0")) { origin case_input; }
        assert "cat-1": privation_stipulee_du_benefice_de_discussion(entity_ref("urn:law:catalog:beneficesconservesdiscussion:v0")) { origin case_input; }
    }
    evaluate truth(benefices_conserves_faute_de_reconnaissance(entity_ref("urn:law:catalog:beneficesconservesdiscussion:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-MANDATSOUMISALAMENTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": mandat_de_se_porter_caution(entity_ref("urn:law:catalog:mandatsoumisalamention:v0")) { origin case_input; }
        assert "cat-1": regi_par_la_loi_nouvelle(entity_ref("urn:law:catalog:mandatsoumisalamention:v0")) { origin case_input; }
        assert "cat-2": caution_personne_physique(entity_ref("urn:law:catalog:mandatsoumisalamention:v0")) { origin case_input; }
    }
    evaluate truth(mandat_soumis_a_la_mention(entity_ref("urn:law:catalog:mandatsoumisalamention:v0")));
    expect truth_status == TRUE_ONLY;
}
