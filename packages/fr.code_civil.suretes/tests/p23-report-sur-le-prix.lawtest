language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2330 : le meuble grevé est vendu — le privilège se reporte sur la créance de prix contre l'acquéreur.
test "urn:query:fr-code-civil-suretes-p23-report-sur-le-prix" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": privilege_mobilier_sur(entity_ref("urn:fr:cc:suretes:p23:R"), entity_ref("urn:fr:cc:suretes:p23:B")) { origin case_input; }
        assert "f2": bien_vendu_prix_du(entity_ref("urn:fr:cc:suretes:p23:B"), entity_ref("urn:fr:cc:suretes:p23:A")) { origin case_input; }
    }
    evaluate truth(report_sur_la_creance_de_prix(entity_ref("urn:fr:cc:suretes:p23:R"), entity_ref("urn:fr:cc:suretes:p23:A")));
    expect truth_status == TRUE_ONLY;
}
