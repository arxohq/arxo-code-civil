language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2298 : délai de grâce accordé au débiteur défaillant — la caution ne peut s'en prévaloir.
test "urn:query:fr-code-civil-suretes-c55-mesure-consecutive-a-la-defaillance" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c55:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c55:K"), entity_ref("urn:fr:cc:suretes:c55:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c55:K"), entity_ref("urn:fr:cc:suretes:c55:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c55:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c55:B")) { origin case_input; }
        assert "f6": exception_du_debiteur(entity_ref("urn:fr:cc:suretes:c55:K"), "delai-de-grace") { origin case_input; }
        assert "f7": mesure_consecutive_a_la_defaillance(entity_ref("urn:fr:cc:suretes:c55:K"), "delai-de-grace") { origin case_input; }
    }
    evaluate truth(exception_opposable_par_la_caution(entity_ref("urn:fr:cc:suretes:c55:K"), "delai-de-grace"));
    expect truth_status == NEITHER;
}
