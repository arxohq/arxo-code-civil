language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2306 : une seule caution de la dette — pas de pluralité, pas de division.
test "urn:query:fr-code-civil-suretes-c18-caution-unique-pas-de-division" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c18:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c18:K"), entity_ref("urn:fr:cc:suretes:c18:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c18:K"), entity_ref("urn:fr:cc:suretes:c18:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c18:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c18:B")) { origin case_input; }
        assert "f6": dette_garantie(entity_ref("urn:fr:cc:suretes:c18:K"), entity_ref("urn:fr:cc:suretes:c18:D")) { origin case_input; }
    }
    evaluate truth(tenue_pour_le_tout(entity_ref("urn:fr:cc:suretes:c18:K")));
    expect truth_status == NEITHER;
}
