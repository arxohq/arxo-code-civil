test "urn:positions:fr-code-civil-suretes-2366-excedent-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:n2366:S"), entity_ref("urn:fr:cc:suretes:n2366:C"), entity_ref("urn:fr:cc:suretes:n2366:P"), entity_ref("urn:fr:cc:suretes:n2366:B")) { origin case_input; }
        assert "charge": nantissement_de(entity_ref("urn:fr:cc:suretes:n2366:S"), entity_ref("urn:fr:cc:suretes:n2366:N")) { origin case_input; }
        assert "payment": paiement_de_la_creance_nantie(entity_ref("urn:fr:cc:suretes:n2366:S"), 12000 EUR) { origin case_input; }
        assert "debt": montant_de_la_dette_reelle(entity_ref("urn:fr:cc:suretes:n2366:S"), 10000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirRestituerExcedentNanti, ACTIVE);
}

