test "urn:positions:fr-code-civil-suretes-2364-affectation-first" {
    // Начало срока affectation_possible_a_partir_du — вывод правила ст. 2364
    // (уведомление + 8 дней), а не факт дела: прежде мир утверждал его под
    // несуществующим именем …_a_partir_de (LDC-E2102).
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:n2364c:S"), entity_ref("urn:fr:cc:suretes:n2364c:C"), entity_ref("urn:fr:cc:suretes:n2364c:P"), entity_ref("urn:fr:cc:suretes:n2364c:B")) { origin case_input; }
        assert "sums": sommes_conservees_en_garantie(entity_ref("urn:fr:cc:suretes:n2364c:S"), 5000 EUR) { origin case_input; }
        assert "payment": paiement_de_la_creance_nantie(entity_ref("urn:fr:cc:suretes:n2364c:S"), 5000 EUR) { origin case_input; }
        assert "default": defaillance_du_debiteur_garanti(entity_ref("urn:fr:cc:suretes:n2364c:S")) { origin case_input; }
        assert "notice": mise_en_demeure_sans_effet_le(entity_ref("urn:fr:cc:suretes:n2364c:S"), @2026-01-01) { origin case_input; }
        assert "date": affectation_des_fonds_le(entity_ref("urn:fr:cc:suretes:n2364c:S"), @2026-01-10) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteAffecterFondsApresDelai, ACTIVE);
}

