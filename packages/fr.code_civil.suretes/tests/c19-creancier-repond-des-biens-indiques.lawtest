// Art. 2305-1 : bénéfice invoqué à temps, mais aucun bien du débiteur encore indiqué — le devoir d'indiquer reste actif (le but est la présence d'un bien utilement indiqué, absent du corps de la règle).
test "urn:positions:fr-code-civil-suretes-2305-discussion-third" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "date": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:pos2305c:K"), @2022-03-01) { origin case_input; }
        assert "surety": caution(entity_ref("urn:fr:cc:suretes:pos2305c:K"), entity_ref("urn:fr:cc:suretes:pos2305c:C")) { origin case_input; }
        assert "first": premieres_poursuites_contre_la_caution_le(entity_ref("urn:fr:cc:suretes:pos2305c:K"), @2023-05-02) { origin case_input; }
        assert "raise": benefice_de_discussion_invoque_le(entity_ref("urn:fr:cc:suretes:pos2305c:K"), @2023-05-02) { origin case_input; }
    }
    evaluate positions();
    expect position(PouvoirInvoquerDiscussion, ACTIVE);
    expect position(DevoirIndiquerBienDuDebiteur, ACTIVE);
}
