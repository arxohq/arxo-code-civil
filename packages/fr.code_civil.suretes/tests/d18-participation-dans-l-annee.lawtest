language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2394, al. 4 : dissolution le 30 juin 2023, inscription le 30 juin 2024 — effet de sa date.
test "urn:query:fr-code-civil-suretes-d18-participation-dans-l-annee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": hypotheque(entity_ref("urn:fr:cc:suretes:d18:S"), entity_ref("urn:fr:cc:suretes:d18:B"), entity_ref("urn:fr:cc:suretes:d18:P")) { origin case_input; }
        assert "f2": espece_d_hypotheque(entity_ref("urn:fr:cc:suretes:d18:S"), Legale) { origin case_input; }
        assert "f3": hypotheque_legale_generale(entity_ref("urn:fr:cc:suretes:d18:S"), EntreEpoux) { origin case_input; }
        assert "f4": stipulation_de_participation_aux_acquets(entity_ref("urn:fr:cc:suretes:d18:S")) { origin case_input; }
        assert "f5": dissolution_du_regime_le(entity_ref("urn:fr:cc:suretes:d18:S"), @2023-06-30) { origin case_input; }
        assert "f6": inscription_de_l_hypotheque_le(entity_ref("urn:fr:cc:suretes:d18:S"), @2024-06-30) { origin case_input; }
    }
    evaluate truth(effet_de_l_inscription_a_compter_du(entity_ref("urn:fr:cc:suretes:d18:S"), @2024-06-30));
    expect truth_status == TRUE_ONLY;
    expect applied(InscriptionDansLAnnee);
}
