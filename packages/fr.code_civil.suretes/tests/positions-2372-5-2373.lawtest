test "urn:positions:fr-code-civil-suretes-2373-3-retour-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:q23733:S"), entity_ref("urn:fr:cc:suretes:q23733:C"), entity_ref("urn:fr:cc:suretes:q23733:P"), entity_ref("urn:fr:cc:suretes:q23733:B")) { origin case_input; }
        assert "cession": cession_de_creance_en_garantie(entity_ref("urn:fr:cc:suretes:q23733:S")) { origin case_input; }
        assert "paid": creance_garantie_integralement_payee(entity_ref("urn:fr:cc:suretes:q23733:S")) { origin case_input; }
        assert "open": creance_cedee_non_encore_payee(entity_ref("urn:fr:cc:suretes:q23733:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirRestituerCreanceCedee, ACTIVE);
}

