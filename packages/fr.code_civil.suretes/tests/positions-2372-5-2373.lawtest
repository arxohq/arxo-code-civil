        assert "act": acte_prevoit_le_rechargement(entity_ref("urn:fr:cc:suretes:q23725b:S")) { origin case_input; }
        assert "registered": convention_enregistree_ou_publiee_le(entity_ref("urn:fr:cc:suretes:q23725b:X"), @2026-02-01) { origin case_input; }
