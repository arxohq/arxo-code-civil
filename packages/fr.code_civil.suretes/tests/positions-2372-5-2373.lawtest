        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:q2373:S"), entity_ref("urn:fr:cc:suretes:q2373:C"), entity_ref("urn:fr:cc:suretes:q2373:P"), entity_ref("urn:fr:cc:suretes:q2373:B")) { origin case_input; }
        assert "cession": cession_de_creance_en_garantie(entity_ref("urn:fr:cc:suretes:q2373:S")) { origin case_input; }
