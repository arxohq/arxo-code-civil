language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2372-5-recharge-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": fiducie_surete(entity_ref("urn:fr:cc:suretes:q23725:S"), entity_ref("urn:fr:cc:suretes:q23725:F"), entity_ref("urn:fr:cc:suretes:q23725:C")) { origin case_input; }
        assert "reload": convention_de_rechargement(entity_ref("urn:fr:cc:suretes:q23725:X"), entity_ref("urn:fr:cc:suretes:q23725:S"), entity_ref("urn:fr:cc:suretes:q23725:C"), 5000 EUR) { origin case_input; }
        assert "act": acte_prevoit_le_rechargement(entity_ref("urn:fr:cc:suretes:q23725:S")) { origin case_input; }
        assert "registered": convention_enregistree_ou_publiee_le(entity_ref("urn:fr:cc:suretes:q23725:X"), @2026-01-01) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteRechargerFiducie, ACTIVE);
}

