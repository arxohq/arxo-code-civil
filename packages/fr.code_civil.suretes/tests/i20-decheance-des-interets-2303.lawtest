language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2303 : premier incident le 15 janvier 2023 (le second, 15 février, ne compte pas), information le 20 avril ; pénalités échues le 31 janvier (40) et le 31 mars (60), non celle du 30 avril (80) — 100 EUR déchus.
test "urn:query:fr-code-civil-suretes-i20-decheance-des-interets-2303" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2023-06-01; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i20:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:i20:K"), entity_ref("urn:fr:cc:suretes:i20:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:i20:K"), entity_ref("urn:fr:cc:suretes:i20:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:i20:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:i20:B")) { origin case_input; }
        assert "f6": echeance_du_principal(entity_ref("urn:fr:cc:suretes:i20:K"), entity_ref("urn:fr:cc:suretes:i20:P1")) { origin case_input; }
        assert "f7": echue_le(entity_ref("urn:fr:cc:suretes:i20:P1"), @2023-01-15) { origin case_input; }
        assert "f8": echeance_impayee(entity_ref("urn:fr:cc:suretes:i20:P1")) { origin case_input; }
        assert "f9": echeance_du_principal(entity_ref("urn:fr:cc:suretes:i20:K"), entity_ref("urn:fr:cc:suretes:i20:P2")) { origin case_input; }
        assert "f10": echue_le(entity_ref("urn:fr:cc:suretes:i20:P2"), @2023-02-15) { origin case_input; }
        assert "f11": echeance_impayee(entity_ref("urn:fr:cc:suretes:i20:P2")) { origin case_input; }
        assert "f12": caution_informee_de_la_defaillance_le(entity_ref("urn:fr:cc:suretes:i20:K"), @2023-04-20) { origin case_input; }
        assert "f13": echeance_accessoire(entity_ref("urn:fr:cc:suretes:i20:K"), entity_ref("urn:fr:cc:suretes:i20:A1")) { origin case_input; }
        assert "f14": echue_le(entity_ref("urn:fr:cc:suretes:i20:A1"), @2023-01-31) { origin case_input; }
        assert "f15": montant_de_l_echeance(entity_ref("urn:fr:cc:suretes:i20:A1"), 40 EUR) { origin case_input; }
        assert "f16": echeance_accessoire(entity_ref("urn:fr:cc:suretes:i20:K"), entity_ref("urn:fr:cc:suretes:i20:A2")) { origin case_input; }
        assert "f17": echue_le(entity_ref("urn:fr:cc:suretes:i20:A2"), @2023-03-31) { origin case_input; }
        assert "f18": montant_de_l_echeance(entity_ref("urn:fr:cc:suretes:i20:A2"), 60 EUR) { origin case_input; }
        assert "f19": echeance_accessoire(entity_ref("urn:fr:cc:suretes:i20:K"), entity_ref("urn:fr:cc:suretes:i20:A3")) { origin case_input; }
        assert "f20": echue_le(entity_ref("urn:fr:cc:suretes:i20:A3"), @2023-04-30) { origin case_input; }
        assert "f21": montant_de_l_echeance(entity_ref("urn:fr:cc:suretes:i20:A3"), 80 EUR) { origin case_input; }
    }
    evaluate truth(interets_et_penalites_dechus(entity_ref("urn:fr:cc:suretes:i20:K"), 100 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(PeriodeDeDecheanceDefaillance);
}
