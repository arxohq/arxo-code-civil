language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2393, 6° ; 2401 : jugement de condamnation — hypothèque légale générale.
test "urn:query:fr-code-civil-suretes-r29-hypotheque-generale-du-jugement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": hypotheque(entity_ref("urn:fr:cc:suretes:r29:S"), entity_ref("urn:fr:cc:suretes:r29:B"), entity_ref("urn:fr:cc:suretes:r29:P")) { origin case_input; }
        assert "f2": espece_d_hypotheque(entity_ref("urn:fr:cc:suretes:r29:S"), Legale) { origin case_input; }
        assert "f3": hypotheque_legale_generale(entity_ref("urn:fr:cc:suretes:r29:S"), CreanceJudiciairementConstatee) { origin case_input; }
        assert "f4": decision_de_condamnation(entity_ref("urn:fr:cc:suretes:r29:S")) { origin case_input; }
    }
    evaluate truth(hypotheque_legale_des_jugements(entity_ref("urn:fr:cc:suretes:r29:S")));
    expect truth_status == TRUE_ONLY;
}
