language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2488-6 et 2488-7 : désignation écrite complète — l'agent est titulaire de la sûreté.
test "urn:query:fr-code-civil-suretes-r19-agent-titulaire" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": agent_des_suretes(entity_ref("urn:fr:cc:suretes:r19:M"), entity_ref("urn:fr:cc:suretes:r19:A")) { origin case_input; }
        assert "f2": convention_de_designation_ecrite(entity_ref("urn:fr:cc:suretes:r19:M")) { origin case_input; }
        assert "f3": ecrit_mentionne_qualite_objet_duree_pouvoirs(entity_ref("urn:fr:cc:suretes:r19:M")) { origin case_input; }
        assert "f4": surete_geree_par_l_agent(entity_ref("urn:fr:cc:suretes:r19:M"), entity_ref("urn:fr:cc:suretes:r19:S")) { origin case_input; }
    }
    evaluate truth(agent_titulaire_des_suretes(entity_ref("urn:fr:cc:suretes:r19:M"), entity_ref("urn:fr:cc:suretes:r19:S")));
    expect truth_status == TRUE_ONLY;
}
