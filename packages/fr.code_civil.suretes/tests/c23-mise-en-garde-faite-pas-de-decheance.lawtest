language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2299 : mise en garde effectuée — la déchéance ne peut naître, même inadaptation retenue.
test "urn:query:fr-code-civil-suretes-c23-mise-en-garde-faite-pas-de-decheance" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c23:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c23:K"), entity_ref("urn:fr:cc:suretes:c23:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c23:K"), entity_ref("urn:fr:cc:suretes:c23:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:c23:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c23:B")) { origin case_input; }
        assert "f6": mention_manuscrite_apposee(entity_ref("urn:fr:cc:suretes:c23:K")) { origin case_input; }
        assert "f7": montant_en_toutes_lettres(entity_ref("urn:fr:cc:suretes:c23:K"), 10000 EUR) { origin case_input; }
        assert "f8": montant_en_chiffres(entity_ref("urn:fr:cc:suretes:c23:K"), 10000 EUR) { origin case_input; }
        assert "f9": prejudice_de_la_caution_2299(entity_ref("urn:fr:cc:suretes:c23:K"), 4000 EUR) { origin adjudicated; }
        assert "f10": engagement_inadapte_aux_capacites_du_debiteur(entity_ref("urn:fr:cc:suretes:c23:K")) { origin adjudicated; }
        assert "f11": mise_en_garde_effectuee(entity_ref("urn:fr:cc:suretes:c23:K")) { origin case_input; }
    }
    evaluate truth(decheance_faute_de_mise_en_garde(entity_ref("urn:fr:cc:suretes:c23:K"), 4000 EUR));
    expect truth_status == NEITHER;
}
