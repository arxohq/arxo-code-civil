language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2356 : écrit désignant les créances garanties et nanties — valable.
test "urn:query:fr-code-civil-suretes-g16-nantissement-valable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": nantissement_de(entity_ref("urn:fr:cc:suretes:g16:S"), entity_ref("urn:fr:cc:suretes:g16:N")) { origin case_input; }
        assert "f2": ecrit_etabli(entity_ref("urn:fr:cc:suretes:g16:S")) { origin case_input; }
        assert "f3": ecrit_designe_la_dette_garantie(entity_ref("urn:fr:cc:suretes:g16:S")) { origin case_input; }
        assert "f4": ecrit_designe_les_creances_nanties(entity_ref("urn:fr:cc:suretes:g16:S")) { origin case_input; }
    }
    evaluate truth(nantissement_de_creance_valable(entity_ref("urn:fr:cc:suretes:g16:S")));
    expect truth_status == TRUE_ONLY;
}
