language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2443 : réquisition en 2026, document de 1976 — délivrable.
test "urn:query:fr-code-civil-suretes-d26-copie-dans-les-cinquante-ans" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": premier_janvier_de_l_annee_de_requisition(entity_ref("urn:fr:cc:suretes:d26:I"), @2026-01-01) { origin case_input; }
        assert "f2": requisition_de_copie_le(entity_ref("urn:fr:cc:suretes:d26:I"), @2026-04-01) { origin case_input; }
        assert "f3": document_depose_le(entity_ref("urn:fr:cc:suretes:d26:I"), @1976-01-01) { origin case_input; }
    }
    evaluate truth(copie_delivrable(entity_ref("urn:fr:cc:suretes:d26:I"), @1976-01-01));
    expect truth_status == TRUE_ONLY;
}
