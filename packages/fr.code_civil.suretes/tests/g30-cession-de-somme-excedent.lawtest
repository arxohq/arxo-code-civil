language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2374-5 : défaillance ; assiette 10 250, dette 9 000 — 1 250 EUR restitués.
test "urn:query:fr-code-civil-suretes-g30-cession-de-somme-excedent" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": cession_de_somme_d_argent(entity_ref("urn:fr:cc:suretes:g29:S"), 10000 EUR) { origin case_input; }
        assert "f2": ecrit_etabli(entity_ref("urn:fr:cc:suretes:g29:S")) { origin case_input; }
        assert "f3": ecrit_designe_la_dette_garantie(entity_ref("urn:fr:cc:suretes:g29:S")) { origin case_input; }
        assert "f4": affectation_convenue_de_la_somme(entity_ref("urn:fr:cc:suretes:g29:S")) { origin case_input; }
        assert "f5": fruits_et_interets_de_la_somme(entity_ref("urn:fr:cc:suretes:g29:S"), 250 EUR) { origin case_input; }
        assert "f6": defaillance_du_debiteur_garanti(entity_ref("urn:fr:cc:suretes:g29:S")) { origin case_input; }
        assert "f7": montant_de_la_dette_reelle(entity_ref("urn:fr:cc:suretes:g29:S"), 9000 EUR) { origin case_input; }
    }
    evaluate truth(excedent_restitue_au_cedant(entity_ref("urn:fr:cc:suretes:g29:S"), 1250 EUR));
    expect truth_status == TRUE_ONLY;
}
