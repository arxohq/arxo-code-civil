language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2321, canal §47.3 : garantie appelée, abus ou fraude allégués non encore appréciés.
test "urn:query:fr-code-civil-suretes-r01-garantie-appelee-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": garantie_autonome(entity_ref("urn:fr:cc:suretes:r01:G"), entity_ref("urn:fr:cc:suretes:r01:A"), entity_ref("urn:fr:cc:suretes:r01:B")) { origin case_input; }
        assert "f2": appel_de_la_garantie(entity_ref("urn:fr:cc:suretes:r01:G")) { origin case_input; }
        assert "f3": somme_de_la_garantie(entity_ref("urn:fr:cc:suretes:r01:G"), 50000 EUR) { origin case_input; }
    }
    evaluate truth(garant_libere_pour_abus_ou_fraude(entity_ref("urn:fr:cc:suretes:r01:G")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(abus_ou_fraude_manifestes, Court);
}
