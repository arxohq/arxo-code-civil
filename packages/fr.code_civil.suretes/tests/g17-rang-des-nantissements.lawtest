language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2361-1 : trois nantissements de la même créance (actes de 2020, 2021, 2022) — celui de 2022 au rang 3.
test "urn:query:fr-code-civil-suretes-g17-rang-des-nantissements" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": nantissement_de(entity_ref("urn:fr:cc:suretes:g17:S1"), entity_ref("urn:fr:cc:suretes:g17:N")) { origin case_input; }
        assert "f2": date_de_l_acte(entity_ref("urn:fr:cc:suretes:g17:S1"), @2020-01-01) { origin case_input; }
        assert "f3": nantissement_de(entity_ref("urn:fr:cc:suretes:g17:S2"), entity_ref("urn:fr:cc:suretes:g17:N")) { origin case_input; }
        assert "f4": date_de_l_acte(entity_ref("urn:fr:cc:suretes:g17:S2"), @2021-01-01) { origin case_input; }
        assert "f5": nantissement_de(entity_ref("urn:fr:cc:suretes:g17:S3"), entity_ref("urn:fr:cc:suretes:g17:N")) { origin case_input; }
        assert "f6": date_de_l_acte(entity_ref("urn:fr:cc:suretes:g17:S3"), @2022-01-01) { origin case_input; }
    }
    evaluate truth(rang_du_nantissement(entity_ref("urn:fr:cc:suretes:g17:S3"), 3));
    expect truth_status == TRUE_ONLY;
    expect applied(RangDuNantissement);
}
