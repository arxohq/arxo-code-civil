language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2302 : « avant le 31 mars » — communiquée le 30 mars 2023, l'information est en temps utile.
test "urn:query:fr-code-civil-suretes-i04-trente-mars-en-temps-utile" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2023-05-01; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i04:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:i04:K"), entity_ref("urn:fr:cc:suretes:i04:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:i04:K"), entity_ref("urn:fr:cc:suretes:i04:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:i04:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:i04:B")) { origin case_input; }
        assert "f6": arrete_annuel(entity_ref("urn:fr:cc:suretes:i04:K"), @2022-12-31) { origin case_input; }
        assert "f7": information_annuelle_communiquee_le(entity_ref("urn:fr:cc:suretes:i04:K"), @2022-12-31, @2023-03-30) { origin case_input; }
        assert "f8": rappel_du_terme_ou_de_la_faculte_de_resiliation(entity_ref("urn:fr:cc:suretes:i04:K"), @2022-12-31) { origin case_input; }
    }
    evaluate truth(information_annuelle_en_temps_utile(entity_ref("urn:fr:cc:suretes:i04:K"), @2022-12-31));
    expect truth_status == TRUE_ONLY;
    expect applied(InformationAnnuelleEnTempsUtile);
}
