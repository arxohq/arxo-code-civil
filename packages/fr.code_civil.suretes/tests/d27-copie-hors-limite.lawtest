language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2443 : document du 31 décembre 1975 — au-delà des cinquante années.
test "urn:query:fr-code-civil-suretes-d27-copie-hors-limite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": premier_janvier_de_l_annee_de_requisition(entity_ref("urn:fr:cc:suretes:d27:I"), @2026-01-01) { origin case_input; }
        assert "f2": requisition_de_copie_le(entity_ref("urn:fr:cc:suretes:d27:I"), @2026-04-01) { origin case_input; }
        assert "f3": document_depose_le(entity_ref("urn:fr:cc:suretes:d27:I"), @1975-12-31) { origin case_input; }
    }
    evaluate truth(copie_hors_limite(entity_ref("urn:fr:cc:suretes:d27:I"), @1975-12-31));
    expect truth_status == TRUE_ONLY;
}
