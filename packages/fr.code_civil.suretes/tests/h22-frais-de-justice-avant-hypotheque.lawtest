language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2377, 1°, et 2378 : frais de justice ayant profité au créancier hypothécaire — rang 1, l'hypothèque au rang 2.
test "urn:query:fr-code-civil-suretes-h22-frais-de-justice-avant-hypotheque" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:h22:D"), 1000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:h22:J"), entity_ref("urn:fr:cc:suretes:h22:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:h22:J"), PrivilegeImmobilierGeneral) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:h22:J"), 100 EUR) { origin case_input; }
        assert "f5": privilege_immobilier_invoque(entity_ref("urn:fr:cc:suretes:h22:J"), FraisDeJusticeImmobiliers) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:h22:H"), entity_ref("urn:fr:cc:suretes:h22:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:h22:H"), HypothequeConventionnelle) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:h22:H"), 600 EUR) { origin case_input; }
        assert "f9": date_de_rang(entity_ref("urn:fr:cc:suretes:h22:H"), @2015-01-01) { origin case_input; }
        assert "f10": frais_de_justice_profitables_a(entity_ref("urn:fr:cc:suretes:h22:J"), entity_ref("urn:fr:cc:suretes:h22:H")) { origin case_input; }
    }
    evaluate truth(rang_de_la_collocation(entity_ref("urn:fr:cc:suretes:h22:H"), 2));
    expect truth_status == TRUE_ONLY;
    expect applied(ClasseFraisDeJusticeImmobiliers);
}
