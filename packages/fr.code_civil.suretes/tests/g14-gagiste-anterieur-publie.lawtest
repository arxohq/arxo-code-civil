language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2340, al. 2 : le gagiste antérieur publié l'emporte sur le gagiste postérieur avec dépossession.
test "urn:query:fr-code-civil-suretes-g14-gagiste-anterieur-publie" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_constitue(entity_ref("urn:fr:cc:suretes:g14:S"), entity_ref("urn:fr:cc:suretes:g14:B"), entity_ref("urn:fr:cc:suretes:g14:P")) { origin case_input; }
        assert "f2": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g14:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "f3": gage_publie(entity_ref("urn:fr:cc:suretes:g14:S")) { origin case_input; }
        assert "f4": gage_avec_depossession_posterieur(entity_ref("urn:fr:cc:suretes:g14:S"), entity_ref("urn:fr:cc:suretes:g14:T")) { origin case_input; }
    }
    evaluate truth(preference_du_gagiste_anterieur_publie(entity_ref("urn:fr:cc:suretes:g14:S"), entity_ref("urn:fr:cc:suretes:g14:T")));
    expect truth_status == TRUE_ONLY;
}
