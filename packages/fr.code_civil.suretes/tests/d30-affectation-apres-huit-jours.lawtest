language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2364 : mise en demeure le 1er mars 2024, sans effet — affectation le 10 mars régulière.
test "urn:query:fr-code-civil-suretes-d30-affectation-apres-huit-jours" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_JOUR; }
        assert "f1": nantissement_de(entity_ref("urn:fr:cc:suretes:d30:S"), entity_ref("urn:fr:cc:suretes:d30:N")) { origin case_input; }
        assert "f2": paiement_de_la_creance_nantie(entity_ref("urn:fr:cc:suretes:d30:S"), 5000 EUR) { origin case_input; }
        assert "f3": defaillance_du_debiteur_garanti(entity_ref("urn:fr:cc:suretes:d30:S")) { origin case_input; }
        assert "f4": mise_en_demeure_sans_effet_le(entity_ref("urn:fr:cc:suretes:d30:S"), @2024-03-01) { origin case_input; }
        assert "f5": affectation_des_fonds_le(entity_ref("urn:fr:cc:suretes:d30:S"), @2024-03-10) { origin case_input; }
    }
    evaluate truth(affectation_des_fonds_reguliere(entity_ref("urn:fr:cc:suretes:d30:S")));
    expect truth_status == TRUE_ONLY;
}
