language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2362-paiement-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:n2362:S"), entity_ref("urn:fr:cc:suretes:n2362:C"), entity_ref("urn:fr:cc:suretes:n2362:P"), entity_ref("urn:fr:cc:suretes:n2362:B")) { origin case_input; }
        assert "charge": nantissement_de(entity_ref("urn:fr:cc:suretes:n2362:S"), entity_ref("urn:fr:cc:suretes:n2362:N")) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteConstituantRecevoirPaiement, ACTIVE);
}

