language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2298 : la nullité de la dette pour dol est une exception que la caution peut opposer.
test "urn:query:fr-code-civil-suretes-c56-exception-inherente-a-la-dette" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c56:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c56:K"), entity_ref("urn:fr:cc:suretes:c56:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c56:K"), entity_ref("urn:fr:cc:suretes:c56:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c56:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c56:B")) { origin case_input; }
        assert "f6": exception_du_debiteur(entity_ref("urn:fr:cc:suretes:c56:K"), "nullite-pour-dol") { origin case_input; }
    }
    evaluate truth(exception_opposable_par_la_caution(entity_ref("urn:fr:cc:suretes:c56:K"), "nullite-pour-dol"));
    expect truth_status == TRUE_ONLY;
}
