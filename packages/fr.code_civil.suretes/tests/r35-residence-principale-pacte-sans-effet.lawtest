language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2452 : pacte commissoire sur la résidence principale du débiteur — sans effet.
test "urn:query:fr-code-civil-suretes-r35-residence-principale-pacte-sans-effet" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": hypotheque(entity_ref("urn:fr:cc:suretes:r35:S"), entity_ref("urn:fr:cc:suretes:r35:B"), entity_ref("urn:fr:cc:suretes:r35:P")) { origin case_input; }
        assert "f2": espece_d_hypotheque(entity_ref("urn:fr:cc:suretes:r35:S"), Conventionnelle) { origin case_input; }
        assert "f3": acte_notarie(entity_ref("urn:fr:cc:suretes:r35:S")) { origin case_input; }
        assert "f4": constituant_capable_de_disposer(entity_ref("urn:fr:cc:suretes:r35:S")) { origin case_input; }
        assert "f5": acte_designe_nature_et_situation(entity_ref("urn:fr:cc:suretes:r35:S")) { origin case_input; }
        assert "f6": cause_determinee_dans_l_acte(entity_ref("urn:fr:cc:suretes:r35:S")) { origin case_input; }
        assert "f7": somme_determinee_dans_l_acte(entity_ref("urn:fr:cc:suretes:r35:S"), 200000 EUR) { origin case_input; }
        assert "f8": pacte_commissoire(entity_ref("urn:fr:cc:suretes:r35:S")) { origin case_input; }
        assert "f9": residence_principale_du_constituant(entity_ref("urn:fr:cc:suretes:r35:S")) { origin case_input; }
        assert "f10": dette_garantie_impayee(entity_ref("urn:fr:cc:suretes:r35:S")) { origin case_input; }
    }
    evaluate truth(pacte_commissoire_immobilier_efficace(entity_ref("urn:fr:cc:suretes:r35:S")));
    expect truth_status == NEITHER;
}
