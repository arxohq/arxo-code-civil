language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2381-entretien-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "gage": gage_immobilier_constitue(entity_ref("urn:fr:cc:suretes:i2381:S"), entity_ref("urn:fr:cc:suretes:i2381:C"), entity_ref("urn:fr:cc:suretes:i2381:P")) { origin case_input; }
        assert "maintained": immeuble_conserve_et_entretenu(entity_ref("urn:fr:cc:suretes:i2381:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirConserverEntretenirImmeuble, SATISFIED);
}

