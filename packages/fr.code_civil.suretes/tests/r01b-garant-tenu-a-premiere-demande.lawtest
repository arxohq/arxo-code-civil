language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2321, al. 1 : sans abus, fraude ni collusion établis, le garant paie à première demande les 50 000 EUR.
test "urn:query:fr-code-civil-suretes-r01b-garant-tenu-a-premiere-demande" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": garantie_autonome(entity_ref("urn:fr:cc:suretes:r01b:G"), entity_ref("urn:fr:cc:suretes:r01b:A"), entity_ref("urn:fr:cc:suretes:r01b:B")) { origin case_input; }
        assert "f2": appel_de_la_garantie(entity_ref("urn:fr:cc:suretes:r01b:G")) { origin case_input; }
        assert "f3": somme_de_la_garantie(entity_ref("urn:fr:cc:suretes:r01b:G"), 50000 EUR) { origin case_input; }
    }
    evaluate truth(garant_tenu_de_payer(entity_ref("urn:fr:cc:suretes:r01b:G"), 50000 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(GarantTenuDePayer);
}
