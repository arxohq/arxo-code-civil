language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2427 : principal 100 000, intérêts annuels 3 000, échus 10 000 — colloqué pour 100 000 + 9 000 = 109 000 EUR.
test "urn:query:fr-code-civil-suretes-h14-trois-annees-d-interets" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": collocation_dans(entity_ref("urn:fr:cc:suretes:h14:H"), entity_ref("urn:fr:cc:suretes:h14:D")) { origin case_input; }
        assert "f2": cause_de_preference(entity_ref("urn:fr:cc:suretes:h14:H"), HypothequeConventionnelle) { origin case_input; }
        assert "f3": creance_en_principal(entity_ref("urn:fr:cc:suretes:h14:H"), 100000 EUR) { origin case_input; }
        assert "f4": date_de_rang(entity_ref("urn:fr:cc:suretes:h14:H"), @2015-01-01) { origin case_input; }
        assert "f5": interets_annuels(entity_ref("urn:fr:cc:suretes:h14:H"), 3000 EUR) { origin case_input; }
        assert "f6": interets_echus_impayes(entity_ref("urn:fr:cc:suretes:h14:H"), 10000 EUR) { origin case_input; }
    }
    evaluate truth(montant_admis(entity_ref("urn:fr:cc:suretes:h14:H"), 109000 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(MontantAdmisAvecInterets);
}
