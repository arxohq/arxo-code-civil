language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2364, al. 2 : créance non échue — les sommes sont conservées.
test "urn:query:fr-code-civil-suretes-g23-sommes-conservees" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": nantissement_de(entity_ref("urn:fr:cc:suretes:g23:S"), entity_ref("urn:fr:cc:suretes:g23:N")) { origin case_input; }
        assert "f2": paiement_de_la_creance_nantie(entity_ref("urn:fr:cc:suretes:g23:S"), 5000 EUR) { origin case_input; }
    }
    evaluate truth(sommes_conservees_en_garantie(entity_ref("urn:fr:cc:suretes:g23:S"), 5000 EUR));
    expect truth_status == TRUE_ONLY;
}
