language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2366 : payé 5 000 pour une dette de 4 200 — 800 EUR dus au constituant.
test "urn:query:fr-code-civil-suretes-g24-excedent-au-constituant" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": nantissement_de(entity_ref("urn:fr:cc:suretes:g24:S"), entity_ref("urn:fr:cc:suretes:g24:N")) { origin case_input; }
        assert "f2": paiement_de_la_creance_nantie(entity_ref("urn:fr:cc:suretes:g24:S"), 5000 EUR) { origin case_input; }
        assert "f3": montant_de_la_dette_reelle(entity_ref("urn:fr:cc:suretes:g24:S"), 4200 EUR) { origin case_input; }
    }
    evaluate truth(difference_due_au_constituant(entity_ref("urn:fr:cc:suretes:g24:S"), 800 EUR));
    expect truth_status == TRUE_ONLY;
}
