language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2402, 2° : prêteur de deniers sans constatation authentique de l'emploi — pas d'hypothèque spéciale.
test "urn:query:fr-code-civil-suretes-r30-preteur-sans-emploi-constate" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": hypotheque(entity_ref("urn:fr:cc:suretes:r30:S"), entity_ref("urn:fr:cc:suretes:r30:B"), entity_ref("urn:fr:cc:suretes:r30:P")) { origin case_input; }
        assert "f2": espece_d_hypotheque(entity_ref("urn:fr:cc:suretes:r30:S"), Legale) { origin case_input; }
        assert "f3": hypotheque_legale_speciale(entity_ref("urn:fr:cc:suretes:r30:S"), PreteurDeDeniers) { origin case_input; }
    }
    evaluate truth(hypotheque_speciale(entity_ref("urn:fr:cc:suretes:r30:S")));
    expect truth_status == NEITHER;
}
