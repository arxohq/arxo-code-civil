language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2325 : sûreté légale — le texte ne vise que la sûreté conventionnelle.
test "urn:query:fr-code-civil-suretes-r13-surete-legale-non-pour-autrui" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:r13:S"), entity_ref("urn:fr:cc:suretes:r13:B"), entity_ref("urn:fr:cc:suretes:r13:P"), entity_ref("urn:fr:cc:suretes:r13:X")) { origin case_input; }
        assert "f2": surete_accordee_par_la_loi(entity_ref("urn:fr:cc:suretes:r13:S")) { origin case_input; }
        assert "f3": surete_constituee_par_un_tiers(entity_ref("urn:fr:cc:suretes:r13:S"), entity_ref("urn:fr:cc:suretes:r13:T")) { origin case_input; }
    }
    evaluate truth(action_limitee_au_bien_affecte(entity_ref("urn:fr:cc:suretes:r13:S"), entity_ref("urn:fr:cc:suretes:r13:T")));
    expect truth_status == NEITHER;
}
