language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2314 : faute du créancier retenue, préjudice 3 000 — la caution est déchargée de 3 000 EUR.
test "urn:query:fr-code-civil-suretes-c34-perte-de-subrogation-decharge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c34:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c34:K"), entity_ref("urn:fr:cc:suretes:c34:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c34:K"), entity_ref("urn:fr:cc:suretes:c34:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c34:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c34:B")) { origin case_input; }
        assert "f6": subrogation_devenue_impossible(entity_ref("urn:fr:cc:suretes:c34:K")) { origin case_input; }
        assert "f7": prejudice_de_la_perte_de_subrogation(entity_ref("urn:fr:cc:suretes:c34:K"), 3000 EUR) { origin adjudicated; }
        assert "f8": faute_du_creancier_2314(entity_ref("urn:fr:cc:suretes:c34:K")) { origin adjudicated; }
    }
    evaluate truth(caution_dechargee(entity_ref("urn:fr:cc:suretes:c34:K"), 3000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect judgment_requests(0);
}
