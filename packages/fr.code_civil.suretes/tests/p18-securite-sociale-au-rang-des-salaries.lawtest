language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2332-2 : la caisse de sécurité sociale vient au même rang que le salarié — rang 1 pour les deux.
test "urn:query:fr-code-civil-suretes-p18-securite-sociale-au-rang-des-salaries" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:p18:D"), 1000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:p18:S"), entity_ref("urn:fr:cc:suretes:p18:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:p18:S"), PrivilegeMobilierGeneral) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:p18:S"), 300 EUR) { origin case_input; }
        assert "f5": privilege_general_invoque(entity_ref("urn:fr:cc:suretes:p18:S"), RemunerationsEtIndemnites) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:p18:U"), entity_ref("urn:fr:cc:suretes:p18:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:p18:U"), PrivilegeMobilierGeneral) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:p18:U"), 300 EUR) { origin case_input; }
        assert "f9": privilege_general_invoque(entity_ref("urn:fr:cc:suretes:p18:U"), CaissesDeSecuriteSociale) { origin case_input; }
    }
    evaluate truth(rang_de_la_collocation(entity_ref("urn:fr:cc:suretes:p18:U"), 1));
    expect truth_status == TRUE_ONLY;
}
