language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2372-5 : deux rechargements enregistrés en mars et en février — celui de mars au rang 2.
test "urn:query:fr-code-civil-suretes-r18-rang-des-rechargements" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fiducie_surete(entity_ref("urn:fr:cc:suretes:r18:S"), entity_ref("urn:fr:cc:suretes:r18:F"), entity_ref("urn:fr:cc:suretes:r18:C")) { origin case_input; }
        assert "f2": convention_de_rechargement(entity_ref("urn:fr:cc:suretes:r18:X"), entity_ref("urn:fr:cc:suretes:r18:S"), entity_ref("urn:fr:cc:suretes:r18:N1"), 1000 EUR) { origin case_input; }
        assert "f3": convention_enregistree_ou_publiee_le(entity_ref("urn:fr:cc:suretes:r18:X"), @2024-03-01) { origin case_input; }
        assert "f4": convention_de_rechargement(entity_ref("urn:fr:cc:suretes:r18:Y"), entity_ref("urn:fr:cc:suretes:r18:S"), entity_ref("urn:fr:cc:suretes:r18:N2"), 1000 EUR) { origin case_input; }
        assert "f5": convention_enregistree_ou_publiee_le(entity_ref("urn:fr:cc:suretes:r18:Y"), @2024-02-01) { origin case_input; }
    }
    evaluate truth(rang_du_rechargement(entity_ref("urn:fr:cc:suretes:r18:X"), 2));
    expect truth_status == TRUE_ONLY;
}
