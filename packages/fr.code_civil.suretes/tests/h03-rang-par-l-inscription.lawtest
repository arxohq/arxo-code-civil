language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2418 : l'hypothèque inscrite en 2020 vient après le privilège général et l'hypothèque de 2019 — rang 3.
test "urn:query:fr-code-civil-suretes-h03-rang-par-l-inscription" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:h01:D"), 300000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:h01:P"), entity_ref("urn:fr:cc:suretes:h01:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:h01:P"), PrivilegeImmobilierGeneral) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:h01:P"), 20000 EUR) { origin case_input; }
        assert "f5": privilege_immobilier_invoque(entity_ref("urn:fr:cc:suretes:h01:P"), RemunerationsEtIndemnitesImmobilieres) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:h01:H1"), entity_ref("urn:fr:cc:suretes:h01:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:h01:H1"), HypothequeConventionnelle) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:h01:H1"), 150000 EUR) { origin case_input; }
        assert "f9": date_de_rang(entity_ref("urn:fr:cc:suretes:h01:H1"), @2020-03-01) { origin case_input; }
        assert "f10": collocation_dans(entity_ref("urn:fr:cc:suretes:h01:H2"), entity_ref("urn:fr:cc:suretes:h01:D")) { origin case_input; }
        assert "f11": cause_de_preference(entity_ref("urn:fr:cc:suretes:h01:H2"), HypothequeConventionnelle) { origin case_input; }
        assert "f12": creance_en_principal(entity_ref("urn:fr:cc:suretes:h01:H2"), 100000 EUR) { origin case_input; }
        assert "f13": date_de_rang(entity_ref("urn:fr:cc:suretes:h01:H2"), @2019-06-10) { origin case_input; }
        assert "f14": collocation_dans(entity_ref("urn:fr:cc:suretes:h01:X"), entity_ref("urn:fr:cc:suretes:h01:D")) { origin case_input; }
        assert "f15": cause_de_preference(entity_ref("urn:fr:cc:suretes:h01:X"), Chirographaire) { origin case_input; }
        assert "f16": creance_en_principal(entity_ref("urn:fr:cc:suretes:h01:X"), 100000 EUR) { origin case_input; }
    }
    evaluate truth(rang_de_la_collocation(entity_ref("urn:fr:cc:suretes:h01:H1"), 3));
    expect truth_status == TRUE_ONLY;
    expect applied(PrecedeParLaDate);
}
