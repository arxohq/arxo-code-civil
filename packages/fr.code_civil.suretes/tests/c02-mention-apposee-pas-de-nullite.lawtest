language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2297 : mention apposée — pas de nullité.
test "urn:query:fr-code-civil-suretes-c02-mention-apposee-pas-de-nullite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c02:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c02:K"), entity_ref("urn:fr:cc:suretes:c02:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c02:K"), entity_ref("urn:fr:cc:suretes:c02:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:c02:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c02:B")) { origin case_input; }
        assert "f6": mention_manuscrite_apposee(entity_ref("urn:fr:cc:suretes:c02:K")) { origin case_input; }
        assert "f7": montant_en_toutes_lettres(entity_ref("urn:fr:cc:suretes:c02:K"), 10000 EUR) { origin case_input; }
        assert "f8": montant_en_chiffres(entity_ref("urn:fr:cc:suretes:c02:K"), 10000 EUR) { origin case_input; }
    }
    evaluate truth(cautionnement_nul_faute_de_mention(entity_ref("urn:fr:cc:suretes:c02:K")));
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
