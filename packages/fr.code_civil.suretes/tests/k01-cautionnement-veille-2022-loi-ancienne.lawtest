language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Ordonnance 2021-1192, art. 37, II : cautionnement conclu le 31 décembre 2021 — la rédaction antérieure s'applique, le paquet s'arrête là.
test "urn:query:fr-code-civil-suretes-k01-cautionnement-veille-2022-loi-ancienne" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:k01:K"), @2021-12-31) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:k01:K"), entity_ref("urn:fr:cc:suretes:k01:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:k01:K"), entity_ref("urn:fr:cc:suretes:k01:B")) { origin case_input; }
    }
    evaluate truth(redaction_anterieure_applicable(entity_ref("urn:fr:cc:suretes:k01:K")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CautionnementDeLaLoiAncienne);
}
