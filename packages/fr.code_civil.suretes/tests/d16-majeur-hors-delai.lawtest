language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2399 : inscription requise le 11 mai 2025 — hors délai.
test "urn:query:fr-code-civil-suretes-d16-majeur-hors-delai" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": hypotheque(entity_ref("urn:fr:cc:suretes:d16:S"), entity_ref("urn:fr:cc:suretes:d16:B"), entity_ref("urn:fr:cc:suretes:d16:P")) { origin case_input; }
        assert "f2": espece_d_hypotheque(entity_ref("urn:fr:cc:suretes:d16:S"), Legale) { origin case_input; }
        assert "f3": hypotheque_legale_generale(entity_ref("urn:fr:cc:suretes:d16:S"), MineurOuMajeurEnTutelle) { origin case_input; }
        assert "f4": fin_de_l_incapacite_le(entity_ref("urn:fr:cc:suretes:d16:S"), @2024-05-10) { origin case_input; }
        assert "f5": inscription_requise_le(entity_ref("urn:fr:cc:suretes:d16:S"), @2025-05-11) { origin case_input; }
    }
    evaluate truth(inscription_2399_hors_delai(entity_ref("urn:fr:cc:suretes:d16:S")));
    expect truth_status == TRUE_ONLY;
}
