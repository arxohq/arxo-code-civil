        assert "gage": gage_constitue(entity_ref("urn:fr:cc:suretes:g07b:S"), entity_ref("urn:fr:cc:suretes:g07b:B"), entity_ref("urn:fr:cc:suretes:g07b:P")) { origin case_input; }
        assert "nature": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g07b:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "paid": dette_entierement_payee(entity_ref("urn:fr:cc:suretes:g07b:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(PouvoirExigerRadiationApresPaiement, ACTIVE);
