language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2488-7 : désignation sans écrit — nulle.
test "urn:query:fr-code-civil-suretes-r20-designation-sans-ecrit" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": agent_des_suretes(entity_ref("urn:fr:cc:suretes:r20:M"), entity_ref("urn:fr:cc:suretes:r20:A")) { origin case_input; }
    }
    evaluate truth(designation_nulle(entity_ref("urn:fr:cc:suretes:r20:M")));
    expect truth_status == TRUE_ONLY;
}
