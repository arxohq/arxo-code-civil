language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2348 : autres créanciers gagistes — la différence est consignée.
test "urn:query:fr-code-civil-suretes-g05-soulte-consignee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_constitue(entity_ref("urn:fr:cc:suretes:g05:S"), entity_ref("urn:fr:cc:suretes:g05:B"), entity_ref("urn:fr:cc:suretes:g05:P")) { origin case_input; }
        assert "f2": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g05:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "f3": dette_garantie_impayee(entity_ref("urn:fr:cc:suretes:g05:S")) { origin case_input; }
        assert "f4": pacte_commissoire(entity_ref("urn:fr:cc:suretes:g05:S")) { origin case_input; }
        assert "f5": valeur_au_jour_du_transfert(entity_ref("urn:fr:cc:suretes:g05:S"), 12000 EUR) { origin case_input; }
        assert "f6": montant_de_la_dette_reelle(entity_ref("urn:fr:cc:suretes:g05:S"), 10000 EUR) { origin case_input; }
        assert "f7": autres_creanciers_de_meme_rang_ou_inscrits(entity_ref("urn:fr:cc:suretes:g05:S")) { origin case_input; }
    }
    evaluate truth(soulte_consignee(entity_ref("urn:fr:cc:suretes:g05:S"), 2000 EUR));
    expect truth_status == TRUE_ONLY;
}
