language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2305-1 : bénéfice invoqué après les premières poursuites — non invoqué à temps.
test "urn:query:fr-code-civil-suretes-c20-discussion-invoquee-tardivement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c20:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c20:K"), entity_ref("urn:fr:cc:suretes:c20:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c20:K"), entity_ref("urn:fr:cc:suretes:c20:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c20:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c20:B")) { origin case_input; }
        assert "f6": premieres_poursuites_contre_la_caution_le(entity_ref("urn:fr:cc:suretes:c20:K"), @2023-05-02) { origin case_input; }
        assert "f7": benefice_de_discussion_invoque_le(entity_ref("urn:fr:cc:suretes:c20:K"), @2023-06-15) { origin case_input; }
    }
    evaluate truth(benefice_de_discussion_invoque_a_temps(entity_ref("urn:fr:cc:suretes:c20:K")));
    expect truth_status == NEITHER;
}
