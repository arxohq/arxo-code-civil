language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2488-2 : contrat de fiducie-sûreté qui ne mentionne pas la dette garantie — nul.
test "urn:query:fr-code-civil-suretes-r15-fiducie-sans-dette-nulle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fiducie_surete(entity_ref("urn:fr:cc:suretes:r15:S"), entity_ref("urn:fr:cc:suretes:r15:F"), entity_ref("urn:fr:cc:suretes:r15:C")) { origin case_input; }
        assert "f2": fiducie_immobiliere(entity_ref("urn:fr:cc:suretes:r15:S")) { origin case_input; }
    }
    evaluate truth(fiducie_surete_nulle(entity_ref("urn:fr:cc:suretes:r15:S")));
    expect truth_status == TRUE_ONLY;
}
