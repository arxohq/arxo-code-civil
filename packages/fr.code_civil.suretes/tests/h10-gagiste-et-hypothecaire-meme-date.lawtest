language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2419 : gagiste sur immeuble par destination et créancier hypothécaire publiés le même jour — le texte ne les départage pas, distribution non calculée.
test "urn:query:fr-code-civil-suretes-h10-gagiste-et-hypothecaire-meme-date" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:h10:D"), 1000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:h10:A"), entity_ref("urn:fr:cc:suretes:h10:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:h10:A"), GageSurImmeubleParDestination) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:h10:A"), 600 EUR) { origin case_input; }
        assert "f5": date_de_rang(entity_ref("urn:fr:cc:suretes:h10:A"), @2021-03-01) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:h10:B"), entity_ref("urn:fr:cc:suretes:h10:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:h10:B"), HypothequeConventionnelle) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:h10:B"), 600 EUR) { origin case_input; }
        assert "f9": date_de_rang(entity_ref("urn:fr:cc:suretes:h10:B"), @2021-03-01) { origin case_input; }
    }
    evaluate truth(distribution_non_calculee(entity_ref("urn:fr:cc:suretes:h10:D")));
    expect truth_status == TRUE_ONLY;
    expect applied(FrontiereSuspendLaDistribution);
}
