language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2356 : nantissement de créance sans écrit — nul.
test "urn:query:fr-code-civil-suretes-g15-nantissement-sans-ecrit-nul" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": nantissement_de(entity_ref("urn:fr:cc:suretes:g15:S"), entity_ref("urn:fr:cc:suretes:g15:N")) { origin case_input; }
    }
    evaluate truth(nantissement_de_creance_nul(entity_ref("urn:fr:cc:suretes:g15:S")));
    expect truth_status == TRUE_ONLY;
}
