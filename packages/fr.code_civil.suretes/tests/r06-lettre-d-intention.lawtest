language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2322 : lettre d'intention — soutien promis au débiteur.
test "urn:query:fr-code-civil-suretes-r06-lettre-d-intention" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": lettre_d_intention(entity_ref("urn:fr:cc:suretes:r06:L"), entity_ref("urn:fr:cc:suretes:r06:M"), entity_ref("urn:fr:cc:suretes:r06:D")) { origin case_input; }
    }
    evaluate truth(soutien_du_debiteur_promis(entity_ref("urn:fr:cc:suretes:r06:L"), entity_ref("urn:fr:cc:suretes:r06:D")));
    expect truth_status == TRUE_ONLY;
}
