language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Ordonnance 2021-1192, art. 37, I ; art. 2305 : cautionnement du 1er janvier 2022 — le bénéfice de discussion est calculé.
test "urn:query:fr-code-civil-suretes-c58-cautionnement-premier-janvier-benefice" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c58:K"), @2022-01-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c58:K"), entity_ref("urn:fr:cc:suretes:c58:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c58:K"), entity_ref("urn:fr:cc:suretes:c58:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c58:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c58:B")) { origin case_input; }
    }
    evaluate truth(benefice_de_discussion(entity_ref("urn:fr:cc:suretes:c58:K")));
    expect truth_status == TRUE_ONLY;
}
