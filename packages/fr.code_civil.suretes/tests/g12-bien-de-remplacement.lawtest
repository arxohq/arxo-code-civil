language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2342-1 : le bien acquis en remplacement entre dans l'assiette.
test "urn:query:fr-code-civil-suretes-g12-bien-de-remplacement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_constitue(entity_ref("urn:fr:cc:suretes:g12:S"), entity_ref("urn:fr:cc:suretes:g12:B"), entity_ref("urn:fr:cc:suretes:g12:P")) { origin case_input; }
        assert "f2": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g12:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "f3": choses_fongibles(entity_ref("urn:fr:cc:suretes:g12:S")) { origin case_input; }
        assert "f4": bien_acquis_en_remplacement(entity_ref("urn:fr:cc:suretes:g12:S"), entity_ref("urn:fr:cc:suretes:g12:R")) { origin case_input; }
    }
    evaluate truth(dans_l_assiette_du_gage(entity_ref("urn:fr:cc:suretes:g12:S"), entity_ref("urn:fr:cc:suretes:g12:R")));
    expect truth_status == TRUE_ONLY;
}
