language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2338, al. 2 : le 31 décembre 2022, la rédaction nouvelle n'est pas en vigueur.
test "urn:query:fr-code-civil-suretes-g10-vehicule-avant-2023" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2022-12-31; timezone "Europe/Paris"; }
        assert "f1": gage_sur_vehicule_immatricule(entity_ref("urn:fr:cc:suretes:g09:S"), entity_ref("urn:fr:cc:suretes:g09:V")) { origin case_input; }
    }
    evaluate truth(nouvelle_inscription_impossible(entity_ref("urn:fr:cc:suretes:g09:V")));
    expect truth_status == NEITHER;
}
