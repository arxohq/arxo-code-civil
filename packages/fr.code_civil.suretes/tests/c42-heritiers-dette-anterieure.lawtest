language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2317 : caution décédée le 10 mars 2024 ; dette née le 9 mars — les héritiers en sont tenus.
test "urn:query:fr-code-civil-suretes-c42-heritiers-dette-anterieure" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c42:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c42:K"), entity_ref("urn:fr:cc:suretes:c42:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c42:K"), entity_ref("urn:fr:cc:suretes:c42:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:c42:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c42:B")) { origin case_input; }
        assert "f6": mention_manuscrite_apposee(entity_ref("urn:fr:cc:suretes:c42:K")) { origin case_input; }
        assert "f7": montant_en_toutes_lettres(entity_ref("urn:fr:cc:suretes:c42:K"), 10000 EUR) { origin case_input; }
        assert "f8": montant_en_chiffres(entity_ref("urn:fr:cc:suretes:c42:K"), 10000 EUR) { origin case_input; }
        assert "f9": deces_de_la_caution_le(entity_ref("urn:fr:cc:suretes:c42:K"), @2024-03-10) { origin case_input; }
        assert "f10": dette_garantie(entity_ref("urn:fr:cc:suretes:c42:K"), entity_ref("urn:fr:cc:suretes:c42:D")) { origin case_input; }
        assert "f11": nee_le(entity_ref("urn:fr:cc:suretes:c42:D"), @2024-03-09) { origin case_input; }
    }
    evaluate truth(heritiers_tenus_de_la_dette(entity_ref("urn:fr:cc:suretes:c42:K"), entity_ref("urn:fr:cc:suretes:c42:D")));
    expect truth_status == TRUE_ONLY;
}
