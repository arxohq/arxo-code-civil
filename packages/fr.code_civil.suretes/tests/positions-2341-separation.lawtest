language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2341-separation-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "gage": gage_constitue(entity_ref("urn:fr:cc:suretes:g2341:S"), entity_ref("urn:fr:cc:suretes:g2341:C"), entity_ref("urn:fr:cc:suretes:g2341:P")) { origin case_input; }
        assert "possession": gage_avec_depossession(entity_ref("urn:fr:cc:suretes:g2341:S")) { origin case_input; }
        assert "fungible": choses_fongibles(entity_ref("urn:fr:cc:suretes:g2341:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirSeparerChosesFongibles, ACTIVE);
}

test "urn:positions:fr-code-civil-suretes-2341-separation-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "gage": gage_constitue(entity_ref("urn:fr:cc:suretes:g2341b:S"), entity_ref("urn:fr:cc:suretes:g2341b:C"), entity_ref("urn:fr:cc:suretes:g2341b:P")) { origin case_input; }
        assert "possession": gage_avec_depossession(entity_ref("urn:fr:cc:suretes:g2341b:S")) { origin case_input; }
        assert "fungible": choses_fongibles(entity_ref("urn:fr:cc:suretes:g2341b:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirSeparerChosesFongibles, ACTIVE);
}
