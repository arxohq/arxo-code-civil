language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2332-2, al. 2 : prix 100, trois salariés de 100 — 33,33 EUR chacun, un centime non attribué (politique du paquet).
test "urn:query:fr-code-civil-suretes-p08-centime-non-attribue" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:p08:D"), 100 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:p08:S1"), entity_ref("urn:fr:cc:suretes:p08:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:p08:S1"), PrivilegeMobilierGeneral) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:p08:S1"), 100 EUR) { origin case_input; }
        assert "f5": privilege_general_invoque(entity_ref("urn:fr:cc:suretes:p08:S1"), RemunerationsEtIndemnites) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:p08:S2"), entity_ref("urn:fr:cc:suretes:p08:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:p08:S2"), PrivilegeMobilierGeneral) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:p08:S2"), 100 EUR) { origin case_input; }
        assert "f9": privilege_general_invoque(entity_ref("urn:fr:cc:suretes:p08:S2"), RemunerationsEtIndemnites) { origin case_input; }
        assert "f10": collocation_dans(entity_ref("urn:fr:cc:suretes:p08:S3"), entity_ref("urn:fr:cc:suretes:p08:D")) { origin case_input; }
        assert "f11": cause_de_preference(entity_ref("urn:fr:cc:suretes:p08:S3"), PrivilegeMobilierGeneral) { origin case_input; }
        assert "f12": creance_en_principal(entity_ref("urn:fr:cc:suretes:p08:S3"), 100 EUR) { origin case_input; }
        assert "f13": privilege_general_invoque(entity_ref("urn:fr:cc:suretes:p08:S3"), RemunerationsEtIndemnites) { origin case_input; }
    }
    evaluate truth(reliquat_du_prix(entity_ref("urn:fr:cc:suretes:p08:D"), 0.01 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(ReliquatDuPrix);
}
