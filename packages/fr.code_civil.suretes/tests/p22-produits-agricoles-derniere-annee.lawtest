language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2331, 4° : produits livrés pendant la dernière année — quatrième privilège général.
test "urn:query:fr-code-civil-suretes-p22-produits-agricoles-derniere-annee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": collocation_dans(entity_ref("urn:fr:cc:suretes:p21:A"), entity_ref("urn:fr:cc:suretes:p21:D")) { origin case_input; }
        assert "f2": cause_de_preference(entity_ref("urn:fr:cc:suretes:p21:A"), PrivilegeMobilierGeneral) { origin case_input; }
        assert "f3": creance_en_principal(entity_ref("urn:fr:cc:suretes:p21:A"), 100 EUR) { origin case_input; }
        assert "f4": privilege_general_invoque(entity_ref("urn:fr:cc:suretes:p21:A"), ProduitsAgricoles) { origin case_input; }
        assert "f5": produits_livres_pendant_la_derniere_annee(entity_ref("urn:fr:cc:suretes:p21:A")) { origin case_input; }
    }
    evaluate truth(classe_de_preference(entity_ref("urn:fr:cc:suretes:p21:A"), 24));
    expect truth_status == TRUE_ONLY;
    expect applied(ClasseProduitsAgricoles);
}
