language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Ordonnance 2021-1192, art. 37, I ; art. 2288 : conclu le 1er janvier 2022, la caution est obligée envers le créancier selon la rédaction nouvelle.
test "urn:query:fr-code-civil-suretes-k03-cautionnement-premier-janvier-2022-loi-nouvelle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:k03:K"), @2022-01-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:k03:K"), entity_ref("urn:fr:cc:suretes:k03:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:k03:K"), entity_ref("urn:fr:cc:suretes:k03:B")) { origin case_input; }
    }
    evaluate truth(caution_obligee_envers(entity_ref("urn:fr:cc:suretes:k03:K"), entity_ref("urn:fr:cc:suretes:k03:C"), entity_ref("urn:fr:cc:suretes:k03:B")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CautionObligeeEnversLeCreancier);
}
