language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2420 : deux créanciers de la même hypothèque rechargeable, même rang d'inscription ; conventions publiées le 1er février et le 1er janvier 2021 — la première publiée passe avant.
test "urn:query:fr-code-civil-suretes-h19-rechargement-par-publication" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:h19:D"), 1000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:h19:A"), entity_ref("urn:fr:cc:suretes:h19:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:h19:A"), HypothequeConventionnelle) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:h19:A"), 600 EUR) { origin case_input; }
        assert "f5": date_de_rang(entity_ref("urn:fr:cc:suretes:h19:A"), @2021-03-01) { origin case_input; }
        assert "f6": collocation_hypothecaire_rechargeable(entity_ref("urn:fr:cc:suretes:h19:A"), entity_ref("urn:fr:cc:suretes:h19:S")) { origin case_input; }
        assert "f7": date_de_la_convention_de_rechargement(entity_ref("urn:fr:cc:suretes:h19:A"), @2021-02-01) { origin case_input; }
        assert "f8": collocation_dans(entity_ref("urn:fr:cc:suretes:h19:B"), entity_ref("urn:fr:cc:suretes:h19:D")) { origin case_input; }
        assert "f9": cause_de_preference(entity_ref("urn:fr:cc:suretes:h19:B"), HypothequeConventionnelle) { origin case_input; }
        assert "f10": creance_en_principal(entity_ref("urn:fr:cc:suretes:h19:B"), 600 EUR) { origin case_input; }
        assert "f11": date_de_rang(entity_ref("urn:fr:cc:suretes:h19:B"), @2021-03-01) { origin case_input; }
        assert "f12": collocation_hypothecaire_rechargeable(entity_ref("urn:fr:cc:suretes:h19:B"), entity_ref("urn:fr:cc:suretes:h19:S")) { origin case_input; }
        assert "f13": date_de_la_convention_de_rechargement(entity_ref("urn:fr:cc:suretes:h19:B"), @2021-01-01) { origin case_input; }
    }
    evaluate truth(rang_de_la_collocation(entity_ref("urn:fr:cc:suretes:h19:A"), 2));
    expect truth_status == TRUE_ONLY;
    expect applied(RechargementPrecedeParLaPublication);
}
