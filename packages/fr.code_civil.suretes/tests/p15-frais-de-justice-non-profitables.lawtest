language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2331, 1° : les frais de justice n'ont pas profité au créancier chirographaire — préférence relative, distribution non calculée (frontière).
test "urn:query:fr-code-civil-suretes-p15-frais-de-justice-non-profitables" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:p15:D"), 1000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:p15:J"), entity_ref("urn:fr:cc:suretes:p15:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:p15:J"), PrivilegeMobilierGeneral) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:p15:J"), 100 EUR) { origin case_input; }
        assert "f5": privilege_general_invoque(entity_ref("urn:fr:cc:suretes:p15:J"), FraisDeJustice) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:p15:X"), entity_ref("urn:fr:cc:suretes:p15:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:p15:X"), Chirographaire) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:p15:X"), 500 EUR) { origin case_input; }
    }
    evaluate truth(distribution_non_calculee(entity_ref("urn:fr:cc:suretes:p15:D")));
    expect truth_status == TRUE_ONLY;
    expect applied(FraisDeJusticeNonProfitables);
}
