language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2306 : trois cautions solvables de 10 000 — 3 333,33 EUR (arrondi au centime : politique du paquet).
test "urn:query:fr-code-civil-suretes-c15-division-entre-trois-arrondie" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c15:K1"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c15:K1"), entity_ref("urn:fr:cc:suretes:c15:C1")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c15:K1"), entity_ref("urn:fr:cc:suretes:c15:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c15:C1")) { origin case_input; }
        assert "f5": dette_garantie(entity_ref("urn:fr:cc:suretes:c15:K1"), entity_ref("urn:fr:cc:suretes:c15:D")) { origin case_input; }
        assert "f6": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c15:K2"), @2022-03-01) { origin case_input; }
        assert "f7": caution(entity_ref("urn:fr:cc:suretes:c15:K2"), entity_ref("urn:fr:cc:suretes:c15:C2")) { origin case_input; }
        assert "f8": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c15:K2"), entity_ref("urn:fr:cc:suretes:c15:B")) { origin case_input; }
        assert "f9": est_personne_morale(entity_ref("urn:fr:cc:suretes:c15:C2")) { origin case_input; }
        assert "f10": dette_garantie(entity_ref("urn:fr:cc:suretes:c15:K2"), entity_ref("urn:fr:cc:suretes:c15:D")) { origin case_input; }
        assert "f11": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c15:K3"), @2022-03-01) { origin case_input; }
        assert "f12": caution(entity_ref("urn:fr:cc:suretes:c15:K3"), entity_ref("urn:fr:cc:suretes:c15:C3")) { origin case_input; }
        assert "f13": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c15:K3"), entity_ref("urn:fr:cc:suretes:c15:B")) { origin case_input; }
        assert "f14": est_personne_morale(entity_ref("urn:fr:cc:suretes:c15:C3")) { origin case_input; }
        assert "f15": dette_garantie(entity_ref("urn:fr:cc:suretes:c15:K3"), entity_ref("urn:fr:cc:suretes:c15:D")) { origin case_input; }
        assert "f16": premieres_poursuites_contre_la_caution_le(entity_ref("urn:fr:cc:suretes:c15:K1"), @2023-05-02) { origin case_input; }
        assert "f17": benefice_de_division_invoque_le(entity_ref("urn:fr:cc:suretes:c15:K1"), @2023-05-02) { origin case_input; }
        assert "f18": montant_de_la_dette_garantie(entity_ref("urn:fr:cc:suretes:c15:K1"), 10000 EUR) { origin case_input; }
    }
    evaluate truth(part_de_la_caution_dans_la_division(entity_ref("urn:fr:cc:suretes:c15:K1"), 3333.33 EUR));
    expect truth_status == TRUE_ONLY;
}

test "urn:positions:fr-code-civil-suretes-2306-division-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "date": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c15:K1"), @2022-03-01) { origin case_input; }
        assert "surety": caution(entity_ref("urn:fr:cc:suretes:c15:K1"), entity_ref("urn:fr:cc:suretes:c15:C1")) { origin case_input; }
        assert "debt": dette_garantie(entity_ref("urn:fr:cc:suretes:c15:K1"), entity_ref("urn:fr:cc:suretes:c15:D")) { origin case_input; }
        assert "date2": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c15:K2"), @2022-03-01) { origin case_input; }
        assert "surety2": caution(entity_ref("urn:fr:cc:suretes:c15:K2"), entity_ref("urn:fr:cc:suretes:c15:C2")) { origin case_input; }
        assert "debt2": dette_garantie(entity_ref("urn:fr:cc:suretes:c15:K2"), entity_ref("urn:fr:cc:suretes:c15:D")) { origin case_input; }
        assert "date3": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c15:K3"), @2022-03-01) { origin case_input; }
        assert "surety3": caution(entity_ref("urn:fr:cc:suretes:c15:K3"), entity_ref("urn:fr:cc:suretes:c15:C3")) { origin case_input; }
        assert "debt3": dette_garantie(entity_ref("urn:fr:cc:suretes:c15:K3"), entity_ref("urn:fr:cc:suretes:c15:D")) { origin case_input; }
        assert "first": premieres_poursuites_contre_la_caution_le(entity_ref("urn:fr:cc:suretes:c15:K1"), @2023-05-02) { origin case_input; }
        assert "raise": benefice_de_division_invoque_le(entity_ref("urn:fr:cc:suretes:c15:K1"), @2023-05-02) { origin case_input; }
    }
    evaluate positions();
    expect position(PouvoirInvoquerDivision, ACTIVE);
}

