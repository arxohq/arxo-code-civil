language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2300 : créancier non professionnel — l'article ne joue pas, même disproportion retenue.
test "urn:query:fr-code-civil-suretes-c26-disproportion-creancier-non-professionnel" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c26:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c26:K"), entity_ref("urn:fr:cc:suretes:c26:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c26:K"), entity_ref("urn:fr:cc:suretes:c26:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:c26:C")) { origin case_input; }
        assert "f5": mention_manuscrite_apposee(entity_ref("urn:fr:cc:suretes:c26:K")) { origin case_input; }
        assert "f6": montant_en_toutes_lettres(entity_ref("urn:fr:cc:suretes:c26:K"), 10000 EUR) { origin case_input; }
        assert "f7": montant_en_chiffres(entity_ref("urn:fr:cc:suretes:c26:K"), 10000 EUR) { origin case_input; }
        assert "f8": montant_a_hauteur_duquel_la_caution_pouvait_s_engager(entity_ref("urn:fr:cc:suretes:c26:K"), 20000 EUR) { origin adjudicated; }
        assert "f9": cautionnement_manifestement_disproportionne(entity_ref("urn:fr:cc:suretes:c26:K")) { origin adjudicated; }
    }
    evaluate truth(cautionnement_reduit_pour_disproportion(entity_ref("urn:fr:cc:suretes:c26:K"), 20000 EUR));
    expect truth_status == NEITHER;
}
