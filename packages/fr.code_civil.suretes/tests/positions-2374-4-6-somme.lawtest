test "urn:positions:fr-code-civil-suretes-2374-5-excess-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:x23745:S"), entity_ref("urn:fr:cc:suretes:x23745:C"), entity_ref("urn:fr:cc:suretes:x23745:P"), entity_ref("urn:fr:cc:suretes:x23745:B")) { origin case_input; }
        assert "base": assiette_de_la_somme(entity_ref("urn:fr:cc:suretes:x23745:S"), 12000 EUR) { origin case_input; }
        assert "default": defaillance_du_debiteur_garanti(entity_ref("urn:fr:cc:suretes:x23745:S")) { origin case_input; }
        assert "debt": montant_de_la_dette_reelle(entity_ref("urn:fr:cc:suretes:x23745:S"), 10000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirRestituerExcedentSomme, ACTIVE);
}

