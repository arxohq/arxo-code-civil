language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2374-4-interest-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:i23744:S"), entity_ref("urn:fr:cc:suretes:i23744:C"), entity_ref("urn:fr:cc:suretes:i23744:P"), entity_ref("urn:fr:cc:suretes:i23744:B")) { origin case_input; }
        assert "free": libre_disposition_de_la_somme(entity_ref("urn:fr:cc:suretes:i23744:S")) { origin case_input; }
        assert "interest": interet_convenu_au_profit_du_cedant(entity_ref("urn:fr:cc:suretes:i23744:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteConvenirInteretCedant, ACTIVE);
}

