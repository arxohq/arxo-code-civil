    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:y23746:S"), entity_ref("urn:fr:cc:suretes:y23746:C"), entity_ref("urn:fr:cc:suretes:y23746:P"), entity_ref("urn:fr:cc:suretes:y23746:B")) { origin case_input; }
