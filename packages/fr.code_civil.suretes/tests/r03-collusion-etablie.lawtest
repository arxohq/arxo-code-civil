language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2321, al. 2 : collusion établie — le garant n'est pas tenu, sans appréciation de la fraude.
test "urn:query:fr-code-civil-suretes-r03-collusion-etablie" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": garantie_autonome(entity_ref("urn:fr:cc:suretes:r03:G"), entity_ref("urn:fr:cc:suretes:r03:A"), entity_ref("urn:fr:cc:suretes:r03:B")) { origin case_input; }
        assert "f2": appel_de_la_garantie(entity_ref("urn:fr:cc:suretes:r03:G")) { origin case_input; }
        assert "f3": somme_de_la_garantie(entity_ref("urn:fr:cc:suretes:r03:G"), 50000 EUR) { origin case_input; }
        assert "f4": collusion_avec_le_donneur_d_ordre(entity_ref("urn:fr:cc:suretes:r03:G")) { origin adjudicated; }
    }
    evaluate truth(garant_libere_pour_collusion(entity_ref("urn:fr:cc:suretes:r03:G")));
    expect truth_status == TRUE_ONLY;
}
