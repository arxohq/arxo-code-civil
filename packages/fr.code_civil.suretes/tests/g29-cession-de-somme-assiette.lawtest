language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2374-4 : somme affectée de 10 000, fruits 250 — assiette 10 250 EUR.
test "urn:query:fr-code-civil-suretes-g29-cession-de-somme-assiette" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": cession_de_somme_d_argent(entity_ref("urn:fr:cc:suretes:g29:S"), 10000 EUR) { origin case_input; }
        assert "f2": ecrit_etabli(entity_ref("urn:fr:cc:suretes:g29:S")) { origin case_input; }
        assert "f3": ecrit_designe_la_dette_garantie(entity_ref("urn:fr:cc:suretes:g29:S")) { origin case_input; }
        assert "f4": affectation_convenue_de_la_somme(entity_ref("urn:fr:cc:suretes:g29:S")) { origin case_input; }
        assert "f5": fruits_et_interets_de_la_somme(entity_ref("urn:fr:cc:suretes:g29:S"), 250 EUR) { origin case_input; }
    }
    evaluate truth(assiette_de_la_somme(entity_ref("urn:fr:cc:suretes:g29:S"), 10250 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(FruitsAccroissentLAssiette);
}
