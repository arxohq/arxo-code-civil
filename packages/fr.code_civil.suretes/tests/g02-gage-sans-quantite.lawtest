language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2336 : écrit sans la quantité des biens — gage non parfait.
test "urn:query:fr-code-civil-suretes-g02-gage-sans-quantite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_constitue(entity_ref("urn:fr:cc:suretes:g02:S"), entity_ref("urn:fr:cc:suretes:g02:B"), entity_ref("urn:fr:cc:suretes:g02:P")) { origin case_input; }
        assert "f2": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g02:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "f3": ecrit_etabli(entity_ref("urn:fr:cc:suretes:g02:S")) { origin case_input; }
        assert "f4": ecrit_designe_la_dette_garantie(entity_ref("urn:fr:cc:suretes:g02:S")) { origin case_input; }
        assert "f5": ecrit_indique_l_espece_ou_la_nature(entity_ref("urn:fr:cc:suretes:g02:S")) { origin case_input; }
    }
    evaluate truth(gage_parfait(entity_ref("urn:fr:cc:suretes:g02:S")));
    expect truth_status == NEITHER;
}
