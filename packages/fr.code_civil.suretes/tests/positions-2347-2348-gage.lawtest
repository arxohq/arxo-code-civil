test "urn:positions:fr-code-civil-suretes-2347-soulte-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "gage": gage_constitue(entity_ref("urn:fr:cc:suretes:g2347s:S"), entity_ref("urn:fr:cc:suretes:g2347s:C"), entity_ref("urn:fr:cc:suretes:g2347s:P")) { origin case_input; }
        assert "nature": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g2347s:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "unpaid": dette_garantie_impayee(entity_ref("urn:fr:cc:suretes:g2347s:S")) { origin case_input; }
        assert "request": attribution_judiciaire_demandee(entity_ref("urn:fr:cc:suretes:g2347s:S")) { origin case_input; }
        assert "value": valeur_au_jour_du_transfert(entity_ref("urn:fr:cc:suretes:g2347s:S"), 12000 EUR) { origin case_input; }
        assert "debt": montant_de_la_dette_reelle(entity_ref("urn:fr:cc:suretes:g2347s:S"), 10000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirVerserSoulteAuConstituant, ACTIVE);
}

