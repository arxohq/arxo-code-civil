language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2332-4 : gage et bailleur ignorant les autres privilèges, sans date pour le bailleur — même rang, concours : prix 600 pour 400 + 400, 300 EUR chacun.
test "urn:query:fr-code-civil-suretes-p19-gage-au-rang-du-bailleur-qui-ignorait" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:p19:D"), 600 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:p19:G"), entity_ref("urn:fr:cc:suretes:p19:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:p19:G"), GageSansDepossession) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:p19:G"), 400 EUR) { origin case_input; }
        assert "f5": date_de_rang(entity_ref("urn:fr:cc:suretes:p19:G"), @2023-02-01) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:p19:L"), entity_ref("urn:fr:cc:suretes:p19:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:p19:L"), PrivilegeMobilierSpecial) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:p19:L"), 400 EUR) { origin case_input; }
        assert "f9": privilege_special_invoque(entity_ref("urn:fr:cc:suretes:p19:L"), BailleurDImmeuble) { origin case_input; }
    }
    evaluate truth(somme_attribuee(entity_ref("urn:fr:cc:suretes:p19:G"), 300 EUR));
    expect truth_status == TRUE_ONLY;
}
