language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2303 : l'incident du 15 février 2023 n'est pas le premier.
test "urn:query:fr-code-civil-suretes-i21-second-incident-pas-premier" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2023-06-01; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i21:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:i21:K"), entity_ref("urn:fr:cc:suretes:i21:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:i21:K"), entity_ref("urn:fr:cc:suretes:i21:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:i21:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:i21:B")) { origin case_input; }
        assert "f6": echeance_du_principal(entity_ref("urn:fr:cc:suretes:i21:K"), entity_ref("urn:fr:cc:suretes:i21:P1")) { origin case_input; }
        assert "f7": echue_le(entity_ref("urn:fr:cc:suretes:i21:P1"), @2023-01-15) { origin case_input; }
        assert "f8": echeance_impayee(entity_ref("urn:fr:cc:suretes:i21:P1")) { origin case_input; }
        assert "f9": echeance_du_principal(entity_ref("urn:fr:cc:suretes:i21:K"), entity_ref("urn:fr:cc:suretes:i21:P2")) { origin case_input; }
        assert "f10": echue_le(entity_ref("urn:fr:cc:suretes:i21:P2"), @2023-02-15) { origin case_input; }
        assert "f11": echeance_impayee(entity_ref("urn:fr:cc:suretes:i21:P2")) { origin case_input; }
    }
    evaluate truth(premier_incident(entity_ref("urn:fr:cc:suretes:i21:K"), entity_ref("urn:fr:cc:suretes:i21:P2"), @2023-02-15));
    expect truth_status == NEITHER;
}
