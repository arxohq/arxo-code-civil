language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2301 : caution légale devenue insolvable, non remplacée — le débiteur est déchu du terme.
test "urn:query:fr-code-civil-suretes-c53-caution-legale-insolvable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c53:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c53:K"), entity_ref("urn:fr:cc:suretes:c53:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c53:K"), entity_ref("urn:fr:cc:suretes:c53:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c53:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c53:B")) { origin case_input; }
        assert "f6": nature_du_cautionnement(entity_ref("urn:fr:cc:suretes:c53:K"), CautionnementLegal) { origin case_input; }
        assert "f7": caution_devenue_insolvable(entity_ref("urn:fr:cc:suretes:c53:K")) { origin case_input; }
    }
    evaluate truth(decheance_du_terme_ou_perte_de_l_avantage(entity_ref("urn:fr:cc:suretes:c53:K")));
    expect truth_status == TRUE_ONLY;
    expect applied(DecheanceFauteDeSubstitution);
}
