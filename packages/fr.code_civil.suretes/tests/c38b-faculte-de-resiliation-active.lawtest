language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2315 : autre cautionnement de dettes futures à durée indéterminée ;
// la caution personne physique peut y mettre fin à tout moment, dès la
// conclusion du cautionnement.
test "urn:query:fr-code-civil-suretes-c38b-faculte-de-resiliation-active" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c38b:K"), @2023-11-15) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c38b:K"), entity_ref("urn:fr:cc:suretes:c38b:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c38b:K"), entity_ref("urn:fr:cc:suretes:c38b:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c38b:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c38b:B")) { origin case_input; }
        assert "f6": cautionnement_de_dettes_futures(entity_ref("urn:fr:cc:suretes:c38b:K")) { origin case_input; }
    }
    evaluate positions();
    expect position(FaculteDeMettreFinAuCautionnement, ACTIVE);
}

test "urn:query:fr-code-civil-suretes-c38b-faculte-de-resiliation-active-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c38c:K"), @2024-01-15) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c38c:K"), entity_ref("urn:fr:cc:suretes:c38c:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c38c:K"), entity_ref("urn:fr:cc:suretes:c38c:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c38c:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c38c:B")) { origin case_input; }
        assert "f6": cautionnement_de_dettes_futures(entity_ref("urn:fr:cc:suretes:c38c:K")) { origin case_input; }
    }
    evaluate positions();
    expect position(FaculteDeMettreFinAuCautionnement, ACTIVE);
}
