language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2371 : bien repris valant 8 000 pour 6 500 restant dus — 1 500 EUR dus au débiteur.
test "urn:query:fr-code-civil-suretes-g26-reserve-restitution-difference" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": clause_de_reserve_de_propriete(entity_ref("urn:fr:cc:suretes:g26:S"), entity_ref("urn:fr:cc:suretes:g26:X")) { origin case_input; }
        assert "f2": dette_garantie_impayee(entity_ref("urn:fr:cc:suretes:g26:S")) { origin case_input; }
        assert "f3": valeur_au_jour_du_transfert(entity_ref("urn:fr:cc:suretes:g26:S"), 8000 EUR) { origin case_input; }
        assert "f4": creance_restant_due(entity_ref("urn:fr:cc:suretes:g26:S"), 6500 EUR) { origin case_input; }
    }
    evaluate truth(difference_due_au_debiteur(entity_ref("urn:fr:cc:suretes:g26:S"), 1500 EUR));
    expect truth_status == TRUE_ONLY;
    expect applied(DifferenceAuDebiteur);
}
