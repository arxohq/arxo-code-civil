language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2321, al. 2 : fraude manifeste retenue — le garant n'est plus tenu de payer.
test "urn:query:fr-code-civil-suretes-r01c-fraude-retenue-plus-de-paiement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": garantie_autonome(entity_ref("urn:fr:cc:suretes:r01c:G"), entity_ref("urn:fr:cc:suretes:r01c:A"), entity_ref("urn:fr:cc:suretes:r01c:B")) { origin case_input; }
        assert "f2": appel_de_la_garantie(entity_ref("urn:fr:cc:suretes:r01c:G")) { origin case_input; }
        assert "f3": somme_de_la_garantie(entity_ref("urn:fr:cc:suretes:r01c:G"), 50000 EUR) { origin case_input; }
        assert "f4": abus_ou_fraude_manifestes(entity_ref("urn:fr:cc:suretes:r01c:G")) { origin adjudicated; }
    }
    evaluate truth(garant_tenu_de_payer(entity_ref("urn:fr:cc:suretes:r01c:G"), 50000 EUR));
    expect truth_status == NEITHER;
}
