language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2367 : prix intégralement payé — transfert non suspendu.
test "urn:query:fr-code-civil-suretes-g28-reserve-paye-pas-de-suspension" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": clause_de_reserve_de_propriete(entity_ref("urn:fr:cc:suretes:g28:S"), entity_ref("urn:fr:cc:suretes:g28:X")) { origin case_input; }
        assert "f2": prix_integralement_paye(entity_ref("urn:fr:cc:suretes:g28:S")) { origin case_input; }
    }
    evaluate truth(transfert_suspendu(entity_ref("urn:fr:cc:suretes:g28:S"), entity_ref("urn:fr:cc:suretes:g28:X")));
    expect truth_status == NEITHER;
}
