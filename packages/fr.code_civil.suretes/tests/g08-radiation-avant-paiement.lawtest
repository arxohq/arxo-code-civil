language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2339 : dette non entièrement payée — pas de radiation exigible.
test "urn:query:fr-code-civil-suretes-g08-radiation-avant-paiement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_constitue(entity_ref("urn:fr:cc:suretes:g08:S"), entity_ref("urn:fr:cc:suretes:g08:B"), entity_ref("urn:fr:cc:suretes:g08:P")) { origin case_input; }
        assert "f2": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g08:S"), GageDeMeublesCorporels) { origin case_input; }
    }
    evaluate truth(radiation_ou_restitution_exigible(entity_ref("urn:fr:cc:suretes:g08:S")));
    expect truth_status == NEITHER;
}
