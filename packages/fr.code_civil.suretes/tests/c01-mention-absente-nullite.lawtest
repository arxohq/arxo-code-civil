language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2297 : caution personne physique sans mention apposée par elle-même — nullité de son engagement.
test "urn:query:fr-code-civil-suretes-c01-mention-absente-nullite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c01:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c01:K"), entity_ref("urn:fr:cc:suretes:c01:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c01:K"), entity_ref("urn:fr:cc:suretes:c01:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:c01:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c01:B")) { origin case_input; }
    }
    evaluate truth(cautionnement_nul_faute_de_mention(entity_ref("urn:fr:cc:suretes:c01:K")));
    expect truth_status == TRUE_ONLY;
    expect applied(NulliteFauteDeMention);
}
