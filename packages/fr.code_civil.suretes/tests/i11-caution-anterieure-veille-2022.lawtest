language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Ordonnance 2021-1192, art. 37, I et III : le 31 décembre 2021, l'article 2302 nouveau n'est pas encore en vigueur.
test "urn:query:fr-code-civil-suretes-i11-caution-anterieure-veille-2022" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2021-12-31; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i11:K"), @2020-06-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:i11:K"), entity_ref("urn:fr:cc:suretes:i11:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:i11:K"), entity_ref("urn:fr:cc:suretes:i11:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:i11:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:i11:B")) { origin case_input; }
        assert "f6": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:suretes:i11:K"), "2302") { origin case_input; }
    }
    evaluate truth(article_2302_applicable(entity_ref("urn:fr:cc:suretes:i11:K")));
    expect truth_status == NEITHER;
}
