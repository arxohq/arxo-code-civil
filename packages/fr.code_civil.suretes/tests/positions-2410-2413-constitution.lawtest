language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2410-capable-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "mortgage": hypotheque(entity_ref("urn:fr:cc:suretes:h2410:S"), entity_ref("urn:fr:cc:suretes:h2410:C"), entity_ref("urn:fr:cc:suretes:h2410:P")) { origin case_input; }
        assert "kind": hypotheque_d_espece(entity_ref("urn:fr:cc:suretes:h2410:S"), Conventionnelle) { origin case_input; }
        assert "deed": acte_notarie(entity_ref("urn:fr:cc:suretes:h2410:S")) { origin case_input; }
        assert "capacity": constituant_capable_de_disposer(entity_ref("urn:fr:cc:suretes:h2410:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteConstituantCapableHypotheque, ACTIVE);
}

