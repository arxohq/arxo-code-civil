language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2444, II : action le 2 septembre 2024 — forclose.
test "urn:query:fr-code-civil-suretes-d25-responsabilite-forclose" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": faute_du_service_commise_le(entity_ref("urn:fr:cc:suretes:d25:I"), @2014-09-01) { origin case_input; }
        assert "f2": action_en_responsabilite_le(entity_ref("urn:fr:cc:suretes:d25:I"), @2024-09-02) { origin case_input; }
    }
    evaluate truth(action_en_responsabilite_forclose(entity_ref("urn:fr:cc:suretes:d25:I")));
    expect truth_status == TRUE_ONLY;
}
