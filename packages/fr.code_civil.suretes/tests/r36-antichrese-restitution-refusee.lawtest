language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2383 : gage immobilier, dette non entièrement payée — restitution refusée.
test "urn:query:fr-code-civil-suretes-r36-antichrese-restitution-refusee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_immobilier_constitue(entity_ref("urn:fr:cc:suretes:r36:S"), entity_ref("urn:fr:cc:suretes:r36:B"), entity_ref("urn:fr:cc:suretes:r36:P")) { origin case_input; }
    }
    evaluate truth(restitution_de_l_immeuble_refusee(entity_ref("urn:fr:cc:suretes:r36:S")));
    expect truth_status == TRUE_ONLY;
}
