language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2374-somme-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:s2374:S"), entity_ref("urn:fr:cc:suretes:s2374:C"), entity_ref("urn:fr:cc:suretes:s2374:P"), entity_ref("urn:fr:cc:suretes:s2374:B")) { origin case_input; }
        assert "sum": cession_de_somme_d_argent(entity_ref("urn:fr:cc:suretes:s2374:S"), 10000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteCederSommeGarantie, ACTIVE);
}

