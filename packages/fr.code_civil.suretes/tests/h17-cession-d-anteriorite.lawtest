language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2473 : l'hypothèque de 2019 cède son rang à celle de 2020 — celle de 2020 passe au rang 1.
test "urn:query:fr-code-civil-suretes-h17-cession-d-anteriorite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:h17:D"), 1000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:h17:A"), entity_ref("urn:fr:cc:suretes:h17:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:h17:A"), HypothequeConventionnelle) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:h17:A"), 600 EUR) { origin case_input; }
        assert "f5": date_de_rang(entity_ref("urn:fr:cc:suretes:h17:A"), @2019-01-01) { origin case_input; }
        assert "f6": collocation_dans(entity_ref("urn:fr:cc:suretes:h17:B"), entity_ref("urn:fr:cc:suretes:h17:D")) { origin case_input; }
        assert "f7": cause_de_preference(entity_ref("urn:fr:cc:suretes:h17:B"), HypothequeConventionnelle) { origin case_input; }
        assert "f8": creance_en_principal(entity_ref("urn:fr:cc:suretes:h17:B"), 600 EUR) { origin case_input; }
        assert "f9": date_de_rang(entity_ref("urn:fr:cc:suretes:h17:B"), @2020-01-01) { origin case_input; }
        assert "f10": cession_d_anteriorite(entity_ref("urn:fr:cc:suretes:h17:A"), entity_ref("urn:fr:cc:suretes:h17:B")) { origin case_input; }
    }
    evaluate truth(rang_de_la_collocation(entity_ref("urn:fr:cc:suretes:h17:B"), 1));
    expect truth_status == TRUE_ONLY;
    expect applied(DateUtileDuCessionnaire);
}
