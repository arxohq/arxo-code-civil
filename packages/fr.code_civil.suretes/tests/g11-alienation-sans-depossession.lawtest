language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2342 : gage sans dépossession de choses fongibles — le constituant peut aliéner à charge de remplacement.
test "urn:query:fr-code-civil-suretes-g11-alienation-sans-depossession" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_constitue(entity_ref("urn:fr:cc:suretes:g11:S"), entity_ref("urn:fr:cc:suretes:g11:B"), entity_ref("urn:fr:cc:suretes:g11:P")) { origin case_input; }
        assert "f2": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g11:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "f3": choses_fongibles(entity_ref("urn:fr:cc:suretes:g11:S")) { origin case_input; }
    }
    evaluate truth(faculte_d_aliener_a_charge_de_remplacement(entity_ref("urn:fr:cc:suretes:g11:S")));
    expect truth_status == TRUE_ONLY;
    expect applied(AlienationSansDepossession);
}
