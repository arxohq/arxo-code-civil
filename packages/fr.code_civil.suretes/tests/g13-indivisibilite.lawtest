language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2349 : l'héritier qui a payé sa portion ne récupère pas sa part du gage.
test "urn:query:fr-code-civil-suretes-g13-indivisibilite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gage_constitue(entity_ref("urn:fr:cc:suretes:g13:S"), entity_ref("urn:fr:cc:suretes:g13:B"), entity_ref("urn:fr:cc:suretes:g13:P")) { origin case_input; }
        assert "f2": nature_de_la_surete(entity_ref("urn:fr:cc:suretes:g13:S"), GageDeMeublesCorporels) { origin case_input; }
        assert "f3": heritier_ayant_paye_sa_portion(entity_ref("urn:fr:cc:suretes:g13:S"), entity_ref("urn:fr:cc:suretes:g13:H")) { origin case_input; }
    }
    evaluate truth(restitution_partielle_refusee(entity_ref("urn:fr:cc:suretes:g13:S"), entity_ref("urn:fr:cc:suretes:g13:H")));
    expect truth_status == TRUE_ONLY;
}
