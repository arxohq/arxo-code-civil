language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2311 : la caution privée de recours peut agir en restitution contre le créancier.
test "urn:query:fr-code-civil-suretes-c29-action-en-restitution" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c29:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c29:K"), entity_ref("urn:fr:cc:suretes:c29:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c29:K"), entity_ref("urn:fr:cc:suretes:c29:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c29:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c29:B")) { origin case_input; }
        assert "f6": paiement_par_la_caution(entity_ref("urn:fr:cc:suretes:c29:K"), @2023-05-10, 5000 EUR) { origin case_input; }
        assert "f7": paye_sans_avertir_le_debiteur(entity_ref("urn:fr:cc:suretes:c29:K")) { origin case_input; }
        assert "f8": debiteur_pouvait_faire_declarer_la_dette_eteinte(entity_ref("urn:fr:cc:suretes:c29:K")) { origin case_input; }
    }
    evaluate truth(action_en_restitution_contre_le_creancier(entity_ref("urn:fr:cc:suretes:c29:K")));
    expect truth_status == TRUE_ONLY;
    expect applied(ActionEnRestitution);
}
