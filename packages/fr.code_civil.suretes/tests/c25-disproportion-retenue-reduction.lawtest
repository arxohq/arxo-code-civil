language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2300 : disproportion retenue, montant possible fixé à 20 000 — le cautionnement est réduit à 20 000 EUR.
test "urn:query:fr-code-civil-suretes-c25-disproportion-retenue-reduction" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c25:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c25:K"), entity_ref("urn:fr:cc:suretes:c25:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c25:K"), entity_ref("urn:fr:cc:suretes:c25:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:c25:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c25:B")) { origin case_input; }
        assert "f6": mention_manuscrite_apposee(entity_ref("urn:fr:cc:suretes:c25:K")) { origin case_input; }
        assert "f7": montant_en_toutes_lettres(entity_ref("urn:fr:cc:suretes:c25:K"), 10000 EUR) { origin case_input; }
        assert "f8": montant_en_chiffres(entity_ref("urn:fr:cc:suretes:c25:K"), 10000 EUR) { origin case_input; }
        assert "f9": montant_a_hauteur_duquel_la_caution_pouvait_s_engager(entity_ref("urn:fr:cc:suretes:c25:K"), 20000 EUR) { origin adjudicated; }
        assert "f10": cautionnement_manifestement_disproportionne(entity_ref("urn:fr:cc:suretes:c25:K")) { origin adjudicated; }
    }
    evaluate truth(cautionnement_reduit_pour_disproportion(entity_ref("urn:fr:cc:suretes:c25:K"), 20000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect judgment_requests(0);
}
