language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2372-report-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "security": surete_reelle_constituee(entity_ref("urn:fr:cc:suretes:f2372:S"), entity_ref("urn:fr:cc:suretes:f2372:C"), entity_ref("urn:fr:cc:suretes:f2372:P"), entity_ref("urn:fr:cc:suretes:f2372:B")) { origin case_input; }
        assert "clause": clause_de_reserve_de_propriete(entity_ref("urn:fr:cc:suretes:f2372:S"), entity_ref("urn:fr:cc:suretes:f2372:B")) { origin case_input; }
        assert "lost": bien_aliene_ou_perdu(entity_ref("urn:fr:cc:suretes:f2372:S")) { origin case_input; }
        assert "claim": creance_contre_le_sous_acquereur_ou_l_assureur(entity_ref("urn:fr:cc:suretes:f2372:S"), entity_ref("urn:fr:cc:suretes:f2372:Q")) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteReporterPropriete, ACTIVE);
}

