test "urn:positions:fr-code-civil-suretes-2372-4-surplus-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "fiducie": fiducie_surete(entity_ref("urn:fr:cc:suretes:f23724:S"), entity_ref("urn:fr:cc:suretes:f23724:F"), entity_ref("urn:fr:cc:suretes:f23724:C")) { origin case_input; }
        assert "free": libre_disposition_du_fiduciaire_creancier(entity_ref("urn:fr:cc:suretes:f23724:S")) { origin case_input; }
        assert "value": valeur_au_jour_du_transfert(entity_ref("urn:fr:cc:suretes:f23724:S"), 12000 EUR) { origin case_input; }
        assert "debt": montant_de_la_dette_reelle(entity_ref("urn:fr:cc:suretes:f23724:S"), 10000 EUR) { origin case_input; }
        assert "costs": dettes_de_conservation_ou_gestion_payees(entity_ref("urn:fr:cc:suretes:f23724:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(DevoirVerserExcedentFiducie, ACTIVE);
}

