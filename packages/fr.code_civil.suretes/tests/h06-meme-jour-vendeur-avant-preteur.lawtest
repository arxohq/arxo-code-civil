language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2418, al. 2 : même jour, l'hypothèque du vendeur passe avant celle du prêteur de deniers.
test "urn:query:fr-code-civil-suretes-h06-meme-jour-vendeur-avant-preteur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prix_a_distribuer(entity_ref("urn:fr:cc:suretes:h06:D"), 1000 EUR) { origin case_input; }
        assert "f2": collocation_dans(entity_ref("urn:fr:cc:suretes:h06:A"), entity_ref("urn:fr:cc:suretes:h06:D")) { origin case_input; }
        assert "f3": cause_de_preference(entity_ref("urn:fr:cc:suretes:h06:A"), HypothequeLegale) { origin case_input; }
        assert "f4": creance_en_principal(entity_ref("urn:fr:cc:suretes:h06:A"), 600 EUR) { origin case_input; }
        assert "f5": date_de_rang(entity_ref("urn:fr:cc:suretes:h06:A"), @2021-03-01) { origin case_input; }
        assert "f6": collocation_du_preteur_de_deniers(entity_ref("urn:fr:cc:suretes:h06:A")) { origin case_input; }
        assert "f7": collocation_dans(entity_ref("urn:fr:cc:suretes:h06:B"), entity_ref("urn:fr:cc:suretes:h06:D")) { origin case_input; }
        assert "f8": cause_de_preference(entity_ref("urn:fr:cc:suretes:h06:B"), HypothequeLegale) { origin case_input; }
        assert "f9": creance_en_principal(entity_ref("urn:fr:cc:suretes:h06:B"), 600 EUR) { origin case_input; }
        assert "f10": date_de_rang(entity_ref("urn:fr:cc:suretes:h06:B"), @2021-03-01) { origin case_input; }
        assert "f11": collocation_du_vendeur_d_immeuble(entity_ref("urn:fr:cc:suretes:h06:B")) { origin case_input; }
    }
    evaluate truth(rang_de_la_collocation(entity_ref("urn:fr:cc:suretes:h06:A"), 2));
    expect truth_status == TRUE_ONLY;
    expect applied(MemeJourVendeurAvantPreteur);
}
