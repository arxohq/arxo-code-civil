language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2308 : la caution a payé 5 000 le 10 mai 2023 — recours personnel de 5 000, intérêts depuis ce jour.
test "urn:query:fr-code-civil-suretes-c27-recours-personnel" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c27:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c27:K"), entity_ref("urn:fr:cc:suretes:c27:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c27:K"), entity_ref("urn:fr:cc:suretes:c27:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c27:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c27:B")) { origin case_input; }
        assert "f6": paiement_par_la_caution(entity_ref("urn:fr:cc:suretes:c27:K"), @2023-05-10, 5000 EUR) { origin case_input; }
    }
    evaluate truth(interets_du_recours_depuis(entity_ref("urn:fr:cc:suretes:c27:K"), @2023-05-10));
    expect truth_status == TRUE_ONLY;
    expect applied(InteretsDuRecours);
}
