language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2302 : le paiement du débiteur du 15 septembre 2022, dans la période de déchéance, s'impute d'abord sur le principal.
test "urn:query:fr-code-civil-suretes-i09-paiement-impute-sur-le-principal" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2023-05-01; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:i09:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:i09:K"), entity_ref("urn:fr:cc:suretes:i09:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:i09:K"), entity_ref("urn:fr:cc:suretes:i09:B")) { origin case_input; }
        assert "f4": est_personne_physique(entity_ref("urn:fr:cc:suretes:i09:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:i09:B")) { origin case_input; }
        assert "f6": arrete_annuel(entity_ref("urn:fr:cc:suretes:i09:K"), @2022-12-31) { origin case_input; }
        assert "f7": information_annuelle_communiquee_le(entity_ref("urn:fr:cc:suretes:i09:K"), @2022-12-31, @2023-04-10) { origin case_input; }
        assert "f8": rappel_du_terme_ou_de_la_faculte_de_resiliation(entity_ref("urn:fr:cc:suretes:i09:K"), @2022-12-31) { origin case_input; }
        assert "f9": precedente_information_le(entity_ref("urn:fr:cc:suretes:i09:K"), @2022-12-31, @2022-03-01) { origin case_input; }
        assert "f10": paiement_du_debiteur(entity_ref("urn:fr:cc:suretes:i09:K"), entity_ref("urn:fr:cc:suretes:i09:P1")) { origin case_input; }
        assert "f11": paye_le(entity_ref("urn:fr:cc:suretes:i09:P1"), @2022-09-15) { origin case_input; }
    }
    evaluate truth(paiement_impute_d_abord_sur_le_principal(entity_ref("urn:fr:cc:suretes:i09:K"), entity_ref("urn:fr:cc:suretes:i09:P1")));
    expect truth_status == TRUE_ONLY;
    expect applied(Imputation2302);
}
