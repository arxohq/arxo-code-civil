language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2320 : prorogation accordée, terme initial échu — option de la caution et menace présumée.
test "urn:query:fr-code-civil-suretes-c51-prorogation-presomption" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c51:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c51:K"), entity_ref("urn:fr:cc:suretes:c51:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c51:K"), entity_ref("urn:fr:cc:suretes:c51:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c51:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c51:B")) { origin case_input; }
        assert "f6": prorogation_de_terme_accordee(entity_ref("urn:fr:cc:suretes:c51:K")) { origin case_input; }
        assert "f7": terme_initial_echu(entity_ref("urn:fr:cc:suretes:c51:K")) { origin case_input; }
    }
    evaluate truth(menace_sur_le_recouvrement_presumee(entity_ref("urn:fr:cc:suretes:c51:K")));
    expect truth_status == TRUE_ONLY;
}
