language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2286, 3° : créance née de la détention de la chose — droit de rétention.
test "urn:query:fr-code-civil-suretes-r07-retention-par-connexite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": creance_impayee_nee_de_la_detention(entity_ref("urn:fr:cc:suretes:r07:P"), entity_ref("urn:fr:cc:suretes:r07:X")) { origin case_input; }
        assert "f2": detenteur_de_la_chose(entity_ref("urn:fr:cc:suretes:r07:P"), entity_ref("urn:fr:cc:suretes:r07:X")) { origin case_input; }
    }
    evaluate truth(droit_de_retention(entity_ref("urn:fr:cc:suretes:r07:P"), entity_ref("urn:fr:cc:suretes:r07:X")));
    expect truth_status == TRUE_ONLY;
    expect applied(RetentionConnexiteMaterielle);
}
