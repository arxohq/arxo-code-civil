language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

test "urn:positions:fr-code-civil-suretes-2429-date-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SURETES_MOIS_AN; }
        assert "registration": inscription_de(entity_ref("urn:fr:cc:suretes:p2429a:I"), entity_ref("urn:fr:cc:suretes:p2429a:S")) { origin case_input; }
        assert "filed": inscription_prise_le(entity_ref("urn:fr:cc:suretes:p2429a:I"), @2020-05-15) { origin case_input; }
        assert "maturity": derniere_echeance_de_la_creance(entity_ref("urn:fr:cc:suretes:p2429a:I"), entity_ref("urn:fr:cc:suretes:p2429a:C"), @2040-05-15) { origin case_input; }
        assert "creditor": creancier_de_l_inscription(entity_ref("urn:fr:cc:suretes:p2429a:I"), entity_ref("urn:fr:cc:suretes:p2429a:P")) { origin case_input; }
        assert "requested": date_d_effet_requise(entity_ref("urn:fr:cc:suretes:p2429a:I"), @2041-05-15) { origin case_input; }
    }
    evaluate positions();
    expect position(LiberteFixerDateEffet, ACTIVE);
}

