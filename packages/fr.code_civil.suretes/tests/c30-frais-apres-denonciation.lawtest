language "law.core" version "0.2";
package fr.code_civil.suretes version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-suretes";

// Art. 2308 : seuls les frais postérieurs à la dénonciation (1er mars) sont restituables — ceux du 15 mars.
test "urn:query:fr-code-civil-suretes-c30-frais-apres-denonciation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fr.code_civil.transitions::cautionnement_conclu_le(entity_ref("urn:fr:cc:suretes:c30:K"), @2022-03-01) { origin case_input; }
        assert "f2": caution(entity_ref("urn:fr:cc:suretes:c30:K"), entity_ref("urn:fr:cc:suretes:c30:C")) { origin case_input; }
        assert "f3": creancier_du_cautionnement(entity_ref("urn:fr:cc:suretes:c30:K"), entity_ref("urn:fr:cc:suretes:c30:B")) { origin case_input; }
        assert "f4": est_personne_morale(entity_ref("urn:fr:cc:suretes:c30:C")) { origin case_input; }
        assert "f5": creancier_professionnel(entity_ref("urn:fr:cc:suretes:c30:B")) { origin case_input; }
        assert "f6": paiement_par_la_caution(entity_ref("urn:fr:cc:suretes:c30:K"), @2023-05-10, 5000 EUR) { origin case_input; }
        assert "f7": denonciation_des_poursuites_au_debiteur_le(entity_ref("urn:fr:cc:suretes:c30:K"), @2023-03-01) { origin case_input; }
        assert "f8": frais_de_la_caution(entity_ref("urn:fr:cc:suretes:c30:K"), @2023-02-10, 300 EUR) { origin case_input; }
        assert "f9": frais_de_la_caution(entity_ref("urn:fr:cc:suretes:c30:K"), @2023-03-15, 200 EUR) { origin case_input; }
    }
    evaluate truth(frais_restituables(entity_ref("urn:fr:cc:suretes:c30:K"), @2023-02-10, 300 EUR));
    expect truth_status == NEITHER;
}
