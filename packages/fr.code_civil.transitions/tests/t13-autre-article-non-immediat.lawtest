language "law.core" version "0.2";
package fr.code_civil.transitions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-transitions";

// Ordonnance 2021-1192 art. 37 III : l article 2288 n est pas dans la liste d application immédiate.
test "urn:query:fr-code-civil-transitions-t13-autre-article-non-immediat" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": cautionnement_conclu_le(entity_ref("urn:fr:cc:transitions:c21"), @2019-03-01) { origin case_input; }
        assert "f2": article_invoque(entity_ref("urn:fr:cc:transitions:c21"), "2288") { origin case_input; }
    }
    evaluate truth(applicable_des_l_entree_en_vigueur_2021(entity_ref("urn:fr:cc:transitions:c21"), "2288"));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
