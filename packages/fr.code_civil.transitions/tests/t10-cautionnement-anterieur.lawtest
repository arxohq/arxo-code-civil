language "law.core" version "0.2";
package fr.code_civil.transitions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-transitions";

// Ordonnance 2021-1192 art. 37 II : cautionnement du 31 décembre 2021 → loi ancienne.
test "urn:query:fr-code-civil-transitions-t10-cautionnement-anterieur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": cautionnement_conclu_le(entity_ref("urn:fr:cc:transitions:c21"), @2021-12-31) { origin case_input; }
    }
    evaluate truth(loi_applicable_au_cautionnement(entity_ref("urn:fr:cc:transitions:c21"), LoiAncienne));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CautionnementAnterieurSoumisALaLoiAncienne);
}
