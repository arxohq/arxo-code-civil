language "law.core" version "0.2";
package fr.code_civil.transitions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-transitions";

// Loi 2006-728 art. 47 II al. 2 : instance introduite avant l entrée en vigueur → loi ancienne.
test "urn:query:fr-code-civil-transitions-t18-instance-anterieure-2006" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": instance_introduite_le(entity_ref("urn:fr:cc:transitions:c06"), @2006-11-01) { origin case_input; }
    }
    evaluate truth(instance_anterieure_a_la_reforme_2006(entity_ref("urn:fr:cc:transitions:c06")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
