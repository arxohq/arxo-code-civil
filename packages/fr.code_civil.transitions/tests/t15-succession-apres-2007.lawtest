language "law.core" version "0.2";
package fr.code_civil.transitions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-transitions";

// Loi 2006-728 art. 47 : succession ouverte le 1er janvier 2007 → loi nouvelle, même si des libéralités sont antérieures.
test "urn:query:fr-code-civil-transitions-t15-succession-apres-2007" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": succession_ouverte_le(entity_ref("urn:fr:cc:transitions:c06"), @2007-01-01) { origin case_input; }
    }
    evaluate truth(loi_applicable_a_la_succession(entity_ref("urn:fr:cc:transitions:c06"), LoiNouvelle));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(SuccessionOuverteApresLaReforme);
}
