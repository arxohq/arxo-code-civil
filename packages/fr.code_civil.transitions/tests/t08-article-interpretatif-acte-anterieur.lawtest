language "law.core" version "0.2";
package fr.code_civil.transitions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-transitions";

// Loi 2018-287 art. 16 I : article 1112 interprétatif → la rédaction ratifiée vaut pour l acte de 2017.
test "urn:query:fr-code-civil-transitions-t08-article-interpretatif-acte-anterieur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:transitions:c18"), @2017-05-01) { origin case_input; }
        assert "f2": article_invoque(entity_ref("urn:fr:cc:transitions:c18"), "1112") { origin case_input; }
    }
    evaluate truth(loi_applicable_a_l_article_2018(entity_ref("urn:fr:cc:transitions:c18"), "1112", LoiNouvelle));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ArticleInterpretatifVautPourLActeAnterieur);
}
