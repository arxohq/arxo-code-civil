// BEGIN GENERATED FRAGMENTS

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART515_14")
pub fragment CC_ART515_14 in CC_COURANT {
    label fr official "Article 515-14";
    kind article;
    locator "article/515-14";
    text fr official """Article 515-14
Les animaux sont des êtres vivants doués de sensibilité. Sous réserve des lois qui les protègent, les animaux sont soumis au régime des biens.
""";
    content_hash "sha256:b303f0903847761cb181c48bcd6855192a32592439be5fb4dea9bc27aa521abf";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART516")
pub fragment CC_ART516 in CC_COURANT {
    label fr official "Article 516";
    kind article;
    locator "article/516";
    text fr official """Article 516
Tous les biens sont meubles ou immeubles.
""";
    content_hash "sha256:9270a3d43b1e2b45942fa8e38825f8deef4bc43dcb297b2db60bee106fa92019";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART517")
pub fragment CC_ART517 in CC_COURANT {
    label fr official "Article 517";
    kind article;
    locator "article/517";
    text fr official """Article 517
Les biens sont immeubles, ou par leur nature, ou par leur destination, ou par l'objet auquel ils s'appliquent.
""";
    content_hash "sha256:6a02bce8ab2552368622c4447d40da2850b77369f210a757728e7a0e2b6b60da";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART518")
pub fragment CC_ART518 in CC_COURANT {
    label fr official "Article 518";
    kind article;
    locator "article/518";
    text fr official """Article 518
Les fonds de terre et les bâtiments sont immeubles par leur nature.
""";
    content_hash "sha256:c13863a60e55dade0db7bfed9758b75628f880de59057f4e36080aee9ecbe720";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART519")
pub fragment CC_ART519 in CC_COURANT {
    label fr official "Article 519";
    kind article;
    locator "article/519";
    text fr official """Article 519
Les moulins à vent ou à eau, fixés sur piliers et faisant partie du bâtiment, sont aussi immeubles par leur nature.
""";
    content_hash "sha256:38d77142fe9607b478e9f7561328dafd740517ba6dd358590222ccfc7949fd28";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART520")
pub fragment CC_ART520 in CC_COURANT {
    label fr official "Article 520";
    kind article;
    locator "article/520";
    text fr official """Article 520
Les récoltes pendantes par les racines et les fruits des arbres non encore recueillis sont pareillement immeubles.
Dès que les grains sont coupés et les fruits détachés, quoique non enlevés, ils sont meubles.
Si une partie seulement de la récolte est coupée, cette partie seule est meuble.
""";
    content_hash "sha256:0cdf36438fc785f52d1733a0be1dbfd740ff8ec710b87f3e8e69f18e29563ae5";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART521")
pub fragment CC_ART521 in CC_COURANT {
    label fr official "Article 521";
    kind article;
    locator "article/521";
    text fr official """Article 521
Les coupes ordinaires des bois taillis ou de futaies mises en coupes réglées ne deviennent meubles qu'au fur et à mesure que les arbres sont abattus.
""";
    content_hash "sha256:2d6fd272871505bdc916cb570a3529263d11226d21768df44c80492db8ef387d";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART522")
pub fragment CC_ART522 in CC_COURANT {
    label fr official "Article 522";
    kind article;
    locator "article/522";
    text fr official """Article 522
Les animaux que le propriétaire du fonds livre au fermier ou au métayer pour la culture, estimés ou non, sont soumis au régime des immeubles tant qu'ils demeurent attachés au fonds par l'effet de la convention.
Ceux qu'il donne à cheptel à d'autres qu'au fermier ou métayer sont soumis au régime des meubles.
""";
    content_hash "sha256:f5e422ece96f0623df05e69eae0956beb0d05c20533f6fbe6ddef1f40df0e573";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART523")
pub fragment CC_ART523 in CC_COURANT {
    label fr official "Article 523";
    kind article;
    locator "article/523";
    text fr official """Article 523
Les tuyaux servant à la conduite des eaux dans une maison ou autre héritage sont immeubles et font partie du fonds auquel ils sont attachés.
""";
    content_hash "sha256:fba6c2e13d111a059bcc6e8ee537ee4262386f2810075972f16116360b7f406f";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART524")
pub fragment CC_ART524 in CC_COURANT {
    label fr official "Article 524";
    kind article;
    locator "article/524";
    text fr official """Article 524
Les objets que le propriétaire d'un fonds y a placés pour le service et l'exploitation de ce fonds sont immeubles par destination.
Les animaux que le propriétaire d'un fonds y a placés aux mêmes fins sont soumis au régime des immeubles par destination.
Ainsi, sont immeubles par destination, quand ils ont été placés par le propriétaire pour le service et l'exploitation du fonds :
Les ustensiles aratoires ;
Les semences données aux fermiers ou métayers ;
Les ruches à miel ;
Les pressoirs, chaudières, alambics, cuves et tonnes ;
Les ustensiles nécessaires à l'exploitation des forges, papeteries et autres usines ;
Les pailles et engrais.
Sont aussi immeubles par destination tous effets mobiliers que le propriétaire a attachés au fonds à perpétuelle demeure.
""";
    content_hash "sha256:389e6f979c221381e74ccaf3246bd837e2affd6d18759019eccfb26883d2a7d0";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART525")
pub fragment CC_ART525 in CC_COURANT {
    label fr official "Article 525";
    kind article;
    locator "article/525";
    text fr official """Article 525
Le propriétaire est censé avoir attaché à son fonds des effets mobiliers à perpétuelle demeure, quand ils y sont scellés en plâtre ou à chaux ou à ciment, ou, lorsqu'ils ne peuvent être détachés sans être fracturés ou détériorés, ou sans briser ou détériorer la partie du fonds à laquelle ils sont attachés.
Les glaces d'un appartement sont censées mises à perpétuelle demeure lorsque le parquet sur lequel elles sont attachées fait corps avec la boiserie.
Il en est de même des tableaux et autres ornements.
Quant aux statues, elles sont immeubles lorsqu'elles sont placées dans une niche pratiquée exprès pour les recevoir, encore qu'elles puissent être enlevées sans fracture ou détérioration.
""";
    content_hash "sha256:c9ec56f064b4a5ef98f4404c5e336ce76214eeaaf91d7535dc960d2398807c39";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART526")
pub fragment CC_ART526 in CC_COURANT {
    label fr official "Article 526";
    kind article;
    locator "article/526";
    text fr official """Article 526
Sont immeubles, par l'objet auquel ils s'appliquent :
L'usufruit des choses immobilières ;
Les servitudes ou services fonciers ;
Les actions qui tendent à revendiquer un immeuble.
""";
    content_hash "sha256:7a156716a5831f8abbeafb921fd32e2406b834ebe2bcef00a5ff00b77d76e3dd";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART527")
pub fragment CC_ART527 in CC_COURANT {
    label fr official "Article 527";
    kind article;
    locator "article/527";
    text fr official """Article 527
Les biens sont meubles par leur nature ou par la détermination de la loi.
""";
    content_hash "sha256:9e7b6f8fff2d194fd240933b97387edbf87a7e839e689dc6145a1f553cbdf712";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART528")
pub fragment CC_ART528 in CC_COURANT {
    label fr official "Article 528";
    kind article;
    locator "article/528";
    text fr official """Article 528
Sont meubles par leur nature les biens qui peuvent se transporter d'un lieu à un autre.
""";
    content_hash "sha256:3ab3c88492b916b5715a8598bc64ea3f82c2432e60780f4600399f7d3b2493c2";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART529")
pub fragment CC_ART529 in CC_COURANT {
    label fr official "Article 529";
    kind article;
    locator "article/529";
    text fr official """Article 529
Sont meubles par la détermination de la loi les obligations et actions qui ont pour objet des sommes exigibles ou des effets mobiliers, les actions ou intérêts dans les compagnies de finance, de commerce ou d'industrie, encore que des immeubles dépendant de ces entreprises appartiennent aux compagnies. Ces actions ou intérêts sont réputés meubles à l'égard de chaque associé seulement, tant que dure la société.
Sont aussi meubles par la détermination de la loi les rentes perpétuelles ou viagères, soit sur l'Etat, soit sur des particuliers.
""";
    content_hash "sha256:71f4ef0bf32827a640ae05126a621c8c9a89495da79a160bd077a5883b3cc99f";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART530")
pub fragment CC_ART530 in CC_COURANT {
    label fr official "Article 530";
    kind article;
    locator "article/530";
    text fr official """Article 530
Toute rente établie à perpétuité pour le prix de la vente d'un immeuble, ou comme condition de la cession à titre onéreux ou gratuit d'un fonds immobilier, est essentiellement rachetable.
Il est néanmoins permis au créancier de régler les clauses et conditions du rachat.
Il lui est aussi permis de stipuler que la rente ne pourra lui être remboursée qu'après un certain terme, lequel ne peut jamais excéder trente ans ; toute stipulation contraire est nulle.
""";
    content_hash "sha256:f7eac3ae4cbe163924443abcbe0606c63f3eadc4c20594518a3bb3bad01f7545";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART531")
pub fragment CC_ART531 in CC_COURANT {
    label fr official "Article 531";
    kind article;
    locator "article/531";
    text fr official """Article 531
Les bateaux, bacs, navires, moulins et bains sur bateaux, et généralement toutes usines non fixées par des piliers, et ne faisant point partie de la maison, sont meubles : la saisie de quelques-uns de ces objets peut cependant, à cause de leur importance, être soumises à des formes particulières, ainsi qu'il sera expliqué dans le code de la procédure civile.
""";
    content_hash "sha256:a034b451fd467f8bc6be9883c637da20152d5f3a71676c6e596cd34b118ff936";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART532")
pub fragment CC_ART532 in CC_COURANT {
    label fr official "Article 532";
    kind article;
    locator "article/532";
    text fr official """Article 532
Les matériaux provenant de la démolition d'un édifice, ceux assemblés pour en construire un nouveau, sont meubles jusqu'à ce qu'ils soient employés par l'ouvrier dans une construction.
""";
    content_hash "sha256:25d7bef6d16b354725036703241dfd6d1a2da878f9662af939299444494a5c73";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART533")
pub fragment CC_ART533 in CC_COURANT {
    label fr official "Article 533";
    kind article;
    locator "article/533";
    text fr official """Article 533
Le mot " meuble ", employé seul dans les dispositions de la loi ou de l'homme, sans autre addition ni désignation, ne comprend pas l'argent comptant, les pierreries, les dettes actives, les livres, les médailles, les instruments des sciences, des arts et métiers, le linge de corps, les équipages, armes, grains, vins, foins et autres denrées ; il ne comprend pas aussi ce qui fait l'objet d'un commerce.
""";
    content_hash "sha256:700087b4ee44d807989d15d323ddec575a0a18ebee59d4c6a4b6f3ce5f673195";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART534")
pub fragment CC_ART534 in CC_COURANT {
    label fr official "Article 534";
    kind article;
    locator "article/534";
    text fr official """Article 534
Les mots "meubles meublants" ne comprennent que les meubles destinés à l'usage et à l'ornement des appartements, comme tapisseries, lits, sièges, glaces, pendules, tables, porcelaines et autres objets de cette nature.
Les tableaux et les statues qui font partie du meuble d'un appartement y sont aussi compris, mais non les collections de tableaux qui peuvent être dans les galeries ou pièces particulières.
Il en est de même des porcelaines : celles seulement qui font partie de la décoration d'un appartement sont comprises sous la dénomination de "meubles meublants".
""";
    content_hash "sha256:cca456f0db420c4b89e32da2950900a3a3711e11baca1054495de73883182949";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART535")
pub fragment CC_ART535 in CC_COURANT {
    label fr official "Article 535";
    kind article;
    locator "article/535";
    text fr official """Article 535
L'expression " biens meubles ", celle de " mobilier ou d'effets mobiliers ", comprennent généralement tout ce qui est censé meuble d'après les règles ci-dessus établies. La vente ou le don d'une maison meublée ne comprend que les meubles meublants.
""";
    content_hash "sha256:58bf05bb1076bc77a06b6c266376de5ccc710245dacc6fbaf8801a5b14bc8208";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART536")
pub fragment CC_ART536 in CC_COURANT {
    label fr official "Article 536";
    kind article;
    locator "article/536";
    text fr official """Article 536
La vente ou le don d'une maison, avec tout ce qui s'y trouve, ne comprend pas l'argent comptant, ni les dettes actives et autres droits dont les titres peuvent être déposés dans la maison ; tous les autres effets mobiliers y sont compris.
""";
    content_hash "sha256:69a241ee07e8db29079df0d104358e6eb0a653c2ff42a3c3ca276c1af70ca709";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART537")
pub fragment CC_ART537 in CC_COURANT {
    label fr official "Article 537";
    kind article;
    locator "article/537";
    text fr official """Article 537
Les particuliers ont la libre disposition des biens qui leur appartiennent, sous les modifications établies par les lois.
Les biens qui n'appartiennent pas à des particuliers sont administrés et ne peuvent être aliénés que dans les formes et suivant les règles qui leur sont particulières.
""";
    content_hash "sha256:c13889c43eaa2ae26465366adc24681556ee712a850fe2917e33aea5aa4973ad";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART539")
pub fragment CC_ART539 in CC_COURANT {
    label fr official "Article 539";
    kind article;
    locator "article/539";
    text fr official """Article 539
Les biens des personnes qui décèdent sans héritiers ou dont les successions sont abandonnées appartiennent à l'Etat.
""";
    content_hash "sha256:beedc7d9d5e11541d10dea2c52ee86a82a152588106416b68f1baf5419c15161";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART542")
pub fragment CC_ART542 in CC_COURANT {
    label fr official "Article 542";
    kind article;
    locator "article/542";
    text fr official """Article 542
Les biens communaux sont ceux à la propriété ou au produit desquels les habitants d'une ou plusieurs communes ont un droit acquis.
""";
    content_hash "sha256:8db0e5c1041e761638a9d6ed28c29656d190f3d82d44cf0128fbf3e383ced6dc";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART543")
pub fragment CC_ART543 in CC_COURANT {
    label fr official "Article 543";
    kind article;
    locator "article/543";
    text fr official """Article 543
On peut avoir sur les biens, ou un droit de propriété, ou un simple droit de jouissance, ou seulement des services fonciers à prétendre.
""";
    content_hash "sha256:99d3533f75fac2fc5bc6da53abe382bbe7a7dcef5f99b0252cdb1d361178fea0";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART544")
pub fragment CC_ART544 in CC_COURANT {
    label fr official "Article 544";
    kind article;
    locator "article/544";
    text fr official """Article 544
La propriété est le droit de jouir et disposer des choses de la manière la plus absolue, pourvu qu'on n'en fasse pas un usage prohibé par les lois ou par les règlements.
""";
    content_hash "sha256:f71bc8b0200b401fa1a9b3996669bc5de8efcf0e2571c42f0abac73256ce1e11";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART545")
pub fragment CC_ART545 in CC_COURANT {
    label fr official "Article 545";
    kind article;
    locator "article/545";
    text fr official """Article 545
Nul ne peut être contraint de céder sa propriété, si ce n'est pour cause d'utilité publique, et moyennant une juste et préalable indemnité.
""";
    content_hash "sha256:9913e6e7853c247e49d3ccc854d81d5d1f8fd504baad619aa3fc36376162b44c";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART546")
pub fragment CC_ART546 in CC_COURANT {
    label fr official "Article 546";
    kind article;
    locator "article/546";
    text fr official """Article 546
La propriété d'une chose soit mobilière, soit immobilière, donne droit sur tout ce qu'elle produit, et sur ce qui s'y unit accessoirement soit naturellement, soit artificiellement.
Ce droit s'appelle "droit d'accession".
""";
    content_hash "sha256:f8a049556763d64a6b99d06770612470d7d9dd88842ce169a027c4056aef94fc";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART547")
pub fragment CC_ART547 in CC_COURANT {
    label fr official "Article 547";
    kind article;
    locator "article/547";
    text fr official """Article 547
Les fruits naturels ou industriels de la terre,
Les fruits civils,
Le croît des animaux, appartiennent au propriétaire par droit d'accession.
""";
    content_hash "sha256:95dcb5fd08bbbb9336ec1e80ccea28f8ce5ddb1d518c181ae19f359dadb151ac";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART548")
pub fragment CC_ART548 in CC_COURANT {
    label fr official "Article 548";
    kind article;
    locator "article/548";
    text fr official """Article 548
Les fruits produits par la chose n'appartiennent au propriétaire qu'à la charge de rembourser les frais des labours, travaux et semences faits par des tiers et dont la valeur est estimée à la date du remboursement.
""";
    content_hash "sha256:e43160dc5fdc80601a444a9762d632e5fc528700e9db4c60cf30eee4edafbfe1";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART549")
pub fragment CC_ART549 in CC_COURANT {
    label fr official "Article 549";
    kind article;
    locator "article/549";
    text fr official """Article 549
Le simple possesseur ne fait les fruits siens que dans le cas où il possède de bonne foi. Dans le cas contraire, il est tenu de restituer les produits avec la chose au propriétaire qui la revendique ; si lesdits produits ne se retrouvent pas en nature, leur valeur est estimée à la date du remboursement.
""";
    content_hash "sha256:fc2c2e2e894cf7e8ad6b988cef0c9882c71548b0acf617bd5ee0cb54fe462014";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART550")
pub fragment CC_ART550 in CC_COURANT {
    label fr official "Article 550";
    kind article;
    locator "article/550";
    text fr official """Article 550
Le possesseur est de bonne foi quand il possède comme propriétaire, en vertu d'un titre translatif de propriété dont il ignore les vices.
Il cesse d'être de bonne foi du moment où ces vices lui sont connus.
""";
    content_hash "sha256:ebfeafc819e8d3fd64612a74e6d2afb70da02a1d3b0e22f3faeef02ff34f7068";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART551")
pub fragment CC_ART551 in CC_COURANT {
    label fr official "Article 551";
    kind article;
    locator "article/551";
    text fr official """Article 551
Tout ce qui s'unit et s'incorpore à la chose appartient au propriétaire, suivant les règles qui seront ci-après établies.
""";
    content_hash "sha256:5bb6d01a4238245f8ac346be0e0a61e7249e215d5b9795ccbd9b77fc4d359fe4";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART552")
pub fragment CC_ART552 in CC_COURANT {
    label fr official "Article 552";
    kind article;
    locator "article/552";
    text fr official """Article 552
La propriété du sol emporte la propriété du dessus et du dessous.
Le propriétaire peut faire au-dessus toutes les plantations et constructions qu'il juge à propos, sauf les exceptions établies au titre " Des servitudes ou services fonciers ".
Il peut faire au-dessous toutes les constructions et fouilles qu'il jugera à propos, et tirer de ces fouilles tous les produits qu'elles peuvent fournir, sauf les modifications résultant des lois et règlements relatifs aux mines, et des lois et règlements de police.
""";
    content_hash "sha256:d243ea79d227c7b4d7a94396faad065c629dbb9a2e1835c91c2fe5a173cbb2a9";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART553")
pub fragment CC_ART553 in CC_COURANT {
    label fr official "Article 553";
    kind article;
    locator "article/553";
    text fr official """Article 553
Toutes constructions, plantations et ouvrages sur un terrain ou dans l'intérieur sont présumés faits par le propriétaire à ses frais et lui appartenir, si le contraire n'est prouvé ; sans préjudice de la propriété qu'un tiers pourrait avoir acquise ou pourrait acquérir par prescription soit d'un souterrain sous le bâtiment d'autrui, soit de toute autre partie du bâtiment.
""";
    content_hash "sha256:ce1d0ac820a1a94c79476af4c20477e3c2def609f08453eeb5a79b669055a2b8";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART554")
pub fragment CC_ART554 in CC_COURANT {
    label fr official "Article 554";
    kind article;
    locator "article/554";
    text fr official """Article 554
Le propriétaire du sol qui a fait des constructions, plantations et ouvrages avec des matériaux qui ne lui appartenaient pas doit en payer la valeur estimée à la date du paiement ; il peut aussi être condamné à des dommages-intérêts, s'il ya lieu : mais le propriétaire des matériaux n'a pas le droit de les enlever.
""";
    content_hash "sha256:ecacadee6f0c53b24fd711d61d4a373e239ecaa0e0e9879113faf10bfb87d10e";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART555")
pub fragment CC_ART555 in CC_COURANT {
    label fr official "Article 555";
    kind article;
    locator "article/555";
    text fr official """Article 555
Lorsque les plantations, constructions et ouvrages ont été faits par un tiers et avec des matériaux appartenant à ce dernier, le propriétaire du fonds a le droit, sous réserve des dispositions de l'alinéa 4, soit d'en conserver la propriété, soit d'obliger le tiers à les enlever.
Si le propriétaire du fonds exige la suppression des constructions, plantations et ouvrages, elle est exécutée aux frais du tiers, sans aucune indemnité pour lui ; le tiers peut, en outre, être condamné à des dommages-intérêts pour le préjudice éventuellement subi par le propriétaire du fonds.
Si le propriétaire du fonds préfère conserver la propriété des constructions, plantations et ouvrages, il doit, à son choix, rembourser au tiers, soit une somme égale à celle dont le fonds a augmenté de valeur, soit le coût des matériaux et le prix de la main-d'oeuvre estimés à la date du remboursement, compte tenu de l'état dans lequel se trouvent lesdites constructions, plantations et ouvrages.
Si les plantations, constructions et ouvrages ont été faits par un tiers évincé qui n'aurait pas été condamné, en raison de sa bonne foi, à la restitution des fruits, le propriétaire ne pourra exiger la suppression desdits ouvrages, constructions et plantations, mais il aura le choix de rembourser au tiers l'une ou l'autre des sommes visées à l'alinéa précédent.
""";
    content_hash "sha256:9e133072e5380705c6259c35787f9ba3f2c8760075df0e131d215082e25a8a05";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART556")
pub fragment CC_ART556 in CC_COURANT {
    label fr official "Article 556";
    kind article;
    locator "article/556";
    text fr official """Article 556
Les atterrissements et accroissements qui se forment successivement et imperceptiblement aux fonds riverains d'un cours d'eau s'appellent " alluvion ".
L'alluvion profite au propriétaire riverain, qu'il s'agisse d'un cours d'eau domanial ou non ; à la charge, dans le premier cas, de laisser le marchepied ou chemin de halage, conformément aux règlements.
""";
    content_hash "sha256:72e9454962c9c6eb413d94fc61ad6ba827af8de7a14063841ea03da1c09ea52f";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART557")
pub fragment CC_ART557 in CC_COURANT {
    label fr official "Article 557";
    kind article;
    locator "article/557";
    text fr official """Article 557
Il en est de même des relais que forme l'eau courante qui se retire insensiblement de l'une de ses rives en se portant sur l'autre : le propriétaire de la rive découverte profite de l'alluvion, sans que le riverain du côté opposé y puisse venir réclamer le terrain qu'il a perdu.
Ce droit n'a pas lieu à l'égard des relais de la mer.
""";
    content_hash "sha256:cc523d9901cba2984f6bdcfd90bdaefe8b696fdca1b6442bf331caf299145b55";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART558")
pub fragment CC_ART558 in CC_COURANT {
    label fr official "Article 558";
    kind article;
    locator "article/558";
    text fr official """Article 558
L'alluvion n'a pas lieu à l'égard des lacs et étangs, dont le propriétaire conserve toujours le terrain que l'eau couvre quand elle est à la hauteur de la décharge de l'étang, encore que le volume de l'eau vienne à diminuer.
Réciproquement, le propriétaire de l'étang n'acquiert aucun droit sur les terres riveraines que son eau vient à couvrir dans des crues extraordinaires.
""";
    content_hash "sha256:f351d2cabe6506153a70b7e9c23930c2ef4ac921698738dc2f7ec1b2755235a6";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART559")
pub fragment CC_ART559 in CC_COURANT {
    label fr official "Article 559";
    kind article;
    locator "article/559";
    text fr official """Article 559
Si un cours d'eau, domanial ou non, enlève par une force subite une partie considérable et reconnaissable d'un champ riverain, et la porte vers un champ inférieur ou sur la rive opposée, le propriétaire de la partie enlevée peut réclamer sa propriété ; mais il est tenu de former sa demande dans l'année : après ce délai, il n'y sera plus recevable, à moins que le propriétaire du champ auquel la partie enlevée a été unie, n'eût pas encore pris possession de celle-ci.
""";
    content_hash "sha256:f37694e6b97ebebf81cd664fad2cbaa8fb5a896486ae66eba8bc35e66112fe70";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART560")
pub fragment CC_ART560 in CC_COURANT {
    label fr official "Article 560";
    kind article;
    locator "article/560";
    text fr official """Article 560
Les îles, îlots, atterrissements, qui se forment dans le lit des cours d'eau domaniaux, appartiennent à la personne publique propriétaire du domaine concerné, en l'absence de titre ou de prescription contraire.
""";
    content_hash "sha256:71a11c2d7806834774749e12cc2f8129a55dc26cdf097f6582844f00a62b78e0";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART561")
pub fragment CC_ART561 in CC_COURANT {
    label fr official "Article 561";
    kind article;
    locator "article/561";
    text fr official """Article 561
Les îles et atterrissements qui se forment dans les cours d'eau non domaniaux, appartiennent aux propriétaires riverains du côté où l'île s'est formée : si l'île n'est pas formée d'un seul côté, elle appartient aux propriétaires riverains des deux côtés, à partir de la ligne qu'on suppose tracée au milieu du cours d'eau.
""";
    content_hash "sha256:3dd447d96891488cb762143327a3df82dc9e5b32e73f227380b788630a5877f9";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART562")
pub fragment CC_ART562 in CC_COURANT {
    label fr official "Article 562";
    kind article;
    locator "article/562";
    text fr official """Article 562
Si un cours d'eau, en se formant un bras nouveau, coupe et embrasse le champ d'un propriétaire riverain, et en fait une île, ce propriétaire conserve la propriété de son champ, encore que l'île se soit formée dans un cours d'eau domanial.
""";
    content_hash "sha256:49c66bcec0a894793b6f4d2e30c97585fd11d1df7df1b9a8f287f1b302f91ea5";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART563")
pub fragment CC_ART563 in CC_COURANT {
    label fr official "Article 563";
    kind article;
    locator "article/563";
    text fr official """Article 563
Si un cours d'eau domanial forme un nouveau cours en abandonnant son ancien lit, les propriétaires riverains peuvent acquérir la propriété de cet ancien lit, chacun en droit soi, jusqu'à une ligne qu'on suppose tracée au milieu du cours d'eau. Le prix de l'ancien lit est fixé par des experts nommés par le président du tribunal de la situation des lieux, à la requête de l'autorité compétente.
A défaut par les propriétaires riverains de déclarer, dans les trois mois de la notification qui leur sera faite par l'autorité compétente, l'intention de faire l'acquisition aux prix fixés par les experts, il est procédé à l'aliénation de l'ancien lit selon les règles qui président aux aliénations du domaine des personnes publiques.
Le prix provenant de la vente est distribué aux propriétaires des fonds occupés par le nouveau cours à titre d'indemnité, dans la proportion de la valeur du terrain enlevé à chacun d'eux.
""";
    content_hash "sha256:09363cb1650fdc6160bf05067421af0742eb2a350938ac46dc85b674e23dcf73";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART564")
pub fragment CC_ART564 in CC_COURANT {
    label fr official "Article 564";
    kind article;
    locator "article/564";
    text fr official """Article 564
Les pigeons, lapins, poissons, qui passent dans un autre colombier, garenne ou plan d'eau visé aux articles L. 431-6 et L. 431-7 du code de l'environnement appartiennent au propriétaire de ces derniers, pourvu qu'ils n'y aient point été attirés par fraude et artifice.
""";
    content_hash "sha256:8575e02c46fcb2f2082ab12cc613a7f4b687bfa5adfdc205c174e3f71e498ce8";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART565")
pub fragment CC_ART565 in CC_COURANT {
    label fr official "Article 565";
    kind article;
    locator "article/565";
    text fr official """Article 565
Le droit d'accession, quand il a pour objet deux choses mobilières appartenant à deux maîtres différents, est entièrement subordonné aux principes de l'équité naturelle.
Les règles suivantes serviront d'exemple au juge pour se déterminer, dans les cas non prévus, suivant les circonstances particulières.
""";
    content_hash "sha256:1384b53f213561bd32e43f62d4eced27a3d0884d16304a349ed6d85c23675f55";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART566")
pub fragment CC_ART566 in CC_COURANT {
    label fr official "Article 566";
    kind article;
    locator "article/566";
    text fr official """Article 566
Lorsque deux choses appartenant à différents maîtres, qui ont été unies de manière à former un tout, sont néanmoins séparables, en sorte que l'une puisse subsister sans l'autre, le tout appartient au maître de la chose qui forme la partie principale, à la charge de payer à l'autre la valeur, estimée à la date du paiement, de la chose qui a été unie.
""";
    content_hash "sha256:60c727420d416fdc68c84d099e51a4a16d5fe45a18cfba3cf882e1223d4d210b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART567")
pub fragment CC_ART567 in CC_COURANT {
    label fr official "Article 567";
    kind article;
    locator "article/567";
    text fr official """Article 567
Est réputée partie principale celle à laquelle l'autre n'a été unie que pour l'usage, l'ornement ou le complément de la première.
""";
    content_hash "sha256:689cde6fdba07e6443f1a170110d2bbd9a4781e5615b27c1cd9956a967dfec5e";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART568")
pub fragment CC_ART568 in CC_COURANT {
    label fr official "Article 568";
    kind article;
    locator "article/568";
    text fr official """Article 568
Néanmoins, quand la chose unie est beaucoup plus précieuse que la chose principale, et quand elle a été employée à l'insu du propriétaire, celui-ci peut demander que la chose unie soit séparée pour lui être rendue, même quand il pourrait en résulter quelque dégradation de la chose à laquelle elle a été jointe.
""";
    content_hash "sha256:0babaa5c8bff76e39adbb4d592d3b5723f6234cf6fa2644e98d78d51f8f2fd4c";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART569")
pub fragment CC_ART569 in CC_COURANT {
    label fr official "Article 569";
    kind article;
    locator "article/569";
    text fr official """Article 569
Si de deux choses unies pour former un seul tout, l'une ne peut point être regardée comme l'accessoire de l'autre, celle-là est réputée principale qui est la plus considérable en valeur, ou en volume, si les valeurs sont à peu près égales.
""";
    content_hash "sha256:b6e2b58671f9054653e06a008ac8fa95e6617d62f3dbff99cf791fe5ccd7cfed";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART570")
pub fragment CC_ART570 in CC_COURANT {
    label fr official "Article 570";
    kind article;
    locator "article/570";
    text fr official """Article 570
Si un artisan ou une personne quelconque a employé une matière qui ne lui appartenait pas à former une chose d'une nouvelle espèce, soit que la matière puisse ou non reprendre sa première forme, celui qui en était le propriétaire a le droit de réclamer la chose qui en a été formée en remboursant le prix de la main-d'oeuvre estimée à la date du remboursement.
""";
    content_hash "sha256:16c77dd8569bccaaf9c8835f3dfcc3e6f7df024e5124ca035d923846d9fcd9bc";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART571")
pub fragment CC_ART571 in CC_COURANT {
    label fr official "Article 571";
    kind article;
    locator "article/571";
    text fr official """Article 571
Si, cependant, la main-d'oeuvre était tellement importante qu'elle surpassât de beaucoup la valeur de la matière employée, l'industrie serait alors réputée la partie principale, et l'ouvrier aurait le droit de retenir la chose travaillée, en remboursant au propriétaire le prix de la matière, estimée à la date du remboursement.
""";
    content_hash "sha256:878abd07a8d01e85f0e741c4af92267cf799467bdf9b911ece3333c30a32aeef";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART572")
pub fragment CC_ART572 in CC_COURANT {
    label fr official "Article 572";
    kind article;
    locator "article/572";
    text fr official """Article 572
Lorsqu'une personne a employé en partie la matière qui lui appartenait et en partie celle qui ne lui appartenait pas à former une chose d'une espèce nouvelle, sans que ni l'une ni l'autre des deux matières soit entièrement détruite, mais de manière qu'elles ne puissent pas se séparer sans inconvénient, la chose est commune aux deux propriétaires, en raison, quant à l'un, de la matière qui lui appartenait, quant à l'autre, en raison à la fois et de la matière qui lui appartenait et du prix de sa main-d'oeuvre. Le prix de la main-d'oeuvre est estimé à la date de la licitation prévue à l'article 575.
""";
    content_hash "sha256:dc82562ab65099c22f44a9a0568ea3a47c7244615bccb3424f3aa80515b62e8f";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART573")
pub fragment CC_ART573 in CC_COURANT {
    label fr official "Article 573";
    kind article;
    locator "article/573";
    text fr official """Article 573
Lorsqu'une chose a été formée par le mélange de plusieurs matières appartenant à différents propriétaires, mais dont aucune ne peut être regardée comme la matière principale, si les matières peuvent être séparées, celui à l'insu duquel les matières ont été mélangées peut en demander la division.
Si les matières ne peuvent plus être séparées sans inconvénient, ils en acquièrent en commun la propriété dans la proportion de la quantité, de la qualité et de la valeur des matières appartenant à chacun d'eux.
""";
    content_hash "sha256:2e63441ea7e7f38d5e473e5697cbdf01463259af3aeb91cc2e516c6f3154e6b7";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART574")
pub fragment CC_ART574 in CC_COURANT {
    label fr official "Article 574";
    kind article;
    locator "article/574";
    text fr official """Article 574
Si la matière appartenant à l'un des propriétaires était de beaucoup supérieure à l'autre par la quantité et le prix, en ce cas le propriétaire de la matière supérieure en valeur pourrait réclamer la chose provenue du mélange en remboursant à l'autre la valeur de sa matière, estimée à la date du remboursement.
""";
    content_hash "sha256:22ad5d284c130408e9d44efcef938a65f0bb133db6833c6b03278a2c3c602a2c";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART575")
pub fragment CC_ART575 in CC_COURANT {
    label fr official "Article 575";
    kind article;
    locator "article/575";
    text fr official """Article 575
Lorsque la chose reste en commun entre les propriétaires des matières dont elle a été formée, elle doit être licitée au profit commun.
""";
    content_hash "sha256:a1faafbcff641cc371cbd0ea55b5c751bc0c95d8bfae3486774a3f1adf7d3445";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART576")
pub fragment CC_ART576 in CC_COURANT {
    label fr official "Article 576";
    kind article;
    locator "article/576";
    text fr official """Article 576
Dans tous les cas où le propriétaire dont la matière a été employée, à son insu, à former une chose d'une autre espèce peut réclamer la propriété de cette chose, il a le choix de demander la restitution de sa matière en même nature, quantité, poids, mesure et bonté, ou sa valeur estimée à la date de la restitution.
""";
    content_hash "sha256:f70f4d43ce77aa534c23ab12412a772bcdabc353c1a6cb5f3423248f17b5a81a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART577")
pub fragment CC_ART577 in CC_COURANT {
    label fr official "Article 577";
    kind article;
    locator "article/577";
    text fr official """Article 577
Ceux qui auront employé des matières appartenant à d'autres, et à leur insu, pourront aussi être condamnés à des dommages et intérêts, s'il y a lieu, sans préjudice des poursuites par voie extraordinaire, si le cas y échet.
""";
    content_hash "sha256:e812d7f3aee277ac530987eaf471717f21cb06ffcf7d8d5580a28a64c702e657";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART578")
pub fragment CC_ART578 in CC_COURANT {
    label fr official "Article 578";
    kind article;
    locator "article/578";
    text fr official """Article 578
L'usufruit est le droit de jouir des choses dont un autre a la propriété, comme le propriétaire lui-même, mais à la charge d'en conserver la substance.
""";
    content_hash "sha256:cac3cee11e895b2cdab53a978985393b9cd3e2a6d94d712bcf816ed82cb98f00";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART579")
pub fragment CC_ART579 in CC_COURANT {
    label fr official "Article 579";
    kind article;
    locator "article/579";
    text fr official """Article 579
L'usufruit est établi par la loi, ou par la volonté de l'homme.
""";
    content_hash "sha256:f9fe5b6457ff22f6e6219a377cf49df7c4d5503dca13e696da429ffd736f343a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART580")
pub fragment CC_ART580 in CC_COURANT {
    label fr official "Article 580";
    kind article;
    locator "article/580";
    text fr official """Article 580
L'usufruit peut être établi, ou purement, ou à certain jour, ou à condition.
""";
    content_hash "sha256:b919c454306260f6486c23fd77311f671b3295d411c5dd81926ab62b29764f25";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART581")
pub fragment CC_ART581 in CC_COURANT {
    label fr official "Article 581";
    kind article;
    locator "article/581";
    text fr official """Article 581
Il peut être établi sur toute espèce de biens meubles ou immeubles.
""";
    content_hash "sha256:be49ffb92535c22f221e68a2c815e0b4d2595c66bb473e6e99040ae0ee83a733";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART582")
pub fragment CC_ART582 in CC_COURANT {
    label fr official "Article 582";
    kind article;
    locator "article/582";
    text fr official """Article 582
L'usufruitier a le droit de jouir de toute espèce de fruits, soit naturels, soit industriels, soit civils, que peut produire l'objet dont il a l'usufruit.
""";
    content_hash "sha256:6a98657276a35f6be817094ea6c258cb89efe1e14ede2a41aee5e581b7625afd";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART583")
pub fragment CC_ART583 in CC_COURANT {
    label fr official "Article 583";
    kind article;
    locator "article/583";
    text fr official """Article 583
Les fruits naturels sont ceux qui sont le produit spontané de la terre. Le produit et le croît des animaux sont aussi des fruits naturels.
Les fruits industriels d'un fonds sont ceux qu'on obtient par la culture.
""";
    content_hash "sha256:7d6d59c8c0a13890e5c131045ad912474125f33efc7523c9ac8d14028fbad825";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART584")
pub fragment CC_ART584 in CC_COURANT {
    label fr official "Article 584";
    kind article;
    locator "article/584";
    text fr official """Article 584
Les fruits civils sont les loyers des maisons, les intérêts des sommes exigibles, les arrérages des rentes.
Les prix des baux à ferme sont aussi rangés dans la classe des fruits civils.
""";
    content_hash "sha256:e95fd51ff98f76b545b25cd0143d84da4abff2d988199533c26106befb5b1980";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART585")
pub fragment CC_ART585 in CC_COURANT {
    label fr official "Article 585";
    kind article;
    locator "article/585";
    text fr official """Article 585
Les fruits naturels et industriels, pendants par branches ou par racines au moment où l'usufruit est ouvert, appartiennent à l'usufruitier.
Ceux qui sont dans le même état au moment où finit l'usufruit appartiennent au propriétaire, sans récompense de part ni d'autre des labours et des semences, mais aussi sans préjudice de la portion des fruits qui pourrait être acquise au métayer, s'il en existait un au commencement ou à la cessation de l'usufruit.
""";
    content_hash "sha256:4611cbb168d89c2079f52904efd79f379d1b8974a8d05520da3b0f4f0eeab061";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART586")
pub fragment CC_ART586 in CC_COURANT {
    label fr official "Article 586";
    kind article;
    locator "article/586";
    text fr official """Article 586
Les fruits civils sont réputés s'acquérir jour par jour et appartiennent à l'usufruitier à proportion de la durée de son usufruit. Cette règle s'applique aux prix des baux à ferme comme aux loyers des maisons et autres fruits civils.
""";
    content_hash "sha256:abfdc5cb151e6d2b66d372a2bbd0e2028251ff44dbf45342e9d8b555094e86b1";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART587")
pub fragment CC_ART587 in CC_COURANT {
    label fr official "Article 587";
    kind article;
    locator "article/587";
    text fr official """Article 587
Si l'usufruit comprend des choses dont on ne peut faire usage sans les consommer, comme l'argent, les grains, les liqueurs, l'usufruitier a le droit de s'en servir, mais à la charge de rendre, à la fin de l'usufruit, soit des choses de même quantité et qualité soit leur valeur estimée à la date de la restitution.
""";
    content_hash "sha256:496f2d57ddf54d847252ddb7974498ec5c9c1585dc62142cdf87b97419e78dc2";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART588")
pub fragment CC_ART588 in CC_COURANT {
    label fr official "Article 588";
    kind article;
    locator "article/588";
    text fr official """Article 588
L'usufruit d'une rente viagère donne aussi à l'usufruitier, pendant la durée de son usufruit, le droit d'en percevoir les arrérages, sans être tenu à aucune restitution.
""";
    content_hash "sha256:3106909fe532c961f6dbc82556beed638a369c0175b61bed87bdc8ec16b5d55c";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART589")
pub fragment CC_ART589 in CC_COURANT {
    label fr official "Article 589";
    kind article;
    locator "article/589";
    text fr official """Article 589
Si l'usufruit comprend des choses qui, sans se consommer de suite, se détériorent peu à peu par l'usage, comme du linge, des meubles meublants, l'usufruitier a le droit de s'en servir pour l'usage auquel elles sont destinées, et n'est obligé de les rendre à la fin de l'usufruit que dans l'état où elles se trouvent, non détériorées par son dol ou par sa faute.
""";
    content_hash "sha256:1f15547e27eccbcb29d8c8ddf6c6cf2c23e5764cbc79717f0b3f697d9ed99833";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART590")
pub fragment CC_ART590 in CC_COURANT {
    label fr official "Article 590";
    kind article;
    locator "article/590";
    text fr official """Article 590
Si l'usufruit comprend des bois taillis, l'usufruitier est tenu d'observer l'ordre et la quotité des coupes, conformément à l'aménagement ou à l'usage constant des propriétaires ; sans indemnité toutefois en faveur de l'usufruitier ou de ses héritiers, pour les coupes ordinaires, soit de taillis, soit de baliveaux, soit de futaie, qu'il n'aurait pas faites pendant sa jouissance.
Les arbres qu'on peut tirer d'une pépinière sans la dégrader ne font aussi partie de l'usufruit qu'à la charge par l'usufruitier de se conformer aux usages des lieux pour le remplacement.
""";
    content_hash "sha256:3dd52afd2edccb34642ce3d378398e60a9a6ab81c6b2f4723ced99892b3e2a7f";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART591")
pub fragment CC_ART591 in CC_COURANT {
    label fr official "Article 591";
    kind article;
    locator "article/591";
    text fr official """Article 591
L'usufruitier profite encore, toujours en se conformant aux époques et à l'usage des anciens propriétaires, des parties de bois de haute futaie qui ont été mises en coupes réglées, soit que ces coupes se fassent périodiquement sur une certaine étendue de terrain, soit qu'elles se fassent d'une certaine quantité d'arbres pris indistinctement sur toute la surface du domaine.
""";
    content_hash "sha256:b478344b34cf213651ef95c6db46836d616f46c2b9e88e675c432f6e3e8292c2";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART592")
pub fragment CC_ART592 in CC_COURANT {
    label fr official "Article 592";
    kind article;
    locator "article/592";
    text fr official """Article 592
Dans tous les autres cas, l'usufruitier ne peut toucher aux arbres de haute futaie : il peut seulement employer, pour faire les réparations dont il est tenu, les arbres arrachés ou brisés par accident ; il peut même, pour cet objet, en faire abattre s'il est nécessaire, mais à la charge d'en faire constater la nécessité avec le propriétaire.
""";
    content_hash "sha256:bc784d82efda3e3b38e4cde109a0e3119ad3187ea2214b43706aef3e6d876498";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART593")
pub fragment CC_ART593 in CC_COURANT {
    label fr official "Article 593";
    kind article;
    locator "article/593";
    text fr official """Article 593
Il peut prendre, dans les bois, des échalas pour les vignes ; il peut aussi prendre, sur les arbres, des produits annuels ou périodiques ; le tout suivant l'usage du pays ou la coutume des propriétaires.
""";
    content_hash "sha256:3051be0628771aac77b45485aa05a7cebe2f2ac849fa3c44395e352f9fb3671b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART594")
pub fragment CC_ART594 in CC_COURANT {
    label fr official "Article 594";
    kind article;
    locator "article/594";
    text fr official """Article 594
Les arbres fruitiers qui meurent, ceux mêmes qui sont arrachés ou brisés par accident, appartiennent à l'usufruitier, à la charge de les remplacer par d'autres.
""";
    content_hash "sha256:e6642f3cd7e5b4685abb4b49ebd0833fcbb9c253486fe4ed69680610ad4bdef3";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART595")
pub fragment CC_ART595 in CC_COURANT {
    label fr official "Article 595";
    kind article;
    locator "article/595";
    text fr official """Article 595
L'usufruitier peut jouir par lui-même, donner à bail à un autre, même vendre ou céder son droit à titre gratuit.
Les baux que l'usufruitier seul a faits pour un temps qui excède neuf ans ne sont, en cas de cessation de l'usufruit, obligatoires à l'égard du nu-propriétaire que pour le temps qui reste à courir, soit de la première période de neuf ans, si les parties s'y trouvent encore, soit de la seconde, et ainsi de suite de manière que le preneur n'ait que le droit d'achever la jouissance de la période de neuf ans où il se trouve.
Les baux de neuf ans ou au-dessous que l'usufruitier seul a passés ou renouvelés plus de trois ans avant l'expiration du bail courant s'il s'agit de biens ruraux, et plus de deux ans avant la même époque s'il s'agit de maisons, sont sans effet, à moins que leur exécution n'ait commencé avant la cessation de l'usufruit.
L'usufruitier ne peut, sans le concours du nu-propriétaire, donner à bail un fonds rural ou un immeuble à usage commercial, industriel ou artisanal. A défaut d'accord du nu-propriétaire, l'usufruitier peut être autorisé par justice à passer seul cet acte.
""";
    content_hash "sha256:ab21f7f862590a95259aaa00779d3028827a5a7a8cc0ada40c1d479da31b8b76";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART596")
pub fragment CC_ART596 in CC_COURANT {
    label fr official "Article 596";
    kind article;
    locator "article/596";
    text fr official """Article 596
L'usufruitier jouit de l'augmentation survenue par alluvion à l'objet dont il a l'usufruit.
""";
    content_hash "sha256:68f864a57fde24dc6229c82cfc8699711be332a3f2566e2c743cd52490c68d33";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART597")
pub fragment CC_ART597 in CC_COURANT {
    label fr official "Article 597";
    kind article;
    locator "article/597";
    text fr official """Article 597
Il jouit des droits de servitude, de passage, et généralement de tous les droits dont le propriétaire peut jouir, et il en jouit comme le propriétaire lui-même.
""";
    content_hash "sha256:26ad44aad5f40549e55e56ce88c27cdd2db7bfcbb4d89f76ca8edc81453fd632";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART598")
pub fragment CC_ART598 in CC_COURANT {
    label fr official "Article 598";
    kind article;
    locator "article/598";
    text fr official """Article 598
Il jouit aussi, de la même manière que le propriétaire, des mines et carrières qui sont en exploitation à l'ouverture de l'usufruit ; et néanmoins, s'il s'agit d'une exploitation qui ne puisse être faite sans une concession, l'usufruitier ne pourra en jouir qu'après en avoir obtenu la permission du Président de la République.
Il n'a aucun droit aux mines et carrières non encore ouvertes, ni aux tourbières dont l'exploitation n'est point encore commencée, ni au trésor qui pourrait être découvert pendant la durée de l'usufruit.
""";
    content_hash "sha256:3b4ace12764d5c101a7f9237d7f0a3dca61c10083774c0f0618f41b1fa06aef2";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART599")
pub fragment CC_ART599 in CC_COURANT {
    label fr official "Article 599";
    kind article;
    locator "article/599";
    text fr official """Article 599
Le propriétaire ne peut, par son fait, ni de quelque manière que ce soit, nuire aux droits de l'usufruitier.
De son côté, l'usufruitier ne peut, à la cessation de l'usufruit, réclamer aucune indemnité pour les améliorations qu'il prétendrait avoir faites, encore que la valeur de la chose en fût augmentée.
Il peut cependant, ou ses héritiers, enlever les glaces, tableaux et autres ornements qu'il aurait fait placer, mais à la charge de rétablir les lieux dans leur premier état.
""";
    content_hash "sha256:20ab829e96ab0ae15fd383a0fd27d6efecf1a7b8e90fd7dd3e3d2795177c45ae";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART600")
pub fragment CC_ART600 in CC_COURANT {
    label fr official "Article 600";
    kind article;
    locator "article/600";
    text fr official """Article 600
L'usufruitier prend les choses dans l'état où elles sont, mais il ne peut entrer en jouissance qu'après avoir fait dresser, en présence du propriétaire, ou lui dûment appelé, un inventaire des meubles et un état des immeubles sujets à l'usufruit.
""";
    content_hash "sha256:764d363705a9c09f67fa1b1b9c7f1b7bc238a94f1cbe17466fd6e7fcf437e1dc";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART601")
pub fragment CC_ART601 in CC_COURANT {
    label fr official "Article 601";
    kind article;
    locator "article/601";
    text fr official """Article 601
Il donne caution de jouir raisonnablement, s'il n'en est dispensé par l'acte constitutif de l'usufruit ; cependant les père et mère ayant l'usufruit légal du bien de leurs enfants, le vendeur ou le donateur, sous réserve d'usufruit, ne sont pas tenus de donner caution.
""";
    content_hash "sha256:8b93d28fc754d1ee1bc0e2d07b343573cfcfaf713fcea91a576e96b103159957";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART602")
pub fragment CC_ART602 in CC_COURANT {
    label fr official "Article 602";
    kind article;
    locator "article/602";
    text fr official """Article 602
Si l'usufruitier ne trouve pas de caution, les immeubles sont donnés à ferme ou mis en séquestre ;
Les sommes comprises dans l'usufruit sont placées ;
Les denrées sont vendues et le prix en provenant est pareillement placé ;
Les intérêts de ces sommes et les prix des fermes appartiennent, dans ce cas, à l'usufruitier.
""";
    content_hash "sha256:6b76ed2b19cf76cc6d361f45a1e721093c576a856969560397a0d5f67c93415a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART603")
pub fragment CC_ART603 in CC_COURANT {
    label fr official "Article 603";
    kind article;
    locator "article/603";
    text fr official """Article 603
A défaut d'une caution de la part de l'usufruitier, le propriétaire peut exiger que les meubles qui dépérissent par l'usage soient vendus, pour le prix en être placé comme celui des denrées ; et alors l'usufruitier jouit de l'intérêt pendant son usufruit : cependant l'usufruitier pourra demander, et les juges pourront ordonner, suivant les circonstances, qu'une partie des meubles nécessaires pour son usage lui soit délaissée, sous sa simple caution juratoire, et à la charge de les représenter à l'extinction de l'usufruit.
""";
    content_hash "sha256:d7a91844bf0ca91a57245dcfc4fa0ae4d2a8640d4e2de47103dcf55efd62a8c6";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART604")
pub fragment CC_ART604 in CC_COURANT {
    label fr official "Article 604";
    kind article;
    locator "article/604";
    text fr official """Article 604
Le retard de donner caution ne prive pas l'usufruitier des fruits auxquels il peut avoir droit ; ils lui sont dus du moment où l'usufruit a été ouvert.
""";
    content_hash "sha256:13bb65267f2585cdaae1bb82af7385dd78a087efacd77b5b889d3d320f38f987";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART605")
pub fragment CC_ART605 in CC_COURANT {
    label fr official "Article 605";
    kind article;
    locator "article/605";
    text fr official """Article 605
L'usufruitier n'est tenu qu'aux réparations d'entretien.
Les grosses réparations demeurent à la charge du propriétaire, à moins qu'elles n'aient été occasionnées par le défaut de réparations d'entretien, depuis l'ouverture de l'usufruit ; auquel cas l'usufruitier en est aussi tenu.
""";
    content_hash "sha256:b040cd2a1eb1778d565d2aa50d369f2acf0b1508b45e9fea9dfb821159e7a671";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART606")
pub fragment CC_ART606 in CC_COURANT {
    label fr official "Article 606";
    kind article;
    locator "article/606";
    text fr official """Article 606
Les grosses réparations sont celles des gros murs et des voûtes, le rétablissement des poutres et des couvertures entières.
Celui des digues et des murs de soutènement et de clôture aussi en entier.
Toutes les autres réparations sont d'entretien.
""";
    content_hash "sha256:efa0280ea0df4cb8edcdcfd916d905712484178e281a4e2acb7467a972dbaf67";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART607")
pub fragment CC_ART607 in CC_COURANT {
    label fr official "Article 607";
    kind article;
    locator "article/607";
    text fr official """Article 607
Ni le propriétaire, ni l'usufruitier, ne sont tenus de rebâtir ce qui est tombé de vétusté, ou ce qui a été détruit par cas fortuit.
""";
    content_hash "sha256:45f7b7e1ec482c270195bd702d74721bcef8342670ad1ee50d35de330df496e4";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART608")
pub fragment CC_ART608 in CC_COURANT {
    label fr official "Article 608";
    kind article;
    locator "article/608";
    text fr official """Article 608
L'usufruitier est tenu, pendant sa jouissance, de toutes les charges annuelles de l'héritage, telles que les contributions et autres qui dans l'usage sont censées charges des fruits.
""";
    content_hash "sha256:c4e00f16e7c6faa55256cc63f5d6a74a68009fbe282a9b97419fea17c1fc6c87";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART609")
pub fragment CC_ART609 in CC_COURANT {
    label fr official "Article 609";
    kind article;
    locator "article/609";
    text fr official """Article 609
A l'égard des charges qui peuvent être imposées sur la propriété pendant la durée de l'usufruit, l'usufruitier et le propriétaire y contribuent ainsi qu'il suit :
Le propriétaire est obligé de les payer, et l'usufruitier doit lui tenir compte des intérêts ;
Si elles sont avancées par l'usufruitier, il a la répétition du capital à la fin de l'usufruit.
""";
    content_hash "sha256:d45dac6fe875311dd6f370c0e54a86bf442fd9a68cf75be8a5a4b6291f0da43e";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART610")
pub fragment CC_ART610 in CC_COURANT {
    label fr official "Article 610";
    kind article;
    locator "article/610";
    text fr official """Article 610
Le legs fait par un testateur, d'une rente viagère ou pension alimentaire, doit être acquitté par le légataire universel de l'usufruit dans son intégrité, et par le légataire à titre universel de l'usufruit dans la proportion de sa jouissance, sans aucune répétition de leur part.
""";
    content_hash "sha256:31a61dd36ea4bd18ffce283606ca01fbcb26ba1222341fc7805272a31453e011";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART611")
pub fragment CC_ART611 in CC_COURANT {
    label fr official "Article 611";
    kind article;
    locator "article/611";
    text fr official """Article 611
L'usufruitier à titre particulier n'est pas tenu des dettes auxquelles le fonds est hypothéqué : s'il est forcé de les payer, il a son recours contre le propriétaire, sauf ce qui est dit à l'article 1020, au titre " Des donations entre vifs et des testaments ".
""";
    content_hash "sha256:1f82c1ca853b92e05e5b19291b141429430ac1ac2802759b14e6b8c284586fda";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART612")
pub fragment CC_ART612 in CC_COURANT {
    label fr official "Article 612";
    kind article;
    locator "article/612";
    text fr official """Article 612
L'usufruitier, ou universel, ou à titre universel, doit contribuer avec le propriétaire au paiement des dettes ainsi qu'il suit :
On estime la valeur du fonds sujet à usufruit ; on fixe ensuite la contribution aux dettes à raison de cette valeur.
Si l'usufruitier veut avancer la somme pour laquelle le fonds doit contribuer, le capital lui en est restitué à la fin de l'usufruit, sans aucun intérêt.
Si l'usufruitier ne veut pas faire cette avance, le propriétaire a le choix, ou de payer cette somme, et, dans ce cas, l'usufruitier lui tient compte des intérêts pendant la durée de l'usufruit, ou de faire vendre jusqu'à due concurrence une portion des biens soumis à l'usufruit.
""";
    content_hash "sha256:a809194bcf458dbc05cc05925e483d36bfdd17b666ff9a7fbe9aff88282af047";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART613")
pub fragment CC_ART613 in CC_COURANT {
    label fr official "Article 613";
    kind article;
    locator "article/613";
    text fr official """Article 613
L'usufruitier n'est tenu que des frais des procès qui concernent la jouissance et des autres condamnations auxquelles ces procès pourraient donner lieu.
""";
    content_hash "sha256:aa302a4d99cf539be5c01b68bc2ba49de8179438f4b99c99f8b66ee4150ccb6e";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART614")
pub fragment CC_ART614 in CC_COURANT {
    label fr official "Article 614";
    kind article;
    locator "article/614";
    text fr official """Article 614
Si, pendant la durée de l'usufruit, un tiers commet quelque usurpation sur le fonds, ou attente autrement aux droits du propriétaire, l'usufruitier est tenu de le dénoncer à celui-ci ; faute de ce, il est responsable de tout le dommage qui peut en résulter pour le propriétaire, comme il le serait de dégradations commises par lui-même.
""";
    content_hash "sha256:af79ff155faf29f22d3af07a3611f079121285f76e87de1f46ad15a8b6061806";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART615")
pub fragment CC_ART615 in CC_COURANT {
    label fr official "Article 615";
    kind article;
    locator "article/615";
    text fr official """Article 615
Si l'usufruit n'est établi que sur un animal qui vient à périr sans la faute de l'usufruitier, celui-ci n'est pas tenu d'en rendre un autre, ni d'en payer l'estimation.
""";
    content_hash "sha256:18cc10ae5939633721d4fb722990bad557f1f81238f69aedb92a32c5077d8491";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART616")
pub fragment CC_ART616 in CC_COURANT {
    label fr official "Article 616";
    kind article;
    locator "article/616";
    text fr official """Article 616
Si le troupeau sur lequel un usufruit a été établi périt entièrement par accident ou par maladie et sans la faute de l'usufruitier, celui-ci n'est tenu envers le propriétaire que de lui rendre compte des cuirs, ou de leur valeur estimée à la date de la restitution.
Si le troupeau ne périt pas entièrement, l'usufruitier est tenu de remplacer, jusqu'à concurrence du croît, les têtes des animaux qui ont péri.
""";
    content_hash "sha256:243f76e8472cfd6c8daccbbd668e619a4af713b6d7615f0eb127744aea5cc603";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART617")
pub fragment CC_ART617 in CC_COURANT {
    label fr official "Article 617";
    kind article;
    locator "article/617";
    text fr official """Article 617
L'usufruit s'éteint :
Par la mort de l'usufruitier ;
Par l'expiration du temps pour lequel il a été accordé ;
Par la consolidation ou la réunion sur la même tête, des deux qualités d'usufruitier et de propriétaire ;
Par le non-usage du droit pendant trente ans ;
Par la perte totale de la chose sur laquelle l'usufruit est établi.
""";
    content_hash "sha256:8c9ccdb121a11874ffa0fbfc56f6cc9e73be75a84c03605ef6909864723d8a31";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART618")
pub fragment CC_ART618 in CC_COURANT {
    label fr official "Article 618";
    kind article;
    locator "article/618";
    text fr official """Article 618
L'usufruit peut aussi cesser par l'abus que l'usufruitier fait de sa jouissance, soit en commettant des dégradations sur le fonds, soit en le laissant dépérir faute d'entretien.
Les créanciers de l'usufruitier peuvent intervenir dans les contestations pour la conservation de leurs droits ; ils peuvent offrir la réparation des dégradations commises et des garanties pour l'avenir.
Les juges peuvent, suivant la gravité des circonstances, ou prononcer l'extinction absolue de l'usufruit, ou n'ordonner la rentrée du propriétaire dans la jouissance de l'objet qui en est grevé, que sous la charge de payer annuellement à l'usufruitier, ou à ses ayants cause, une somme déterminée, jusqu'à l'instant où l'usufruit aurait dû cesser.
""";
    content_hash "sha256:88d98d20538133236b8b77795012dd780df1694a4bb1049d5c4bafbdf6e3b1c0";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART619")
pub fragment CC_ART619 in CC_COURANT {
    label fr official "Article 619";
    kind article;
    locator "article/619";
    text fr official """Article 619
L'usufruit qui n'est pas accordé à des particuliers ne dure que trente ans.
""";
    content_hash "sha256:a99fd3858711b89acb77fee53ef99cd1cf1e2af0c6ebd4a5de829268b66a8d06";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART620")
pub fragment CC_ART620 in CC_COURANT {
    label fr official "Article 620";
    kind article;
    locator "article/620";
    text fr official """Article 620
L'usufruit accordé jusqu'à ce qu'un tiers ait atteint un âge fixe dure jusqu'à cette époque, encore que le tiers soit mort avant l'âge fixé.
""";
    content_hash "sha256:f097cdb1137ac4849dc561d52f0eb2537a90f97c11e665d0a9f55414cf82210f";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART621")
pub fragment CC_ART621 in CC_COURANT {
    label fr official "Article 621";
    kind article;
    locator "article/621";
    text fr official """Article 621
En cas de vente simultanée de l'usufruit et de la nue-propriété d'un bien, le prix se répartit entre l'usufruit et la nue-propriété selon la valeur respective de chacun de ces droits, sauf accord des parties pour reporter l'usufruit sur le prix.
La vente du bien grevé d'usufruit, sans l'accord de l'usufruitier, ne modifie pas le droit de ce dernier, qui continue à jouir de son usufruit sur le bien s'il n'y a pas expressément renoncé.
""";
    content_hash "sha256:a05ae3b1e7fa1cb539e956324b34fcfb9eb669176a559ee8f1a8d832e2fae435";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART622")
pub fragment CC_ART622 in CC_COURANT {
    label fr official "Article 622";
    kind article;
    locator "article/622";
    text fr official """Article 622
Les créanciers de l'usufruitier peuvent faire annuler la renonciation qu'il aurait faite à leur préjudice.
""";
    content_hash "sha256:4841e95fc1f92a090aa35ce4d37763023023887e2bef6572526b8d4fd8797e04";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART623")
pub fragment CC_ART623 in CC_COURANT {
    label fr official "Article 623";
    kind article;
    locator "article/623";
    text fr official """Article 623
Si une partie seulement de la chose soumise à l'usufruit est détruite, l'usufruit se conserve sur ce qui reste.
""";
    content_hash "sha256:0bec15c2d87090fd1fbd38d5e4cf21d0c22b6d559430436b16d7a4647c4ae82a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART624")
pub fragment CC_ART624 in CC_COURANT {
    label fr official "Article 624";
    kind article;
    locator "article/624";
    text fr official """Article 624
Si l'usufruit n'est établi que sur un bâtiment, et que ce bâtiment soit détruit par un incendie ou autre accident, ou qu'il s'écroule de vétusté, l'usufruitier n'aura le droit de jouir ni du sol ni des matériaux.
Si l'usufruit était établi sur un domaine dont le bâtiment faisait partie, l'usufruitier jouirait du sol et des matériaux.
""";
    content_hash "sha256:fa1bc4fca7127069b3501351aa77e043bf67ff6a332378851fcedf610b5d3dc8";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART625")
pub fragment CC_ART625 in CC_COURANT {
    label fr official "Article 625";
    kind article;
    locator "article/625";
    text fr official """Article 625
Les droits d'usage et d'habitation s'établissent et se perdent de la même manière que l'usufruit.
""";
    content_hash "sha256:f6330bc8757eedac11bfbe7935f099d22804b799123f65b2f79c8b06abb5a737";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART626")
pub fragment CC_ART626 in CC_COURANT {
    label fr official "Article 626";
    kind article;
    locator "article/626";
    text fr official """Article 626
On ne peut en jouir, comme dans le cas de l'usufruit, sans donner préalablement caution et sans faire des états et inventaires.
""";
    content_hash "sha256:e6e8be09a94df9c13bbfaeb41b90a4019f9d7619620c7068593ba5bf46e200a8";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART627")
pub fragment CC_ART627 in CC_COURANT {
    label fr official "Article 627";
    kind article;
    locator "article/627";
    text fr official """Article 627
L'usager, et celui qui a un droit d'habitation, doivent jouir raisonnablement.
""";
    content_hash "sha256:c4923579f3635d406a4ca9a75ce94b786104e8ad86df1fb9f2c4d44d7629121a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART628")
pub fragment CC_ART628 in CC_COURANT {
    label fr official "Article 628";
    kind article;
    locator "article/628";
    text fr official """Article 628
Les droits d'usage et d'habitation se règlent par le titre qui les a établis et reçoivent, d'après ses dispositions, plus ou moins d'étendue.
""";
    content_hash "sha256:bf1d3115f82beac65eed61ae95769a3b8b4227cf403278c926efe1535e04ffdd";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART629")
pub fragment CC_ART629 in CC_COURANT {
    label fr official "Article 629";
    kind article;
    locator "article/629";
    text fr official """Article 629
Si le titre ne s'explique pas sur l'étendue de ces droits ils sont réglés ainsi qu'il suit.
""";
    content_hash "sha256:7d7be2bab264b170a7219eec8424a53735f167f669380cea76ccbe54284d5b22";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART630")
pub fragment CC_ART630 in CC_COURANT {
    label fr official "Article 630";
    kind article;
    locator "article/630";
    text fr official """Article 630
Celui qui a l'usage des fruits d'un fonds ne peut en exiger qu'autant qu'il lui en faut pour ses besoins et ceux de sa famille.
Il peut en exiger pour les besoins même des enfants qui lui sont survenus depuis la concession de l'usage.
""";
    content_hash "sha256:174b1796aa1ecbe46a22a176a3f4420e71b1799ab4debf52b126784ee41ff855";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART631")
pub fragment CC_ART631 in CC_COURANT {
    label fr official "Article 631";
    kind article;
    locator "article/631";
    text fr official """Article 631
L'usager ne peut céder ni louer son droit à un autre.
""";
    content_hash "sha256:498b77cfb123d13cdb01150ea795653d33b4dd1d8b6fb76d5a25bf9cbad61735";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART632")
pub fragment CC_ART632 in CC_COURANT {
    label fr official "Article 632";
    kind article;
    locator "article/632";
    text fr official """Article 632
Celui qui a un droit d'habitation dans une maison peut y demeurer avec sa famille, quand même il n'aurait pas été marié à l'époque où ce droit lui a été donné.
""";
    content_hash "sha256:cf75ebf6f4d0a6d3a759a85e8124eece9b94fcc2c4affef9385e25edcbdf3446";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART633")
pub fragment CC_ART633 in CC_COURANT {
    label fr official "Article 633";
    kind article;
    locator "article/633";
    text fr official """Article 633
Le droit d'habitation se restreint à ce qui est nécessaire pour l'habitation de celui à qui ce droit est concédé et de sa famille.
""";
    content_hash "sha256:0c2a24d2bcda1a2603079b1c93c02e84113371a4cd61a2e72271cee537f1f009";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART634")
pub fragment CC_ART634 in CC_COURANT {
    label fr official "Article 634";
    kind article;
    locator "article/634";
    text fr official """Article 634
Le droit d'habitation ne peut être ni cédé ni loué.
""";
    content_hash "sha256:ff1a23043d10f82388c55337b54110b04106b35ef3da213c300bbf1c87454692";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART635")
pub fragment CC_ART635 in CC_COURANT {
    label fr official "Article 635";
    kind article;
    locator "article/635";
    text fr official """Article 635
Si l'usager absorbe tous les fruits du fonds ou s'il occupe la totalité de la maison, il est assujetti aux frais de culture, aux réparations d'entretien et au paiement des contributions, comme l'usufruitier.
S'il ne prend qu'une partie des fruits ou s'il n'occupe qu'une partie de la maison, il contribue au prorata de ce dont il jouit.
""";
    content_hash "sha256:9462d37a586e1034b471bce6feb161c89121d07af7a1eeda54771820c7460d5d";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART636")
pub fragment CC_ART636 in CC_COURANT {
    label fr official "Article 636";
    kind article;
    locator "article/636";
    text fr official """Article 636
L'usage des bois et forêts est réglé par des lois particulières.
""";
    content_hash "sha256:da9b1fb914ca336e27f8e0f3574e4938b1215dbc1ce384aefa450a627f4d16a5";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART637")
pub fragment CC_ART637 in CC_COURANT {
    label fr official "Article 637";
    kind article;
    locator "article/637";
    text fr official """Article 637
Une servitude est une charge imposée sur un héritage pour l'usage et l'utilité d'un héritage appartenant à un autre propriétaire.
""";
    content_hash "sha256:e22dc9d13d880d08e69d570e857fe9086c09129cb071df61f956b3c2230ce18b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART638")
pub fragment CC_ART638 in CC_COURANT {
    label fr official "Article 638";
    kind article;
    locator "article/638";
    text fr official """Article 638
La servitude n'établit aucune prééminence d'un héritage sur l'autre.
""";
    content_hash "sha256:8ec476069043fdd5d26d79ee750b33b50d60fdca94a74e2b91de6d40159eec4a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART639")
pub fragment CC_ART639 in CC_COURANT {
    label fr official "Article 639";
    kind article;
    locator "article/639";
    text fr official """Article 639
Elle dérive ou de la situation naturelle des lieux, ou des obligations imposées par la loi, ou des conventions entre les propriétaires.
""";
    content_hash "sha256:4b68a05a296889cffe049f9252c58c6e2dbccd53b617b43483318c271db3fa02";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART640")
pub fragment CC_ART640 in CC_COURANT {
    label fr official "Article 640";
    kind article;
    locator "article/640";
    text fr official """Article 640
Les fonds inférieurs sont assujettis envers ceux qui sont plus élevés à recevoir les eaux qui en découlent naturellement sans que la main de l'homme y ait contribué.
Le propriétaire inférieur ne peut point élever de digue qui empêche cet écoulement.
Le propriétaire supérieur ne peut rien faire qui aggrave la servitude du fonds inférieur.
""";
    content_hash "sha256:c9f356c2163530518b13688d2b12aabacb1cdb651b789d752a9cdab36ddee698";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART641")
pub fragment CC_ART641 in CC_COURANT {
    label fr official "Article 641";
    kind article;
    locator "article/641";
    text fr official """Article 641
Tout propriétaire a le droit d'user et de disposer des eaux pluviales qui tombent sur son fonds.
Si l'usage de ces eaux ou la direction qui leur est donnée aggrave la servitude naturelle d'écoulement établie par l'article 640, une indemnité est due au propriétaire du fonds inférieur.
La même disposition est applicable aux eaux de sources nées sur un fonds.
Lorsque, par des sondages ou des travaux souterrains, un propriétaire fait surgir des eaux dans son fonds, les propriétaires des fonds inférieurs doivent les recevoir ; mais ils ont droit à une indemnité en cas de dommages résultant de leur écoulement.
Les maisons, cours, jardins, parcs et enclos attenant aux habitations ne peuvent être assujettis à aucune aggravation de la servitude d'écoulement dans les cas prévus par les paragraphes précédents.
Les contestations auxquelles peuvent donner lieu l'établissement et l'exercice des servitudes prévues par ces paragraphes et le règlement, s'il y a lieu, des indemnités dues aux propriétaires des fonds inférieurs sont portées, en premier ressort, devant le juge du tribunal judiciaire du canton qui, en prononçant, doit concilier les intérêts de l'agriculture et de l'industrie avec le respect dû à la propriété.
S'il y a lieu à expertise, il peut n'être nommé qu'un seul expert.
""";
    content_hash "sha256:d3cf08b6fc9731f724a03bad3bbac76e9f035b57df91b703b3edb1291d992587";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART642")
pub fragment CC_ART642 in CC_COURANT {
    label fr official "Article 642";
    kind article;
    locator "article/642";
    text fr official """Article 642
Celui qui a une source dans son fonds peut toujours user des eaux à sa volonté dans les limites et pour les besoins de son héritage.
Le propriétaire d'une source ne peut plus en user au préjudice des propriétaires des fonds inférieurs qui, depuis plus de trente ans, ont fait et terminé, sur le fonds où jaillit la source, des ouvrages apparents et permanents destinés à utiliser les eaux ou à en faciliter le passage dans leur propriété.
Il ne peut pas non plus en user de manière à enlever aux habitants d'une commune, village ou hameau, l'eau qui leur est nécessaire ; mais si les habitants n'en n'ont pas acquis ou prescrit l'usage, le propriétaire peut réclamer une indemnité, laquelle est réglée par experts.
""";
    content_hash "sha256:13454c0c10dd86e45c10c7f87a9b16fe21432f468cd4c28ef23daea64bc4ffbe";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART643")
pub fragment CC_ART643 in CC_COURANT {
    label fr official "Article 643";
    kind article;
    locator "article/643";
    text fr official """Article 643
Si, dès la sortie du fonds où elles surgissent, les eaux de source forment un cours d'eau offrant le caractère d'eaux publiques et courantes, le propriétaire ne peut les détourner de leurs cours naturel au préjudice des usagers inférieurs.
""";
    content_hash "sha256:7d63ed91d271c3943ca7abbcdd595aab42fedc1d0d4580514734f8f8e3c03884";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART644")
pub fragment CC_ART644 in CC_COURANT {
    label fr official "Article 644";
    kind article;
    locator "article/644";
    text fr official """Article 644
Celui dont la propriété borde une eau courante, autre que celle qui est déclarée dépendance du domaine public par l'article 538 au titre " De la distinction des biens ", peut s'en servir à son passage pour l'irrigation de ses propriétés.
Celui dont cette eau traverse l'héritage peut même en user dans l'intervalle qu'elle y parcourt, mais à la charge de la rendre, à la sortie de ses fonds, à son cours ordinaire.
""";
    content_hash "sha256:d4e4077a91cfbef019094cb078b2abce1b8a17c3f3bc131b16b536a0bda350a7";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART645")
pub fragment CC_ART645 in CC_COURANT {
    label fr official "Article 645";
    kind article;
    locator "article/645";
    text fr official """Article 645
S'il s'élève une contestation entre les propriétaires auxquels ces eaux peuvent être utiles, les tribunaux, en prononçant, doivent concilier l'intérêt de l'agriculture avec le respect dû à la propriété ; et, dans tous les cas, les règlements particuliers et locaux sur le cours et l'usage des eaux doivent être observés.
""";
    content_hash "sha256:e38370e445d30b4001738d1b13f8aa12e77cebff9a6abd327fa687b58fc1f5b1";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART646")
pub fragment CC_ART646 in CC_COURANT {
    label fr official "Article 646";
    kind article;
    locator "article/646";
    text fr official """Article 646
Tout propriétaire peut obliger son voisin au bornage de leurs propriétés contiguës. Le bornage se fait à frais communs.
""";
    content_hash "sha256:411bea4ce4618ba55893d08ea468e9b6e4c1556ff5e6e19933f898b0a03da262";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART647")
pub fragment CC_ART647 in CC_COURANT {
    label fr official "Article 647";
    kind article;
    locator "article/647";
    text fr official """Article 647
Tout propriétaire peut clore son héritage, sauf l'exception portée en l'article 682.
""";
    content_hash "sha256:cf4cbdcc3c15c17c9508954c5b8d5388989c9d6fb9c28ee73bb8d35077d1c0d3";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART648")
pub fragment CC_ART648 in CC_COURANT {
    label fr official "Article 648";
    kind article;
    locator "article/648";
    text fr official """Article 648
Le propriétaire qui veut se clore perd son droit au parcours et vaine pâture en proportion du terrain qu'il y soustrait.
""";
    content_hash "sha256:2da034d62fcbea5ce51b85c470def287298f19d69d4277ad280d569a86d99bc6";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART649")
pub fragment CC_ART649 in CC_COURANT {
    label fr official "Article 649";
    kind article;
    locator "article/649";
    text fr official """Article 649
Les servitudes établies par la loi ont pour objet l'utilité publique ou communale, ou l'utilité des particuliers.
""";
    content_hash "sha256:806a66658d2980bc60c7b00e94d963d43fc265e2195a981139c8e84ed0510fae";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART650")
pub fragment CC_ART650 in CC_COURANT {
    label fr official "Article 650";
    kind article;
    locator "article/650";
    text fr official """Article 650
Celles établies pour l'utilité publique ou communale ont pour objet le marchepied le long des cours d'eau domaniaux, la construction ou réparation des chemins et autres ouvrages publics ou communaux.
Tout ce qui concerne cette espèce de servitude est déterminé par des lois ou des règlements particuliers.
""";
    content_hash "sha256:5431c71af4ecc9411c8e406bc667070c97735fd4ab034b9a6538aec350af6055";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART651")
pub fragment CC_ART651 in CC_COURANT {
    label fr official "Article 651";
    kind article;
    locator "article/651";
    text fr official """Article 651
La loi assujettit les propriétaires à différentes obligations l'un à l'égard de l'autre, indépendamment de toute convention.
""";
    content_hash "sha256:8ac7b2eb9ffe5c6952175a2d9f88b9777ccc71fbb7ec204688bdcb7675b1d2fa";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART652")
pub fragment CC_ART652 in CC_COURANT {
    label fr official "Article 652";
    kind article;
    locator "article/652";
    text fr official """Article 652
Partie de ces obligations est réglée par les lois sur la police rurale ;
Les autres sont relatives au mur et au fossé mitoyens, au cas où il y a lieu à contre-mur, aux vues sur la propriété du voisin, à l'égout des toits, au droit de passage.
""";
    content_hash "sha256:55edec0b8d25ce8e81c81cd1973cc969c69aa2e6291120dcc34bab8ab0243a58";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART653")
pub fragment CC_ART653 in CC_COURANT {
    label fr official "Article 653";
    kind article;
    locator "article/653";
    text fr official """Article 653
Dans les villes et les campagnes, tout mur servant de séparation entre bâtiments jusqu'à l'héberge, ou entre cours et jardins, et même entre enclos dans les champs, est présumé mitoyen s'il n'y a titre ou marque du contraire.
""";
    content_hash "sha256:83ad235d8536f369d856f344e95dc66398e372d809dcf98a8830259e7eaf27bf";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART654")
pub fragment CC_ART654 in CC_COURANT {
    label fr official "Article 654";
    kind article;
    locator "article/654";
    text fr official """Article 654
Il y a marque de non-mitoyenneté lorsque la sommité du mur est droite et à plomb de son parement d'un côté, et présente de l'autre un plan incliné.
Lors encore qu'il n'y a que d'un côté ou un chaperon ou des filets et corbeaux de pierre qui y auraient été mis en bâtissant le mur.
Dans ces cas, le mur est censé appartenir exclusivement au propriétaire du côté duquel sont l'égout ou les corbeaux et filets de pierre.
""";
    content_hash "sha256:14c927d35deb10d7cd3a5bf4b1eda9fb26073dfb890683b3694859f416294f9a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART655")
pub fragment CC_ART655 in CC_COURANT {
    label fr official "Article 655";
    kind article;
    locator "article/655";
    text fr official """Article 655
La réparation et la reconstruction du mur mitoyen sont à la charge de tous ceux qui y ont droit, et proportionnellement au droit de chacun.
""";
    content_hash "sha256:021f84dfcf846b18e589dc50a29b476cb0d1b0a9a2b44f330b6e6efc3f11031b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART656")
pub fragment CC_ART656 in CC_COURANT {
    label fr official "Article 656";
    kind article;
    locator "article/656";
    text fr official """Article 656
Cependant tout copropriétaire d'un mur mitoyen peut se dispenser de contribuer aux réparations et reconstructions en abandonnant le droit de mitoyenneté, pourvu que le mur mitoyen ne soutienne pas un bâtiment qui lui appartienne.
""";
    content_hash "sha256:4ef61ee30fe68c9f7826ad7886851a3d8114e3163673005926f988a020b55c1b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART657")
pub fragment CC_ART657 in CC_COURANT {
    label fr official "Article 657";
    kind article;
    locator "article/657";
    text fr official """Article 657
Tout copropriétaire peut faire bâtir contre un mur mitoyen, et y faire placer des poutres ou solives dans toute l'épaisseur du mur, à cinquante-quatre millimètres près, sans préjudice du droit qu'a le voisin de faire réduire à l'ébauchoir la poutre jusqu'à la moitié du mur, dans le cas où il voudrait lui-même asseoir des poutres dans le même lieu, ou y adosser une cheminée.
""";
    content_hash "sha256:5f230eac9f01356bfff751d56eb38f80794e686923b80cc30ab71d5aab1d8809";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART658")
pub fragment CC_ART658 in CC_COURANT {
    label fr official "Article 658";
    kind article;
    locator "article/658";
    text fr official """Article 658
Tout copropriétaire peut faire exhausser le mur mitoyen ; mais il doit payer seul la dépense de l'exhaussement et les réparations d'entretien au-dessus de la hauteur de la clôture commune ; il doit en outre payer seul les frais d'entretien de la partie commune du mur dus à l'exhaussement et rembourser au propriétaire voisin toutes les dépenses rendues nécessaires à ce dernier par l'exhaussement.
""";
    content_hash "sha256:560dfac4e5b1fbd7df89df4133d1654ff267c947b8e5f28f8a942aade012bcdd";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART659")
pub fragment CC_ART659 in CC_COURANT {
    label fr official "Article 659";
    kind article;
    locator "article/659";
    text fr official """Article 659
Si le mur mitoyen n'est pas en état de supporter l'exhaussement, celui qui veut l'exhausser doit le faire reconstruire en entier à ses frais, et l'excédent d'épaisseur doit se prendre de son côté.
""";
    content_hash "sha256:f61d1eb2d66ff7a5fd3328e15182541c764ba3208b747bdbee82026a3728c8b6";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART660")
pub fragment CC_ART660 in CC_COURANT {
    label fr official "Article 660";
    kind article;
    locator "article/660";
    text fr official """Article 660
Le voisin qui n'a pas contribué à l'exhaussement peut en acquérir la mitoyenneté en payant la moitié de la dépense qu'il a coûté et la valeur de la moitié du sol fourni pour l'excédent d'épaisseur, s'il y en a. La dépense que l'exhaussement a coûté est estimée à la date de l'acquisition, compte tenu de l'état dans lequel se trouve la partie exhaussée du mur.
""";
    content_hash "sha256:23e96119e3b24ba5a748da4cb15c8258d9970c7e3ce05de985303d47b0e58092";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART661")
pub fragment CC_ART661 in CC_COURANT {
    label fr official "Article 661";
    kind article;
    locator "article/661";
    text fr official """Article 661
Tout propriétaire joignant un mur a la faculté de le rendre mitoyen en tout ou en partie, en remboursant au maître du mur la moitié de la dépense qu'il a coûté, ou la moitié de la dépense qu'a coûté la portion du mur qu'il veut rendre mitoyenne et la moitié de la valeur du sol sur lequel le mur est bâti. La dépense que le mur a coûté est estimée à la date de l'acquisition de sa mitoyenneté, compte tenu de l'état dans lequel il se trouve.
""";
    content_hash "sha256:be3f63959e18f1eb9361197fb251e4292c284c0db3f67adf826e901d2462b16b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART662")
pub fragment CC_ART662 in CC_COURANT {
    label fr official "Article 662";
    kind article;
    locator "article/662";
    text fr official """Article 662
L'un des voisins ne peut pratiquer dans le corps d'un mur mitoyen aucun enfoncement, ni y appliquer ou appuyer aucun ouvrage sans le consentement de l'autre, ou sans avoir, à son refus, fait régler par experts les moyens nécessaires pour que le nouvel ouvrage ne soit pas nuisible aux droits de l'autre.
""";
    content_hash "sha256:245bed10774f0c0898ad66f76d760ab0c6e328712762cb446ab38e796943dcea";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART663")
pub fragment CC_ART663 in CC_COURANT {
    label fr official "Article 663";
    kind article;
    locator "article/663";
    text fr official """Article 663
Chacun peut contraindre son voisin, dans les villes et faubourgs, à contribuer aux constructions et réparations de la clôture faisant séparation de leurs maisons, cours et jardins assis ès dites villes et faubourgs : la hauteur de la clôture sera fixée suivant les règlements particuliers ou les usages constants et reconnus et, à défaut d'usages et de règlements, tout mur de séparation entre voisins, qui sera construit ou rétabli à l'avenir, doit avoir au moins trente-deux décimètres de hauteur, compris le chaperon, dans les villes de cinquante mille âmes et au-dessus, et vingt-six décimètres dans les autres.
""";
    content_hash "sha256:25c9d9bfa1914653bf778ed5c3a78067860fc6e85703157ae913bdf66c19aca1";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART665")
pub fragment CC_ART665 in CC_COURANT {
    label fr official "Article 665";
    kind article;
    locator "article/665";
    text fr official """Article 665
Lorsqu'on reconstruit un mur mitoyen ou une maison, les servitudes actives et passives se continuent à l'égard du nouveau mur ou de la nouvelle maison, sans toutefois qu'elles puissent être aggravées, et pourvu que la reconstruction se fasse avant que la prescription soit acquise.
""";
    content_hash "sha256:9c123ecc985cedb649049dce72ef612543dfb81fd576747134ab399626f66645";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART666")
pub fragment CC_ART666 in CC_COURANT {
    label fr official "Article 666";
    kind article;
    locator "article/666";
    text fr official """Article 666
Toute clôture qui sépare des héritages est réputée mitoyenne, à moins qu'il n'y ait qu'un seul des héritages en état de clôture, ou s'il n'y a titre, prescription ou marque contraire.
Pour les fossés, il y a marque de non-mitoyenneté lorsque la levée ou le rejet de la terre se trouve d'un côté seulement du fossé.
Le fossé est censé appartenir exclusivement à celui du côté duquel le rejet se trouve.
""";
    content_hash "sha256:5f51f658a0a517a11434949993246e30519b88f1603b809d4fbd4a77caf685b8";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART667")
pub fragment CC_ART667 in CC_COURANT {
    label fr official "Article 667";
    kind article;
    locator "article/667";
    text fr official """Article 667
La clôture mitoyenne doit être entretenue à frais communs ; mais le voisin peut se soustraire à cette obligation en renonçant à la mitoyenneté.
Cette faculté cesse si le fossé sert habituellement à l'écoulement des eaux.
""";
    content_hash "sha256:e59a0805ec6f4cfe876cd17d3d59ee815d2d745cfa04656206bfac9965d0df52";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART668")
pub fragment CC_ART668 in CC_COURANT {
    label fr official "Article 668";
    kind article;
    locator "article/668";
    text fr official """Article 668
Le voisin dont l'héritage joint un fossé ou une haie non mitoyens ne peut contraindre le propriétaire de ce fossé ou de cette haie à lui céder la mitoyenneté.
Le copropriétaire d'une haie mitoyenne peut la détruire jusqu'à la limite de sa propriété, à la charge de construire un mur sur cette limite.
La même règle est applicable au copropriétaire d'un fossé mitoyen qui ne sert qu'à la clôture.
""";
    content_hash "sha256:33e60f910593b729b55841cdecead1ec44f2605a8d10006f6f8363e4170ec436";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART669")
pub fragment CC_ART669 in CC_COURANT {
    label fr official "Article 669";
    kind article;
    locator "article/669";
    text fr official """Article 669
Tant que dure la mitoyenneté de la haie, les produits en appartiennent aux propriétaires par moitié.
""";
    content_hash "sha256:dccd71d4141849b36dc58e9aca5380e76e0b7be822e9b12b862109015db5915d";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART670")
pub fragment CC_ART670 in CC_COURANT {
    label fr official "Article 670";
    kind article;
    locator "article/670";
    text fr official """Article 670
Les arbres qui se trouvent dans la haie mitoyenne sont mitoyens comme la haie. Les arbres plantés sur la ligne séparative de deux héritages sont aussi réputés mitoyens. Lorsqu'ils meurent ou lorsqu'ils sont coupés ou arrachés, ces arbres sont partagés par moitié. Les fruits sont recueillis à frais communs et partagés aussi par moitié, soit qu'ils tombent naturellement, soit que la chute en ait été provoquée, soit qu'ils aient été cueillis.
Chaque propriétaire a le droit d'exiger que les arbres mitoyens soient arrachés.
""";
    content_hash "sha256:737ab15e3d4e17ec1d47005f184446d2c46844036fec83103b36c193b041a7a6";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART671")
pub fragment CC_ART671 in CC_COURANT {
    label fr official "Article 671";
    kind article;
    locator "article/671";
    text fr official """Article 671
Il n'est permis d'avoir des arbres, arbrisseaux et arbustes près de la limite de la propriété voisine qu'à la distance prescrite par les règlements particuliers actuellement existants, ou par des usages constants et reconnus et, à défaut de règlements et usages, qu'à la distance de deux mètres de la ligne séparative des deux héritages pour les plantations dont la hauteur dépasse deux mètres, et à la distance d'un demi-mètre pour les autres plantations.
Les arbres, arbustes et arbrisseaux de toute espèce peuvent être plantés en espaliers, de chaque côté du mur séparatif, sans que l'on soit tenu d'observer aucune distance, mais ils ne pourront dépasser la crête du mur.
Si le mur n'est pas mitoyen, le propriétaire seul a le droit d'y appuyer les espaliers.
""";
    content_hash "sha256:bfb532d69866df80c200152864cdda5d304f7d4393d448822394bdcc5855c78c";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART672")
pub fragment CC_ART672 in CC_COURANT {
    label fr official "Article 672";
    kind article;
    locator "article/672";
    text fr official """Article 672
Le voisin peut exiger que les arbres, arbrisseaux et arbustes, plantés à une distance moindre que la distance légale, soient arrachés ou réduits à la hauteur déterminée dans l'article précédent, à moins qu'il n'y ait titre, destination du père de famille ou prescription trentenaire.
Si les arbres meurent ou s'ils sont coupés ou arrachés, le voisin ne peut les remplacer qu'en observant les distances légales.
""";
    content_hash "sha256:d95a23148fea89e278e9f2133c29d10d5fc3595e4d5832437137446c92cfa644";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART673")
pub fragment CC_ART673 in CC_COURANT {
    label fr official "Article 673";
    kind article;
    locator "article/673";
    text fr official """Article 673
Celui sur la propriété duquel avancent les branches des arbres, arbustes et arbrisseaux du voisin peut contraindre celui-ci à les couper. Les fruits tombés naturellement de ces branches lui appartiennent.
Si ce sont les racines, ronces ou brindilles qui avancent sur son héritage, il a le droit de les couper lui-même à la limite de la ligne séparative.
Le droit de couper les racines, ronces et brindilles ou de faire couper les branches des arbres, arbustes ou arbrisseaux est imprescriptible.
""";
    content_hash "sha256:da757b7f8d53be922558fde91b3775733e489d4d34ca631ed8ca812c35c39ca1";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART674")
pub fragment CC_ART674 in CC_COURANT {
    label fr official "Article 674";
    kind article;
    locator "article/674";
    text fr official """Article 674
Celui qui fait creuser un puits ou une fosse d'aisance près d'un mur mitoyen ou non,
Celui qui veut y construire cheminée ou âtre, forge, four ou fourneau,
Y adosser une étable,
Ou établir contre ce mur un magasin de sel ou amas de matières corrosives,
Est obligé à laisser la distance prescrite par les règlements et usages particuliers sur ces objets, ou à faire les ouvrages prescrits par les mêmes règlements et usages, pour éviter de nuire au voisin.
""";
    content_hash "sha256:f473f4ce598c30f6d60826c87035f3283f26804c364951289c8d9a89bf135aa4";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART675")
pub fragment CC_ART675 in CC_COURANT {
    label fr official "Article 675";
    kind article;
    locator "article/675";
    text fr official """Article 675
L'un des voisins ne peut, sans le consentement de l'autre, pratiquer dans le mur mitoyen aucune fenêtre ou ouverture, en quelque manière que ce soit, même à verre dormant.
""";
    content_hash "sha256:b29ee5140f0c95f1ca4c50c53eb2d95dcad3a64b29ca765c417a27d221a43486";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART676")
pub fragment CC_ART676 in CC_COURANT {
    label fr official "Article 676";
    kind article;
    locator "article/676";
    text fr official """Article 676
Le propriétaire d'un mur non mitoyen, joignant immédiatement l'héritage d'autrui, peut pratiquer dans ce mur des jours ou fenêtres à fer maillé et verre dormant.
Ces fenêtres doivent être garnies d'un treillis de fer dont les mailles auront un décimètre (environ trois pouces huit lignes) d'ouverture au plus et d'un châssis à verre dormant.
""";
    content_hash "sha256:5ebb763829260fed18bdcffe7516aa6e34fdf567550fa3d5fd72bf449d1ceeeb";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART677")
pub fragment CC_ART677 in CC_COURANT {
    label fr official "Article 677";
    kind article;
    locator "article/677";
    text fr official """Article 677
Ces fenêtres ou jours ne peuvent être établis qu'à vingt-six décimètres (huit pieds) au-dessus du plancher ou sol de la chambre qu'on veut éclairer, si c'est à rez-de-chaussée, et à dix-neuf décimètres (six pieds) au-dessus du plancher pour les étages supérieurs.
""";
    content_hash "sha256:250e21a98fbde26fcbd8b329dbc53cb81e386087641267637a22fbcc052a1fac";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART678")
pub fragment CC_ART678 in CC_COURANT {
    label fr official "Article 678";
    kind article;
    locator "article/678";
    text fr official """Article 678
On ne peut avoir des vues droites ou fenêtres d'aspect, ni balcons ou autres semblables saillies sur l'héritage clos ou non clos de son voisin, s'il n'y a dix-neuf décimètres de distance entre le mur où on les pratique et ledit héritage, à moins que le fonds ou la partie du fonds sur lequel s'exerce la vue ne soit déjà grevé, au profit du fonds qui en bénéficie, d'une servitude de passage faisant obstacle à l'édification de constructions.
""";
    content_hash "sha256:8c10e77ac6e949d57d45e9bd9c8f520b7eebc71ffce28d116c960a7c3de225eb";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART679")
pub fragment CC_ART679 in CC_COURANT {
    label fr official "Article 679";
    kind article;
    locator "article/679";
    text fr official """Article 679
On ne peut, sous la même réserve, avoir des vues par côté ou obliques sur le même héritage, s'il n'y a six décimètres de distance.
""";
    content_hash "sha256:df17fba9cec3c114840d260286074eb2c4eb5d63e54bd26e984136405ed559b2";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART680")
pub fragment CC_ART680 in CC_COURANT {
    label fr official "Article 680";
    kind article;
    locator "article/680";
    text fr official """Article 680
La distance dont il est parlé dans les deux articles précédents se compte depuis le parement extérieur du mur où l'ouverture se fait, et, s'il y a balcons ou autres semblables saillies, depuis leur ligne extérieure jusqu'à la ligne de séparation des deux propriétés.
""";
    content_hash "sha256:577d118522a887a12d4bfb63049bef47201c9467c64bc6c45e915ff25486b8a8";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART681")
pub fragment CC_ART681 in CC_COURANT {
    label fr official "Article 681";
    kind article;
    locator "article/681";
    text fr official """Article 681
Tout propriétaire doit établir des toits de manière que les eaux pluviales s'écoulent sur son terrain ou sur la voie publique ; il ne peut les faire verser sur le fonds de son voisin.
""";
    content_hash "sha256:7992ecfe9a8f9ac584a895f4658585dc51ba05c8fab0531edf1bbbf8c9bb97ef";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART682")
pub fragment CC_ART682 in CC_COURANT {
    label fr official "Article 682";
    kind article;
    locator "article/682";
    text fr official """Article 682
Le propriétaire dont les fonds sont enclavés et qui n'a sur la voie publique aucune issue, ou qu'une issue insuffisante, soit pour l'exploitation agricole, industrielle ou commerciale de sa propriété, soit pour la réalisation d'opérations de construction ou de lotissement, est fondé à réclamer sur les fonds de ses voisins un passage suffisant pour assurer la desserte complète de ses fonds, à charge d'une indemnité proportionnée au dommage qu'il peut occasionner.
""";
    content_hash "sha256:825111782ef5421874f4f96d2f9b56eb52c2ff42f3afbbede573533229bd2af1";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART683")
pub fragment CC_ART683 in CC_COURANT {
    label fr official "Article 683";
    kind article;
    locator "article/683";
    text fr official """Article 683
Le passage doit régulièrement être pris du côté où le trajet est le plus court du fonds enclavé à la voie publique.
Néanmoins, il doit être fixé dans l'endroit le moins dommageable à celui sur le fonds duquel il est accordé.
""";
    content_hash "sha256:9708015a87b644358151fc693503097b10f645d20c2e90a5277c6a078e512181";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART684")
pub fragment CC_ART684 in CC_COURANT {
    label fr official "Article 684";
    kind article;
    locator "article/684";
    text fr official """Article 684
Si l'enclave résulte de la division d'un fonds par suite d'une vente, d'un échange, d'un partage ou de tout autre contrat, le passage ne peut être demandé que sur les terrains qui ont fait l'objet de ces actes.
Toutefois, dans le cas où un passage suffisant ne pourrait être établi sur les fonds divisés, l'article 682 serait applicable.
""";
    content_hash "sha256:1cc7f3f7dfec2d074244b1e65b8ca59cbe0ea2c1af940140fa7c0b3b6fed2eaa";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART685")
pub fragment CC_ART685 in CC_COURANT {
    label fr official "Article 685";
    kind article;
    locator "article/685";
    text fr official """Article 685
L'assiette et le mode de servitude de passage pour cause d'enclave sont déterminés par trente ans d'usage continu.
L'action en indemnité, dans le cas prévu par l'article 682, est prescriptible, et le passage peut être continué, quoique l'action en indemnité ne soit plus recevable.
""";
    content_hash "sha256:f388723d2ee0e718a5fe0b36faae32b1ad5669402133320e4250d185f7c17ebc";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART685_1")
pub fragment CC_ART685_1 in CC_COURANT {
    label fr official "Article 685-1";
    kind article;
    locator "article/685-1";
    text fr official """Article 685-1
En cas de cessation de l'enclave et quelle que soit la manière dont l'assiette et le mode de la servitude ont été déterminés, le propriétaire du fonds servant peut, à tout moment, invoquer l'extinction de la servitude si la desserte du fonds dominant est assurée dans les conditions de l'article 682.
A défaut d'accord amiable, cette disparition est constatée par une décision de justice.
""";
    content_hash "sha256:02ef64f01a9f521a35393b279d93991cf6b1e2a40a85564d04fff2e94c188751";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART686")
pub fragment CC_ART686 in CC_COURANT {
    label fr official "Article 686";
    kind article;
    locator "article/686";
    text fr official """Article 686
Il est permis aux propriétaires d'établir sur leurs propriétés, ou en faveur de leurs propriétés, telles servitudes que bon leur semble, pourvu néanmoins que les services établis ne soient imposés ni à la personne, ni en faveur de la personne, mais seulement à un fonds et pour un fonds, et pourvu que ces services n'aient d'ailleurs rien de contraire à l'ordre public.
L'usage et l'étendue des servitudes ainsi établies se règlent par le titre qui les constitue ; à défaut de titre, par les règles ci-après.
""";
    content_hash "sha256:7cf06968de0579358f103721120270657f90124e49452d999f4c59e22b926b20";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART687")
pub fragment CC_ART687 in CC_COURANT {
    label fr official "Article 687";
    kind article;
    locator "article/687";
    text fr official """Article 687
Les servitudes sont établies ou pour l'usage des bâtiments, ou pour celui des fonds de terre.
Celles de la première espèce s'appellent " urbaines ", soit que les bâtiments auxquels elles sont dues soient situés à la ville ou à la campagne.
Celles de la seconde espèce se nomment " rurales ".
""";
    content_hash "sha256:8dc727ca03bfc7ab3da61d9588c619de5743e289b47b9788fd4b9c40044e464f";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART688")
pub fragment CC_ART688 in CC_COURANT {
    label fr official "Article 688";
    kind article;
    locator "article/688";
    text fr official """Article 688
Les servitudes sont ou continues, ou discontinues.
Les servitudes continues sont celles dont l'usage est ou peut être continuel sans avoir besoin du fait actuel de l'homme : tels sont les conduites d'eau, les égouts, les vues et autres de cette espèce.
Les servitudes discontinues sont celles qui ont besoin du fait actuel de l'homme pour être exercées : tels sont les droits de passage, puisage, pacage et autres semblables.
""";
    content_hash "sha256:be6372aff3cc7e9d97d864b9869eaadb0822bcd245abee8f0ae935fef91c58fe";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART689")
pub fragment CC_ART689 in CC_COURANT {
    label fr official "Article 689";
    kind article;
    locator "article/689";
    text fr official """Article 689
Les servitudes sont apparentes ou non apparentes.
Les servitudes apparentes sont celles qui s'annoncent par des ouvrages extérieurs, tels qu'une porte, une fenêtre, un aqueduc.
Les servitudes non apparentes sont celles qui n'ont pas de signe extérieur de leur existence, comme, par exemple, la prohibition de bâtir sur un fonds, ou de ne bâtir qu'à une hauteur déterminée.
""";
    content_hash "sha256:2f56924fd6e62db58f403fa44171d9633dfbd6ea667626007330a2363b96ad56";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART690")
pub fragment CC_ART690 in CC_COURANT {
    label fr official "Article 690";
    kind article;
    locator "article/690";
    text fr official """Article 690
Les servitudes continues et apparentes s'acquièrent par titre, ou par la possession de trente ans.
""";
    content_hash "sha256:ba3bd7ce9e1a37b51456a385e10c31354e2c93df18eabc2c4dcbe57769765632";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART691")
pub fragment CC_ART691 in CC_COURANT {
    label fr official "Article 691";
    kind article;
    locator "article/691";
    text fr official """Article 691
Les servitudes continues non apparentes, et les servitudes discontinues apparentes ou non apparentes, ne peuvent s'établir que par titres.
La possession même immémoriale ne suffit pas pour les établir, sans cependant qu'on puisse attaquer aujourd'hui les servitudes de cette nature déjà acquises par la possession, dans les pays où elles pouvaient s'acquérir de cette manière.
""";
    content_hash "sha256:508f96f263874219a85c948bc51c43068f853bac44d6f19980f031152e5643de";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART692")
pub fragment CC_ART692 in CC_COURANT {
    label fr official "Article 692";
    kind article;
    locator "article/692";
    text fr official """Article 692
La destination du père de famille vaut titre à l'égard des servitudes continues et apparentes.
""";
    content_hash "sha256:d9f283b9cac743aed73d20d470e50e6bffe4fd0891005315aca2a58c7d371792";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART693")
pub fragment CC_ART693 in CC_COURANT {
    label fr official "Article 693";
    kind article;
    locator "article/693";
    text fr official """Article 693
Il n'y a destination du père de famille que lorsqu'il est prouvé que les deux fonds actuellement divisés ont appartenu au même propriétaire, et que c'est par lui que les choses ont été mises dans l'état duquel résulte la servitude.
""";
    content_hash "sha256:2628541c1bb51e193cdf842f8e58f59302e6b32e3896c276f03090e59a77dede";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART694")
pub fragment CC_ART694 in CC_COURANT {
    label fr official "Article 694";
    kind article;
    locator "article/694";
    text fr official """Article 694
Si le propriétaire de deux héritages entre lesquels il existe un signe apparent de servitude, dispose de l'un des héritages sans que le contrat contienne aucune convention relative à la servitude, elle continue d'exister activement ou passivement en faveur du fonds aliéné ou sur le fonds aliéné.
""";
    content_hash "sha256:a84280df430b2bf3bd8dbeef6799824cf4589ac123d2fb8b7125070237bf3157";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART695")
pub fragment CC_ART695 in CC_COURANT {
    label fr official "Article 695";
    kind article;
    locator "article/695";
    text fr official """Article 695
Le titre constitutif de la servitude, à l'égard de celles qui ne peuvent s'acquérir par la prescription, ne peut être remplacé que par un titre récognitif de la servitude, et émané du propriétaire du fonds asservi.
""";
    content_hash "sha256:d15eb2c3b93451ba8d7a40123ffe7672c63b70d357156497b0c6980be918e767";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART696")
pub fragment CC_ART696 in CC_COURANT {
    label fr official "Article 696";
    kind article;
    locator "article/696";
    text fr official """Article 696
Quand on établit une servitude, on est censé accorder tout ce qui est nécessaire pour en user.
Ainsi la servitude de puiser l'eau à la fontaine d'autrui emporte nécessairement le droit de passage.
""";
    content_hash "sha256:a64c6dfb23b8a2e49f420c488681426451fec5589a8b5056c1c4b182fa199361";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART697")
pub fragment CC_ART697 in CC_COURANT {
    label fr official "Article 697";
    kind article;
    locator "article/697";
    text fr official """Article 697
Celui auquel est due une servitude a droit de faire tous les ouvrages nécessaires pour en user et pour la conserver.
""";
    content_hash "sha256:ea379ca72bd526c2b43111ee459119c1cb47f8d73a9df048e8167c9e35f05e2b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART698")
pub fragment CC_ART698 in CC_COURANT {
    label fr official "Article 698";
    kind article;
    locator "article/698";
    text fr official """Article 698
Ces ouvrages sont à ses frais, et non à ceux du propriétaire du fonds assujetti, à moins que le titre d'établissement de la servitude ne dise le contraire.
""";
    content_hash "sha256:98900b23a7234a527d76abec3f7ae00096ff008fa31d1bbf7677c08a2f8df673";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART699")
pub fragment CC_ART699 in CC_COURANT {
    label fr official "Article 699";
    kind article;
    locator "article/699";
    text fr official """Article 699
Dans le cas même où le propriétaire du fonds assujetti est chargé par le titre de faire à ses frais les ouvrages nécessaires pour l'usage ou la conservation de la servitude, il peut toujours s'affranchir de la charge, en abandonnant le fonds assujetti au propriétaire du fonds auquel la servitude est due.
""";
    content_hash "sha256:c44140c773ae16911cc1390480d221db285ab72e364702d91cf0e18ae2f2fbcf";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART700")
pub fragment CC_ART700 in CC_COURANT {
    label fr official "Article 700";
    kind article;
    locator "article/700";
    text fr official """Article 700
Si l'héritage pour lequel la servitude a été établie vient à être divisé, la servitude reste due pour chaque portion, sans néanmoins que la condition du fonds assujetti soit aggravée.
Ainsi, par exemple, s'il s'agit d'un droit de passage, tous les copropriétaires seront obligés de l'exercer par le même endroit.
""";
    content_hash "sha256:67afbdd15d8c72d3ff2e273c483fc4327e9f17430a9c6ddf1a7cf344cec6cdc5";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART701")
pub fragment CC_ART701 in CC_COURANT {
    label fr official "Article 701";
    kind article;
    locator "article/701";
    text fr official """Article 701
Le propriétaire du fonds débiteur de la servitude ne peut rien faire qui tende à en diminuer l'usage, ou à le rendre plus incommode.
Ainsi, il ne peut changer l'état des lieux, ni transporter l'exercice de la servitude dans un endroit différent de celui où elle a été primitivement assignée.
Mais cependant, si cette assignation primitive était devenue plus onéreuse au propriétaire du fonds assujetti, ou si elle l'empêchait d'y faire des réparations avantageuses, il pourrait offrir au propriétaire de l'autre fonds un endroit aussi commode pour l'exercice de ses droits, et celui-ci ne pourrait pas le refuser.
""";
    content_hash "sha256:606f9617db194f3ccd7038ba3e44bc368c2955589724563aa336c1f35567510a";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART702")
pub fragment CC_ART702 in CC_COURANT {
    label fr official "Article 702";
    kind article;
    locator "article/702";
    text fr official """Article 702
De son côté, celui qui a un droit de servitude ne peut en user que suivant son titre, sans pouvoir faire, ni dans le fonds qui doit la servitude, ni dans le fonds à qui elle est due, de changement qui aggrave la condition du premier.
""";
    content_hash "sha256:c527fb7bbf6e736f6fbb6cf0ddc502aa84cf1aa3278d8574d6da978bbdcbf2a9";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART703")
pub fragment CC_ART703 in CC_COURANT {
    label fr official "Article 703";
    kind article;
    locator "article/703";
    text fr official """Article 703
Les servitudes cessent lorsque les choses se trouvent en tel état qu'on ne peut plus en user.
""";
    content_hash "sha256:678afc3a7ad4d716223b6e6878be5cf2f71b301444e25524e2ab563620c1836c";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART704")
pub fragment CC_ART704 in CC_COURANT {
    label fr official "Article 704";
    kind article;
    locator "article/704";
    text fr official """Article 704
Elles revivent si les choses sont rétablies de manière qu'on puisse en user ; à moins qu'il ne se soit déjà écoulé un espace de temps suffisant pour faire présumer l'extinction de la servitude, ainsi qu'il est dit à l'article 707.
""";
    content_hash "sha256:3dba4955044c34a28710bb07fcc388fda426b7f408fb62b3290c5af404c4694c";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART705")
pub fragment CC_ART705 in CC_COURANT {
    label fr official "Article 705";
    kind article;
    locator "article/705";
    text fr official """Article 705
Toute servitude est éteinte lorsque le fonds à qui elle est due, et celui qui la doit, sont réunis dans la même main.
""";
    content_hash "sha256:22438de2a95bcff5fe681d4211a6cc698cf5b884bfe03be7bed26c9a7d42a250";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART706")
pub fragment CC_ART706 in CC_COURANT {
    label fr official "Article 706";
    kind article;
    locator "article/706";
    text fr official """Article 706
La servitude est éteinte par le non-usage pendant trente ans.
""";
    content_hash "sha256:38ad7a90a95e8aabfe26df7240021ca1ed7e2adb1ad728a26a40362f3d8436f9";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART707")
pub fragment CC_ART707 in CC_COURANT {
    label fr official "Article 707";
    kind article;
    locator "article/707";
    text fr official """Article 707
Les trente ans commencent à courir, selon les diverses espèces de servitudes, ou du jour où l'on a cessé d'en jouir, lorsqu'il s'agit de servitudes discontinues, ou du jour où il a été fait un acte contraire à la servitude, lorsqu'il s'agit de servitudes continues.
""";
    content_hash "sha256:c1cd09cf6bf8b50a74e5be4c63118450da3becdcab455ef76357acfcb7177706";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART708")
pub fragment CC_ART708 in CC_COURANT {
    label fr official "Article 708";
    kind article;
    locator "article/708";
    text fr official """Article 708
Le mode de la servitude peut se prescrire comme la servitude même, et de la même manière.
""";
    content_hash "sha256:3a8f8a5c90edd8064997835dd861715ec5ed3c87c44c9416216ce3e8247db6ac";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART709")
pub fragment CC_ART709 in CC_COURANT {
    label fr official "Article 709";
    kind article;
    locator "article/709";
    text fr official """Article 709
Si l'héritage en faveur duquel la servitude est établie appartient à plusieurs par indivis, la jouissance de l'un empêche la prescription à l'égard de tous.
""";
    content_hash "sha256:24172d01b3abe28ae5c085ca8bdad1170b025d0cd12750fdbfc422fcf7647960";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART710")
pub fragment CC_ART710 in CC_COURANT {
    label fr official "Article 710";
    kind article;
    locator "article/710";
    text fr official """Article 710
Si, parmi les copropriétaires, il s'en trouve un contre lequel la prescription n'ait pu courir, comme un mineur, il aura conservé le droit de tous les autres.
""";
    content_hash "sha256:e9acea8b48ec58e4434aff99627fd3e44c1c5d3db57c8db9ea4f51ed75a6fc76";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART710_1")
pub fragment CC_ART710_1 in CC_COURANT {
    label fr official "Article 710-1";
    kind article;
    locator "article/710-1";
    text fr official """Article 710-1
Tout acte ou droit doit, pour donner lieu aux formalités de publicité foncière, résulter d'un acte reçu en la forme authentique par un notaire exerçant en France, d'une décision juridictionnelle ou d'un acte authentique émanant d'une autorité administrative.
Le dépôt au rang des minutes d'un notaire d'un acte sous seing privé, contresigné ou non, même avec reconnaissance d'écriture et de signature, ne peut donner lieu aux formalités de publicité foncière. Toutefois, même lorsqu'ils ne sont pas dressés en la forme authentique, les procès-verbaux des délibérations des assemblées générales préalables ou consécutives à l'apport de biens ou droits immobiliers à une société ou par une société ainsi que les procès-verbaux d'abornement peuvent être publiés au bureau des hypothèques à la condition d'être annexés à un acte qui en constate le dépôt au rang des minutes d'un notaire.
Le premier alinéa n'est pas applicable aux formalités de publicité foncière des assignations en justice, des commandements valant saisie, des différents actes de procédure qui s'y rattachent et des jugements d'adjudication, des documents portant limitation administrative au droit de propriété ou portant servitude administrative, des procès-verbaux établis par le service du cadastre, des documents d'arpentage établis par un géomètre et des modifications provenant de décisions administratives ou d'événements naturels.
""";
    content_hash "sha256:d1799eeb496feb9dee0693a5726ecbe8c9a064a3456457af94b7821e338e2572";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART711")
pub fragment CC_ART711 in CC_COURANT {
    label fr official "Article 711";
    kind article;
    locator "article/711";
    text fr official """Article 711
La propriété des biens s'acquiert et se transmet par succession, par donation entre vifs ou testamentaire, et par l'effet des obligations.
""";
    content_hash "sha256:cd8962dce723204d614d137b3688afcadcce9c4d7d98a129be307f2e1c90359b";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART712")
pub fragment CC_ART712 in CC_COURANT {
    label fr official "Article 712";
    kind article;
    locator "article/712";
    text fr official """Article 712
La propriété s'acquiert aussi par accession ou incorporation, et par prescription.
""";
    content_hash "sha256:044a90312aa619b479599d42e3486ca53dacee3d2c2478f84225af36155f87eb";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART713")
pub fragment CC_ART713 in CC_COURANT {
    label fr official "Article 713";
    kind article;
    locator "article/713";
    text fr official """Article 713
Les biens qui n'ont pas de maître appartiennent à la commune sur le territoire de laquelle ils sont situés. Par délibération du conseil municipal, la commune peut renoncer à exercer ses droits, sur tout ou partie de son territoire, au profit de l'établissement public de coopération intercommunale à fiscalité propre dont elle est membre. Les biens sans maître sont alors réputés appartenir à l'établissement public de coopération intercommunale à fiscalité propre.
Si la commune ou l'établissement public de coopération intercommunale à fiscalité propre renonce à exercer ses droits, la propriété est transférée de plein droit :
1° Pour les biens situés dans les zones définies à l'article L. 322-1 du code de l'environnement, au Conservatoire de l'espace littoral et des rivages lacustres lorsqu'il en fait la demande ou, à défaut, au conservatoire régional d'espaces naturels agréé au titre de l'article L. 414-11 du même code lorsqu'il en fait la demande ou, à défaut, à l'Etat ;
2° Pour les autres biens, après accord du représentant de l'Etat dans la région, au conservatoire régional d'espaces naturels agréé au titre du même article L. 414-11 lorsqu'il en fait la demande ou, à défaut, à l'Etat.
""";
    content_hash "sha256:18afaf914f5c4d2ffcd30b95f20df70fbff4ce4a97a38d8e1440f5c18255e0e6";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART714")
pub fragment CC_ART714 in CC_COURANT {
    label fr official "Article 714";
    kind article;
    locator "article/714";
    text fr official """Article 714
Il est des choses qui n'appartiennent à personne et dont l'usage est commun à tous.
Des lois de police règlent la manière d'en jouir.
""";
    content_hash "sha256:ed5feab57ed5b4a17e967872fdc77c8d580d5e9fbc4c2e45774ce77a38832556";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART715")
pub fragment CC_ART715 in CC_COURANT {
    label fr official "Article 715";
    kind article;
    locator "article/715";
    text fr official """Article 715
La faculté de chasser ou de pêcher est également réglée par des lois particulières.
""";
    content_hash "sha256:6daa4746f86be81480e77e1f75c92a1b5b7f3b73596b4d04a678f7170f1097be";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART716")
pub fragment CC_ART716 in CC_COURANT {
    label fr official "Article 716";
    kind article;
    locator "article/716";
    text fr official """Article 716
La propriété d'un trésor appartient à celui qui le trouve dans son propre fonds ; si le trésor est trouvé dans le fonds d'autrui, il appartient pour moitié à celui qui l'a découvert, et pour l'autre moitié au propriétaire du fonds.
Le trésor est toute chose cachée ou enfouie sur laquelle personne ne peut justifier sa propriété, et qui est découverte par le pur effet du hasard.
""";
    content_hash "sha256:dfab6360bf236e46830ab5cbc82dd71941d0cb4bde1f0199c7b1d7635ab6eaa4";
}

@id("urn:fr:corpus:clir:code-civil-biens#CC_ART717")
pub fragment CC_ART717 in CC_COURANT {
    label fr official "Article 717";
    kind article;
    locator "article/717";
    text fr official """Article 717
Les droits sur les effets jetés à la mer, sur les objets que la mer rejette, de quelque nature qu'ils puissent être, sur les plantes et herbages qui croissent sur les rivages de la mer, sont aussi réglés par des lois particulières.
Il en est de même des choses perdues dont le maître ne se représente pas.
""";
    content_hash "sha256:e39a2448aef1d5491846c4d910647e2e766547a26fda5b94f9d7c7bd0ad2c955";
}

// END GENERATED FRAGMENTS
