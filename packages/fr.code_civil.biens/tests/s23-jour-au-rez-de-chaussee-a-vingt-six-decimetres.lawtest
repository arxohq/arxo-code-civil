language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 676 et 677. Le jour à fer maillé exige des mailles d'un décimètre au
// plus, un châssis à verre dormant, et vingt-six décimètres au-dessus du
// plancher au rez-de-chaussée : ici tout est juste atteint.
test "urn:query:fr-code-civil-biens-s23-jour-rez-de-chaussee-vingt-six-decimetres" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": ouverture_dans(entity_ref("urn:fr:cc:biens:s23:O"), entity_ref("urn:fr:cc:biens:s23:M")) { origin case_input; }
        assert "f2": espece_de_l_ouverture(entity_ref("urn:fr:cc:biens:s23:O"), JourAFerMailleEtVerreDormant) { origin case_input; }
        assert "f3": ouverture_du_treillis(entity_ref("urn:fr:cc:biens:s23:O"), 1 dm) { origin case_input; }
        assert "f4": chassis_a_verre_dormant(entity_ref("urn:fr:cc:biens:s23:O")) { origin case_input; }
        assert "f5": niveau_de_l_ouverture(entity_ref("urn:fr:cc:biens:s23:O"), RezDeChaussee) { origin case_input; }
        assert "f6": hauteur_au_dessus_du_plancher(entity_ref("urn:fr:cc:biens:s23:O"), 26 dm) { origin case_input; }
    }
    evaluate truth(jour_a_la_hauteur_requise(entity_ref("urn:fr:cc:biens:s23:O")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
