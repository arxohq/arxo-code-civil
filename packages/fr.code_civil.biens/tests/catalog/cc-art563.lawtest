language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ALIENATIONDELANCIENLITFAUTEDEDECLARATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": echeance_de_la_declaration_le(entity_ref("urn:law:catalog:alienationdelancienlitfautededeclaration:v0"), @2026-01-15) { origin case_input; }
        assert "cat-1": declaration_d_intention_d_acquerir_le(entity_ref("urn:law:catalog:alienationdelancienlitfautededeclaration:v0"), entity_ref("urn:law:catalog:alienationdelancienlitfautededeclaration:v1"), @2026-01-16) { origin case_input; }
        assert "cat-2": ancien_lit_abandonne(entity_ref("urn:law:catalog:alienationdelancienlitfautededeclaration:v0"), entity_ref("urn:law:catalog:alienationdelancienlitfautededeclaration:v1")) { origin case_input; }
    }
    evaluate truth(alienation_de_l_ancien_lit(entity_ref("urn:law:catalog:alienationdelancienlitfautededeclaration:v0")));
    expect truth_status == TRUE_ONLY;
}
