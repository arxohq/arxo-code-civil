language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-REGIMEDESIMMEUBLESANIMAUXDUFERMIER" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": livre_au_fermier_ou_metayer_pour_la_culture(entity_ref("urn:law:catalog:regimedesimmeublesanimauxdufermier:v0"), entity_ref("urn:law:catalog:regimedesimmeublesanimauxdufermier:v1")) { origin case_input; }
        assert "cat-1": attache_au_fonds_par_l_effet_de_la_convention(entity_ref("urn:law:catalog:regimedesimmeublesanimauxdufermier:v0"), entity_ref("urn:law:catalog:regimedesimmeublesanimauxdufermier:v1")) { origin case_input; }
    }
    evaluate truth(soumis_au_regime_des_immeubles(entity_ref("urn:law:catalog:regimedesimmeublesanimauxdufermier:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-REGIMEDESMEUBLESCHEPTELATIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": donne_a_cheptel_a_un_autre_que_le_fermier(entity_ref("urn:law:catalog:regimedesmeublescheptelatiers:v0"), entity_ref("urn:law:catalog:regimedesmeublescheptelatiers:v1")) { origin case_input; }
    }
    evaluate truth(soumis_au_regime_des_meubles(entity_ref("urn:law:catalog:regimedesmeublescheptelatiers:v0")));
    expect truth_status == TRUE_ONLY;
}
