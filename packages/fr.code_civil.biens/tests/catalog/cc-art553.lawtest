language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-PRESOMPTIONDELOUVRAGEDUPROPRIETAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": ouvrage_sur(entity_ref("urn:law:catalog:presomptiondelouvrageduproprietaire:v0"), entity_ref("urn:law:catalog:presomptiondelouvrageduproprietaire:v1")) { origin case_input; }
        assert "cat-1": proprietaire_du_bien(entity_ref("urn:law:catalog:presomptiondelouvrageduproprietaire:v1"), entity_ref("urn:law:catalog:presomptiondelouvrageduproprietaire:v2")) { origin case_input; }
    }
    evaluate truth(presume_fait_par_le_proprietaire(entity_ref("urn:law:catalog:presomptiondelouvrageduproprietaire:v0"), entity_ref("urn:law:catalog:presomptiondelouvrageduproprietaire:v2")));
    expect truth_status == TRUE_ONLY;
}
