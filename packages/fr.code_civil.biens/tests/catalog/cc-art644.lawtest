language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CHARGEDERENDRELEAUASONCOURSORDINAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": eau_courante_traversant_l_heritage(entity_ref("urn:law:catalog:chargederendreleauasoncoursordinaire:v0")) { origin case_input; }
    }
    evaluate truth(charge_de_rendre_l_eau_a_son_cours_ordinaire(entity_ref("urn:law:catalog:chargederendreleauasoncoursordinaire:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-DROITDIRRIGATIONDURIVERAIN" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": propriete_bordant_une_eau_courante(entity_ref("urn:law:catalog:droitdirrigationduriverain:v0")) { origin case_input; }
    }
    evaluate truth(droit_d_irrigation_au_passage(entity_ref("urn:law:catalog:droitdirrigationduriverain:v0")));
    expect truth_status == TRUE_ONLY;
}
