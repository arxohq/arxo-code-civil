language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CESSIONFORCEEADMISE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cause_d_utilite_publique_declaree(entity_ref("urn:law:catalog:cessionforceeadmise:v0")) { origin case_input; }
        assert "cat-1": juste_et_prealable_indemnite_versee(entity_ref("urn:law:catalog:cessionforceeadmise:v0")) { origin case_input; }
        assert "cat-2": proprietaire_du_bien(entity_ref("urn:law:catalog:cessionforceeadmise:v0"), entity_ref("urn:law:catalog:cessionforceeadmise:v1")) { origin case_input; }
    }
    evaluate truth(cession_forcee_admise(entity_ref("urn:law:catalog:cessionforceeadmise:v0"), entity_ref("urn:law:catalog:cessionforceeadmise:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CESSIONFORCEEINTERDITEFAUTEDINDEMNITE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": proprietaire_du_bien(entity_ref("urn:law:catalog:cessionforceeinterditefautedindemnite:v0"), entity_ref("urn:law:catalog:cessionforceeinterditefautedindemnite:v1")) { origin case_input; }
    }
    evaluate truth(cession_forcee_interdite(entity_ref("urn:law:catalog:cessionforceeinterditefautedindemnite:v0"), entity_ref("urn:law:catalog:cessionforceeinterditefautedindemnite:v1")));
    expect truth_status == TRUE_ONLY;
}
