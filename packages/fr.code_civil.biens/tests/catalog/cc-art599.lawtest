}

// 
test "CATALOG-PROPRIETAIRENENUITPASALUSUFRUITIER" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": nu_proprietaire(entity_ref("urn:law:catalog:proprietairenenuitpasalusufruitier:v0"), entity_ref("urn:law:catalog:proprietairenenuitpasalusufruitier:v1")) { origin case_input; }
    }
    evaluate truth(le_proprietaire_ne_peut_nuire_aux_droits_de_l_usufruitier(entity_ref("urn:law:catalog:proprietairenenuitpasalusufruitier:v0"), entity_ref("urn:law:catalog:proprietairenenuitpasalusufruitier:v1")));
    expect truth_status == TRUE_ONLY;
