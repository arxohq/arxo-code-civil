        assert "cat-0": usufruitier(entity_ref("urn:law:catalog:pasdindemnitepourlesameliorations:v0"), entity_ref("urn:law:catalog:pasdindemnitepourlesameliorations:v1")) { origin case_input; }
    }
    evaluate truth(aucune_indemnite_pour_les_ameliorations(entity_ref("urn:law:catalog:pasdindemnitepourlesameliorations:v0"), entity_ref("urn:law:catalog:pasdindemnitepourlesameliorations:v1")));
