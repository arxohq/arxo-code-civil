language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ESPALIERSURMURNONMITOYEN" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cloture_separant(entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v0"), entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v1"), entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v2"), entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v3")) { origin case_input; }
        assert "cat-1": appartient_exclusivement_a(entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v0"), entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v1")) { origin case_input; }
    }
    evaluate truth(droit_exclusif_d_appuyer_les_espaliers(entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v0"), entity_ref("urn:law:catalog:espaliersurmurnonmitoyen:v1")));
    expect truth_status == TRUE_ONLY;
}
