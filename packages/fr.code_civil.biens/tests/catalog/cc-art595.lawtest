language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-BAILRURALOUCOMMERCIALSANSCONCOURS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": bail_de_l_usufruitier(entity_ref("urn:law:catalog:bailruraloucommercialsansconcours:v0"), entity_ref("urn:law:catalog:bailruraloucommercialsansconcours:v1")) { origin case_input; }
        assert "cat-1": espece_du_bien_baille(entity_ref("urn:law:catalog:bailruraloucommercialsansconcours:v0"), ImmeubleCommercialIndustrielOuArtisanal) { origin case_input; }
    }
    evaluate truth(bail_nul_faute_de_concours(entity_ref("urn:law:catalog:bailruraloucommercialsansconcours:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-FACULTEDEBAILLERDEVENDREOUDECEDER" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": usufruitier(entity_ref("urn:law:catalog:facultedebaillerdevendreoudeceder:v0"), entity_ref("urn:law:catalog:facultedebaillerdevendreoudeceder:v1")) { origin case_input; }
    }
    evaluate truth(droit_de_bailler_de_vendre_ou_de_ceder(entity_ref("urn:law:catalog:facultedebaillerdevendreoudeceder:v0"), entity_ref("urn:law:catalog:facultedebaillerdevendreoudeceder:v1")));
    expect truth_status == TRUE_ONLY;
}
