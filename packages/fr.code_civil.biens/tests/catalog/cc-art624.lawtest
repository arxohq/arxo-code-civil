language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-BATIMENTDUNDOMAINEDETRUIT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": batiment_detruit_par_incendie_accident_ou_vetuste(entity_ref("urn:law:catalog:batimentdundomainedetruit:v0")) { origin case_input; }
        assert "cat-1": usufruit_sur_un_domaine_dont_le_batiment_fait_partie(entity_ref("urn:law:catalog:batimentdundomainedetruit:v0")) { origin case_input; }
    }
    evaluate truth(jouissance_du_sol_et_des_materiaux(entity_ref("urn:law:catalog:batimentdundomainedetruit:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-BATIMENTSEULDETRUIT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": batiment_detruit_par_incendie_accident_ou_vetuste(entity_ref("urn:law:catalog:batimentseuldetruit:v0")) { origin case_input; }
        assert "cat-1": usufruit_sur_un_batiment_seul(entity_ref("urn:law:catalog:batimentseuldetruit:v0")) { origin case_input; }
    }
    evaluate truth(pas_de_jouissance_du_sol_ni_des_materiaux(entity_ref("urn:law:catalog:batimentseuldetruit:v0")));
    expect truth_status == TRUE_ONLY;
}
