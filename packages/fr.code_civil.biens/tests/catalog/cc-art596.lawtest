language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-USUFRUITIERJOUITDELALLUVION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": usufruit_sur(entity_ref("urn:law:catalog:usufruitierjouitdelalluvion:v0"), entity_ref("urn:law:catalog:usufruitierjouitdelalluvion:v1")) { origin case_input; }
        assert "cat-1": alluvion_profite_au_riverain(entity_ref("urn:law:catalog:usufruitierjouitdelalluvion:v2"), entity_ref("urn:law:catalog:usufruitierjouitdelalluvion:v3")) { origin case_input; }
    }
    evaluate truth(jouissance_de_l_augmentation_par_alluvion(entity_ref("urn:law:catalog:usufruitierjouitdelalluvion:v0"), entity_ref("urn:law:catalog:usufruitierjouitdelalluvion:v2")));
    expect truth_status == TRUE_ONLY;
}
