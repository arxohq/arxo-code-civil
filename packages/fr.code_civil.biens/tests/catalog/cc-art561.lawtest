language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ILEFORMEEDESDEUXCOTES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": ile_formee_dans_le_lit(entity_ref("urn:law:catalog:ileformeedesdeuxcotes:v0"), CoursDEauNonDomanial, LesDeuxCotes) { origin case_input; }
    }
    evaluate truth(ile_partagee_a_la_ligne_mediane(entity_ref("urn:law:catalog:ileformeedesdeuxcotes:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-ILEFORMEEDUNSEULCOTE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": ile_formee_dans_le_lit(entity_ref("urn:law:catalog:ileformeedunseulcote:v0"), CoursDEauNonDomanial, UnSeulCote) { origin case_input; }
    }
    evaluate truth(ile_appartient_aux_riverains_d_un_cote(entity_ref("urn:law:catalog:ileformeedunseulcote:v0")));
    expect truth_status == TRUE_ONLY;
}
