language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-BIENHORSDUPATRIMOINEDESPARTICULIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": n_appartient_pas_a_un_particulier(entity_ref("urn:law:catalog:bienhorsdupatrimoinedesparticuliers:v0")) { origin case_input; }
    }
    evaluate truth(inalienable_hors_des_formes_particulieres(entity_ref("urn:law:catalog:bienhorsdupatrimoinedesparticuliers:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-LIBREDISPOSITIONDUPARTICULIER" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": proprietaire_du_bien(entity_ref("urn:law:catalog:libredispositionduparticulier:v0"), entity_ref("urn:law:catalog:libredispositionduparticulier:v1")) { origin case_input; }
    }
    evaluate truth(libre_disposition(entity_ref("urn:law:catalog:libredispositionduparticulier:v0"), entity_ref("urn:law:catalog:libredispositionduparticulier:v1")));
    expect truth_status == TRUE_ONLY;
}
