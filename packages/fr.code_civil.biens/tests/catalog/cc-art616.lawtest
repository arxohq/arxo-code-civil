language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-TROUPEAUNEPERISSANTPASENTIEREMENT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": usufruit_sur_un_troupeau(entity_ref("urn:law:catalog:troupeauneperissantpasentierement:v0")) { origin case_input; }
    }
    evaluate truth(tenu_de_remplacer_jusqu_a_concurrence_du_croit(entity_ref("urn:law:catalog:troupeauneperissantpasentierement:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-TROUPEAUPERIENTIEREMENT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": usufruit_sur_un_troupeau(entity_ref("urn:law:catalog:troupeauperientierement:v0")) { origin case_input; }
        assert "cat-1": troupeau_peri_entierement_sans_faute(entity_ref("urn:law:catalog:troupeauperientierement:v0")) { origin case_input; }
    }
    evaluate truth(tenu_de_rendre_compte_des_cuirs(entity_ref("urn:law:catalog:troupeauperientierement:v0")));
    expect truth_status == TRUE_ONLY;
}
