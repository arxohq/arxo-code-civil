language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CHARGESENTIERESDELUSAGERTOTAL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": absorbe_tous_les_fruits_ou_occupe_toute_la_maison(entity_ref("urn:law:catalog:chargesentieresdelusagertotal:v0")) { origin case_input; }
    }
    evaluate truth(tenu_de_toutes_les_charges_comme_l_usufruitier(entity_ref("urn:law:catalog:chargesentieresdelusagertotal:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CONTRIBUTIONAUPRORATA" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": droit_d_usage_ou_d_habitation_sur(entity_ref("urn:law:catalog:contributionauprorata:v0"), entity_ref("urn:law:catalog:contributionauprorata:v1"), entity_ref("urn:law:catalog:contributionauprorata:v2")) { origin case_input; }
    }
    evaluate truth(contribution_au_prorata_de_la_jouissance(entity_ref("urn:law:catalog:contributionauprorata:v0")));
    expect truth_status == TRUE_ONLY;
}
