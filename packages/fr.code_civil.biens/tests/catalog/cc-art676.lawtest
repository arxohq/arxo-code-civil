language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-JOURPERMISDANSLEMURNONMITOYEN" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": ouverture_dans(entity_ref("urn:law:catalog:jourpermisdanslemurnonmitoyen:v0"), entity_ref("urn:law:catalog:jourpermisdanslemurnonmitoyen:v1")) { origin case_input; }
        assert "cat-1": ouverture_sur_l_heritage(entity_ref("urn:law:catalog:jourpermisdanslemurnonmitoyen:v0"), entity_ref("urn:law:catalog:jourpermisdanslemurnonmitoyen:v2")) { origin case_input; }
        assert "cat-2": espece_de_l_ouverture(entity_ref("urn:law:catalog:jourpermisdanslemurnonmitoyen:v0"), JourAFerMailleEtVerreDormant) { origin case_input; }
    }
    evaluate truth(jour_permis_dans_le_mur_non_mitoyen(entity_ref("urn:law:catalog:jourpermisdanslemurnonmitoyen:v0")));
    expect truth_status == TRUE_ONLY;
}
