language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ACCESSIONMOBILIERENONPREVUEREGLEEPARLEJUGE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cas_non_prevu_par_les_articles_566_a_577(entity_ref("urn:law:catalog:accessionmobilierenonprevueregleeparlejuge:v0")) { origin case_input; }
        assert "cat-1": equite_naturelle_du_cas_non_prevu(entity_ref("urn:law:catalog:accessionmobilierenonprevueregleeparlejuge:v0")) { origin case_input; }
    }
    evaluate truth(accession_mobiliere_reglee_en_equite(entity_ref("urn:law:catalog:accessionmobilierenonprevueregleeparlejuge:v0")));
    expect truth_status == TRUE_ONLY;
}
