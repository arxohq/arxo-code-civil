language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

test "urn:query:fr-code-civil-biens-p4-682-a" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": proprietaire_fonds_enclave(entity_ref("urn:p4:682:a:D"), entity_ref("urn:p4:682:a:P")) { origin case_input; }
        assert "f2": aucune_issue_sur_la_voie_publique(entity_ref("urn:p4:682:a:D")) { origin case_input; }
        assert "f3": voisin(entity_ref("urn:p4:682:a:D"), entity_ref("urn:p4:682:a:S")) { origin case_input; }
    }
    evaluate positions();
    expect position(P4PouvoirReclamerPassage682Actif, ACTIVE);
}

