language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 605, al. 2. « l'usufruitier en est AUSSI tenu » : occasionnée par le
// défaut d'entretien depuis l'ouverture, la grosse réparation pèse sur
// l'usufruitier SANS cesser de peser sur le propriétaire.
test "urn:query:fr-code-civil-biens-u07-grosse-reparation-aussi-a-l-usufruitier" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": reparation_sur(entity_ref("urn:fr:cc:biens:u07:R"), entity_ref("urn:fr:cc:biens:u07:U")) { origin case_input; }
        assert "f2": objet_de_la_reparation(entity_ref("urn:fr:cc:biens:u07:R"), CouverturesEntieres) { origin case_input; }
        assert "f3": occasionnee_par_le_defaut_d_entretien_depuis_l_ouverture(entity_ref("urn:fr:cc:biens:u07:R")) { origin case_input; }
    }
    evaluate truth(a_la_charge_de_l_usufruitier(entity_ref("urn:fr:cc:biens:u07:R")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
