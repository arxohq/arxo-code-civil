language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 559. Le témoin jumeau de a05, un jour plus tard : « après ce délai,
// il n'y sera plus recevable », le propriétaire du champ d'arrivée ayant
// pris possession.
test "urn:query:fr-code-civil-biens-a06-revendication-forclose" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": partie_emportee_par_force_subite(entity_ref("urn:fr:cc:biens:a06:A"), entity_ref("urn:fr:cc:biens:a06:ORIG"), entity_ref("urn:fr:cc:biens:a06:ARR")) { origin case_input; }
        assert "f2": jour_de_l_enlevement(entity_ref("urn:fr:cc:biens:a06:A"), @2024-03-15) { origin case_input; }
        assert "f3": demande_formee_le(entity_ref("urn:fr:cc:biens:a06:A"), @2025-03-16) { origin case_input; }
        assert "f4": possession_prise_par_le_proprietaire_du_champ_d_arrivee(entity_ref("urn:fr:cc:biens:a06:A")) { origin case_input; }
        assert "j1": partie_considerable_et_reconnaissable(entity_ref("urn:fr:cc:biens:a06:A")) { origin adjudicated; }
    }
    evaluate truth(revendication_non_recevable(entity_ref("urn:fr:cc:biens:a06:A")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
