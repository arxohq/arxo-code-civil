language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 607. Rebâtir ce qui est tombé de vétusté n'est à la charge ni du
// propriétaire ni de l'usufruitier, même si l'objet relève des grosses
// réparations de l'article 606.
test "urn:query:fr-code-civil-biens-u08-rebatir-de-vetuste" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": reparation_sur(entity_ref("urn:fr:cc:biens:u08:R"), entity_ref("urn:fr:cc:biens:u08:U")) { origin case_input; }
        assert "f2": objet_de_la_reparation(entity_ref("urn:fr:cc:biens:u08:R"), GrosMurs) { origin case_input; }
        assert "f3": rebatir_ce_qui_est_tombe_de_vetuste_ou_par_cas_fortuit(entity_ref("urn:fr:cc:biens:u08:R")) { origin case_input; }
    }
    evaluate truth(a_la_charge_du_proprietaire(entity_ref("urn:fr:cc:biens:u08:R")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
