language "law.core" version "0.2";
package fr.code_civil_biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

test "urn:query:fr-code-civil-biens-p4-wave3-595-active" {
 given { context { decision_time @2026-09-21T09:00:00Z; knowledge_time @2026-09-21T09:00:00Z; legal_time @2026-09-21; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
 assert "a": bail_de_l_usufruitier(entity_ref("urn:p4:595:w3a:B"), entity_ref("urn:p4:595:w3a:U")) { origin case_input; }
 assert "b": usufruitier(entity_ref("urn:p4:595:w3a:U"), entity_ref("urn:p4:595:w3a:P")) { origin case_input; }
 assert "c": espece_du_bien_baille(entity_ref("urn:p4:595:w3a:B"), BienRural) { origin case_input; } }
 evaluate positions();
 expect position(P4InterdictionBailSansConcours595Actif, ACTIVE);
 expect position(MaintenanceInterdictionBailSansConcours595Duty, ACTIVE); }

test "urn:query:fr-code-civil-biens-p4-wave3-595-violated" {
 given { context { decision_time @2026-09-21T09:00:00Z; knowledge_time @2026-09-21T09:00:00Z; legal_time @2026-09-21; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
 assert "a": bail_de_l_usufruitier(entity_ref("urn:p4:595:w3v:B"), entity_ref("urn:p4:595:w3v:U")) { origin case_input; }
 assert "b": usufruitier(entity_ref("urn:p4:595:w3v:U"), entity_ref("urn:p4:595:w3v:P")) { origin case_input; }
 assert "c": espece_du_bien_baille(entity_ref("urn:p4:595:w3v:B"), BienRural) { origin case_input; }
 assert "d": bail_agricole_ou_commercial_exerce_sans_concours(entity_ref("urn:p4:595:w3v:B"), entity_ref("urn:p4:595:w3v:U"), entity_ref("urn:p4:595:w3v:P")) { origin case_input; } }
 evaluate positions();
 expect position(P4InterdictionBailSansConcours595Actif, VIOLATED);
 expect position(MaintenanceInterdictionBailSansConcours595Duty, VIOLATED); }

