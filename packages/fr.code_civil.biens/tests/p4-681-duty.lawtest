language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

test "urn:query:fr-code-civil-biens-p4-681-c" {
    given {
        context { decision_time @2026-09-21T09:00:00Z; knowledge_time @2026-09-21T09:00:00Z; legal_time @2026-09-21; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": proprietaire_du_fonds(entity_ref("urn:p4:681:c:F"), entity_ref("urn:p4:681:c:P")) { origin case_input; }
        assert "f2": voisin(entity_ref("urn:p4:681:c:F"), entity_ref("urn:p4:681:c:V")) { origin case_input; }
        assert "f3": toits_versant_sur_le_fonds_voisin(entity_ref("urn:p4:681:c:F"), entity_ref("urn:p4:681:c:V")) { origin case_input; }
    }
    evaluate positions();
    expect position(P4DevoirEgoutDesToits681Actif, ACTIVE);
}

