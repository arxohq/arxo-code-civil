language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 671, al. 1, et 672, al. 1. Un centimètre de moins que les deux mètres
// fait la distance moindre, et ouvre au voisin le droit d'exiger l'arrachage.
test "urn:query:fr-code-civil-biens-s04-distance-un-metre-quatre-vingt-dix-neuf" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": plantee_sur(entity_ref("urn:fr:cc:biens:s04:P"), entity_ref("urn:fr:cc:biens:s04:F")) { origin case_input; }
        assert "f2": voisin(entity_ref("urn:fr:cc:biens:s04:F"), entity_ref("urn:fr:cc:biens:s04:V")) { origin case_input; }
        assert "f3": aucun_reglement_ni_usage_sur_les_distances(entity_ref("urn:fr:cc:biens:s04:F")) { origin case_input; }
        assert "f4": hauteur_de_la_plantation(entity_ref("urn:fr:cc:biens:s04:P"), 4 m) { origin case_input; }
        assert "f5": distance_a_la_ligne_separative(entity_ref("urn:fr:cc:biens:s04:P"), 1.99 m) { origin case_input; }
    }
    evaluate truth(droit_d_exiger_l_arrachage_ou_la_reduction(entity_ref("urn:fr:cc:biens:s04:V"), entity_ref("urn:fr:cc:biens:s04:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
