language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 671, al. 1. « dont la hauteur dépasse deux mètres » : 2,01 m dépasse,
// donc la distance légale supplétive est de deux mètres.
test "urn:query:fr-code-civil-biens-s01-plantation-deux-metres-un-centimetre" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": plantee_sur(entity_ref("urn:fr:cc:biens:s01:P"), entity_ref("urn:fr:cc:biens:s01:F")) { origin case_input; }
        assert "f2": voisin(entity_ref("urn:fr:cc:biens:s01:F"), entity_ref("urn:fr:cc:biens:s01:V")) { origin case_input; }
        assert "f3": aucun_reglement_ni_usage_sur_les_distances(entity_ref("urn:fr:cc:biens:s01:F")) { origin case_input; }
        assert "f4": hauteur_de_la_plantation(entity_ref("urn:fr:cc:biens:s01:P"), 2.01 m) { origin case_input; }
        assert "f5": distance_a_la_ligne_separative(entity_ref("urn:fr:cc:biens:s01:P"), 1.5 m) { origin case_input; }
    }
    evaluate truth(distance_legale_de_plantation(entity_ref("urn:fr:cc:biens:s01:P"), 2 m));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
