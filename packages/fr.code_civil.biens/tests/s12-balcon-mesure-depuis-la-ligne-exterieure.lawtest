language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 680. S'il y a balcon, la distance se compte depuis sa LIGNE
// EXTÉRIEURE : le mur est à vingt-deux décimètres de la limite, mais le
// balcon avance, et sa ligne extérieure n'en est qu'à seize — la vue est
// donc prohibée, alors que la mesure au mur l'aurait permise.
test "urn:query:fr-code-civil-biens-s12-balcon-mesure-depuis-la-saillie" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": ouverture_dans(entity_ref("urn:fr:cc:biens:s12:O"), entity_ref("urn:fr:cc:biens:s12:M")) { origin case_input; }
        assert "f2": ouverture_sur_l_heritage(entity_ref("urn:fr:cc:biens:s12:O"), entity_ref("urn:fr:cc:biens:s12:V")) { origin case_input; }
        assert "f3": espece_de_l_ouverture(entity_ref("urn:fr:cc:biens:s12:O"), BalconOuAutreSaillieSemblable) { origin case_input; }
        assert "f4": balcon_ou_saillie_semblable(entity_ref("urn:fr:cc:biens:s12:O")) { origin case_input; }
        assert "f5": distance_du_parement_exterieur_a_la_ligne_separative(entity_ref("urn:fr:cc:biens:s12:O"), 22 dm) { origin case_input; }
        assert "f6": distance_de_la_ligne_exterieure_de_la_saillie(entity_ref("urn:fr:cc:biens:s12:O"), 16 dm) { origin case_input; }
    }
    evaluate truth(vue_prohibee(entity_ref("urn:fr:cc:biens:s12:O")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
