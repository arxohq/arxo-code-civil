language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 690 et 691. Seule la servitude CONTINUE ET APPARENTE s'acquiert par
// trente ans de possession ; la servitude de passage, discontinue, ne
// s'établit que par titre, même après une longue possession.
test "urn:query:fr-code-civil-biens-s21-servitude-discontinue-par-titre" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": servitude_grevant(entity_ref("urn:fr:cc:biens:s21:S"), entity_ref("urn:fr:cc:biens:s21:SERV"), entity_ref("urn:fr:cc:biens:s21:DOM")) { origin case_input; }
        assert "f2": usage_exigeant_le_fait_actuel_de_l_homme(entity_ref("urn:fr:cc:biens:s21:S")) { origin case_input; }
        assert "f3": ouvrage_exterieur_annoncant_la_servitude(entity_ref("urn:fr:cc:biens:s21:S")) { origin case_input; }
        assert "f4": debut_de_la_possession_le(entity_ref("urn:fr:cc:biens:s21:S"), @1960-01-01) { origin case_input; }
        assert "f5": jour_de_reference_de_la_servitude(entity_ref("urn:fr:cc:biens:s21:S"), @2020-01-01) { origin case_input; }
    }
    evaluate truth(servitude_acquise(entity_ref("urn:fr:cc:biens:s21:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
