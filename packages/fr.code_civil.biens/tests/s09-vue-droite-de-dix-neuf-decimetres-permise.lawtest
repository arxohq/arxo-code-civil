language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 678 et 680. « s'il n'y a dix-neuf décimètres de distance » : dix-neuf
// décimètres exactement suffisent, mesurés depuis le parement extérieur.
test "urn:query:fr-code-civil-biens-s09-vue-droite-dix-neuf-decimetres" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": ouverture_dans(entity_ref("urn:fr:cc:biens:s09:O"), entity_ref("urn:fr:cc:biens:s09:M")) { origin case_input; }
        assert "f2": ouverture_sur_l_heritage(entity_ref("urn:fr:cc:biens:s09:O"), entity_ref("urn:fr:cc:biens:s09:V")) { origin case_input; }
        assert "f3": espece_de_l_ouverture(entity_ref("urn:fr:cc:biens:s09:O"), VueDroiteOuFenetreDAspect) { origin case_input; }
        assert "f4": distance_du_parement_exterieur_a_la_ligne_separative(entity_ref("urn:fr:cc:biens:s09:O"), 19 dm) { origin case_input; }
    }
    evaluate truth(vue_permise(entity_ref("urn:fr:cc:biens:s09:O")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
