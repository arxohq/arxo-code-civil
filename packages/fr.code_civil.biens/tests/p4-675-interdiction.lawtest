language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

test "urn:query:fr-code-civil-biens-p4-675-a" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": auteur_ouverture(entity_ref("urn:p4:675:a:O"), entity_ref("urn:p4:675:a:P")) { origin case_input; }
        assert "f2": ouverture_dans(entity_ref("urn:p4:675:a:O"), entity_ref("urn:p4:675:a:M")) { origin case_input; }
        assert "f3": cloture_separant(entity_ref("urn:p4:675:a:M"), entity_ref("urn:p4:675:a:F"), entity_ref("urn:p4:675:a:V"), MurEntreCoursEtJardins) { origin case_input; }
    }
    evaluate positions();
    expect position(P4InterdictionOuverture675Actif, ACTIVE);
}

