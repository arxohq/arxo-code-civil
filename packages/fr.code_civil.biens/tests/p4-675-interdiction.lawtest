    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": auteur_ouverture(entity_ref("urn:p4:675:b:O"), entity_ref("urn:p4:675:b:P")) { origin case_input; }
        assert "f2": ouverture_dans(entity_ref("urn:p4:675:b:O"), entity_ref("urn:p4:675:b:M")) { origin case_input; }
        assert "f3": cloture_separant(entity_ref("urn:p4:675:b:M"), entity_ref("urn:p4:675:b:F"), entity_ref("urn:p4:675:b:V"), MurEntreBatimentsJusquALHeberge) { origin case_input; }
