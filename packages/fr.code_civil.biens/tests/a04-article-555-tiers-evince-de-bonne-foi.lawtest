language "law.core" version "0.2";
package fr.code_civil.biens version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-biens";

// Art. 555, al. 4. Le tiers évincé que le juge n'a pas condamné à la
// restitution des fruits EN RAISON DE SA BONNE FOI — un fait établi par la
// décision, donc d'origine adjudicated — retire au propriétaire le droit
// d'exiger la suppression.
test "urn:query:fr-code-civil-biens-a04-555-tiers-evince-de-bonne-foi" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_BIENS_CALENDRIER; }
        assert "f1": ouvrage_sur(entity_ref("urn:fr:cc:biens:a04:O"), entity_ref("urn:fr:cc:biens:a04:F")) { origin case_input; }
        assert "f2": proprietaire_du_bien(entity_ref("urn:fr:cc:biens:a04:F"), entity_ref("urn:fr:cc:biens:a04:MAITRE")) { origin case_input; }
        assert "f3": ouvrage_fait_par_un_tiers(entity_ref("urn:fr:cc:biens:a04:O"), entity_ref("urn:fr:cc:biens:a04:TIERS")) { origin case_input; }
        assert "f4": tiers_evince(entity_ref("urn:fr:cc:biens:a04:O"), entity_ref("urn:fr:cc:biens:a04:TIERS")) { origin case_input; }
        assert "j1": non_condamne_a_restituer_les_fruits_pour_bonne_foi(entity_ref("urn:fr:cc:biens:a04:O"), entity_ref("urn:fr:cc:biens:a04:TIERS")) { origin adjudicated; }
        assert "f5": choix_du_proprietaire_du_fonds(entity_ref("urn:fr:cc:biens:a04:O"), ObligerLeTiersAEnlever) { origin case_input; }
    }
    evaluate truth(suppression_aux_frais_du_tiers(entity_ref("urn:fr:cc:biens:a04:O"), entity_ref("urn:fr:cc:biens:a04:TIERS")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
