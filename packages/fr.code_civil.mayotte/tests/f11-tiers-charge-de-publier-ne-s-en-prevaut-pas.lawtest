language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2528, alinéa 3 : le tiers qui était lui-même chargé de faire publier les droits concurrents ne peut s'en prévaloir.
test "urn:query:fr-code-civil-mayotte-f11-tiers-charge-de-publier-ne-s-en-prevaut-pas" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": nature_du_droit(entity_ref("urn:fr:cc:may:y:dr"), ProprieteImmobiliere) { origin case_input; }
        assert "f2": nature_du_droit(entity_ref("urn:fr:cc:may:y:conc"), ProprieteImmobiliere) { origin case_input; }
        assert "f3": droit_concurrent_du_meme_auteur(entity_ref("urn:fr:cc:may:y:dr"), entity_ref("urn:fr:cc:may:y:conc")) { origin case_input; }
        assert "f4": droit_inscrit_le(entity_ref("urn:fr:cc:may:y:conc"), @2026-02-01) { origin case_input; }
        assert "f5": tiers_charge_de_publier(entity_ref("urn:fr:cc:may:y:conc")) { origin case_input; }
    }
    evaluate truth(inopposable_au_tiers(entity_ref("urn:fr:cc:may:y:dr"), entity_ref("urn:fr:cc:may:y:conc")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
