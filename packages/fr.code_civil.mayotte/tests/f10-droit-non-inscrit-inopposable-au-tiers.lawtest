language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2528, alinéa 1 : droit de propriété non inscrit, concurrent du même auteur inscrit.
test "urn:query:fr-code-civil-mayotte-f10-droit-non-inscrit-inopposable-au-tiers" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": nature_du_droit(entity_ref("urn:fr:cc:may:x:dr"), ProprieteImmobiliere) { origin case_input; }
        assert "f2": nature_du_droit(entity_ref("urn:fr:cc:may:x:conc"), ProprieteImmobiliere) { origin case_input; }
        assert "f3": droit_concurrent_du_meme_auteur(entity_ref("urn:fr:cc:may:x:dr"), entity_ref("urn:fr:cc:may:x:conc")) { origin case_input; }
        assert "f4": droit_inscrit_le(entity_ref("urn:fr:cc:may:x:conc"), @2026-02-01) { origin case_input; }
    }
    evaluate truth(inopposable_au_tiers(entity_ref("urn:fr:cc:may:x:dr"), entity_ref("urn:fr:cc:may:x:conc")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InopposabiliteFauteDInscription);
}
