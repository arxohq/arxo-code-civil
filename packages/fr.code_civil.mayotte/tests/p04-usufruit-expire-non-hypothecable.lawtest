language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2531, 2° : l'usufruit expiré le 30 avril 2026 n'est plus hypothécable le 1er mai 2026.
test "urn:query:fr-code-civil-mayotte-p04-usufruit-expire-non-hypothecable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": bien_offert_en_hypotheque(entity_ref("urn:fr:cc:may:aq:bien"), UsufruitDesMemesBiens) { origin case_input; }
        assert "f2": duree_du_droit_jusqu_au(entity_ref("urn:fr:cc:may:aq:bien"), @2026-04-30) { origin case_input; }
        assert "f3": jour_de_l_hypotheque(entity_ref("urn:fr:cc:may:aq:bien"), @2026-05-01) { origin case_input; }
    }
    evaluate truth(susceptible_d_hypotheque(entity_ref("urn:fr:cc:may:aq:bien")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
