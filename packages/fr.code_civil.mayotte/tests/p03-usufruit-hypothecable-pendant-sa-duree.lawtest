language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2531, 2° : usufruit dont le terme est au 1er janvier 2030, hypothèque consentie le 1er mai 2026.
test "urn:query:fr-code-civil-mayotte-p03-usufruit-hypothecable-pendant-sa-duree" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": bien_offert_en_hypotheque(entity_ref("urn:fr:cc:may:ap:bien"), UsufruitDesMemesBiens) { origin case_input; }
        assert "f2": duree_du_droit_jusqu_au(entity_ref("urn:fr:cc:may:ap:bien"), @2030-01-01) { origin case_input; }
        assert "f3": jour_de_l_hypotheque(entity_ref("urn:fr:cc:may:ap:bien"), @2026-05-01) { origin case_input; }
    }
    evaluate truth(susceptible_d_hypotheque(entity_ref("urn:fr:cc:may:ap:bien")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(UsufruitHypothecablePendantSaDuree);
}
