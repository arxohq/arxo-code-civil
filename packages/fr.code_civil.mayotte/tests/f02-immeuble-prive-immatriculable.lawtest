language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2511, alinéa 1 : immeuble de toute nature, bâti ou non, hors domaine public.
test "urn:query:fr-code-civil-mayotte-f02-immeuble-prive-immatriculable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": situe_a_mayotte(entity_ref("urn:fr:cc:may:p:imm")) { origin case_input; }
    }
    evaluate truth(immatriculable(entity_ref("urn:fr:cc:may:p:imm")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ImmeubleImmatriculable);
}
