language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

test "Article 2525 : position de l'officier active" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f": officier_instrumentaire(entity_ref("urn:fr:cc:may:2525:f"), entity_ref("urn:fr:cc:may:2525:o")) { origin case_input; }
        assert "d": nature_du_droit(entity_ref("urn:fr:cc:may:2525:d"), ProprieteImmobiliere) { origin case_input; }
        assert "t": titulaire_du_droit(entity_ref("urn:fr:cc:may:2525:d"), entity_ref("urn:fr:cc:may:2525:t")) { origin case_input; }
    }
    evaluate positions();
    expect position(Position2525FaireInscrire, ACTIVE);
}

test "Article 2525 : inscription faite sans délai" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f": officier_instrumentaire(entity_ref("urn:fr:cc:may:2525:f"), entity_ref("urn:fr:cc:may:2525:o")) { origin case_input; }
        assert "d": nature_du_droit(entity_ref("urn:fr:cc:may:2525:d"), ProprieteImmobiliere) { origin case_input; }
        assert "t": titulaire_du_droit(entity_ref("urn:fr:cc:may:2525:d"), entity_ref("urn:fr:cc:may:2525:t")) { origin case_input; }
        assert "j": inscription_faite_sans_delai(entity_ref("urn:fr:cc:may:2525:f")) { origin adjudicated; }
    }
    evaluate positions();
    expect position(Position2525FaireInscrire, SATISFIED);
}
