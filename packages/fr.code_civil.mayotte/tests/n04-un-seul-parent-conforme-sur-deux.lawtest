language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2493, alinéa 1 : la condition pèse sur les DEUX parents ; un seul y satisfait.
test "urn:query:fr-code-civil-mayotte-n04-un-seul-parent-conforme-sur-deux" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": ne_a_mayotte(entity_ref("urn:fr:cc:may:d:enf")) { origin case_input; }
        assert "f2": naissance_le(entity_ref("urn:fr:cc:may:d:enf"), @2025-06-15) { origin case_input; }
        assert "f3": filiation_etablie_a_l_egard_de(entity_ref("urn:fr:cc:may:d:enf"), entity_ref("urn:fr:cc:may:d:p1")) { origin case_input; }
        assert "f4": sejour_regulier_sous_titre_depuis(entity_ref("urn:fr:cc:may:d:enf"), entity_ref("urn:fr:cc:may:d:p1"), @2024-06-14) { origin case_input; }
        assert "f5": filiation_etablie_a_l_egard_de(entity_ref("urn:fr:cc:may:d:enf"), entity_ref("urn:fr:cc:may:d:p2")) { origin case_input; }
        assert "f6": sejour_regulier_sous_titre_depuis(entity_ref("urn:fr:cc:may:d:enf"), entity_ref("urn:fr:cc:may:d:p2"), @2024-12-01) { origin case_input; }
    }
    evaluate truth(condition_de_l_article_2493_remplie(entity_ref("urn:fr:cc:may:d:enf")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
