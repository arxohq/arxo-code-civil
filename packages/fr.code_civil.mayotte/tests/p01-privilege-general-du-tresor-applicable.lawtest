language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2530 : les droits du Trésor public sont l'un des deux seuls privilèges généraux immobiliers de Mayotte.
test "urn:query:fr-code-civil-mayotte-p01-privilege-general-du-tresor-applicable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": privilege_invoque(entity_ref("urn:fr:cc:may:an:cr"), DroitsDuTresorPublic) { origin case_input; }
    }
    evaluate truth(privilege_general_applicable(entity_ref("urn:fr:cc:may:an:cr")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PrivilegeDuTresorPublic);
}
