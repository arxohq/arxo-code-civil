language "law.core" version "0.2";
package fr.code_civil.mayotte version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-mayotte";

// Art. 2493, alinéa 2 : la filiation n'est établie qu'à l'égard d'un parent ; la condition ne pèse que sur lui.
test "urn:query:fr-code-civil-mayotte-n05-filiation-a-l-egard-d-un-seul-parent" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Indian/Mayotte"; deadline_policy CC_MAYOTTE_CALENDRIER; }
        assert "f1": ne_a_mayotte(entity_ref("urn:fr:cc:may:e:enf")) { origin case_input; }
        assert "f2": naissance_le(entity_ref("urn:fr:cc:may:e:enf"), @2025-06-15) { origin case_input; }
        assert "f3": filiation_etablie_a_l_egard_de(entity_ref("urn:fr:cc:may:e:enf"), entity_ref("urn:fr:cc:may:e:p1")) { origin case_input; }
        assert "f4": sejour_regulier_sous_titre_depuis(entity_ref("urn:fr:cc:may:e:enf"), entity_ref("urn:fr:cc:may:e:p1"), @2024-06-14) { origin case_input; }
    }
    evaluate truth(condition_de_l_article_2493_remplie(entity_ref("urn:fr:cc:may:e:enf")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ConditionRemplie);
}
