language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1245-15 : action le 11 mai 2024 — la responsabilité du chapitre est éteinte.
test "urn:query:fr-code-civil-responsabilite-r54-action-le-lendemain-du-terme" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": produit_en_cause(entity_ref("urn:fr:cc:resp:v2p:f"), entity_ref("urn:fr:cc:resp:v2p:prod")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:v2p:f"), entity_ref("urn:fr:cc:resp:v2p:d")) { origin adjudicated; }
        assert "f3": producteur(entity_ref("urn:fr:cc:resp:v2p:prod"), entity_ref("urn:fr:cc:resp:v2p:fab")) { origin case_input; }
        assert "f4": dessaisissement_volontaire_le(entity_ref("urn:fr:cc:resp:v2p:prod"), @2014-05-10) { origin case_input; }
        assert "f5": action_en_justice_engagee_le(entity_ref("urn:fr:cc:resp:v2p:d"), @2024-05-11) { origin case_input; }
    }
    evaluate truth(responsabilite_eteinte(entity_ref("urn:fr:cc:resp:v2p:d")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ExtinctionFauteDActionDansLesDixAns);
}
