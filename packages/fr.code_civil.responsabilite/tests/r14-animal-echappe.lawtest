language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1243 : le propriétaire répond du dommage causé par l animal, même égaré ou échappé.
test "urn:query:fr-code-civil-responsabilite-r14-animal-echappe" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fait_de_l_animal(entity_ref("urn:fr:cc:resp:i:f"), entity_ref("urn:fr:cc:resp:i:proprietaire")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:i:f"), entity_ref("urn:fr:cc:resp:i:d")) { origin adjudicated; }
    }
    evaluate truth(responsable_du_dommage(entity_ref("urn:fr:cc:resp:i:d"), entity_ref("urn:fr:cc:resp:i:proprietaire")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ResponsabiliteDuFaitDesAnimaux);
}
