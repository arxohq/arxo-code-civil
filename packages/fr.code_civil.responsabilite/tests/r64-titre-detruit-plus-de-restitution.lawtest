language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1302-2, alinéa 1 : le créancier a détruit son titre — le droit contre lui cesse.
test "urn:query:fr-code-civil-responsabilite-r64-titre-detruit-plus-de-restitution" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": paiement_recu_par(entity_ref("urn:fr:cc:resp:v2z:pa"), entity_ref("urn:fr:cc:resp:v2z:creancier")) { origin case_input; }
        assert "f2": dette_d_autrui_acquittee(entity_ref("urn:fr:cc:resp:v2z:pa"), entity_ref("urn:fr:cc:resp:v2z:debiteur")) { origin case_input; }
        assert "f3": paye_par_erreur_ou_sous_contrainte(entity_ref("urn:fr:cc:resp:v2z:pa")) { origin adjudicated; }
        assert "f4": titre_detruit_ou_suretes_abandonnees(entity_ref("urn:fr:cc:resp:v2z:pa")) { origin adjudicated; }
    }
    evaluate truth(restitution_contre_le_creancier(entity_ref("urn:fr:cc:resp:v2z:pa"), entity_ref("urn:fr:cc:resp:v2z:creancier")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
