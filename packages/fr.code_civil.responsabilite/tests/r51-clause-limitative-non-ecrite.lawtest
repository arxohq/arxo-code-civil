language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1245-14, alinéa 1 : clause limitative stipulée envers un consommateur.
test "urn:query:fr-code-civil-responsabilite-r51-clause-limitative-non-ecrite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": clause_limitative(entity_ref("urn:fr:cc:resp:v2m:cl"), entity_ref("urn:fr:cc:resp:v2m:p")) { origin case_input; }
    }
    evaluate truth(clause_reputee_non_ecrite(entity_ref("urn:fr:cc:resp:v2m:cl")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ClauseLimitativeNonEcrite);
}
