language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1247 : atteinte non négligeable retenue — préjudice écologique réparable.
test "urn:query:fr-code-civil-responsabilite-r22-atteinte-non-negligeable-reparable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": atteinte_non_negligeable(entity_ref("urn:fr:cc:resp:q:d")) { origin adjudicated; }
    }
    evaluate truth(prejudice_reparable(entity_ref("urn:fr:cc:resp:q:d")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PrejudiceEcologiqueEstReparable);
}
