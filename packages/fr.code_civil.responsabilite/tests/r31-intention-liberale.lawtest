language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1303-1 : l enrichissement qui procède d une intention libérale n est pas injustifié.
test "urn:query:fr-code-civil-responsabilite-r31-intention-liberale" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": valeur_de_l_enrichissement(entity_ref("urn:fr:cc:resp:u2:e"), 12000 EUR) { origin case_input; }
        assert "f2": intention_liberale(entity_ref("urn:fr:cc:resp:u2:e")) { origin case_input; }
    }
    evaluate truth(enrichissement_injustifie(entity_ref("urn:fr:cc:resp:u2:e")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
