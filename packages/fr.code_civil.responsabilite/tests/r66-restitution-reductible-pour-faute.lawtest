language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1302-3 : paiement indu procédant d'une faute retenue par le juge — restitution réductible.
test "urn:query:fr-code-civil-responsabilite-r66-restitution-reductible-pour-faute" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": montant_paye(entity_ref("urn:fr:cc:resp:v3b:pa"), 500 EUR) { origin case_input; }
        assert "f2": paiement_recu_par(entity_ref("urn:fr:cc:resp:v3b:pa"), entity_ref("urn:fr:cc:resp:v3b:accipiens")) { origin case_input; }
        assert "f3": paiement_fait_par(entity_ref("urn:fr:cc:resp:v3b:pa"), entity_ref("urn:fr:cc:resp:v3b:solvens")) { origin case_input; }
        assert "f4": paiement_procedant_d_une_faute(entity_ref("urn:fr:cc:resp:v3b:pa")) { origin adjudicated; }
    }
    evaluate truth(restitution_reductible(entity_ref("urn:fr:cc:resp:v3b:pa")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RestitutionReduitePourFaute);
}
