language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1242 al. 4 : l enfant confié à un tiers par décision administrative ou judiciaire — les parents ne répondent pas.
test "urn:query:fr-code-civil-responsabilite-r08-enfant-confie-par-decision" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": enfant_mineur_sous_autorite_parentale(entity_ref("urn:fr:cc:resp:e:f"), entity_ref("urn:fr:cc:resp:e:mere"), entity_ref("urn:fr:cc:resp:e:enfant")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:e:f"), entity_ref("urn:fr:cc:resp:e:d")) { origin adjudicated; }
        assert "f3": enfant_confie_a_un_tiers_par_decision(entity_ref("urn:fr:cc:resp:e:f"), entity_ref("urn:fr:cc:resp:e:enfant")) { origin adjudicated; }
    }
    evaluate truth(responsabilite_du_fait_d_autrui(entity_ref("urn:fr:cc:resp:e:d"), entity_ref("urn:fr:cc:resp:e:mere"), entity_ref("urn:fr:cc:resp:e:enfant")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
