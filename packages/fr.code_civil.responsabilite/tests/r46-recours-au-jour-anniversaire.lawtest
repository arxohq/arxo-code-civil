language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1245-6, alinéa 2 : citation le 1er février 2025, recours le 1er février 2026 — dans l'année.
test "urn:query:fr-code-civil-responsabilite-r46-recours-au-jour-anniversaire" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": citation_du_fournisseur_le(entity_ref("urn:fr:cc:resp:v2h:p"), entity_ref("urn:fr:cc:resp:v2h:v"), @2025-02-01) { origin case_input; }
        assert "f2": recours_du_fournisseur_engage_le(entity_ref("urn:fr:cc:resp:v2h:p"), entity_ref("urn:fr:cc:resp:v2h:v"), @2026-02-01) { origin case_input; }
    }
    evaluate truth(recours_du_fournisseur_forclos(entity_ref("urn:fr:cc:resp:v2h:p"), entity_ref("urn:fr:cc:resp:v2h:v")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
