language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1242 al. 5 : le commettant répond du fait du préposé dans ses fonctions.
test "urn:query:fr-code-civil-responsabilite-r10-commettant-repond-du-prepose" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prepose_dans_ses_fonctions(entity_ref("urn:fr:cc:resp:g:f"), entity_ref("urn:fr:cc:resp:g:employeur"), entity_ref("urn:fr:cc:resp:g:salarie")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:g:f"), entity_ref("urn:fr:cc:resp:g:d")) { origin adjudicated; }
    }
    evaluate truth(responsable_du_dommage(entity_ref("urn:fr:cc:resp:g:d"), entity_ref("urn:fr:cc:resp:g:employeur")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ResponsabiliteDesCommettants);
}
