language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1242 al. 1 : le gardien répond du fait de la chose sans qu aucune faute soit à apprécier.
test "urn:query:fr-code-civil-responsabilite-r06-fait-des-choses-sans-faute" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": chose_sous_la_garde(entity_ref("urn:fr:cc:resp:d:f"), entity_ref("urn:fr:cc:resp:d:gardien"), entity_ref("urn:fr:cc:resp:d:echelle")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:d:f"), entity_ref("urn:fr:cc:resp:d:d")) { origin adjudicated; }
    }
    evaluate truth(responsable_du_dommage(entity_ref("urn:fr:cc:resp:d:d"), entity_ref("urn:fr:cc:resp:d:gardien")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ResponsabiliteDuFaitDesChoses);
    expect judgment_requests(0);
}
