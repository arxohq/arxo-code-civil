language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1249, alinéa 2 : réparation en nature impossible, le demandeur ne peut agir utilement — les dommages et intérêts vont à l'État.
test "urn:query:fr-code-civil-responsabilite-r58-dommages-et-interets-a-l-etat" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": atteinte_non_negligeable(entity_ref("urn:fr:cc:resp:v2t:d")) { origin adjudicated; }
        assert "f2": demandeur_ecologique(entity_ref("urn:fr:cc:resp:v2t:d"), entity_ref("urn:fr:cc:resp:v2t:commune"), CollectiviteTerritorialeConcernee) { origin case_input; }
        assert "f3": reparation_en_nature_impossible_ou_insuffisante(entity_ref("urn:fr:cc:resp:v2t:d")) { origin adjudicated; }
        assert "f4": demandeur_ne_peut_prendre_les_mesures(entity_ref("urn:fr:cc:resp:v2t:d"), entity_ref("urn:fr:cc:resp:v2t:commune")) { origin adjudicated; }
    }
    evaluate truth(dommages_et_interets_affectes_a_l_etat(entity_ref("urn:fr:cc:resp:v2t:d")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DommagesEtInteretsALEtat);
}
