language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1245-16 : connaissance acquise le 15 janvier 2023 — prescription le 15 janvier 2026.
test "urn:query:fr-code-civil-responsabilite-r55-prescription-triennale" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": connaissance_acquise_le(entity_ref("urn:fr:cc:resp:v2q:d"), @2023-01-15) { origin case_input; }
    }
    evaluate truth(action_prescrite_le(entity_ref("urn:fr:cc:resp:v2q:d"), @2026-01-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PrescriptionTriennale);
}
