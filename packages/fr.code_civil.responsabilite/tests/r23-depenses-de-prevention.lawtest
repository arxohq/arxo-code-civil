language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1251 : les dépenses de prévention constituent un préjudice réparable, sans appréciation.
test "urn:query:fr-code-civil-responsabilite-r23-depenses-de-prevention" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": depense_de_prevention(entity_ref("urn:fr:cc:resp:q2:d")) { origin case_input; }
    }
    evaluate truth(prejudice_reparable(entity_ref("urn:fr:cc:resp:q2:d")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DepensesDePreventionReparables);
    expect judgment_requests(0);
}
