language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1240, canal §47.3 : fait et lien de causalité établis, la faute n est pas encore appréciée — la question est adressée au juge.
test "urn:query:fr-code-civil-responsabilite-r01-faute-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fait_de_la_personne(entity_ref("urn:fr:cc:resp:a:f"), entity_ref("urn:fr:cc:resp:a:auteur")) { origin case_input; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:a:f"), entity_ref("urn:fr:cc:resp:a:d")) { origin adjudicated; }
        assert "f3": victime(entity_ref("urn:fr:cc:resp:a:d"), entity_ref("urn:fr:cc:resp:a:v")) { origin case_input; }
    }
    evaluate truth(responsable_du_dommage(entity_ref("urn:fr:cc:resp:a:d"), entity_ref("urn:fr:cc:resp:a:auteur")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(faute_commise, Court);
    expect judgment_request(negligence_ou_imprudence, Court);
}
