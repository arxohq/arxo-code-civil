language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1245-10 4° : le risque de développement prouvé exonère le producteur.
test "urn:query:fr-code-civil-responsabilite-r19-risque-de-developpement-exonere" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": produit_en_cause(entity_ref("urn:fr:cc:resp:p:f"), entity_ref("urn:fr:cc:resp:p:prod")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:p:f"), entity_ref("urn:fr:cc:resp:p:d")) { origin adjudicated; }
        assert "f3": atteinte_a_la_personne(entity_ref("urn:fr:cc:resp:p:d")) { origin case_input; }
        assert "f4": producteur(entity_ref("urn:fr:cc:resp:p:prod"), entity_ref("urn:fr:cc:resp:p:fabricant")) { origin case_input; }
        assert "f5": defaut_prouve(entity_ref("urn:fr:cc:resp:p:f"), entity_ref("urn:fr:cc:resp:p:prod")) { origin adjudicated; }
        assert "f6": produit_defectueux(entity_ref("urn:fr:cc:resp:p:prod")) { origin adjudicated; }
        assert "f7": exoneration_invoquee_et_prouvee(entity_ref("urn:fr:cc:resp:p:prod"), RisqueDeDeveloppement) { origin adjudicated; }
    }
    evaluate truth(producteur_responsable(entity_ref("urn:fr:cc:resp:p:d"), entity_ref("urn:fr:cc:resp:p:fabricant")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
