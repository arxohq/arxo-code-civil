language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1252 : l'État, qui a qualité, demande des mesures de cessation.
test "urn:query:fr-code-civil-responsabilite-r60-mesures-de-prevention-recevables" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": demandeur_ecologique(entity_ref("urn:fr:cc:resp:v2v:d"), entity_ref("urn:fr:cc:resp:v2v:etat"), Etat) { origin case_input; }
        assert "f2": demande_de_mesures_de_prevention(entity_ref("urn:fr:cc:resp:v2v:d"), entity_ref("urn:fr:cc:resp:v2v:etat")) { origin case_input; }
    }
    evaluate truth(demande_de_mesures_recevable(entity_ref("urn:fr:cc:resp:v2v:d"), entity_ref("urn:fr:cc:resp:v2v:etat")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DemandeDeMesuresRecevable);
}
