language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1242 al. 7 : l exonération par la preuve de n avoir pu empêcher le fait vise les parents et les artisans, pas le commettant.
test "urn:query:fr-code-civil-responsabilite-r11-commettant-sans-exoneration-alinea-7" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": prepose_dans_ses_fonctions(entity_ref("urn:fr:cc:resp:g:f"), entity_ref("urn:fr:cc:resp:g:employeur"), entity_ref("urn:fr:cc:resp:g:salarie")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:g:f"), entity_ref("urn:fr:cc:resp:g:d")) { origin adjudicated; }
        assert "f3": preuve_de_n_avoir_pu_empecher_le_fait(entity_ref("urn:fr:cc:resp:g:f"), entity_ref("urn:fr:cc:resp:g:employeur")) { origin adjudicated; }
    }
    evaluate truth(responsable_du_dommage(entity_ref("urn:fr:cc:resp:g:d"), entity_ref("urn:fr:cc:resp:g:employeur")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
