language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1241 : la négligence retenue par le juge suffit.
test "urn:query:fr-code-civil-responsabilite-r05-negligence-retenue" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": fait_de_la_personne(entity_ref("urn:fr:cc:resp:c:f"), entity_ref("urn:fr:cc:resp:c:auteur")) { origin case_input; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:c:f"), entity_ref("urn:fr:cc:resp:c:d")) { origin adjudicated; }
        assert "f3": negligence_ou_imprudence(entity_ref("urn:fr:cc:resp:c:f"), entity_ref("urn:fr:cc:resp:c:auteur")) { origin adjudicated; }
    }
    evaluate truth(responsable_du_dommage(entity_ref("urn:fr:cc:resp:c:d"), entity_ref("urn:fr:cc:resp:c:auteur")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ResponsabiliteDeLaNegligence);
}
