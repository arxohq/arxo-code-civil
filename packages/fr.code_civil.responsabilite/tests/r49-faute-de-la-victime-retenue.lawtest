language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1245-12 : le juge retient la faute de la victime — la responsabilité peut être réduite ou supprimée.
test "urn:query:fr-code-civil-responsabilite-r49-faute-de-la-victime-retenue" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": produit_en_cause(entity_ref("urn:fr:cc:resp:v2k:f"), entity_ref("urn:fr:cc:resp:v2k:prod")) { origin adjudicated; }
        assert "f2": a_cause(entity_ref("urn:fr:cc:resp:v2k:f"), entity_ref("urn:fr:cc:resp:v2k:d")) { origin adjudicated; }
        assert "f3": atteinte_a_la_personne(entity_ref("urn:fr:cc:resp:v2k:d")) { origin case_input; }
        assert "f4": producteur(entity_ref("urn:fr:cc:resp:v2k:prod"), entity_ref("urn:fr:cc:resp:v2k:fab")) { origin case_input; }
        assert "f5": defaut_prouve(entity_ref("urn:fr:cc:resp:v2k:f"), entity_ref("urn:fr:cc:resp:v2k:prod")) { origin adjudicated; }
        assert "f6": produit_defectueux(entity_ref("urn:fr:cc:resp:v2k:prod")) { origin adjudicated; }
        assert "f7": faute_de_la_victime_ayant_concouru(entity_ref("urn:fr:cc:resp:v2k:f")) { origin adjudicated; }
    }
    evaluate truth(responsabilite_reductible_ou_supprimable(entity_ref("urn:fr:cc:resp:v2k:d"), entity_ref("urn:fr:cc:resp:v2k:fab")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ReductionPourFauteDeLaVictime);
}
