language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1245-5, 2° : l'importateur professionnel dans l'Union est assimilé au producteur.
test "urn:query:fr-code-civil-responsabilite-r42-importateur-assimile-au-producteur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_RESPONSABILITE_CALENDRIER; }
        assert "f1": qualite_invoquee(entity_ref("urn:fr:cc:resp:v2d:p"), entity_ref("urn:fr:cc:resp:v2d:imp"), ImportateurDansLUnion) { origin case_input; }
        assert "f2": agit_a_titre_professionnel(entity_ref("urn:fr:cc:resp:v2d:imp")) { origin case_input; }
    }
    evaluate truth(producteur_au_sens_du_chapitre(entity_ref("urn:fr:cc:resp:v2d:p"), entity_ref("urn:fr:cc:resp:v2d:imp")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ProducteurParSaQualite);
}
