language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1254 al. 4 : personne morale — plafond au quintuple du profit : 200 000 €.
test "urn:query:fr-code-civil-responsabilite-r27-plafond-personne-morale" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": manquement_professionnel(entity_ref("urn:fr:cc:resp:t:f"), entity_ref("urn:fr:cc:resp:t:auteur")) { origin adjudicated; }
        assert "f2": faute_deliberee_en_vue_d_un_gain(entity_ref("urn:fr:cc:resp:t:f"), entity_ref("urn:fr:cc:resp:t:auteur")) { origin adjudicated; }
        assert "f3": dommages_a_plusieurs_personnes_similaires(entity_ref("urn:fr:cc:resp:t:f")) { origin adjudicated; }
        assert "f4": profit_retire(entity_ref("urn:fr:cc:resp:t:f"), 40000 EUR) { origin adjudicated; }
        assert "f5": auteur_personne_morale(entity_ref("urn:fr:cc:resp:t:auteur")) { origin case_input; }
    }
    evaluate truth(plafond_de_la_sanction_civile(entity_ref("urn:fr:cc:resp:t:f"), 200000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PlafondPersonneMorale);
}
