language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1301-2 : gestion utile retenue — le maître rembourse les dépenses : 1 500 €.
test "urn:query:fr-code-civil-responsabilite-r37-remboursement-du-gerant" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": gestion_sans_y_etre_tenu(entity_ref("urn:fr:cc:resp:x:g")) { origin case_input; }
        assert "f2": gerant(entity_ref("urn:fr:cc:resp:x:g"), entity_ref("urn:fr:cc:resp:x:gerant")) { origin case_input; }
        assert "f3": maitre_de_l_affaire(entity_ref("urn:fr:cc:resp:x:g"), entity_ref("urn:fr:cc:resp:x:maitre")) { origin case_input; }
        assert "f4": depenses_du_gerant(entity_ref("urn:fr:cc:resp:x:g"), 1500 EUR) { origin case_input; }
        assert "f5": gestion_utile(entity_ref("urn:fr:cc:resp:x:g")) { origin adjudicated; }
    }
    evaluate truth(remboursement_du_gerant(entity_ref("urn:fr:cc:resp:x:g"), 1500 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RemboursementDesDepenses);
}
