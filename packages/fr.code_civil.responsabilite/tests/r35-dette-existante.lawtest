language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1302 al. 1 : tout paiement suppose une dette — le paiement d une dette existante n est pas sujet à restitution.
test "urn:query:fr-code-civil-responsabilite-r35-dette-existante" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": montant_paye(entity_ref("urn:fr:cc:resp:w2:pa"), 500 EUR) { origin case_input; }
        assert "f2": dette_existante(entity_ref("urn:fr:cc:resp:w2:pa")) { origin case_input; }
    }
    evaluate truth(sujet_a_restitution(entity_ref("urn:fr:cc:resp:w2:pa")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
