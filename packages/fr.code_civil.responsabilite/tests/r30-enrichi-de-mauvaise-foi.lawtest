language "law.core" version "0.2";
package fr.code_civil.responsabilite version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-responsabilite";

// Art. 1303-4 : mauvaise foi de l enrichi — indemnité égale à la plus forte : 12 000 €.
test "urn:query:fr-code-civil-responsabilite-r30-enrichi-de-mauvaise-foi" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f1": valeur_de_l_enrichissement(entity_ref("urn:fr:cc:resp:u:e"), 12000 EUR) { origin case_input; }
        assert "f2": valeur_de_l_appauvrissement(entity_ref("urn:fr:cc:resp:u:e"), 9000 EUR) { origin case_input; }
        assert "f3": mauvaise_foi_de_l_enrichi(entity_ref("urn:fr:cc:resp:u:e")) { origin adjudicated; }
    }
    evaluate truth(indemnite_d_enrichissement(entity_ref("urn:fr:cc:resp:u:e"), 12000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(IndemniteEgaleALaPlusForteEnCasDeMauvaiseFoi);
}
