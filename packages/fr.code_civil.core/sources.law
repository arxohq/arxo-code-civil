@id("urn:fr:corpus:clir:code-civil-core#CC_ART1")
pub fragment CC_ART1 in CC_COURANT {
    label fr official "Article 1";
    kind article;
    locator "article/1";
    text fr official """Article 1
Les lois et, lorsqu'ils sont publiés au Journal officiel de la République française, les actes administratifs entrent en vigueur à la date qu'ils fixent ou, à défaut, le lendemain de leur publication. Toutefois, l'entrée en vigueur de celles de leurs dispositions dont l'exécution nécessite des mesures d'application est reportée à la date d'entrée en vigueur de ces mesures.
En cas d'urgence, entrent en vigueur dès leur publication les lois dont le décret de promulgation le prescrit et les actes administratifs pour lesquels le Gouvernement l'ordonne par une disposition spéciale.
Les dispositions du présent article ne sont pas applicables aux actes individuels.
""";
    content_hash "sha256:e803e1000b7a4bff46a15eb744907f860158e07332a32cb5ea64a57d4728e694";
}

@id("urn:fr:corpus:clir:code-civil-core#CC_ART2")
pub fragment CC_ART2 in CC_COURANT {
    label fr official "Article 2";
    kind article;
    locator "article/2";
    text fr official """Article 2
La loi ne dispose que pour l'avenir ; elle n'a point d'effet rétroactif.
""";
    content_hash "sha256:8dcd88ed3d0c0043f33bfcdb69bfcf8698c86eb2e3ac52df2d3eac12f31e2896";
}

@id("urn:fr:corpus:clir:code-civil-core#CC_ART3")
pub fragment CC_ART3 in CC_COURANT {
    label fr official "Article 3";
    kind article;
    locator "article/3";
    text fr official """Article 3
Les lois de police et de sûreté obligent tous ceux qui habitent le territoire.
Les immeubles, même ceux possédés par des étrangers, sont régis par la loi française.
Les lois concernant l'état et la capacité des personnes régissent les Français, même résidant en pays étranger.
""";
    content_hash "sha256:d18e4bf7079ddfb7e5cdb675d118e97f2bdde18d68ad15d26127ec709585db6a";
}

@id("urn:fr:corpus:clir:code-civil-core#CC_ART4")
pub fragment CC_ART4 in CC_COURANT {
    label fr official "Article 4";
    kind article;
    locator "article/4";
    text fr official """Article 4
Le juge qui refusera de juger, sous prétexte du silence, de l'obscurité ou de l'insuffisance de la loi, pourra être poursuivi comme coupable de déni de justice.
""";
    content_hash "sha256:51185c88bd449e3605e1cf4f86d0e787b4c0279b09e391fd02179a0e7a8b2959";
}

@id("urn:fr:corpus:clir:code-civil-core#CC_ART5")
pub fragment CC_ART5 in CC_COURANT {
    label fr official "Article 5";
    kind article;
    locator "article/5";
    text fr official """Article 5
Il est défendu aux juges de prononcer par voie de disposition générale et réglementaire sur les causes qui leur sont soumises.
""";
    content_hash "sha256:203a0e8f2afb6c41ab1e282e92ca5ec81e3a9f9b86156d312ffe0c98e2fb9d5d";
}

@id("urn:fr:corpus:clir:code-civil-core#CC_ART6")
pub fragment CC_ART6 in CC_COURANT {
    label fr official "Article 6";
    kind article;
    locator "article/6";
    text fr official """Article 6
On ne peut déroger, par des conventions particulières, aux lois qui intéressent l'ordre public et les bonnes moeurs.
""";
    content_hash "sha256:8f81162cf4d615053920f8a7e213ae075d4fd6c9b4ffce14f71cbaf6744014e5";
}

@id("urn:fr:corpus:clir:code-civil-core#CC_ART6_1")
pub fragment CC_ART6_1 in CC_COURANT {
    label fr official "Article 6-1";
    kind article;
    locator "article/6-1";
    text fr official """Article 6-1
Le mariage et la filiation adoptive emportent les mêmes effets, droits et obligations reconnus par les lois, à l'exclusion de ceux prévus aux chapitres Ier à IV du titre VII du livre Ier du présent code, que les époux ou les parents soient de sexe différent ou de même sexe.
""";
    content_hash "sha256:11e81f2d7b56c449f2d80263fbe22d51468d50a0c488aa5b0f9de6adccd0ee33";
}

@id("urn:fr:corpus:clir:code-civil-core#CC_ART6_2")
pub fragment CC_ART6_2 in CC_COURANT {
    label fr official "Article 6-2";
    kind article;
    locator "article/6-2";
    text fr official """Article 6-2
Tous les enfants dont la filiation est légalement établie ont, dans leurs rapports avec leurs parents, les mêmes droits et les mêmes devoirs, sous réserve des dispositions propres à l'adoption simple. La filiation fait entrer l'enfant dans la famille de chacun de ses parents.
""";
    content_hash "sha256:6d2d87b5e2f7353e38aa280d7140e773bf867fc30b95ff60428f9df6fdd3ee0a";
}

// END GENERATED FRAGMENTS
