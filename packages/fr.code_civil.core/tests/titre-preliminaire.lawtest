        assert "g": disposition_generale_et_reglementaire(entity_ref("urn:cc01:decision:1")) { origin case_input; }
    }
    evaluate positions();
    expect position(InterdictionDesArretsDeReglement, VIOLATED);
}

test "CC01-13-ordre-public-attend-le-juge" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "d": convention_deroge_a_une_loi(entity_ref("urn:cc01:convention:1")) { origin case_input; }
    }
    evaluate truth(derogation_conventionnelle_interdite(entity_ref("urn:cc01:convention:1")));
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect truth_status == NEITHER;
    expect judgment_request(loi_interesse_ordre_public_ou_bonnes_moeurs, Court);
}

test "CC01-14-ordre-public-retenu" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
