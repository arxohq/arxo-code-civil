test "CC01-09-application-territoriale" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "p1": loi_de_police_ou_de_surete(entity_ref("urn:cc01:loi:police")) { origin case_input; }
        assert "p2": personne_habite_le_territoire(entity_ref("urn:cc01:personne:resident")) { origin case_input; }
        assert "i": bien_est_immeuble(entity_ref("urn:cc01:bien:immeuble")) { origin case_input; }
        assert "f1": personne_est_francaise(entity_ref("urn:cc01:personne:fr")) { origin case_input; }
        assert "f2": question_d_etat_ou_de_capacite(entity_ref("urn:cc01:personne:fr"), entity_ref("urn:cc01:situation:capacite")) { origin case_input; }
    }
    evaluate truth(loi_oblige_personne(entity_ref("urn:cc01:loi:police"), entity_ref("urn:cc01:personne:resident")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(immeuble_releve_de_la_loi_francaise(entity_ref("urn:cc01:bien:immeuble")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(loi_francaise_regit_etat_ou_capacite(entity_ref("urn:cc01:personne:fr"), entity_ref("urn:cc01:situation:capacite")));
    expect truth_status == TRUE_ONLY;
}

test "CC01-10-obligation-de-juger-satisfaite" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "s": juge_saisi(entity_ref("urn:cc01:juge:1"), entity_ref("urn:cc01:instance:1")) { origin case_input; }
        assert "l": loi_silencieuse_obscure_ou_insuffisante(entity_ref("urn:cc01:instance:1")) { origin case_input; }
    }
    evaluate positions();
    expect position(ObligationDeStatuer, ACTIVE);
}

test "CC01-11-obligation-de-juger-violee" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "s": juge_saisi(entity_ref("urn:cc01:juge:2"), entity_ref("urn:cc01:instance:2")) { origin case_input; }
        assert "l": loi_silencieuse_obscure_ou_insuffisante(entity_ref("urn:cc01:instance:2")) { origin case_input; }
        assert "r": juge_refuse_de_juger(entity_ref("urn:cc01:juge:2"), entity_ref("urn:cc01:instance:2")) { origin case_input; }
    }
    evaluate positions();
    expect position(ObligationDeStatuer, VIOLATED);
}

test "CC01-12-interdiction-arret-reglement" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
