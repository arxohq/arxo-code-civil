language "law.core" version "0.2";
package fr.code_civil.core version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-core";

test "CC01-01-date-fixee" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CORE_JOUR; }
        assert "p": publie_au_journal_officiel_le(entity_ref("urn:cc01:acte:fixe"), @2026-03-01) { origin case_input; }
        assert "d": date_d_entree_en_vigueur_fixee(entity_ref("urn:cc01:acte:fixe"), @2026-04-01) { origin case_input; }
    }
    evaluate truth(entre_en_vigueur_le(entity_ref("urn:cc01:acte:fixe"), @2026-04-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EntreeEnVigueurDateFixee);
}

