        assert "o": loi_interesse_ordre_public_ou_bonnes_moeurs(entity_ref("urn:cc01:convention:2")) { origin adjudicated; }
    }
    evaluate truth(derogation_conventionnelle_interdite(entity_ref("urn:cc01:convention:2")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(OrdrePublicConvention);
    expect judgment_requests(0);
}

test "CC01-15-egalite-mariage-et-exception" {
    given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "e1": effet_du_mariage_ou_de_l_adoption_pleniere(entity_ref("urn:cc01:effet:commun")) { origin case_input; }
        assert "e2": effet_du_mariage_ou_de_l_adoption_pleniere(entity_ref("urn:cc01:effet:exclu")) { origin case_input; }
        assert "x": effet_releve_chapitres_un_a_quatre_titre_sept(entity_ref("urn:cc01:effet:exclu")) { origin case_input; }
    }
    evaluate truth(effet_identique_independant_du_sexe(entity_ref("urn:cc01:effet:commun")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(effet_identique_independant_du_sexe(entity_ref("urn:cc01:effet:exclu")));
    expect truth_status == NEITHER;
}

