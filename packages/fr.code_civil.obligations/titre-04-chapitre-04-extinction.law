    CC_ART1346_2,
    CC_ART1346_3,
    CC_ART1346_4,
    CC_ART1346_5,
    CC_ART1347,
    CC_ART1347_1,
    CC_ART1347_2,
    CC_ART1347_3,
    CC_ART1347_4,
    CC_ART1347_5,
    CC_ART1347_6,
    CC_ART1347_7,
    CC_ART1348,
    CC_ART1348_1,
    CC_ART1348_2,
    CC_ART1349,
    CC_ART1349_1,
    CC_ART1350,
    CC_ART1350_1,
    CC_ART1350_2,
    CC_ART1351,
    CC_ART1351_1,
    Creance,
    MiseEnDemeure,
    ModeDeMiseEnDemeure,
    ObjetDeLObligationInexecutee,
    Paiement,
    Personne,
    RemiseDeDette,
    Subrogation,
    anatocisme_ordonne_par_le_juge,
    date_d_exigibilite,
    date_de_naissance_de_la_dette,
    delai_de_grace_accorde,
    dette_du_debiteur,
    egalite_d_interet_d_acquitter,
    exception_inherente_a_la_dette,
    force_majeure_definitive,
    obligation_solidaire_entre_creanciers,
    obligation_solidaire_entre_debiteurs,
    plus_d_interet_d_acquitter,
    refus_sans_motif_legitime,
};

// --- Entrées du cas propres au chapitre ----------------------------------------------------

pub relation paiement_de_la_dette(pay: Paiement, c: Creance) kind empirical {
    key(pay);
    label fr official "paiement offert ou fait au titre de cette dette (article 1342)";
    label en unofficial "payment offered or made under this debt (Article 1342)";
}
pub relation auteur_du_paiement(pay: Paiement, p: Personne) kind empirical {
    key(pay);
    label fr official "personne qui paie (article 1342-1)";
    label en unofficial "person who pays (Article 1342-1)";
}
pub relation destinataire_du_paiement(pay: Paiement, p: Personne) kind empirical {
    key(pay);
    label fr official "personne qui reçoit le paiement (article 1342-2)";
    label en unofficial "person who receives the payment (Article 1342-2)";
}
pub relation montant_paye(pay: Paiement, m: Money) kind empirical {
    key(pay);
    label fr official "montant versé (articles 1342-4 et 1342-10)";
    label en unofficial "amount paid (Articles 1342-4 and 1342-10)";
}
pub relation date_du_paiement(pay: Paiement, jour: Date) kind empirical {
    key(pay);
    label fr official "date du paiement (articles 1342-10 et 1352-7)";
    label en unofficial "date of the payment (Articles 1342-10 and 1352-7)";
}
pub relation paiement_du_debiteur(pay: Paiement, d: Personne) kind empirical {
    key(pay);
    label fr official "débiteur de plusieurs dettes qui paie (article 1342-10, alinéa 1)";
    label en unofficial "debtor of several debts who pays (Article 1342-10, paragraph 1)";
}
pub relation dette_designee_par_le_debiteur(pay: Paiement, c: Creance) kind empirical {
    label fr official "dette que le débiteur a indiquée, lorsqu'il paie, comme celle qu'il entend acquitter (article 1342-10, alinéa 1)";
    label en unofficial "debt the debtor indicated, when paying, as the one he intends to discharge (Article 1342-10, paragraph 1)";
}
pub relation personne_designee_pour_recevoir(c: Creance, p: Personne) kind empirical {
    label fr official "personne désignée pour recevoir le paiement (article 1342-2, alinéa 1)";
    label en unofficial "person designated to receive the payment (Article 1342-2, paragraph 1)";
}
pub relation paiement_ratifie_par_le_creancier(pay: Paiement) kind empirical {
    label fr official "le créancier ratifie le paiement fait à une personne sans qualité (article 1342-2, alinéa 2)";
    label en unofficial "the creditor ratifies the payment made to an unqualified person (Article 1342-2, paragraph 2)";
}
pub relation creancier_a_profite_du_paiement(pay: Paiement) kind empirical {
    label fr official "le créancier a profité du paiement (article 1342-2, alinéas 2 et 3)";
    label en unofficial "the creditor benefited from the payment (Article 1342-2, paragraphs 2 and 3)";
}
pub relation creancier_incapable_de_contracter(c: Creance) kind empirical {
    label fr official "le créancier est dans l'incapacité de contracter (article 1342-2, alinéa 3)";
    label en unofficial "the creditor is incapable of contracting (Article 1342-2, paragraph 3)";
}
pub relation creancier_apparent(pay: Paiement, p: Personne) kind empirical {
    label fr official "celui qui a reçu était créancier apparent (article 1342-3)";
    label en unofficial "the recipient was an apparent creditor (Article 1342-3)";
}
pub relation paiement_fait_de_bonne_foi(pay: Paiement) kind empirical {
    label fr official "le paiement a été fait de bonne foi (article 1342-3)";
    label en unofficial "the payment was made in good faith (Article 1342-3)";
}
