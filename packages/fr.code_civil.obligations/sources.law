// BEGIN GENERATED FRAGMENTS

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304")
pub fragment CC_ART1304 in CC_COURANT {
    label fr official "Article 1304";
    kind article;
    locator "article/1304";
    text fr official """Article 1304
L'obligation est conditionnelle lorsqu'elle dépend d'un événement futur et incertain.
La condition est suspensive lorsque son accomplissement rend l'obligation pure et simple.
Elle est résolutoire lorsque son accomplissement entraîne l'anéantissement de l'obligation.
""";
    content_hash "sha256:b0c34d98f67ba1c80b31c2a02bd71746e53b9fbbe2800183237b97dc8c1de8eb";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304_1")
pub fragment CC_ART1304_1 in CC_COURANT {
    label fr official "Article 1304-1";
    kind article;
    locator "article/1304-1";
    text fr official """Article 1304-1
La condition doit être licite. A défaut, l'obligation est nulle.
""";
    content_hash "sha256:8efdce8ea21f8d0ecf38299a7102007510b8a90ee41db2bcc920a239337403f7";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304_2")
pub fragment CC_ART1304_2 in CC_COURANT {
    label fr official "Article 1304-2";
    kind article;
    locator "article/1304-2";
    text fr official """Article 1304-2
Est nulle l'obligation contractée sous une condition dont la réalisation dépend de la seule volonté du débiteur. Cette nullité ne peut être invoquée lorsque l'obligation a été exécutée en connaissance de cause.
""";
    content_hash "sha256:da6206f3f5da0020fb6c5c6e2359c5f15f78cfc9b0439dc584c364d7c38784a1";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304_3")
pub fragment CC_ART1304_3 in CC_COURANT {
    label fr official "Article 1304-3";
    kind article;
    locator "article/1304-3";
    text fr official """Article 1304-3
La condition suspensive est réputée accomplie si celui qui y avait intérêt en a empêché l'accomplissement.
La condition résolutoire est réputée défaillie si son accomplissement a été provoqué par la partie qui y avait intérêt.
""";
    content_hash "sha256:428afd963835bdf7394fb583ea314e7df4c162d202b56f707df9360535b2fe52";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304_4")
pub fragment CC_ART1304_4 in CC_COURANT {
    label fr official "Article 1304-4";
    kind article;
    locator "article/1304-4";
    text fr official """Article 1304-4
Une partie est libre de renoncer à la condition stipulée dans son intérêt exclusif, tant que celle-ci n'est pas accomplie ou n'a pas défailli.
""";
    content_hash "sha256:a241394e47a46c2b088b13e02721f34ebe48774eddc2f72ae2e6e42dd22438bb";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304_5")
pub fragment CC_ART1304_5 in CC_COURANT {
    label fr official "Article 1304-5";
    kind article;
    locator "article/1304-5";
    text fr official """Article 1304-5
Avant que la condition suspensive ne soit accomplie, le débiteur doit s'abstenir de tout acte qui empêcherait la bonne exécution de l'obligation ; le créancier peut accomplir tout acte conservatoire et attaquer les actes du débiteur accomplis en fraude de ses droits.
Ce qui a été payé peut être répété tant que la condition suspensive ne s'est pas accomplie.
""";
    content_hash "sha256:b3b4de0acf43c026df180feab2c2a56a7e1e45743214d824634bd45206870a03";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304_6")
pub fragment CC_ART1304_6 in CC_COURANT {
    label fr official "Article 1304-6";
    kind article;
    locator "article/1304-6";
    text fr official """Article 1304-6
L'obligation devient pure et simple à compter de l'accomplissement de la condition suspensive.
Toutefois, les parties peuvent prévoir que l'accomplissement de la condition rétroagira au jour du contrat. La chose, objet de l'obligation, n'en demeure pas moins aux risques du débiteur, qui en conserve l'administration et a droit aux fruits jusqu'à l'accomplissement de la condition.
En cas de défaillance de la condition suspensive, l'obligation est réputée n'avoir jamais existé.
""";
    content_hash "sha256:0e309ad7cd9439620307ebbf007e87eb43d320941ee00f85f6db2b96caea8438";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1304_7")
pub fragment CC_ART1304_7 in CC_COURANT {
    label fr official "Article 1304-7";
    kind article;
    locator "article/1304-7";
    text fr official """Article 1304-7
L'accomplissement de la condition résolutoire éteint rétroactivement l'obligation, sans remettre en cause, le cas échéant, les actes conservatoires et d'administration.
La rétroactivité n'a pas lieu si telle est la convention des parties ou si les prestations échangées ont trouvé leur utilité au fur et à mesure de l'exécution réciproque du contrat.
""";
    content_hash "sha256:4995f45512223c1e81cf01ba03f551d028f0e5c4a61bd3a62fca55303651b568";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1305")
pub fragment CC_ART1305 in CC_COURANT {
    label fr official "Article 1305";
    kind article;
    locator "article/1305";
    text fr official """Article 1305
L'obligation est à terme lorsque son exigibilité est différée jusqu'à la survenance d'un événement futur et certain, encore que la date en soit incertaine.
""";
    content_hash "sha256:73f4e816a619f36465a52bb70fecf5455c3ddd66be6c527f3f6b13fa28abd8be";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1305_1")
pub fragment CC_ART1305_1 in CC_COURANT {
    label fr official "Article 1305-1";
    kind article;
    locator "article/1305-1";
    text fr official """Article 1305-1
Le terme peut être exprès ou tacite.
A défaut d'accord, le juge peut le fixer en considération de la nature de l'obligation et de la situation des parties.
""";
    content_hash "sha256:bee4e66ceb857a1c8ad90e636dd1f3a4078af0d348df42eae72755923f6055dd";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1305_2")
pub fragment CC_ART1305_2 in CC_COURANT {
    label fr official "Article 1305-2";
    kind article;
    locator "article/1305-2";
    text fr official """Article 1305-2
Ce qui n'est dû qu'à terme ne peut être exigé avant l'échéance ; mais ce qui a été payé d'avance ne peut être répété.
""";
    content_hash "sha256:e9d82dd49a4398ca5d8d3cbf62a0ebdca78388dda8dc2138232cf95321f2641d";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1305_3")
pub fragment CC_ART1305_3 in CC_COURANT {
    label fr official "Article 1305-3";
    kind article;
    locator "article/1305-3";
    text fr official """Article 1305-3
Le terme profite au débiteur, s'il ne résulte de la loi, de la volonté des parties ou des circonstances qu'il a été établi en faveur du créancier ou des deux parties.
La partie au bénéfice exclusif de qui le terme a été fixé peut y renoncer sans le consentement de l'autre.
""";
    content_hash "sha256:3f23b337bee49f9f9010790ea785b90df6e8d1d1ad52a5951efbfd67914eee39";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1305_4")
pub fragment CC_ART1305_4 in CC_COURANT {
    label fr official "Article 1305-4";
    kind article;
    locator "article/1305-4";
    text fr official """Article 1305-4
Le débiteur ne peut réclamer le bénéfice du terme s'il ne fournit pas les sûretés promises au créancier ou s'il diminue celles qui garantissent l'obligation.
""";
    content_hash "sha256:b6297f2d1e78171557e07baeacc35846cbb24973481b00ef8ae97bd5c18b1413";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1305_5")
pub fragment CC_ART1305_5 in CC_COURANT {
    label fr official "Article 1305-5";
    kind article;
    locator "article/1305-5";
    text fr official """Article 1305-5
La déchéance du terme encourue par un débiteur est inopposable à ses coobligés, même solidaires, et à ses cautions.
""";
    content_hash "sha256:9f2884dc6221552d09571633ae22a23c11e32f79f6a3aefab022a9d60c551487";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1306")
pub fragment CC_ART1306 in CC_COURANT {
    label fr official "Article 1306";
    kind article;
    locator "article/1306";
    text fr official """Article 1306
L'obligation est cumulative lorsqu'elle a pour objet plusieurs prestations et que seule l'exécution de la totalité de celles-ci libère le débiteur.
""";
    content_hash "sha256:51d809d8a9f610cadf5ffc75f2bcbbc3d8a2e3fc1adac18bd3908f546b9ad425";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1307")
pub fragment CC_ART1307 in CC_COURANT {
    label fr official "Article 1307";
    kind article;
    locator "article/1307";
    text fr official """Article 1307
L'obligation est alternative lorsqu'elle a pour objet plusieurs prestations et que l'exécution de l'une d'elles libère le débiteur.
""";
    content_hash "sha256:a6ff5228e1cb3c5de892f74c4812fe170c36d578a4b0f0522f73b7b3688c68e6";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1307_1")
pub fragment CC_ART1307_1 in CC_COURANT {
    label fr official "Article 1307-1";
    kind article;
    locator "article/1307-1";
    text fr official """Article 1307-1
Le choix entre les prestations appartient au débiteur.
Si le choix n'est pas exercé dans le temps convenu ou dans un délai raisonnable, l'autre partie peut, après mise en demeure, exercer ce choix ou résoudre le contrat.
Le choix exercé est définitif et fait perdre à l'obligation son caractère alternatif.
""";
    content_hash "sha256:c0be7e2c72ffa9103bbca6972b2965f6ab5c1c302d961585b8c972a1d7d647fd";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1307_2")
pub fragment CC_ART1307_2 in CC_COURANT {
    label fr official "Article 1307-2";
    kind article;
    locator "article/1307-2";
    text fr official """Article 1307-2
Si elle procède d'un cas de force majeure, l'impossibilité d'exécuter la prestation choisie libère le débiteur.
""";
    content_hash "sha256:4324fc3314bf42320edf5080ab1bb22f7c35eae197902931bc01ae71063e7473";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1307_3")
pub fragment CC_ART1307_3 in CC_COURANT {
    label fr official "Article 1307-3";
    kind article;
    locator "article/1307-3";
    text fr official """Article 1307-3
Le débiteur qui n'a pas fait connaître son choix doit, si l'une des prestations devient impossible, exécuter l'une des autres.
""";
    content_hash "sha256:87e7a014d2bb469b002754fd4b8a5ccdc1a19c5d0524d2e524b0746c744d4dde";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1307_4")
pub fragment CC_ART1307_4 in CC_COURANT {
    label fr official "Article 1307-4";
    kind article;
    locator "article/1307-4";
    text fr official """Article 1307-4
Le créancier qui n'a pas fait connaître son choix doit, si l'une des prestations devient impossible à exécuter par suite d'un cas de force majeure, se contenter de l'une des autres.
""";
    content_hash "sha256:7346797b7fb44fa824bf7d8027c5a972f3004cb2df756c326a5728b988198f1e";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1307_5")
pub fragment CC_ART1307_5 in CC_COURANT {
    label fr official "Article 1307-5";
    kind article;
    locator "article/1307-5";
    text fr official """Article 1307-5
Lorsque les prestations deviennent impossibles, le débiteur n'est libéré que si l'impossibilité procède, pour chacune, d'un cas de force majeure.
""";
    content_hash "sha256:f1b64dc67f8c40a57599b2657ad385e7b68f416a7d40fbd7b00f608649e7c6e6";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1308")
pub fragment CC_ART1308 in CC_COURANT {
    label fr official "Article 1308";
    kind article;
    locator "article/1308";
    text fr official """Article 1308
L'obligation est facultative lorsqu'elle a pour objet une certaine prestation mais que le débiteur a la faculté, pour se libérer, d'en fournir une autre.
L'obligation facultative est éteinte si l'exécution de la prestation initialement convenue devient impossible pour cause de force majeure.
""";
    content_hash "sha256:d63af1f25922bee69d9bd494aaace0646b7f36048c7dcc5b1f96ab331600cedc";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1309")
pub fragment CC_ART1309 in CC_COURANT {
    label fr official "Article 1309";
    kind article;
    locator "article/1309";
    text fr official """Article 1309
L'obligation qui lie plusieurs créanciers ou débiteurs se divise de plein droit entre eux. La division a lieu également entre leurs successeurs, l'obligation fût-elle solidaire. Si elle n'est pas réglée autrement par la loi ou par le contrat, la division a lieu par parts égales.
Chacun des créanciers n'a droit qu'à sa part de la créance commune ; chacun des débiteurs n'est tenu que de sa part de la dette commune.
Il n'en va autrement, dans les rapports entre les créanciers et les débiteurs, que si l'obligation est solidaire ou si la prestation due est indivisible.
""";
    content_hash "sha256:1b1747400cc10b3cc96ae9cc53d8456520be968d768cad6eba2083878a1e4f58";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1310")
pub fragment CC_ART1310 in CC_COURANT {
    label fr official "Article 1310";
    kind article;
    locator "article/1310";
    text fr official """Article 1310
La solidarité est légale ou conventionnelle ; elle ne se présume pas.
""";
    content_hash "sha256:673c2878358b5d1fbd5b9fd6cf69e002f1ae2f7a017990626967714474c4fda6";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1311")
pub fragment CC_ART1311 in CC_COURANT {
    label fr official "Article 1311";
    kind article;
    locator "article/1311";
    text fr official """Article 1311
La solidarité entre créanciers permet à chacun d'eux d'exiger et de recevoir le paiement de toute la créance. Le paiement fait à l'un d'eux, qui en doit compte aux autres, libère le débiteur à l'égard de tous.
Le débiteur peut payer l'un ou l'autre des créanciers solidaires tant qu'il n'est pas poursuivi par l'un d'eux.
""";
    content_hash "sha256:6a2215d8e99ebbcfd7c60ca085f485366e7d4de17db3d6e98805147a95bd7c19";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1312")
pub fragment CC_ART1312 in CC_COURANT {
    label fr official "Article 1312";
    kind article;
    locator "article/1312";
    text fr official """Article 1312
Tout acte qui interrompt ou suspend la prescription à l'égard de l'un des créanciers solidaires, profite aux autres créanciers.
""";
    content_hash "sha256:3a86522baffa8d922f6ca7c262a21f0b8e07a59f950e7571991ccfb0f563c099";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1313")
pub fragment CC_ART1313 in CC_COURANT {
    label fr official "Article 1313";
    kind article;
    locator "article/1313";
    text fr official """Article 1313
La solidarité entre les débiteurs oblige chacun d'eux à toute la dette. Le paiement fait par l'un d'eux les libère tous envers le créancier.
Le créancier peut demander le paiement au débiteur solidaire de son choix. Les poursuites exercées contre l'un des débiteurs solidaires n'empêchent pas le créancier d'en exercer de pareilles contre les autres.
""";
    content_hash "sha256:d9ae2f029890213bb9d45adf6109c35924f40465f42a65dab5bfdbb4ef780e91";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1314")
pub fragment CC_ART1314 in CC_COURANT {
    label fr official "Article 1314";
    kind article;
    locator "article/1314";
    text fr official """Article 1314
La demande d'intérêts formée contre l'un des débiteurs solidaires fait courir les intérêts à l'égard de tous.
""";
    content_hash "sha256:dd58d53c7b75abb8e2c614b1ba6cad83de060de52e1a5322054541038ce88625";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1315")
pub fragment CC_ART1315 in CC_COURANT {
    label fr official "Article 1315";
    kind article;
    locator "article/1315";
    text fr official """Article 1315
Le débiteur solidaire poursuivi par le créancier peut opposer les exceptions qui sont communes à tous les codébiteurs, telles que la nullité ou la résolution, et celles qui lui sont personnelles. Il ne peut opposer les exceptions qui sont personnelles à d'autres codébiteurs, telle que l'octroi d'un terme. Toutefois, lorsqu'une exception personnelle à un autre codébiteur éteint la part divise de celui-ci, notamment en cas de compensation ou de remise de dette, il peut s'en prévaloir pour la faire déduire du total de la dette.
""";
    content_hash "sha256:1783a43e7f8bc5e66a3cd5ef9d40def3840d23c9934bcb871e3846a1225cb40c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1316")
pub fragment CC_ART1316 in CC_COURANT {
    label fr official "Article 1316";
    kind article;
    locator "article/1316";
    text fr official """Article 1316
Le créancier qui reçoit paiement de l'un des codébiteurs solidaires et lui consent une remise de solidarité conserve sa créance contre les autres, déduction faite de la part du débiteur qu'il a déchargé.
""";
    content_hash "sha256:7246ddd100f4ae19961165182fe28ac1249672452aee6e08db10315b8cefdb70";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1317")
pub fragment CC_ART1317 in CC_COURANT {
    label fr official "Article 1317";
    kind article;
    locator "article/1317";
    text fr official """Article 1317
Entre eux, les codébiteurs solidaires ne contribuent à la dette que chacun pour sa part.
Celui qui a payé au-delà de sa part dispose d'un recours contre les autres à proportion de leur propre part.
Si l'un d'eux est insolvable, sa part se répartit, par contribution, entre les codébiteurs solvables, y compris celui qui a fait le paiement et celui qui a bénéficié d'une remise de solidarité.
""";
    content_hash "sha256:00980f9e89143cee521bd9ef38944e775e0cbcddda2f6e8731f34a23f9f69e21";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1318")
pub fragment CC_ART1318 in CC_COURANT {
    label fr official "Article 1318";
    kind article;
    locator "article/1318";
    text fr official """Article 1318
Si la dette procède d'une affaire qui ne concerne que l'un des codébiteurs solidaires, celui-ci est seul tenu de la dette à l'égard des autres. S'il l'a payée, il ne dispose d'aucun recours contre ses codébiteurs. Si ceux-ci l'ont payée, ils disposent d'un recours contre lui.
""";
    content_hash "sha256:7fbc01bebe6695db63be32db2acc8523b6f0c442ebe17f2065644a8d24afa955";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1319")
pub fragment CC_ART1319 in CC_COURANT {
    label fr official "Article 1319";
    kind article;
    locator "article/1319";
    text fr official """Article 1319
Les codébiteurs solidaires répondent solidairement de l'inexécution de l'obligation. La charge en incombe à titre définitif à ceux auxquels l'inexécution est imputable.
""";
    content_hash "sha256:baf4e0d38c2aa6430c2d9616b02d8172c136a21ffb5db7fa90c096d910b604ed";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1320")
pub fragment CC_ART1320 in CC_COURANT {
    label fr official "Article 1320";
    kind article;
    locator "article/1320";
    text fr official """Article 1320
Chacun des créanciers d'une obligation à prestation indivisible, par nature ou par contrat, peut en exiger et en recevoir le paiement intégral, sauf à rendre compte aux autres ; mais il ne peut seul disposer de la créance ni recevoir le prix au lieu de la chose.
Chacun des débiteurs d'une telle obligation en est tenu pour le tout ; mais il a ses recours en contribution contre les autres.
Il en va de même pour chacun des successeurs de ces créanciers et débiteurs.
""";
    content_hash "sha256:fb097556b049dc5cb9350172401b4b418a6562a8e9f692d40ec36cf9a4670fba";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1321")
pub fragment CC_ART1321 in CC_COURANT {
    label fr official "Article 1321";
    kind article;
    locator "article/1321";
    text fr official """Article 1321
La cession de créance est un contrat par lequel le créancier cédant transmet, à titre onéreux ou gratuit, tout ou partie de sa créance contre le débiteur cédé à un tiers appelé le cessionnaire.
Elle peut porter sur une ou plusieurs créances présentes ou futures, déterminées ou déterminables.
Elle s'étend aux accessoires de la créance.
Le consentement du débiteur n'est pas requis, à moins que la créance ait été stipulée incessible.
""";
    content_hash "sha256:a396588215123ce55aba13c7a33be83b1092d794ca252b1f241d2659f78ba3f0";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1322")
pub fragment CC_ART1322 in CC_COURANT {
    label fr official "Article 1322";
    kind article;
    locator "article/1322";
    text fr official """Article 1322
La cession de créance doit être constatée par écrit, à peine de nullité.
""";
    content_hash "sha256:92b24bb5e62f3733be39af799cf19f54ab8b0bbc2b704acec3b8927162bbcee1";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1323")
pub fragment CC_ART1323 in CC_COURANT {
    label fr official "Article 1323";
    kind article;
    locator "article/1323";
    text fr official """Article 1323
Entre les parties, le transfert de la créance, présente ou future, s'opère à la date de l'acte.
Il est opposable aux tiers dès ce moment. En cas de contestation, la preuve de la date de la cession incombe au cessionnaire, qui peut la rapporter par tout moyen.
""";
    content_hash "sha256:c1bb58a9c0401ac2aaacda48945724d544c2867f7ef5cd30b1ac8ebfd3f46ec3";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1324")
pub fragment CC_ART1324 in CC_COURANT {
    label fr official "Article 1324";
    kind article;
    locator "article/1324";
    text fr official """Article 1324
La cession n'est opposable au débiteur, s'il n'y a déjà consenti, que si elle lui a été notifiée ou s'il en a pris acte.
Le débiteur peut opposer au cessionnaire les exceptions inhérentes à la dette, telles que la nullité, l'exception d'inexécution, la résolution ou la compensation des dettes connexes. Il peut également opposer les exceptions nées de ses rapports avec le cédant avant que la cession lui soit devenue opposable, telles que l'octroi d'un terme, la remise de dette ou la compensation de dettes non connexes.
Le cédant et le cessionnaire sont solidairement tenus de tous les frais supplémentaires occasionnés par la cession dont le débiteur n'a pas à faire l'avance. Sauf clause contraire, la charge de ces frais incombe au cessionnaire.
""";
    content_hash "sha256:3badc5aeaef7da035b236123f6357d56dc82dca1ad35e08165f712c5497de069";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1325")
pub fragment CC_ART1325 in CC_COURANT {
    label fr official "Article 1325";
    kind article;
    locator "article/1325";
    text fr official """Article 1325
Le concours entre cessionnaires successifs d'une créance se résout en faveur du premier en date ; il dispose d'un recours contre celui auquel le débiteur aurait fait un paiement.
""";
    content_hash "sha256:abce834403fefb498df758e80d4f5a25944da0555220b39bc2a11cb92ee6ffb9";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1326")
pub fragment CC_ART1326 in CC_COURANT {
    label fr official "Article 1326";
    kind article;
    locator "article/1326";
    text fr official """Article 1326
Celui qui cède une créance à titre onéreux garantit l'existence de la créance et de ses accessoires, à moins que le cessionnaire l'ait acquise à ses risques et périls ou qu'il ait connu le caractère incertain de la créance.
Il ne répond de la solvabilité du débiteur que lorsqu'il s'y est engagé, et jusqu'à concurrence du prix qu'il a pu retirer de la cession de sa créance.
Lorsque le cédant a garanti la solvabilité du débiteur, cette garantie ne s'entend que de la solvabilité actuelle ; elle peut toutefois s'étendre à la solvabilité à l'échéance, mais à la condition que le cédant l'ait expressément spécifié.
""";
    content_hash "sha256:efdc4e23cc00042bcec9e0dd833af7ef639c8573eae2d07b255fbbc22e516c65";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1327")
pub fragment CC_ART1327 in CC_COURANT {
    label fr official "Article 1327";
    kind article;
    locator "article/1327";
    text fr official """Article 1327
Un débiteur peut, avec l'accord du créancier, céder sa dette.
La cession doit être constatée par écrit, à peine de nullité.
""";
    content_hash "sha256:bf863f02c310ba24ac59d544f4b352aca1bdfa782e571f8a32101ae712adb92c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1327_1")
pub fragment CC_ART1327_1 in CC_COURANT {
    label fr official "Article 1327-1";
    kind article;
    locator "article/1327-1";
    text fr official """Article 1327-1
Le créancier, s'il a par avance donné son accord à la cession et n'y est pas intervenu, ne peut se la voir opposer ou s'en prévaloir que du jour où elle lui a été notifiée ou dès qu'il en a pris acte.
""";
    content_hash "sha256:cb70f63f22fa299cfde226240fc2f078d869222a21bc76796b0ccbb0be9374f9";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1327_2")
pub fragment CC_ART1327_2 in CC_COURANT {
    label fr official "Article 1327-2";
    kind article;
    locator "article/1327-2";
    text fr official """Article 1327-2
Si le créancier y consent expressément, le débiteur originaire est libéré pour l'avenir. A défaut, et sauf clause contraire, il est tenu solidairement au paiement de la dette.
""";
    content_hash "sha256:de061d33606b96154023348dab795a3a406cb41c86f6473556dcef8897979b3f";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1328")
pub fragment CC_ART1328 in CC_COURANT {
    label fr official "Article 1328";
    kind article;
    locator "article/1328";
    text fr official """Article 1328
Le débiteur substitué, et le débiteur originaire s'il reste tenu, peuvent opposer au créancier les exceptions inhérentes à la dette, telles que la nullité, l'exception d'inexécution, la résolution ou la compensation de dettes connexes. Chacun peut aussi opposer les exceptions qui lui sont personnelles.
""";
    content_hash "sha256:e4bd3700181d2b48e1798e6eeee7a28c4f81ea56607cf880d209bf4aecd0235d";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1328_1")
pub fragment CC_ART1328_1 in CC_COURANT {
    label fr official "Article 1328-1";
    kind article;
    locator "article/1328-1";
    text fr official """Article 1328-1
Lorsque le débiteur originaire n'est pas déchargé par le créancier, les sûretés subsistent. Dans le cas contraire, les sûretés consenties par le débiteur originaire ou par des tiers ne subsistent qu'avec leur accord.
Si le cédant est déchargé, ses codébiteurs solidaires restent tenus déduction faite de sa part dans la dette.
""";
    content_hash "sha256:99e01a88aff03a3acfb24a2b23e35e63a1a3aa263e97647bc959c697e50ce059";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1329")
pub fragment CC_ART1329 in CC_COURANT {
    label fr official "Article 1329";
    kind article;
    locator "article/1329";
    text fr official """Article 1329
La novation est un contrat qui a pour objet de substituer à une obligation, qu'elle éteint, une obligation nouvelle qu'elle crée.
Elle peut avoir lieu par substitution d'obligation entre les mêmes parties, par changement de débiteur ou par changement de créancier.
""";
    content_hash "sha256:96bafe5cd3d20d7a72e701716db2f70cb6b0de7ef056656e5285ff6c7d8516b2";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1330")
pub fragment CC_ART1330 in CC_COURANT {
    label fr official "Article 1330";
    kind article;
    locator "article/1330";
    text fr official """Article 1330
La novation ne se présume pas ; la volonté de l'opérer doit résulter clairement de l'acte.
""";
    content_hash "sha256:9bcaf04e961a1c8da717eb242b8964990c33a2560e6f6926f8122017770364e1";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1331")
pub fragment CC_ART1331 in CC_COURANT {
    label fr official "Article 1331";
    kind article;
    locator "article/1331";
    text fr official """Article 1331
La novation n'a lieu que si l'obligation ancienne et l'obligation nouvelle sont l'une et l'autre valables, à moins qu'elle n'ait pour objet déclaré de substituer un engagement valable à un engagement entaché d'un vice.
""";
    content_hash "sha256:76d14694396305d91d5106e4d1d76a8b1e5d832229caa795018c1cbdb18b4da0";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1332")
pub fragment CC_ART1332 in CC_COURANT {
    label fr official "Article 1332";
    kind article;
    locator "article/1332";
    text fr official """Article 1332
La novation par changement de débiteur peut s'opérer sans le concours du premier débiteur.
""";
    content_hash "sha256:933868aefa8ca110e2ef151aa80a6d12c11416541d095f025e479487c54d0e00";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1333")
pub fragment CC_ART1333 in CC_COURANT {
    label fr official "Article 1333";
    kind article;
    locator "article/1333";
    text fr official """Article 1333
La novation par changement de créancier requiert le consentement du débiteur. Celui-ci peut, par avance, accepter que le nouveau créancier soit désigné par le premier.
La novation est opposable aux tiers à la date de l'acte. En cas de contestation de la date de la novation, la preuve en incombe au nouveau créancier, qui peut l'apporter par tout moyen.
""";
    content_hash "sha256:881c5ba8861c33be1908a6b06770efdda1bd884e0cee0cba297eb72b00c21072";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1334")
pub fragment CC_ART1334 in CC_COURANT {
    label fr official "Article 1334";
    kind article;
    locator "article/1334";
    text fr official """Article 1334
L'extinction de l'obligation ancienne s'étend à tous ses accessoires.
Par exception, les sûretés d'origine peuvent être réservées pour la garantie de la nouvelle obligation avec le consentement des tiers garants.
""";
    content_hash "sha256:06a29e9be5d10070eefbdce36b9422e5a6dac6abd395f5e2b9a492b171eae1a2";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1335")
pub fragment CC_ART1335 in CC_COURANT {
    label fr official "Article 1335";
    kind article;
    locator "article/1335";
    text fr official """Article 1335
La novation convenue entre le créancier et l'un des codébiteurs solidaires libère les autres.
La novation convenue entre le créancier et une caution ne libère pas le débiteur principal. Elle libère les autres cautions à concurrence de la part contributive de celle dont l'obligation a fait l'objet de la novation.
""";
    content_hash "sha256:9fa2b43a7ba5563355ba96322331481314c080c22cf0f35d45965acbf714c5a3";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1336")
pub fragment CC_ART1336 in CC_COURANT {
    label fr official "Article 1336";
    kind article;
    locator "article/1336";
    text fr official """Article 1336
La délégation est une opération par laquelle une personne, le délégant, obtient d'une autre, le délégué, qu'elle s'oblige envers une troisième, le délégataire, qui l'accepte comme débiteur.
Le délégué ne peut, sauf stipulation contraire, opposer au délégataire aucune exception tirée de ses rapports avec le délégant ou des rapports entre ce dernier et le délégataire.
""";
    content_hash "sha256:848a1446b9d57d66689c4a82abc79dd161785d759737f60746259e3a687b5a4c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1337")
pub fragment CC_ART1337 in CC_COURANT {
    label fr official "Article 1337";
    kind article;
    locator "article/1337";
    text fr official """Article 1337
Lorsque le délégant est débiteur du délégataire et que la volonté du délégataire de décharger le délégant résulte expressément de l'acte, la délégation opère novation.
Toutefois, le délégant demeure tenu s'il s'est expressément engagé à garantir la solvabilité future du délégué ou si ce dernier se trouve soumis à une procédure d'apurement de ses dettes lors de la délégation.
""";
    content_hash "sha256:4399bd8888fb22d8025979e48d5b34df7d29459a99f1abd82670935be7bb5c8d";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1338")
pub fragment CC_ART1338 in CC_COURANT {
    label fr official "Article 1338";
    kind article;
    locator "article/1338";
    text fr official """Article 1338
Lorsque le délégant est débiteur du délégataire mais que celui-ci ne l'a pas déchargé de sa dette, la délégation donne au délégataire un second débiteur.
Le paiement fait par l'un des deux débiteurs libère l'autre, à due concurrence.
""";
    content_hash "sha256:db162fe34b7f38e3b329dcbcecd6840b433be0d92ef2bb73562e6d158c622f79";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1339")
pub fragment CC_ART1339 in CC_COURANT {
    label fr official "Article 1339";
    kind article;
    locator "article/1339";
    text fr official """Article 1339
Lorsque le délégant est créancier du délégué, sa créance ne s'éteint que par l'exécution de l'obligation du délégué envers le délégataire et à due concurrence.
Jusque-là, le délégant ne peut en exiger ou en recevoir le paiement que pour la part qui excèderait l'engagement du délégué. Il ne recouvre ses droits qu'en exécutant sa propre obligation envers le délégataire.
La cession ou la saisie de la créance du délégant ne produisent effet que sous les mêmes limitations.
Toutefois, si le délégataire a libéré le délégant, le délégué est lui-même libéré à l'égard du délégant, à concurrence du montant de son engagement envers le délégataire.
""";
    content_hash "sha256:7ad6c543df5ef8898dba3243dfe77f10359ceed4c9d93b47eaa5f1a27360effb";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1340")
pub fragment CC_ART1340 in CC_COURANT {
    label fr official "Article 1340";
    kind article;
    locator "article/1340";
    text fr official """Article 1340
La simple indication faite par le débiteur d'une personne désignée pour payer à sa place n'emporte ni novation, ni délégation. Il en est de même de la simple indication faite, par le créancier, d'une personne désignée pour recevoir le paiement pour lui.
""";
    content_hash "sha256:e3a8e058b34bfce7bbbf73b1f12f32899f372f06208c7aa7cdea51cfcdd439db";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1341")
pub fragment CC_ART1341 in CC_COURANT {
    label fr official "Article 1341";
    kind article;
    locator "article/1341";
    text fr official """Article 1341
Le créancier a droit à l'exécution de l'obligation ; il peut y contraindre le débiteur dans les conditions prévues par la loi.
""";
    content_hash "sha256:857d352e2e312d14c96ff86a469e83c89045398bfac9858ede0781c873ddaf2c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1341_1")
pub fragment CC_ART1341_1 in CC_COURANT {
    label fr official "Article 1341-1";
    kind article;
    locator "article/1341-1";
    text fr official """Article 1341-1
Lorsque la carence du débiteur dans l'exercice de ses droits et actions à caractère patrimonial compromet les droits de son créancier, celui-ci peut les exercer pour le compte de son débiteur, à l'exception de ceux qui sont exclusivement rattachés à sa personne.
""";
    content_hash "sha256:01242d35b5e026319f7d05e069a23fa262763657159bc9cbcebae95a0f022d56";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1341_2")
pub fragment CC_ART1341_2 in CC_COURANT {
    label fr official "Article 1341-2";
    kind article;
    locator "article/1341-2";
    text fr official """Article 1341-2
Le créancier peut aussi agir en son nom personnel pour faire déclarer inopposables à son égard les actes faits par son débiteur en fraude de ses droits, à charge d'établir, s'il s'agit d'un acte à titre onéreux, que le tiers cocontractant avait connaissance de la fraude.
""";
    content_hash "sha256:e2cc39fccb47719f7f5cf4cd2fedc54fdf16b456cea0a0e977ce4fff572d9e2f";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1341_3")
pub fragment CC_ART1341_3 in CC_COURANT {
    label fr official "Article 1341-3";
    kind article;
    locator "article/1341-3";
    text fr official """Article 1341-3
Dans les cas déterminés par la loi, le créancier peut agir directement en paiement de sa créance contre un débiteur de son débiteur.
""";
    content_hash "sha256:7d58d8050a3397a3d2e2975f78e32d384e9296c84586a173794d92ddcadbebbf";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342")
pub fragment CC_ART1342 in CC_COURANT {
    label fr official "Article 1342";
    kind article;
    locator "article/1342";
    text fr official """Article 1342
Le paiement est l'exécution volontaire de la prestation due.
Il doit être fait sitôt que la dette devient exigible.
Il libère le débiteur à l'égard du créancier et éteint la dette, sauf lorsque la loi ou le contrat prévoit une subrogation dans les droits du créancier.
""";
    content_hash "sha256:39e60cb293aa9bf0cce9792c9f356fd91c706245a2dc1c870300f555380876d7";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_1")
pub fragment CC_ART1342_1 in CC_COURANT {
    label fr official "Article 1342-1";
    kind article;
    locator "article/1342-1";
    text fr official """Article 1342-1
Le paiement peut être fait même par une personne qui n'y est pas tenue, sauf refus légitime du créancier.
""";
    content_hash "sha256:ead8c65a15e5fd89591d7c3a4d4286225f82a649eaf5b438c8ee661c72e2d78f";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_2")
pub fragment CC_ART1342_2 in CC_COURANT {
    label fr official "Article 1342-2";
    kind article;
    locator "article/1342-2";
    text fr official """Article 1342-2
Le paiement doit être fait au créancier ou à la personne désignée pour le recevoir.
Le paiement fait à une personne qui n'avait pas qualité pour le recevoir est néanmoins valable si le créancier le ratifie ou s'il en a profité.
Le paiement fait à un créancier dans l'incapacité de contracter n'est pas valable, s'il n'en a tiré profit.
""";
    content_hash "sha256:4b80744c20df9e988cbf0b5683c0f096918f06b73aac25d4aa105297da823413";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_3")
pub fragment CC_ART1342_3 in CC_COURANT {
    label fr official "Article 1342-3";
    kind article;
    locator "article/1342-3";
    text fr official """Article 1342-3
Le paiement fait de bonne foi à un créancier apparent est valable.
""";
    content_hash "sha256:f59226d67c952a081e023eecfea3df2598f815e63d85518b14ed85968fd500ba";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_4")
pub fragment CC_ART1342_4 in CC_COURANT {
    label fr official "Article 1342-4";
    kind article;
    locator "article/1342-4";
    text fr official """Article 1342-4
Le créancier peut refuser un paiement partiel même si la prestation est divisible.
Il peut accepter de recevoir en paiement autre chose que ce qui lui est dû.
""";
    content_hash "sha256:679a2aae12bfc6eb2ac1a87dc1f9090e911d72b7548d6e17060b322f96311cf5";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_5")
pub fragment CC_ART1342_5 in CC_COURANT {
    label fr official "Article 1342-5";
    kind article;
    locator "article/1342-5";
    text fr official """Article 1342-5
Le débiteur d'une obligation de remettre un corps certain est libéré par sa remise au créancier en l'état, sauf à prouver, en cas de détérioration, que celle-ci n'est pas due à son fait ou à celui de personnes dont il doit répondre.
""";
    content_hash "sha256:33c0558c633a2142d954066a021c2939dce7833486af1ff186e8c9d2002ae078";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_6")
pub fragment CC_ART1342_6 in CC_COURANT {
    label fr official "Article 1342-6";
    kind article;
    locator "article/1342-6";
    text fr official """Article 1342-6
A défaut d'une autre désignation par la loi, le contrat ou le juge, le paiement doit être fait au domicile du débiteur.
""";
    content_hash "sha256:cfc43e3b43ed59bbf28de8558ba605653469e22ba65b18ff82d9a80ef54973d4";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_7")
pub fragment CC_ART1342_7 in CC_COURANT {
    label fr official "Article 1342-7";
    kind article;
    locator "article/1342-7";
    text fr official """Article 1342-7
Les frais du paiement sont à la charge du débiteur.
""";
    content_hash "sha256:5bb7e711042463fd0348cabd1ab0c9d249f1f76eda8870718423fa8a61f302d2";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_8")
pub fragment CC_ART1342_8 in CC_COURANT {
    label fr official "Article 1342-8";
    kind article;
    locator "article/1342-8";
    text fr official """Article 1342-8
Le paiement se prouve par tout moyen.
""";
    content_hash "sha256:12719e80ff89689ded3229a0eeedc669955f613be819084039a0c1c755125ec9";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_9")
pub fragment CC_ART1342_9 in CC_COURANT {
    label fr official "Article 1342-9";
    kind article;
    locator "article/1342-9";
    text fr official """Article 1342-9
La remise volontaire par le créancier au débiteur de l'original sous signature privée ou de la copie exécutoire du titre de sa créance vaut présomption simple de libération.
La même remise à l'un des codébiteurs solidaires produit le même effet à l'égard de tous.
""";
    content_hash "sha256:4087ea02a8e47699260f188c7670848a813683fa275acae285cba10aa600ab61";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1342_10")
pub fragment CC_ART1342_10 in CC_COURANT {
    label fr official "Article 1342-10";
    kind article;
    locator "article/1342-10";
    text fr official """Article 1342-10
Le débiteur de plusieurs dettes peut indiquer, lorsqu'il paie, celle qu'il entend acquitter.
A défaut d'indication par le débiteur, l'imputation a lieu comme suit : d'abord sur les dettes échues ; parmi celles-ci, sur les dettes que le débiteur avait le plus d'intérêt d'acquitter. A égalité d'intérêt, l'imputation se fait sur la plus ancienne ; toutes choses égales, elle se fait proportionnellement.
""";
    content_hash "sha256:1561f0643f1c01b76e8b180dde184c0bdced47d78dc6b046c2d304d7736a3c95";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1343")
pub fragment CC_ART1343 in CC_COURANT {
    label fr official "Article 1343";
    kind article;
    locator "article/1343";
    text fr official """Article 1343
Le débiteur d'une obligation de somme d'argent se libère par le versement de son montant nominal.
Le montant de la somme due peut varier par le jeu de l'indexation.
Le débiteur d'une dette de valeur se libère par le versement de la somme d'argent résultant de sa liquidation.
""";
    content_hash "sha256:191068d2451795bfa815f34cfc8ecec29393048886ae80c26165648ffa886555";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1343_1")
pub fragment CC_ART1343_1 in CC_COURANT {
    label fr official "Article 1343-1";
    kind article;
    locator "article/1343-1";
    text fr official """Article 1343-1
Lorsque l'obligation de somme d'argent porte intérêt, le débiteur se libère en versant le principal et les intérêts. Le paiement partiel s'impute d'abord sur les intérêts.
L'intérêt est accordé par la loi ou stipulé dans le contrat. Le taux de l'intérêt conventionnel doit être fixé par écrit. Il est réputé annuel par défaut.
""";
    content_hash "sha256:56a151068db4f78606f02de94890dfaf4ece250b4aceac666ff555bcf02441e8";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1343_2")
pub fragment CC_ART1343_2 in CC_COURANT {
    label fr official "Article 1343-2";
    kind article;
    locator "article/1343-2";
    text fr official """Article 1343-2
Les intérêts échus, dus au moins pour une année entière, produisent intérêt si le contrat l'a prévu ou si une décision de justice le précise.
""";
    content_hash "sha256:17ec43a1ecab3cf0efde244d0b1bc6d6de008020de34ae491fd93d6e99db2d5d";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1343_3")
pub fragment CC_ART1343_3 in CC_COURANT {
    label fr official "Article 1343-3";
    kind article;
    locator "article/1343-3";
    text fr official """Article 1343-3
Le paiement, en France, d'une obligation de somme d'argent s'effectue en euros. Toutefois, le paiement peut avoir lieu en une autre monnaie si l'obligation ainsi libellée procède d'une opération à caractère international ou d'un jugement étranger. Les parties peuvent convenir que le paiement aura lieu en devise s'il intervient entre professionnels, lorsque l'usage d'une monnaie étrangère est communément admis pour l'opération concernée.
""";
    content_hash "sha256:5797544b2a737f3a96fe739d1bd8e7a1b3416c051c27c14ab7429ce87bc8d6fb";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1343_4")
pub fragment CC_ART1343_4 in CC_COURANT {
    label fr official "Article 1343-4";
    kind article;
    locator "article/1343-4";
    text fr official """Article 1343-4
A défaut d'une autre désignation par la loi, le contrat ou le juge, le lieu du paiement de l'obligation de somme d'argent est le domicile du créancier.
""";
    content_hash "sha256:93c1bf67406f54eb46c082254b80abfe2f4e69b6412fec72954997f3ae9ce8a4";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1343_5")
pub fragment CC_ART1343_5 in CC_COURANT {
    label fr official "Article 1343-5";
    kind article;
    locator "article/1343-5";
    text fr official """Article 1343-5
Le juge peut, compte tenu de la situation du débiteur et en considération des besoins du créancier, reporter ou échelonner, dans la limite de deux années, le paiement des sommes dues.
Par décision spéciale et motivée, il peut ordonner que les sommes correspondant aux échéances reportées porteront intérêt à un taux réduit au moins égal au taux légal, ou que les paiements s'imputeront d'abord sur le capital.
Il peut subordonner ces mesures à l'accomplissement par le débiteur d'actes propres à faciliter ou à garantir le paiement de la dette.
La décision du juge suspend les procédures d'exécution qui auraient été engagées par le créancier. Les majorations d'intérêts ou les pénalités prévues en cas de retard ne sont pas encourues pendant le délai fixé par le juge.
Toute stipulation contraire est réputée non écrite.
Les dispositions du présent article ne sont pas applicables aux dettes d'aliment.
""";
    content_hash "sha256:01a73de2b71528288b88df904238c5e3cfc6df3bf5acae37c03e6c512dfb027b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1344")
pub fragment CC_ART1344 in CC_COURANT {
    label fr official "Article 1344";
    kind article;
    locator "article/1344";
    text fr official """Article 1344
Le débiteur est mis en demeure de payer soit par une sommation ou un acte portant interpellation suffisante, soit, si le contrat le prévoit, par la seule exigibilité de l'obligation.
""";
    content_hash "sha256:2c67015c0c2653b5d09db68f4ec70526187069c27199338ba68ea6b7e72c1ebe";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1344_1")
pub fragment CC_ART1344_1 in CC_COURANT {
    label fr official "Article 1344-1";
    kind article;
    locator "article/1344-1";
    text fr official """Article 1344-1
La mise en demeure de payer une obligation de somme d'argent fait courir l'intérêt moratoire, au taux légal, sans que le créancier soit tenu de justifier d'un préjudice.
""";
    content_hash "sha256:797759ffd9483099e5682ab467cccefc7e88ec8b099eb2b3fd752a5256c49da5";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1344_2")
pub fragment CC_ART1344_2 in CC_COURANT {
    label fr official "Article 1344-2";
    kind article;
    locator "article/1344-2";
    text fr official """Article 1344-2
La mise en demeure de délivrer une chose met les risques à la charge du débiteur, s'ils n'y sont déjà.
""";
    content_hash "sha256:11b570b4f6f2f76c3852300c87d2671cd4f8c715a9cedc59eaa06c34f321fed6";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1345")
pub fragment CC_ART1345 in CC_COURANT {
    label fr official "Article 1345";
    kind article;
    locator "article/1345";
    text fr official """Article 1345
Lorsque le créancier, à l'échéance et sans motif légitime, refuse de recevoir le paiement qui lui est dû ou l'empêche par son fait, le débiteur peut le mettre en demeure d'en accepter ou d'en permettre l'exécution.
La mise en demeure du créancier arrête le cours des intérêts dus par le débiteur et met les risques de la chose à la charge du créancier, s'ils n'y sont déjà, sauf faute lourde ou dolosive du débiteur.
Elle n'interrompt pas la prescription.
""";
    content_hash "sha256:65cd4f1fa8205d72ead7837afc0c0eff04f37cea5f29366e20bd9f28bd5c1e46";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1345_1")
pub fragment CC_ART1345_1 in CC_COURANT {
    label fr official "Article 1345-1";
    kind article;
    locator "article/1345-1";
    text fr official """Article 1345-1
Si l'obstruction n'a pas pris fin dans les deux mois de la mise en demeure, le débiteur peut, lorsque l'obligation porte sur une somme d'argent, la consigner à la Caisse des dépôts et consignations ou, lorsque l'obligation porte sur la livraison d'une chose, séquestrer celle-ci auprès d'un gardien professionnel.
Si le séquestre de la chose est impossible ou trop onéreux, le juge peut en autoriser la vente amiable ou aux enchères publiques. Déduction faite des frais de la vente, le prix en est consigné à la Caisse des dépôts et consignations.
La consignation ou le séquestre libère le débiteur à compter de leur notification au créancier.
""";
    content_hash "sha256:72e7e8ef9f827511250db8b5218d61a27a21e5d02a53b297a3423e3213b6fe75";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1345_2")
pub fragment CC_ART1345_2 in CC_COURANT {
    label fr official "Article 1345-2";
    kind article;
    locator "article/1345-2";
    text fr official """Article 1345-2
Lorsque l'obligation porte sur un autre objet, le débiteur est libéré si l'obstruction n'a pas cessé dans les deux mois de la mise en demeure.
""";
    content_hash "sha256:bbe87ad34554b1b8fc594f92ac373cf1697e24d9a565b52adaa70dd4e19e48a1";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1345_3")
pub fragment CC_ART1345_3 in CC_COURANT {
    label fr official "Article 1345-3";
    kind article;
    locator "article/1345-3";
    text fr official """Article 1345-3
Les frais de la mise en demeure et de la consignation ou du séquestre sont à la charge du créancier.
""";
    content_hash "sha256:3f62532d2e19c07645e80a28655342a9a8f7f65aee6c35f2064324a10de5e485";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1346")
pub fragment CC_ART1346 in CC_COURANT {
    label fr official "Article 1346";
    kind article;
    locator "article/1346";
    text fr official """Article 1346
La subrogation a lieu par le seul effet de la loi au profit de celui qui, y ayant un intérêt légitime, paie dès lors que son paiement libère envers le créancier celui sur qui doit peser la charge définitive de tout ou partie de la dette.
""";
    content_hash "sha256:07416f324cfb1dba7411a1b79c42a180fadf615dd184d14b6faab9a96d4dee9c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1346_1")
pub fragment CC_ART1346_1 in CC_COURANT {
    label fr official "Article 1346-1";
    kind article;
    locator "article/1346-1";
    text fr official """Article 1346-1
La subrogation conventionnelle s'opère à l'initiative du créancier lorsque celui-ci, recevant son paiement d'une tierce personne, la subroge dans ses droits contre le débiteur.
Cette subrogation doit être expresse.
Elle doit être consentie en même temps que le paiement, à moins que, dans un acte antérieur, le subrogeant n'ait manifesté la volonté que son cocontractant lui soit subrogé lors du paiement. La concomitance de la subrogation et du paiement peut être prouvée par tous moyens.
""";
    content_hash "sha256:58447d532c4ded822359ae70abca398994dab03aa123385f8f28aa3937b64097";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1346_2")
pub fragment CC_ART1346_2 in CC_COURANT {
    label fr official "Article 1346-2";
    kind article;
    locator "article/1346-2";
    text fr official """Article 1346-2
La subrogation a lieu également lorsque le débiteur, empruntant une somme à l'effet de payer sa dette, subroge le prêteur dans les droits du créancier avec le concours de celui-ci. En ce cas, la subrogation doit être expresse et la quittance donnée par le créancier doit indiquer l'origine des fonds.
La subrogation peut être consentie sans le concours du créancier, mais à la condition que la dette soit échue ou que le terme soit en faveur du débiteur. Il faut alors que l'acte d'emprunt et la quittance soient passés devant notaire, que dans l'acte d'emprunt il soit déclaré que la somme a été empruntée pour faire le paiement, et que dans la quittance il soit déclaré que le paiement a été fait des sommes versées à cet effet par le nouveau créancier.
""";
    content_hash "sha256:7d40ef28c949fc00297efca174b3be3288af417562c83c6f955c7a864d5cb0ca";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1346_3")
pub fragment CC_ART1346_3 in CC_COURANT {
    label fr official "Article 1346-3";
    kind article;
    locator "article/1346-3";
    text fr official """Article 1346-3
La subrogation ne peut nuire au créancier lorsqu'il n'a été payé qu'en partie ; en ce cas, il peut exercer ses droits, pour ce qui lui reste dû, par préférence à celui dont il n'a reçu qu'un paiement partiel.
""";
    content_hash "sha256:b28000262da0967d1a5769d638d95b8267c34b2e8e9d50ae807cb2fc1bae5ea8";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1346_4")
pub fragment CC_ART1346_4 in CC_COURANT {
    label fr official "Article 1346-4";
    kind article;
    locator "article/1346-4";
    text fr official """Article 1346-4
La subrogation transmet à son bénéficiaire, dans la limite de ce qu'il a payé, la créance et ses accessoires, à l'exception des droits exclusivement attachés à la personne du créancier.
Toutefois, le subrogé n'a droit qu'à l'intérêt légal à compter d'une mise en demeure, s'il n'a convenu avec le débiteur d'un nouvel intérêt. Ces intérêts sont garantis par les sûretés attachées à la créance, dans les limites, lorsqu'elles ont été constituées par des tiers, de leurs engagements initiaux s'ils ne consentent à s'obliger au-delà.
""";
    content_hash "sha256:dd127cfd7bb18044f7c246dadc8e2d032662d73344a9f38e06fa09fa96167a7c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1346_5")
pub fragment CC_ART1346_5 in CC_COURANT {
    label fr official "Article 1346-5";
    kind article;
    locator "article/1346-5";
    text fr official """Article 1346-5
Le débiteur peut invoquer la subrogation dès qu'il en a connaissance mais elle ne peut lui être opposée que si elle lui a été notifiée ou s'il en a pris acte.
La subrogation est opposable aux tiers dès le paiement.
Le débiteur peut opposer au créancier subrogé les exceptions inhérentes à la dette, telles que la nullité, l'exception d'inexécution, la résolution ou la compensation de dettes connexes. Il peut également lui opposer les exceptions nées de ses rapports avec le subrogeant avant que la subrogation lui soit devenue opposable, telles que l'octroi d'un terme, la remise de dette ou la compensation de dettes non connexes.
""";
    content_hash "sha256:ac6ec7b118c113dac2bf9878d140ae9842d3eb8de1a31da10435054c199cdef1";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347")
pub fragment CC_ART1347 in CC_COURANT {
    label fr official "Article 1347";
    kind article;
    locator "article/1347";
    text fr official """Article 1347
La compensation est l'extinction simultanée d'obligations réciproques entre deux personnes.
Elle s'opère, sous réserve d'être invoquée, à due concurrence, à la date où ses conditions se trouvent réunies.
""";
    content_hash "sha256:663c41be19493c809151c68b1fedc9ec9ffc253a629046a3e668454524b312c3";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347_1")
pub fragment CC_ART1347_1 in CC_COURANT {
    label fr official "Article 1347-1";
    kind article;
    locator "article/1347-1";
    text fr official """Article 1347-1
Sous réserve des dispositions prévues à la sous-section suivante, la compensation n'a lieu qu'entre deux obligations fongibles, certaines, liquides et exigibles.
Sont fongibles les obligations de somme d'argent, même en différentes devises, pourvu qu'elles soient convertibles, ou celles qui ont pour objet une quantité de choses de même genre.
""";
    content_hash "sha256:f8e27b28e51e734c73e75fef9ca3018fe751feab35388ceb6970a74372391369";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347_2")
pub fragment CC_ART1347_2 in CC_COURANT {
    label fr official "Article 1347-2";
    kind article;
    locator "article/1347-2";
    text fr official """Article 1347-2
Les créances insaisissables et les obligations de restitution d'un dépôt, d'un prêt à usage ou d'une chose dont le propriétaire a été injustement privé ne sont compensables que si le créancier y consent.
""";
    content_hash "sha256:5aa444002ce4512f098a59fe3c78ac1c3e6c269438ef33fe3fb28d35f9e09b1d";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347_3")
pub fragment CC_ART1347_3 in CC_COURANT {
    label fr official "Article 1347-3";
    kind article;
    locator "article/1347-3";
    text fr official """Article 1347-3
Le délai de grâce ne fait pas obstacle à la compensation.
""";
    content_hash "sha256:f390a8958f341282acd0fe3f519c57e9c64f8d950e7b6c95e61767b5e1d1d54b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347_4")
pub fragment CC_ART1347_4 in CC_COURANT {
    label fr official "Article 1347-4";
    kind article;
    locator "article/1347-4";
    text fr official """Article 1347-4
S'il y a plusieurs dettes compensables, les règles d'imputation des paiements sont transposables.
""";
    content_hash "sha256:e99061b0977ed05fdf693da761f82a248b7d10e59cc46464c1dd4669d318c325";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347_5")
pub fragment CC_ART1347_5 in CC_COURANT {
    label fr official "Article 1347-5";
    kind article;
    locator "article/1347-5";
    text fr official """Article 1347-5
Le débiteur qui a pris acte sans réserve de la cession de la créance ne peut opposer au cessionnaire la compensation qu'il eût pu opposer au cédant.
""";
    content_hash "sha256:4b408cacc7c1ba9194de9a50ad4e6712a337d2a88157bbf5255c483a8a86b325";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347_6")
pub fragment CC_ART1347_6 in CC_COURANT {
    label fr official "Article 1347-6";
    kind article;
    locator "article/1347-6";
    text fr official """Article 1347-6
La caution peut opposer la compensation de ce que le créancier doit au débiteur principal. Le codébiteur solidaire peut se prévaloir de la compensation de ce que le créancier doit à l'un de ses coobligés pour faire déduire la part divise de celui-ci du total de la dette.
""";
    content_hash "sha256:86207ea8a563b403f10418cd92a104781280ecbe102201e75635db139706b16b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1347_7")
pub fragment CC_ART1347_7 in CC_COURANT {
    label fr official "Article 1347-7";
    kind article;
    locator "article/1347-7";
    text fr official """Article 1347-7
La compensation ne préjudicie pas aux droits acquis par des tiers.
""";
    content_hash "sha256:25ba9dd1ba3c74f326a0a25e1492228c022476844e2542a2d1d12e06fa2c9674";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1348")
pub fragment CC_ART1348 in CC_COURANT {
    label fr official "Article 1348";
    kind article;
    locator "article/1348";
    text fr official """Article 1348
La compensation peut être prononcée en justice, même si l'une des obligations, quoique certaine, n'est pas encore liquide ou exigible. A moins qu'il n'en soit décidé autrement, la compensation produit alors ses effets à la date de la décision.
""";
    content_hash "sha256:ea38cc856e1a458057bf6de5112cb3118f2e0c694807f6c0217a85263673a398";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1348_1")
pub fragment CC_ART1348_1 in CC_COURANT {
    label fr official "Article 1348-1";
    kind article;
    locator "article/1348-1";
    text fr official """Article 1348-1
Le juge ne peut refuser la compensation de dettes connexes au seul motif que l'une des obligations ne serait pas liquide ou exigible.
Dans ce cas, la compensation est réputée s'être produite au jour de l'exigibilité de la première d'entre elles.
Dans le même cas, l'acquisition de droits par un tiers sur l'une des obligations n'empêche pas son débiteur d'opposer la compensation.
""";
    content_hash "sha256:14bcef616ae4b5214a27d7166da44ad8b27b044521ad3389ef4000fe28e2ae3c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1348_2")
pub fragment CC_ART1348_2 in CC_COURANT {
    label fr official "Article 1348-2";
    kind article;
    locator "article/1348-2";
    text fr official """Article 1348-2
Les parties peuvent librement convenir d'éteindre toutes obligations réciproques, présentes ou futures, par une compensation ; celle-ci prend effet à la date de leur accord ou, s'il s'agit d'obligations futures, à celle de leur coexistence.
""";
    content_hash "sha256:1e4e8732cd646f676fbac3c69c874af118b655b1f1acbd931b88331b7b85abf4";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1349")
pub fragment CC_ART1349 in CC_COURANT {
    label fr official "Article 1349";
    kind article;
    locator "article/1349";
    text fr official """Article 1349
La confusion résulte de la réunion des qualités de créancier et de débiteur d'une même obligation dans la même personne. Elle éteint la créance et ses accessoires, sous réserve des droits acquis par ou contre des tiers.
""";
    content_hash "sha256:ffbf9878c1f3594f59454d6aa9b4939e596aeee6466bb96bcaf56308a248522b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1349_1")
pub fragment CC_ART1349_1 in CC_COURANT {
    label fr official "Article 1349-1";
    kind article;
    locator "article/1349-1";
    text fr official """Article 1349-1
Lorsqu'il y a solidarité entre plusieurs débiteurs ou entre plusieurs créanciers, et que la confusion ne concerne que l'un d'eux, l'extinction n'a lieu, à l'égard des autres, que pour sa part.
Lorsque la confusion concerne une obligation cautionnée, la caution, même solidaire, est libérée. Lorsque la confusion concerne l'obligation d'une des cautions, le débiteur principal n'est pas libéré. Les autres cautions solidaires sont libérées à concurrence de la part de cette caution.
""";
    content_hash "sha256:767e7ae4c6b2658fbaad8cac3ad5b7ad4cffa4f08a9f26998a10ff2c359fe4df";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1350")
pub fragment CC_ART1350 in CC_COURANT {
    label fr official "Article 1350";
    kind article;
    locator "article/1350";
    text fr official """Article 1350
La remise de dette est le contrat par lequel le créancier libère le débiteur de son obligation.
""";
    content_hash "sha256:497e1ca8f37d39741013092c2bfe3e9b9a6c53bb45a93c6f80091cd5591e1044";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1350_1")
pub fragment CC_ART1350_1 in CC_COURANT {
    label fr official "Article 1350-1";
    kind article;
    locator "article/1350-1";
    text fr official """Article 1350-1
La remise de dette consentie à l'un des codébiteurs solidaires libère les autres à concurrence de sa part.
La remise de dette faite par l'un seulement des créanciers solidaires ne libère le débiteur que pour la part de ce créancier.
""";
    content_hash "sha256:8a4a451e1a24bf87f90c4b830f67cbdc7f40fe82727cb0cb699f1b37ddc41643";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1350_2")
pub fragment CC_ART1350_2 in CC_COURANT {
    label fr official "Article 1350-2";
    kind article;
    locator "article/1350-2";
    text fr official """Article 1350-2
La remise de dette accordée au débiteur principal libère les cautions, même solidaires.
La remise consentie à l'une des cautions solidaires ne libère pas le débiteur principal, mais libère les autres à concurrence de sa part.
Ce que le créancier a reçu d'une caution pour la décharge de son cautionnement doit être imputé sur la dette et décharger le débiteur principal à proportion. Les autres cautions ne restent tenues que déduction faite de la part de la caution libérée ou de la valeur fournie si elle excède cette part.
""";
    content_hash "sha256:9c81ab9fe7a42e162e41b3cbad64be15466e75a341736f244df323bcaa3613c1";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1351")
pub fragment CC_ART1351 in CC_COURANT {
    label fr official "Article 1351";
    kind article;
    locator "article/1351";
    text fr official """Article 1351
L'impossibilité d'exécuter la prestation libère le débiteur à due concurrence lorsqu'elle procède d'un cas de force majeure et qu'elle est définitive, à moins qu'il n'ait convenu de s'en charger ou qu'il ait été préalablement mis en demeure.
""";
    content_hash "sha256:85043bada47c7a93130c4d60b412536170480b2dc583fbde4da33722e04a9477";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1351_1")
pub fragment CC_ART1351_1 in CC_COURANT {
    label fr official "Article 1351-1";
    kind article;
    locator "article/1351-1";
    text fr official """Article 1351-1
Lorsque l'impossibilité d'exécuter résulte de la perte de la chose due, le débiteur mis en demeure est néanmoins libéré s'il prouve que la perte se serait pareillement produite si l'obligation avait été exécutée.
Il est cependant tenu de céder à son créancier les droits et actions attachés à la chose.
""";
    content_hash "sha256:8d5972bd2e9cf9c85e42c993e34007aba7db23b22a825d1eca22a6f076805675";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352")
pub fragment CC_ART1352 in CC_COURANT {
    label fr official "Article 1352";
    kind article;
    locator "article/1352";
    text fr official """Article 1352
La restitution d'une chose autre que d'une somme d'argent a lieu en nature ou, lorsque cela est impossible, en valeur, estimée au jour de la restitution.
""";
    content_hash "sha256:6e9d2bfc43752c343844c0f3a9f5c6b5f0d2d90ffe2b2442c1a88d17abd221e9";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_1")
pub fragment CC_ART1352_1 in CC_COURANT {
    label fr official "Article 1352-1";
    kind article;
    locator "article/1352-1";
    text fr official """Article 1352-1
Celui qui restitue la chose répond des dégradations et détériorations qui en ont diminué la valeur, à moins qu'il ne soit de bonne foi et que celles-ci ne soient pas dues à sa faute.
""";
    content_hash "sha256:1f8e2f8312d18e546158daad2520bfa7300dbd2648c24d8cc62fa3b9355dbfce";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_2")
pub fragment CC_ART1352_2 in CC_COURANT {
    label fr official "Article 1352-2";
    kind article;
    locator "article/1352-2";
    text fr official """Article 1352-2
Celui qui l'ayant reçue de bonne foi a vendu la chose ne doit restituer que le prix de la vente.
S'il l'a reçue de mauvaise foi, il en doit la valeur au jour de la restitution lorsqu'elle est supérieure au prix.
""";
    content_hash "sha256:18a548b9f510c29f66a2200c441e7970e1cc3c537eb3e76af7cb759148f330af";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_3")
pub fragment CC_ART1352_3 in CC_COURANT {
    label fr official "Article 1352-3";
    kind article;
    locator "article/1352-3";
    text fr official """Article 1352-3
La restitution inclut les fruits et la valeur de la jouissance que la chose a procurée.
La valeur de la jouissance est évaluée par le juge au jour où il se prononce.
Sauf stipulation contraire, la restitution des fruits, s'ils ne se retrouvent pas en nature, a lieu selon une valeur estimée à la date du remboursement, suivant l'état de la chose au jour du paiement de l'obligation.
""";
    content_hash "sha256:667d4b87724e040ca0500749ca747086e6fcfff839fb300004531f49720d7ec6";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_4")
pub fragment CC_ART1352_4 in CC_COURANT {
    label fr official "Article 1352-4";
    kind article;
    locator "article/1352-4";
    text fr official """Article 1352-4
Les restitutions dues par un mineur non émancipé ou par un majeur protégé sont réduites à hauteur du profit qu'il a retiré de l'acte annulé.
""";
    content_hash "sha256:37507abb51832c3273e05df120777a0caac91aea069723981e1f9f2d70852377";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_5")
pub fragment CC_ART1352_5 in CC_COURANT {
    label fr official "Article 1352-5";
    kind article;
    locator "article/1352-5";
    text fr official """Article 1352-5
Pour fixer le montant des restitutions, il est tenu compte à celui qui doit restituer des dépenses nécessaires à la conservation de la chose et de celles qui en ont augmenté la valeur, dans la limite de la plus-value estimée au jour de la restitution.
""";
    content_hash "sha256:aea494c5110aa8693ec9766019e85ce32a9a649454ab6fdfa4006ac41c87db7f";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_6")
pub fragment CC_ART1352_6 in CC_COURANT {
    label fr official "Article 1352-6";
    kind article;
    locator "article/1352-6";
    text fr official """Article 1352-6
La restitution d'une somme d'argent inclut les intérêts au taux légal et les taxes acquittées entre les mains de celui qui l'a reçue.
""";
    content_hash "sha256:1a139c969a5063098ece637689a0447d3db53e1db96140704c9f5ce7fb3e779b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_7")
pub fragment CC_ART1352_7 in CC_COURANT {
    label fr official "Article 1352-7";
    kind article;
    locator "article/1352-7";
    text fr official """Article 1352-7
Celui qui a reçu de mauvaise foi doit les intérêts, les fruits qu'il a perçus ou la valeur de la jouissance à compter du paiement. Celui qui a reçu de bonne foi ne les doit qu'à compter du jour de la demande.
""";
    content_hash "sha256:051d2eefe345504137d46f7dc84b18fd918211b7045c88a966eb7a7c7b8e1d5c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_8")
pub fragment CC_ART1352_8 in CC_COURANT {
    label fr official "Article 1352-8";
    kind article;
    locator "article/1352-8";
    text fr official """Article 1352-8
La restitution d'une prestation de service a lieu en valeur. Celle-ci est appréciée à la date à laquelle elle a été fournie.
""";
    content_hash "sha256:362cadd0e7d92ea285642bc45b1df965d743fa4e0cdf27b8106217a66c6b99b6";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1352_9")
pub fragment CC_ART1352_9 in CC_COURANT {
    label fr official "Article 1352-9";
    kind article;
    locator "article/1352-9";
    text fr official """Article 1352-9
Les sûretés constituées pour le paiement de l'obligation sont reportées de plein droit sur l'obligation de restituer sans toutefois que la caution soit privée du bénéfice du terme.
""";
    content_hash "sha256:b4e88870e5b81f329c15aa843470ccfe946241c7e95eea8f18a02aa9f3743daf";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1353")
pub fragment CC_ART1353 in CC_COURANT {
    label fr official "Article 1353";
    kind article;
    locator "article/1353";
    text fr official """Article 1353
Celui qui réclame l'exécution d'une obligation doit la prouver.
Réciproquement, celui qui se prétend libéré doit justifier le paiement ou le fait qui a produit l'extinction de son obligation.
""";
    content_hash "sha256:a4167d935b1221231c59ce73a66fe063663d932678b8c89a5150def94fc865bd";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1354")
pub fragment CC_ART1354 in CC_COURANT {
    label fr official "Article 1354";
    kind article;
    locator "article/1354";
    text fr official """Article 1354
La présomption que la loi attache à certains actes ou à certains faits en les tenant pour certains dispense celui au profit duquel elle existe d'en rapporter la preuve.
Elle est dite simple, lorsque la loi réserve la preuve contraire, et peut alors être renversée par tout moyen de preuve ; elle est dite mixte, lorsque la loi limite les moyens par lesquels elle peut être renversée ou l'objet sur lequel elle peut être renversée ; elle est dite irréfragable lorsqu'elle ne peut être renversée.
""";
    content_hash "sha256:cef592345b3b1e516a43886102e660f8860c6000889cecb459812fb06b79a1a0";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1355")
pub fragment CC_ART1355 in CC_COURANT {
    label fr official "Article 1355";
    kind article;
    locator "article/1355";
    text fr official """Article 1355
L'autorité de la chose jugée n'a lieu qu'à l'égard de ce qui a fait l'objet du jugement. Il faut que la chose demandée soit la même ; que la demande soit fondée sur la même cause ; que la demande soit entre les mêmes parties, et formée par elles et contre elles en la même qualité.
""";
    content_hash "sha256:4b934a1c8a0cf0695ac757a017de51a3f6c1189ee146f20579e160b55d4b6b5b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1356")
pub fragment CC_ART1356 in CC_COURANT {
    label fr official "Article 1356";
    kind article;
    locator "article/1356";
    text fr official """Article 1356
Les contrats sur la preuve sont valables lorsqu'ils portent sur des droits dont les parties ont la libre disposition.
Néanmoins, ils ne peuvent contredire les présomptions irréfragables établies par la loi, ni modifier la foi attachée à l'aveu ou au serment. Ils ne peuvent davantage établir au profit de l'une des parties une présomption irréfragable.
""";
    content_hash "sha256:00875aed3c82037025882c278be41b313e8ad158ffc98ed299642b2a2ac6d66c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1357")
pub fragment CC_ART1357 in CC_COURANT {
    label fr official "Article 1357";
    kind article;
    locator "article/1357";
    text fr official """Article 1357
L'administration judiciaire de la preuve et les contestations qui s'y rapportent sont régies par le code de procédure civile.
""";
    content_hash "sha256:a0ead34655b61e9779c9f51a143b042dbb2b928a6aac172ce437795f2021c090";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1358")
pub fragment CC_ART1358 in CC_COURANT {
    label fr official "Article 1358";
    kind article;
    locator "article/1358";
    text fr official """Article 1358
Hors les cas où la loi en dispose autrement, la preuve peut être apportée par tout moyen.
""";
    content_hash "sha256:26c099bdf56b294e5fa60d49629cbc5aa6bf9eba1d7081491a0693036089a26a";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1359")
pub fragment CC_ART1359 in CC_COURANT {
    label fr official "Article 1359";
    kind article;
    locator "article/1359";
    text fr official """Article 1359
L'acte juridique portant sur une somme ou une valeur excédant un montant fixé par décret doit être prouvé par écrit sous signature privée ou authentique.
Il ne peut être prouvé outre ou contre un écrit établissant un acte juridique, même si la somme ou la valeur n'excède pas ce montant, que par un autre écrit sous signature privée ou authentique.
Celui dont la créance excède le seuil mentionné au premier alinéa ne peut pas être dispensé de la preuve par écrit en restreignant sa demande.
Il en est de même de celui dont la demande, même inférieure à ce montant, porte sur le solde ou sur une partie d'une créance supérieure à ce montant.
""";
    content_hash "sha256:d4a71840faa940db7280c4cba44351def2fa7a14672ad788caaab208e843a3bd";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1360")
pub fragment CC_ART1360 in CC_COURANT {
    label fr official "Article 1360";
    kind article;
    locator "article/1360";
    text fr official """Article 1360
Les règles prévues à l'article précédent reçoivent exception en cas d'impossibilité matérielle ou morale de se procurer un écrit, s'il est d'usage de ne pas établir un écrit, ou lorsque l'écrit a été perdu par force majeure.
""";
    content_hash "sha256:164a4874e02a4fb89b7ab84a48e6cba610e9bf74dc0366d36df4ef93599e0f78";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1361")
pub fragment CC_ART1361 in CC_COURANT {
    label fr official "Article 1361";
    kind article;
    locator "article/1361";
    text fr official """Article 1361
Il peut être suppléé à l'écrit par l'aveu judiciaire, le serment décisoire ou un commencement de preuve par écrit corroboré par un autre moyen de preuve.
""";
    content_hash "sha256:6259d899f49cc41c834d58afae15307e5cd218b13eb9a361174b5c4d6fc33150";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1362")
pub fragment CC_ART1362 in CC_COURANT {
    label fr official "Article 1362";
    kind article;
    locator "article/1362";
    text fr official """Article 1362
Constitue un commencement de preuve par écrit tout écrit qui, émanant de celui qui conteste un acte ou de celui qu'il représente, rend vraisemblable ce qui est allégué.
Peuvent être considérés par le juge comme équivalant à un commencement de preuve par écrit les déclarations faites par une partie lors de sa comparution personnelle, son refus de répondre ou son absence à la comparution.
La mention d'un écrit authentique ou sous signature privée sur un registre public vaut commencement de preuve par écrit.
""";
    content_hash "sha256:01943ef99fab7c726ce177ab5e14ee82200b5143931a0e308775773606b3e62a";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1363")
pub fragment CC_ART1363 in CC_COURANT {
    label fr official "Article 1363";
    kind article;
    locator "article/1363";
    text fr official """Article 1363
Nul ne peut se constituer de titre à soi-même.
""";
    content_hash "sha256:9b6ab47fe395dbbffcabb66a758d3f91161b336e6d29889046c2d07492b230bb";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1364")
pub fragment CC_ART1364 in CC_COURANT {
    label fr official "Article 1364";
    kind article;
    locator "article/1364";
    text fr official """Article 1364
La preuve d'un acte juridique peut être préconstituée par un écrit en la forme authentique ou sous signature privée.
""";
    content_hash "sha256:a9e215b9434e4ac1c7074ca18e29e2362f0d582ac360ab24a7725a31502f2d9d";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1365")
pub fragment CC_ART1365 in CC_COURANT {
    label fr official "Article 1365";
    kind article;
    locator "article/1365";
    text fr official """Article 1365
L'écrit consiste en une suite de lettres, de caractères, de chiffres ou de tous autres signes ou symboles dotés d'une signification intelligible, quel que soit leur support.
""";
    content_hash "sha256:94140cc89516776a0b562ac05062e40e9e65a01007174799eb8b4134a036b3d0";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1366")
pub fragment CC_ART1366 in CC_COURANT {
    label fr official "Article 1366";
    kind article;
    locator "article/1366";
    text fr official """Article 1366
L'écrit électronique a la même force probante que l'écrit sur support papier, sous réserve que puisse être dûment identifiée la personne dont il émane et qu'il soit établi et conservé dans des conditions de nature à en garantir l'intégrité.
""";
    content_hash "sha256:910bbda7042361a08564ca9dcdf02e8067cbf0f9d5a84b31882552198f438218";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1367")
pub fragment CC_ART1367 in CC_COURANT {
    label fr official "Article 1367";
    kind article;
    locator "article/1367";
    text fr official """Article 1367
La signature nécessaire à la perfection d'un acte juridique identifie son auteur. Elle manifeste son consentement aux obligations qui découlent de cet acte. Quand elle est apposée par un officier public, elle confère l'authenticité à l'acte.
Lorsqu'elle est électronique, elle consiste en l'usage d'un procédé fiable d'identification garantissant son lien avec l'acte auquel elle s'attache. La fiabilité de ce procédé est présumée, jusqu'à preuve contraire, lorsque la signature électronique est créée, l'identité du signataire assurée et l'intégrité de l'acte garantie, dans des conditions fixées par décret en Conseil d'Etat.
""";
    content_hash "sha256:10da243d4309c91ffee18681eeb3a67a1c9df681082c7eddf74e02f6f496d207";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1368")
pub fragment CC_ART1368 in CC_COURANT {
    label fr official "Article 1368";
    kind article;
    locator "article/1368";
    text fr official """Article 1368
A défaut de dispositions ou de conventions contraires, le juge règle les conflits de preuve par écrit en déterminant par tout moyen le titre le plus vraisemblable.
""";
    content_hash "sha256:dcc50a0c5d2fedf4295cb68b68eeea6d0c28288f12ddf4679689faaefa09a1bf";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1369")
pub fragment CC_ART1369 in CC_COURANT {
    label fr official "Article 1369";
    kind article;
    locator "article/1369";
    text fr official """Article 1369
L'acte authentique est celui qui a été reçu, avec les solennités requises, par un officier public ayant compétence et qualité pour instrumenter.
Il peut être dressé sur support électronique s'il est établi et conservé dans des conditions fixées par décret en Conseil d'État.
Lorsqu'il est reçu par un notaire, il est dispensé de toute mention manuscrite exigée par la loi.
""";
    content_hash "sha256:aa3862dbc59ac81b80cd5e0977de0608fc5d129618fa1df1e481078b2142bc54";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1370")
pub fragment CC_ART1370 in CC_COURANT {
    label fr official "Article 1370";
    kind article;
    locator "article/1370";
    text fr official """Article 1370
L'acte qui n'est pas authentique du fait de l'incompétence ou de l'incapacité de l'officier, ou par un défaut de forme, vaut comme écrit sous signature privée, s'il a été signé des parties.
""";
    content_hash "sha256:5e154aba0db1fa140021717c09cbed2fd26a279234b328edc9de13affae978d4";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1371")
pub fragment CC_ART1371 in CC_COURANT {
    label fr official "Article 1371";
    kind article;
    locator "article/1371";
    text fr official """Article 1371
L'acte authentique fait foi jusqu'à inscription de faux de ce que l'officier public dit avoir personnellement accompli ou constaté.
En cas d'inscription de faux, le juge peut suspendre l'exécution de l'acte.
""";
    content_hash "sha256:b09918feb576f746ff118527d1904c4ba3700d36cb0afd4eb09e5ee871bd7711";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1372")
pub fragment CC_ART1372 in CC_COURANT {
    label fr official "Article 1372";
    kind article;
    locator "article/1372";
    text fr official """Article 1372
L'acte sous signature privée, reconnu par la partie à laquelle on l'oppose ou légalement tenu pour reconnu à son égard, fait foi entre ceux qui l'ont souscrit et à l'égard de leurs héritiers et ayants cause.
""";
    content_hash "sha256:18c00a465fdf387620bef5e2e1f0034b7c3ae00464317b449ab0024f472b891a";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1373")
pub fragment CC_ART1373 in CC_COURANT {
    label fr official "Article 1373";
    kind article;
    locator "article/1373";
    text fr official """Article 1373
La partie à laquelle on l'oppose peut désavouer son écriture ou sa signature. Les héritiers ou ayants cause d'une partie peuvent pareillement désavouer l'écriture ou la signature de leur auteur, ou déclarer qu'ils ne les connaissent. Dans ces cas, il y a lieu à vérification d'écriture.
""";
    content_hash "sha256:c6b66fe54c0b67cc3bc38b8d816e687b93d26a11dfd297426bc3806a5ba70183";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1374")
pub fragment CC_ART1374 in CC_COURANT {
    label fr official "Article 1374";
    kind article;
    locator "article/1374";
    text fr official """Article 1374
L'acte sous signature privée contresigné par les avocats de chacune des parties ou par l'avocat de toutes les parties fait foi de l'écriture et de la signature des parties, tant à leur égard qu'à celui de leurs héritiers ou ayants cause.
La procédure de faux prévue par le code de procédure civile lui est applicable.
Cet acte est dispensé de toute mention manuscrite exigée par la loi.
""";
    content_hash "sha256:20260c20a5927253c39e8a26c1738365ab152b2089c85f785387cefcbdb6b9e5";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1375")
pub fragment CC_ART1375 in CC_COURANT {
    label fr official "Article 1375";
    kind article;
    locator "article/1375";
    text fr official """Article 1375
L'acte sous signature privée qui constate un contrat synallagmatique ne fait preuve que s'il a été fait en autant d'originaux qu'il y a de parties ayant un intérêt distinct, à moins que les parties ne soient convenues de remettre à un tiers l'unique exemplaire dressé.
Chaque original doit mentionner le nombre des originaux qui en ont été faits.
Celui qui a exécuté le contrat, même partiellement, ne peut opposer le défaut de la pluralité d'originaux ou de la mention de leur nombre.
L'exigence d'une pluralité d'originaux est réputée satisfaite pour les contrats sous forme électronique lorsque l'acte est établi et conservé conformément aux articles 1366 et 1367, et que le procédé permet à chaque partie de disposer d'un exemplaire sur support durable ou d'y avoir accès.
""";
    content_hash "sha256:f6e40830edd0eab2d0cb02258a86e2e569d899e6a56c3dd8e2fbf04a7f7d80be";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1376")
pub fragment CC_ART1376 in CC_COURANT {
    label fr official "Article 1376";
    kind article;
    locator "article/1376";
    text fr official """Article 1376
L'acte sous signature privée par lequel une seule partie s'engage envers une autre à lui payer une somme d'argent ou à lui livrer un bien fongible ne fait preuve que s'il comporte la signature de celui qui souscrit cet engagement ainsi que la mention, écrite par lui-même, de la somme ou de la quantité en toutes lettres et en chiffres. En cas de différence, l'acte sous signature privée vaut preuve pour la somme écrite en toutes lettres.
""";
    content_hash "sha256:69386ef1063430218c3ca4c817ab5f926f891071a3e245a56f3f80dbff346c5a";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1377")
pub fragment CC_ART1377 in CC_COURANT {
    label fr official "Article 1377";
    kind article;
    locator "article/1377";
    text fr official """Article 1377
L'acte sous signature privée n'acquiert date certaine à l'égard des tiers que du jour où il a été enregistré, du jour de la mort d'un signataire, ou du jour où sa substance est constatée dans un acte authentique.
""";
    content_hash "sha256:a7ea0e728cf9ea92facd611378123feb8695086e6e958dcbea7fde25e08478e5";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1378")
pub fragment CC_ART1378 in CC_COURANT {
    label fr official "Article 1378";
    kind article;
    locator "article/1378";
    text fr official """Article 1378
Les registres et documents que les professionnels doivent tenir ou établir ont, contre leur auteur, la même force probante que les écrits sous signature privée ; mais celui qui s'en prévaut ne peut en diviser les mentions pour n'en retenir que celles qui lui sont favorables.
""";
    content_hash "sha256:f739c5fc034e03cebedbbf7d3ba2f4f8b55899228c65d4b473bd6f7c36c0450b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1378_1")
pub fragment CC_ART1378_1 in CC_COURANT {
    label fr official "Article 1378-1";
    kind article;
    locator "article/1378-1";
    text fr official """Article 1378-1
Les registres et papiers domestiques ne font pas preuve au profit de celui qui les a écrits.
Ils font preuve contre lui :
1° Dans tous les cas où ils énoncent formellement un paiement reçu ;
2° Lorsqu'ils contiennent la mention expresse que l'écrit a été fait pour suppléer le défaut du titre en faveur de qui ils énoncent une obligation.
""";
    content_hash "sha256:f341faecde4172e458cbec906c887d5cbc4011de0402fa39e6deac2e9c069bef";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1378_2")
pub fragment CC_ART1378_2 in CC_COURANT {
    label fr official "Article 1378-2";
    kind article;
    locator "article/1378-2";
    text fr official """Article 1378-2
La mention d'un paiement ou d'une autre cause de libération portée par le créancier sur un titre original qui est toujours resté en sa possession vaut présomption simple de libération du débiteur.
Il en est de même de la mention portée sur le double d'un titre ou d'une quittance, pourvu que ce double soit entre les mains du débiteur.
""";
    content_hash "sha256:08cbaa5c1c3fb06a205ee74b9dc243ef6034af204aff457ac28af0a643f06bd2";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1379")
pub fragment CC_ART1379 in CC_COURANT {
    label fr official "Article 1379";
    kind article;
    locator "article/1379";
    text fr official """Article 1379
La copie fiable a la même force probante que l'original. La fiabilité est laissée à l'appréciation du juge. Néanmoins est réputée fiable la copie exécutoire ou authentique d'un écrit authentique.
Est présumée fiable jusqu'à preuve du contraire toute copie résultant d'une reproduction à l'identique de la forme et du contenu de l'acte, et dont l'intégrité est garantie dans le temps par un procédé conforme à des conditions fixées par décret en Conseil d'État.
Si l'original subsiste, sa présentation peut toujours être exigée.
""";
    content_hash "sha256:4a8c97d72183b3ccd13cf4614120022b70089e21917b898a4f6edaa8187cf14b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1380")
pub fragment CC_ART1380 in CC_COURANT {
    label fr official "Article 1380";
    kind article;
    locator "article/1380";
    text fr official """Article 1380
L'acte récognitif ne dispense pas de la présentation du titre original sauf si sa teneur y est spécialement relatée.
Ce qu'il contient de plus ou de différent par rapport au titre original n'a pas d'effet.
""";
    content_hash "sha256:4bcf50f027ab1e5fac49e030289be6a367ea7f45e2175acd41c1aebcb1a0f4fc";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1381")
pub fragment CC_ART1381 in CC_COURANT {
    label fr official "Article 1381";
    kind article;
    locator "article/1381";
    text fr official """Article 1381
La valeur probante des déclarations faites par un tiers dans les conditions du code de procédure civile est laissée à l'appréciation du juge.
""";
    content_hash "sha256:96ee2a5d99ffcb4f7952cd6d011d5964b0749e506c75caf3aa7c9fb20a6dadff";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1382")
pub fragment CC_ART1382 in CC_COURANT {
    label fr official "Article 1382";
    kind article;
    locator "article/1382";
    text fr official """Article 1382
Les présomptions qui ne sont pas établies par la loi, sont laissées à l'appréciation du juge, qui ne doit les admettre que si elles sont graves, précises et concordantes, et dans les cas seulement où la loi admet la preuve par tout moyen.
""";
    content_hash "sha256:2e88e02b3152461986f02b3bfe77e644508195201a7c98db72ef72bd5a97e48c";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1383")
pub fragment CC_ART1383 in CC_COURANT {
    label fr official "Article 1383";
    kind article;
    locator "article/1383";
    text fr official """Article 1383
L'aveu est la déclaration par laquelle une personne reconnaît pour vrai un fait de nature à produire contre elle des conséquences juridiques.
Il peut être judiciaire ou extrajudiciaire.
""";
    content_hash "sha256:ac789a07e199aae2d558079ba3b59bc0803f56e1ea2211be96becb98368e5549";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1383_1")
pub fragment CC_ART1383_1 in CC_COURANT {
    label fr official "Article 1383-1";
    kind article;
    locator "article/1383-1";
    text fr official """Article 1383-1
L'aveu extrajudiciaire purement verbal n'est reçu que dans les cas où la loi permet la preuve par tout moyen.
Sa valeur probante est laissée à l'appréciation du juge.
""";
    content_hash "sha256:f324e1db9a39b9bc5597ecc998d407e1f956b869b0b8716350d189b1cb0e6391";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1383_2")
pub fragment CC_ART1383_2 in CC_COURANT {
    label fr official "Article 1383-2";
    kind article;
    locator "article/1383-2";
    text fr official """Article 1383-2
L'aveu judiciaire est la déclaration que fait en justice la partie ou son représentant spécialement mandaté.
Il fait foi contre celui qui l'a fait.
Il ne peut être divisé contre son auteur.
Il est irrévocable, sauf en cas d'erreur de fait.
""";
    content_hash "sha256:34fdbf095d1be879da6bf166644be6e2e7e6875333920f5ddcc0373f29c724e4";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1384")
pub fragment CC_ART1384 in CC_COURANT {
    label fr official "Article 1384";
    kind article;
    locator "article/1384";
    text fr official """Article 1384
Le serment peut être déféré, à titre décisoire, par une partie à l'autre pour en faire dépendre le jugement de la cause. Il peut aussi être déféré d'office par le juge à l'une des parties.
""";
    content_hash "sha256:6849c91274b529b3f86ebf40225d20a3fe43c98fb8243f9b541a788547f280ce";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1385")
pub fragment CC_ART1385 in CC_COURANT {
    label fr official "Article 1385";
    kind article;
    locator "article/1385";
    text fr official """Article 1385
Le serment décisoire peut être déféré sur quelque espèce de contestation que ce soit et en tout état de cause.
""";
    content_hash "sha256:64895343351a8395db923d2110433aaa3ccb31656ef815e2c9bda73dc7e7f12b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1385_1")
pub fragment CC_ART1385_1 in CC_COURANT {
    label fr official "Article 1385-1";
    kind article;
    locator "article/1385-1";
    text fr official """Article 1385-1
Il ne peut être déféré que sur un fait personnel à la partie à laquelle on le défère.
Il peut être référé par celle-ci, à moins que le fait qui en est l'objet ne lui soit purement personnel.
""";
    content_hash "sha256:5db6867869c94078e504f5cf225532e7faad5d2dbdf1ebd352036829c8f6a736";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1385_2")
pub fragment CC_ART1385_2 in CC_COURANT {
    label fr official "Article 1385-2";
    kind article;
    locator "article/1385-2";
    text fr official """Article 1385-2
Celui à qui le serment est déféré et qui le refuse ou ne veut pas le référer, ou celui à qui il a été référé et qui le refuse, succombe dans sa prétention.
""";
    content_hash "sha256:1c633821f5cc5cfce395e315eb0ccba574f101a51f8309f3e6c07ebcb09af154";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1385_3")
pub fragment CC_ART1385_3 in CC_COURANT {
    label fr official "Article 1385-3";
    kind article;
    locator "article/1385-3";
    text fr official """Article 1385-3
La partie qui a déféré ou référé le serment ne peut plus se rétracter lorsque l'autre partie a déclaré qu'elle est prête à faire ce serment.
Lorsque le serment déféré ou référé a été fait, l'autre partie n'est pas admise à en prouver la fausseté.
""";
    content_hash "sha256:8287a1d14ce31b341a92273b7c2ee279cd953667d41606b200e8176c8b814a2b";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1385_4")
pub fragment CC_ART1385_4 in CC_COURANT {
    label fr official "Article 1385-4";
    kind article;
    locator "article/1385-4";
    text fr official """Article 1385-4
Le serment ne fait preuve qu'au profit de celui qui l'a déféré et de ses héritiers et ayants cause, ou contre eux.
Le serment déféré par l'un des créanciers solidaires au débiteur ne libère celui-ci que pour la part de ce créancier.
Le serment déféré au débiteur principal libère également les cautions.
Celui déféré à l'un des débiteurs solidaires profite aux codébiteurs.
Celui déféré à la caution profite au débiteur principal.
Dans ces deux derniers cas, le serment du codébiteur solidaire ou de la caution ne profite aux autres codébiteurs ou au débiteur principal que lorsqu'il a été déféré sur la dette, et non sur le fait de la solidarité ou du cautionnement.
""";
    content_hash "sha256:5501d8399e189bcf37fd2b57538d60adcbe2abf4058fea9e65a34f33a3d0a50e";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1386")
pub fragment CC_ART1386 in CC_COURANT {
    label fr official "Article 1386";
    kind article;
    locator "article/1386";
    text fr official """Article 1386
Le juge peut d'office déférer le serment à l'une des parties.
Ce serment ne peut être référé à l'autre partie.
Sa valeur probante est laissée à l'appréciation du juge.
""";
    content_hash "sha256:24e6ca4258af378635eb130073748ef092d0ea3b7d35bc4bae019270a82718d1";
}

@id("urn:fr:corpus:clir:code-civil-obligations#CC_ART1386_1")
pub fragment CC_ART1386_1 in CC_COURANT {
    label fr official "Article 1386-1";
    kind article;
    locator "article/1386-1";
    text fr official """Article 1386-1
Le juge ne peut déférer d'office le serment, soit sur la demande, soit sur l'exception qui y est opposée, que si elle n'est pas pleinement justifiée ou totalement dénuée de preuves.
""";
    content_hash "sha256:69233c4ac30e52755c159b30768b6391c703d73cb170bb08855bf630abffe5fd";
}

// END GENERATED FRAGMENTS
