language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1352-3, al. 1 et 2 : la restitution inclut les fruits ET la valeur de la
// jouissance, cette dernière évaluée PAR LE JUGE au jour où il se prononce.
// Calcul à la main : 1 500 EUR de fruits + 2 400 EUR de jouissance = 3 900 EUR.
test "urn:query:fr-code-civil-obligations-r05-fruits-et-valeur-de-la-jouissance" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obligations:rfj:r"), entity_ref("urn:fr:cc:obligations:rfj:D"), entity_ref("urn:fr:cc:obligations:rfj:CR")) { origin case_input; }
        assert "f2": fruits_percus(entity_ref("urn:fr:cc:obligations:rfj:r"), 1500 EUR) { origin case_input; }
        assert "f3": valeur_de_la_jouissance(entity_ref("urn:fr:cc:obligations:rfj:r"), 2400 EUR) { origin adjudicated; }
    }
    evaluate truth(restitution_incluant_les_fruits_et_la_jouissance(entity_ref("urn:fr:cc:obligations:rfj:r"), 3900 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RestitutionIncluantFruitsEtJouissance);
}
