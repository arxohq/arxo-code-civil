language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1304-6, al. 3 : en cas de défaillance de la condition suspensive, l'obligation
// est réputée N'AVOIR JAMAIS EXISTÉ.
test "urn:query:fr-code-civil-obligations-m04-defaillance-de-la-condition-suspensive" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": condition_de_l_obligation(entity_ref("urn:fr:cc:obligations:def:c"), entity_ref("urn:fr:cc:obligations:def:k")) { origin case_input; }
        assert "f2": espece_de_la_condition(entity_ref("urn:fr:cc:obligations:def:k"), Suspensive) { origin case_input; }
        assert "f3": condition_defaillie(entity_ref("urn:fr:cc:obligations:def:k")) { origin case_input; }
    }
    evaluate truth(obligation_reputee_n_avoir_jamais_existe(entity_ref("urn:fr:cc:obligations:def:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ObligationReputeeNAvoirJamaisExiste);
}
