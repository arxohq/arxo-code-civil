language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1326, al. 2 : le cédant ne répond de la solvabilité du débiteur que lorsqu'il
// s'y est engagé, et JUSQU'À CONCURRENCE DU PRIX qu'il a retiré de la cession :
// ici 12 000 EUR, quel que soit le montant de la créance cédée.
test "urn:query:fr-code-civil-obligations-o06-garantie-de-solvabilite-plafonnee-au-prix" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": cession_de_creance(entity_ref("urn:fr:cc:obligations:ces:x"), entity_ref("urn:fr:cc:obligations:ces:c")) { origin case_input; }
        assert "f2": cedant(entity_ref("urn:fr:cc:obligations:ces:x"), entity_ref("urn:fr:cc:obligations:ces:CED")) { origin case_input; }
        assert "f3": cessionnaire(entity_ref("urn:fr:cc:obligations:ces:x"), entity_ref("urn:fr:cc:obligations:ces:CESS")) { origin case_input; }
        assert "f4": date_de_l_acte_de_cession(entity_ref("urn:fr:cc:obligations:ces:x"), @2025-04-15) { origin case_input; }
        assert "f5": cession_constatee_par_ecrit(entity_ref("urn:fr:cc:obligations:ces:x")) { origin case_input; }
        assert "f6": cession_a_titre_onereux(entity_ref("urn:fr:cc:obligations:ces:x")) { origin case_input; }
        assert "f7": garantie_de_solvabilite_stipulee(entity_ref("urn:fr:cc:obligations:ces:x")) { origin case_input; }
        assert "f8": prix_retire_de_la_cession(entity_ref("urn:fr:cc:obligations:ces:x"), 12000 EUR) { origin case_input; }
    }
    evaluate truth(garantie_de_solvabilite_plafonnee(entity_ref("urn:fr:cc:obligations:ces:x"), 12000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(GarantieDeSolvabilitePlafonnee);
}
