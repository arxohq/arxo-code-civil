language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1352-2, al. 2 : s'il l'a reçue DE MAUVAISE FOI, il en doit la valeur au jour de
// la restitution LORSQU'ELLE EST SUPÉRIEURE AU PRIX.
// Calcul à la main : max(prix 6 000 EUR, valeur 9 000 EUR) = 9 000 EUR.
test "urn:query:fr-code-civil-obligations-r08-vendeur-de-mauvaise-foi-doit-la-valeur-superieure" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obligations:rvm:r"), entity_ref("urn:fr:cc:obligations:rvm:D"), entity_ref("urn:fr:cc:obligations:rvm:CR")) { origin case_input; }
        assert "f2": chose_vendue_par_celui_qui_l_a_recue(entity_ref("urn:fr:cc:obligations:rvm:r"), 6000 EUR) { origin case_input; }
        assert "f3": valeur_au_jour_de_la_restitution(entity_ref("urn:fr:cc:obligations:rvm:r"), 9000 EUR) { origin case_input; }
        assert "f4": recu_de_mauvaise_foi(entity_ref("urn:fr:cc:obligations:rvm:r")) { origin adjudicated; }
    }
    evaluate truth(restitution_de_la_valeur_superieure_au_prix(entity_ref("urn:fr:cc:obligations:rvm:r"), 9000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RestitutionDeLaValeurSiSuperieureAuPrix);
}
