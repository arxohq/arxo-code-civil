language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1351, in fine : le débiteur PRÉALABLEMENT MIS EN DEMEURE n'est pas libéré,
// quand bien même l'impossibilité procède d'un cas de force majeure définitif.
test "urn:query:fr-code-civil-obligations-c12-impossibilite-apres-mise-en-demeure" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": force_majeure_definitive(entity_ref("urn:fr:cc:obligations:imd:c")) { origin adjudicated; }
        assert "f2": mise_en_demeure_du_debiteur(entity_ref("urn:fr:cc:obligations:imd:md"), entity_ref("urn:fr:cc:obligations:imd:c"), entity_ref("urn:fr:cc:obligations:imd:D")) { origin case_input; }
        assert "f3": mode_de_la_mise_en_demeure(entity_ref("urn:fr:cc:obligations:imd:md"), Sommation) { origin case_input; }
        assert "f4": date_de_la_mise_en_demeure(entity_ref("urn:fr:cc:obligations:imd:md"), @2025-02-03) { origin case_input; }
    }
    evaluate truth(debiteur_non_libere_malgre_la_force_majeure(entity_ref("urn:fr:cc:obligations:imd:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(MiseEnDemeurePrealable);
    expect applied(DebiteurNonLibereMisEnDemeure);
}
