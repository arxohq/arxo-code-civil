language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1352-4 : les restitutions dues par un mineur non émancipé ou par un majeur
// protégé sont RÉDUITES À HAUTEUR DU PROFIT qu'il a retiré de l'acte annulé.
test "urn:query:fr-code-civil-obligations-r09-restitution-reduite-au-profit-du-mineur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obligations:rmi:r"), entity_ref("urn:fr:cc:obligations:rmi:D"), entity_ref("urn:fr:cc:obligations:rmi:CR")) { origin case_input; }
        assert "f2": restitution_due_par_un_mineur_ou_un_majeur_protege(entity_ref("urn:fr:cc:obligations:rmi:r")) { origin case_input; }
        assert "f3": profit_retire_de_l_acte_annule(entity_ref("urn:fr:cc:obligations:rmi:r"), 450 EUR) { origin case_input; }
    }
    evaluate truth(restitution_reduite_au_profit(entity_ref("urn:fr:cc:obligations:rmi:r"), 450 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RestitutionReduiteAuProfitDuMineurOuDuMajeurProtege);
}
