language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1354, al. 1 et 2 : la présomption SIMPLE dispense de la preuve celui au profit
// duquel elle existe, tant que la preuve contraire n'est pas rapportée. L'espèce de la
// présomption vient de la LOI QUI L'ÉTABLIT, jamais d'une supposition : le cas la donne.
test "urn:query:fr-code-civil-obligations-e03-presomption-simple-dispense-de-preuve" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": presomption_legale_attachee(entity_ref("urn:fr:cc:obligations:psi:pr"), entity_ref("urn:fr:cc:obligations:psi:a")) { origin case_input; }
        assert "f2": espece_de_la_presomption(entity_ref("urn:fr:cc:obligations:psi:pr"), Simple) { origin case_input; }
        assert "f3": beneficiaire_de_la_presomption(entity_ref("urn:fr:cc:obligations:psi:pr"), entity_ref("urn:fr:cc:obligations:psi:P")) { origin case_input; }
    }
    evaluate truth(dispense_de_preuve(entity_ref("urn:fr:cc:obligations:psi:pr"), entity_ref("urn:fr:cc:obligations:psi:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DispenseDePreuveParPresomptionSimple);
}
