language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1330 : la novation NE SE PRÉSUME PAS ; la volonté de l'opérer doit résulter
// clairement de l'acte. Les deux obligations sont valables, mais la volonté manque.
test "urn:query:fr-code-civil-obligations-o09-novation-ne-se-presume-pas" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": novation_convenue(entity_ref("urn:fr:cc:obligations:nov:n"), entity_ref("urn:fr:cc:obligations:nov:anc"), entity_ref("urn:fr:cc:obligations:nov:nou")) { origin case_input; }
        assert "f2": obligation_valable(entity_ref("urn:fr:cc:obligations:nov:anc")) { origin case_input; }
        assert "f3": obligation_valable(entity_ref("urn:fr:cc:obligations:nov:nou")) { origin case_input; }
    }
    evaluate truth(novation_operee(entity_ref("urn:fr:cc:obligations:nov:n"), entity_ref("urn:fr:cc:obligations:nov:anc"), entity_ref("urn:fr:cc:obligations:nov:nou")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
    expect applied(NovationNonPresumee);
}
