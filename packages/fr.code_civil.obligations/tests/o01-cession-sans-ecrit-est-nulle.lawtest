language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1322 : la cession de créance doit être constatée par écrit, À PEINE DE NULLITÉ.
test "urn:query:fr-code-civil-obligations-o01-cession-sans-ecrit-est-nulle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": cession_de_creance(entity_ref("urn:fr:cc:obligations:nul:x"), entity_ref("urn:fr:cc:obligations:nul:c")) { origin case_input; }
        assert "f2": date_de_l_acte_de_cession(entity_ref("urn:fr:cc:obligations:nul:x"), @2025-04-15) { origin case_input; }
    }
    evaluate truth(cession_nulle_faute_d_ecrit(entity_ref("urn:fr:cc:obligations:nul:x")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CessionNulleFauteDEcrit);
}
