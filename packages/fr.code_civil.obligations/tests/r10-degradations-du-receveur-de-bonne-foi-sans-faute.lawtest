language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1352-1 : celui qui restitue répond des dégradations, À MOINS qu'il ne soit de
// bonne foi ET que celles-ci ne soient pas dues à sa faute — les deux conditions sont
// réunies ici : il n'en répond pas.
test "urn:query:fr-code-civil-obligations-r10-degradations-du-receveur-de-bonne-foi-sans-faute" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obligations:rdg:r"), entity_ref("urn:fr:cc:obligations:rdg:D"), entity_ref("urn:fr:cc:obligations:rdg:CR")) { origin case_input; }
        assert "f2": degradation_ayant_diminue_la_valeur(entity_ref("urn:fr:cc:obligations:rdg:r")) { origin case_input; }
        assert "f3": recu_de_bonne_foi(entity_ref("urn:fr:cc:obligations:rdg:r")) { origin adjudicated; }
    }
    evaluate truth(exoneration_des_degradations(entity_ref("urn:fr:cc:obligations:rdg:r")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ExonerationDesDegradations);
}
