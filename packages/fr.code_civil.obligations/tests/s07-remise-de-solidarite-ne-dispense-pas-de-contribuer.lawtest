language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1317, al. 3 : la répartition comprend « celui qui a bénéficié d'une remise de
// solidarité ». B, déchargé de la solidarité, reste solvable au sens du texte et
// supporte la même part contributive de 1/2 que s'il ne l'avait pas été.
test "urn:query:fr-code-civil-obligations-s07-remise-de-solidarite-ne-dispense-pas-de-contribuer" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": obligation_solidaire_entre_debiteurs(entity_ref("urn:fr:cc:obligations:sol:c")) { origin case_input; }
        assert "f2": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obligations:sol:c"), 9000 EUR) { origin case_input; }
        assert "f3": fr.code_civil.core::creancier(entity_ref("urn:fr:cc:obligations:sol:c"), entity_ref("urn:fr:cc:obligations:sol:CR")) { origin case_input; }
        assert "f4": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obligations:sol:c"), entity_ref("urn:fr:cc:obligations:sol:A")) { origin case_input; }
        assert "f5": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obligations:sol:c"), entity_ref("urn:fr:cc:obligations:sol:B")) { origin case_input; }
        assert "f6": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obligations:sol:c"), entity_ref("urn:fr:cc:obligations:sol:C")) { origin case_input; }
        assert "f7": codebiteur_insolvable(entity_ref("urn:fr:cc:obligations:sol:c"), entity_ref("urn:fr:cc:obligations:sol:C")) { origin case_input; }
        assert "f8": remise_de_solidarite(entity_ref("urn:fr:cc:obligations:sol:c"), entity_ref("urn:fr:cc:obligations:sol:B")) { origin case_input; }
    }
    evaluate truth(part_contributive(entity_ref("urn:fr:cc:obligations:sol:c"), entity_ref("urn:fr:cc:obligations:sol:B"), 1 / 2));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CodebiteurSolvable);
    expect applied(ContributionApresRepartitionDeLInsolvable);
}
