language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1376, frontière : sans la mention en toutes lettres, l'acte NE FAIT PAS PREUVE
// de l'engagement unilatéral.
test "urn:query:fr-code-civil-obligations-e19-engagement-unilateral-sans-mention-en-lettres" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": engagement_unilateral_de_payer_ou_de_livrer(entity_ref("urn:fr:cc:obligations:snl:e"), entity_ref("urn:fr:cc:obligations:snl:a")) { origin case_input; }
        assert "f2": signature_du_souscripteur(entity_ref("urn:fr:cc:obligations:snl:e")) { origin case_input; }
        assert "f3": mention_en_chiffres(entity_ref("urn:fr:cc:obligations:snl:e"), 2100 EUR) { origin case_input; }
    }
    evaluate truth(engagement_unilateral_prouve(entity_ref("urn:fr:cc:obligations:snl:e")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
