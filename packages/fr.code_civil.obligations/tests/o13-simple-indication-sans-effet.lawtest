language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1340 : la simple indication d'une personne désignée pour payer à la place du
// débiteur n'emporte NI NOVATION NI DÉLÉGATION.
test "urn:query:fr-code-civil-obligations-o13-simple-indication-sans-effet" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": simple_indication_d_une_personne(entity_ref("urn:fr:cc:obligations:ind:g")) { origin case_input; }
    }
    evaluate truth(ni_novation_ni_delegation(entity_ref("urn:fr:cc:obligations:ind:g")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(SimpleIndicationSansEffet);
}
