language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1354, al. 2 : le moyen admis par la loi contre la présomption mixte la renverse.
test "urn:query:fr-code-civil-obligations-e06-presomption-mixte-renversee-par-un-moyen-admis" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": presomption_legale_attachee(entity_ref("urn:fr:cc:obligations:pmr:pr"), entity_ref("urn:fr:cc:obligations:pmr:a")) { origin case_input; }
        assert "f2": espece_de_la_presomption(entity_ref("urn:fr:cc:obligations:pmr:pr"), Mixte) { origin case_input; }
        assert "f3": beneficiaire_de_la_presomption(entity_ref("urn:fr:cc:obligations:pmr:pr"), entity_ref("urn:fr:cc:obligations:pmr:P")) { origin case_input; }
        assert "f4": preuve_contraire_par_un_moyen_admis(entity_ref("urn:fr:cc:obligations:pmr:pr")) { origin case_input; }
    }
    evaluate truth(dispense_de_preuve(entity_ref("urn:fr:cc:obligations:pmr:pr"), entity_ref("urn:fr:cc:obligations:pmr:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
    expect applied(PresomptionMixteRenversee);
}
