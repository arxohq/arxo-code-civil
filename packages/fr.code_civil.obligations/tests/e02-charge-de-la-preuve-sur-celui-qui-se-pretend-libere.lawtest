language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1353, al. 2 : RÉCIPROQUEMENT, celui qui se prétend libéré doit justifier le
// paiement ou le fait qui a produit l'extinction de son obligation.
test "urn:query:fr-code-civil-obligations-e02-charge-de-la-preuve-sur-celui-qui-se-pretend-libere" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": se_pretend_libere(entity_ref("urn:fr:cc:obligations:plb:a"), entity_ref("urn:fr:cc:obligations:plb:D"), entity_ref("urn:fr:cc:obligations:plb:c")) { origin case_input; }
    }
    evaluate truth(charge_de_la_preuve(entity_ref("urn:fr:cc:obligations:plb:a"), entity_ref("urn:fr:cc:obligations:plb:D"), entity_ref("urn:fr:cc:obligations:plb:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ChargeDeLaPreuveSurCeluiQuiSePretendLibere);
}
