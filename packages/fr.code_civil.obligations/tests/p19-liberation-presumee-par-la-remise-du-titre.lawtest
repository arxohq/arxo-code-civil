language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1342-9, al. 1, lu avec 1354, al. 2 : la remise volontaire du titre vaut
// PRÉSOMPTION SIMPLE de libération — elle tient tant que la preuve contraire manque.
test "urn:query:fr-code-civil-obligations-p19-liberation-presumee-par-la-remise-du-titre" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": remise_volontaire_du_titre(entity_ref("urn:fr:cc:obl"), entity_ref("urn:fr:cc:obl:D")) { origin case_input; }
    }
    evaluate truth(liberation_presumee(entity_ref("urn:fr:cc:obl"), entity_ref("urn:fr:cc:obl:D")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(LiberationPresumeeParLaRemiseDuTitre);
}
