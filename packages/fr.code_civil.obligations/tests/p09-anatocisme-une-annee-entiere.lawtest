language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1343-2 : les intérêts échus, dus au moins pour UNE ANNÉE ENTIÈRE, produisent
// intérêt si le contrat l'a prévu. Du 1er janvier 2024 au 1er janvier 2025 : l'année
// est exactement entière (pas de délai §86 : 2024-01-01 + 1 an = 2025-01-01).
test "urn:query:fr-code-civil-obligations-p09-anatocisme-une-annee-entiere" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": interets_echus(entity_ref("/Users/rifatjumagulov/Downloads/law-dsl-fr-cc-obligations/corpus/laws/fr/code-civil-obligations/urn:fr:cc:obl"), @2024-01-01, @2025-01-01) { origin case_input; }
        assert "f2": capitalisation_prevue_au_contrat(entity_ref("/Users/rifatjumagulov/Downloads/law-dsl-fr-cc-obligations/corpus/laws/fr/code-civil-obligations/urn:fr:cc:obl")) { origin case_input; }
    }
    evaluate truth(interets_producteurs(entity_ref("/Users/rifatjumagulov/Downloads/law-dsl-fr-cc-obligations/corpus/laws/fr/code-civil-obligations/urn:fr:cc:obl")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InteretsDusPourUneAnneeEntiere);
    expect applied(AnatocismeParLeContrat);
}
