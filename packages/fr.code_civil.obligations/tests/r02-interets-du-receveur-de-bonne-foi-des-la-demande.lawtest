language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1352-7, seconde phrase : celui qui a reçu DE BONNE FOI ne les doit qu'à compter
// DU JOUR DE LA DEMANDE — le 1er juin 2025 sur les mêmes faits. La paire r01/r02 tient
// les deux points de départ que le texte distingue.
test "urn:query:fr-code-civil-obligations-r02-interets-du-receveur-de-bonne-foi-des-la-demande" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obligations:rbf:r"), entity_ref("urn:fr:cc:obligations:rbf:D"), entity_ref("urn:fr:cc:obligations:rbf:CR")) { origin case_input; }
        assert "f2": restitution_d_une_somme_d_argent(entity_ref("urn:fr:cc:obligations:rbf:r"), 20000 EUR) { origin case_input; }
        assert "f3": date_du_paiement_a_restituer(entity_ref("urn:fr:cc:obligations:rbf:r"), @2024-02-10) { origin case_input; }
        assert "f4": date_de_la_demande_en_restitution(entity_ref("urn:fr:cc:obligations:rbf:r"), @2025-06-01) { origin case_input; }
        assert "f5": recu_de_bonne_foi(entity_ref("urn:fr:cc:obligations:rbf:r")) { origin adjudicated; }
    }
    evaluate truth(interets_de_restitution_courent_depuis(entity_ref("urn:fr:cc:obligations:rbf:r"), @2025-06-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(InteretsDepuisLaDemandePourLeReceveurDeBonneFoi);
}
