language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1385-2 : celui à qui le serment est déféré et qui LE REFUSE sans vouloir le
// référer SUCCOMBE DANS SA PRÉTENTION.
test "urn:query:fr-code-civil-obligations-e22-serment-refuse-fait-succomber" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": serment_defere_par_une_partie(entity_ref("urn:fr:cc:obligations:ser:sm"), entity_ref("urn:fr:cc:obligations:ser:A"), entity_ref("urn:fr:cc:obligations:ser:B")) { origin case_input; }
        assert "f2": fait_personnel_a_la_partie(entity_ref("urn:fr:cc:obligations:ser:sm"), entity_ref("urn:fr:cc:obligations:ser:B")) { origin case_input; }
        assert "f3": refus_de_preter_ou_de_referer(entity_ref("urn:fr:cc:obligations:ser:sm"), entity_ref("urn:fr:cc:obligations:ser:B")) { origin case_input; }
    }
    evaluate truth(succombe_dans_sa_pretention(entity_ref("urn:fr:cc:obligations:ser:sm"), entity_ref("urn:fr:cc:obligations:ser:B")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RefusFaitSuccomber);
}
