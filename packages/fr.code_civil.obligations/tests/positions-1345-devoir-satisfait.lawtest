language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1345-devoir-satisfait" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obl:md:c2"), entity_ref("urn:fr:cc:obl:md:d2")) { origin case_input; }
        assert "f2": fr.code_civil.core::creancier(entity_ref("urn:fr:cc:obl:md:c2"), entity_ref("urn:fr:cc:obl:md:cr2")) { origin case_input; }
        assert "f3": date_d_exigibilite(entity_ref("urn:fr:cc:obl:md:c2"), @2026-09-10) { origin case_input; }
        assert "f4": mise_en_demeure_du_creancier_effectuee(entity_ref("urn:fr:cc:obl:md:c2"), entity_ref("urn:fr:cc:obl:md:d2"), entity_ref("urn:fr:cc:obl:md:cr2")) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionDevoirDeMettreLeCreancierEnDemeure, SATISFIED);
}
