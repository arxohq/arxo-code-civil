language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1307-1, al. 1 : le choix entre les prestations appartient au débiteur, à défaut
// d'attribution au créancier.
test "urn:query:fr-code-civil-obligations-m09-obligation-alternative-choix-au-debiteur" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": espece_de_l_obligation_plurale(entity_ref("urn:fr:cc:obligations:alt:c"), Alternative) { origin case_input; }
        assert "f2": prestation_de_l_obligation(entity_ref("urn:fr:cc:obligations:alt:c"), entity_ref("urn:fr:cc:obligations:alt:p1")) { origin case_input; }
        assert "f3": prestation_de_l_obligation(entity_ref("urn:fr:cc:obligations:alt:c"), entity_ref("urn:fr:cc:obligations:alt:p2")) { origin case_input; }
    }
    evaluate truth(choix_appartenant_au_debiteur(entity_ref("urn:fr:cc:obligations:alt:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ChoixAuDebiteur);
}
