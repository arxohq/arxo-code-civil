language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1345 et 1345-1 : le créancier refuse sans motif légitime (réponse du juge) ;
// mise en demeure le 10 mars 2025, obstruction constatée le 11 mai 2025.
// 2025-03-10 + 2 mois = 2025-05-10 ; le 11 mai est AU-DELÀ : la consignation s'ouvre.
test "urn:query:fr-code-civil-obligations-p14-consignation-apres-deux-mois" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": mise_en_demeure_du_creancier(entity_ref("urn:fr:cc:obl:k:md"), entity_ref("urn:fr:cc:obl:k:c"), entity_ref("urn:fr:cc:obl:k:CR")) { origin case_input; }
        assert "f2": refus_ou_empechement_du_creancier(entity_ref("urn:fr:cc:obl:k:c")) { origin case_input; }
        assert "f3": date_de_la_mise_en_demeure(entity_ref("urn:fr:cc:obl:k:md"), @2025-03-10) { origin case_input; }
        assert "f4": refus_sans_motif_legitime(entity_ref("urn:fr:cc:obl:k:md")) { origin adjudicated; }
        assert "f5": obstruction_persistante_au(entity_ref("urn:fr:cc:obl:k:md"), @2025-05-11) { origin case_input; }
        assert "f6": objet_de_l_obligation_obstruee(entity_ref("urn:fr:cc:obl:k:c"), SommeDArgent) { origin case_input; }
    }
    evaluate truth(consignation_ouverte(entity_ref("urn:fr:cc:obl:k:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(MiseEnDemeureDuCreancierQuiRefuse);
    expect applied(ConsignationApresDeuxMois);
}
