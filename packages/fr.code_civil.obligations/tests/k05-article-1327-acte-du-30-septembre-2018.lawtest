language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Loi n° 2018-287, article 16, I : l'article 1327 est le second article « nouveau » qui
// intéresse ce paquet (cession de dette). L'acte antérieur au 1er octobre 2018 échappe
// à sa rédaction issue de la ratification.
test "urn:query:fr-code-civil-obligations-k05-article-1327-acte-du-30-septembre-2018" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": situation_de_la_creance(entity_ref("urn:fr:cc:obligations:k5:s"), entity_ref("urn:fr:cc:obligations:k5:c")) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:obligations:k5:s"), @2018-09-30) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:obligations:k5:s"), "1327") { origin case_input; }
    }
    evaluate truth(article_nouveau_de_2018_inapplicable(entity_ref("urn:fr:cc:obligations:k5:c"), "1327"));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ArticleNouveauDe2018Inapplicable);
}
