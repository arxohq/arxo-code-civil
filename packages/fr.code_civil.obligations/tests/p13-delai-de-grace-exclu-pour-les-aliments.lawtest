language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1343-5, dernier alinéa : les dispositions de l'article ne sont pas applicables
// aux dettes d'aliment — et le report n'est donc pas accordé dans sa limite.
test "urn:query:fr-code-civil-obligations-p13-delai-de-grace-exclu-pour-les-aliments" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": date_d_exigibilite(entity_ref("urn:fr:cc:obl:i:c"), @2025-01-15) { origin case_input; }
        assert "f2": dette_d_aliment(entity_ref("urn:fr:cc:obl:i:c")) { origin case_input; }
        assert "f3": delai_de_grace_accorde(entity_ref("urn:fr:cc:obl:i:c"), @2026-01-15) { origin adjudicated; }
    }
    evaluate truth(report_dans_la_limite_de_deux_annees(entity_ref("urn:fr:cc:obl:i:c"), @2026-01-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
    expect applied(DelaiDeGraceExcluPourLesAliments);
}
