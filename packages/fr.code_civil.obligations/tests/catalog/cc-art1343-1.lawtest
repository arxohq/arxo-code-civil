language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-IMPUTATIONDUPAIEMENTPARTIELSURLESINTERETS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_de_la_dette(entity_ref("urn:kz:catalog:imputationdupaiementpartielsurlesinterets:v0"), entity_ref("urn:kz:catalog:imputationdupaiementpartielsurlesinterets:v1")) { origin case_input; }
        assert "cat-1": paiement_partiel(entity_ref("urn:kz:catalog:imputationdupaiementpartielsurlesinterets:v0")) { origin case_input; }
        assert "cat-2": obligation_portant_interet(entity_ref("urn:kz:catalog:imputationdupaiementpartielsurlesinterets:v1")) { origin case_input; }
    }
    evaluate truth(paiement_partiel_impute_sur_les_interets(entity_ref("urn:kz:catalog:imputationdupaiementpartielsurlesinterets:v0"), entity_ref("urn:kz:catalog:imputationdupaiementpartielsurlesinterets:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-LIBERATIONPRINCIPALETINTERETS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": obligation_portant_interet(entity_ref("urn:kz:catalog:liberationprincipaletinterets:v0")) { origin case_input; }
        assert "cat-1": obligation_de_somme_d_argent(entity_ref("urn:kz:catalog:liberationprincipaletinterets:v0")) { origin case_input; }
    }
    evaluate truth(liberation_par_le_principal_et_les_interets(entity_ref("urn:kz:catalog:liberationprincipaletinterets:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-TAUXCONVENTIONNELSANSECRIT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": interet_stipule_au_contrat(entity_ref("urn:kz:catalog:tauxconventionnelsansecrit:v0")) { origin case_input; }
    }
    evaluate truth(taux_conventionnel_inopposable(entity_ref("urn:kz:catalog:tauxconventionnelsansecrit:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-TAUXREPUTEANNUEL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": interet_stipule_au_contrat(entity_ref("urn:kz:catalog:tauxreputeannuel:v0")) { origin case_input; }
        assert "cat-1": taux_conventionnel_fixe_par_ecrit(entity_ref("urn:kz:catalog:tauxreputeannuel:v0")) { origin case_input; }
    }
    evaluate truth(taux_repute_annuel(entity_ref("urn:kz:catalog:tauxreputeannuel:v0")));
    expect truth_status == TRUE_ONLY;
}
