language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-CAUTIONLIBEREEPARLACONFUSION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": reunion_des_qualites_dans_la_meme_personne(entity_ref("urn:kz:catalog:cautionlibereeparlaconfusion:v0"), entity_ref("urn:kz:catalog:cautionlibereeparlaconfusion:v1")) { origin case_input; }
        assert "cat-1": caution_de_la_creance(entity_ref("urn:kz:catalog:cautionlibereeparlaconfusion:v0"), entity_ref("urn:kz:catalog:cautionlibereeparlaconfusion:v2")) { origin case_input; }
    }
    evaluate truth(caution_liberee_par_la_confusion(entity_ref("urn:kz:catalog:cautionlibereeparlaconfusion:v0"), entity_ref("urn:kz:catalog:cautionlibereeparlaconfusion:v2")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CONFUSIONLIMITEEALAPARTDUCODEBITEUR" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": reunion_des_qualites_dans_la_meme_personne(entity_ref("urn:kz:catalog:confusionlimiteealapartducodebiteur:v0"), entity_ref("urn:kz:catalog:confusionlimiteealapartducodebiteur:v1")) { origin case_input; }
        assert "cat-1": obligation_solidaire_entre_debiteurs(entity_ref("urn:kz:catalog:confusionlimiteealapartducodebiteur:v0")) { origin case_input; }
    }
    evaluate truth(extinction_par_confusion_limitee_a_la_part(entity_ref("urn:kz:catalog:confusionlimiteealapartducodebiteur:v0"), entity_ref("urn:kz:catalog:confusionlimiteealapartducodebiteur:v1")));
    expect truth_status == TRUE_ONLY;
}
