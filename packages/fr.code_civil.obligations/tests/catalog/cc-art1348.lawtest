language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-COMPENSATIONJUDICIAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": obligation_certaine(entity_ref("urn:kz:catalog:compensationjudiciaire:v0")) { origin case_input; }
        assert "cat-1": compensation_prononcee_en_justice(entity_ref("urn:kz:catalog:compensationjudiciaire:v0"), entity_ref("urn:kz:catalog:compensationjudiciaire:v1"), @2026-01-15) { origin case_input; }
        assert "cat-2": obligation_certaine(entity_ref("urn:kz:catalog:compensationjudiciaire:v1")) { origin case_input; }
    }
    evaluate truth(compensation_judiciaire_a_la_date_de_la_decision(entity_ref("urn:kz:catalog:compensationjudiciaire:v0"), entity_ref("urn:kz:catalog:compensationjudiciaire:v1"), @2026-01-15));
    expect truth_status == TRUE_ONLY;
}
