language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-RENONCIATIONALACONDITION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": condition_stipulee_dans_l_interet_exclusif(entity_ref("urn:kz:catalog:renonciationalacondition:v0"), entity_ref("urn:kz:catalog:renonciationalacondition:v1")) { origin case_input; }
        assert "cat-1": renonciation_a_la_condition(entity_ref("urn:kz:catalog:renonciationalacondition:v0"), entity_ref("urn:kz:catalog:renonciationalacondition:v1")) { origin case_input; }
    }
    evaluate truth(renonciation_valable(entity_ref("urn:kz:catalog:renonciationalacondition:v0"), entity_ref("urn:kz:catalog:renonciationalacondition:v1")));
    expect truth_status == TRUE_ONLY;
}
