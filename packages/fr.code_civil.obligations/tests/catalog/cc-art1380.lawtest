language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-CONTENUADDITIONNELSANSEFFET" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_recognitif(entity_ref("urn:kz:catalog:contenuadditionnelsanseffet:v0"), entity_ref("urn:kz:catalog:contenuadditionnelsanseffet:v1")) { origin case_input; }
        assert "cat-1": contenu_de_plus_ou_de_different(entity_ref("urn:kz:catalog:contenuadditionnelsanseffet:v0")) { origin case_input; }
    }
    evaluate truth(contenu_additionnel_sans_effet(entity_ref("urn:kz:catalog:contenuadditionnelsanseffet:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-PRESENTATIONDUTITREORIGINALEXIGEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_recognitif(entity_ref("urn:kz:catalog:presentationdutitreoriginalexigee:v0"), entity_ref("urn:kz:catalog:presentationdutitreoriginalexigee:v1")) { origin case_input; }
    }
    evaluate truth(presentation_du_titre_original_exigee(entity_ref("urn:kz:catalog:presentationdutitreoriginalexigee:v1")));
    expect truth_status == TRUE_ONLY;
}
