language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-EXECUTIONSUSPENDABLEENCASDEFAUX" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": inscription_de_faux(entity_ref("urn:kz:catalog:executionsuspendableencasdefaux:v0")) { origin case_input; }
        assert "cat-1": acte_authentique(entity_ref("urn:kz:catalog:executionsuspendableencasdefaux:v0")) { origin case_input; }
    }
    evaluate truth(execution_suspendable_par_le_juge(entity_ref("urn:kz:catalog:executionsuspendableencasdefaux:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-FOIJUSQUALINSCRIPTIONDEFAUX" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": fait_personnellement_accompli_ou_constate(entity_ref("urn:kz:catalog:foijusqualinscriptiondefaux:v0")) { origin case_input; }
        assert "cat-1": acte_authentique(entity_ref("urn:kz:catalog:foijusqualinscriptiondefaux:v0")) { origin case_input; }
    }
    evaluate truth(foi_jusqu_a_inscription_de_faux(entity_ref("urn:kz:catalog:foijusqualinscriptiondefaux:v0")));
    expect truth_status == TRUE_ONLY;
}
