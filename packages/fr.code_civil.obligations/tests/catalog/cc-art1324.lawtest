language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-EXCEPTIONANTERIEUREOPPOSABLEAUCESSIONNAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": exception_nee_avant_l_opposabilite(entity_ref("urn:kz:catalog:exceptionanterieureopposableaucessionnaire:v0"), entity_ref("urn:kz:catalog:exceptionanterieureopposableaucessionnaire:v1")) { origin case_input; }
        assert "cat-1": cession_de_creance(entity_ref("urn:kz:catalog:exceptionanterieureopposableaucessionnaire:v0"), entity_ref("urn:kz:catalog:exceptionanterieureopposableaucessionnaire:v1")) { origin case_input; }
    }
    evaluate truth(exception_opposable_au_cessionnaire(entity_ref("urn:kz:catalog:exceptionanterieureopposableaucessionnaire:v0"), entity_ref("urn:kz:catalog:exceptionanterieureopposableaucessionnaire:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-FRAISDELACESSIONAUCESSIONNAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cessionnaire(entity_ref("urn:kz:catalog:fraisdelacessionaucessionnaire:v0"), entity_ref("urn:kz:catalog:fraisdelacessionaucessionnaire:v2")) { origin case_input; }
        assert "cat-1": cession_de_creance(entity_ref("urn:kz:catalog:fraisdelacessionaucessionnaire:v0"), entity_ref("urn:kz:catalog:fraisdelacessionaucessionnaire:v1")) { origin case_input; }
    }
    evaluate truth(frais_de_la_cession_a_la_charge_du_cessionnaire(entity_ref("urn:kz:catalog:fraisdelacessionaucessionnaire:v0"), entity_ref("urn:kz:catalog:fraisdelacessionaucessionnaire:v2")));
    expect truth_status == TRUE_ONLY;
}
