language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-SUBROGATIONPAREMPRUNTSANSLECREANCIER" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_d_emprunt_et_quittance_notaries(entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v0")) { origin case_input; }
        assert "cat-1": subrogation_de_la_creance(entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v0"), entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v1")) { origin case_input; }
        assert "cat-2": subrogation_par_emprunt_du_debiteur(entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v0")) { origin case_input; }
        assert "cat-3": subrogation_expresse(entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v0")) { origin case_input; }
        assert "cat-4": dette_echue_ou_terme_en_faveur_du_debiteur(entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v1")) { origin case_input; }
        assert "cat-5": subroge(entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v0"), entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v2")) { origin case_input; }
    }
    evaluate truth(subrogation_par_emprunt_sans_le_creancier(entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v0"), entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v1"), entity_ref("urn:kz:catalog:subrogationparempruntsanslecreancier:v2")));
    expect truth_status == TRUE_ONLY;
}
