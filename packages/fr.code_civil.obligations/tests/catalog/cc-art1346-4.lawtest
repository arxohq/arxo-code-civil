language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-DROITATTACHEALAPERSONNENONTRANSMIS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": subrogation_acquise(entity_ref("urn:kz:catalog:droitattachealapersonnenontransmis:v0"), entity_ref("urn:kz:catalog:droitattachealapersonnenontransmis:v1"), entity_ref("urn:kz:catalog:droitattachealapersonnenontransmis:v2")) { origin case_input; }
        assert "cat-1": droit_exclusivement_attache_a_la_personne(entity_ref("urn:kz:catalog:droitattachealapersonnenontransmis:v1")) { origin case_input; }
    }
    evaluate truth(droit_non_transmis_au_subroge(entity_ref("urn:kz:catalog:droitattachealapersonnenontransmis:v0"), entity_ref("urn:kz:catalog:droitattachealapersonnenontransmis:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SUBROGELIMITEALINTERETLEGAL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": subrogation_acquise(entity_ref("urn:kz:catalog:subrogelimitealinteretlegal:v0"), entity_ref("urn:kz:catalog:subrogelimitealinteretlegal:v1"), entity_ref("urn:kz:catalog:subrogelimitealinteretlegal:v2")) { origin case_input; }
    }
    evaluate truth(subroge_limite_a_l_interet_legal(entity_ref("urn:kz:catalog:subrogelimitealinteretlegal:v0")));
    expect truth_status == TRUE_ONLY;
}
