language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-OPPOSABILITEAUCREANCIERPARNOTIFICATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": accord_donne_par_avance_sans_intervention(entity_ref("urn:kz:catalog:opposabiliteaucreancierparnotification:v0")) { origin case_input; }
        assert "cat-1": cession_notifiee_au_creancier(entity_ref("urn:kz:catalog:opposabiliteaucreancierparnotification:v0"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(cession_de_dette_opposable_au_creancier_le(entity_ref("urn:kz:catalog:opposabiliteaucreancierparnotification:v0"), @2026-01-15));
    expect truth_status == TRUE_ONLY;
}
