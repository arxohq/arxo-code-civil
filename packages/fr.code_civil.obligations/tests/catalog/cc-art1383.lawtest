language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-AVEUCONSTITUE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": aveu_fait(entity_ref("urn:kz:catalog:aveuconstitue:v0"), entity_ref("urn:kz:catalog:aveuconstitue:v1"), entity_ref("urn:kz:catalog:aveuconstitue:v2")) { origin case_input; }
    }
    evaluate truth(aveu_constitue(entity_ref("urn:kz:catalog:aveuconstitue:v0"), entity_ref("urn:kz:catalog:aveuconstitue:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-AVEUEXTRAJUDICIAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": aveu_fait(entity_ref("urn:kz:catalog:aveuextrajudiciaire:v0"), entity_ref("urn:kz:catalog:aveuextrajudiciaire:v1"), entity_ref("urn:kz:catalog:aveuextrajudiciaire:v2")) { origin case_input; }
    }
    evaluate truth(aveu_extrajudiciaire(entity_ref("urn:kz:catalog:aveuextrajudiciaire:v0")));
    expect truth_status == TRUE_ONLY;
}
