language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-DISPENSEDEMENTIONMANUSCRITEPARCONTRESEING" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_contresigne_par_avocat(entity_ref("urn:kz:catalog:dispensedementionmanuscriteparcontreseing:v0")) { origin case_input; }
    }
    evaluate truth(dispense_de_mention_manuscrite(entity_ref("urn:kz:catalog:dispensedementionmanuscriteparcontreseing:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-FOIDELECRITUREPARCONTRESEINGDAVOCAT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_contresigne_par_avocat(entity_ref("urn:kz:catalog:foidelecritureparcontreseingdavocat:v0")) { origin case_input; }
    }
    evaluate truth(foi_de_l_ecriture_et_de_la_signature(entity_ref("urn:kz:catalog:foidelecritureparcontreseingdavocat:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-PROCEDUREDEFAUXAPPLICABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": procedure_de_faux_engagee(entity_ref("urn:kz:catalog:proceduredefauxapplicable:v0")) { origin case_input; }
        assert "cat-1": acte_contresigne_par_avocat(entity_ref("urn:kz:catalog:proceduredefauxapplicable:v0")) { origin case_input; }
    }
    evaluate truth(procedure_de_faux_applicable(entity_ref("urn:kz:catalog:proceduredefauxapplicable:v0")));
    expect truth_status == TRUE_ONLY;
}
