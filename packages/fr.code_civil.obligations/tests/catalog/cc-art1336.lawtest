language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-DELEGUEOBLIGEENVERSLEDELEGATAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": delegue(entity_ref("urn:kz:catalog:delegueobligeenversledelegataire:v0"), entity_ref("urn:kz:catalog:delegueobligeenversledelegataire:v1")) { origin case_input; }
        assert "cat-1": delegation_consentie(entity_ref("urn:kz:catalog:delegueobligeenversledelegataire:v0")) { origin case_input; }
    }
    evaluate truth(delegue_oblige_envers_le_delegataire(entity_ref("urn:kz:catalog:delegueobligeenversledelegataire:v0"), entity_ref("urn:kz:catalog:delegueobligeenversledelegataire:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-EXCEPTIONINOPPOSABLEAUDELEGATAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": delegation_consentie(entity_ref("urn:kz:catalog:exceptioninopposableaudelegataire:v0")) { origin case_input; }
    }
    evaluate truth(exception_inopposable_au_delegataire(entity_ref("urn:kz:catalog:exceptioninopposableaudelegataire:v0")));
    expect truth_status == TRUE_ONLY;
}
