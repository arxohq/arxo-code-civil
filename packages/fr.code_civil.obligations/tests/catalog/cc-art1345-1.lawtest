language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-LIBERATIONPARLACONSIGNATIONNOTIFIEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": consignation_ou_sequestre_notifie_le(entity_ref("urn:kz:catalog:liberationparlaconsignationnotifiee:v0"), @2026-01-15) { origin case_input; }
        assert "cat-1": consignation_ouverte(entity_ref("urn:kz:catalog:liberationparlaconsignationnotifiee:v0")) { origin case_input; }
    }
    evaluate truth(debiteur_libere_par_la_consignation(entity_ref("urn:kz:catalog:liberationparlaconsignationnotifiee:v0"), @2026-01-15));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-VENTEAUTORISABLEPARLEJUGE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": sequestre_ouvert(entity_ref("urn:kz:catalog:venteautorisableparlejuge:v0")) { origin case_input; }
        assert "cat-1": sequestre_impossible_ou_trop_onereux(entity_ref("urn:kz:catalog:venteautorisableparlejuge:v0")) { origin case_input; }
    }
    evaluate truth(vente_autorisable_par_le_juge(entity_ref("urn:kz:catalog:venteautorisableparlejuge:v0")));
    expect truth_status == TRUE_ONLY;
}
