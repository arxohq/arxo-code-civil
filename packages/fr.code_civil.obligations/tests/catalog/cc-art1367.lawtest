language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-AUTHENTICITEPARLOFFICIERPUBLIC" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": signature_apposee_par_un_officier_public(entity_ref("urn:kz:catalog:authenticiteparlofficierpublic:v0")) { origin case_input; }
    }
    evaluate truth(authenticite_conferee_par_l_officier_public(entity_ref("urn:kz:catalog:authenticiteparlofficierpublic:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-FIABILITEDUPROCEDEPRESUMEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": conditions_du_decret_sur_la_signature_electronique_remplies(entity_ref("urn:kz:catalog:fiabiliteduprocedepresumee:v0")) { origin case_input; }
        assert "cat-1": signature_electronique(entity_ref("urn:kz:catalog:fiabiliteduprocedepresumee:v0")) { origin case_input; }
    }
    evaluate truth(fiabilite_du_procede_presumee(entity_ref("urn:kz:catalog:fiabiliteduprocedepresumee:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SIGNATUREIDENTIFIELAUTEUR" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": signature_apposee(entity_ref("urn:kz:catalog:signatureidentifielauteur:v0"), entity_ref("urn:kz:catalog:signatureidentifielauteur:v1")) { origin case_input; }
    }
    evaluate truth(signature_identifiant_l_auteur(entity_ref("urn:kz:catalog:signatureidentifielauteur:v0"), entity_ref("urn:kz:catalog:signatureidentifielauteur:v1")));
    expect truth_status == TRUE_ONLY;
}
