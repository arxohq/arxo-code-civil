language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-AVEUEXTRAJUDICIAIREVERBALRECEVABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": aveu_fait(entity_ref("urn:kz:catalog:aveuextrajudiciaireverbalrecevable:v0"), entity_ref("urn:kz:catalog:aveuextrajudiciaireverbalrecevable:v1"), entity_ref("urn:kz:catalog:aveuextrajudiciaireverbalrecevable:v2")) { origin case_input; }
        assert "cat-1": aveu_extrajudiciaire_purement_verbal(entity_ref("urn:kz:catalog:aveuextrajudiciaireverbalrecevable:v0")) { origin case_input; }
        assert "cat-2": preuve_par_tout_moyen(entity_ref("urn:kz:catalog:aveuextrajudiciaireverbalrecevable:v2")) { origin case_input; }
    }
    evaluate truth(aveu_recevable(entity_ref("urn:kz:catalog:aveuextrajudiciaireverbalrecevable:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-VALEURDELAVEULAISSEEAUJUGE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": aveu_extrajudiciaire_purement_verbal(entity_ref("urn:kz:catalog:valeurdelaveulaisseeaujuge:v0")) { origin case_input; }
    }
    evaluate truth(valeur_de_l_aveu_laissee_au_juge(entity_ref("urn:kz:catalog:valeurdelaveulaisseeaujuge:v0")));
    expect truth_status == TRUE_ONLY;
}
