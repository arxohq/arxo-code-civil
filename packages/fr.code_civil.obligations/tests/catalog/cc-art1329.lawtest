language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-NOVATIONNONPRESUMEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": novation_convenue(entity_ref("urn:kz:catalog:novationnonpresumee:v0"), entity_ref("urn:kz:catalog:novationnonpresumee:v1"), entity_ref("urn:kz:catalog:novationnonpresumee:v2")) { origin case_input; }
    }
    evaluate truth(novation_non_operee(entity_ref("urn:kz:catalog:novationnonpresumee:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-NOVATIONPARCHANGEMENTDECREANCIERESTUNMODE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": novation_par_changement_de_creancier(entity_ref("urn:kz:catalog:novationparchangementdecreancierestunmode:v0")) { origin case_input; }
    }
    evaluate truth(mode_de_novation_reconnu(entity_ref("urn:kz:catalog:novationparchangementdecreancierestunmode:v0")));
    expect truth_status == TRUE_ONLY;
}
