language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-FAUSSETNONPROUVABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": serment_fait(entity_ref("urn:kz:catalog:faussetnonprouvable:v0"), entity_ref("urn:kz:catalog:faussetnonprouvable:v1")) { origin case_input; }
    }
    evaluate truth(faussete_non_prouvable(entity_ref("urn:kz:catalog:faussetnonprouvable:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-RETRACTATIONIMPOSSIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": serment_defere_par_une_partie(entity_ref("urn:kz:catalog:retractationimpossible:v0"), entity_ref("urn:kz:catalog:retractationimpossible:v1"), entity_ref("urn:kz:catalog:retractationimpossible:v2")) { origin case_input; }
        assert "cat-1": partie_prete_a_faire_le_serment(entity_ref("urn:kz:catalog:retractationimpossible:v0"), entity_ref("urn:kz:catalog:retractationimpossible:v2")) { origin case_input; }
        assert "cat-2": retractation_tentee(entity_ref("urn:kz:catalog:retractationimpossible:v0"), entity_ref("urn:kz:catalog:retractationimpossible:v1")) { origin case_input; }
    }
    evaluate truth(retractation_impossible(entity_ref("urn:kz:catalog:retractationimpossible:v0"), entity_ref("urn:kz:catalog:retractationimpossible:v1")));
    expect truth_status == TRUE_ONLY;
}
