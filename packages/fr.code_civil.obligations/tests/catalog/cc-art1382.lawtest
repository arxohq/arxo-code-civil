language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-PRESOMPTIONJUDICIAIREADMISSIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": presomption_grave_precise_et_concordante(entity_ref("urn:kz:catalog:presomptionjudiciaireadmissible:v0")) { origin case_input; }
        assert "cat-1": presomption_judiciaire(entity_ref("urn:kz:catalog:presomptionjudiciaireadmissible:v0"), entity_ref("urn:kz:catalog:presomptionjudiciaireadmissible:v1")) { origin case_input; }
        assert "cat-2": preuve_par_tout_moyen(entity_ref("urn:kz:catalog:presomptionjudiciaireadmissible:v1")) { origin case_input; }
    }
    evaluate truth(presomption_judiciaire_admissible(entity_ref("urn:kz:catalog:presomptionjudiciaireadmissible:v0")));
    expect truth_status == TRUE_ONLY;
}
