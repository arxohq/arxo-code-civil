language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-LIBERATIONMALGRELADETERIORATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": chose_remise_au_creancier(entity_ref("urn:kz:catalog:liberationmalgreladeterioration:v0")) { origin case_input; }
        assert "cat-1": deterioration_non_imputable_au_debiteur(entity_ref("urn:kz:catalog:liberationmalgreladeterioration:v0")) { origin case_input; }
        assert "cat-2": deterioration_de_la_chose(entity_ref("urn:kz:catalog:liberationmalgreladeterioration:v0")) { origin case_input; }
        assert "cat-3": obligation_de_remettre_un_corps_certain(entity_ref("urn:kz:catalog:liberationmalgreladeterioration:v0")) { origin case_input; }
    }
    evaluate truth(debiteur_libere_par_la_remise_de_la_chose(entity_ref("urn:kz:catalog:liberationmalgreladeterioration:v0")));
    expect truth_status == TRUE_ONLY;
}
