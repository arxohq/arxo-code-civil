language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-REGISTREDOMESTIQUEENONCANTUNPAIEMENTRECU" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": enonce_formellement_un_paiement_recu(entity_ref("urn:kz:catalog:registredomestiqueenoncantunpaiementrecu:v0")) { origin case_input; }
        assert "cat-1": registre_domestique(entity_ref("urn:kz:catalog:registredomestiqueenoncantunpaiementrecu:v0"), entity_ref("urn:kz:catalog:registredomestiqueenoncantunpaiementrecu:v1")) { origin case_input; }
    }
    evaluate truth(registre_domestique_faisant_preuve_contre_l_auteur(entity_ref("urn:kz:catalog:registredomestiqueenoncantunpaiementrecu:v0"), entity_ref("urn:kz:catalog:registredomestiqueenoncantunpaiementrecu:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-REGISTREDOMESTIQUESANSPREUVEAUPROFITDELAUTEUR" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": registre_domestique(entity_ref("urn:kz:catalog:registredomestiquesanspreuveauprofitdelauteur:v0"), entity_ref("urn:kz:catalog:registredomestiquesanspreuveauprofitdelauteur:v1")) { origin case_input; }
    }
    evaluate truth(registre_domestique_sans_preuve_au_profit_de_l_auteur(entity_ref("urn:kz:catalog:registredomestiquesanspreuveauprofitdelauteur:v0"), entity_ref("urn:kz:catalog:registredomestiquesanspreuveauprofitdelauteur:v1")));
    expect truth_status == TRUE_ONLY;
}
