language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-COMPENSATIONMAINTENUEMALGRELESDROITSDUTIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": droits_acquis_par_un_tiers(entity_ref("urn:kz:catalog:compensationmaintenuemalgrelesdroitsdutiers:v0")) { origin case_input; }
        assert "cat-1": dettes_connexes(entity_ref("urn:kz:catalog:compensationmaintenuemalgrelesdroitsdutiers:v0"), entity_ref("urn:kz:catalog:compensationmaintenuemalgrelesdroitsdutiers:v1")) { origin case_input; }
    }
    evaluate truth(compensation_maintenue_malgre_les_droits_du_tiers(entity_ref("urn:kz:catalog:compensationmaintenuemalgrelesdroitsdutiers:v0"), entity_ref("urn:kz:catalog:compensationmaintenuemalgrelesdroitsdutiers:v1")));
    expect truth_status == TRUE_ONLY;
}
