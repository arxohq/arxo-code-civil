language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-QUALIFICATIONDUTERMESANSEFFETPROPRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": terme_expres_ou_tacite(entity_ref("urn:kz:catalog:qualificationdutermesanseffetpropre:v0")) { origin case_input; }
    }
    evaluate truth(qualification_du_terme_sans_effet_propre(entity_ref("urn:kz:catalog:qualificationdutermesanseffetpropre:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-TERMEFIXEPARLEJUGEADEFAUTDACCORD" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": terme_fixe_par_le_juge(entity_ref("urn:kz:catalog:termefixeparlejugeadefautdaccord:v1"), @2026-01-15) { origin case_input; }
        assert "cat-1": terme_de_l_obligation(entity_ref("urn:kz:catalog:termefixeparlejugeadefautdaccord:v0"), entity_ref("urn:kz:catalog:termefixeparlejugeadefautdaccord:v1")) { origin case_input; }
    }
    evaluate truth(terme_judiciairement_fixe(entity_ref("urn:kz:catalog:termefixeparlejugeadefautdaccord:v0"), @2026-01-15));
    expect truth_status == TRUE_ONLY;
}
