language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-EXTINCTIONRETROACTIVEPARLACONDITIONRESOLUTOIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": condition_accomplie(entity_ref("urn:kz:catalog:extinctionretroactiveparlaconditionresolutoire:v1")) { origin case_input; }
        assert "cat-1": condition_de_l_obligation(entity_ref("urn:kz:catalog:extinctionretroactiveparlaconditionresolutoire:v0"), entity_ref("urn:kz:catalog:extinctionretroactiveparlaconditionresolutoire:v1")) { origin case_input; }
        assert "cat-2": espece_de_la_condition(entity_ref("urn:kz:catalog:extinctionretroactiveparlaconditionresolutoire:v1"), Resolutoire) { origin case_input; }
    }
    evaluate truth(extinction_retroactive_de_l_obligation(entity_ref("urn:kz:catalog:extinctionretroactiveparlaconditionresolutoire:v0")));
    expect truth_status == TRUE_ONLY;
}
