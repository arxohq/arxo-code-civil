language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-CHARGEDEFINITIVEDELINEXECUTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": inexecution_imputable_a(entity_ref("urn:kz:catalog:chargedefinitivedelinexecution:v0"), entity_ref("urn:kz:catalog:chargedefinitivedelinexecution:v1")) { origin case_input; }
        assert "cat-1": inexecution_de_l_obligation(entity_ref("urn:kz:catalog:chargedefinitivedelinexecution:v0")) { origin case_input; }
    }
    evaluate truth(charge_definitive_de_l_inexecution(entity_ref("urn:kz:catalog:chargedefinitivedelinexecution:v0"), entity_ref("urn:kz:catalog:chargedefinitivedelinexecution:v1")));
    expect truth_status == TRUE_ONLY;
}
