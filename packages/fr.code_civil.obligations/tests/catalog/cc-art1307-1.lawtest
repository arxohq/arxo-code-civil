language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-CHOIXDEFINITIF" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": espece_de_l_obligation_plurale(entity_ref("urn:kz:catalog:choixdefinitif:v0"), Alternative) { origin case_input; }
        assert "cat-1": prestation_choisie(entity_ref("urn:kz:catalog:choixdefinitif:v0"), entity_ref("urn:kz:catalog:choixdefinitif:v1")) { origin case_input; }
    }
    evaluate truth(choix_definitif(entity_ref("urn:kz:catalog:choixdefinitif:v0"), entity_ref("urn:kz:catalog:choixdefinitif:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CHOIXTRANSFEREAPRESLETEMPSCONVENU" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": espece_de_l_obligation_plurale(entity_ref("urn:kz:catalog:choixtransfereapresletempsconvenu:v0"), Alternative) { origin case_input; }
        assert "cat-1": choix_non_exerce_dans_le_delai(entity_ref("urn:kz:catalog:choixtransfereapresletempsconvenu:v0")) { origin case_input; }
        assert "cat-2": mise_en_demeure_d_exercer_le_choix(entity_ref("urn:kz:catalog:choixtransfereapresletempsconvenu:v0")) { origin case_input; }
    }
    evaluate truth(choix_transfere_a_l_autre_partie(entity_ref("urn:kz:catalog:choixtransfereapresletempsconvenu:v0")));
    expect truth_status == TRUE_ONLY;
}
