language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-COMMENCEMENTDEPREUVEPARECRIT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": rend_vraisemblable_ce_qui_est_allegue(entity_ref("urn:kz:catalog:commencementdepreuveparecrit:v0")) { origin case_input; }
        assert "cat-1": ecrit_emanant_de_celui_qui_conteste(entity_ref("urn:kz:catalog:commencementdepreuveparecrit:v0"), entity_ref("urn:kz:catalog:commencementdepreuveparecrit:v1")) { origin case_input; }
    }
    evaluate truth(commencement_de_preuve_par_ecrit(entity_ref("urn:kz:catalog:commencementdepreuveparecrit:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-EQUIVALENTAUCOMMENCEMENTDEPREUVE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": declaration_a_la_comparution_personnelle(entity_ref("urn:kz:catalog:equivalentaucommencementdepreuve:v0"), entity_ref("urn:kz:catalog:equivalentaucommencementdepreuve:v1")) { origin case_input; }
        assert "cat-1": equivalence_retenue_par_le_juge(entity_ref("urn:kz:catalog:equivalentaucommencementdepreuve:v0")) { origin case_input; }
    }
    evaluate truth(equivalent_au_commencement_de_preuve(entity_ref("urn:kz:catalog:equivalentaucommencementdepreuve:v0")));
    expect truth_status == TRUE_ONLY;
}
