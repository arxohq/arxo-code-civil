language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-DATIONENPAIEMENTADMISE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_de_la_dette(entity_ref("urn:kz:catalog:dationenpaiementadmise:v0"), entity_ref("urn:kz:catalog:dationenpaiementadmise:v1")) { origin case_input; }
        assert "cat-1": dation_acceptee_par_le_creancier(entity_ref("urn:kz:catalog:dationenpaiementadmise:v0")) { origin case_input; }
    }
    evaluate truth(dation_en_paiement_admise(entity_ref("urn:kz:catalog:dationenpaiementadmise:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-REFUSDUPAIEMENTPARTIEL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_de_la_dette(entity_ref("urn:kz:catalog:refusdupaiementpartiel:v1"), entity_ref("urn:kz:catalog:refusdupaiementpartiel:v0")) { origin case_input; }
        assert "cat-1": paiement_partiel(entity_ref("urn:kz:catalog:refusdupaiementpartiel:v1")) { origin case_input; }
    }
    evaluate truth(droit_de_refuser_le_paiement_partiel(entity_ref("urn:kz:catalog:refusdupaiementpartiel:v0")));
    expect truth_status == TRUE_ONLY;
}
