language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-AVEUINDIVISIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": division_de_l_aveu_tentee(entity_ref("urn:kz:catalog:aveuindivisible:v0")) { origin case_input; }
        assert "cat-1": aveu_judiciaire(entity_ref("urn:kz:catalog:aveuindivisible:v0")) { origin case_input; }
    }
    evaluate truth(aveu_indivisible(entity_ref("urn:kz:catalog:aveuindivisible:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-AVEUJUDICIAIREFAITFOI" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": aveu_fait(entity_ref("urn:kz:catalog:aveujudiciairefaitfoi:v0"), entity_ref("urn:kz:catalog:aveujudiciairefaitfoi:v1"), entity_ref("urn:kz:catalog:aveujudiciairefaitfoi:v2")) { origin case_input; }
        assert "cat-1": aveu_judiciaire(entity_ref("urn:kz:catalog:aveujudiciairefaitfoi:v0")) { origin case_input; }
    }
    evaluate truth(aveu_faisant_foi_contre_son_auteur(entity_ref("urn:kz:catalog:aveujudiciairefaitfoi:v0"), entity_ref("urn:kz:catalog:aveujudiciairefaitfoi:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-AVEUREVOCABLEPOURERREURDEFAIT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": erreur_de_fait_invoquee(entity_ref("urn:kz:catalog:aveurevocablepourerreurdefait:v0")) { origin case_input; }
        assert "cat-1": aveu_judiciaire(entity_ref("urn:kz:catalog:aveurevocablepourerreurdefait:v0")) { origin case_input; }
    }
    evaluate truth(aveu_revocable_pour_erreur_de_fait(entity_ref("urn:kz:catalog:aveurevocablepourerreurdefait:v0")));
    expect truth_status == TRUE_ONLY;
}
