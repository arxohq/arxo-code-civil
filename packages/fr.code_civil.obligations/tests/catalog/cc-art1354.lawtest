language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-PRESOMPTIONIRRENVERSABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": espece_de_la_presomption(entity_ref("urn:kz:catalog:presomptionirrenversable:v0"), Irrefragable) { origin case_input; }
        assert "cat-1": presomption_legale_attachee(entity_ref("urn:kz:catalog:presomptionirrenversable:v0"), entity_ref("urn:kz:catalog:presomptionirrenversable:v1")) { origin case_input; }
    }
    evaluate truth(presomption_irrenversable(entity_ref("urn:kz:catalog:presomptionirrenversable:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-PRESOMPTIONMIXTERENVERSEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": preuve_contraire_par_un_moyen_admis(entity_ref("urn:kz:catalog:presomptionmixterenversee:v0")) { origin case_input; }
        assert "cat-1": espece_de_la_presomption(entity_ref("urn:kz:catalog:presomptionmixterenversee:v0"), Mixte) { origin case_input; }
    }
    evaluate truth(presomption_renversee(entity_ref("urn:kz:catalog:presomptionmixterenversee:v0")));
    expect truth_status == TRUE_ONLY;
}
