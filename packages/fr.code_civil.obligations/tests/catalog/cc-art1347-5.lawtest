language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-APPLYP2MAINTIENINTERDICTIONCOMPENSATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": date_d_exigibilite(entity_ref("urn:kz:catalog:applyp2maintieninterdictioncompensation:v0"), @2026-01-15) { origin case_input; }
        assert "cat-1": compensation_inopposable_au_cessionnaire(entity_ref("urn:kz:catalog:applyp2maintieninterdictioncompensation:v0"), entity_ref("urn:kz:catalog:applyp2maintieninterdictioncompensation:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(P2MaintienInterdictionCompensation, ACTIVE);
}
