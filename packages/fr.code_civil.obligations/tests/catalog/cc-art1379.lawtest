language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-COPIEEXECUTOIREREPUTEEFIABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": copie_executoire_ou_authentique(entity_ref("urn:kz:catalog:copieexecutoirereputeefiable:v0")) { origin case_input; }
        assert "cat-1": copie_d_un_ecrit(entity_ref("urn:kz:catalog:copieexecutoirereputeefiable:v0"), entity_ref("urn:kz:catalog:copieexecutoirereputeefiable:v1")) { origin case_input; }
    }
    evaluate truth(copie_fiable(entity_ref("urn:kz:catalog:copieexecutoirereputeefiable:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-PRESENTATIONDELORIGINALEXIGIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": original_subsistant(entity_ref("urn:kz:catalog:presentationdeloriginalexigible:v1")) { origin case_input; }
        assert "cat-1": copie_d_un_ecrit(entity_ref("urn:kz:catalog:presentationdeloriginalexigible:v0"), entity_ref("urn:kz:catalog:presentationdeloriginalexigible:v1")) { origin case_input; }
    }
    evaluate truth(presentation_de_l_original_exigible(entity_ref("urn:kz:catalog:presentationdeloriginalexigible:v1")));
    expect truth_status == TRUE_ONLY;
}
