language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-SUBROGATIONOPPOSABLEAUDEBITEUR" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": subrogation_de_la_creance(entity_ref("urn:kz:catalog:subrogationopposableaudebiteur:v0"), entity_ref("urn:kz:catalog:subrogationopposableaudebiteur:v1")) { origin case_input; }
        assert "cat-1": subrogation_notifiee_ou_prise_en_acte(entity_ref("urn:kz:catalog:subrogationopposableaudebiteur:v0")) { origin case_input; }
    }
    evaluate truth(subrogation_opposable_au_debiteur(entity_ref("urn:kz:catalog:subrogationopposableaudebiteur:v0"), entity_ref("urn:kz:catalog:subrogationopposableaudebiteur:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SUBROGATIONOPPOSABLEAUXTIERSDESLEPAIEMENT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": subrogation_de_la_creance(entity_ref("urn:kz:catalog:subrogationopposableauxtiersdeslepaiement:v0"), entity_ref("urn:kz:catalog:subrogationopposableauxtiersdeslepaiement:v1")) { origin case_input; }
        assert "cat-1": date_du_paiement_subrogatoire(entity_ref("urn:kz:catalog:subrogationopposableauxtiersdeslepaiement:v0"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(subrogation_opposable_aux_tiers_des_le_paiement(entity_ref("urn:kz:catalog:subrogationopposableauxtiersdeslepaiement:v0"), @2026-01-15));
    expect truth_status == TRUE_ONLY;
}
