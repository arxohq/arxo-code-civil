language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-PAIEMENTALAPERSONNEDESIGNEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_de_la_dette(entity_ref("urn:kz:catalog:paiementalapersonnedesignee:v0"), entity_ref("urn:kz:catalog:paiementalapersonnedesignee:v1")) { origin case_input; }
        assert "cat-1": destinataire_du_paiement(entity_ref("urn:kz:catalog:paiementalapersonnedesignee:v0"), entity_ref("urn:kz:catalog:paiementalapersonnedesignee:v2")) { origin case_input; }
        assert "cat-2": personne_designee_pour_recevoir(entity_ref("urn:kz:catalog:paiementalapersonnedesignee:v1"), entity_ref("urn:kz:catalog:paiementalapersonnedesignee:v2")) { origin case_input; }
    }
    evaluate truth(paiement_valable(entity_ref("urn:kz:catalog:paiementalapersonnedesignee:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-PAIEMENTAUCREANCIERINCAPABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_de_la_dette(entity_ref("urn:kz:catalog:paiementaucreancierincapable:v0"), entity_ref("urn:kz:catalog:paiementaucreancierincapable:v1")) { origin case_input; }
        assert "cat-1": creancier_incapable_de_contracter(entity_ref("urn:kz:catalog:paiementaucreancierincapable:v1")) { origin case_input; }
    }
    evaluate truth(paiement_non_valable(entity_ref("urn:kz:catalog:paiementaucreancierincapable:v0")));
    expect truth_status == TRUE_ONLY;
}
