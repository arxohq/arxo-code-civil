language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-SURETESREPORTEESSURLANOUVELLEOBLIGATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": novation_operee(entity_ref("urn:kz:catalog:suretesreporteessurlanouvelleobligation:v0"), entity_ref("urn:kz:catalog:suretesreporteessurlanouvelleobligation:v1"), entity_ref("urn:kz:catalog:suretesreporteessurlanouvelleobligation:v2")) { origin case_input; }
        assert "cat-1": suretes_d_origine_reservees(entity_ref("urn:kz:catalog:suretesreporteessurlanouvelleobligation:v0")) { origin case_input; }
    }
    evaluate truth(suretes_reportees_sur_la_nouvelle_obligation(entity_ref("urn:kz:catalog:suretesreporteessurlanouvelleobligation:v0"), entity_ref("urn:kz:catalog:suretesreporteessurlanouvelleobligation:v2")));
    expect truth_status == TRUE_ONLY;
}
