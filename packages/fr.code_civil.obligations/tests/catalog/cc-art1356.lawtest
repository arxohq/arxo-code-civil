language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-CONTRATSURLAPREUVESANSEFFET" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": contrat_sur_la_preuve(entity_ref("urn:kz:catalog:contratsurlapreuvesanseffet:v0")) { origin case_input; }
        assert "cat-1": contredit_une_presomption_irrefragable(entity_ref("urn:kz:catalog:contratsurlapreuvesanseffet:v0")) { origin case_input; }
    }
    evaluate truth(contrat_sur_la_preuve_sans_effet(entity_ref("urn:kz:catalog:contratsurlapreuvesanseffet:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CONTRATSURLAPREUVEVALABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": droits_dont_les_parties_ont_la_libre_disposition(entity_ref("urn:kz:catalog:contratsurlapreuvevalable:v0")) { origin case_input; }
        assert "cat-1": contrat_sur_la_preuve(entity_ref("urn:kz:catalog:contratsurlapreuvevalable:v0")) { origin case_input; }
    }
    evaluate truth(contrat_sur_la_preuve_valable(entity_ref("urn:kz:catalog:contratsurlapreuvevalable:v0")));
    expect truth_status == TRUE_ONLY;
}
