        assert "cat-0": serment_defere_par_une_partie(entity_ref("urn:kz:catalog:sermentfaitpreuveauprofitdesheritiers:v0"), entity_ref("urn:kz:catalog:sermentfaitpreuveauprofitdesheritiers:v1"), entity_ref("urn:kz:catalog:sermentfaitpreuveauprofitdesheritiers:v2")) { origin case_input; }
