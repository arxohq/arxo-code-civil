test "CATALOG-LIBERATIONPOURLAPARTDUCREANCIERAYANTDEFERE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": serment_defere_par_un_creancier_solidaire(entity_ref("urn:kz:catalog:liberationpourlapartducreancierayantdefere:v0"), entity_ref("urn:kz:catalog:liberationpourlapartducreancierayantdefere:v1"), entity_ref("urn:kz:catalog:liberationpourlapartducreancierayantdefere:v2")) { origin case_input; }
        assert "cat-1": obligation_solidaire_entre_creanciers(entity_ref("urn:kz:catalog:liberationpourlapartducreancierayantdefere:v1")) { origin case_input; }
    }
    evaluate truth(debiteur_libere_pour_la_part_du_creancier_ayant_defere(entity_ref("urn:kz:catalog:liberationpourlapartducreancierayantdefere:v0"), entity_ref("urn:kz:catalog:liberationpourlapartducreancierayantdefere:v1"), entity_ref("urn:kz:catalog:liberationpourlapartducreancierayantdefere:v2")));
