language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-EXCEPTIONINHERENTEOPPOSABLEPARLEDEBITEURSUBSTITUE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cessionnaire(entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v0"), entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v2")) { origin case_input; }
        assert "cat-1": cession_de_dette(entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v0"), entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v1")) { origin case_input; }
        assert "cat-2": exception_inherente_a_la_dette(entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v1")) { origin case_input; }
    }
    evaluate truth(exception_opposable_au_creancier(entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v0"), entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v1"), entity_ref("urn:kz:catalog:exceptioninherenteopposableparledebiteursubstitu:v2")));
    expect truth_status == TRUE_ONLY;
}
