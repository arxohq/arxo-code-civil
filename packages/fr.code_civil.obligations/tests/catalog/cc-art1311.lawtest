language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны из CLIR пакета; правка руками — только вместе с каталогом.

// 
test "CATALOG-PAIEMENTALUNLIBEREENVERSTOUS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_fait_a_un_creancier_solidaire(entity_ref("urn:kz:catalog:paiementalunlibereenverstous:v0"), entity_ref("urn:kz:catalog:paiementalunlibereenverstous:v1")) { origin case_input; }
        assert "cat-1": obligation_solidaire_entre_creanciers(entity_ref("urn:kz:catalog:paiementalunlibereenverstous:v0")) { origin case_input; }
    }
    evaluate truth(paiement_liberatoire_envers_tous_les_creanciers(entity_ref("urn:kz:catalog:paiementalunlibereenverstous:v0")));
    expect truth_status == TRUE_ONLY;
}
