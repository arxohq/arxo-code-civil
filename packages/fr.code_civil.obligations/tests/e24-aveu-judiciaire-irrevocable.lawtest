language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1383-2, al. 4 : l'aveu judiciaire est IRRÉVOCABLE, sauf en cas d'erreur de fait.
// Aucune erreur n'est invoquée ici.
test "urn:query:fr-code-civil-obligations-e24-aveu-judiciaire-irrevocable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": aveu_fait(entity_ref("urn:fr:cc:obligations:avr:av"), entity_ref("urn:fr:cc:obligations:avr:P"), entity_ref("urn:fr:cc:obligations:avr:a")) { origin case_input; }
        assert "f2": aveu_judiciaire(entity_ref("urn:fr:cc:obligations:avr:av")) { origin case_input; }
    }
    evaluate truth(aveu_irrevocable(entity_ref("urn:fr:cc:obligations:avr:av")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(AveuIrrevocable);
}
