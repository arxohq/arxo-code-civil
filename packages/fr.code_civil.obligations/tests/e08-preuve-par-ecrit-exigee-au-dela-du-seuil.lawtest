language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1359, al. 1 : l'acte portant sur une somme EXCÉDANT le montant fixé par décret
// doit être prouvé par écrit. Le Code ne nomme pas ce montant : le cas le fournit
// (1 500 EUR au décret n° 80-533 en vigueur), et l'acte de 2 000 EUR le dépasse.
test "urn:query:fr-code-civil-obligations-e08-preuve-par-ecrit-exigee-au-dela-du-seuil" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": somme_ou_valeur_de_l_acte(entity_ref("urn:fr:cc:obligations:sup:a"), 2000 EUR) { origin case_input; }
        assert "f2": seuil_de_la_preuve_par_ecrit(entity_ref("urn:fr:cc:obligations:sup:a"), 1500 EUR) { origin case_input; }
    }
    evaluate truth(preuve_par_ecrit_exigee(entity_ref("urn:fr:cc:obligations:sup:a")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PreuveParEcritExigee);
}
