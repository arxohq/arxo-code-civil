language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1347-pouvoir-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": fr.code_civil.core::creancier(entity_ref("urn:fr:cc:obl:cmp:c3"), entity_ref("urn:fr:cc:obl:cmp:cr3")) { origin case_input; }
        assert "f2": obligation_reciproque(entity_ref("urn:fr:cc:obl:cmp:c3"), entity_ref("urn:fr:cc:obl:cmp:c4")) { origin case_input; }
        assert "f3": obligation_fongible(entity_ref("urn:fr:cc:obl:cmp:c3")) { origin case_input; }
        assert "f4": obligation_fongible(entity_ref("urn:fr:cc:obl:cmp:c4")) { origin case_input; }
        assert "f5": obligation_certaine(entity_ref("urn:fr:cc:obl:cmp:c3")) { origin case_input; }
        assert "f6": obligation_certaine(entity_ref("urn:fr:cc:obl:cmp:c4")) { origin case_input; }
        assert "f7": obligation_liquide(entity_ref("urn:fr:cc:obl:cmp:c3")) { origin case_input; }
        assert "f8": obligation_liquide(entity_ref("urn:fr:cc:obl:cmp:c4")) { origin case_input; }
        assert "f9": date_de_reunion_des_conditions(entity_ref("urn:fr:cc:obl:cmp:c3"), entity_ref("urn:fr:cc:obl:cmp:c4"), @2025-03-01) { origin case_input; }
        assert "f10": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obl:cmp:c3"), 1200 EUR) { origin case_input; }
        assert "f11": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obl:cmp:c4"), 700 EUR) { origin case_input; }
        assert "f12": date_d_exigibilite(entity_ref("urn:fr:cc:obl:cmp:c3"), @2025-02-01) { origin case_input; }
        assert "f13": date_d_exigibilite(entity_ref("urn:fr:cc:obl:cmp:c4"), @2025-03-01) { origin case_input; }
        assert "f14": date_de_reunion_des_conditions(entity_ref("urn:fr:cc:obl:cmp:c4"), entity_ref("urn:fr:cc:obl:cmp:c3"), @2025-03-01) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionPouvoirDInvoquerLaCompensation, ACTIVE);
}
