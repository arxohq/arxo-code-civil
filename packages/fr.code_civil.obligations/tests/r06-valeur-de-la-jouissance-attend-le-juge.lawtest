language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1352-3, al. 2, canal §47.3 : la valeur de la jouissance est ÉVALUÉE PAR LE JUGE.
// Sans son évaluation, le total de la restitution n'est pas calculable : le paquet ne
// l'invente pas et la question reste ouverte.
test "urn:query:fr-code-civil-obligations-r06-valeur-de-la-jouissance-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obligations:rjj:r"), entity_ref("urn:fr:cc:obligations:rjj:D"), entity_ref("urn:fr:cc:obligations:rjj:CR")) { origin case_input; }
        assert "f2": fruits_percus(entity_ref("urn:fr:cc:obligations:rjj:r"), 1500 EUR) { origin case_input; }
    }
    evaluate truth(restitution_incluant_les_fruits_et_la_jouissance(entity_ref("urn:fr:cc:obligations:rjj:r"), 1500 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
