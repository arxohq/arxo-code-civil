language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1304-7, al. 2 : la rétroactivité n'a pas lieu si les prestations échangées ont
// trouvé leur utilité au fur et à mesure de l'exécution réciproque du contrat.
test "urn:query:fr-code-civil-obligations-m05-condition-resolutoire-sans-retroactivite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": condition_de_l_obligation(entity_ref("urn:fr:cc:obligations:res:c"), entity_ref("urn:fr:cc:obligations:res:k")) { origin case_input; }
        assert "f2": espece_de_la_condition(entity_ref("urn:fr:cc:obligations:res:k"), Resolutoire) { origin case_input; }
        assert "f3": condition_accomplie(entity_ref("urn:fr:cc:obligations:res:k")) { origin case_input; }
        assert "f4": prestations_utiles_au_fur_et_a_mesure(entity_ref("urn:fr:cc:obligations:res:k")) { origin case_input; }
    }
    evaluate truth(extinction_sans_retroactivite(entity_ref("urn:fr:cc:obligations:res:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ExtinctionSansRetroactivitePourPrestationsUtiles);
}
