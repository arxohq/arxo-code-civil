language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1352-restitution-satisfaite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obl:pos:r2"), entity_ref("urn:fr:cc:obl:pos:recipient2"), entity_ref("urn:fr:cc:obl:pos:payee2")) { origin case_input; }
        assert "f2": date_du_paiement_a_restituer(entity_ref("urn:fr:cc:obl:pos:r2"), @2026-09-01) { origin case_input; }
        assert "f3": restitution_effectuee(entity_ref("urn:fr:cc:obl:pos:r2")) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionDevoirDeRestituer, SATISFIED);
}
