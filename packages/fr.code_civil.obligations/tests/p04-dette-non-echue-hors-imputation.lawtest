language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1342-10, al. 2 : l'imputation légale n'atteint que les dettes ÉCHUES.
// d3 n'est exigible que le 1er janvier 2027 : au 1er mars 2025 elle n'est pas imputable.
test "urn:query:fr-code-civil-obligations-p04-dette-non-echue-hors-imputation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": paiement_du_debiteur(entity_ref("urn:fr:cc:obl:p:pay"), entity_ref("urn:fr:cc:obl:p:D")) { origin case_input; }
        assert "f2": date_du_paiement(entity_ref("urn:fr:cc:obl:p:pay"), @2025-03-01) { origin case_input; }
        assert "f3": montant_paye(entity_ref("urn:fr:cc:obl:p:pay"), 1500 EUR) { origin case_input; }
        assert "f4": dette_du_debiteur(entity_ref("urn:fr:cc:obl:p:D"), entity_ref("urn:fr:cc:obl:p:d1")) { origin case_input; }
        assert "f5": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obl:p:d1"), 3000 EUR) { origin case_input; }
        assert "f6": date_de_naissance_de_la_dette(entity_ref("urn:fr:cc:obl:p:d1"), @2020-01-10) { origin case_input; }
        assert "f7": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p:d1"), @2024-01-10) { origin case_input; }
        assert "f8": dette_du_debiteur(entity_ref("urn:fr:cc:obl:p:D"), entity_ref("urn:fr:cc:obl:p:d2")) { origin case_input; }
        assert "f9": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obl:p:d2"), 2000 EUR) { origin case_input; }
        assert "f10": date_de_naissance_de_la_dette(entity_ref("urn:fr:cc:obl:p:d2"), @2022-05-01) { origin case_input; }
        assert "f11": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p:d2"), @2024-06-01) { origin case_input; }
        assert "f12": dette_du_debiteur(entity_ref("urn:fr:cc:obl:p:D"), entity_ref("urn:fr:cc:obl:p:d3")) { origin case_input; }
        assert "f13": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obl:p:d3"), 1000 EUR) { origin case_input; }
        assert "f14": date_de_naissance_de_la_dette(entity_ref("urn:fr:cc:obl:p:d3"), @2023-01-01) { origin case_input; }
        assert "f15": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p:d3"), @2027-01-01) { origin case_input; }
        assert "f16": egalite_d_interet_d_acquitter(entity_ref("urn:fr:cc:obl:p:D"), entity_ref("urn:fr:cc:obl:p:d1"), entity_ref("urn:fr:cc:obl:p:d2")) { origin adjudicated; }
    }
    evaluate truth(dette_imputable(entity_ref("urn:fr:cc:obl:p:pay"), entity_ref("urn:fr:cc:obl:p:d3")));
    expect evaluation_status == COMPUTED;
    // `applied` porte sur le document, non sur ce fondement : la règle a bien
    // servi pour d1 et d2. C'est le statut de CE terme qui répond ici.
    expect truth_status == NEITHER;
}
