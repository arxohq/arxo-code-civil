language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1347-2, in fine : le créancier consent à la compensation — elle redevient
// possible malgré l'insaisissabilité.
test "urn:query:fr-code-civil-obligations-c05-creance-insaisissable-compensable-avec-consentement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": obligation_reciproque(entity_ref("urn:fr:cc:obligations:cic:c1"), entity_ref("urn:fr:cc:obligations:cic:c2")) { origin case_input; }
        assert "f2": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obligations:cic:c1"), 5000 EUR) { origin case_input; }
        assert "f3": fr.code_civil.core::objet_monetaire(entity_ref("urn:fr:cc:obligations:cic:c2"), 3000 EUR) { origin case_input; }
        assert "f4": obligation_fongible(entity_ref("urn:fr:cc:obligations:cic:c1")) { origin case_input; }
        assert "f5": obligation_fongible(entity_ref("urn:fr:cc:obligations:cic:c2")) { origin case_input; }
        assert "f6": obligation_certaine(entity_ref("urn:fr:cc:obligations:cic:c1")) { origin case_input; }
        assert "f7": obligation_certaine(entity_ref("urn:fr:cc:obligations:cic:c2")) { origin case_input; }
        assert "f8": obligation_liquide(entity_ref("urn:fr:cc:obligations:cic:c1")) { origin case_input; }
        assert "f9": obligation_liquide(entity_ref("urn:fr:cc:obligations:cic:c2")) { origin case_input; }
        assert "f10": date_d_exigibilite(entity_ref("urn:fr:cc:obligations:cic:c1"), @2025-01-10) { origin case_input; }
        assert "f11": date_d_exigibilite(entity_ref("urn:fr:cc:obligations:cic:c2"), @2025-02-01) { origin case_input; }
        assert "f12": date_de_reunion_des_conditions(entity_ref("urn:fr:cc:obligations:cic:c1"), entity_ref("urn:fr:cc:obligations:cic:c2"), @2025-02-01) { origin case_input; }
        assert "f13": date_de_reunion_des_conditions(entity_ref("urn:fr:cc:obligations:cic:c2"), entity_ref("urn:fr:cc:obligations:cic:c1"), @2025-02-01) { origin case_input; }
        assert "f14": creance_insaisissable(entity_ref("urn:fr:cc:obligations:cic:c2")) { origin case_input; }
        assert "f15": consentement_du_creancier_a_la_compensation(entity_ref("urn:fr:cc:obligations:cic:c2")) { origin case_input; }
        assert "f16": compensation_invoquee(entity_ref("urn:fr:cc:obligations:cic:c1"), entity_ref("urn:fr:cc:obligations:cic:c2")) { origin case_input; }
    }
    evaluate truth(extinction_par_compensation(entity_ref("urn:fr:cc:obligations:cic:c1"), entity_ref("urn:fr:cc:obligations:cic:c2"), 3000 EUR, @2025-02-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ExtinctionParCompensation);
}
