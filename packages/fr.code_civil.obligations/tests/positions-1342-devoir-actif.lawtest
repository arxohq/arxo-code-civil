language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1342-devoir-actif" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obl:pos:c"), entity_ref("urn:fr:cc:obl:pos:d")) { origin case_input; }
        assert "f2": fr.code_civil.core::creancier(entity_ref("urn:fr:cc:obl:pos:c"), entity_ref("urn:fr:cc:obl:pos:cr")) { origin case_input; }
        assert "f3": date_d_exigibilite(entity_ref("urn:fr:cc:obl:pos:c"), @2026-09-10) { origin case_input; }
    }
    evaluate positions();
    expect position(P2DevoirDePayerLaDette, ACTIVE);
}

test "urn:query:fr-code-civil-obligations-positions-1342-devoir-actif-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obl:pos:c2"), entity_ref("urn:fr:cc:obl:pos:d2")) { origin case_input; }
        assert "f2": fr.code_civil.core::creancier(entity_ref("urn:fr:cc:obl:pos:c2"), entity_ref("urn:fr:cc:obl:pos:cr2")) { origin case_input; }
        assert "f3": date_d_exigibilite(entity_ref("urn:fr:cc:obl:pos:c2"), @2026-09-11) { origin case_input; }
    }
    evaluate positions();
    expect position(P2DevoirDePayerLaDette, ACTIVE);
}
