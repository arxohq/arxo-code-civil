language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1343-5, al. 1, frontière : un jour au-delà des deux années (16 janvier 2027)
// excède le pouvoir que le texte donne au juge.
test "urn:query:fr-code-civil-obligations-p12-delai-de-grace-un-jour-au-dela" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": date_d_exigibilite(entity_ref("."), @2025-01-15) { origin case_input; }
        assert "f2": delai_de_grace_accorde(entity_ref("."), @2027-01-16) { origin adjudicated; }
    }
    evaluate truth(report_excedant_la_limite_legale(entity_ref("."), @2027-01-16));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ReportExcedantLaLimiteLegale);
}
