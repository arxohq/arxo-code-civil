language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1342-9 et 1354, al. 2 : la présomption est SIMPLE — la preuve contraire la
// renverse, et la libération n'est plus présumée.
test "urn:query:fr-code-civil-obligations-p20-presomption-de-liberation-renversee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": remise_volontaire_du_titre(entity_ref("URN:FR:CC:OBL"), entity_ref("URN:FR:CC:OBL:D")) { origin case_input; }
        assert "f2": preuve_contraire_de_la_liberation(entity_ref("URN:FR:CC:OBL"), entity_ref("URN:FR:CC:OBL:D")) { origin case_input; }
    }
    evaluate truth(liberation_presumee(entity_ref("URN:FR:CC:OBL"), entity_ref("URN:FR:CC:OBL:D")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
