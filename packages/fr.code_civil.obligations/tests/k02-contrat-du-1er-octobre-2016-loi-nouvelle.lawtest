language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Ordonnance n° 2016-131, article 9 : le contrat conclu À COMPTER du 1er octobre 2016
// relève de la loi nouvelle — le jour même du seuil suffit. Paire avec k01.
test "urn:query:fr-code-civil-obligations-k02-contrat-du-1er-octobre-2016-loi-nouvelle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": situation_de_la_creance(entity_ref("urn:fr:cc:obligations:k2:s"), entity_ref("urn:fr:cc:obligations:k2:c")) { origin case_input; }
        assert "f2": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc:obligations:k2:s"), @2016-10-01) { origin case_input; }
    }
    evaluate truth(regime_general_de_la_loi_nouvelle(entity_ref("urn:fr:cc:obligations:k2:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CreanceRegieParLaLoiNouvelle);
}
