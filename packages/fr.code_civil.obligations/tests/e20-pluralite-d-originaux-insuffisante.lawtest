language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1375, al. 1 et 2 : l'acte constatant un contrat synallagmatique ne fait preuve
// que s'il a été fait en AUTANT D'ORIGINAUX qu'il y a de parties d'intérêt distinct.
// Deux originaux pour trois parties : la preuve n'est pas faite.
test "urn:query:fr-code-civil-obligations-e20-pluralite-d-originaux-insuffisante" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": contrat_synallagmatique(entity_ref("urn:fr:cc:obligations:ori:a")) { origin case_input; }
        assert "f2": ecrit_de_l_acte(entity_ref("urn:fr:cc:obligations:ori:a"), entity_ref("urn:fr:cc:obligations:ori:e")) { origin case_input; }
        assert "f3": nombre_d_originaux(entity_ref("urn:fr:cc:obligations:ori:e"), 2) { origin case_input; }
        assert "f4": nombre_de_parties_d_interet_distinct(entity_ref("urn:fr:cc:obligations:ori:a"), 3) { origin case_input; }
        assert "f5": mention_du_nombre_des_originaux(entity_ref("urn:fr:cc:obligations:ori:e")) { origin case_input; }
    }
    evaluate truth(pluralite_d_originaux_non_satisfaite(entity_ref("urn:fr:cc:obligations:ori:e")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PluraliteDOriginauxNonSatisfaite);
}
