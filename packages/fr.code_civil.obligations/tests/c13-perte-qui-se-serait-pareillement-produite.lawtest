language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1351-1, al. 1 : le débiteur mis en demeure est NÉANMOINS libéré s'il prouve que
// la perte se serait pareillement produite si l'obligation avait été exécutée ; il
// reste tenu de céder les droits et actions attachés à la chose (al. 2).
test "urn:query:fr-code-civil-obligations-c13-perte-qui-se-serait-pareillement-produite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": force_majeure_definitive(entity_ref("urn:fr:cc:obligations:prt:c")) { origin adjudicated; }
        assert "f2": mise_en_demeure_du_debiteur(entity_ref("urn:fr:cc:obligations:prt:md"), entity_ref("urn:fr:cc:obligations:prt:c"), entity_ref("urn:fr:cc:obligations:prt:D")) { origin case_input; }
        assert "f3": mode_de_la_mise_en_demeure(entity_ref("urn:fr:cc:obligations:prt:md"), Sommation) { origin case_input; }
        assert "f4": date_de_la_mise_en_demeure(entity_ref("urn:fr:cc:obligations:prt:md"), @2025-02-03) { origin case_input; }
        assert "f5": perte_de_la_chose_due(entity_ref("urn:fr:cc:obligations:prt:c")) { origin case_input; }
        assert "f6": perte_se_serait_pareillement_produite(entity_ref("urn:fr:cc:obligations:prt:c")) { origin case_input; }
    }
    evaluate truth(cession_des_droits_attaches_a_la_chose(entity_ref("urn:fr:cc:obligations:prt:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PerteQuiSeSeraitPareillementProduite);
    expect applied(CessionDesDroitsAttachesALaChose);
}
