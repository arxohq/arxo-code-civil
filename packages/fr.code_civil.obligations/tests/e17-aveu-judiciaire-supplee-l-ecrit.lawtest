language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1361 : l'aveu judiciaire, autre membre de la liste fermée, supplée l'écrit sans
// condition supplémentaire.
test "urn:query:fr-code-civil-obligations-e17-aveu-judiciaire-supplee-l-ecrit" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": supplement_produit(entity_ref("urn:fr:cc:obligations:avj:a"), AveuJudiciaire) { origin case_input; }
    }
    evaluate truth(ecrit_supplee(entity_ref("urn:fr:cc:obligations:avj:a")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EcritSuppleeParAveuJudiciaire);
}
