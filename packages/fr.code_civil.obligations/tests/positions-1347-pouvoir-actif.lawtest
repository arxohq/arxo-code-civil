        assert "f6": obligation_certaine(entity_ref("urn:fr:cc:obl:cmp:c6")) { origin case_input; }
        assert "f7": obligation_liquide(entity_ref("urn:fr:cc:obl:cmp:c5")) { origin case_input; }
        assert "f8": obligation_liquide(entity_ref("urn:fr:cc:obl:cmp:c6")) { origin case_input; }
