language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1346-5-power-active" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": subrogation_de_la_creance(entity_ref("urn:fr:cc:obl:p2:s"), entity_ref("urn:fr:cc:obl:p2:c")) { origin case_input; }
        assert "f2": subroge(entity_ref("urn:fr:cc:obl:p2:s"), entity_ref("urn:fr:cc:obl:p2:p")) { origin case_input; }
        assert "f3": exception_a_opposer_au_subroge(entity_ref("urn:fr:cc:obl:p2:s"), entity_ref("urn:fr:cc:obl:p2:c")) { origin case_input; }
        assert "f4": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obl:p2:c"), entity_ref("urn:fr:cc:obl:p2:d")) { origin case_input; }
        assert "f5": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p2:c"), @2026-09-01) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionPouvoirOpposerExceptionSubrogation, ACTIVE);
}

test "urn:query:fr-code-civil-obligations-positions-1346-5-power-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": subrogation_de_la_creance(entity_ref("urn:fr:cc:obl:p2:s2"), entity_ref("urn:fr:cc:obl:p2:c2")) { origin case_input; }
        assert "f2": subroge(entity_ref("urn:fr:cc:obl:p2:s2"), entity_ref("urn:fr:cc:obl:p2:p2")) { origin case_input; }
        assert "f3": exception_a_opposer_au_subroge(entity_ref("urn:fr:cc:obl:p2:s2"), entity_ref("urn:fr:cc:obl:p2:c2")) { origin case_input; }
        assert "f4": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obl:p2:c2"), entity_ref("urn:fr:cc:obl:p2:d2")) { origin case_input; }
        assert "f5": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p2:c2"), @2026-09-10) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionPouvoirOpposerExceptionSubrogation, ACTIVE);
}
