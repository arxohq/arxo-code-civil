language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1307-2, canal §47.3 : l'impossibilité est constatée, mais la force majeure ne
// l'est pas. Sans réponse du juge, la libération n'est pas acquise et le cas porte
// une demande de jugement.
test "urn:query:fr-code-civil-obligations-m11-prestation-choisie-impossible-attend-le-juge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": espece_de_l_obligation_plurale(entity_ref("urn:fr:cc:obligations:atj:c"), Alternative) { origin case_input; }
        assert "f2": prestation_de_l_obligation(entity_ref("urn:fr:cc:obligations:atj:c"), entity_ref("urn:fr:cc:obligations:atj:p1")) { origin case_input; }
        assert "f3": prestation_choisie(entity_ref("urn:fr:cc:obligations:atj:c"), entity_ref("urn:fr:cc:obligations:atj:p1")) { origin case_input; }
        assert "f4": prestation_devenue_impossible(entity_ref("urn:fr:cc:obligations:atj:p1")) { origin case_input; }
    }
    evaluate truth(debiteur_libere_par_l_impossibilite_de_la_prestation_choisie(entity_ref("urn:fr:cc:obligations:atj:c")));
    expect truth_status == NEITHER;
    expect evaluation_status == REQUIRES_JUDGMENT;
    expect judgment_request(force_majeure_sur_la_prestation, Court);
}
