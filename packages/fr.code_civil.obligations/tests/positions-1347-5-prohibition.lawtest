language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1347-5-prohibition-active" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": prise_d_acte_sans_reserve_de_la_cession(entity_ref("urn:fr:cc:obl:p2:c"), entity_ref("urn:fr:cc:obl:p2:d")) { origin case_input; }
        assert "f2": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p2:c"), @2026-09-01) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionInterdictionOpposerLaCompensation, ACTIVE);
}

test "urn:query:fr-code-civil-obligations-positions-1347-5-prohibition-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": prise_d_acte_sans_reserve_de_la_cession(entity_ref("urn:fr:cc:obl:p2:c2"), entity_ref("urn:fr:cc:obl:p2:d2")) { origin case_input; }
        assert "f2": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p2:c2"), @2026-09-10) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionInterdictionOpposerLaCompensation, ACTIVE);
}

test "urn:query:fr-code-civil-obligations-positions-1347-5-prohibition-violated" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": prise_d_acte_sans_reserve_de_la_cession(entity_ref("urn:fr:cc:obl:p2:c3"), entity_ref("urn:fr:cc:obl:p2:d3")) { origin case_input; }
        assert "f2": date_d_exigibilite(entity_ref("urn:fr:cc:obl:p2:c3"), @2026-09-01) { origin case_input; }
        assert "f3": opposition_compensation_au_cessionnaire(entity_ref("urn:fr:cc:obl:p2:c3"), entity_ref("urn:fr:cc:obl:p2:d3")) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionInterdictionOpposerLaCompensation, VIOLATED);
}
