language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1346-3-preference-active" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": subrogation_de_la_creance(entity_ref("urn:fr:cc:obl:pref:s"), entity_ref("urn:fr:cc:obl:pref:c")) { origin case_input; }
        assert "f2": creancier_paye_en_partie_seulement(entity_ref("urn:fr:cc:obl:pref:s")) { origin case_input; }
        assert "f3": fr.code_civil.core::creancier(entity_ref("urn:fr:cc:obl:pref:c"), entity_ref("urn:fr:cc:obl:pref:cr")) { origin case_input; }
        assert "f4": subroge(entity_ref("urn:fr:cc:obl:pref:s"), entity_ref("urn:fr:cc:obl:pref:p")) { origin case_input; }
        assert "f5": date_d_exigibilite(entity_ref("urn:fr:cc:obl:pref:c"), @2026-09-01) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionLiberteExercerLaPreference, ACTIVE);
}
