language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1352-7-interest-bad-faith" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obl:p2:r"), entity_ref("urn:fr:cc:obl:p2:d"), entity_ref("urn:fr:cc:obl:p2:cr")) { origin case_input; }
        assert "f2": recu_de_mauvaise_foi(entity_ref("urn:fr:cc:obl:p2:r")) { origin case_input; }
        assert "f3": date_du_paiement_a_restituer(entity_ref("urn:fr:cc:obl:p2:r"), @2026-09-01) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionDevoirPayerLesInteretsDeRestitution, ACTIVE);
}

test "urn:query:fr-code-civil-obligations-positions-1352-7-interest-good-faith" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": restitution_due(entity_ref("urn:fr:cc:obl:p2:r2"), entity_ref("urn:fr:cc:obl:p2:d2"), entity_ref("urn:fr:cc:obl:p2:cr2")) { origin case_input; }
        assert "f2": recu_de_bonne_foi(entity_ref("urn:fr:cc:obl:p2:r2")) { origin case_input; }
        assert "f3": date_de_la_demande_en_restitution(entity_ref("urn:fr:cc:obl:p2:r2"), @2026-09-10) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionDevoirPayerLesInteretsDeRestitution, ACTIVE);
}
