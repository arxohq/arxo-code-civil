language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Loi n° 2018-287, article 16, I : l'article 1343-3, dans sa rédaction issue de la loi
// de ratification, n'est applicable qu'aux actes conclus ou établis À COMPTER du
// 1er octobre 2018. L'acte du 30 septembre 2018 y échappe : frontière déclarée.
test "urn:query:fr-code-civil-obligations-k03-article-1343-3-acte-du-30-septembre-2018" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": situation_de_la_creance(entity_ref("urn:fr:cc:obligations:k3:s"), entity_ref("urn:fr:cc:obligations:k3:c")) { origin case_input; }
        assert "f2": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc:obligations:k3:s"), @2018-09-30) { origin case_input; }
        assert "f3": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc:obligations:k3:s"), "1343-3") { origin case_input; }
    }
    evaluate truth(article_nouveau_de_2018_inapplicable(entity_ref("urn:fr:cc:obligations:k3:c"), "1343-3"));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ArticleNouveauDe2018Inapplicable);
}
