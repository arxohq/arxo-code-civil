language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1350-2, al. 1 : la remise de dette accordée au débiteur principal libère les
// cautions, MÊME SOLIDAIRES.
test "urn:query:fr-code-civil-obligations-c09-remise-au-debiteur-principal-libere-les-cautions" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": remise_consentie(entity_ref("urn:fr:cc:obligations:rem:r"), entity_ref("urn:fr:cc:obligations:rem:c"), entity_ref("urn:fr:cc:obligations:rem:D")) { origin case_input; }
        assert "f2": fr.code_civil.core::debiteur(entity_ref("urn:fr:cc:obligations:rem:c"), entity_ref("urn:fr:cc:obligations:rem:D")) { origin case_input; }
        assert "f3": caution_de_la_creance(entity_ref("urn:fr:cc:obligations:rem:c"), entity_ref("urn:fr:cc:obligations:rem:K")) { origin case_input; }
    }
    evaluate truth(cautions_liberees_par_la_remise(entity_ref("urn:fr:cc:obligations:rem:c"), entity_ref("urn:fr:cc:obligations:rem:K")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RemiseDeDetteLibereLeDebiteur);
    expect applied(RemiseAuDebiteurPrincipalLibereLesCautions);
}
