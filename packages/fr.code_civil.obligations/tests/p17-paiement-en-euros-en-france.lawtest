language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1343-3, première phrase : le paiement, en France, d'une obligation de somme
// d'argent s'effectue en euros — aucune des trois portes de sortie n'est ouverte.
test "urn:query:fr-code-civil-obligations-p17-paiement-en-euros-en-france" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": paiement_de_la_dette(entity_ref(":pay"), entity_ref("")) { origin case_input; }
        assert "f2": obligation_de_somme_d_argent(entity_ref("")) { origin case_input; }
        assert "f3": paiement_effectue_en_france(entity_ref(":pay")) { origin case_input; }
    }
    evaluate truth(paiement_en_euros(entity_ref(":pay")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PaiementEnEuros);
}
