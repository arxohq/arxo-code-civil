language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

// Art. 1360 : l'exception joue aussi S'IL EST D'USAGE de ne pas établir un écrit —
// cette branche-là ne demande aucune appréciation du juge.
test "urn:query:fr-code-civil-obligations-e14-usage-de-ne-pas-etablir-un-ecrit" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": somme_ou_valeur_de_l_acte(entity_ref("urn:fr:cc:obligations:usg:a"), 2000 EUR) { origin case_input; }
        assert "f2": seuil_de_la_preuve_par_ecrit(entity_ref("urn:fr:cc:obligations:usg:a"), 1500 EUR) { origin case_input; }
        assert "f3": usage_de_ne_pas_etablir_un_ecrit(entity_ref("urn:fr:cc:obligations:usg:a")) { origin case_input; }
    }
    evaluate truth(exception_a_l_exigence_d_ecrit(entity_ref("urn:fr:cc:obligations:usg:a")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ExceptionParUsage);
}
