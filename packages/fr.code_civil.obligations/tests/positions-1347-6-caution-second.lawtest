language "law.core" version "0.2";
package fr.code_civil.obligations version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-obligations";

test "urn:query:fr-code-civil-obligations-positions-1347-6-caution-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_OBLIGATIONS_CALENDRIER; }
        assert "f1": caution_opposant_la_compensation(entity_ref("urn:fr:cc:obl:caution:c2"), entity_ref("urn:fr:cc:obl:caution:k2")) { origin case_input; }
        assert "f2": date_d_exigibilite(entity_ref("urn:fr:cc:obl:caution:c2"), @2026-09-02) { origin case_input; }
    }
    evaluate positions();
    expect position(P2PositionPouvoirOpposerLaCompensationCaution, ACTIVE);
}
