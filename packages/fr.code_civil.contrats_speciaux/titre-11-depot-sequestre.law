@source(CC_ART1932) {
    rule RestitutionMemeChoseDeposee(d: Depot) strict {
        label fr official "Article 1932, alinéa 1. Le dépositaire rend identiquement la chose reçue";
        label en unofficial "Article 1932, paragraph 1. The depositary returns the very thing received";
        when meme_chose_restituee(d); then restitution_depot_conforme(d);
    }
    rule RestitutionMonnaieMemesEspeces(d: Depot, depot: Money, restitution: Money) strict {
        label fr official "Article 1932, alinéa 2. Le dépôt de monnaie est rendu dans les mêmes espèces, quelle que soit leur valeur";
        label en unofficial "Article 1932, paragraph 2. Money is returned in the same denominations regardless of value changes";
        when depot_monnaie(d, depot) and somme_restituee(d, restitution) and restitution == depot;
        then restitution_depot_conforme(d);
    }
}

@source(CC_ART1953) {
    rule HotelierResponsableSansLimiteChoseConfiee(d: Depot) strict {
        label fr official "Article 1953, alinéa 2. La responsabilité est illimitée pour les choses confiées à l'hôtelier";
        label en unofficial "Article 1953, paragraph 2. Liability is unlimited for things entrusted to the hotelkeeper";
        when depot_hotelier(d) and chose_confiee_a_hotelier(d); then responsabilite_hotelier_illimitee(d);
    }
    rule HotelierResponsableSansLimiteRefusInjustifie(d: Depot) defeasible {
        label fr official "Article 1953, alinéa 2. La responsabilité est illimitée pour les choses refusées sans motif légitime";
        label en unofficial "Article 1953, paragraph 2. Liability is unlimited for things refused without legitimate grounds";
        when depot_hotelier(d) and refus_reception(d); then responsabilite_hotelier_illimitee(d);
        unless motif_legitime_refus_hotelier(d);
    }
    rule PlafondHotelCentFoisPrixChambre(d: Depot, prix: Money) strict {
        label fr official "Article 1953, alinéa 3. Hors faute de l'hôtelier, l'indemnisation est plafonnée à cent fois le prix journalier";
        label en unofficial "Article 1953, paragraph 3. Absent hotelkeeper fault, compensation is capped at one hundred daily room rates";
        when depot_hotelier(d) and regime_hotelier_ordinaire(d) and prix_journalier_chambre(d, prix);
        then plafond_indemnisation_hotel(d, prix * 100);
    }
    rule FauteHotelierSansLimite(d: Depot) strict {
        label fr official "Article 1953, alinéa 3. La faute de l'hôtelier écarte le plafond";
        label en unofficial "Article 1953, paragraph 3. Hotelkeeper fault removes the cap";
        when depot_hotelier(d) and faute_hotelier(d); then responsabilite_hotelier_illimitee(d);
    }
}

@source(CC_ART1954) {
    rule ExonerationHotelForceMajeure(d: Depot) strict { label fr official "Article 1954, alinéa 1. La force majeure exonère l'hôtelier"; label en unofficial "Article 1954, paragraph 1. Force majeure exonerates the hotelkeeper"; when depot_hotelier(d) and force_majeure_etablie(d); then exoneration_hotelier(d); }
    rule ExonerationHotelViceChose(d: Depot) strict { label fr official "Article 1954, alinéa 1. Le vice de la chose exonère l'hôtelier"; label en unofficial "Article 1954, paragraph 1. A defect in the thing exonerates the hotelkeeper"; when depot_hotelier(d) and vice_de_la_chose_etabli(d); then exoneration_hotelier(d); }
    rule PlafondVehiculeCinquanteFoisPrixChambre(d: Depot, prix: Money) strict {
        label fr official "Article 1954, alinéa 2. Les objets dans un véhicule sont plafonnés à cinquante fois le prix journalier";
        label en unofficial "Article 1954, paragraph 2. Property in a parked vehicle is capped at fifty daily room rates";
        when depot_hotelier(d) and chose_dans_vehicule_stationne(d) and prix_journalier_chambre(d, prix); then plafond_indemnisation_hotel(d, prix * 50);
    }
}

@source(CC_ART1956)
rule SequestreConventionnelReconnu(d: Sequestre) strict { label fr official "Article 1956. Le séquestre conventionnel est un dépôt remis à un tiers"; label en unofficial "Article 1956. A contractual sequestration is a deposit entrusted to a third party"; when sequestre_conventionnel(d); then sequestre_reconnu(d); }

@source(CC_ART1961)
rule SequestreJudiciaireReconnu(d: Sequestre) strict { label fr official "Article 1961. La justice peut ordonner le séquestre"; label en unofficial "Article 1961. A court may order sequestration"; when sequestre_judiciaire(d); then sequestre_reconnu(d); }

@source(CC_ART1915)
rule DepotRecuPourGardeEtRestitution(d: Depot) strict {
    label fr official "Article 1915. Le dépôt reçoit la chose d'autrui à charge de la garder et de la restituer en nature";
    label en unofficial "Article 1915. A deposit receives another's thing for safekeeping and return in kind";
    when chose_autrui_recue(d) and charge_de_garder(d) and charge_de_restituer_en_nature(d);
    then depot_reconnu(d);
}

@source(CC_ART1916)
rule DepotProprementDitReconnu(d: Depot) strict { label fr official "Article 1916. Le dépôt proprement dit est une espèce de dépôt"; label en unofficial "Article 1916. An ordinary deposit is a form of deposit"; when depot_proprement_dit(d); then depot_reconnu(d); }

@source(CC_ART1916)
rule SequestreEstEspeceDepot(d: Sequestre) strict { label fr official "Article 1916. Le séquestre est une espèce de dépôt"; label en unofficial "Article 1916. Sequestration is a form of deposit"; when sequestre_conventionnel(d); then sequestre_reconnu(d); }

@source(CC_ART1917)
rule DepotProprementDitGratuit(d: Depot) strict { label fr official "Article 1917. Le dépôt proprement dit est essentiellement gratuit"; label en unofficial "Article 1917. An ordinary deposit is inherently gratuitous"; when depot_proprement_dit(d); then depot_gratuit_par_nature(d); }

@source(CC_ART1918)
rule DepotPorteSurChoseMobiliere(d: Depot) strict { label fr official "Article 1918. Seule une chose mobilière peut faire l'objet du dépôt proprement dit"; label en unofficial "Article 1918. Only movable property may be the object of an ordinary deposit"; when chose_deposee_mobiliere(d); then objet_depot_admissible(d); }

@source(CC_ART1918)
rule P3PouvoirDeposerChoseMobiliere(d: Depot, p: Personne) strict {
    label fr official "Article 1918. Seule une chose mobilière peut faire l'objet du dépôt proprement dit";
    label en unofficial "Article 1918. Only movable property may be the object of an ordinary deposit";
    when chose_deposee_mobiliere(d) and deposant(d, p);
    then power P3PositionPouvoirDeposerChoseMobiliere {
        holder p;
        over d;
        exercise depot_mobilier_exerce(d, p);
        effect depot_proprement_dit_constitue(d);
        valid_when objet_depot_admissible(d);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1919)
rule DepotParfaitParRemiseReelle(d: Depot) strict { label fr official "Article 1919. Le dépôt est parfait par la remise réelle"; label en unofficial "Article 1919. A deposit is perfected by actual delivery"; when remise_reelle_chose(d); then depot_parfait(d); }

@source(CC_ART1919)
rule DepotParfaitParRemiseFictive(d: Depot) strict { label fr official "Article 1919. La remise fictive suffit si le dépositaire détient déjà la chose"; label en unofficial "Article 1919. Constructive delivery suffices where the depositary already holds the thing"; when remise_fictive_chose_deja_detenue(d); then depot_parfait(d); }

@source(CC_ART1920)
rule DepotVolontaireReconnu(d: Depot) strict { label fr official "Article 1920. Le dépôt peut être volontaire"; label en unofficial "Article 1920. A deposit may be voluntary"; when depot_volontaire(d); then depot_reconnu(d); }

@source(CC_ART1920)
rule DepotNecessaireReconnu(d: Depot) strict { label fr official "Article 1920. Le dépôt peut être nécessaire"; label en unofficial "Article 1920. A deposit may be necessary"; when depot_necessaire(d); then depot_reconnu(d); }

@source(CC_ART1921)
rule DepotVolontaireParConsentement(d: Depot) strict { label fr official "Article 1921. Le consentement réciproque forme le dépôt volontaire"; label en unofficial "Article 1921. Mutual consent forms a voluntary deposit"; when consentement_reciproque_depot(d); then depot_volontaire_forme(d); }

@source(CC_ART1922)
rule DepotVolontaireParProprietaire(d: Depot) strict { label fr official "Article 1922. Le propriétaire peut régulièrement faire le dépôt volontaire"; label en unofficial "Article 1922. The owner may validly make a voluntary deposit"; when deposant_proprietaire(d); then depot_volontaire_regulier(d); }

@source(CC_ART1922)
rule P3PouvoirFaireDepotVolontaire(d: Depot, p: Personne) strict {
    label fr official "Article 1922. Le propriétaire peut régulièrement faire le dépôt volontaire";
    label en unofficial "Article 1922. The owner may validly make a voluntary deposit";
    when deposant_proprietaire(d) and deposant(d, p);
    then power P3PositionPouvoirFaireDepotVolontaire {
        holder p;
        over d;
        exercise depot_volontaire_exerce(d, p);
        effect depot_volontaire_regulier(d);
        valid_when deposant_proprietaire(d);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1922)
rule DepotVolontaireAvecConsentementProprietaire(d: Depot) strict { label fr official "Article 1922. Le consentement exprès ou tacite du propriétaire régularise le dépôt"; label en unofficial "Article 1922. The owner's express or tacit consent validates the deposit"; when consentement_proprietaire_depot(d); then depot_volontaire_regulier(d); }

@source(CC_ART1924)
rule DeclarationDepositaireFaitFoiSansEcrit(d: Depot) strict { label fr official "Article 1924. Sans preuve écrite au-dessus du seuil, la déclaration du dépositaire fait foi"; label en unofficial "Article 1924. Without writing above the threshold, the depositary's declaration prevails"; when depot_superieur_seuil_1359(d) and preuve_ecrite_depot_absente(d); then declaration_depositaire_fait_foi(d); }

@source(CC_ART1925)
rule DepotEntreCapablesRegulier(d: Depot) strict { label fr official "Article 1925. Le dépôt volontaire a régulièrement lieu entre personnes capables"; label en unofficial "Article 1925. A voluntary deposit is regularly made between capable persons"; when deposant_capable(d) and depositaire_capable(d); then depot_volontaire_regulier(d); }

@source(CC_ART1925)
rule DepositaireCapableObligeEnversDeposantIncapable(d: Depot) strict { label fr official "Article 1925. Le dépositaire capable assume toutes les obligations envers le déposant incapable"; label en unofficial "Article 1925. A capable depositary assumes all duties toward an incapable depositor"; when deposant_incapable(d) and depositaire_capable(d); then obligations_depositaire_veritable(d); }

@source(CC_ART1925)
rule P3DevoirDepositaireCapable(d: Depot, p: Personne, dep_: Personne) strict {
    label fr official "Article 1925. Le dépositaire capable assume toutes les obligations envers le déposant incapable";
    label en unofficial "Article 1925. A capable depositary assumes all duties toward an incapable depositor";
    when deposant_incapable(d) and depositaire_capable(d) and depositaire(d, p) and deposant(d, dep_);
    then duty P3PositionDevoirDepositaireCapable {
        bearer p;
        beneficiary dep_;
        goal achievement {
            condition obligations_depositaire_assumees(d, p);
            window [@2016-10-01, infinity];
        };
    };
}

@source(CC_ART1926)
rule RevendicationContreDepositaireIncapable(d: Depot) strict { label fr official "Article 1926. Le déposant capable conserve l'action en revendication contre le dépositaire incapable"; label en unofficial "Article 1926. A capable depositor retains a recovery claim against an incapable depositary"; when deposant_capable(d) and depositaire_incapable(d); then action_revendication_deposant(d); }

@source(CC_ART1926)
rule RestitutionProfitDepositaireIncapable(d: Depot, montant: Money) strict { label fr official "Article 1926. Le dépositaire incapable restitue ce qui a tourné à son profit"; label en unofficial "Article 1926. An incapable depositary restores the benefit received"; when profit_tire_par_depositaire_incapable(d, montant); then restitution_profit_due(d, montant); }

@source(CC_ART1927)
rule SoinDepotCommeChosesPersonnelles(d: Depot) strict { label fr official "Article 1927. Le dépositaire apporte les mêmes soins qu'à ses propres choses"; label en unofficial "Article 1927. The depositary takes the same care as with personal things"; when soin_identique_aux_choses_personnelles(d); then garde_depot_conforme(d); }

@source(CC_ART1928)
rule SoinRenforceDepositaireOffert(d: Depot) strict { label fr official "Article 1928, 1°. Le dépositaire qui s'est offert est tenu plus rigoureusement"; label en unofficial "Article 1928(1). A volunteer depositary is held to a stricter standard"; when depositaire_s_est_offert(d); then niveau_soin_renforce(d); }

@source(CC_ART1928)
rule SoinRenforceDepotRemunere(d: Depot) strict { label fr official "Article 1928, 2°. Le salaire de garde renforce le niveau de soin"; label en unofficial "Article 1928(2). Payment for safekeeping raises the standard of care"; when salaire_garde_stipule(d); then niveau_soin_renforce(d); }

@source(CC_ART1928)
rule SoinRenforceInteretDepositaire(d: Depot) strict { label fr official "Article 1928, 3°. Le dépôt dans le seul intérêt du dépositaire renforce le soin"; label en unofficial "Article 1928(3). A deposit solely for the depositary's benefit raises the standard of care"; when depot_dans_seul_interet_depositaire(d); then niveau_soin_renforce(d); }

@source(CC_ART1928)
rule SoinRenforceConventionTouteFaute(d: Depot) strict { label fr official "Article 1928, 4°. La convention de responsabilité pour toute faute renforce le soin"; label en unofficial "Article 1928(4). An all-fault agreement raises the standard of care"; when responsabilite_toute_faute_expresse(d); then niveau_soin_renforce(d); }

@source(CC_ART1929)
rule ForceMajeureExonereDepositaire(d: Depot) defeasible { label fr official "Article 1929. La force majeure exonère le dépositaire avant mise en demeure"; label en unofficial "Article 1929. Force majeure exonerates the depositary before formal notice"; when accident_force_majeure_depot(d); then exoneration_force_majeure_depositaire(d); unless mise_en_demeure_restituer_depot(d); }

@source(CC_ART1929)
rule MiseEnDemeureEcarteExoneration(d: Depot) strict { label fr official "Article 1929. Après mise en demeure de restituer, le dépositaire répond de la force majeure"; label en unofficial "Article 1929. After formal notice to return, the depositary is liable for force majeure"; when accident_force_majeure_depot(d) and mise_en_demeure_restituer_depot(d); then responsabilite_apres_mise_en_demeure(d); }

@source(CC_ART1930)
rule UsageDepotAvecPermission(d: Depot) strict { label fr official "Article 1930. Le dépositaire ne peut utiliser la chose qu'avec permission du déposant"; label en unofficial "Article 1930. The depositary may use the thing only with the depositor's permission"; when permission_usage_deposant(d); then usage_chose_deposee_autorise(d); }

@source(CC_ART1930)
rule P3InterdictionUsageDepotSansPermission(d: Depot, p: Personne) strict {
    label fr official "Article 1930. Le dépositaire ne peut utiliser la chose qu'avec permission du déposant";
    label en unofficial "Article 1930. The depositary may use the thing only with permission";
    when depositaire(d, p) and absence_permission_usage_deposant(d);
    then prohibition P3PositionInterdictionUsageDepotSansPermission {
        bearer p;
        action usage_chose_deposee_exerce(d, p);
        window [@2016-10-01, infinity];
    };
}

pub relation violation_usage_chose_deposee_sans_permission(d: Depot, p: Personne) kind derived {
    label fr official "usage de la chose déposée sans permission en violation de l'article 1930";
    label en unofficial "deposited thing used without permission in violation of Article 1930";
}
@source(CC_ART1930)
rule ViolationInterdictionUsageDepotSansPermission(d: Depot, p: Personne) strict {
    label fr official "usage de la chose déposée sans permission en violation de l'article 1930";
    label en unofficial "deposited thing used without permission in violation of Article 1930";
    when usage_chose_deposee_exerce(d, p);
    then violation_usage_chose_deposee_sans_permission(d, p);
}
@source(CC_ART1930)
rule P3MaintenanceInterdictionUsageDepotSansPermission(d: Depot, p: Personne) strict {
    label fr official "usage de la chose déposée sans permission en violation de l'article 1930";
    label en unofficial "deposited thing used without permission in violation of Article 1930";
    when depositaire(d, p) and absence_permission_usage_deposant(d);
    then duty P3PositionMaintenanceInterdictionUsageDepotSansPermission {
        bearer p;
        goal maintenance {
            condition not violation_usage_chose_deposee_sans_permission(d, p);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART1931)
rule ContenuFermeNeDoitPasEtreRecherche(d: Depot) strict { label fr official "Article 1931. Le dépositaire ne recherche pas le contenu d'un coffre fermé ou pli cacheté"; label en unofficial "Article 1931. The depositary must not inspect a closed box or sealed envelope"; when coffre_ferme_ou_enveloppe_cachetee(d); then recherche_contenu_interdite(d); }

@source(CC_ART1933)
rule DeteriorationNonImputableAChargeDeposant(d: Depot) strict { label fr official "Article 1933. La détérioration non imputable au dépositaire est à la charge du déposant"; label en unofficial "Article 1933. Deterioration not attributable to the depositary falls on the depositor"; when deterioration_non_imputable_depositaire(d); then deterioration_a_charge_deposant(d); }

@source(CC_ART1934)
rule ContrepartieForceMajeureAReconstituer(d: Depot, montant: Money) strict { label fr official "Article 1934. La contrepartie reçue après force majeure doit être restituée"; label en unofficial "Article 1934. Consideration received after force majeure must be returned"; when contrepartie_recue_apres_force_majeure(d, montant); then contrepartie_a_restituer(d, montant); }

@source(CC_ART1935)
rule HeritierBonneFoiRestituePrix(d: Depot, montant: Money) strict { label fr official "Article 1935. L'héritier vendeur de bonne foi restitue le prix reçu"; label en unofficial "Article 1935. A good-faith heir who sells the deposit returns the price received"; when heritier_depositaire_a_vendu_bonne_foi(d) and prix_vente_recu_par_heritier(d, montant); then prix_a_restituer_par_heritier(d, montant); }

@source(CC_ART1935)
rule HeritierBonneFoiCedeAction(d: Depot) strict { label fr official "Article 1935. À défaut de prix reçu, l'héritier cède son action contre l'acheteur"; label en unofficial "Article 1935. If no price was received, the heir assigns the claim against the buyer"; when heritier_depositaire_a_vendu_bonne_foi(d); then action_contre_acheteur_a_ceder(d); }

@source(CC_ART1936)
rule FruitsDepotAReconstituer(d: Depot, montant: Money) strict { label fr official "Article 1936. Les fruits perçus de la chose déposée doivent être restitués"; label en unofficial "Article 1936. Fruits received from the deposited thing must be returned"; when fruits_percus_depot(d, montant); then fruits_a_restituer(d, montant); }

@source(CC_ART1936)
rule P3DevoirRestituerFruitsDepot(d: Depot, p: Personne, dep_: Personne, montant: Money) strict {
    label fr official "Article 1936. Les fruits perçus de la chose déposée doivent être restitués";
    label en unofficial "Article 1936. Fruits received from the deposited thing must be returned";
    when fruits_percus_depot(d, montant) and depositaire(d, p) and deposant(d, dep_);
    then duty P3PositionDevoirRestituerFruitsDepot {
        bearer p;
        beneficiary dep_;
        goal achievement {
            condition restitution_fruits_exercee(d, p, montant);
            window [@2016-10-01, infinity];
        };
    };
}

@source(CC_ART1936)
rule InteretsDepotMonnaieApresMiseEnDemeure(d: Depot) strict { label fr official "Article 1936. L'argent déposé porte intérêt à compter de la mise en demeure de restituer"; label en unofficial "Article 1936. Deposited money bears interest from formal notice to return"; when depot_monnaie(d, _) and mise_en_demeure_restituer_depot(d); then interets_depot_monnaie_dus(d); }

@source(CC_ART1937)
rule RestitutionAuDestinataireDesigne(d: Depot) strict { label fr official "Article 1937. La restitution est faite au déposant, à son représenté ou au destinataire indiqué"; label en unofficial "Article 1937. Return is made to the depositor, represented person or designated recipient"; when destinataire_restitution_designe(d); then restitution_au_destinataire_autorisee(d); }

@source(CC_ART1938)
rule PreuveProprieteNonExigible(d: Depot) strict { label fr official "Article 1938. Le dépositaire ne peut exiger la preuve de propriété du déposant"; label en unofficial "Article 1938. The depositary may not require proof of the depositor's ownership"; when preuve_propriete_exigee_par_depositaire(d); then exigence_preuve_propriete_exclue(d); }

@source(CC_ART1938)
rule P3InterdictionExigerPreuvePropriete(d: Depot, p: Personne) strict {
    label fr official "Article 1938. Le dépositaire ne peut exiger la preuve de propriété du déposant";
    label en unofficial "Article 1938. The depositary may not require proof of ownership";
    when preuve_propriete_exigee_par_depositaire(d) and depositaire(d, p);
    then prohibition P3PositionInterdictionExigerPreuvePropriete {
        bearer p;
        action exigence_preuve_propriete_exercee(d, p);
        window [@2016-10-01, infinity];
    };
}

pub relation violation_exigence_preuve_propriete(d: Depot, p: Personne) kind derived {
    label fr official "preuve de propriété exigée en violation de l'article 1938";
    label en unofficial "ownership proof demanded in violation of Article 1938";
}
@source(CC_ART1938)
rule ViolationInterdictionExigerPreuvePropriete(d: Depot, p: Personne) strict {
    label fr official "preuve de propriété exigée en violation de l'article 1938";
    label en unofficial "ownership proof demanded in violation of Article 1938";
    when exigence_preuve_propriete_exercee(d, p);
    then violation_exigence_preuve_propriete(d, p);
}
@source(CC_ART1938)
rule P3MaintenanceInterdictionExigerPreuvePropriete(d: Depot, p: Personne) strict {
    label fr official "preuve de propriété exigée en violation de l'article 1938";
    label en unofficial "ownership proof demanded in violation of Article 1938";
    when preuve_propriete_exigee_par_depositaire(d) and depositaire(d, p);
    then duty P3PositionMaintenanceInterdictionExigerPreuvePropriete {
        bearer p;
        goal maintenance {
            condition not violation_exigence_preuve_propriete(d, p);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART1938)
rule RemiseDeposantDechargeApresDenonciation(d: Depot) strict { label fr official "Article 1938. Après dénonciation sans réclamation du propriétaire, la remise au déposant décharge le dépositaire"; label en unofficial "Article 1938. After notice and no owner claim, return to the depositor discharges the depositary"; when chose_deposee_volee(d) and veritable_proprietaire_identifie(d) and denonciation_depot_au_proprietaire(d) and proprietaire_n_a_pas_reclame_dans_delai(d); then remise_au_deposant_decharge_depositaire(d); }

@source(CC_ART1939)
rule RestitutionAuxHeritiersDeposant(d: Depot) strict { label fr official "Article 1939. Au décès du déposant, la restitution est faite à ses héritiers"; label en unofficial "Article 1939. On the depositor's death, return is made to the heirs"; when deces_deposant(d); then remise_aux_heritiers_requise(d); }

@source(CC_ART1939)
rule AccordHeritiersPourChoseIndivisible(d: Depot) strict { label fr official "Article 1939. Les héritiers s'accordent pour recevoir la chose indivisible"; label en unofficial "Article 1939. Heirs must agree to receive an indivisible thing"; when deces_deposant(d) and chose_deposee_indivisible(d); then accord_heritiers_requis(d); }

@source(CC_ART1940)
rule RestitutionAAdministrateurBiens(d: Depot) strict { label fr official "Article 1940. Le dépôt est restitué à l'administrateur des biens du déposant dessaisi"; label en unofficial "Article 1940. The deposit is returned to the administrator where the depositor loses administration powers"; when deposant_dessaisi_administration(d) and administrateur_biens_deposant_identifie(d); then restitution_a_administrateur_requise(d); }

@source(CC_ART1941)
rule RestitutionAuRepresenteApresGestion(d: Depot) strict { label fr official "Article 1941. À la fin de la gestion, le dépôt est restitué à la personne représentée"; label en unofficial "Article 1941. At the end of administration, the deposit is returned to the represented person"; when depot_fait_par_tuteur_ou_administrateur(d) and gestion_tuteur_terminee(d); then restitution_au_represente_requise(d); }

@source(CC_ART1942)
rule RestitutionAuLieuContractuel(d: Depot) strict { label fr official "Article 1942. Le dépositaire porte la chose au lieu de restitution désigné"; label en unofficial "Article 1942. The depositary carries the thing to the designated place of return"; when lieu_restitution_designe_contrat(d); then restitution_au_lieu_contractuel_requise(d); }

@source(CC_ART1942)
rule FraisTransportAChargeDeposant(d: Depot, montant: Money) strict { label fr official "Article 1942. Les frais de transport sont à la charge du déposant"; label en unofficial "Article 1942. Transport costs are borne by the depositor"; when frais_transport_restitution(d, montant); then frais_transport_a_charge_deposant(d, montant); }

@source(CC_ART1943)
rule RestitutionAuLieuDepotParDefaut(d: Depot) strict { label fr official "Article 1943. Sans lieu désigné, la restitution est faite au lieu du dépôt"; label en unofficial "Article 1943. Without a designated place, return occurs at the place of deposit"; when aucun_lieu_restitution_designe(d); then restitution_au_lieu_depot_requise(d); }

@source(CC_ART1944)
rule RestitutionImmediateSurReclamation(d: Depot) defeasible { label fr official "Article 1944. Le dépôt est remis aussitôt réclamé malgré le terme convenu"; label en unofficial "Article 1944. The deposit is returned immediately on demand despite an agreed term"; when reclamation_deposant(d); then restitution_immediate_requise(d); unless saisie_ou_opposition_restitution(d); }

@source(CC_ART1945)
rule DepositaireInfideleSansBeneficeCession(d: Depot) strict { label fr official "Article 1945. Le dépositaire infidèle n'a pas le bénéfice de cession"; label en unofficial "Article 1945. An unfaithful depositary has no benefit of assignment"; when depositaire_infidele(d); then benefice_cession_exclu(d); }

@source(CC_ART1946)
rule ProprietaireDepositaireMetFinObligations(d: Depot) strict { label fr official "Article 1946. Les obligations cessent si le dépositaire prouve être propriétaire"; label en unofficial "Article 1946. Duties end if the depositary proves ownership"; when depositaire_prouve_proprietaire(d); then obligations_depositaire_cessent(d); }

@source(CC_ART1946)
rule P3PouvoirProuverProprieteDepositaire(d: Depot, p: Personne) strict {
    label fr official "Article 1946. Les obligations cessent si le dépositaire prouve être propriétaire";
    label en unofficial "Article 1946. Duties cease if the depositary proves ownership";
    when depositaire_prouve_proprietaire(d) and depositaire(d, p);
    then power P3PositionPouvoirProuverProprieteDepositaire {
        holder p;
        over d;
        exercise preuve_propriete_exercee(d, p);
        effect obligations_depositaire_cessent(d);
        valid_when depositaire_prouve_proprietaire(d);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1947)
rule RemboursementDepensesConservationDepot(d: Depot, montant: Money) strict { label fr official "Article 1947. Le déposant rembourse les dépenses de conservation"; label en unofficial "Article 1947. The depositor reimburses preservation expenses"; when depenses_conservation_depot(d, montant); then remboursement_depenses_depot_du(d, montant); }

@source(CC_ART1947)
rule IndemnisationPertesCauseesParDepot(d: Depot, montant: Money) strict { label fr official "Article 1947. Le déposant indemnise les pertes occasionnées par le dépôt"; label en unofficial "Article 1947. The depositor indemnifies losses caused by the deposit"; when pertes_causees_par_depot(d, montant); then indemnisation_pertes_depot_due(d, montant); }

@source(CC_ART1948)
rule RetentionJusquAuPaiement(d: Depot) strict { label fr official "Article 1948. Le dépositaire peut retenir jusqu'au paiement intégral"; label en unofficial "Article 1948. The depositary may retain until full payment"; when sommes_dues_au_depositaire_non_payees(d); then droit_retention_depot(d); }

@source(CC_ART1948)
rule P3PouvoirRetenirDepot(d: Depot, p: Personne) strict {
    label fr official "Article 1948. Le dépositaire peut retenir jusqu'au paiement intégral";
    label en unofficial "Article 1948. The depositary may retain until full payment";
    when sommes_dues_au_depositaire_non_payees(d) and depositaire(d, p);
    then power P3PositionPouvoirRetenirDepot {
        holder p;
        over d;
        exercise retention_depot_exercee(d, p);
        effect droit_retention_depot(d);
        valid_when sommes_dues_au_depositaire_non_payees(d);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1949)
rule DepotNecessaireParAccidentImprevu(d: Depot) strict { label fr official "Article 1949. L'accident imprévu qui force le dépôt le qualifie de nécessaire"; label en unofficial "Article 1949. An unforeseen accident forcing the deposit makes it necessary"; when accident_imprevu_force_depot(d); then qualification_depot_necessaire(d); }

@source(CC_ART1950)
rule PreuveTemoinsDepotNecessaire(d: Depot) strict { label fr official "Article 1950. La preuve testimoniale du dépôt nécessaire est admise même au-dessus du seuil"; label en unofficial "Article 1950. Witness evidence of a necessary deposit is admitted even above the threshold"; when depot_necessaire(d); then preuve_testimoniale_depot_necessaire_admise(d); }

@source(CC_ART1951)
rule ReglesOrdinairesAuDepotNecessaire(d: Depot) strict { label fr official "Article 1951. Les règles du dépôt ordinaire régissent le dépôt nécessaire"; label en unofficial "Article 1951. Ordinary deposit rules govern a necessary deposit"; when depot_necessaire(d); then regles_depot_ordinaire_applicables(d); }

@source(CC_ART1952)
rule DepotHotelierEstNecessaire(d: Depot) strict { label fr official "Article 1952. Les effets apportés par le voyageur logé constituent un dépôt nécessaire"; label en unofficial "Article 1952. Property brought by a lodging traveller constitutes a necessary deposit"; when depot_hotelier(d) and voyageur_loge_hotel(d) and effets_apportes_hotel(d); then qualification_depot_hotelier_necessaire(d); }

@source(CC_ART1955)
rule SequestreConventionnelOuJudiciaire(d: Sequestre) strict { label fr official "Article 1955. Le séquestre conventionnel est reconnu comme séquestre"; label en unofficial "Article 1955. Contractual sequestration is recognised as sequestration"; when sequestre_conventionnel(d); then sequestre_reconnu(d); }

@source(CC_ART1957)
rule SequestrePeutEtreRemunere(d: Sequestre) strict { label fr official "Article 1957. Le séquestre peut ne pas être gratuit"; label en unofficial "Article 1957. Sequestration may be remunerated"; when sequestre_non_gratuit(d); then remuneration_sequestre_admise(d); }

@source(CC_ART1957)
rule P3PouvoirRemunererSequestre(d: Sequestre, p: Personne) strict {
    label fr official "Article 1957. Le séquestre peut ne pas être gratuit";
    label en unofficial "Article 1957. Sequestration may be remunerated";
    when sequestre_non_gratuit(d) and sequestre_gardien(d, p);
    then power P3PositionPouvoirRemunererSequestre {
        holder p;
        over d;
        exercise remuneration_sequestre_exercee(d, p);
        effect remuneration_sequestre_admise(d);
        valid_when sequestre_non_gratuit(d);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1958)
rule SequestreGratuitSoumisReglesDepot(d: Sequestre) strict { label fr official "Article 1958. Le séquestre gratuit est soumis aux règles du dépôt proprement dit"; label en unofficial "Article 1958. Gratuitous sequestration is governed by ordinary deposit rules"; when sequestre_gratuit(d); then regles_depot_applicables_sequestre(d); }

@source(CC_ART1959)
rule SequestreObjetMobilier(d: Sequestre) strict { label fr official "Article 1959. Un meuble peut faire l'objet du séquestre"; label en unofficial "Article 1959. Movable property may be sequestered"; when objet_sequestre_mobilier(d); then objet_sequestre_admissible(d); }

@source(CC_ART1959)
rule P3PouvoirSequestrerMeuble(d: Sequestre, p: Personne) strict {
    label fr official "Article 1959. Un meuble peut faire l'objet du séquestre";
    label en unofficial "Article 1959. Movable property may be sequestered";
    when objet_sequestre_mobilier(d) and sequestre_gardien(d, p);
    then power P3PositionPouvoirSequestrerMeuble {
        holder p;
        over d;
        exercise sequestre_mobilier_exerce(d, p);
        effect objet_sequestre_admissible(d);
        valid_when objet_sequestre_mobilier(d);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1959)
rule SequestreObjetImmobilier(d: Sequestre) strict { label fr official "Article 1959. Un immeuble peut faire l'objet du séquestre"; label en unofficial "Article 1959. Immovable property may be sequestered"; when objet_sequestre_immobilier(d); then objet_sequestre_admissible(d); }

@source(CC_ART1959)
rule P3PouvoirSequestrerImmeuble(d: Sequestre, p: Personne) strict {
    label fr official "Article 1959. Un immeuble peut faire l'objet du séquestre";
    label en unofficial "Article 1959. Immovable property may be sequestered";
    when objet_sequestre_immobilier(d) and sequestre_gardien(d, p);
    then power P3PositionPouvoirSequestrerImmeuble {
        holder p;
        over d;
        exercise sequestre_immobilier_exerce(d, p);
        effect objet_sequestre_admissible(d);
        valid_when objet_sequestre_immobilier(d);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1960)
rule DechargeSequestreApresContestation(d: Sequestre) strict { label fr official "Article 1960. Le séquestre peut être déchargé après la fin de la contestation"; label en unofficial "Article 1960. The sequestrator may be discharged after the dispute ends"; when contestation_sequestre_terminee(d); then decharge_sequestre_autorisee(d); }

@source(CC_ART1960)
rule DechargeSequestreParConsentement(d: Sequestre) strict { label fr official "Article 1960. Le consentement de toutes les parties autorise la décharge anticipée"; label en unofficial "Article 1960. Consent of all parties permits early discharge"; when consentement_toutes_parties_decharge(d); then decharge_sequestre_autorisee(d); }

@source(CC_ART1960)
rule DechargeSequestrePourCauseLegitime(d: Sequestre) strict { label fr official "Article 1960. Une cause jugée légitime autorise la décharge anticipée"; label en unofficial "Article 1960. A judicially accepted legitimate cause permits early discharge"; when cause_legitime_decharge_sequestre(d); then decharge_sequestre_autorisee(d); }

@source(CC_ART1962)
rule ObligationsGardienJudiciaire(d: Sequestre) strict { label fr official "Article 1962. Le gardien conserve et représente les effets, et le saisissant paie son salaire"; label en unofficial "Article 1962. The custodian preserves and presents the property, and the seizing party pays remuneration"; when gardien_judiciaire(d) and conservation_effets_saisis_raisonnable(d) and representation_effets_saisis_conforme(d) and salaire_gardien_paye(d); then obligations_gardien_judiciaire_accomplies(d); }

@source(CC_ART1963)
rule SequestreJudiciaireSoumisObligationsConventionnelles(d: Sequestre) strict { label fr official "Article 1963. Le séquestre judiciaire nommé par les parties ou le juge assume les obligations conventionnelles"; label en unofficial "Article 1963. A judicial sequestrator appointed by parties or court assumes contractual sequestration duties"; when sequestre_judiciaire(d) and sequestre_nomme_par_parties_ou_juge(d); then obligations_sequestre_conventionnel_applicables(d); }
