// BEGIN GENERATED FRAGMENTS

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1832")
pub fragment CC_ART1832 in CC_COURANT {
    label fr official "Article 1832";
    kind article;
    locator "article/1832";
    text fr official """Article 1832
La société est instituée par deux ou plusieurs personnes qui conviennent par un contrat d'affecter à une entreprise commune des biens ou leur industrie en vue de partager le bénéfice ou de profiter de l'économie qui pourra en résulter.
Elle peut être instituée, dans les cas prévus par la loi, par l'acte de volonté d'une seule personne.
Les associés s'engagent à contribuer aux pertes.
""";
    content_hash "sha256:f6ebf18e8db43da0b5c745c6df187c1efc72ee2a11ffad679f3324b929be4d42";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1832_1")
pub fragment CC_ART1832_1 in CC_COURANT {
    label fr official "Article 1832-1";
    kind article;
    locator "article/1832-1";
    text fr official """Article 1832-1
Même s'ils n'emploient que des biens de communauté pour les apports à une société ou pour l'acquisition de parts sociales, deux époux seuls ou avec d'autres personnes peuvent être associés dans une même société et participer ensemble ou non à la gestion sociale.
Les avantages et libéralités résultant d'un contrat de société entre époux ne peuvent être annulés parce qu'ils constitueraient des donations déguisées, lorsque les conditions en ont été réglées par un acte authentique.
""";
    content_hash "sha256:30031118057966b35cc29fbef9b1c1330bec30a82eff7521854c58ae21cc877d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1832_2")
pub fragment CC_ART1832_2 in CC_COURANT {
    label fr official "Article 1832-2";
    kind article;
    locator "article/1832-2";
    text fr official """Article 1832-2
Un époux ne peut, sous la sanction prévue à l'article 1427, employer des biens communs pour faire un apport à une société ou acquérir des parts sociales non négociables sans que son conjoint en ait été averti et sans qu'il en soit justifié dans l'acte.
La qualité d'associé est reconnue à celui des époux qui fait l'apport ou réalise l'acquisition.
La qualité d'associé est également reconnue, pour la moitié des parts souscrites ou acquises, au conjoint qui a notifié à la société son intention d'être personnellement associé. Lorsqu'il notifie son intention lors de l'apport ou de l'acquisition, l'acceptation ou l'agrément des associés vaut pour les deux époux. Si cette notification est postérieure à l'apport ou à l'acquisition, les clauses d'agrément prévues à cet effet par les statuts sont opposables au conjoint ; lors de la délibération sur l'agrément, l'époux associé ne participe pas au vote et ses parts ne sont pas prises en compte pour le calcul du quorum et de la majorité.
Les dispositions du présent article ne sont applicables que dans les sociétés dont les parts ne sont pas négociables et seulement jusqu'à la dissolution de la communauté.
""";
    content_hash "sha256:48fb49707ff33b13bff9c796452ebb363127bd09c2430daf24e1c38af4381fd9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1833")
pub fragment CC_ART1833 in CC_COURANT {
    label fr official "Article 1833";
    kind article;
    locator "article/1833";
    text fr official """Article 1833
Toute société doit avoir un objet licite et être constituée dans l'intérêt commun des associés.
La société est gérée dans son intérêt social, en prenant en considération les enjeux sociaux et environnementaux de son activité.
""";
    content_hash "sha256:ecc1cf69a6b686201f945eabf1f6e762966398ad83a631090bb98f161092a598";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1834")
pub fragment CC_ART1834 in CC_COURANT {
    label fr official "Article 1834";
    kind article;
    locator "article/1834";
    text fr official """Article 1834
Les dispositions du présent chapitre sont applicables à toutes les sociétés s'il n'en est autrement disposé par la loi en raison de leur forme ou de leur objet.
""";
    content_hash "sha256:63703d6ef520271af0dfaf2205680ec8f336d6a47dbdbbffc21c5af5e5590723";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1835")
pub fragment CC_ART1835 in CC_COURANT {
    label fr official "Article 1835";
    kind article;
    locator "article/1835";
    text fr official """Article 1835
Les statuts doivent être établis par écrit. Ils déterminent, outre les apports de chaque associé, la forme, l'objet, l'appellation, le siège social, le capital social, la durée de la société et les modalités de son fonctionnement. Les statuts peuvent préciser une raison d'être, constituée des principes dont la société se dote et pour le respect desquels elle entend affecter des moyens dans la réalisation de son activité.
""";
    content_hash "sha256:121bb805a36a52fbc6ca3bf19738469df3ed70f568399b6673eb7cc12f7d9111";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1836")
pub fragment CC_ART1836 in CC_COURANT {
    label fr official "Article 1836";
    kind article;
    locator "article/1836";
    text fr official """Article 1836
Les statuts ne peuvent être modifiés, à défaut de clause contraire, que par accord unanime des associés.
En aucun cas, les engagements d'un associé ne peuvent être augmentés sans le consentement de celui-ci.
""";
    content_hash "sha256:266ed57dd1d585279605394149a756bd2feeb0e21297750b882c0a6e93fab8cf";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1837")
pub fragment CC_ART1837 in CC_COURANT {
    label fr official "Article 1837";
    kind article;
    locator "article/1837";
    text fr official """Article 1837
Toute société dont le siège est situé sur le territoire français est soumise aux dispositions de la loi française.
Les tiers peuvent se prévaloir du siège statutaire, mais celui-ci ne leur est pas opposable par la société si le siège réel est situé en un autre lieu.
""";
    content_hash "sha256:5d89e7b6c72c0ad94de6b114e5dd762d3d35f87957163c4c0719c30543205110";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1838")
pub fragment CC_ART1838 in CC_COURANT {
    label fr official "Article 1838";
    kind article;
    locator "article/1838";
    text fr official """Article 1838
La durée de la société ne peut excéder quatre-vingt-dix-neuf ans.
""";
    content_hash "sha256:6e2246d26edf0919c0644848e7af9d1dbc6e37ef42fc4746ea86d5f499c32933";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1839")
pub fragment CC_ART1839 in CC_COURANT {
    label fr official "Article 1839";
    kind article;
    locator "article/1839";
    text fr official """Article 1839
Si les statuts ne contiennent pas toutes les énonciations exigées par la législation ou si une formalité prescrite par celle-ci a été omise ou irrégulièrement accomplie, tout intéressé est recevable à demander en justice que soit ordonnée, sous astreinte, la régularisation de la constitution. Le ministère public peut agir aux mêmes fins.
Les mêmes règles sont applicables en cas de modification des statuts.
L'action aux fins de régularisation prévue à l'alinéa premier se prescrit par trois ans à compter de l'immatriculation de la société ou de la publication de l'acte modifiant les statuts.
""";
    content_hash "sha256:ce2d31f1e136f588f13f56b64ceef11f9cf7fa43dc6db822af2ed2ea40646cd3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1840")
pub fragment CC_ART1840 in CC_COURANT {
    label fr official "Article 1840";
    kind article;
    locator "article/1840";
    text fr official """Article 1840
Les fondateurs, ainsi que les premiers membres des organes de gestion, de direction ou d'administration sont solidairement responsables du préjudice causé soit par le défaut d'une mention obligatoire dans les statuts, soit par l'omission ou l'accomplissement irrégulier d'une formalité prescrite pour la constitution de la société.
En cas de modification des statuts, les dispositions de l'alinéa précédent sont applicables aux membres des organes de gestion, de direction ou d'administration alors en fonction.
L'action se prescrira par dix ans à compter du jour où l'une ou l'autre, selon le cas, des formalités visées à l'alinéa 3 de l'article 1839 aura été accomplie.
""";
    content_hash "sha256:5649c13f6dd88dd2fa47ac2d46f1e29fbef9d5eec7ff072cfafcef663f88828d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1842")
pub fragment CC_ART1842 in CC_COURANT {
    label fr official "Article 1842";
    kind article;
    locator "article/1842";
    text fr official """Article 1842
Les sociétés autres que les sociétés en participation visées au chapitre III et que les sociétés de libre partenariat spéciales mentionnées à l'article L. 214-162-13 du code monétaire et financier jouissent de la personnalité morale à compter de leur immatriculation.
Jusqu'à l'immatriculation, les rapports entre les associés sont régis par le contrat de société et par les principes généraux du droit applicable aux contrats et obligations.
""";
    content_hash "sha256:4beeb69a8f77d08b95552cf5a25817d2c7e882ccb2e4577e7d238749b6d3bebc";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1843")
pub fragment CC_ART1843 in CC_COURANT {
    label fr official "Article 1843";
    kind article;
    locator "article/1843";
    text fr official """Article 1843
Les personnes qui ont agi au nom d'une société en formation avant l'immatriculation sont tenues des obligations nées des actes ainsi accomplis, avec solidarité si la société est commerciale, sans solidarité dans les autres cas. La société régulièrement immatriculée peut reprendre les engagements souscrits, qui sont alors réputés avoir été dès l'origine contractés par celle-ci.
""";
    content_hash "sha256:a6f523c0cfcbea06989cfe637742a9d26f138bbb63c0c26527040b0aaea0b1ef";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1843_1")
pub fragment CC_ART1843_1 in CC_COURANT {
    label fr official "Article 1843-1";
    kind article;
    locator "article/1843-1";
    text fr official """Article 1843-1
L'apport d'un bien ou d'un droit soumis à publicité pour son opposabilité aux tiers peut être publié dès avant l'immatriculation et sous la condition que celle-ci intervienne. A compter de celle-ci, les effets de la formalité rétroagissent à la date de son accomplissement.
""";
    content_hash "sha256:c294c161672ac069e6e68be0a51ccabc06319f6970eaeb2baacdbe1c95571a90";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1843_2")
pub fragment CC_ART1843_2 in CC_COURANT {
    label fr official "Article 1843-2";
    kind article;
    locator "article/1843-2";
    text fr official """Article 1843-2
Les droits de chaque associé dans le capital social sont proportionnels à ses apports lors de la constitution de la société ou au cours de l'existence de celle-ci.
Les apports en industrie ne concourent pas à la formation du capital social mais donnent lieu à l'attribution de parts ouvrant droit au partage des bénéfices et de l'actif net, à charge de contribuer aux pertes.
""";
    content_hash "sha256:7a9e3cf71b167bede1cd4de789eea7fd3fbafbf6ce0fd1f717b23b17459d5095";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1843_3")
pub fragment CC_ART1843_3 in CC_COURANT {
    label fr official "Article 1843-3";
    kind article;
    locator "article/1843-3";
    text fr official """Article 1843-3
Chaque associé est débiteur envers la société de tout ce qu'il a promis de lui apporter en nature, en numéraire ou en industrie.
Les apports en nature sont réalisés par le transfert des droits correspondants et par la mise à la disposition effective des biens.
Lorsque l'apport est en propriété, l'apporteur est garant envers la société comme un vendeur envers son acheteur.
Lorsqu'il est en jouissance, l'apporteur est garant envers la société comme un bailleur envers son preneur. Toutefois, lorsque l'apport en jouissance porte sur des choses de genre ou sur tous autres biens normalement appelés à être renouvelés pendant la durée de la société, le contrat transfère à celle-ci la propriété des biens apportés, à charge d'en rendre une pareille quantité, qualité et valeur ; dans ce cas, l'apporteur est garant dans les conditions prévues à l'alinéa précédent.
L'associé qui devait apporter une somme dans la société et qui ne l'a point fait devient de plein droit et sans demande, débiteur des intérêts de cette somme à compter du jour où elle devait être payée et ce sans préjudice de plus amples dommages-intérêts, s'il y a lieu. En outre, lorsqu'il n'a pas été procédé dans un délai légal aux appels de fonds pour réaliser la libération intégrale du capital, tout intéressé peut demander au président du tribunal statuant en référé soit d'enjoindre sous astreinte aux administrateurs, gérants et dirigeants de procéder à ces appels de fonds, soit de désigner un mandataire chargé de procéder à cette formalité.
L'associé qui s'est obligé à apporter son industrie à la société lui doit compte de tous les gains qu'il a réalisés par l'activité faisant l'objet de son apport.
""";
    content_hash "sha256:5159418985ef6dbff22755186041fe3e40011cbe9c879af262fbf8312caeb9d1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1843_4")
pub fragment CC_ART1843_4 in CC_COURANT {
    label fr official "Article 1843-4";
    kind article;
    locator "article/1843-4";
    text fr official """Article 1843-4
I. – Dans les cas où la loi renvoie au présent article pour fixer les conditions de prix d'une cession des droits sociaux d'un associé, ou le rachat de ceux-ci par la société, la valeur de ces droits est déterminée, en cas de contestation, par un expert désigné, soit par les parties, soit à défaut d'accord entre elles, par jugement du président du tribunal judiciaire ou du tribunal de commerce compétent, statuant selon la procédure accélérée au fond et sans recours possible.
L'expert ainsi désigné est tenu d'appliquer, lorsqu'elles existent, les règles et modalités de détermination de la valeur prévues par les statuts de la société ou par toute convention liant les parties.
II. – Dans les cas où les statuts prévoient la cession des droits sociaux d'un associé ou le rachat de ces droits par la société sans que leur valeur soit ni déterminée ni déterminable, celle-ci est déterminée, en cas de contestation, par un expert désigné dans les conditions du premier alinéa.
L'expert ainsi désigné est tenu d'appliquer, lorsqu'elles existent, les règles et modalités de détermination de la valeur prévues par toute convention liant les parties.
""";
    content_hash "sha256:5becce0ab409170ed87605e22a579a804ee786daa9770f97aa9b118e98ea786f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1843_5")
pub fragment CC_ART1843_5 in CC_COURANT {
    label fr official "Article 1843-5";
    kind article;
    locator "article/1843-5";
    text fr official """Article 1843-5
Outre l'action en réparation du préjudice subi personnellement, un ou plusieurs associés peuvent intenter l'action sociale en responsabilité contre les gérants. Les demandeurs sont habilités à poursuivre la réparation du préjudice subi par la société ; en cas de condamnation, les dommages-intérêts sont alloués à la société.
Est réputée non écrite toute clause des statuts ayant pour effet de subordonner l'exercice de l'action sociale à l'avis préalable ou à l'autorisation de l'assemblée ou qui comporterait par avance renonciation à l'exercice de cette action.
Aucune décision de l'assemblée des associés ne peut avoir pour effet d'éteindre une action en responsabilité contre les gérants pour la faute commise dans l'accomplissement de leur mandat.
""";
    content_hash "sha256:0c6d0f8612fb42140730ef013001875ace16adc103b5ebf3102af41d9ee4c649";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844")
pub fragment CC_ART1844 in CC_COURANT {
    label fr official "Article 1844";
    kind article;
    locator "article/1844";
    text fr official """Article 1844
Tout associé a le droit de participer aux décisions collectives.
Les copropriétaires d'une part sociale indivise sont représentés par un mandataire unique, choisi parmi les indivisaires ou en dehors d'eux. En cas de désaccord, le mandataire sera désigné en justice à la demande du plus diligent.
Si une part est grevée d'un usufruit, le nu-propriétaire et l'usufruitier ont le droit de participer aux décisions collectives. Le droit de vote appartient au nu-propriétaire, sauf pour les décisions concernant l'affectation des bénéfices, où il est réservé à l'usufruitier. Toutefois, pour les autres décisions, le nu-propriétaire et l'usufruitier peuvent convenir que le droit de vote sera exercé par l'usufruitier.
Les statuts peuvent déroger aux dispositions du deuxième alinéa et de la seconde phrase du troisième alinéa.
""";
    content_hash "sha256:3a96da6339157e0d11bed66772716438b50e84dce8c6a6bc1fddb07378fa3403";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_1")
pub fragment CC_ART1844_1 in CC_COURANT {
    label fr official "Article 1844-1";
    kind article;
    locator "article/1844-1";
    text fr official """Article 1844-1
La part de chaque associé dans les bénéfices et sa contribution aux pertes se déterminent à proportion de sa part dans le capital social et la part de l'associé qui n'a apporté que son industrie est égale à celle de l'associé qui a le moins apporté, le tout sauf clause contraire.
Toutefois, la stipulation attribuant à un associé la totalité du profit procuré par la société ou l'exonérant de la totalité des pertes, celle excluant un associé totalement du profit ou mettant à sa charge la totalité des pertes sont réputées non écrites.
""";
    content_hash "sha256:2ea17ee20ebd3b27a91abd4623a88aa8d5826c3034f7aeaa1158f5ca0b077ba4";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_3")
pub fragment CC_ART1844_3 in CC_COURANT {
    label fr official "Article 1844-3";
    kind article;
    locator "article/1844-3";
    text fr official """Article 1844-3
La transformation régulière d'une société en une société d'une autre forme n'entraîne pas la création d'une personne morale nouvelle. Il en est de même de la prorogation ou de toute autre modification statutaire.
""";
    content_hash "sha256:65e7fc7d1330fd9e0cbcf49ee6fd110d0a6ad1090a9ed9b19d5551e8aa97728f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_4")
pub fragment CC_ART1844_4 in CC_COURANT {
    label fr official "Article 1844-4";
    kind article;
    locator "article/1844-4";
    text fr official """Article 1844-4
Une société, même en liquidation, peut être absorbée par une autre société ou participer à la constitution d'une société nouvelle, par voie de fusion.
Elle peut aussi transmettre son patrimoine par voie de scission à des sociétés existantes ou à des sociétés nouvelles.
Ces opérations peuvent intervenir entre des sociétés de forme différente.
Elles sont décidées, par chacune des sociétés intéressées, dans les conditions requises pour la modification de ses statuts.
Si l'opération comporte la création de sociétés nouvelles, chacune de celles-ci est constituée selon les règles propres à la forme de société adoptée.
""";
    content_hash "sha256:9ee2735d1bdc2aa8c9ee38fbed4d3dc02ca3d35d4ee653e47133ea82a5652a8e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_5")
pub fragment CC_ART1844_5 in CC_COURANT {
    label fr official "Article 1844-5";
    kind article;
    locator "article/1844-5";
    text fr official """Article 1844-5
La réunion de toutes les parts sociales en une seule main n'entraîne pas la dissolution de plein droit de la société. Tout intéressé peut demander cette dissolution si la situation n'a pas été régularisée dans le délai d'un an. Le tribunal peut accorder à la société un délai maximal de six mois pour régulariser la situation. Il ne peut prononcer la dissolution si, au jour où il statue sur le fond, cette régularisation a eu lieu.
L'appartenance de l'usufruit de toutes les parts sociales à la même personne est sans conséquence sur l'existence de la société.
En cas de dissolution, celle-ci entraîne la transmission universelle du patrimoine de la société à l'associé unique, sans qu'il y ait lieu à liquidation. Les créanciers peuvent faire opposition à la dissolution dans le délai de trente jours à compter de la publication de celle-ci. Une décision de justice rejette l'opposition ou ordonne soit le remboursement des créances, soit la constitution de garanties si la société en offre et si elles sont jugées suffisantes. La transmission du patrimoine n'est réalisée et il n'y a disparition de la personne morale qu'à l'issue du délai d'opposition ou, le cas échéant, lorsque l'opposition a été rejetée en première instance ou que le remboursement des créances a été effectué ou les garanties constituées.
Les dispositions du troisième alinéa ne sont pas applicables aux sociétés dont l'associé unique est une personne physique.
""";
    content_hash "sha256:5b473761a34cc31fa69a420ead9c1712ed5fdbe93a8c4078a502dadd342f729a";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_6")
pub fragment CC_ART1844_6 in CC_COURANT {
    label fr official "Article 1844-6";
    kind article;
    locator "article/1844-6";
    text fr official """Article 1844-6
La prorogation de la société est décidée à l'unanimité des associés, ou, si les statuts le prévoient, à la majorité prévue pour la modification de ceux-ci.
Un an au moins avant la date d'expiration de la société, les associés doivent être consultés à l'effet de décider si la société doit être prorogée.
A défaut, tout associé peut demander au président du tribunal, statuant sur requête, la désignation d'un mandataire de justice chargé de provoquer la consultation prévue au deuxième alinéa.
Lorsque la consultation n'a pas eu lieu, le président du tribunal, statuant sur requête à la demande de tout associé dans l'année suivant la date d'expiration de la société, peut constater l'intention des associés de proroger la société et autoriser la consultation à titre de régularisation dans un délai de trois mois, le cas échéant en désignant un mandataire de justice chargé de la provoquer. Si la société est prorogée, les actes conformes à la loi et aux statuts antérieurs à la prorogation sont réputés réguliers et avoir été accomplis par la société ainsi prorogée.
""";
    content_hash "sha256:f9813fdf6bbbf1fa8e9c919f1020f29266e5e6992ceed7f62afb89797029b593";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_7")
pub fragment CC_ART1844_7 in CC_COURANT {
    label fr official "Article 1844-7";
    kind article;
    locator "article/1844-7";
    text fr official """Article 1844-7
La société prend fin :
1° Par l'expiration du temps pour lequel elle a été constituée, sauf prorogation effectuée conformément à l'article 1844-6 ;
2° Par la réalisation ou l'extinction de son objet ;
3° Par l'annulation du contrat de société ;
4° Par la dissolution anticipée décidée par les associés ;
5° Par la dissolution anticipée prononcée par le tribunal à la demande d'un associé pour justes motifs, notamment en cas d'inexécution de ses obligations par un associé, ou de mésentente entre associés paralysant le fonctionnement de la société ;
6° Par la dissolution anticipée prononcée par le tribunal dans le cas prévu à l'article 1844-5 ;
7° Par l'effet d'un jugement ordonnant la clôture de la liquidation judiciaire pour insuffisance d'actif ;
8° Pour toute autre cause prévue par les statuts.
""";
    content_hash "sha256:fc4a712e41de10a7656f257963982ed83b8700cc096884c0ff821c29da413d76";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_8")
pub fragment CC_ART1844_8 in CC_COURANT {
    label fr official "Article 1844-8";
    kind article;
    locator "article/1844-8";
    text fr official """Article 1844-8
La dissolution de la société entraîne sa liquidation, hormis les cas prévus à l'article 1844-4 et au troisième alinéa de l'article 1844-5. Elle n'a d'effet à l'égard des tiers qu'après sa publication.
Le liquidateur est nommé conformément aux dispositions des statuts. Dans le silence de ceux-ci, il est nommé par les associés ou, si les associés n'ont pu procéder à cette nomination, par décision de justice. Le liquidateur peut être révoqué dans les mêmes conditions. La nomination et la révocation ne sont opposables aux tiers qu'à compter de leur publication. Ni la société ni les tiers ne peuvent, pour se soustraire à leurs engagements, se prévaloir d'une irrégularité dans la nomination ou dans la révocation du liquidateur, dès lors que celle-ci a été régulièrement publiée.
La personnalité morale de la société subsiste pour les besoins de la liquidation jusqu'à la publication de la clôture de celle-ci.
Si la clôture de la liquidation n'est pas intervenue dans un délai de trois ans à compter de la dissolution, le ministère public ou tout intéressé peut saisir le tribunal, qui fait procéder à la liquidation ou, si celle-ci a été commencée, à son achèvement.
""";
    content_hash "sha256:e74cecd51c5ea8783fcac23d930be92a4c2c716a55b9685aa15bd24886fb3ae6";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_9")
pub fragment CC_ART1844_9 in CC_COURANT {
    label fr official "Article 1844-9";
    kind article;
    locator "article/1844-9";
    text fr official """Article 1844-9
Après paiement des dettes et remboursement du capital social, le partage de l'actif est effectué entre les associés dans les mêmes proportions que leur participation aux bénéfices, sauf clause ou convention contraire.
Les règles concernant le partage des successions, y compris l'attribution préférentielle, s'appliquent aux partages entre associés.
Toutefois, les associés peuvent valablement décider, soit dans les statuts, soit par une décision ou un acte distinct, que certains biens seront attribués à certains associés. A défaut, tout bien apporté qui se retrouve en nature dans la masse partagée est attribué, sur sa demande, et à charge de soulte s'il y a lieu, à l'associé qui en avait fait l'apport. Cette faculté s'exerce avant tout autre droit à une attribution préférentielle.
Tous les associés, ou certains d'entre eux seulement, peuvent aussi demeurer dans l'indivision pour tout ou partie des biens sociaux. Leurs rapports sont alors régis, à la clôture de la liquidation, en ce qui concerne ces biens, par les dispositions relatives à l'indivision.
""";
    content_hash "sha256:eefe7d78ec1750314a831dc3e7dd060b6217f66d5b9a2c89a95681d9c49f6ebf";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_10")
pub fragment CC_ART1844_10 in CC_COURANT {
    label fr official "Article 1844-10";
    kind article;
    locator "article/1844-10";
    text fr official """Article 1844-10
La nullité de la société ne peut résulter que de l'incapacité de tous les fondateurs ou de la violation des dispositions fixant un nombre minimal de deux associés.
Toute clause statutaire contraire à une disposition impérative du droit des sociétés dont la violation n'est pas sanctionnée par la nullité de la société, est réputée non écrite.
La nullité des décisions sociales ne peut résulter que de la violation d'une disposition impérative de droit des sociétés, à l'exception du dernier alinéa de l'article 1833, ou de l'une des causes de nullité des contrats en général.
Sauf si la loi en dispose autrement, la violation des statuts ne constitue pas une cause de nullité.
""";
    content_hash "sha256:3e1fdda5d21c518734655ef7a084af83c7bf9d02be03430806072d96e6a8154f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_10_1")
pub fragment CC_ART1844_10_1 in CC_COURANT {
    label fr official "Article 1844-10-1";
    kind article;
    locator "article/1844-10-1";
    text fr official """Article 1844-10-1
La nullité de l'apport ne peut résulter que des causes mentionnées au troisième alinéa de l'article 1844-10.
La nullité de l'apport entraîne l'annulation des parts sociales ou des actions émises en contrepartie, et, dans les conditions prévues aux articles 1352 à 1352-9, la restitution, par la société, des engagements exécutés par l'apporteur.
La nullité de tous les apports, qu'ils soient souscrits au cours de la constitution ou postérieurement à celle-ci, entraîne la dissolution de la société. Il est alors procédé à sa liquidation conformément aux dispositions des statuts et du chapitre VII du titre III du livre II du code de commerce, sans préjudice des dispositions du troisième alinéa de l'article 1844-5.
""";
    content_hash "sha256:3c7cb274e207815aa7c51335693dce4994417c83fdca6f478b1b06cf8b7ab32c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_11")
pub fragment CC_ART1844_11 in CC_COURANT {
    label fr official "Article 1844-11";
    kind article;
    locator "article/1844-11";
    text fr official """Article 1844-11
L'action en nullité est éteinte lorsque la cause de la nullité a cessé d'exister le jour où le tribunal statue sur le fond en première instance.
""";
    content_hash "sha256:5e495bb2ff179d4b79c8df0f3ea52799b056175a8136b753531cb579bae0ca5e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_12_1")
pub fragment CC_ART1844_12_1 in CC_COURANT {
    label fr official "Article 1844-12-1";
    kind article;
    locator "article/1844-12-1";
    text fr official """Article 1844-12-1
La nullité des décisions sociales ne peut être prononcée que si :
1° Le demandeur justifie d'un grief résultant d'une atteinte à l'intérêt protégé par la règle dont la violation est invoquée ;
2° L'irrégularité a eu une influence sur le sens de la décision ;
3° Les conséquences de la nullité pour l'intérêt social ne sont pas excessives, au jour de la décision la prononçant, au regard de l'atteinte à l'intérêt dont la protection est invoquée.
""";
    content_hash "sha256:5aa92be3ee9214ba96e88d9630bef26d056788c0ce0e9cc292db38382b2bc81d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_13")
pub fragment CC_ART1844_13 in CC_COURANT {
    label fr official "Article 1844-13";
    kind article;
    locator "article/1844-13";
    text fr official """Article 1844-13
Le tribunal, saisi d'une demande en nullité, peut, même d'office, fixer un délai pour permettre de couvrir les nullités. Il ne peut prononcer la nullité moins de deux mois après la date de l'exploit introductif d'instance.
Si, pour couvrir une nullité, une assemblée doit être convoquée, ou une consultation des associés effectuée, et s'il est justifié d'une convocation régulière de cette assemblée ou de l'envoi aux associés du texte des projets de décision accompagné des documents qui doivent leur être communiqués, le tribunal accorde par jugement le délai nécessaire pour que les associés puissent prendre une décision.
""";
    content_hash "sha256:a3f9e6686b361d24138a8c1743185369f878463d6059a0be35ea97840e96d827";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_14")
pub fragment CC_ART1844_14 in CC_COURANT {
    label fr official "Article 1844-14";
    kind article;
    locator "article/1844-14";
    text fr official """Article 1844-14
Sous réserve des dispositions particulières concernant les fusions, les scissions et les modifications du capital social, les actions en nullité de la société, de décisions sociales postérieures à sa constitution ou d'apports se prescrivent par deux ans à compter du jour où la nullité est encourue.
""";
    content_hash "sha256:e9bfee4f3328424a3cfc82cb050fadc62aa85f83bee1ee1b160e48baaa068435";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_15")
pub fragment CC_ART1844_15 in CC_COURANT {
    label fr official "Article 1844-15";
    kind article;
    locator "article/1844-15";
    text fr official """Article 1844-15
Lorsque la nullité de la société est prononcée, elle met fin, sans rétroactivité, à l'exécution du contrat.
Sous réserve de l'application des dispositions du troisième alinéa de l'article 1844-5, il est procédé à sa liquidation conformément aux dispositions des statuts et du chapitre VII du titre III du livre II du code de commerce.
A l'égard de la personne morale qui a pu prendre naissance, elle produit les effets d'une dissolution prononcée par justice.
""";
    content_hash "sha256:39cee9ca28bf3300c7619e3c31f1c47198edc123714243bc14387866a3168854";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_15_1")
pub fragment CC_ART1844_15_1 in CC_COURANT {
    label fr official "Article 1844-15-1";
    kind article;
    locator "article/1844-15-1";
    text fr official """Article 1844-15-1
Sauf disposition législative contraire, la nullité de la nomination ou le maintien irrégulier d'un organe ou d'un membre d'un organe de la société n'entraîne pas la nullité des décisions prises par celui-ci.
""";
    content_hash "sha256:174edb7a1ed0f453c1a13d9c5a6dcbd8a58fdda388bd70ca943882bca964b4e7";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_15_2")
pub fragment CC_ART1844_15_2 in CC_COURANT {
    label fr official "Article 1844-15-2";
    kind article;
    locator "article/1844-15-2";
    text fr official """Article 1844-15-2
Lorsque la rétroactivité de la nullité d'une décision sociale est de nature à produire des effets manifestement excessifs pour l'intérêt social, les effets de cette nullité peuvent être différés.
""";
    content_hash "sha256:144a5acbaa86e2a7113ffafa65b4352d6b62f675b9ece471f1db8453558bcdd3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_16")
pub fragment CC_ART1844_16 in CC_COURANT {
    label fr official "Article 1844-16";
    kind article;
    locator "article/1844-16";
    text fr official """Article 1844-16
Ni la société ni les associés ne peuvent se prévaloir d'une nullité à l'égard des tiers de bonne foi. Cependant la nullité résultant de l'incapacité ou de l'un des vices du consentement est opposable même aux tiers par l'incapable et ses représentants légaux, ou par l'associé dont le consentement a été surpris par erreur, dol ou violence.
""";
    content_hash "sha256:c98b42daea629050ca76b45e772ce001cd77ac913f258a6bc6c80f1112f19d6c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1844_17")
pub fragment CC_ART1844_17 in CC_COURANT {
    label fr official "Article 1844-17";
    kind article;
    locator "article/1844-17";
    text fr official """Article 1844-17
L'action en responsabilité fondée sur l'annulation de la société ou des décisions sociales et apports postérieurs à la constitution se prescrit par trois ans à compter du jour où la décision d'annulation est passée en force de chose jugée.
La disparition de la cause de nullité ne met pas obstacle à l'exercice de l'action en dommages-intérêts tendant à la réparation du préjudice causé par le vice dont la société, la décision sociale ou l'apport était entaché. Cette action se prescrit par trois ans à compter du jour où la nullité a été couverte.
""";
    content_hash "sha256:18497f193183359ba343ee7fddd965007ac600b05b33f54fa1bc2476351289ff";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1845")
pub fragment CC_ART1845 in CC_COURANT {
    label fr official "Article 1845";
    kind article;
    locator "article/1845";
    text fr official """Article 1845
Les dispositions du présent chapitre sont applicables à toutes les sociétés civiles, à moins qu'il n'y soit dérogé par le statut légal particulier auquel certaines d'entre elles sont assujetties.
Ont le caractère civil toutes les sociétés auxquelles la loi n'attribue pas un autre caractère à raison de leur forme, de leur nature, ou de leur objet.
""";
    content_hash "sha256:b9241ad383dcaaabbb75998a0a2e6edcf898c9d47307d65d6534559dfb117aab";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1845_1")
pub fragment CC_ART1845_1 in CC_COURANT {
    label fr official "Article 1845-1";
    kind article;
    locator "article/1845-1";
    text fr official """Article 1845-1
Le capital est divisé en parts égales.
Les dispositions du chapitre Ier du titre III du livre II du code de commerce relatives au capital variable des sociétés sont applicables aux sociétés civiles.
""";
    content_hash "sha256:5ba57b7c0ee7eedeea42b712f5e116c955804f585bb2111f72ed9d24e8503167";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1846")
pub fragment CC_ART1846 in CC_COURANT {
    label fr official "Article 1846";
    kind article;
    locator "article/1846";
    text fr official """Article 1846
La société est gérée par une ou plusieurs personnes, associées ou non, nommées soit par les statuts, soit par un acte distinct, soit par une décision des associés.
Les statuts fixent les règles de désignation du ou des gérants et le mode d'organisation de la gérance.
Sauf disposition contraire des statuts, le gérant est nommé par une décision des associés représentant plus de la moitié des parts sociales.
Dans le silence des statuts, et s'il n'en a été décidé autrement par les associés lors de la désignation, les gérants sont réputés nommés pour la durée de la société.
Si, pour quelque cause que ce soit, la société se trouve dépourvue de gérant, tout associé peut réunir les associés ou, à défaut, demander au président du tribunal statuant sur requête la désignation d'un mandataire chargé de le faire, à seule fin de nommer un ou plusieurs gérants.
""";
    content_hash "sha256:67131f2432dfd45e341a0d3eb90f0a5d0fdb58a0a333e7e23b8053857e1e68ff";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1846_1")
pub fragment CC_ART1846_1 in CC_COURANT {
    label fr official "Article 1846-1";
    kind article;
    locator "article/1846-1";
    text fr official """Article 1846-1
Hors les cas visés à l'article 1844-7, la société prend fin par la dissolution anticipée que peut prononcer le tribunal à la demande de tout intéressé, lorsqu'elle est dépourvue de gérant depuis plus d'un an.
""";
    content_hash "sha256:e321846a8f569692f808cfd54f1b95b37b8179f981ddc7d71feef516ab76d213";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1846_2")
pub fragment CC_ART1846_2 in CC_COURANT {
    label fr official "Article 1846-2";
    kind article;
    locator "article/1846-2";
    text fr official """Article 1846-2
La nomination et la cessation de fonction des gérants doivent être publiées.
Ni la société, ni les tiers ne peuvent, pour se soustraire à leurs engagements, se prévaloir d'une irrégularité dans la nomination des gérants ou dans la cessation de leur fonction, dès lors que ces décisions ont été régulièrement publiées.
""";
    content_hash "sha256:feadab49f5c2e05d46631cc5e6870fde52fb4e23bbbae725fdf20e6b51dc28b2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1847")
pub fragment CC_ART1847 in CC_COURANT {
    label fr official "Article 1847";
    kind article;
    locator "article/1847";
    text fr official """Article 1847
Si une personne morale exerce la gérance, ses dirigeants sont soumis aux mêmes conditions et obligations et encourent les mêmes responsabilités, civile et pénale, que s'ils étaient gérants en leur nom propre, sans préjudice de la responsabilité solidaire de la personne morale qu'ils dirigent.
""";
    content_hash "sha256:5bd6afba03002ea988b0b96a3ebb9458a14bbbcc14d3ea507e8a6047d5116769";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1848")
pub fragment CC_ART1848 in CC_COURANT {
    label fr official "Article 1848";
    kind article;
    locator "article/1848";
    text fr official """Article 1848
Dans les rapports entre associés, le gérant peut accomplir tous les actes de gestion que demande l'intérêt de la société.
S'il y a plusieurs gérants, ils exercent séparément ces pouvoirs, sauf le droit qui appartient à chacun de s'opposer à une opération avant qu'elle ne soit conclue.
Le tout, à défaut de dispositions des statuts sur le mode d'administration.
""";
    content_hash "sha256:ec863c4e9e3773a6ff986cfb290c6159be12dc917dd2e860da4406077b7fa694";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1849")
pub fragment CC_ART1849 in CC_COURANT {
    label fr official "Article 1849";
    kind article;
    locator "article/1849";
    text fr official """Article 1849
Dans les rapports avec les tiers, le gérant engage la société par les actes entrant dans l'objet social.
En cas de pluralité de gérants, ceux-ci détiennent séparément les pouvoirs prévus à l'alinéa précédent. L'opposition formée par un gérant aux actes d'un autre gérant est sans effet à l'égard des tiers, à moins qu'il ne soit établi qu'ils en ont eu connaissance.
Les clauses statutaires limitant les pouvoirs des gérants sont inopposables aux tiers.
""";
    content_hash "sha256:d9c6b8181efc3ed287880ec25a693eca310cabed7340fcf3587533ce053ed4ca";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1850")
pub fragment CC_ART1850 in CC_COURANT {
    label fr official "Article 1850";
    kind article;
    locator "article/1850";
    text fr official """Article 1850
Chaque gérant est responsable individuellement envers la société et envers les tiers, soit des infractions aux lois et règlements, soit de la violation des statuts, soit des fautes commises dans sa gestion.
Si plusieurs gérants ont participé aux mêmes faits, leur responsabilité est solidaire à l'égard des tiers et des associés. Toutefois, dans leurs rapports entre eux, le tribunal détermine la part contributive de chacun dans la réparation du dommage.
""";
    content_hash "sha256:09fe98bcccd7c4790da5db1d0b05d7fcda752e94f3e272ab76b1a0f521d8f921";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1851")
pub fragment CC_ART1851 in CC_COURANT {
    label fr official "Article 1851";
    kind article;
    locator "article/1851";
    text fr official """Article 1851
Sauf disposition contraire des statuts le gérant est révocable par une décision des associés représentant plus de la moitié des parts sociales. Si la révocation est décidée sans juste motif, elle peut donner lieu à dommages-intérêts.
Le gérant est également révocable par les tribunaux pour cause légitime, à la demande de tout associé.
Sauf clause contraire, la révocation d'un gérant, qu'il soit associé ou non, n'entraîne pas la dissolution de la société. Si le gérant révoqué est un associé, il peut, à moins qu'il n'en soit autrement convenu dans les statuts, ou que les autres associés ne décident la dissolution anticipée de la société, se retirer de celle-ci dans les conditions prévues à l'article 1869 (2ème alinéa).
""";
    content_hash "sha256:f4dc5b2b9317b3a0a061148c2b00f5d7b6716ede928a87b86bb97ebba6c41033";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1852")
pub fragment CC_ART1852 in CC_COURANT {
    label fr official "Article 1852";
    kind article;
    locator "article/1852";
    text fr official """Article 1852
Les décisions qui excèdent les pouvoirs reconnus aux gérants sont prises selon les dispositions statutaires ou, en l'absence de telles dispositions, à l'unanimité des associés.
""";
    content_hash "sha256:d0a459646fb86df08885ffdb6d595103a508cbc1fdacef627308d33d3e79b121";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1853")
pub fragment CC_ART1853 in CC_COURANT {
    label fr official "Article 1853";
    kind article;
    locator "article/1853";
    text fr official """Article 1853
Les décisions sont prises par les associés réunis en assemblée. Les statuts peuvent aussi prévoir qu'elles résulteront d'une consultation écrite, y compris par voie électronique, selon les délais et les modalités qu'ils définissent.
""";
    content_hash "sha256:087a50bf3348282d40dca363942675d9a0f9caead630486fb3d2db0a02c47ab9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1854")
pub fragment CC_ART1854 in CC_COURANT {
    label fr official "Article 1854";
    kind article;
    locator "article/1854";
    text fr official """Article 1854
Les décisions peuvent encore résulter du consentement de tous les associés exprimé dans un acte.
""";
    content_hash "sha256:a7fbe5600c005a9e0b979d9ca67a714ae2634c90056d973d573c73df8cea1765";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1854_1")
pub fragment CC_ART1854_1 in CC_COURANT {
    label fr official "Article 1854-1";
    kind article;
    locator "article/1854-1";
    text fr official """Article 1854-1
En cas de fusion de sociétés civiles, si les statuts prévoient la consultation des associés de la société absorbante, cette consultation n'est pas requise lorsque, depuis le dépôt du projet de fusion et jusqu'à la réalisation de l'opération, la société absorbante détient au moins 90 % des parts de la société absorbée. Toutefois, un ou plusieurs associés de la société absorbante réunissant au moins 5 % du capital social peuvent demander en justice la désignation d'un mandataire aux fins de provoquer la consultation des associés de la société absorbante pour qu'ils se prononcent sur l'approbation de la fusion.
""";
    content_hash "sha256:472968b5b6b6828f1fe1d9a6818d8595eef0d517c23db78615540ec015c82666";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1855")
pub fragment CC_ART1855 in CC_COURANT {
    label fr official "Article 1855";
    kind article;
    locator "article/1855";
    text fr official """Article 1855
Les associés ont le droit d'obtenir, au moins une fois par an, communication des livres et des documents sociaux, et de poser par écrit des questions sur la gestion sociale auxquelles il devra être répondu par écrit dans le délai d'un mois.
""";
    content_hash "sha256:074090c96e7b7d391e6d14efc375718aa9b79849c0534f31ebef3ba323bf3cc9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1856")
pub fragment CC_ART1856 in CC_COURANT {
    label fr official "Article 1856";
    kind article;
    locator "article/1856";
    text fr official """Article 1856
Les gérants doivent, au moins une fois dans l'année, rendre compte de leur gestion aux associés. Cette reddition de compte doit comporter un rapport écrit d'ensemble sur l'activité de la société au cours de l'année ou de l'exercice écoulé comportant l'indication des bénéfices réalisés ou prévisibles et des pertes encourues ou prévues.
""";
    content_hash "sha256:56bf4dc20f569ec80e6ec86092f9528042b2867847e8acbdc267c95ad524398d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1857")
pub fragment CC_ART1857 in CC_COURANT {
    label fr official "Article 1857";
    kind article;
    locator "article/1857";
    text fr official """Article 1857
A l'égard des tiers, les associés répondent indéfiniment des dettes sociales à proportion de leur part dans le capital social à la date de l'exigibilité ou au jour de la cessation des paiements.
L'associé qui n'a apporté que son industrie est tenu comme celui dont la participation dans le capital social est la plus faible.
""";
    content_hash "sha256:c0de1780f2446b91b0fddac5357350d90dc954703c84dc687bf280da7bd44688";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1858")
pub fragment CC_ART1858 in CC_COURANT {
    label fr official "Article 1858";
    kind article;
    locator "article/1858";
    text fr official """Article 1858
Les créanciers ne peuvent poursuivre le paiement des dettes sociales contre un associé qu'après avoir préalablement et vainement poursuivi la personne morale.
""";
    content_hash "sha256:7be83f1012cdcdfce40b1a8b881744cd66fbdbbc64bb7fff8782215e979b45b4";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1859")
pub fragment CC_ART1859 in CC_COURANT {
    label fr official "Article 1859";
    kind article;
    locator "article/1859";
    text fr official """Article 1859
Toutes les actions contre les associés non liquidateurs ou leurs héritiers et ayants cause se prescrivent par cinq ans à compter de la publication de la dissolution de la société.
""";
    content_hash "sha256:c33fac4e26360bc6e276e1d3cf54edd58243a18ccee86c77c90168b424479e17";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1860")
pub fragment CC_ART1860 in CC_COURANT {
    label fr official "Article 1860";
    kind article;
    locator "article/1860";
    text fr official """Article 1860
S'il y a déconfiture, faillite personnelle, liquidation de biens ou règlement judiciaire atteignant l'un des associés, à moins que les autres unanimes ne décident de dissoudre la société par anticipation ou que cette dissolution ne soit prévue par les statuts, il est procédé, dans les conditions énoncées à l'article 1843-4, au remboursement des droits sociaux de l'intéressé, lequel perdra alors la qualité d'associé.
""";
    content_hash "sha256:c535fd25ce50cd6804dad57c60d3aaa00134693347564f8c76475d9b39f2adbb";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1861")
pub fragment CC_ART1861 in CC_COURANT {
    label fr official "Article 1861";
    kind article;
    locator "article/1861";
    text fr official """Article 1861
Les parts sociales ne peuvent être cédées qu'avec l'agrément de tous les associés.
Les statuts peuvent toutefois convenir que cet agrément sera obtenu à une majorité qu'ils déterminent, ou qu'il peut être accordé par les gérants. Ils peuvent aussi dispenser d'agrément les cessions consenties à des associés ou au conjoint de l'un d'eux. Sauf dispositions contraires des statuts, ne sont pas soumises à agrément les cessions consenties à des ascendants ou descendants du cédant.
Le projet de cession est notifié, avec demande d'agrément, à la société et à chacun des associés. Il n'est notifié qu'à la société quand les statuts prévoient que l'agrément peut être accordé par les gérants.
Lorsque deux époux sont simultanément membres d'une société, les cessions faites par l'un d'eux à l'autre doivent, pour être valables, résulter d'un acte notarié ou d'un acte sous seing privé ayant acquis date certaine autrement que par le décès du cédant.
""";
    content_hash "sha256:60f58e5988158f383aa0a37543af9a20ca335c0b50b34cfead7b56cb634f7645";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1862")
pub fragment CC_ART1862 in CC_COURANT {
    label fr official "Article 1862";
    kind article;
    locator "article/1862";
    text fr official """Article 1862
Lorsque plusieurs associés expriment leur volonté d'acquérir, ils sont, sauf clause ou convention contraire, réputés acquéreurs à proportion du nombre de parts qu'ils détenaient antérieurement.
Si aucun associé ne se porte acquéreur, la société peut faire acquérir les parts par un tiers désigné à l'unanimité des autres associés ou suivant les modalités prévues par les statuts. La société peut également procéder au rachat des parts en vue de leur annulation.
Le nom du ou des acquéreurs proposés, associés ou tiers, ou l'offre de rachat par la société, ainsi que le prix offert sont notifiés au cédant. En cas de contestation, sur le prix, celui-ci est fixé conformément aux dispositions de l'article 1843-4, le tout sans préjudice du droit du cédant de conserver ses parts.
""";
    content_hash "sha256:7cad44e6dded34719ea5917a3f5206bcfe827f8698814f1c6b0874dbbdb94de1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1863")
pub fragment CC_ART1863 in CC_COURANT {
    label fr official "Article 1863";
    kind article;
    locator "article/1863";
    text fr official """Article 1863
Si aucune offre d'achat n'est faite au cédant dans un délai de six mois à compter de la dernière des notifications prévues au troisième alinéa de l'article 1861, l'agrément à la cession est réputé acquis, à moins que les autres associés ne décident, dans le même délai, la dissolution anticipée de la société.
Dans ce dernier cas, le cédant peut rendre caduque cette décision en faisant connaître qu'il renonce à la cession dans le délai d'un mois à compter de ladite décision.
""";
    content_hash "sha256:e5fbef75999743b5d371eceef65a46e8037f1421042d49aefd2c9194bbbd3a57";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1864")
pub fragment CC_ART1864 in CC_COURANT {
    label fr official "Article 1864";
    kind article;
    locator "article/1864";
    text fr official """Article 1864
Il ne peut être dérogé aux dispositions des deux articles qui précèdent que pour modifier le délai de six mois prévu à l'article 1863 (1er alinéa), et sans que le délai prévu par les statuts puisse excéder un an ni être inférieur à un mois.
""";
    content_hash "sha256:4abf59bdd5f6c08abb93640bf647fbce859ac4a586ba4036de98e8be4b268b0a";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1865")
pub fragment CC_ART1865 in CC_COURANT {
    label fr official "Article 1865";
    kind article;
    locator "article/1865";
    text fr official """Article 1865
La cession de parts sociales doit être constatée par écrit. Elle est rendue opposable à la société dans les formes prévues à l'article 1690 ou, si les statuts le stipulent, par transfert sur les registres de la société.
Elle n'est opposable aux tiers qu'après accomplissement de ces formalités et après publication au registre du commerce et des sociétés ; ce dépôt peut être effectué par voie électronique.
""";
    content_hash "sha256:df29f000af4ba8692aff38132edc366ba7231855bf32bd30868f0d98da98426f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1865_1")
pub fragment CC_ART1865_1 in CC_COURANT {
    label fr official "Article 1865-1";
    kind article;
    locator "article/1865-1";
    text fr official """Article 1865-1
I. - A peine de nullité, la cession de parts sociales ou d'actions d'une personne morale à prépondérance immobilière, au sens du 2° du I de l'article 726 du code général des impôts, est constatée par :
1° Un acte authentique ;
2° Un acte contresigné par avocat, au sens de l'article 1374 du présent code ;
3° Dans les seuls cas où un expert-comptable est légalement habilité à le rédiger en application du 2° de l'article 22 de l'ordonnance n° 45-2138 du 19 septembre 1945 portant institution de l'ordre des experts-comptables et réglementant le titre et la profession d'expert-comptable et de l'article 59 de la loi n° 71-1130 du 31 décembre 1971 portant réforme de certaines professions judiciaires et juridiques, un acte sous signature privée rédigé par celui-ci.
Les professionnels concernés réalisent ces actes dans le respect des obligations de vigilance, de déclaration et d'information prévues au titre VI du livre V du code monétaire et financier.
II. - Le I du présent article n'est pas applicable aux cessions portant sur des parts sociales ou des actions de placements collectifs mentionnés à l'article L. 214-1 du code monétaire et financier.
""";
    content_hash "sha256:3fa6f32c73e59b17c858880d8f033043a83563ea851723ef43ae3110e701f299";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1866")
pub fragment CC_ART1866 in CC_COURANT {
    label fr official "Article 1866";
    kind article;
    locator "article/1866";
    text fr official """Article 1866
Les parts sociales peuvent faire l'objet d'un nantissement dans les conditions prévues au dernier alinéa de l'article 2355 du code civil.
""";
    content_hash "sha256:d7b40fb02585d8606257528eb2d6e691efba92457d901e84a2fa4f62fe9e24bf";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1867")
pub fragment CC_ART1867 in CC_COURANT {
    label fr official "Article 1867";
    kind article;
    locator "article/1867";
    text fr official """Article 1867
Tout associé peut obtenir des autres associés leur consentement à un projet de nantissement dans les mêmes conditions que leur agrément à une cession de parts.
Le consentement donné au projet de nantissement emporte agrément du cessionnaire en cas de réalisation forcée des parts sociales à la condition que cette réalisation soit notifiée un mois avant la vente aux associés et à la société.
Chaque associé peut se substituer à l'acquéreur dans un délai de cinq jours francs à compter de la vente. Si plusieurs associés exercent cette faculté, ils sont, sauf clause ou convention contraire, réputés acquéreurs à proportion du nombre de parts qu'ils détenaient antérieurement. Si aucun associé n'exerce cette faculté, la société peut racheter les parts elle-même, en vue de leur annulation.
La notification prévue au deuxième alinéa ainsi que le troisième alinéa ne sont pas applicables au nantissement réalisé en application de l'article 2348.
""";
    content_hash "sha256:022ab72d64dc8e9f82ada15c60bc148b0424c869f751580cf421cd6e80fc5041";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1868")
pub fragment CC_ART1868 in CC_COURANT {
    label fr official "Article 1868";
    kind article;
    locator "article/1868";
    text fr official """Article 1868
La réalisation forcée qui ne procède pas d'un nantissement auquel les autres associés ont donné leur consentement doit pareillement être notifiée un mois avant la vente aux associés et à la société.
Les associés peuvent, dans ce délai, décider la dissolution de la société ou l'acquisition des parts dans les conditions prévues aux articles 1862 et 1863.
Si la vente a eu lieu, les associés ou la société peuvent exercer la faculté de substitution qui leur est reconnue par l'article 1867. Le non-exercice de cette faculté emporte agrément de l'acquéreur.
""";
    content_hash "sha256:b6f08fcbe15a914c9fd110953996883f140be83d6b25fd94d04248e4ab8ef08f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1869")
pub fragment CC_ART1869 in CC_COURANT {
    label fr official "Article 1869";
    kind article;
    locator "article/1869";
    text fr official """Article 1869
Sans préjudice des droits des tiers, un associé peut se retirer totalement ou partiellement de la société, dans les conditions prévues par les statuts ou, à défaut, après autorisation donnée par une décision unanime des autres associés. Ce retrait peut également être autorisé pour justes motifs par une décision de justice.
A moins qu'il ne soit fait application de l'article 1844-9 (3ème alinéa), l'associé qui se retire a droit au remboursement de la valeur de ses droits sociaux, fixée, à défaut d'accord amiable, conformément à l'article 1843-4.
""";
    content_hash "sha256:be2fca1d66dafd768ccb3beee294e174ed6d9c11b030594b06ab1c7e4f84a780";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1870")
pub fragment CC_ART1870 in CC_COURANT {
    label fr official "Article 1870";
    kind article;
    locator "article/1870";
    text fr official """Article 1870
La société n'est pas dissoute par le décès d'un associé, mais continue avec ses héritiers ou légataires, sauf à prévoir dans les statuts qu'ils doivent être agréés par les associés.
Il peut toutefois, être convenu que ce décès entraînera la dissolution de la société ou que celle-ci continuera avec les seuls associés survivants.
Il peut également être convenu que la société continuera soit avec le conjoint survivant, soit avec un ou plusieurs des héritiers, soit avec toute autre personne désignée par les statuts ou, si ceux-ci l'autorisent, par disposition testamentaire.
Sauf clause contraire des statuts, lorsque la succession est dévolue à une personne morale, celle-ci ne peut devenir associée qu'avec l'agrément des autres associés, donné selon les conditions statutaires ou, à défaut, par l'accord unanime des associés.
""";
    content_hash "sha256:4ca3b68e34abbba24bc2a66d9bf0e1d40358192cb7a6de37ea5f20587b96bf4b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1870_1")
pub fragment CC_ART1870_1 in CC_COURANT {
    label fr official "Article 1870-1";
    kind article;
    locator "article/1870-1";
    text fr official """Article 1870-1
Les héritiers ou légataires qui ne deviennent pas associés n'ont droit qu'à la valeur des parts sociales de leur auteur. Cette valeur doit leur être payée par les nouveaux titulaires des parts ou par la société elle-même si celle-ci les a rachetées en vue de leur annulation.
La valeur de ces droits sociaux est déterminée au jour du décès dans les conditions prévues à l'article 1843-4.
""";
    content_hash "sha256:61e2f81061943ccf229e488090eb6712234cf13398b6cc19dd9b50a898d73605";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1871")
pub fragment CC_ART1871 in CC_COURANT {
    label fr official "Article 1871";
    kind article;
    locator "article/1871";
    text fr official """Article 1871
Les associés peuvent convenir que la société ne sera point immatriculée. La société est dite alors " société en participation ". Elle n'est pas une personne morale et n'est pas soumise à publicité. Elle peut être prouvée par tous moyens.
Les associés conviennent librement de l'objet, du fonctionnement et des conditions de la société en participation, sous réserve de ne pas déroger aux dispositions impératives des articles 1832,1832-1,1833,1836 (2e alinéa), 1844 (1er alinéa) et 1844-1 (2e alinéa) et de l'article L. 411-1 du code monétaire et financier.
""";
    content_hash "sha256:7e43c104aa47c7ad3e6865b30b158e5d1f1e658a1b6db8dff5c34b33a6962b05";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1871_1")
pub fragment CC_ART1871_1 in CC_COURANT {
    label fr official "Article 1871-1";
    kind article;
    locator "article/1871-1";
    text fr official """Article 1871-1
A moins qu'une organisation différente n'ait été prévue, les rapports entre associés sont régis, en tant que de raison, soit par les dispositions applicables aux sociétés civiles, si la société a un caractère civil, soit, si elle a un caractère commercial, par celles applicables aux sociétés en nom collectif.
""";
    content_hash "sha256:3cbf881492139c6f212424a9d75efe54e665230577973f67876963ca640f629c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1872")
pub fragment CC_ART1872 in CC_COURANT {
    label fr official "Article 1872";
    kind article;
    locator "article/1872";
    text fr official """Article 1872
A l'égard des tiers, chaque associé reste propriétaire des biens qu'il met à la disposition de la société.
Sont réputés indivis entre les associés les biens acquis par emploi ou remploi de deniers indivis pendant la durée de la société et ceux qui se trouvaient indivis avant d'être mis à la disposition de la société.
Il en est de même de ceux que les associés auraient convenu de mettre en indivision.
Il peut en outre être convenu que l'un des associés est, à l'égard des tiers, propriétaire de tout ou partie des biens qu'il acquiert en vue de la réalisation de l'objet social.
""";
    content_hash "sha256:618593afdc5d71799856b3c82aaf1f7a6677fde5e3ea91a84eb27bf8095a20ad";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1872_1")
pub fragment CC_ART1872_1 in CC_COURANT {
    label fr official "Article 1872-1";
    kind article;
    locator "article/1872-1";
    text fr official """Article 1872-1
Chaque associé contracte en son nom personnel et est seul engagé à l'égard des tiers.
Toutefois, si les participants agissent en qualité d'associés au vu et au su des tiers, chacun d'eux est tenu à l'égard de ceux-ci des obligations nées des actes accomplis en cette qualité par l'un des autres, avec solidarité, si la société est commerciale, sans solidarité dans les autres cas.
Il en est de même de l'associé qui, par son immixtion, a laissé croire au cocontractant qu'il entendait s'engager à son égard, ou dont il est prouvé que l'engagement a tourné à son profit.
Dans tous les cas, en ce qui concerne les biens réputés indivis en application de l'article 1872 (alinéas 2 et 3), sont applicables dans les rapports avec les tiers, soit les dispositions du chapitre VI du titre Ier du livre III du présent code, soit, si les formalités prévues à l'article 1873-2 ont été accomplies, celles du titre IX bis du présent livre, tous les associés étant alors, sauf convention contraire, réputés gérants de l'indivision.
""";
    content_hash "sha256:a6f83a8b2fa8f4595b5902e86bf9b73cad7e1e7fd456e72ba05dace5835f2978";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1872_2")
pub fragment CC_ART1872_2 in CC_COURANT {
    label fr official "Article 1872-2";
    kind article;
    locator "article/1872-2";
    text fr official """Article 1872-2
Lorsque la société en participation est à durée indéterminée, sa dissolution peut résulter à tout moment d'une notification adressée par l'un d'eux à tous les associés, pourvu que cette notification soit de bonne foi, et non faite à contretemps.
A moins qu'il n'en soit autrement convenu, aucun associé ne peut demander le partage des biens indivis en application de l'article 1872 tant que la société n'est pas dissoute.
""";
    content_hash "sha256:ea844a4a527f294555cfefefaa2f5be1b6e5d8498f2ad3c02d9388593992754c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873")
pub fragment CC_ART1873 in CC_COURANT {
    label fr official "Article 1873";
    kind article;
    locator "article/1873";
    text fr official """Article 1873
Les dispositions du présent chapitre sont applicables aux sociétés créées de fait.
""";
    content_hash "sha256:6d79bc8fd818c358b768aef927decac49ba3eab56455f1bd7e5c157ee63689ed";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_1")
pub fragment CC_ART1873_1 in CC_COURANT {
    label fr official "Article 1873-1";
    kind article;
    locator "article/1873-1";
    text fr official """Article 1873-1
Ceux qui ont des droits à exercer sur des biens indivis, à titre de propriétaires, de nus-propriétaires ou d'usufruitiers peuvent passer des conventions relatives à l'exercice de ces droits.
""";
    content_hash "sha256:9f922d73bd86373094da1bc3afc9044e3f1b886ccdfe93bcdc61aa96a0951635";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_2")
pub fragment CC_ART1873_2 in CC_COURANT {
    label fr official "Article 1873-2";
    kind article;
    locator "article/1873-2";
    text fr official """Article 1873-2
Les coïndivisaires, s'ils y consentent tous, peuvent convenir de demeurer dans l'indivision.
A peine de nullité, la convention doit être établie par un écrit comportant la désignation des biens indivis et l'indication des quotes-parts appartenant à chaque indivisaire. Si les biens indivis comprennent des créances, il y a lieu aux formalités de l'article 1690 ; s'ils comprennent des immeubles, aux formalités de la publicité foncière.
""";
    content_hash "sha256:84392072b1333e8592b90489e60580534948fa3a10c4ab5077008b192408926b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_3")
pub fragment CC_ART1873_3 in CC_COURANT {
    label fr official "Article 1873-3";
    kind article;
    locator "article/1873-3";
    text fr official """Article 1873-3
La convention peut être conclue pour une durée déterminée qui ne saurait être supérieure à cinq ans. Elle est renouvelable par une décision expresse des parties. Le partage ne peut être provoqué avant le terme convenu qu'autant qu'il y en a de justes motifs.
La convention peut également être conclue pour une durée indéterminée. Le partage peut, en ce cas, être provoqué à tout moment, pourvu que ce ne soit pas de mauvaise foi ou à contretemps.
Il peut être décidé que la convention à durée déterminée se renouvellera par tacite reconduction pour une durée déterminée ou indéterminée. A défaut d'un pareil accord, l'indivision sera régie par les articles 815 et suivants à l'expiration de la convention à durée déterminée.
""";
    content_hash "sha256:6ad35e518922b6a318c39d345231b5e085f3f6d8e9219f25af33ba9b6909f6a6";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_4")
pub fragment CC_ART1873_4 in CC_COURANT {
    label fr official "Article 1873-4";
    kind article;
    locator "article/1873-4";
    text fr official """Article 1873-4
La convention tendant au maintien de l'indivision requiert la capacité ou le pouvoir de disposer des biens indivis.
Elle peut, toutefois, être conclue au nom d'un mineur, par son représentant légal seul ; mais, dans ce cas, le mineur devenu majeur peut y mettre fin, quelle qu'en soit la durée, dans l'année qui suit sa majorité.
""";
    content_hash "sha256:f5b3a42eefd24eb818a1c1fdc3f4d95c92d9cf001f25916fb4a71bc16ded1c0f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_5")
pub fragment CC_ART1873_5 in CC_COURANT {
    label fr official "Article 1873-5";
    kind article;
    locator "article/1873-5";
    text fr official """Article 1873-5
Les coïndivisaires peuvent nommer un ou plusieurs gérants, choisis ou non parmi eux. Les modalités de désignation et de révocation du gérant peuvent être déterminées par une décision unanime des indivisaires.
A défaut d'un tel accord, le gérant pris parmi les indivisaires ne peut être révoqué de ses fonctions que par une décision unanime des autres indivisaires.
Le gérant, qui n'est pas indivisaire, peut être révoqué dans les conditions convenues entre ses mandants ou, à défaut, par une décision prise à la majorité des indivisaires en nombre et en parts. Dans tous les cas, la révocation peut être prononcée par le tribunal à la demande d'un indivisaire lorsque le gérant, par ses fautes de gestion, met en péril les intérêts de l'indivision.
Si le gérant révoqué est un indivisaire, la convention sera réputée conclue pour une durée indéterminée à compter de sa révocation.
""";
    content_hash "sha256:14be3baf34c3dac71c1a57bdb3ab62b9de9260b507c65330b4ad952e1f4b6cd8";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_6")
pub fragment CC_ART1873_6 in CC_COURANT {
    label fr official "Article 1873-6";
    kind article;
    locator "article/1873-6";
    text fr official """Article 1873-6
Le gérant représente les indivisaires dans la mesure de ses pouvoirs, soit pour les actes de la vie civile, soit en justice, tant en demandant qu'en défendant. Il est tenu d'indiquer, à titre purement énonciatif, le nom de tous les indivisaires dans le premier acte de procédure.
Le gérant administre l'indivision et exerce, à cet effet, les pouvoirs attribués à chaque époux sur les biens communs. Il ne peut, toutefois, disposer des meubles corporels que pour les besoins d'une exploitation normale des biens indivis, ou encore s'il s'agit de choses difficiles à conserver ou sujettes à dépérissement. Toute clause extensive des pouvoirs du gérant est réputée non écrite.
""";
    content_hash "sha256:682a595aad7d710580889415f939a2dda43139ab723dad443a65945d6945fc7e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_7")
pub fragment CC_ART1873_7 in CC_COURANT {
    label fr official "Article 1873-7";
    kind article;
    locator "article/1873-7";
    text fr official """Article 1873-7
Le gérant exerce les pouvoirs qu'il tient de l'article précédent lors même qu'il existe un incapable parmi les indivisaires.
Néanmoins, l'article 456, alinéa 3, est applicable aux baux consentis au cours de l'indivision.
""";
    content_hash "sha256:6caf5123d3a907594f67bd2d09506aa3e7361cbedc2a359933ad681f6eb87065";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_8")
pub fragment CC_ART1873_8 in CC_COURANT {
    label fr official "Article 1873-8";
    kind article;
    locator "article/1873-8";
    text fr official """Article 1873-8
Les décisions qui excèdent les pouvoirs du gérant sont prises à l'unanimité, sauf au gérant, s'il est lui-même indivisaire, à exercer les recours prévus par les articles 815-4,815-5 et 815-6.
S'il existe des incapables mineurs ou majeurs parmi les indivisaires, les décisions dont il est parlé à l'alinéa précédent donnent lieu à l'application des règles de protection prévues en leur faveur.
Il peut être convenu entre les indivisaires qu'en l'absence d'incapables certaines catégories de décisions seront prises autrement qu'à l'unanimité. Toutefois, aucun immeuble indivis ne peut être aliéné sans l'accord de tous les indivisaires, si ce n'est en application des articles 815-4 et 815-5 ci-dessus.
""";
    content_hash "sha256:97e44eba013b079025ba9c3621c1ed148a1b4684fbdfc198e663b9877f04c324";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_9")
pub fragment CC_ART1873_9 in CC_COURANT {
    label fr official "Article 1873-9";
    kind article;
    locator "article/1873-9";
    text fr official """Article 1873-9
La convention d'indivision peut régler le mode d'administration en cas de pluralité de gérants. A défaut de stipulations spéciales, ceux-ci détiennent séparément les pouvoirs prévus à l'article 1873-6, sauf le droit pour chacun de s'opposer à toute opération avant qu'elle ne soit conclue.
""";
    content_hash "sha256:494ee8605719b6610bc7f0399097db50c1358bbbb3f324f3b2b84c598aedf2ad";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_10")
pub fragment CC_ART1873_10 in CC_COURANT {
    label fr official "Article 1873-10";
    kind article;
    locator "article/1873-10";
    text fr official """Article 1873-10
Le gérant a droit, sauf accord contraire, à la rémunération de son travail. Les conditions en sont fixées par les indivisaires, à l'exclusion de l'intéressé, ou, à défaut par le président du tribunal judiciaire statuant à titre provisionnel.
Le gérant répond, comme un mandataire, des fautes qu'il commet dans sa gestion.
""";
    content_hash "sha256:d85f4173ec0c9eacc29fbdd7fb77a27d6bc95799c941bec7bba84b190bfbcfef";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_11")
pub fragment CC_ART1873_11 in CC_COURANT {
    label fr official "Article 1873-11";
    kind article;
    locator "article/1873-11";
    text fr official """Article 1873-11
Chaque indivisaire peut exiger la communication de tous les documents relatifs à la gestion. Le gérant doit, une fois par an, rendre compte de sa gestion aux indivisaires. A cette occasion, il indique par écrit les bénéfices réalisés et les pertes encourues ou prévisibles.
Chaque indivisaire est tenu de participer aux dépenses de conservation des biens indivis. A défaut d'accord particulier, les articles 815-9,815-10 et 815-11 du présent code sont applicables à l'exercice du droit d'usage et de jouissance, ainsi qu'à la répartition des bénéfices et des pertes.
""";
    content_hash "sha256:130e3ff78ae0715455a1b3b1c156bfee6947cddb1e12e0a41fde4be43a5bf8ef";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_12")
pub fragment CC_ART1873_12 in CC_COURANT {
    label fr official "Article 1873-12";
    kind article;
    locator "article/1873-12";
    text fr official """Article 1873-12
En cas d'aliénation de tout ou partie des droits d'un indivisaire dans les biens indivis, ou dans un ou plusieurs de ces biens, les coïndivisaires bénéficient des droits de préemption et de substitution prévus par les articles 815-14 à 815-16 et 815-18 du présent code.
La convention est réputée conclue pour une durée indéterminée lorsque, pour quelque cause que ce soit, une part indivise est dévolue à une personne étrangère à l'indivision.
""";
    content_hash "sha256:b78529466774cc3b6c1e98d27d91a2822c923d4ef383a184079e495830190c62";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_13")
pub fragment CC_ART1873_13 in CC_COURANT {
    label fr official "Article 1873-13";
    kind article;
    locator "article/1873-13";
    text fr official """Article 1873-13
Les indivisaires peuvent convenir qu'au décès de l'un d'eux, chacun des survivants pourra acquérir la quote-part du défunt, ou que le conjoint survivant, ou tout autre héritier désigné, pourra se la faire attribuer à charge d'en tenir compte à la succession d'après sa valeur à l'époque de l'acquisition ou de l'attribution.
Si plusieurs indivisaires ou plusieurs héritiers exercent simultanément leur faculté d'acquisition ou d'attribution, ils sont réputés, sauf convention contraire, acquérir ensemble la part du défunt à proportion de leurs droits respectifs dans l'indivision ou la succession.
Les dispositions du présent article ne peuvent préjudicier à l'application des dispositions des articles 831 à 832-2.
""";
    content_hash "sha256:8f6404790e5a8970f7ca2e9b30ed1ec1a87685c66cb43feca0c7669ea00df120";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_14")
pub fragment CC_ART1873_14 in CC_COURANT {
    label fr official "Article 1873-14";
    kind article;
    locator "article/1873-14";
    text fr official """Article 1873-14
La faculté d'acquisition ou d'attribution est caduque si son bénéficiaire ne l'a pas exercée par une notification faite aux indivisaires survivants et aux héritiers du prédécédé dans le délai d'un mois à compter du jour où il aura été mis en demeure de prendre parti. Cette mise en demeure ne peut elle-même avoir lieu avant l'expiration du délai prévu au titre " Des successions " pour faire inventaire et délibérer.
Lorsqu'il n'a pas été prévu de faculté d'acquisition ou d'attribution, ou que celle-ci est caduque, la quote-part du défunt échoit à ses héritiers ou légataires. En pareil cas, la convention d'indivision sera réputée conclue pour une durée indéterminée à compter de l'ouverture de la succession.
""";
    content_hash "sha256:1c94f46cf7c335d166a3478477f6066027163bfdb850f9bbcd76969d2f57ce02";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_15")
pub fragment CC_ART1873_15 in CC_COURANT {
    label fr official "Article 1873-15";
    kind article;
    locator "article/1873-15";
    text fr official """Article 1873-15
L'article 815-17 est applicable aux créanciers de l'indivision, ainsi qu'aux créanciers personnels des indivisaires.
Toutefois, ces derniers ne peuvent provoquer le partage que dans les cas où leur débiteur pourrait lui-même le provoquer. Dans les autres cas, ils peuvent poursuivre la saisie et la vente de la quote-part de leur débiteur dans l'indivision en suivant les formes prévues par le code de procédure civile. Les dispositions de l'article 1873-12 sont alors applicables.
""";
    content_hash "sha256:7e155f23e0a4fc36ef594fa7048b4a70c80b706304fe5fe2ba53baebfe376880";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_16")
pub fragment CC_ART1873_16 in CC_COURANT {
    label fr official "Article 1873-16";
    kind article;
    locator "article/1873-16";
    text fr official """Article 1873-16
Lorsque les biens indivis sont grevés d'un usufruit, des conventions, soumises en principe aux dispositions du chapitre précédent, peuvent être conclues, soit entre les nus-propriétaires, soit entre les usufruitiers, soit entre les uns et les autres. Il peut y avoir pareillement convention entre ceux qui sont en indivision pour la jouissance et celui qui est nu-propriétaire de tous les biens, de même qu'entre l'usufruitier universel et les nus-propriétaires.
""";
    content_hash "sha256:bc3f48e640448b7937ea8f049e69eed7adec217b3a7d731c39b4d054561671b1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_17")
pub fragment CC_ART1873_17 in CC_COURANT {
    label fr official "Article 1873-17";
    kind article;
    locator "article/1873-17";
    text fr official """Article 1873-17
Lorsque les usufruitiers n'ont pas été parties à la convention, les tiers qui ont traité avec le gérant de l'indivision ne peuvent se prévaloir au préjudice des droits d'usufruit des pouvoirs qui lui auraient été conférés par les nus-propriétaires.
""";
    content_hash "sha256:bd9611373be6963fc51a3487353bff5051def323de2a2e0f2cbc7c6a61ce7d01";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1873_18")
pub fragment CC_ART1873_18 in CC_COURANT {
    label fr official "Article 1873-18";
    kind article;
    locator "article/1873-18";
    text fr official """Article 1873-18
Lorsque la convention passée entre usufruitiers et nus-propriétaires prévoit que des décisions seront prises à la majorité en nombre et en parts, le droit de vote afférent aux parts est divisé par moitié entre l'usufruit et la nue-propriété, à moins que les parties n'en soient autrement convenues.
Toute dépense excédant les obligations de l'usufruitier, telles qu'elles sont définies par les articles 582 et suivants, ne l'engage qu'avec son consentement donné dans la convention elle-même ou par un acte ultérieur.
L'aliénation de la pleine propriété des biens indivis ne peut être faite sans l'accord de l'usufruitier, sauf le cas où elle est provoquée par les créanciers habiles à poursuivre la vente.
""";
    content_hash "sha256:a8da179432dbc27681e09531ffbe28102d3e73449aa25ff890af8ea467d6cf89";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1874")
pub fragment CC_ART1874 in CC_COURANT {
    label fr official "Article 1874";
    kind article;
    locator "article/1874";
    text fr official """Article 1874
Il y a deux sortes de prêt :
Celui des choses dont on peut user sans les détruire ;
Et celui des choses qui se consomment par l'usage qu'on en fait.
La première espèce s'appelle " prêt à usage ".
La deuxième s'appelle " prêt de consommation ", ou simplement " prêt ".
""";
    content_hash "sha256:0913c62d1aa4b544d47d8d18c4cd415c07a15cd7f95118c18529362a3f2143ec";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1875")
pub fragment CC_ART1875 in CC_COURANT {
    label fr official "Article 1875";
    kind article;
    locator "article/1875";
    text fr official """Article 1875
Le prêt à usage est un contrat par lequel l'une des parties livre une chose à l'autre pour s'en servir, à la charge par le preneur de la rendre après s'en être servi.
""";
    content_hash "sha256:9c3f1d40a5ebf5cd0120029c7b8964d9e98050017cfbf9ea61fb1dd649c96c69";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1876")
pub fragment CC_ART1876 in CC_COURANT {
    label fr official "Article 1876";
    kind article;
    locator "article/1876";
    text fr official """Article 1876
Ce prêt est essentiellement gratuit.
""";
    content_hash "sha256:3593c00d41f8d1d6a23e83fb088a8ba59e5079bfd475fa6b3c886037b804674f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1877")
pub fragment CC_ART1877 in CC_COURANT {
    label fr official "Article 1877";
    kind article;
    locator "article/1877";
    text fr official """Article 1877
Le prêteur demeure propriétaire de la chose prêtée.
""";
    content_hash "sha256:2273289eb521c49ff5c7c05841c6d29af333336100869636d6940b4919626b54";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1878")
pub fragment CC_ART1878 in CC_COURANT {
    label fr official "Article 1878";
    kind article;
    locator "article/1878";
    text fr official """Article 1878
Tout ce qui est dans le commerce, et qui ne se consomme pas par l'usage, peut être l'objet de cette convention.
""";
    content_hash "sha256:f8575590ed85b185debe5b853096e90b8ebbee131ed5054adaa3edf7b1daf956";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1879")
pub fragment CC_ART1879 in CC_COURANT {
    label fr official "Article 1879";
    kind article;
    locator "article/1879";
    text fr official """Article 1879
Les engagements qui se forment par le prêt à usage passent aux héritiers de celui qui prête, et aux héritiers de celui qui emprunte.
Mais si l'on n'a prêté qu'en considération de l'emprunteur, et à lui personnellement, alors ses héritiers ne peuvent continuer de jouir de la chose prêtée.
""";
    content_hash "sha256:5142ab7d4c82aeca17576c0343e0e331abbc881351ffd11cae4e4301233abacb";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1880")
pub fragment CC_ART1880 in CC_COURANT {
    label fr official "Article 1880";
    kind article;
    locator "article/1880";
    text fr official """Article 1880
L'emprunteur est tenu de veiller raisonnablement à la garde et à la conservation de la chose prêtée. Il ne peut s'en servir qu'à l'usage déterminé par sa nature ou par la convention ; le tout à peine de dommages-intérêts, s'il y a lieu.
""";
    content_hash "sha256:c9a70467c38026a9abfdb4e723c3c6a3567ed42aca1bc8105710ee3a1e93092d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1881")
pub fragment CC_ART1881 in CC_COURANT {
    label fr official "Article 1881";
    kind article;
    locator "article/1881";
    text fr official """Article 1881
Si l'emprunteur emploie la chose à un autre usage, ou pour un temps plus long qu'il ne le devait, il sera tenu de la perte arrivée, même par cas fortuit.
""";
    content_hash "sha256:7db7eab791147036664d470d17230590931f77e23fc4ceaa11c487079278ac14";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1882")
pub fragment CC_ART1882 in CC_COURANT {
    label fr official "Article 1882";
    kind article;
    locator "article/1882";
    text fr official """Article 1882
Si la chose prêtée périt par cas fortuit dont l'emprunteur aurait pu la garantir en employant la sienne propre, ou si, ne pouvant conserver que l'une des deux, il a préféré la sienne, il est tenu de la perte de l'autre.
""";
    content_hash "sha256:b4965aa1a39dba70cb5fbd6d12579118e0f3d26d52b67d3fe5e38d00a6651513";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1883")
pub fragment CC_ART1883 in CC_COURANT {
    label fr official "Article 1883";
    kind article;
    locator "article/1883";
    text fr official """Article 1883
Si la chose a été estimée en la prêtant, la perte qui arrive, même par cas fortuit, est pour l'emprunteur, s'il n'y a convention contraire.
""";
    content_hash "sha256:9c86d33e785769b39c577e088bf5d527b4604750e839964c05c26329aebf0c5c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1884")
pub fragment CC_ART1884 in CC_COURANT {
    label fr official "Article 1884";
    kind article;
    locator "article/1884";
    text fr official """Article 1884
Si la chose se détériore par le seul effet de l'usage pour lequel elle a été empruntée, et sans aucune faute de la part de l'emprunteur, il n'est pas tenu de la détérioration.
""";
    content_hash "sha256:b94e59a35b46b67bc47b13bf53bb80d7d5b029ed80967f9a8b1c39300e6e6050";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1885")
pub fragment CC_ART1885 in CC_COURANT {
    label fr official "Article 1885";
    kind article;
    locator "article/1885";
    text fr official """Article 1885
L'emprunteur ne peut pas retenir la chose par compensation de ce que le prêteur lui doit.
""";
    content_hash "sha256:a98591d5fde42b48779cdbc43f8c36999a416141cb77276f12e2cebbe87a5bb1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1886")
pub fragment CC_ART1886 in CC_COURANT {
    label fr official "Article 1886";
    kind article;
    locator "article/1886";
    text fr official """Article 1886
Si, pour user de la chose, l'emprunteur a fait quelque dépense, il ne peut pas la répéter.
""";
    content_hash "sha256:23f0b4b1587278ff1150e0a1dce75618ced5896242c2a853e5c67cd532b17996";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1887")
pub fragment CC_ART1887 in CC_COURANT {
    label fr official "Article 1887";
    kind article;
    locator "article/1887";
    text fr official """Article 1887
Si plusieurs ont conjointement emprunté la même chose, ils en sont solidairement responsables envers le prêteur.
""";
    content_hash "sha256:75d509024165cacf2aee110c3e17ae9f432e59a88705ab223ac88e4b31a8aad0";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1888")
pub fragment CC_ART1888 in CC_COURANT {
    label fr official "Article 1888";
    kind article;
    locator "article/1888";
    text fr official """Article 1888
Le prêteur ne peut retirer la chose prêtée qu'après le terme convenu, ou, à défaut de convention, qu'après qu'elle a servi à l'usage pour lequel elle a été empruntée.
""";
    content_hash "sha256:d8460466eb5a0ecf9b53878244ede46ac26eed02a82c9bb9e619414f08463393";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1889")
pub fragment CC_ART1889 in CC_COURANT {
    label fr official "Article 1889";
    kind article;
    locator "article/1889";
    text fr official """Article 1889
Néanmoins, si, pendant ce délai, ou avant que le besoin de l'emprunteur ait cessé, il survient au prêteur un besoin pressant et imprévu de sa chose, le juge peut, suivant les circonstances, obliger l'emprunteur à la lui rendre.
""";
    content_hash "sha256:261e98528f1a2beb6519f91f51ff79788599909febf52e79373c40a067112bfc";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1890")
pub fragment CC_ART1890 in CC_COURANT {
    label fr official "Article 1890";
    kind article;
    locator "article/1890";
    text fr official """Article 1890
Si, pendant la durée du prêt, l'emprunteur a été obligé, pour la conservation de la chose, à quelque dépense extraordinaire, nécessaire, et tellement urgente qu'il n'ait pas pu en prévenir le prêteur, celui-ci sera tenu de la lui rembourser.
""";
    content_hash "sha256:926fa6bdc8369957dcdab54095244410a5dcb4501f1636fa1cfe79a7518c632e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1891")
pub fragment CC_ART1891 in CC_COURANT {
    label fr official "Article 1891";
    kind article;
    locator "article/1891";
    text fr official """Article 1891
Lorsque la chose prêtée a des défauts tels qu'elle puisse causer du préjudice à celui qui s'en sert le prêteur est responsable, s'il connaissait les défauts et n'en a pas averti l'emprunteur.
""";
    content_hash "sha256:18d1ef827b17d0b866fd95eb27c462cf7205ab0d3986843e8faa863894108ea5";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1892")
pub fragment CC_ART1892 in CC_COURANT {
    label fr official "Article 1892";
    kind article;
    locator "article/1892";
    text fr official """Article 1892
Le prêt de consommation est un contrat par lequel l'une des parties livre à l'autre une certaine quantité de choses qui se consomment par l'usage, à la charge par cette dernière de lui en rendre autant de même espèce et qualité.
""";
    content_hash "sha256:7c13572256867193e9b15ec269b978e9866c81d465e020c7cc658df5039bd0dc";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1893")
pub fragment CC_ART1893 in CC_COURANT {
    label fr official "Article 1893";
    kind article;
    locator "article/1893";
    text fr official """Article 1893
Par l'effet de ce prêt, l'emprunteur devient le propriétaire de la chose prêtée ; et c'est pour lui qu'elle périt, de quelque manière que cette perte arrive.
""";
    content_hash "sha256:248979a15eea4b218288cd237badb6cd7da667714a1b19756623c22f05b0c95d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1894")
pub fragment CC_ART1894 in CC_COURANT {
    label fr official "Article 1894";
    kind article;
    locator "article/1894";
    text fr official """Article 1894
On ne peut pas donner à titre de prêt de consommation des choses qui, quoique de même espèce, sont différentes, comme les animaux : alors c'est un prêt à usage.
""";
    content_hash "sha256:371649310633608e68f4ec55e9d58788f95f6e7b109c418fc87ef2682d2c5f2c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1895")
pub fragment CC_ART1895 in CC_COURANT {
    label fr official "Article 1895";
    kind article;
    locator "article/1895";
    text fr official """Article 1895
L'obligation qui résulte d'un prêt en argent n'est toujours que de la somme énoncée au contrat.
S'il y a eu augmentation ou diminution d'espèces avant l'époque du paiement, le débiteur doit rendre la somme prêtée, et ne doit rendre que cette somme dans les espèces ayant cours au moment du paiement.
""";
    content_hash "sha256:d47c300ef5ce7cd8a6c73006dba46ac5f4e180ad7831f8b1315e8907598e00ad";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1896")
pub fragment CC_ART1896 in CC_COURANT {
    label fr official "Article 1896";
    kind article;
    locator "article/1896";
    text fr official """Article 1896
La règle portée en l'article précédent n'a pas lieu si le prêt a été fait en lingots.
""";
    content_hash "sha256:1ce497006b89b4de4ef454745291dcd7c548d162e5bae34411389e013eaf7180";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1897")
pub fragment CC_ART1897 in CC_COURANT {
    label fr official "Article 1897";
    kind article;
    locator "article/1897";
    text fr official """Article 1897
Si ce sont des lingots ou des denrées qui ont été prêtés, quelle que soit l'augmentation ou la diminution de leur prix, le débiteur doit toujours rendre la même quantité et qualité, et ne doit rendre que cela.
""";
    content_hash "sha256:a1964ee7a7c6e2c87c16cdca6f8545efb3e03d2fbff22383f4eaf74af252bd4d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1898")
pub fragment CC_ART1898 in CC_COURANT {
    label fr official "Article 1898";
    kind article;
    locator "article/1898";
    text fr official """Article 1898
Dans le prêt de consommation, le prêteur est tenu de la responsabilité établie par l'article 1891 pour le prêt à usage.
""";
    content_hash "sha256:bb7cfe9b5e642e401dda06f2a8bac49efe5dff756610645581c2a496f0f2c82c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1899")
pub fragment CC_ART1899 in CC_COURANT {
    label fr official "Article 1899";
    kind article;
    locator "article/1899";
    text fr official """Article 1899
Le prêteur ne peut pas redemander les choses prêtées avant le terme convenu.
""";
    content_hash "sha256:af281b2a34217a65fecc18cd51adf423545d16d90feb7e4c64c4c7a181081b0e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1900")
pub fragment CC_ART1900 in CC_COURANT {
    label fr official "Article 1900";
    kind article;
    locator "article/1900";
    text fr official """Article 1900
S'il n'a pas été fixé de terme pour la restitution, le juge peut accorder à l'emprunteur un délai suivant les circonstances.
""";
    content_hash "sha256:7783b2da269a58ae8bea82783bb47f1a7b81b65d57b91bcaadebc5af38de5b33";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1901")
pub fragment CC_ART1901 in CC_COURANT {
    label fr official "Article 1901";
    kind article;
    locator "article/1901";
    text fr official """Article 1901
S'il a été seulement convenu que l'emprunteur payerait quand il le pourrait, ou quand il en aurait les moyens, le juge lui fixera un terme de paiement suivant les circonstances.
""";
    content_hash "sha256:f7877151019aa940e15c49e617808021269e129b987ce813a8ec7ab2762843db";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1902")
pub fragment CC_ART1902 in CC_COURANT {
    label fr official "Article 1902";
    kind article;
    locator "article/1902";
    text fr official """Article 1902
L'emprunteur est tenu de rendre les choses prêtées, en même quantité et qualité, et au terme convenu.
""";
    content_hash "sha256:addb85dd591c20a27cbd65df6cbd0ead298520b2206fd74ee5dc41747e706fe0";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1903")
pub fragment CC_ART1903 in CC_COURANT {
    label fr official "Article 1903";
    kind article;
    locator "article/1903";
    text fr official """Article 1903
S'il est dans l'impossibilité d'y satisfaire, il est tenu d'en payer la valeur eu égard au temps et au lieu où la chose devait être rendue d'après la convention.
Si ce temps et ce lieu n'ont pas été réglés, le paiement se fait au prix du temps et du lieu où l'emprunt a été fait.
""";
    content_hash "sha256:8fb9a6d7542bb39072a3b8a3f2e91cfb9b0a3788a3ab6de115d4dcc5b34ec947";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1904")
pub fragment CC_ART1904 in CC_COURANT {
    label fr official "Article 1904";
    kind article;
    locator "article/1904";
    text fr official """Article 1904
Si l'emprunteur ne rend pas les choses prêtées ou leur valeur au terme convenu, il en doit l'intérêt du jour de la sommation ou de la demande en justice.
""";
    content_hash "sha256:42af731bc7e169d4962e79ac17667040477bd4a508983f3067a604066b9ef785";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1905")
pub fragment CC_ART1905 in CC_COURANT {
    label fr official "Article 1905";
    kind article;
    locator "article/1905";
    text fr official """Article 1905
Il est permis de stipuler des intérêts pour simple prêt soit d'argent, soit de denrées, ou autres choses mobilières.
""";
    content_hash "sha256:ddb5bcad730642bb9356f8bfa08697ffd3753ecaa8adf3945857ae7adb0d5c25";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1906")
pub fragment CC_ART1906 in CC_COURANT {
    label fr official "Article 1906";
    kind article;
    locator "article/1906";
    text fr official """Article 1906
L'emprunteur qui a payé des intérêts qui n'étaient pas stipulés ne peut ni les répéter ni les imputer sur le capital.
""";
    content_hash "sha256:def9860a1b89754425d3e4407f307545eec0d0e67baab572df6e9f947c1f3372";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1907")
pub fragment CC_ART1907 in CC_COURANT {
    label fr official "Article 1907";
    kind article;
    locator "article/1907";
    text fr official """Article 1907
L'intérêt est légal ou conventionnel. L'intérêt légal est fixé par la loi. L'intérêt conventionnel peut excéder celui de la loi, toutes les fois que la loi ne le prohibe pas.
Le taux de l'intérêt conventionnel doit être fixé par écrit.
""";
    content_hash "sha256:81112ed4c0edf0a0fd484f00f828b21ebf51573225bc2b39374d8deaea322ce2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1908")
pub fragment CC_ART1908 in CC_COURANT {
    label fr official "Article 1908";
    kind article;
    locator "article/1908";
    text fr official """Article 1908
La quittance du capital donnée sans réserve des intérêts en fait présumer le paiement et en opère la libération.
""";
    content_hash "sha256:08dfa99b46458f817c1a039c931f3517495ad59c6a0c5142a46acd7936cfa50a";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1909")
pub fragment CC_ART1909 in CC_COURANT {
    label fr official "Article 1909";
    kind article;
    locator "article/1909";
    text fr official """Article 1909
On peut stipuler un intérêt moyennant un capital que le prêteur s'interdit d'exiger.
Dans ce cas, le prêt prend le nom de " constitution de rente ".
""";
    content_hash "sha256:a74dca2027ce2efa7a8bb1eef39d08a28987219decf583b9c4e510ce79cd7652";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1910")
pub fragment CC_ART1910 in CC_COURANT {
    label fr official "Article 1910";
    kind article;
    locator "article/1910";
    text fr official """Article 1910
Cette rente peut être constituée de deux manières, en perpétuel ou en viager.
""";
    content_hash "sha256:fe1db435440656019c9a9fdcd9643aed922d5dfb489a92ad483d08a67805d2f8";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1911")
pub fragment CC_ART1911 in CC_COURANT {
    label fr official "Article 1911";
    kind article;
    locator "article/1911";
    text fr official """Article 1911
La rente constituée en perpétuel est essentiellement rachetable.
Les parties peuvent seulement convenir que le rachat ne sera pas fait avant un délai qui ne pourra excéder dix ans, ou sans avoir averti le créancier au terme d'avance qu'elles auront déterminé.
""";
    content_hash "sha256:214dcc1e7d730c3138aee5304471beba0ed174340f9a40922c1dbace2fce7f6c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1912")
pub fragment CC_ART1912 in CC_COURANT {
    label fr official "Article 1912";
    kind article;
    locator "article/1912";
    text fr official """Article 1912
Le débiteur d'une rente constituée en perpétuel peut être contraint au rachat :
1° S'il cesse de remplir ses obligations pendant deux années ;
2° S'il manque à fournir au prêteur les sûretés promises par le contrat.
""";
    content_hash "sha256:9570e571d387c1a46fc2c7a723453aa578386c8882ebfea77609513a541c68e8";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1913")
pub fragment CC_ART1913 in CC_COURANT {
    label fr official "Article 1913";
    kind article;
    locator "article/1913";
    text fr official """Article 1913
Le capital de la rente constituée en perpétuel devient aussi exigible en cas de faillite ou de déconfiture du débiteur.
""";
    content_hash "sha256:26f01f2c9d59c691a8c7ac778af8a232f9030629a00035d460b7327454482c25";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1914")
pub fragment CC_ART1914 in CC_COURANT {
    label fr official "Article 1914";
    kind article;
    locator "article/1914";
    text fr official """Article 1914
Les règles concernant les rentes viagères sont établies au titre " Des contrats aléatoires ".
""";
    content_hash "sha256:c5fab8cce814f8636ea76323dee1b7b5a35824842ea3b950cbd8cec0a1b21260";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1915")
pub fragment CC_ART1915 in CC_COURANT {
    label fr official "Article 1915";
    kind article;
    locator "article/1915";
    text fr official """Article 1915
Le dépôt, en général, est un acte par lequel on reçoit la chose d'autrui, à la charge de la garder et de la restituer en nature.
""";
    content_hash "sha256:ec7cc5f3d6d65645db80adace78bbda14a6c02c0667852d318d657cf043c0299";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1916")
pub fragment CC_ART1916 in CC_COURANT {
    label fr official "Article 1916";
    kind article;
    locator "article/1916";
    text fr official """Article 1916
Il y a deux espèces de dépôt : le dépôt proprement dit et le séquestre.
""";
    content_hash "sha256:fddf11311a9878f33d8fe261df861f794169a9e4b6140556d23ab2558d100419";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1917")
pub fragment CC_ART1917 in CC_COURANT {
    label fr official "Article 1917";
    kind article;
    locator "article/1917";
    text fr official """Article 1917
Le dépôt proprement dit est un contrat essentiellement gratuit.
""";
    content_hash "sha256:d7e09fffcf359336ef109680271275d6e67220bd679a63d8e1f99de7482789c2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1918")
pub fragment CC_ART1918 in CC_COURANT {
    label fr official "Article 1918";
    kind article;
    locator "article/1918";
    text fr official """Article 1918
Il ne peut avoir pour objet que des choses mobilières.
""";
    content_hash "sha256:e24615ce308410273fad4bb8141fecc079bbcf53672cfb50e1e3fa52edcc942e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1919")
pub fragment CC_ART1919 in CC_COURANT {
    label fr official "Article 1919";
    kind article;
    locator "article/1919";
    text fr official """Article 1919
Il n'est parfait que par la remise réelle ou fictive de la chose déposée.
La remise fictive suffit quand le dépositaire se trouve déjà nanti, à quelque autre titre, de la chose que l'on consent à lui laisser à titre de dépôt.
""";
    content_hash "sha256:cb877eb8de125870ebd05dc2d52aff73299bf6bb77939598e343b57332431ccd";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1920")
pub fragment CC_ART1920 in CC_COURANT {
    label fr official "Article 1920";
    kind article;
    locator "article/1920";
    text fr official """Article 1920
Le dépôt est volontaire ou nécessaire.
""";
    content_hash "sha256:496ad99205c71b64395d33f6adea09d4096d30406ce6553d5fb51fe3b519f787";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1921")
pub fragment CC_ART1921 in CC_COURANT {
    label fr official "Article 1921";
    kind article;
    locator "article/1921";
    text fr official """Article 1921
Le dépôt volontaire se forme par le consentement réciproque de la personne qui fait le dépôt et de celle qui le reçoit.
""";
    content_hash "sha256:1b39fea91d430ddfc0ab0fe34188db9ea7ae722271946dac884b875fdd503404";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1922")
pub fragment CC_ART1922 in CC_COURANT {
    label fr official "Article 1922";
    kind article;
    locator "article/1922";
    text fr official """Article 1922
Le dépôt volontaire ne peut régulièrement être fait que par le propriétaire de la chose déposée, ou de son consentement exprès ou tacite.
""";
    content_hash "sha256:511bb1b5b5f7873accf8d6fb0f13038d96747d04de04517df9823e2e49728fb1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1924")
pub fragment CC_ART1924 in CC_COURANT {
    label fr official "Article 1924";
    kind article;
    locator "article/1924";
    text fr official """Article 1924
Lorsque le dépôt étant au-dessus du chiffre prévu à l'article 1359 n'est point prouvé par écrit, celui qui est attaqué comme dépositaire en est cru sur sa déclaration soit pour le fait même du dépôt, soit pour la chose qui en faisait l'objet, soit pour le fait de sa restitution.
""";
    content_hash "sha256:2c82458420bb361fc44a03f868942ff30a9a8ebe28135c1c8720916d74e9102e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1925")
pub fragment CC_ART1925 in CC_COURANT {
    label fr official "Article 1925";
    kind article;
    locator "article/1925";
    text fr official """Article 1925
Le dépôt volontaire ne peut avoir lieu qu'entre personnes capables de contracter.
Néanmoins, si une personne capable de contracter accepte le dépôt fait par une personne incapable, elle est tenue de toutes les obligations d'un véritable dépositaire ; elle peut être poursuivie par le tuteur ou administrateur de la personne qui a fait le dépôt.
""";
    content_hash "sha256:f97c8d4e9001bbf7f80d581fec67fe91b453e3095ff065d667f97766f971c359";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1926")
pub fragment CC_ART1926 in CC_COURANT {
    label fr official "Article 1926";
    kind article;
    locator "article/1926";
    text fr official """Article 1926
Si le dépôt a été fait par une personne capable à une personne qui ne l'est pas, la personne qui a fait le dépôt n'a que l'action en revendication de la chose déposée, tant qu'elle existe dans la main du dépositaire, ou action en restitution jusqu'à concurrence de ce qui a tourné au profit de ce dernier.
""";
    content_hash "sha256:98530961d0afcb019567a20ceb98c500bb6d5f08db4069dc4d5368850b028f42";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1927")
pub fragment CC_ART1927 in CC_COURANT {
    label fr official "Article 1927";
    kind article;
    locator "article/1927";
    text fr official """Article 1927
Le dépositaire doit apporter, dans la garde de la chose déposée, les mêmes soins qu'il apporte dans la garde des choses qui lui appartiennent.
""";
    content_hash "sha256:e04bd48fecf500ccac9635b92ec77fb503de7f251a7fd96b3980c5dccc060135";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1928")
pub fragment CC_ART1928 in CC_COURANT {
    label fr official "Article 1928";
    kind article;
    locator "article/1928";
    text fr official """Article 1928
La disposition de l'article précédent doit être appliquée avec plus de rigueur :
1° si le dépositaire s'est offert lui-même pour recevoir le dépôt ;
2° s'il a stipulé un salaire pour la garde du dépôt ;
3° si le dépôt a été fait uniquement pour l'intérêt du dépositaire ;
4° s'il a été convenu expressément que le dépositaire répondrait de toute espèce de faute.
""";
    content_hash "sha256:8dc273c2ec5b5daa223ac56be65358f2d011af328813e124f63c67406765264b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1929")
pub fragment CC_ART1929 in CC_COURANT {
    label fr official "Article 1929";
    kind article;
    locator "article/1929";
    text fr official """Article 1929
Le dépositaire n'est tenu, en aucun cas, des accidents de force majeure, à moins qu'il n'ait été mis en demeure de restituer la chose déposée.
""";
    content_hash "sha256:cf3c1dac5580d98a5a84b148af6614712229df123961d7a2dde5306f45cec632";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1930")
pub fragment CC_ART1930 in CC_COURANT {
    label fr official "Article 1930";
    kind article;
    locator "article/1930";
    text fr official """Article 1930
Il ne peut se servir de la chose déposée sans la permission expresse ou présumée du déposant.
""";
    content_hash "sha256:ed1c0919af412ddfc5f0aaaa4ad20afb44d66a658607f5524b22a7d2e3f0a072";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1931")
pub fragment CC_ART1931 in CC_COURANT {
    label fr official "Article 1931";
    kind article;
    locator "article/1931";
    text fr official """Article 1931
Il ne doit point chercher à connaître quelles sont les choses qui lui ont été déposées si elles lui ont été confiées dans un coffre fermé ou sous une enveloppe cachetée.
""";
    content_hash "sha256:fb0be4d32fbe3d68ef2cd8670bec00cfc725de017a5872113ef8d478f8b0ec0b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1932")
pub fragment CC_ART1932 in CC_COURANT {
    label fr official "Article 1932";
    kind article;
    locator "article/1932";
    text fr official """Article 1932
Le dépositaire doit rendre identiquement la chose même qu'il a reçue.
Ainsi, le dépôt des sommes monnayées doit être rendu dans les mêmes espèces qu'il a été fait, soit dans le cas d'augmentation, soit dans le cas de diminution de leur valeur.
""";
    content_hash "sha256:d07bb2072ed0738ba57eae8e324df1e3eb2eb5aeb1db36f9f4d72bf481ac3f1b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1933")
pub fragment CC_ART1933 in CC_COURANT {
    label fr official "Article 1933";
    kind article;
    locator "article/1933";
    text fr official """Article 1933
Le dépositaire n'est tenu de rendre la chose déposée que dans l'état où elle se trouve au moment de la restitution. Les détériorations qui ne sont pas survenues par son fait sont à la charge du déposant.
""";
    content_hash "sha256:ef8b437cbeb301da3627fe7136f39d7ca38a1bb7249d8643e81c10bbf606621e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1934")
pub fragment CC_ART1934 in CC_COURANT {
    label fr official "Article 1934";
    kind article;
    locator "article/1934";
    text fr official """Article 1934
Le dépositaire auquel la chose a été enlevée par une force majeure et qui a reçu un prix ou quelque chose à la place doit restituer ce qu'il a reçu en échange.
""";
    content_hash "sha256:5f4f8b4314f292223327579fc26bb47b925a66db1de395c6ff6190772cca3c17";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1935")
pub fragment CC_ART1935 in CC_COURANT {
    label fr official "Article 1935";
    kind article;
    locator "article/1935";
    text fr official """Article 1935
L'héritier du dépositaire, qui a vendu de bonne foi la chose dont il ignorait le dépôt, n'est tenu que de rendre le prix qu'il a reçu, ou de céder son action contre l'acheteur, s'il n'a pas touché le prix.
""";
    content_hash "sha256:5a34874a554c049c003363bbe7ac1b1c690aab88e8ff088a9a64bc0f1b86f303";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1936")
pub fragment CC_ART1936 in CC_COURANT {
    label fr official "Article 1936";
    kind article;
    locator "article/1936";
    text fr official """Article 1936
Si la chose déposée a produit des fruits qui aient été perçus par le dépositaire, il est obligé de les restituer. Il ne doit aucun intérêt de l'argent déposé, si ce n'est du jour où il a été mis en demeure de faire la restitution.
""";
    content_hash "sha256:015ef8619a19863e0eaf1af07cf69fd1ca0bae26047999fd41be0691163dc5ba";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1937")
pub fragment CC_ART1937 in CC_COURANT {
    label fr official "Article 1937";
    kind article;
    locator "article/1937";
    text fr official """Article 1937
Le dépositaire ne doit restituer la chose déposée qu'à celui qui la lui a confiée, ou à celui au nom duquel le dépôt a été fait, ou à celui qui a été indiqué pour le recevoir.
""";
    content_hash "sha256:2c848b750524f59001e5972d5ddc195d4d423c577e1a83162e450568cbba54b3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1938")
pub fragment CC_ART1938 in CC_COURANT {
    label fr official "Article 1938";
    kind article;
    locator "article/1938";
    text fr official """Article 1938
Il ne peut pas exiger de celui qui a fait le dépôt, la preuve qu'il était propriétaire de la chose déposée.
Néanmoins, s'il découvre que la chose a été volée, et quel en est le véritable propriétaire, il doit dénoncer à celui-ci le dépôt qui lui a été fait avec sommation de le réclamer dans un délai déterminé et suffisant. Si celui auquel la dénonciation a été faite néglige de réclamer le dépôt, le dépositaire est valablement déchargé par la tradition qu'il en fait à celui duquel il l'a reçu.
""";
    content_hash "sha256:8446c4a12a086ff4145099124eae05b313215d7df79c0b66e9d9da3170b51e1a";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1939")
pub fragment CC_ART1939 in CC_COURANT {
    label fr official "Article 1939";
    kind article;
    locator "article/1939";
    text fr official """Article 1939
En cas de mort de la personne qui a fait le dépôt, la chose déposée ne peut être rendue qu'à son héritier.
S'il y a plusieurs héritiers, elle doit être rendue à chacun d'eux pour leur part et portion.
Si la chose déposée est indivisible, les héritiers doivent s'accorder entre eux pour la recevoir.
""";
    content_hash "sha256:02f146c64c1bbe23f57571285a2631572ea66cc8b94fb9c64ac6fdb7c3e00eab";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1940")
pub fragment CC_ART1940 in CC_COURANT {
    label fr official "Article 1940";
    kind article;
    locator "article/1940";
    text fr official """Article 1940
Si la personne qui a fait le dépôt a été dessaisie de ses pouvoirs d'administration, le dépôt ne peut être restitué qu'à celui qui a l'administration des biens du déposant.
""";
    content_hash "sha256:b8853d75d61670fa9f056eddeef15808124f074ad9601e8aca07eacb4bd953b3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1941")
pub fragment CC_ART1941 in CC_COURANT {
    label fr official "Article 1941";
    kind article;
    locator "article/1941";
    text fr official """Article 1941
Si le dépôt a été fait par un tuteur ou un administrateur, dans l'une de ces qualités, il ne peut être restitué qu'à la personne que ce tuteur ou cet administrateur représentaient, si leur gestion ou leur administration est finie.
""";
    content_hash "sha256:1474f161e9884809f79c1b516a5479e097860dad6001a89896b1cc7e5c9cc07c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1942")
pub fragment CC_ART1942 in CC_COURANT {
    label fr official "Article 1942";
    kind article;
    locator "article/1942";
    text fr official """Article 1942
Si le contrat de dépôt désigne le lieu dans lequel la restitution doit être faite, le dépositaire est tenu d'y porter la chose déposée. S'il y a des frais de transport, ils sont à la charge du déposant.
""";
    content_hash "sha256:21f476074944169d4e62c17cf487c0cfe6d0968ae8283765aa946335990c80b9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1943")
pub fragment CC_ART1943 in CC_COURANT {
    label fr official "Article 1943";
    kind article;
    locator "article/1943";
    text fr official """Article 1943
Si le contrat ne désigne point le lieu de la restitution, elle doit être faite dans le lieu même du dépôt.
""";
    content_hash "sha256:d0007c8a593c54d860757ba7200a47955fd1a1699ecce35309458dc2fa03c798";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1944")
pub fragment CC_ART1944 in CC_COURANT {
    label fr official "Article 1944";
    kind article;
    locator "article/1944";
    text fr official """Article 1944
Le dépôt doit être remis au déposant aussitôt qu'il le réclame, lors même que le contrat aurait fixé un délai déterminé pour la restitution ; à moins qu'il n'existe, entre les mains du dépositaire, une saisie ou une opposition à la restitution et au déplacement de la chose déposée.
""";
    content_hash "sha256:d4e5966edc31b2290d794c688cb32cdc665ab46bbd6e9e065f7a9667e80637b1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1945")
pub fragment CC_ART1945 in CC_COURANT {
    label fr official "Article 1945";
    kind article;
    locator "article/1945";
    text fr official """Article 1945
Le dépositaire infidèle n'est point admis au bénéfice de cession.
""";
    content_hash "sha256:6b8a197cc29fa090940b20723877057dee31f98e00727e5b44ae6f4268728c51";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1946")
pub fragment CC_ART1946 in CC_COURANT {
    label fr official "Article 1946";
    kind article;
    locator "article/1946";
    text fr official """Article 1946
Toutes les obligations du dépositaire cessent s'il vient à découvrir et à prouver qu'il est lui-même propriétaire de la chose déposée.
""";
    content_hash "sha256:4ae4a378f69d8582eaa03135c23b718c355ef7834d524d2b9a365623404232ef";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1947")
pub fragment CC_ART1947 in CC_COURANT {
    label fr official "Article 1947";
    kind article;
    locator "article/1947";
    text fr official """Article 1947
La personne qui a fait le dépôt est tenue de rembourser au dépositaire les dépenses qu'il a faites pour la conservation de la chose déposée, et de l'indemniser de toutes les pertes que le dépôt peut lui avoir occasionnées.
""";
    content_hash "sha256:7f1a64be5088e1c65af1cf1c3b0522c1d6f99c1eae3e21a5821b9a4bf10d7a69";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1948")
pub fragment CC_ART1948 in CC_COURANT {
    label fr official "Article 1948";
    kind article;
    locator "article/1948";
    text fr official """Article 1948
Le dépositaire peut retenir le dépôt jusqu'à l'entier paiement de ce qui lui est dû à raison du dépôt.
""";
    content_hash "sha256:e812b9a69358dc2d23dd9a30598df8ecb4aad5ca191122655d02391ea2e556ac";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1949")
pub fragment CC_ART1949 in CC_COURANT {
    label fr official "Article 1949";
    kind article;
    locator "article/1949";
    text fr official """Article 1949
Le dépôt nécessaire est celui qui a été forcé par quelque accident, tel qu'un incendie, une ruine, un pillage, un naufrage ou autre événement imprévu.
""";
    content_hash "sha256:3263dc64b90199f0d07daa03eba85cb975b8930d0701900a8cd90c213dde23c3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1950")
pub fragment CC_ART1950 in CC_COURANT {
    label fr official "Article 1950";
    kind article;
    locator "article/1950";
    text fr official """Article 1950
La preuve par témoins peut être reçue pour le dépôt nécessaire, même quand il s'agit d'une valeur supérieure au chiffre prévu à l'article 1359.
""";
    content_hash "sha256:0b092643edd2439cd1d4a66a70b9cb8968c7c8f1c1f49921e022746e458f787b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1951")
pub fragment CC_ART1951 in CC_COURANT {
    label fr official "Article 1951";
    kind article;
    locator "article/1951";
    text fr official """Article 1951
Le dépôt nécessaire est d'ailleurs régi par toutes les règles précédemment énoncées.
""";
    content_hash "sha256:f71ac2a3358c3b5d023d0067ce4818e9dd47805eef76105f8a882867b912c063";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1952")
pub fragment CC_ART1952 in CC_COURANT {
    label fr official "Article 1952";
    kind article;
    locator "article/1952";
    text fr official """Article 1952
Les aubergistes ou hôteliers répondent, comme dépositaires, des vêtements, bagages et objets divers apportés dans leur établissement par le voyageur qui loge chez eux ; le dépôt de ces sortes d'effets doit être regardé comme un dépôt nécessaire.
""";
    content_hash "sha256:454cb5439bc49ee3b0629cab6635c4c6a91bafe700d65d9ab761c1f0516a2834";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1953")
pub fragment CC_ART1953 in CC_COURANT {
    label fr official "Article 1953";
    kind article;
    locator "article/1953";
    text fr official """Article 1953
Ils sont responsables du vol ou du dommage de ces effets, soit que le vol ait été commis ou que le dommage ait été causé par leurs préposés, ou par des tiers allant et venant dans l'hôtel.
Cette responsabilité est illimitée, nonobstant toute clause contraire, au cas de vol ou de détérioration des objets de toute nature déposés entre leurs mains ou qu'ils ont refusé de recevoir sans motif légitime.
Dans tous les autres cas, les dommages-intérêts dus au voyageur sont, à l'exclusion de toute limitation conventionnelle inférieure, limités à l'équivalent de cent fois le prix de location du logement par journée, sauf lorsque le voyageur démontre que le préjudice qu'il a subi résulte d'une faute de celui qui l'héberge ou des personnes dont ce dernier doit répondre.
""";
    content_hash "sha256:26a08a3893cb08f94cc4995afdd1651a1a9a89985a09b9522ba72be36ba3fe6a";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1954")
pub fragment CC_ART1954 in CC_COURANT {
    label fr official "Article 1954";
    kind article;
    locator "article/1954";
    text fr official """Article 1954
Les aubergistes ou hôteliers ne sont pas responsables des vols ou dommages qui arrivent par force majeure, ni de la perte qui résulte de la nature ou d'un vice de la chose, à charge de démontrer le fait qu'ils allèguent.
Par dérogation aux dispositions de l'article 1953, les aubergistes ou hôteliers sont responsables des objets laissés dans les véhicules stationnés sur les lieux dont ils ont la jouissance privative à concurrence de cinquante fois le prix de location du logement par journée.
Les articles 1952 et 1953 ne s'appliquent pas aux animaux vivants.
""";
    content_hash "sha256:c48473eeb471bda2adbb1fcb7ef69bdaec013eb2af4680786cf1eee5f48b3a95";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1955")
pub fragment CC_ART1955 in CC_COURANT {
    label fr official "Article 1955";
    kind article;
    locator "article/1955";
    text fr official """Article 1955
Le séquestre est ou conventionnel ou judiciaire.
""";
    content_hash "sha256:99a420841cb9196e7b0e3ab175225b9b4312fe779779e3b6eec3d3b9a1934578";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1956")
pub fragment CC_ART1956 in CC_COURANT {
    label fr official "Article 1956";
    kind article;
    locator "article/1956";
    text fr official """Article 1956
Le séquestre conventionnel est le dépôt fait par une ou plusieurs personnes, d'une chose contentieuse, entre les mains d'un tiers qui s'oblige de la rendre, après la contestation terminée, à la personne qui sera jugée devoir l'obtenir.
""";
    content_hash "sha256:d53ddaff63a2920b2ef68e69d3975e68091bb5ed2b0013b203fbbf207403fa21";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1957")
pub fragment CC_ART1957 in CC_COURANT {
    label fr official "Article 1957";
    kind article;
    locator "article/1957";
    text fr official """Article 1957
Le séquestre peut n'être pas gratuit.
""";
    content_hash "sha256:5849a2efe59dd3d20ed61600dbeafbe6f873690bb68e59f38d2dab7b5db56d01";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1958")
pub fragment CC_ART1958 in CC_COURANT {
    label fr official "Article 1958";
    kind article;
    locator "article/1958";
    text fr official """Article 1958
Lorsqu'il est gratuit, il est soumis aux règles du dépôt proprement dit, sauf les différences ci-après énoncées.
""";
    content_hash "sha256:60df257dbd86446dfabcf38de7c5b74aea6b4b45bd8b0f80a643795619cf0858";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1959")
pub fragment CC_ART1959 in CC_COURANT {
    label fr official "Article 1959";
    kind article;
    locator "article/1959";
    text fr official """Article 1959
Le séquestre peut avoir pour objet, non seulement des effets mobiliers, mais même des immeubles.
""";
    content_hash "sha256:55af2a178df933a86f27a204d606dedb0afd7eede5efe6072ac62facd80986a2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1960")
pub fragment CC_ART1960 in CC_COURANT {
    label fr official "Article 1960";
    kind article;
    locator "article/1960";
    text fr official """Article 1960
Le dépositaire chargé du séquestre ne peut être déchargé avant la contestation terminée, que du consentement de toutes les parties intéressées, ou pour une cause jugée légitime.
""";
    content_hash "sha256:189b9ff991d407147eebd6720765c915a3ea55b23d6dc6cdbcb23a5b51d049f7";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1961")
pub fragment CC_ART1961 in CC_COURANT {
    label fr official "Article 1961";
    kind article;
    locator "article/1961";
    text fr official """Article 1961
La justice peut ordonner le séquestre :
1° Des meubles saisis sur un débiteur ;
2° D'un immeuble ou d'une chose mobilière dont la propriété ou la possession est litigieuse entre deux ou plusieurs personnes ;
3° Des choses qu'un débiteur offre pour sa libération.
""";
    content_hash "sha256:efa726c8adc9bc87e0dec72b4e2e582166b5bea661355993739e056195626c07";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1962")
pub fragment CC_ART1962 in CC_COURANT {
    label fr official "Article 1962";
    kind article;
    locator "article/1962";
    text fr official """Article 1962
L'établissement d'un gardien judiciaire produit, entre le saisissant et le gardien, des obligations réciproques. Le gardien doit apporter, pour la conservation des effets saisis, les soins raisonnables.
Il doit les représenter soit à la décharge du saisissant pour la vente, soit à la partie contre laquelle les exécutions ont été faites, en cas de mainlevée de la saisie.
L'obligation du saisissant consiste à payer au gardien le salaire fixé par la loi.
""";
    content_hash "sha256:f4bd264fc52c3770f4f67d0a6fa0ef170047b0a7974f23cf1d48074a29c0fe0b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1963")
pub fragment CC_ART1963 in CC_COURANT {
    label fr official "Article 1963";
    kind article;
    locator "article/1963";
    text fr official """Article 1963
Le séquestre judiciaire est donné, soit à une personne dont les parties intéressées sont convenues entre elles, soit à une personne nommée d'office par le juge.
Dans l'un et l'autre cas, celui auquel la chose a été confiée est soumis à toutes les obligations qu'emporte le séquestre conventionnel.
""";
    content_hash "sha256:08b47f4fdcdbfc57746d0ca02d5d06ecfee3121b45389bb4822f4295de16ca4c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1965")
pub fragment CC_ART1965 in CC_COURANT {
    label fr official "Article 1965";
    kind article;
    locator "article/1965";
    text fr official """Article 1965
La loi n'accorde aucune action pour une dette du jeu ou pour le paiement d'un pari.
""";
    content_hash "sha256:431cec747ce9aeae2f688da1fb71fe653fbf839851580deb56e2f2332d12b5ee";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1966")
pub fragment CC_ART1966 in CC_COURANT {
    label fr official "Article 1966";
    kind article;
    locator "article/1966";
    text fr official """Article 1966
Les jeux propres à exercer au fait des armes, les courses à pied ou à cheval, les courses de chariot, le jeu de paume et autres jeux de même nature qui tiennent à l'adresse et à l'exercice du corps, sont exceptés de la disposition précédente.
Néanmoins, le tribunal peut rejeter la demande quand la somme lui paraît excessive.
""";
    content_hash "sha256:5bf06bb5454ffcd37d594e65d07b5f4751d5ee3111e56a2995b270a85264fe3e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1967")
pub fragment CC_ART1967 in CC_COURANT {
    label fr official "Article 1967";
    kind article;
    locator "article/1967";
    text fr official """Article 1967
Dans aucun cas le perdant ne peut répéter ce qu'il a volontairement payé, à moins qu'il n'y ait eu, de la part du gagnant, dol, supercherie ou escroquerie.
""";
    content_hash "sha256:58e7399742ea3179015f723f66b2fe48f2fa4dedafb3d306e77e116a86cb921e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1968")
pub fragment CC_ART1968 in CC_COURANT {
    label fr official "Article 1968";
    kind article;
    locator "article/1968";
    text fr official """Article 1968
La rente viagère peut être constituée à titre onéreux, moyennant une somme d'argent, ou pour une chose mobilière appréciable, ou pour un immeuble.
""";
    content_hash "sha256:577f0a3cecb9a3315bf1fae515d7608d6b04ec06a3197c4242892ddb842ce8ad";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1969")
pub fragment CC_ART1969 in CC_COURANT {
    label fr official "Article 1969";
    kind article;
    locator "article/1969";
    text fr official """Article 1969
Elle peut être aussi constituée, à titre purement gratuit, par donation entre vifs ou par testament. Elle doit être alors revêtue des formes requises par la loi.
""";
    content_hash "sha256:265555c35ab5d9caac1e3ce3aa692b03905c643529ab9d72cd92abc137e135c2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1970")
pub fragment CC_ART1970 in CC_COURANT {
    label fr official "Article 1970";
    kind article;
    locator "article/1970";
    text fr official """Article 1970
Dans le cas de l'article précédent, la rente viagère est réductible si elle excède ce dont il est permis de disposer ; elle est nulle si elle est au profit d'une personne incapable de recevoir.
""";
    content_hash "sha256:c2ebebb9a21934fbee706d7388524a52be45961329c005543582391314c7b814";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1971")
pub fragment CC_ART1971 in CC_COURANT {
    label fr official "Article 1971";
    kind article;
    locator "article/1971";
    text fr official """Article 1971
La rente viagère peut être constituée soit sur la tête de celui qui en fournit le prix, soit sur la tête d'un tiers, qui n'a aucun droit d'en jouir.
""";
    content_hash "sha256:46e6dde6aaab4925c1d5d882f99dfd631c45378d871b2e9edccfc5a61553c5da";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1972")
pub fragment CC_ART1972 in CC_COURANT {
    label fr official "Article 1972";
    kind article;
    locator "article/1972";
    text fr official """Article 1972
Elle peut être constituée sur une ou plusieurs têtes.
""";
    content_hash "sha256:337e6dbcf8acc6035b1b266f148d8dfe7728c76b120068c063fa55c2bd426f34";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1973")
pub fragment CC_ART1973 in CC_COURANT {
    label fr official "Article 1973";
    kind article;
    locator "article/1973";
    text fr official """Article 1973
Elle peut être constituée au profit d'un tiers, quoique le prix en soit fourni par une autre personne.
Dans ce dernier cas, quoiqu'elle ait les caractères d'une libéralité, elle n'est point assujettie aux formes requises pour les donations ; sauf les cas de réduction et de nullité énoncés dans l'article 1970.
Lorsque, constituée par des époux ou l'un d'eux, la rente est stipulée réversible au profit du conjoint survivant, la clause de réversibilité peut avoir les caractères d'une libéralité ou ceux d'un acte à titre onéreux. Dans ce dernier cas, la récompense ou l'indemnité due par le bénéficiaire de la réversion à la communauté ou à la succession du prédécédé est égale à la valeur de la réversion de la rente. Sauf volonté contraire des époux, la réversion est présumée avoir été consentie à titre gratuit.
""";
    content_hash "sha256:eebeacc4ee5c1d445d9a5c0b50707ada52fe2cf05257a33437b156e51b1f4ac5";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1974")
pub fragment CC_ART1974 in CC_COURANT {
    label fr official "Article 1974";
    kind article;
    locator "article/1974";
    text fr official """Article 1974
Tout contrat de rente viagère, créé sur la tête d'une personne qui était morte au jour du contrat, ne produit aucun effet.
""";
    content_hash "sha256:0096982e01759776843f0215933dc591b79e2b6b0b3164c8633af50c9e1e44c9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1975")
pub fragment CC_ART1975 in CC_COURANT {
    label fr official "Article 1975";
    kind article;
    locator "article/1975";
    text fr official """Article 1975
Il en est de même du contrat par lequel la rente a été créée sur la tête d'une personne atteinte de la maladie dont elle est décédée dans les vingt jours de la date du contrat.
""";
    content_hash "sha256:01b24c36391626bbce853e0f96b32a0da941c563554ece043332e214b62e410a";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1976")
pub fragment CC_ART1976 in CC_COURANT {
    label fr official "Article 1976";
    kind article;
    locator "article/1976";
    text fr official """Article 1976
La rente viagère peut être constituée au taux qu'il plaît aux parties contractantes de fixer.
""";
    content_hash "sha256:8b8248508c9585d4a8b1699d0ac6f340deb532ee39ad944d81c1d0aba34f2194";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1977")
pub fragment CC_ART1977 in CC_COURANT {
    label fr official "Article 1977";
    kind article;
    locator "article/1977";
    text fr official """Article 1977
Celui au profit duquel la rente viagère a été constituée moyennant un prix peut demander la résiliation du contrat, si le constituant ne lui donne pas les sûretés stipulées pour son exécution.
""";
    content_hash "sha256:9a28464f5d18033410ff8a51c14513f496326381158cbf34a84db4d18bb24402";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1978")
pub fragment CC_ART1978 in CC_COURANT {
    label fr official "Article 1978";
    kind article;
    locator "article/1978";
    text fr official """Article 1978
Le seul défaut de paiement des arrérages de la rente n'autorise point celui en faveur de qui elle est constituée à demander le remboursement du capital, ou à rentrer dans le fonds par lui aliéné : il n'a que le droit de saisir et de faire vendre les biens de son débiteur et de faire ordonner ou consentir, sur le produit de la vente, l'emploi d'une somme suffisante pour le service des arrérages.
""";
    content_hash "sha256:b34d3ef11802b358fbf0214658693bfa064adb5f3da2ff1785d56c97cd99f73e";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1979")
pub fragment CC_ART1979 in CC_COURANT {
    label fr official "Article 1979";
    kind article;
    locator "article/1979";
    text fr official """Article 1979
Le constituant ne peut se libérer du paiement de la rente, en offrant de rembourser le capital, et en renonçant à la répétition des arrérages payés ; il est tenu de servir la rente pendant toute la vie de la personne ou des personnes sur la tête desquelles la rente a été constituée, quelle que soit la durée de la vie de ces personnes, et quelque onéreux qu'ait pu devenir le service de la rente.
""";
    content_hash "sha256:a56385dd077877ff1c5524451040fa40399a4f58b4d898d123de8fafc1ecc3b9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1980")
pub fragment CC_ART1980 in CC_COURANT {
    label fr official "Article 1980";
    kind article;
    locator "article/1980";
    text fr official """Article 1980
La rente viagère n'est acquise au propriétaire que dans la proportion du nombre de jours qu'il a vécu.
Néanmoins, s'il a été convenu qu'elle serait payée d'avance, le terme qui a dû être payé est acquis du jour où le paiement a dû en être fait.
""";
    content_hash "sha256:eabe82ffe128a10cd96e789d1d742f6577ac61649addc920a05c405308198f15";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1981")
pub fragment CC_ART1981 in CC_COURANT {
    label fr official "Article 1981";
    kind article;
    locator "article/1981";
    text fr official """Article 1981
La rente viagère ne peut être stipulée insaisissable que lorsqu'elle a été constituée à titre gratuit.
""";
    content_hash "sha256:f09cbb8e6785e1135eae97162cc8dfdf396e8d60af19d1205c71bf74f7dfa636";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1983")
pub fragment CC_ART1983 in CC_COURANT {
    label fr official "Article 1983";
    kind article;
    locator "article/1983";
    text fr official """Article 1983
Le propriétaire d'une rente viagère n'en peut demander les arrérages qu'en justifiant de son existence, ou de celle de la personne sur la tête de laquelle elle a été constituée.
""";
    content_hash "sha256:54d58aee2d3ce7b84de995d248b1a1b798ea498107cb0f7ce68a6064acd9afbc";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1984")
pub fragment CC_ART1984 in CC_COURANT {
    label fr official "Article 1984";
    kind article;
    locator "article/1984";
    text fr official """Article 1984
Le mandat ou procuration est un acte par lequel une personne donne à une autre le pouvoir de faire quelque chose pour le mandant et en son nom.
Le contrat ne se forme que par l'acceptation du mandataire.
""";
    content_hash "sha256:1735ae737570e65fe22bb68ba3b1a203093754e43a5ccc435f8d0a3b3f5e4ebc";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1985")
pub fragment CC_ART1985 in CC_COURANT {
    label fr official "Article 1985";
    kind article;
    locator "article/1985";
    text fr official """Article 1985
Le mandat peut être donné par acte authentique ou par acte sous seing privé, même par lettre. Il peut aussi être donné verbalement, mais la preuve testimoniale n'en est reçue que conformément au titre " Des contrats ou des obligations conventionnelles en général ".
L'acceptation du mandat peut n'être que tacite et résulter de l'exécution qui lui a été donnée par le mandataire.
""";
    content_hash "sha256:d5e75a931078ddafc8c61b22c908d99d4b242cf49fae0ee4cadb3826ff8182fa";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1986")
pub fragment CC_ART1986 in CC_COURANT {
    label fr official "Article 1986";
    kind article;
    locator "article/1986";
    text fr official """Article 1986
Le mandat est gratuit s'il n'y a convention contraire.
""";
    content_hash "sha256:5523b8c2cd01a56bec2f8f54b3e968e9d937de97477e3dd3253ec0c6b1cf32ed";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1987")
pub fragment CC_ART1987 in CC_COURANT {
    label fr official "Article 1987";
    kind article;
    locator "article/1987";
    text fr official """Article 1987
Il est ou spécial et pour une affaire ou certaines affaires seulement, ou général et pour toutes les affaires du mandant.
""";
    content_hash "sha256:4516e006053a428846a9a9c140bff640f341601212993b43caca8e4826df0be7";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1988")
pub fragment CC_ART1988 in CC_COURANT {
    label fr official "Article 1988";
    kind article;
    locator "article/1988";
    text fr official """Article 1988
Le mandat conçu en termes généraux n'embrasse que les actes d'administration.
S'il s'agit d'aliéner ou hypothéquer, ou de quelque autre acte de propriété, le mandat doit être exprès.
""";
    content_hash "sha256:528efba26a19777044072c555d86ff2595182a015d55459dfd4e8176652fa3f2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1989")
pub fragment CC_ART1989 in CC_COURANT {
    label fr official "Article 1989";
    kind article;
    locator "article/1989";
    text fr official """Article 1989
Le mandataire ne peut rien faire au-delà de ce qui est porté dans son mandat : le pouvoir de transiger ne renferme pas celui de compromettre.
""";
    content_hash "sha256:859fc281b536a04615e5f21c3280078e867abcf6ddd8f4a93f70cf5c29a74410";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1990")
pub fragment CC_ART1990 in CC_COURANT {
    label fr official "Article 1990";
    kind article;
    locator "article/1990";
    text fr official """Article 1990
Un mineur non émancipé peut être choisi pour mandataire ; mais le mandant n'aura d'action contre lui que d'après les règles générales relatives aux obligations des mineurs.
""";
    content_hash "sha256:384c0175eea4daf06124cd1f58fe579b5f7d6985c084dbf8daa9bf46d6abad71";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1991")
pub fragment CC_ART1991 in CC_COURANT {
    label fr official "Article 1991";
    kind article;
    locator "article/1991";
    text fr official """Article 1991
Le mandataire est tenu d'accomplir le mandat tant qu'il en demeure chargé, et répond des dommages-intérêts qui pourraient résulter de son inexécution.
Il est tenu de même d'achever la chose commencée au décès du mandant, s'il y a péril en la demeure.
""";
    content_hash "sha256:bf2dc3fab45310ca1e5f25460a593daecf123431d3bb3822058cd50ba183b37f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1992")
pub fragment CC_ART1992 in CC_COURANT {
    label fr official "Article 1992";
    kind article;
    locator "article/1992";
    text fr official """Article 1992
Le mandataire répond non seulement du dol, mais encore des fautes qu'il commet dans sa gestion.
Néanmoins, la responsabilité relative aux fautes est appliquée moins rigoureusement à celui dont le mandat est gratuit qu'à celui qui reçoit un salaire.
""";
    content_hash "sha256:b000699d5ebb4dea03d7ff87e49a43c083fbfc385c6831731e6fbc0de8611f71";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1993")
pub fragment CC_ART1993 in CC_COURANT {
    label fr official "Article 1993";
    kind article;
    locator "article/1993";
    text fr official """Article 1993
Tout mandataire est tenu de rendre compte de sa gestion, et de faire raison au mandant de tout ce qu'il a reçu en vertu de sa procuration, quand même ce qu'il aurait reçu n'eût point été dû au mandant.
""";
    content_hash "sha256:d8b7333a127eebdfbed995934bec8f5d016d16b49a4f8e3c635eab106efcf0dc";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1994")
pub fragment CC_ART1994 in CC_COURANT {
    label fr official "Article 1994";
    kind article;
    locator "article/1994";
    text fr official """Article 1994
Le mandataire répond de celui qu'il s'est substitué dans la gestion :
1° quand il n'a pas reçu le pouvoir de se substituer quelqu'un ;
2° quand ce pouvoir lui a été conféré sans désignation d'une personne, et que celle dont il a fait choix était notoirement incapable ou insolvable.
Dans tous les cas, le mandant peut agir directement contre la personne que le mandataire s'est substituée.
""";
    content_hash "sha256:26ad0a5bcb85bf0491fadc406253477b756b10650743add374465a7c79021d64";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1995")
pub fragment CC_ART1995 in CC_COURANT {
    label fr official "Article 1995";
    kind article;
    locator "article/1995";
    text fr official """Article 1995
Quand il y a plusieurs fondés de pouvoir ou mandataires établis par le même acte, il n'y a de solidarité entre eux qu'autant qu'elle est exprimée.
""";
    content_hash "sha256:ec63cc1eeccf9e23f1ef8b6b98dee3c87813c686883cde8185eeb13f65a550a3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1996")
pub fragment CC_ART1996 in CC_COURANT {
    label fr official "Article 1996";
    kind article;
    locator "article/1996";
    text fr official """Article 1996
Le mandataire doit l'intérêt des sommes qu'il a employées à son usage à dater de cet emploi ; et de celles dont il est reliquataire à compter du jour qu'il est mis en demeure.
""";
    content_hash "sha256:d1386ca5db57748a8537b7ddf8aa8b7c372cd0cdabaceea1b3aabebaefcdc282";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1997")
pub fragment CC_ART1997 in CC_COURANT {
    label fr official "Article 1997";
    kind article;
    locator "article/1997";
    text fr official """Article 1997
Le mandataire qui a donné à la partie avec laquelle il contracte en cette qualité une suffisante connaissance de ses pouvoirs n'est tenu d'aucune garantie pour ce qui a été fait au-delà, s'il ne s'y est personnellement soumis.
""";
    content_hash "sha256:459e451f8094144f1736d1fda8b39608c8d06922b3c85798c74d28f9d837ec7b";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1998")
pub fragment CC_ART1998 in CC_COURANT {
    label fr official "Article 1998";
    kind article;
    locator "article/1998";
    text fr official """Article 1998
Le mandant est tenu d'exécuter les engagements contractés par le mandataire, conformément au pouvoir qui lui a été donné.
Il n'est tenu de ce qui a pu être fait au-delà, qu'autant qu'il l'a ratifié expressément ou tacitement.
""";
    content_hash "sha256:3cbde7723ee1b6c17bdc3da7e6f7c360c22d85ec54ddb95bb7eac9b68d4606c3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART1999")
pub fragment CC_ART1999 in CC_COURANT {
    label fr official "Article 1999";
    kind article;
    locator "article/1999";
    text fr official """Article 1999
Le mandant doit rembourser au mandataire les avances et frais que celui-ci a faits pour l'exécution du mandat, et lui payer ses salaires lorsqu'il en a été promis.
S'il n'y a aucune faute imputable au mandataire, le mandant ne peut se dispenser de faire ces remboursements et paiement, lors même que l'affaire n'aurait pas réussi, ni faire réduire le montant des frais et avances sous le prétexte qu'ils pouvaient être moindres.
""";
    content_hash "sha256:fb4a219e2feff9e12998902968eaf479197244a35bcd299caea2099d51ba7af2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2000")
pub fragment CC_ART2000 in CC_COURANT {
    label fr official "Article 2000";
    kind article;
    locator "article/2000";
    text fr official """Article 2000
Le mandant doit aussi indemniser le mandataire des pertes que celui-ci a essuyées à l'occasion de sa gestion, sans imprudence qui lui soit imputable.
""";
    content_hash "sha256:414853b063def1ffeb14cf814edcf2bb7811b3d9675af9430e01fb4d69584e6d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2001")
pub fragment CC_ART2001 in CC_COURANT {
    label fr official "Article 2001";
    kind article;
    locator "article/2001";
    text fr official """Article 2001
L'intérêt des avances faites par le mandataire lui est dû par le mandant, à dater du jour des avances constatées.
""";
    content_hash "sha256:ea906da96d4ec1fc5fedd836cc292a5dbe0bbaf4b71a0ea4faebfed3c95f1390";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2002")
pub fragment CC_ART2002 in CC_COURANT {
    label fr official "Article 2002";
    kind article;
    locator "article/2002";
    text fr official """Article 2002
Lorsque le mandataire a été constitué par plusieurs personnes pour une affaire commune, chacune d'elles est tenue solidairement envers lui de tous les effets du mandat.
""";
    content_hash "sha256:b4fd59b07f5c6ae985d7c929d54f05635013aa0ab8c41bb5c9c46172fa9b0444";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2003")
pub fragment CC_ART2003 in CC_COURANT {
    label fr official "Article 2003";
    kind article;
    locator "article/2003";
    text fr official """Article 2003
Le mandat finit :
Par la révocation du mandataire,
Par la renonciation de celui-ci au mandat,
Par la mort, la tutelle des majeurs ou la déconfiture, soit du mandant, soit du mandataire.
""";
    content_hash "sha256:dbe233cc4285963d16c793e8b060f97727d5ad60406716ea27d221ab6bdf2158";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2004")
pub fragment CC_ART2004 in CC_COURANT {
    label fr official "Article 2004";
    kind article;
    locator "article/2004";
    text fr official """Article 2004
Le mandant peut révoquer sa procuration quand bon lui semble et contraindre, s'il y a lieu, le mandataire à lui remettre soit l'écrit sous seing privé qui la contient, soit l'original de la procuration, si elle a été délivrée en brevet, soit l'expédition, s'il en a été gardé minute.
""";
    content_hash "sha256:1dbc4c5802a6f3afafb46b49f0aee6e0661c80daa6f764bf4fd3e968cf966e9c";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2005")
pub fragment CC_ART2005 in CC_COURANT {
    label fr official "Article 2005";
    kind article;
    locator "article/2005";
    text fr official """Article 2005
La révocation notifiée au seul mandataire ne peut être opposée aux tiers qui ont traité dans l'ignorance de cette révocation, sauf au mandant son recours contre le mandataire.
""";
    content_hash "sha256:a23b1e650127d90023062adc5990e28b3b377a4efa158b53817cf0a4fbea8ac9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2006")
pub fragment CC_ART2006 in CC_COURANT {
    label fr official "Article 2006";
    kind article;
    locator "article/2006";
    text fr official """Article 2006
La constitution d'un nouveau mandataire pour la même affaire vaut révocation du premier, à compter du jour où elle a été notifiée à celui-ci.
""";
    content_hash "sha256:184099e11b7e5659a49542eb0d2b50c21723cca6dafdf89df55284ef4f0c46d1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2007")
pub fragment CC_ART2007 in CC_COURANT {
    label fr official "Article 2007";
    kind article;
    locator "article/2007";
    text fr official """Article 2007
Le mandataire peut renoncer au mandat, en notifiant au mandant sa renonciation.
Néanmoins, si cette renonciation préjudicie au mandant il devra en être indemnisé par le mandataire, à moins que celui-ci ne se trouve dans l'impossibilité de continuer le mandat sans en éprouver lui-même un préjudice considérable.
""";
    content_hash "sha256:7724dda83ccddd06fd7a9e339ae5eab874c14803c43286ae696fb9c4c1e524d2";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2008")
pub fragment CC_ART2008 in CC_COURANT {
    label fr official "Article 2008";
    kind article;
    locator "article/2008";
    text fr official """Article 2008
Si le mandataire ignore la mort du mandant ou l'une des autres causes qui font cesser le mandat, ce qu'il a fait dans cette ignorance est valide.
""";
    content_hash "sha256:2b3ad797f67ca4e8136a5b773706f6df01bc2160eafc5e6717fff588ab009a86";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2009")
pub fragment CC_ART2009 in CC_COURANT {
    label fr official "Article 2009";
    kind article;
    locator "article/2009";
    text fr official """Article 2009
Dans les cas ci-dessus, les engagements du mandataire sont exécutés à l'égard des tiers qui sont de bonne foi.
""";
    content_hash "sha256:d99452226e04776584ddc1402e6664a79a755568773317c4bb582da1ba573e93";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2010")
pub fragment CC_ART2010 in CC_COURANT {
    label fr official "Article 2010";
    kind article;
    locator "article/2010";
    text fr official """Article 2010
En cas de mort du mandataire, ses héritiers doivent en donner avis au mandant, et pourvoir, en attendant, à ce que les circonstances exigent pour l'intérêt de celui-ci.
""";
    content_hash "sha256:b6d0523ec5b16c18d742d8c955914bdb71878006975ff1e5b45a236cb99a4af7";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2011")
pub fragment CC_ART2011 in CC_COURANT {
    label fr official "Article 2011";
    kind article;
    locator "article/2011";
    text fr official """Article 2011
La fiducie est l'opération par laquelle un ou plusieurs constituants transfèrent des biens, des droits ou des sûretés, ou un ensemble de biens, de droits ou de sûretés, présents ou futurs, à un ou plusieurs fiduciaires qui, les tenant séparés de leur patrimoine propre, agissent dans un but déterminé au profit d'un ou plusieurs bénéficiaires.
""";
    content_hash "sha256:406aba78f52ac269a56c242a8fc574a97e15b300aec2810a45529796acf17fab";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2012")
pub fragment CC_ART2012 in CC_COURANT {
    label fr official "Article 2012";
    kind article;
    locator "article/2012";
    text fr official """Article 2012
La fiducie est établie par la loi ou par contrat. Elle doit être expresse.
Si les biens, droits ou sûretés transférés dans le patrimoine fiduciaire dépendent de la communauté existant entre les époux ou d'une indivision, le contrat de fiducie est établi par acte notarié à peine de nullité.
""";
    content_hash "sha256:636813e07c8dab84b709e7f3a43bdb7224efef164d03ffd70551d0e445fb89d6";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2013")
pub fragment CC_ART2013 in CC_COURANT {
    label fr official "Article 2013";
    kind article;
    locator "article/2013";
    text fr official """Article 2013
Le contrat de fiducie est nul s'il procède d'une intention libérale au profit du bénéficiaire. Cette nullité est d'ordre public.
""";
    content_hash "sha256:746c27da223e0f9c71da57199db34ae53af44812916641e5cf710dfc10ce5222";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2015")
pub fragment CC_ART2015 in CC_COURANT {
    label fr official "Article 2015";
    kind article;
    locator "article/2015";
    text fr official """Article 2015
Seuls peuvent avoir la qualité de fiduciaires les établissements de crédit mentionnés au I de l'article L. 511-1 du code monétaire et financier, les institutions et services énumérés à l'article L. 518-1 du même code, les entreprises d'investissement mentionnées à l'article L. 531-4 du même code, les sociétés de gestion de portefeuille ainsi que les entreprises d'assurance régies par l'article L. 310-1 du code des assurances.
Les membres de la profession d'avocat peuvent également avoir la qualité de fiduciaire.
""";
    content_hash "sha256:2f2245194ef2db94183df986e2da6a99325a5f93b3c3b4edb919c72f1e2819ac";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2016")
pub fragment CC_ART2016 in CC_COURANT {
    label fr official "Article 2016";
    kind article;
    locator "article/2016";
    text fr official """Article 2016
Le constituant ou le fiduciaire peut être le bénéficiaire ou l'un des bénéficiaires du contrat de fiducie.
""";
    content_hash "sha256:96c50c8d9f4e24d36c9efe31b495681f820a9bbd0ba62e2f238d09abcfcd3a12";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2017")
pub fragment CC_ART2017 in CC_COURANT {
    label fr official "Article 2017";
    kind article;
    locator "article/2017";
    text fr official """Article 2017
Sauf stipulation contraire du contrat de fiducie, le constituant peut, à tout moment, désigner un tiers chargé de s'assurer de la préservation de ses intérêts dans le cadre de l'exécution du contrat et qui peut disposer des pouvoirs que la loi accorde au constituant.
Lorsque le constituant est une personne physique, il ne peut renoncer à cette faculté.
Le constituant doit informer le fiduciaire de la désignation de ce tiers.
""";
    content_hash "sha256:01f68b2e80fd366d05682133db20c8ea2f0a48b454aca76ec1e6a2518ba30b9d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2018")
pub fragment CC_ART2018 in CC_COURANT {
    label fr official "Article 2018";
    kind article;
    locator "article/2018";
    text fr official """Article 2018
Le contrat de fiducie détermine, à peine de nullité :
1° Les biens, droits ou sûretés transférés. S'ils sont futurs, ils doivent être déterminables ;
2° La durée du transfert, qui ne peut excéder quatre-vingt-dix-neuf ans à compter de la signature du contrat ;
3° L'identité du ou des constituants ;
4° L'identité du ou des fiduciaires ;
5° L'identité du ou des bénéficiaires ou, à défaut, les règles permettant leur désignation ;
6° La mission du ou des fiduciaires et l'étendue de leurs pouvoirs d'administration et de disposition.
""";
    content_hash "sha256:c556961ca707d7ba4fe8bbcfbfc00be50054dd75520714bba65a07c07c878060";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2018_1")
pub fragment CC_ART2018_1 in CC_COURANT {
    label fr official "Article 2018-1";
    kind article;
    locator "article/2018-1";
    text fr official """Article 2018-1
Lorsque le contrat de fiducie prévoit que le constituant conserve l'usage ou la jouissance d'un fonds de commerce ou d'un immeuble à usage professionnel transféré dans le patrimoine fiduciaire, la convention conclue à cette fin n'est pas soumise aux chapitres IV et V du titre IV du livre Ier du code de commerce, sauf stipulation contraire.
""";
    content_hash "sha256:87aeac602f71ad6104d086b8ba36a57c0a0c24917165312da2e95afa3e22f1e1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2018_2")
pub fragment CC_ART2018_2 in CC_COURANT {
    label fr official "Article 2018-2";
    kind article;
    locator "article/2018-2";
    text fr official """Article 2018-2
La cession de créances réalisée dans le cadre d'une fiducie est opposable aux tiers à la date du contrat de fiducie ou de l'avenant qui la constate. Elle ne devient opposable au débiteur de la créance cédée que par la notification qui lui en est faite par le cédant ou le fiduciaire.
""";
    content_hash "sha256:927422d79726279f617e08e3d01b58e0447e99ebaad22c164fde9605748596a5";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2019")
pub fragment CC_ART2019 in CC_COURANT {
    label fr official "Article 2019";
    kind article;
    locator "article/2019";
    text fr official """Article 2019
A peine de nullité, le contrat de fiducie et ses avenants sont enregistrés dans le délai d'un mois à compter de leur date au service des impôts du siège du fiduciaire ou au service des impôts des non-résidents si le fiduciaire n'est pas domicilié en France.
Lorsqu'ils portent sur des immeubles ou des droits réels immobiliers, ils sont, sous la même sanction, publiés dans les conditions prévues aux articles 647 et 657 du code général des impôts.
La transmission des droits résultant du contrat de fiducie et, si le bénéficiaire n'est pas désigné dans le contrat de fiducie, sa désignation ultérieure doivent, à peine de nullité, donner lieu à un acte écrit enregistré dans les mêmes conditions.
La désignation d'un tiers en application de l'article 2017 et l'information sur l'identité du ou des bénéficiaires effectifs de la fiducie mentionnés à l'article L. 561-2-2 du code monétaire et financier doivent également, à peine de nullité, donner lieu à un acte écrit établi par le fiduciaire et enregistré dans les mêmes conditions.
""";
    content_hash "sha256:6725543f4cfb92af6e5f77767346c7e16ea20b19cc5aa136d96470fd1704fba9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2020")
pub fragment CC_ART2020 in CC_COURANT {
    label fr official "Article 2020";
    kind article;
    locator "article/2020";
    text fr official """Article 2020
Un registre national des fiducies est constitué selon des modalités précisées par décret en Conseil d'Etat.
""";
    content_hash "sha256:5cca19793bb7fc4becf7a57c2a4b717c7ed74e2c44db3aa292e7f7cc46ffaaf1";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2021")
pub fragment CC_ART2021 in CC_COURANT {
    label fr official "Article 2021";
    kind article;
    locator "article/2021";
    text fr official """Article 2021
Lorsque le fiduciaire agit pour le compte de la fiducie, il doit en faire expressément mention.
De même, lorsque le patrimoine fiduciaire comprend des biens ou des droits dont la mutation est soumise à publicité, celle-ci doit mentionner le nom du fiduciaire ès qualités.
""";
    content_hash "sha256:5949903ddd0c146084b5572358700af3afaee936dd9305f27bcd28712f09fff9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2022")
pub fragment CC_ART2022 in CC_COURANT {
    label fr official "Article 2022";
    kind article;
    locator "article/2022";
    text fr official """Article 2022
Le contrat de fiducie définit les conditions dans lesquelles le fiduciaire rend compte de sa mission au constituant.
Toutefois, lorsque pendant l'exécution du contrat le constituant fait l'objet d'une mesure de tutelle, le fiduciaire rend compte de sa mission au tuteur à la demande de ce dernier au moins une fois par an, sans préjudice de la périodicité fixée par le contrat. Lorsque pendant l'exécution du contrat le constituant fait l'objet d'une mesure de curatelle, le fiduciaire rend compte de sa mission, dans les mêmes conditions, au constituant et à son curateur.
Le fiduciaire rend compte de sa mission au bénéficiaire et au tiers désigné en application de l'article 2017, à leur demande, selon la périodicité fixée par le contrat.
""";
    content_hash "sha256:58e3b88baaa26ff2fd346c2bb6d06bcfa37d83b98144eb804122c8bd9f3e61bd";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2023")
pub fragment CC_ART2023 in CC_COURANT {
    label fr official "Article 2023";
    kind article;
    locator "article/2023";
    text fr official """Article 2023
Dans ses rapports avec les tiers, le fiduciaire est réputé disposer des pouvoirs les plus étendus sur le patrimoine fiduciaire, à moins qu'il ne soit démontré que les tiers avaient connaissance de la limitation de ses pouvoirs.
""";
    content_hash "sha256:bd07db577faa73c98898fb62a09f1807c46dca9a688520a8cdd63683a6535495";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2024")
pub fragment CC_ART2024 in CC_COURANT {
    label fr official "Article 2024";
    kind article;
    locator "article/2024";
    text fr official """Article 2024
L'ouverture d'une procédure de sauvegarde, de redressement judiciaire ou de liquidation judiciaire au profit du fiduciaire n'affecte pas le patrimoine fiduciaire.
""";
    content_hash "sha256:9ba7e8b4c181f8dc91d7283f64f72527224b9bda9e6c8cd95def3bad394f70a3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2025")
pub fragment CC_ART2025 in CC_COURANT {
    label fr official "Article 2025";
    kind article;
    locator "article/2025";
    text fr official """Article 2025
Sans préjudice des droits des créanciers du constituant titulaires d'un droit de suite attaché à une sûreté publiée antérieurement au contrat de fiducie et hors les cas de fraude aux droits des créanciers du constituant, le patrimoine fiduciaire ne peut être saisi que par les titulaires de créances nées de la conservation ou de la gestion de ce patrimoine.
En cas d'insuffisance du patrimoine fiduciaire, le patrimoine du constituant constitue le gage commun de ces créanciers, sauf stipulation contraire du contrat de fiducie mettant tout ou partie du passif à la charge du fiduciaire.
Le contrat de fiducie peut également limiter l'obligation au passif fiduciaire au seul patrimoine fiduciaire. Une telle clause n'est opposable qu'aux créanciers qui l'ont expressément acceptée.
""";
    content_hash "sha256:ac051052163c5e8da660bde9c53014343f2e3db4742f29814f423bb56c1139e3";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2026")
pub fragment CC_ART2026 in CC_COURANT {
    label fr official "Article 2026";
    kind article;
    locator "article/2026";
    text fr official """Article 2026
Le fiduciaire est responsable, sur son patrimoine propre, des fautes qu'il commet dans l'exercice de sa mission.
""";
    content_hash "sha256:11a573f1a79ff7ab009da2b5cfaef213c172a24907f74593b730c4f512576f25";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2027")
pub fragment CC_ART2027 in CC_COURANT {
    label fr official "Article 2027";
    kind article;
    locator "article/2027";
    text fr official """Article 2027
En l'absence de stipulations contractuelles prévoyant les conditions de son remplacement, si le fiduciaire manque à ses devoirs ou met en péril les intérêts qui lui sont confiés ou encore s'il fait l'objet d'une procédure de sauvegarde ou de redressement judiciaire, le constituant, le bénéficiaire ou le tiers désigné en application de l'article 2017 peut demander en justice la nomination d'un fiduciaire provisoire ou solliciter le remplacement du fiduciaire. La décision judiciaire faisant droit à la demande emporte de plein droit dessaisissement du fiduciaire originaire et transfert du patrimoine fiduciaire en faveur de son remplaçant.
""";
    content_hash "sha256:5e14624ddfa7afc4332a6a20c6d57e8bad860749d11ab8d526098191f1f90a65";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2028")
pub fragment CC_ART2028 in CC_COURANT {
    label fr official "Article 2028";
    kind article;
    locator "article/2028";
    text fr official """Article 2028
Le contrat de fiducie peut être révoqué par le constituant tant qu'il n'a pas été accepté par le bénéficiaire.
Après acceptation par le bénéficiaire, le contrat ne peut être modifié ou révoqué qu'avec son accord ou par décision de justice.
""";
    content_hash "sha256:4d65779936e16fd39ad35f23cd0d7cf6c5a226c492ee2172556bf5d16c5678dc";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2029")
pub fragment CC_ART2029 in CC_COURANT {
    label fr official "Article 2029";
    kind article;
    locator "article/2029";
    text fr official """Article 2029
Le contrat de fiducie prend fin par le décès du constituant personne physique, par la survenance du terme ou par la réalisation du but poursuivi quand celle-ci a lieu avant le terme.
Lorsque la totalité des bénéficiaires renonce à la fiducie, il prend également fin de plein droit, sauf stipulations du contrat prévoyant les conditions dans lesquelles il se poursuit. Sous la même réserve, il prend fin lorsque le fiduciaire fait l'objet d'une liquidation judiciaire ou d'une dissolution ou disparaît par suite d'une cession ou d'une absorption et, s'il est avocat, en cas d'interdiction temporaire, de radiation ou d'omission du tableau.
""";
    content_hash "sha256:66c8da48e86cbc87ef0d35228c67f66b6a013ae96fd7340106fa6f42d9852e2f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2030")
pub fragment CC_ART2030 in CC_COURANT {
    label fr official "Article 2030";
    kind article;
    locator "article/2030";
    text fr official """Article 2030
Lorsque le contrat de fiducie prend fin en l'absence de bénéficiaire, les droits, biens ou sûretés présents dans le patrimoine fiduciaire font de plein droit retour au constituant.
Lorsqu'il prend fin par le décès du constituant, le patrimoine fiduciaire fait de plein droit retour à la succession.
""";
    content_hash "sha256:44c000da6b8063617d08ec3f193ea1919c57779055cca7176866b60740012be4";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2044")
pub fragment CC_ART2044 in CC_COURANT {
    label fr official "Article 2044";
    kind article;
    locator "article/2044";
    text fr official """Article 2044
La transaction est un contrat par lequel les parties, par des concessions réciproques, terminent une contestation née, ou préviennent une contestation à naître.
Ce contrat doit être rédigé par écrit.
""";
    content_hash "sha256:bbeef0b55dc52f5804423e4b309cf6ebe3a460370eeafd5b15b80f26fb41c142";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2045")
pub fragment CC_ART2045 in CC_COURANT {
    label fr official "Article 2045";
    kind article;
    locator "article/2045";
    text fr official """Article 2045
Pour transiger, il faut avoir la capacité de disposer des objets compris dans la transaction.
Le tuteur ne peut transiger pour le mineur ou le majeur en tutelle que conformément à l'article 467 au titre " De la minorité, de la tutelle et de l'émancipation " ; et il ne peut transiger avec le mineur devenu majeur, sur le compte de tutelle, que conformément à l'article 472 au même titre.
Les établissements publics de l'Etat ne peuvent transiger qu'avec l'autorisation expresse du Premier ministre.
""";
    content_hash "sha256:1612a5b2bb41f6b85f741843f80772372d629380676a1d97a12a96b2e273d579";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2046")
pub fragment CC_ART2046 in CC_COURANT {
    label fr official "Article 2046";
    kind article;
    locator "article/2046";
    text fr official """Article 2046
On peut transiger sur l'intérêt civil qui résulte d'un délit.
La transaction n'empêche pas la poursuite du ministère public.
""";
    content_hash "sha256:c6edafde9333b7a4f13e7168872107e6b4969ea987bc318a8d6a95c61e151020";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2048")
pub fragment CC_ART2048 in CC_COURANT {
    label fr official "Article 2048";
    kind article;
    locator "article/2048";
    text fr official """Article 2048
Les transactions se renferment dans leur objet : la renonciation qui y est faite à tous droits, actions et prétentions, ne s'entend que de ce qui est relatif au différend qui y a donné lieu.
""";
    content_hash "sha256:5659e4c60ccac39578357fd0d7acba43da1997370b389188ab5f217fa7708234";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2049")
pub fragment CC_ART2049 in CC_COURANT {
    label fr official "Article 2049";
    kind article;
    locator "article/2049";
    text fr official """Article 2049
Les transactions ne règlent que les différends qui s'y trouvent compris, soit que les parties aient manifesté leur intention par des expressions spéciales ou générales, soit que l'on reconnaisse cette intention par une suite nécessaire de ce qui est exprimé.
""";
    content_hash "sha256:eb376c79b74f5a046c2ffbae70692ea0ab839731cfa8c5d6427265430a1eaa60";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2050")
pub fragment CC_ART2050 in CC_COURANT {
    label fr official "Article 2050";
    kind article;
    locator "article/2050";
    text fr official """Article 2050
Si celui qui avait transigé sur un droit qu'il avait de son chef acquiert ensuite un droit semblable du chef d'une autre personne, il n'est point, quant au droit nouvellement acquis, lié par la transaction antérieure.
""";
    content_hash "sha256:1c8af1ef5de0a61c07807f8ea6b9d0d9b535659742101ede7cb4322db60b4003";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2051")
pub fragment CC_ART2051 in CC_COURANT {
    label fr official "Article 2051";
    kind article;
    locator "article/2051";
    text fr official """Article 2051
La transaction faite par l'un des intéressés ne lie point les autres intéressés et ne peut être opposée par eux.
""";
    content_hash "sha256:33d59480f26f12ed6c2837553a14fc087f4821b3764c2cd09aa2231612f84822";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2052")
pub fragment CC_ART2052 in CC_COURANT {
    label fr official "Article 2052";
    kind article;
    locator "article/2052";
    text fr official """Article 2052
La transaction fait obstacle à l'introduction ou à la poursuite entre les parties d'une action en justice ayant le même objet.
""";
    content_hash "sha256:f99c923e7e7161106665ac704cdf85bc5275a98b6cd9f158c071ded95dabe4e9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2059")
pub fragment CC_ART2059 in CC_COURANT {
    label fr official "Article 2059";
    kind article;
    locator "article/2059";
    text fr official """Article 2059
Toutes personnes peuvent compromettre sur les droits dont elles ont la libre disposition.
""";
    content_hash "sha256:afe345373070224c51e3c15b16101cb5bbf0045864195b865996badecf4786a9";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2060")
pub fragment CC_ART2060 in CC_COURANT {
    label fr official "Article 2060";
    kind article;
    locator "article/2060";
    text fr official """Article 2060
On ne peut compromettre sur les questions d'état et de capacité des personnes, sur celles relatives au divorce et à la séparation de corps ou sur les contestations intéressant les collectivités publiques et les établissements publics et plus généralement dans toutes les matières qui intéressent l'ordre public.
Toutefois, des catégories d'établissements publics à caractère industriel et commercial peuvent être autorisées par décret à compromettre.
""";
    content_hash "sha256:4a886db342540eac2584850267fa419327453c81dd7d6034143f3a9a38a05b2d";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2061")
pub fragment CC_ART2061 in CC_COURANT {
    label fr official "Article 2061";
    kind article;
    locator "article/2061";
    text fr official """Article 2061
La clause compromissoire doit avoir été acceptée par la partie à laquelle on l'oppose, à moins que celle-ci n'ait succédé aux droits et obligations de la partie qui l'a initialement acceptée.
Lorsque l'une des parties n'a pas contracté dans le cadre de son activité professionnelle, la clause ne peut lui être opposée.
""";
    content_hash "sha256:8f1781a8553291973d36c7ff39a62bc17835dd39df4db68423423e0142496564";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2062")
pub fragment CC_ART2062 in CC_COURANT {
    label fr official "Article 2062";
    kind article;
    locator "article/2062";
    text fr official """Article 2062
La convention de procédure participative est une convention par laquelle les parties à un différend s'engagent à œuvrer conjointement et de bonne foi à la résolution amiable de leur différend ou à la mise en état de leur litige.
Cette convention est conclue pour une durée déterminée.
""";
    content_hash "sha256:01879cd3f71bfa8c2e2dff40db155c42cf7b255b73a1a3a35cece0cc39e7c2ce";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2063")
pub fragment CC_ART2063 in CC_COURANT {
    label fr official "Article 2063";
    kind article;
    locator "article/2063";
    text fr official """Article 2063
La convention de procédure participative est, à peine de nullité, contenue dans un écrit qui précise :
1° Son terme ;
2° L'objet du différend ;
3° Les pièces et informations nécessaires à la résolution du différend ou à la mise en état du litige et les modalités de leur échange .
4° Le cas échéant, les actes contresignés par avocats que les parties s'accordent à établir, dans des conditions prévues par décret en Conseil d'Etat.
""";
    content_hash "sha256:3d14c34354808fd86f416dd078524320f4c1c1502bc65899b89b951ace0c16fb";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2064")
pub fragment CC_ART2064 in CC_COURANT {
    label fr official "Article 2064";
    kind article;
    locator "article/2064";
    text fr official """Article 2064
Toute personne, assistée de son avocat, peut conclure une convention de procédure participative sur les droits dont elle a la libre disposition, sous réserve des dispositions de l'article 2067.
""";
    content_hash "sha256:29af3a5ebd3b2c74f53e3fb27d89e7455953dd26edafd01c668c3350482e3e7f";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2065")
pub fragment CC_ART2065 in CC_COURANT {
    label fr official "Article 2065";
    kind article;
    locator "article/2065";
    text fr official """Article 2065
Tant qu'elle est en cours, la convention de procédure participative conclue avant la saisine d'un juge rend irrecevable tout recours au juge pour qu'il statue sur le litige. Toutefois, l'inexécution de la convention par l'une des parties autorise une autre partie à saisir le juge pour qu'il statue sur le litige.
En cas d'urgence, la convention ne fait pas obstacle à ce que des mesures provisoires ou conservatoires soient demandées par les parties.
""";
    content_hash "sha256:a6ca908e75c19e6618f0c60b13f66d0bca1d005cffb118b096b17e29a008a6bf";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2066")
pub fragment CC_ART2066 in CC_COURANT {
    label fr official "Article 2066";
    kind article;
    locator "article/2066";
    text fr official """Article 2066
Sans préjudice du 7° de l'article L. 111-3 du code des procédures civiles d'exécution, les parties qui, au terme de la convention de procédure participative, parviennent à un accord réglant en tout ou partie leur différend peuvent soumettre cet accord à l'homologation du juge.
Lorsque, faute de parvenir à un accord au terme de la convention conclue avant la saisine d'un juge, les parties soumettent leur litige au juge, elles sont dispensées de la conciliation ou de la médiation préalable le cas échéant prévue.
Le deuxième alinéa n'est pas applicable aux litiges en matière prud'homale.
""";
    content_hash "sha256:bfa9ff421fe3ea2d57af4db7395228b3dab1dc660d8ccd0254cf39f4ebebfb4a";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2067")
pub fragment CC_ART2067 in CC_COURANT {
    label fr official "Article 2067";
    kind article;
    locator "article/2067";
    text fr official """Article 2067
Une convention de procédure participative peut être conclue par des époux en vue de rechercher une solution consensuelle en matière de divorce ou de séparation de corps.
L'article 2066 n'est pas applicable en la matière. La demande en divorce ou en séparation de corps présentée à la suite d'une convention de procédure participative est formée et jugée suivant les règles prévues au titre VI du livre Ier relatif au divorce.
""";
    content_hash "sha256:be19060ff20a9bb8f1734cf3a62eae32204d44a267bad7d0df56505b4bedf333";
}

@id("urn:fr:corpus:clir:code-civil-contrats-speciaux#CC_ART2068")
pub fragment CC_ART2068 in CC_COURANT {
    label fr official "Article 2068";
    kind article;
    locator "article/2068";
    text fr official """Article 2068
La procédure participative est régie par le code de procédure civile.
""";
    content_hash "sha256:347dcacec5105054ff81283e6dd0e002a5a5b25752344b6518572955a3f6b153";
}

