pub deadline policy CC_CONTRATS_SPECIAUX_AN {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
pub relation quote_part_indivise_saisie(c: ConventionIndivision) kind institutional {
    label fr official "la quote-part indivise du débiteur est saisie en vue de sa vente (article 1873-15)";
    label en unofficial "the debtor's undivided share is attached with a view to its sale (Article 1873-15)";
}
pub relation patrimoine_fiduciaire_saisi(f: Fiducie) kind institutional {
    label fr official "le patrimoine fiduciaire est saisi pour la créance née de sa conservation ou de sa gestion (article 2025)";
    label en unofficial "the fiduciary estate is attached for the claim arising from its conservation or management (Article 2025)";
}
pub relation remise_du_titre_de_procuration_exigee(m: Mandat) kind institutional {
    label fr official "le mandant a exigé la remise du titre de procuration (article 2004)";
    label en unofficial "the principal has required the return of the power of attorney (Article 2004)";
}
pub relation depot_proprement_dit_constitue(d: Depot) kind institutional {
    label fr official "le dépôt proprement dit est constitué sur une chose mobilière (article 1918)";
    label en unofficial "the deposit proper is constituted over a movable thing (Article 1918)";
}
pub relation decision_prise_par_consultation_ecrite(s: Societe) kind institutional {
    label fr official "la décision collective est prise par consultation écrite prévue par les statuts (article 1853)";
    label en unofficial "the collective decision is taken by written consultation provided for in the articles (Article 1853)";
}
pub relation decision_prise_par_acte_unanime(s: Societe) kind institutional {
    label fr official "la décision collective résulte du consentement de tous les associés exprimé dans un acte (article 1854)";
    label en unofficial "the collective decision results from the consent of all partners expressed in a deed (Article 1854)";
}
pub relation pret_a_usage_conclu(pr: Pret) kind institutional {
    label fr official "le prêt à usage est conclu sur une chose qui peut en faire l'objet (article 1878)";
    label en unofficial "the loan for use is concluded over a thing that may be its object (Article 1878)";
}
pub relation associe_retire_de_la_societe(s: Societe, p: Personne) kind institutional {
    label fr official "l'associé s'est retiré de la société (article 1869)";
    label en unofficial "the partner has withdrawn from the company (Article 1869)";
}
pub relation compromis_etablissement_public_conclu(a: Arbitrage) kind institutional {
    label fr official "l'établissement public autorisé par décret a compromis (article 2060)";
    label en unofficial "the public establishment authorised by decree has entered into an arbitration agreement (Article 2060)";
}
pub relation action_directe_contre_substitut_engagee(m: Mandat) kind institutional {
    label fr official "le mandant a agi directement contre la personne substituée (article 1994)";
    label en unofficial "the principal has acted directly against the substitute (Article 1994)";
}

pub deadline policy CC_CONTRATS_SPECIAUX_MOIS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

pub deadline policy CC_CONTRATS_SPECIAUX_JOUR {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
