// Code civil — Livre III, titres IX à XVII (CC-13).
// Les textes étrangers au Code civil restent des entrées typées ou des frontières
// explicites; ce paquet ne fabrique ni taux légal ni modalités réglementaires.

language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
import fr.code_civil.core version "0.1.0";

type Personne = fr.code_civil.core::Personne;
type PersonnePhysique = fr.code_civil.core::PersonnePhysique;
type PersonneMorale = fr.code_civil.core::PersonneMorale;
type Bien = fr.code_civil.core::Bien;
type Creance = fr.code_civil.core::Creance;

pub entity Societe : PersonneMorale { label fr official "Déclaration du Code civil : societe"; label en unofficial "Civil Code declaration: societe"; }
pub entity PartSociale : Bien { label fr official "Déclaration du Code civil : part Sociale"; label en unofficial "Civil Code declaration: part Sociale"; }
pub entity Pret { label fr official "Déclaration du Code civil : pret"; label en unofficial "Civil Code declaration: pret"; }
pub entity Depot { label fr official "Déclaration du Code civil : depot"; label en unofficial "Civil Code declaration: depot"; }
pub entity Mandat { label fr official "Déclaration du Code civil : mandat"; label en unofficial "Civil Code declaration: mandat"; }
pub entity Fiducie { label fr official "Déclaration du Code civil : fiducie"; label en unofficial "Civil Code declaration: fiducie"; }
pub entity Transaction { label fr official "Déclaration du Code civil : transaction"; label en unofficial "Civil Code declaration: transaction"; }
pub entity ConventionIndivision { label fr official "Déclaration du Code civil : convention Indivision"; label en unofficial "Civil Code declaration: convention Indivision"; }
pub entity ContratAleatoire { label fr official "Déclaration du Code civil : contrat Aleatoire"; label en unofficial "Civil Code declaration: contrat Aleatoire"; }
pub entity RenteViagere : ContratAleatoire { label fr official "Déclaration du Code civil : rente Viagere"; label en unofficial "Civil Code declaration: rente Viagere"; }
pub entity Sequestre : Depot { label fr official "Déclaration du Code civil : sequestre"; label en unofficial "Civil Code declaration: sequestre"; }
pub entity ProcedureParticipative { label fr official "Déclaration du Code civil : procedure Participative"; label en unofficial "Civil Code declaration: procedure Participative"; }
pub entity Arbitrage { label fr official "Déclaration du Code civil : arbitrage"; label en unofficial "Civil Code declaration: arbitrage"; }

pub enum CauseFinMandat { label fr official "Déclaration du Code civil : cause Fin Mandat"; label en unofficial "Civil Code declaration: cause Fin Mandat"; Revocation, Renonciation, Mort, Tutelle, Deconfiture }

// Société: facts supplied by a case.
pub relation contrat_de_societe(s: Societe) kind empirical { label fr official "Déclaration du Code civil : contrat de societe"; label en unofficial "Civil Code declaration: contrat de societe"; }
pub relation associe(s: Societe, p: Personne) kind empirical { label fr official "Déclaration du Code civil : associe"; label en unofficial "Civil Code declaration: associe"; }
pub relation apport_en_capital(s: Societe, p: Personne, m: Money) kind empirical { label fr official "Déclaration du Code civil : apport en capital"; label en unofficial "Civil Code declaration: apport en capital"; key(s, p); }
pub relation apport_en_industrie(s: Societe, p: Personne) kind empirical { label fr official "Déclaration du Code civil : apport en industrie"; label en unofficial "Civil Code declaration: apport en industrie"; }
pub relation nombre_de_parts(s: Societe, p: Personne, n: Integer) kind empirical { label fr official "Déclaration du Code civil : nombre de parts"; label en unofficial "Civil Code declaration: nombre de parts"; key(s, p); }
pub relation total_des_parts(s: Societe, n: Integer) kind empirical { label fr official "Déclaration du Code civil : total des parts"; label en unofficial "Civil Code declaration: total des parts"; key(s); }
pub relation conjoint_notifie_associe(s: Societe, p: Personne, n: Integer) kind empirical { label fr official "Déclaration du Code civil : conjoint notifie associe"; label en unofficial "Civil Code declaration: conjoint notifie associe"; key(s, p); }
pub relation parts_reconnues_au_conjoint(s: Societe, p: Personne, n: Rational) kind derived { label fr official "Déclaration du Code civil : parts reconnues au conjoint"; label en unofficial "Civil Code declaration: parts reconnues au conjoint"; key(s, p); }
pub relation droit_dans_le_capital(s: Societe, p: Personne, m: Money) kind derived { label fr official "Déclaration du Code civil : droit dans le capital"; label en unofficial "Civil Code declaration: droit dans le capital"; key(s, p); }
pub relation apport_industrie_hors_capital(s: Societe, p: Personne) kind derived { label fr official "Déclaration du Code civil : apport industrie hors capital"; label en unofficial "Civil Code declaration: apport industrie hors capital"; }
pub relation objet_licite(s: Societe) kind empirical { label fr official "Déclaration du Code civil : objet licite"; label en unofficial "Civil Code declaration: objet licite"; }
pub relation constituee_dans_interet_commun(s: Societe) kind derived { label fr official "Déclaration du Code civil : constituee dans interet commun"; label en unofficial "Civil Code declaration: constituee dans interet commun"; }
pub relation geree_dans_interet_social(s: Societe) kind derived { label fr official "Déclaration du Code civil : geree dans interet social"; label en unofficial "Civil Code declaration: geree dans interet social"; }
pub external judgment relation interet_commun_des_associes(s: Societe) { authority Court; label fr official "intérêt commun des associés au sens de l'article 1833"; label en unofficial "common interest of the members within Article 1833"; }
pub external judgment relation interet_social_de_la_societe(s: Societe) { authority Court; label fr official "intérêt social au sens de l'article 1833"; label en unofficial "corporate interest within Article 1833"; }
pub relation societe_immatriculee_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : societe immatriculee le"; label en unofficial "Civil Code declaration: societe immatriculee le"; key(s); }
pub relation acte_modificatif_publie_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : acte modificatif publie le"; label en unofficial "Civil Code declaration: acte modificatif publie le"; key(s); }
pub relation action_regularisation_introduite_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : action regularisation introduite le"; label en unofficial "Civil Code declaration: action regularisation introduite le"; key(s); }
pub relation action_regularisation_recevable(s: Societe) kind derived { label fr official "Déclaration du Code civil : action regularisation recevable"; label en unofficial "Civil Code declaration: action regularisation recevable"; }
pub relation formalite_regularisee_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : formalite regularisee le"; label en unofficial "Civil Code declaration: formalite regularisee le"; key(s); }
pub relation action_responsabilite_fondateurs_introduite_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : action responsabilite fondateurs introduite le"; label en unofficial "Civil Code declaration: action responsabilite fondateurs introduite le"; key(s); }
pub relation action_responsabilite_fondateurs_recevable(s: Societe) kind derived { label fr official "Déclaration du Code civil : action responsabilite fondateurs recevable"; label en unofficial "Civil Code declaration: action responsabilite fondateurs recevable"; }
pub relation toutes_parts_en_une_main_depuis(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : toutes parts en une main depuis"; label en unofficial "Civil Code declaration: toutes parts en une main depuis"; key(s); }
pub relation situation_parts_regularisee_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : situation parts regularisee le"; label en unofficial "Civil Code declaration: situation parts regularisee le"; key(s); }
pub relation situation_parts_non_regularisee(s: Societe) kind empirical { label fr official "Déclaration du Code civil : situation parts non regularisee"; label en unofficial "Civil Code declaration: situation parts non regularisee"; }
pub relation demande_dissolution_introduite_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : demande dissolution introduite le"; label en unofficial "Civil Code declaration: demande dissolution introduite le"; key(s); }
