pub relation delai_judiciaire_admissible(s: Societe) kind derived { label fr official "Déclaration du Code civil : delai judiciaire admissible"; label en unofficial "Civil Code declaration: delai judiciaire admissible"; }
pub relation expiration_societe_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : expiration societe le"; label en unofficial "Civil Code declaration: expiration societe le"; key(s); }
pub relation consultation_prorogation_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : consultation prorogation le"; label en unofficial "Civil Code declaration: consultation prorogation le"; key(s); }
pub relation consultation_prorogation_en_temps(s: Societe) kind derived { label fr official "Déclaration du Code civil : consultation prorogation en temps"; label en unofficial "Civil Code declaration: consultation prorogation en temps"; }
pub relation dissolution_societe_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : dissolution societe le"; label en unofficial "Civil Code declaration: dissolution societe le"; key(s); }
pub relation cloture_liquidation_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : cloture liquidation le"; label en unofficial "Civil Code declaration: cloture liquidation le"; key(s); }
pub relation liquidation_non_close(s: Societe) kind empirical { label fr official "Déclaration du Code civil : liquidation non close"; label en unofficial "Civil Code declaration: liquidation non close"; }
pub relation saisine_liquidation_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : saisine liquidation le"; label en unofficial "Civil Code declaration: saisine liquidation le"; key(s); }
pub relation saisine_liquidation_possible(s: Societe) kind derived { label fr official "Déclaration du Code civil : saisine liquidation possible"; label en unofficial "Civil Code declaration: saisine liquidation possible"; }
pub relation action_nullite_introduite_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : action nullite introduite le"; label en unofficial "Civil Code declaration: action nullite introduite le"; key(s); }
