pub relation mois_ecoules_depuis_action_nullite(s: Societe, n: Integer) kind empirical { label fr official "Déclaration du Code civil : mois ecoules depuis action nullite"; label en unofficial "Civil Code declaration: mois ecoules depuis action nullite"; key(s); }
