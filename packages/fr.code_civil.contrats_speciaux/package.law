// Société civile.
pub relation societe_civile(s: Societe) kind empirical { label fr official "Déclaration du Code civil : societe civile"; label en unofficial "Civil Code declaration: societe civile"; }
pub relation candidat_gerant(s: Societe, p: Personne) kind empirical { label fr official "Déclaration du Code civil : candidat gerant"; label en unofficial "Civil Code declaration: candidat gerant"; }
pub relation gerant(s: Societe, p: Personne) kind empirical { label fr official "Déclaration du Code civil : gerant"; label en unofficial "Civil Code declaration: gerant"; key(s); }
pub relation voix_favorables(s: Societe, p: Personne, n: Integer) kind empirical { label fr official "Déclaration du Code civil : voix favorables"; label en unofficial "Civil Code declaration: voix favorables"; key(s, p); }
pub relation nomination_majoritaire(s: Societe, p: Personne) kind derived { label fr official "Déclaration du Code civil : nomination majoritaire"; label en unofficial "Civil Code declaration: nomination majoritaire"; }
pub relation revocation_majoritaire(s: Societe, p: Personne) kind derived { label fr official "Déclaration du Code civil : revocation majoritaire"; label en unofficial "Civil Code declaration: revocation majoritaire"; }
pub external judgment relation juste_motif_de_revocation(s: Societe, p: Personne) { authority Court; label fr official "juste motif de révocation au sens de l'article 1851"; label en unofficial "proper ground for removal within Article 1851"; }
pub relation dommages_interets_pour_revocation(s: Societe, p: Personne) kind derived { label fr official "Déclaration du Code civil : dommages interets pour revocation"; label en unofficial "Civil Code declaration: dommages interets pour revocation"; }
