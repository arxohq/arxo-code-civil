pub relation dissolution_demandable_absence_gerant(s: Societe) kind derived { label fr official "Déclaration du Code civil : dissolution demandable absence gerant"; label en unofficial "Civil Code declaration: dissolution demandable absence gerant"; }
pub relation interesse_societe(s: Societe, interesse_: Personne) kind empirical { label fr official "personne intéressée dans la société"; label en unofficial "interested person in the company"; }
pub relation demande_dissolution_exercee(s: Societe, interesse_: Personne) kind empirical { label fr official "demande de dissolution exercée"; label en unofficial "dissolution request exercised"; }
pub relation demande_dommages_revocation_exercee(s: Societe, gerant_: Personne) kind empirical { label fr official "demande de dommages-intérêts pour révocation"; label en unofficial "damages claim for removal"; }
pub relation question_ecrite_associe_le(s: Societe, p: Personne, d: Date) kind empirical { label fr official "Déclaration du Code civil : question ecrite associe le"; label en unofficial "Civil Code declaration: question ecrite associe le"; key(s, p); }
pub relation reponse_ecrite_du_gerant(s: Societe, p: Personne) kind empirical { label fr official "Déclaration du Code civil : reponse ecrite du gerant"; label en unofficial "Civil Code declaration: reponse ecrite du gerant"; }
pub relation dette_sociale(s: Societe, c: Creance, m: Money) kind empirical { label fr official "Déclaration du Code civil : dette sociale"; label en unofficial "Civil Code declaration: dette sociale"; key(s, c); }
pub relation poursuites_prealables_vaines(s: Societe, c: Creance) kind empirical { label fr official "Déclaration du Code civil : poursuites prealables vaines"; label en unofficial "Civil Code declaration: poursuites prealables vaines"; }
pub relation termes_quote_part(s: Societe, p: Personne, n: Integer, d: Decimal) kind empirical { label fr official "Déclaration du Code civil : termes quote part"; label en unofficial "Civil Code declaration: termes quote part"; key(s, p); }
pub relation montant_du_par_associe(s: Societe, c: Creance, p: Personne, m: Money) kind derived { label fr official "Déclaration du Code civil : montant du par associe"; label en unofficial "Civil Code declaration: montant du par associe"; key(s, c, p); }
pub relation dissolution_publiee_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : dissolution publiee le"; label en unofficial "Civil Code declaration: dissolution publiee le"; key(s); }
pub relation action_contre_associe_introduite_le(s: Societe, p: Personne, d: Date) kind empirical { label fr official "Déclaration du Code civil : action contre associe introduite le"; label en unofficial "Civil Code declaration: action contre associe introduite le"; key(s, p); }
pub relation action_contre_associe_recevable(s: Societe, p: Personne) kind derived { label fr official "Déclaration du Code civil : action contre associe recevable"; label en unofficial "Civil Code declaration: action contre associe recevable"; }
pub relation derniere_notification_cession_le(s: Societe, p: Personne, d: Date) kind empirical { label fr official "Déclaration du Code civil : derniere notification cession le"; label en unofficial "Civil Code declaration: derniere notification cession le"; key(s, p); }
pub relation offre_achat_faite_le(s: Societe, p: Personne, d: Date) kind empirical { label fr official "Déclaration du Code civil : offre achat faite le"; label en unofficial "Civil Code declaration: offre achat faite le"; key(s, p); }
