pub relation delai_statutaire_agrement_mois(s: Societe, n: Integer) kind empirical { label fr official "Déclaration du Code civil : delai statutaire agrement mois"; label en unofficial "Civil Code declaration: delai statutaire agrement mois"; key(s); }
pub relation delai_statutaire_agrement_valide(s: Societe) kind derived { label fr official "Déclaration du Code civil : delai statutaire agrement valide"; label en unofficial "Civil Code declaration: delai statutaire agrement valide"; }
pub relation vente_forcee_prevue_le(s: Societe, d: Date) kind empirical { label fr official "Déclaration du Code civil : vente forcee prevue le"; label en unofficial "Civil Code declaration: vente forcee prevue le"; key(s); }
