pub relation associe_peut_se_retirer(s: Societe, p: Personne) kind derived { label fr official "Déclaration du Code civil : associe peut se retirer"; label en unofficial "Civil Code declaration: associe peut se retirer"; }

// Société, société civile et société en participation — seconde vague.
pub enum CauseFinSociete { label fr official "Déclaration du Code civil : cause Fin Societe"; label en unofficial "Civil Code declaration: cause Fin Societe"; Expiration, ObjetRealise, ObjetEteint, Annulation, DecisionAssocies, TribunalJustesMotifs, ReunionParts, ClotureInsuffisanceActif, CauseStatutaire }
pub relation duree_societe_ans(s: Societe, n: Integer) kind empirical { label fr official "Déclaration du Code civil : duree societe ans"; label en unofficial "Civil Code declaration: duree societe ans"; key(s); }
