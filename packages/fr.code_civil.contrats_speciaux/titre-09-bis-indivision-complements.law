    creancier_personnel_indivision,
    creancier_peut_provoquer_partage,
    creancier_peut_saisir_quote_part,
    debiteur_ne_peut_pas_provoquer_partage,
    debiteur_peut_provoquer_partage,
    depense_conservation_biens_indivis,
    disposition_meuble_exercee,
    disposition_meuble_par_gerant_admise,
    droits_preemption_substitution_applicables,
    exercice_droits_indivis_exerce,
    exigence_documents_gestion_exercee,
    faute_gestion_gerant_indivision,
    fautes_gestion_met_en_peril_indivision,
    gerant_indivision_nomme,
    gerant_indivision_personne,
    gerant_non_indivisaire,
    indivisaire_incapable_present,
    majorite_indivisaires_nombre_et_parts,
    meuble_exploitation_normale_ou_deperissable,
    nomination_gerant_exercee,
    nomination_gerant_indivision_admise,
    operation_bloquee_par_opposition,
    opposition_gerant_avant_operation,
    opposition_operation_exercee,
    part_devolue_personne_etrangere,
    participation_depense_conservation_due,
    pluralite_gerants_indivision,
