    CC_ART1882,
    CC_ART1883,
    CC_ART1884,
    CC_ART1885,
    CC_ART1886,
    CC_ART1887,
    CC_ART1888,
    CC_ART1889,
    CC_ART1890,
    CC_ART1891,
    CC_ART1892,
    CC_ART1893,
    CC_ART1894,
    CC_ART1895,
    CC_ART1896,
    CC_ART1897,
    CC_ART1898,
    CC_ART1899,
    CC_ART1900,
    CC_ART1901,
