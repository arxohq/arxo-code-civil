language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-S01-conjoint-moitie" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "f": conjoint_notifie_associe(entity_ref("urn:cc13:s01:s"), entity_ref("urn:cc13:s01:p"), 9) { origin case_input; } } evaluate truth(parts_reconnues_au_conjoint(entity_ref("urn:cc13:s01:s"), entity_ref("urn:cc13:s01:p"), 9 / 2)); expect evaluation_status == COMPUTED; expect truth_status == TRUE_ONLY; }
