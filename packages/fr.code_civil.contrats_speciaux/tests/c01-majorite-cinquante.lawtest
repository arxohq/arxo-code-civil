language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-C01-majorite-cinquante" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "s": societe_civile(entity_ref("urn:cc13:c01:s")) { origin case_input; } assert "g": candidat_gerant(entity_ref("urn:cc13:c01:s"), entity_ref("urn:cc13:c01:g")) { origin case_input; } assert "v": voix_favorables(entity_ref("urn:cc13:c01:s"), entity_ref("urn:cc13:c01:g"), 50) { origin case_input; } assert "t": total_des_parts(entity_ref("urn:cc13:c01:s"), 100) { origin case_input; } } evaluate truth(nomination_majoritaire(entity_ref("urn:cc13:c01:s"), entity_ref("urn:cc13:c01:g"))); expect truth_status == NEITHER; }
