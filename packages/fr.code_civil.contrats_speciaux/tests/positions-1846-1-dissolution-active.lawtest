language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-1846-1-dissolution-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_AN; }
 assert "f1": societe_civile(entity_ref("urn:cc13:s37:s")) { origin case_input; }
 assert "f2": absence_de_gerant_depuis(entity_ref("urn:cc13:s37:s"), @2024-01-01) { origin case_input; }
 assert "f3": demande_dissolution_introduite_le(entity_ref("urn:cc13:s37:s"), @2025-06-01) { origin case_input; }
 assert "f4": interesse_societe(entity_ref("urn:cc13:s37:s"), entity_ref("urn:cc13:s37:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderDissolutionSansGerant, ACTIVE); }
