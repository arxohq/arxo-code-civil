language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-D02-plafond-cinquante" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "h": depot_hotelier(entity_ref("urn:cc13:d02:d")) { origin case_input; } assert "v": chose_dans_vehicule_stationne(entity_ref("urn:cc13:d02:d")) { origin case_input; } assert "p": prix_journalier_chambre(entity_ref("urn:cc13:d02:d"), 120 EUR) { origin case_input; } } evaluate truth(plafond_indemnisation_hotel(entity_ref("urn:cc13:d02:d"), 6000 EUR)); expect truth_status == TRUE_ONLY; }
