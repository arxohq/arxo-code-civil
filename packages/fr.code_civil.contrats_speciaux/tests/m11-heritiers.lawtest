language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-M11-heritiers" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "d": deces_mandataire(entity_ref("urn:cc13:m11:m")) { origin case_input; } assert "a": heritiers_ont_avise_mandant(entity_ref("urn:cc13:m11:m")) { origin case_input; } assert "p": heritiers_ont_pourvu_interet_mandant(entity_ref("urn:cc13:m11:m")) { origin case_input; } } evaluate truth(obligations_heritiers_mandataire_accomplies(entity_ref("urn:cc13:m11:m"))); expect truth_status == TRUE_ONLY; }
