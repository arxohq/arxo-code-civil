language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-1873-1-exercise-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": titulaires_droits_indivis(entity_ref("urn:cc13:i20:c")) { origin case_input; }
 assert "f2": titulaire_indivision(entity_ref("urn:cc13:i20:c"), entity_ref("urn:cc13:i20:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirConvenirExerciceDroitsIndivis, ACTIVE); }
