language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-105-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": partie_assistee_avocat(entity_ref("urn:cc13:105a:p")) { origin case_input; }
 assert "f2": droits_librement_disponibles_procedure(entity_ref("urn:cc13:105a:p")) { origin case_input; }
 assert "f3": conclusion_procedure_exercee(entity_ref("urn:cc13:105a:p"), entity_ref("urn:cc13:105a:q")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirConclureProcedureParticipative, ACTIVE); }
