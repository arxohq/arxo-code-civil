language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-052-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": demande_restitution_avant_terme(entity_ref("urn:cc13:052a:pr")) { origin case_input; }
 assert "f2": terme_du_pret(entity_ref("urn:cc13:052a:pr"), @2027-01-01) { origin case_input; }
 assert "f3": preteur(entity_ref("urn:cc13:052a:pr"), entity_ref("urn:cc13:052a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionDemanderRestitutionAvantTerme, ACTIVE); expect position(P3PositionMaintenanceInterdictionDemanderRestitutionAvantTerme, ACTIVE); }
