language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-036-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": tiers_bonne_foi_nullite(entity_ref("urn:cc13:x0b:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:x0b:s"), entity_ref("urn:cc13:x0b:p")) { origin case_input; }
 assert "f3": nullite_tiers_non_opposee_exercee(entity_ref("urn:cc13:x0b:s"), entity_ref("urn:cc13:x0b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionOpposerNulliteTiersBonneFoi, VIOLATED); expect position(P3PositionMaintenanceInterdictionOpposerNulliteTiersBonneFoi, VIOLATED); }
test "CC13-positions-036-second-b" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": tiers_bonne_foi_nullite(entity_ref("urn:cc13:x0t:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:x0t:s"), entity_ref("urn:cc13:x0t:p")) { origin case_input; }
 assert "f3": nullite_tiers_non_opposee_exercee(entity_ref("urn:cc13:x0t:s"), entity_ref("urn:cc13:x0t:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionOpposerNulliteTiersBonneFoi, VIOLATED); expect position(P3PositionMaintenanceInterdictionOpposerNulliteTiersBonneFoi, VIOLATED); }
