language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-057-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": chose_deposee_mobiliere(entity_ref("urn:cc13:057s:d")) { origin case_input; }
 assert "f2": deposant(entity_ref("urn:cc13:057s:d"), entity_ref("urn:cc13:057s:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDeposerChoseMobiliere, ACTIVE); }
