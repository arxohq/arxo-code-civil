language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-R03-inexecution-recevable" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "a": procedure_participative_active(entity_ref("urn:cc13:r03:p")) { origin case_input; } assert "i": inexecution_partie_adverse(entity_ref("urn:cc13:r03:p")) { origin case_input; } } evaluate truth(saisine_juridiction_recevable(entity_ref("urn:cc13:r03:p"))); expect truth_status == TRUE_ONLY; }
