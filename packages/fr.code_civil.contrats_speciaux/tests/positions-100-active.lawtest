language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-100-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": tuteur_autorise_selon_regime_protection(entity_ref("urn:cc13:100a:t")) { origin case_input; }
 assert "f2": tuteur_transaction(entity_ref("urn:cc13:100a:t"), entity_ref("urn:cc13:100a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirTransactionTuteur, ACTIVE); }
