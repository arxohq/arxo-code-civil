language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-046-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": aucune_convention_partage_anticipe(entity_ref("urn:cc13:z046a:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:z046a:s"), entity_ref("urn:cc13:z046a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionPartagerBiensAvantDissolution, ACTIVE); expect position(P3PositionMaintenanceInterdictionPartagerBiensAvantDissolution, ACTIVE); }
