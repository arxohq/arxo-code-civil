language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-052-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": demande_restitution_avant_terme(entity_ref("urn:cc13:052s:pr")) { origin case_input; }
 assert "f2": terme_du_pret(entity_ref("urn:cc13:052s:pr"), @2027-01-01) { origin case_input; }
 assert "f3": preteur(entity_ref("urn:cc13:052s:pr"), entity_ref("urn:cc13:052s:p")) { origin case_input; }
 assert "f4": demande_restitution_exercee(entity_ref("urn:cc13:052s:pr"), entity_ref("urn:cc13:052s:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionDemanderRestitutionAvantTerme, VIOLATED); expect position(P3PositionMaintenanceInterdictionDemanderRestitutionAvantTerme, VIOLATED); }

test "CC13-positions-052-second-b" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": demande_restitution_avant_terme(entity_ref("urn:cc13:052t:pr")) { origin case_input; }
 assert "f2": terme_du_pret(entity_ref("urn:cc13:052t:pr"), @2027-01-01) { origin case_input; }
 assert "f3": preteur(entity_ref("urn:cc13:052t:pr"), entity_ref("urn:cc13:052t:p")) { origin case_input; }
 assert "f4": demande_restitution_exercee(entity_ref("urn:cc13:052t:pr"), entity_ref("urn:cc13:052t:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionDemanderRestitutionAvantTerme, VIOLATED); expect position(P3PositionMaintenanceInterdictionDemanderRestitutionAvantTerme, VIOLATED); }
