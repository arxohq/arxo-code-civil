language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

test "CC13-positions-1989-prohibition-active" {
    given {
        context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "f1": acte_au_dela_du_mandat(entity_ref("urn:cc13:p1:m")) { origin case_input; }
        assert "f2": mandataire(entity_ref("urn:cc13:p1:m"), entity_ref("urn:cc13:p1:agent")) { origin case_input; }
    }
    evaluate positions();
    expect position(P3PositionInterdictionAgirAuDelaDuMandat, ACTIVE);
    expect position(P3PositionMaintenanceInterdictionAgirAuDelaDuMandat, ACTIVE);
}
