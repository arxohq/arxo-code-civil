language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-M09-renonciation-excusee" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "n": renonciation_notifiee_au_mandant(entity_ref("urn:cc13:m09:m")) { origin case_input; } assert "p": renonciation_prejudicie_mandant(entity_ref("urn:cc13:m09:m")) { origin adjudicated; } assert "e": impossibilite_continuer_sans_prejudice_considerable(entity_ref("urn:cc13:m09:m")) { origin adjudicated; } } evaluate truth(indemnite_renonciation_due(entity_ref("urn:cc13:m09:m"))); expect truth_status == NEITHER; expect judgment_requests(0); }
