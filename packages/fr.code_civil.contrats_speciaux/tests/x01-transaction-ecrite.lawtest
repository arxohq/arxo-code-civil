language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-X01-transaction-ecrite" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "c": concessions_reciproques(entity_ref("urn:cc13:x01:t")) { origin case_input; } assert "e": transaction_ecrite(entity_ref("urn:cc13:x01:t")) { origin case_input; } } evaluate truth(transaction_valide(entity_ref("urn:cc13:x01:t"))); expect truth_status == TRUE_ONLY; }
