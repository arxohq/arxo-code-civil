language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-T02-participation-solidaire" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "c": contrat_de_societe(entity_ref("urn:cc13:t02:s")) { origin case_input; } assert "n": societe_non_immatriculee(entity_ref("urn:cc13:t02:s")) { origin case_input; } assert "a": associe(entity_ref("urn:cc13:t02:s"), entity_ref("urn:cc13:t02:p")) { origin case_input; } assert "o": associes_agissent_ouvertement(entity_ref("urn:cc13:t02:s")) { origin case_input; } assert "m": societe_caractere_commercial(entity_ref("urn:cc13:t02:s")) { origin case_input; } } evaluate truth(obligation_solidaire_envers_tiers(entity_ref("urn:cc13:t02:s"), entity_ref("urn:cc13:t02:p"))); expect truth_status == TRUE_ONLY; }
