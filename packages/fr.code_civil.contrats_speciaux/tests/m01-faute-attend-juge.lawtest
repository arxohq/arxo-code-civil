language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-M01-faute-attend-juge" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "d": mandat_donne(entity_ref("urn:cc13:m01:m")) { origin case_input; } assert "a": mandat_accepte(entity_ref("urn:cc13:m01:m")) { origin case_input; } } evaluate truth(responsabilite_du_mandataire(entity_ref("urn:cc13:m01:m"))); expect truth_status == NEITHER; expect evaluation_status == REQUIRES_JUDGMENT; expect judgment_request(faute_du_mandataire, Court); }
