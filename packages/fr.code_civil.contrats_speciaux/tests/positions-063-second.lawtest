language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-063-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": depositaire(entity_ref("urn:cc13:063s:d"), entity_ref("urn:cc13:063s:p")) { origin case_input; }
 assert "f2": absence_permission_usage_deposant(entity_ref("urn:cc13:063s:d")) { origin case_input; }
 assert "f3": usage_chose_deposee_exerce(entity_ref("urn:cc13:063s:d"), entity_ref("urn:cc13:063s:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionUsageDepotSansPermission, VIOLATED); expect position(P3PositionMaintenanceInterdictionUsageDepotSansPermission, VIOLATED); }

test "CC13-positions-063-second-b" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": depositaire(entity_ref("urn:cc13:063t:d"), entity_ref("urn:cc13:063t:p")) { origin case_input; }
 assert "f2": absence_permission_usage_deposant(entity_ref("urn:cc13:063t:d")) { origin case_input; }
 assert "f3": usage_chose_deposee_exerce(entity_ref("urn:cc13:063t:d"), entity_ref("urn:cc13:063t:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionUsageDepotSansPermission, VIOLATED); expect position(P3PositionMaintenanceInterdictionUsageDepotSansPermission, VIOLATED); }
