language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-2028-revocation-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": beneficiaire_n_a_pas_accepte_fiducie(entity_ref("urn:cc13:p15:f")) { origin case_input; }
 assert "f2": constituant_fiducie(entity_ref("urn:cc13:p15:f"), entity_ref("urn:cc13:p15:constituant")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirRevoquerFiducieAvantAcceptation, ACTIVE); }
