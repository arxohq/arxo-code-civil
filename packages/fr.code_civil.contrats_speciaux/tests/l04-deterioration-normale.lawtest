language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-L04-deterioration-normale" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "d": deterioration_par_usage_convenu(entity_ref("urn:cc13:l04:p")) { origin case_input; } assert "f": aucune_faute_emprunteur(entity_ref("urn:cc13:l04:p")) { origin adjudicated; } } evaluate truth(emprunteur_non_responsable_deterioration(entity_ref("urn:cc13:l04:p"))); expect truth_status == TRUE_ONLY; }
