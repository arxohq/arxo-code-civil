language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-L03-perte-usage-non-conforme" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "u": usage_non_conforme(entity_ref("urn:cc13:l03:p")) { origin case_input; } assert "p": perte_chose_pretee(entity_ref("urn:cc13:l03:p")) { origin case_input; } } evaluate truth(emprunteur_responsable_perte(entity_ref("urn:cc13:l03:p"))); expect truth_status == TRUE_ONLY; }
