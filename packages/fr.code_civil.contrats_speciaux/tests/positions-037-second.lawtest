language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-037-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": nullite_incapacite_ou_vice_consentement(entity_ref("urn:cc13:x1b:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:x1b:s"), entity_ref("urn:cc13:x1b:p")) { origin case_input; }
 assert "f3": nullite_protegee_opposee_exercee(entity_ref("urn:cc13:x1b:s"), entity_ref("urn:cc13:x1b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirOpposerNullitePersonneProtegee, ACTIVE); }
