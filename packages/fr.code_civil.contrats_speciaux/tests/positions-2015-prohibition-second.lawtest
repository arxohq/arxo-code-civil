language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-2015-prohibition-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": fiduciaire_non_autorise(entity_ref("urn:cc13:p12:f")) { origin case_input; }
 assert "f2": fiduciaire_fiducie(entity_ref("urn:cc13:p12:f"), entity_ref("urn:cc13:p12:fiduciaire")) { origin case_input; }
 assert "f3": acte_fiduciaire_exerce(entity_ref("urn:cc13:p12:f"), entity_ref("urn:cc13:p12:fiduciaire")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionActiviteFiduciaireNonAutorisee, VIOLATED); expect position(P3PositionMaintenanceInterdictionFiduciaireNonAutorise, VIOLATED); }
