language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

test "CC13-positions-1996-interest-second" {
    given {
        context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "f1": reliquat_apres_mise_en_demeure(entity_ref("urn:cc13:p4:m")) { origin case_input; }
        assert "f2": mandant(entity_ref("urn:cc13:p4:m"), entity_ref("urn:cc13:p4:principal")) { origin case_input; }
        assert "f3": mandataire(entity_ref("urn:cc13:p4:m"), entity_ref("urn:cc13:p4:agent")) { origin case_input; }
    }
    evaluate positions();
    expect position(P3PositionDevoirPayerInteretsMandataire, ACTIVE);
}
