language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-L07-interets-non-stipules" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "m": interets_non_stipules_payes(entity_ref("urn:cc13:l07:p"), 80 EUR) { origin case_input; } } evaluate truth(restitution_interets_non_stipules_exclue(entity_ref("urn:cc13:l07:p"), 80 EUR)); expect truth_status == TRUE_ONLY; }
