language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-038-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": nomination_ou_cessation_gerant_publiee(entity_ref("urn:cc13:x2b:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:x2b:s"), entity_ref("urn:cc13:x2b:p")) { origin case_input; }
 assert "f3": irregularite_gerant_invoquee(entity_ref("urn:cc13:x2b:s"), entity_ref("urn:cc13:x2b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionInvoquerIrregulariteGerant, VIOLATED); expect position(P3PositionMaintenanceInterdictionInvoquerIrregulariteGerant, VIOLATED); }
test "CC13-positions-038-second-b" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": nomination_ou_cessation_gerant_publiee(entity_ref("urn:cc13:x2t:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:x2t:s"), entity_ref("urn:cc13:x2t:p")) { origin case_input; }
 assert "f3": irregularite_gerant_invoquee(entity_ref("urn:cc13:x2t:s"), entity_ref("urn:cc13:x2t:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionInvoquerIrregulariteGerant, VIOLATED); expect position(P3PositionMaintenanceInterdictionInvoquerIrregulariteGerant, VIOLATED); }
