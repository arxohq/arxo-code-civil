language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RESTITUTIONDELACHOSEPRETEE-2" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": pret_a_usage(entity_ref("urn:law:catalog:restitutiondelachosepretee:v0")) { origin case_input; }
        assert "cat-1": terme_du_pret(entity_ref("urn:law:catalog:restitutiondelachosepretee:v0"), @2026-01-15) { origin case_input; }
        assert "cat-2": chose_pretee(entity_ref("urn:law:catalog:restitutiondelachosepretee:v0"), entity_ref("urn:law:catalog:restitutiondelachosepretee:v3")) { origin case_input; }
        assert "cat-3": preteur(entity_ref("urn:law:catalog:restitutiondelachosepretee:v0"), entity_ref("urn:law:catalog:restitutiondelachosepretee:v1")) { origin case_input; }
        assert "cat-4": pret_conclu_le(entity_ref("urn:law:catalog:restitutiondelachosepretee:v0"), @2026-01-15) { origin case_input; }
        assert "cat-5": emprunteur(entity_ref("urn:law:catalog:restitutiondelachosepretee:v0"), entity_ref("urn:law:catalog:restitutiondelachosepretee:v2")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(RestituerChosePretee, UNDETERMINED);
}
