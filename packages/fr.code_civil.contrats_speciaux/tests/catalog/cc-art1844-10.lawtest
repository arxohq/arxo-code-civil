language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CLAUSECONTRAIREDISPOSITIONIMPERATIVENONECRITE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": clause_contraire_disposition_imperative(entity_ref("urn:law:catalog:clausecontrairedispositionimperativenonecrite:v0")) { origin case_input; }
    }
    evaluate truth(clause_societe_reputee_non_ecrite(entity_ref("urn:law:catalog:clausecontrairedispositionimperativenonecrite:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-VIOLATIONSTATUTSSEULENECAUSEPASNULLITE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": violation_statuts_seule(entity_ref("urn:law:catalog:violationstatutsseulenecausepasnullite:v0")) { origin case_input; }
    }
    evaluate truth(nullite_pour_violation_statuts_exclue(entity_ref("urn:law:catalog:violationstatutsseulenecausepasnullite:v0")));
    expect truth_status == TRUE_ONLY;
}
