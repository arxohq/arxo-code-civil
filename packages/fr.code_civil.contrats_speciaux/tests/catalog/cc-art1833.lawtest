language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CONSTITUTIONDANSINTERETCOMMUN" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": contrat_de_societe(entity_ref("urn:law:catalog:constitutiondansinteretcommun:v0")) { origin case_input; }
        assert "cat-1": interet_commun_des_associes(entity_ref("urn:law:catalog:constitutiondansinteretcommun:v0")) { origin case_input; }
    }
    evaluate truth(constituee_dans_interet_commun(entity_ref("urn:law:catalog:constitutiondansinteretcommun:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-GESTIONDANSINTERETSOCIAL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": contrat_de_societe(entity_ref("urn:law:catalog:gestiondansinteretsocial:v0")) { origin case_input; }
        assert "cat-1": interet_social_de_la_societe(entity_ref("urn:law:catalog:gestiondansinteretsocial:v0")) { origin case_input; }
    }
    evaluate truth(geree_dans_interet_social(entity_ref("urn:law:catalog:gestiondansinteretsocial:v0")));
    expect truth_status == TRUE_ONLY;
}
