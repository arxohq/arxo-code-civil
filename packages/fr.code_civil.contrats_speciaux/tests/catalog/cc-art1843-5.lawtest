language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ASSEMBLEENEPEUTETEINDREACTIONGERANT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": assemblee_tente_eteindre_action_gerant(entity_ref("urn:law:catalog:assembleenepeuteteindreactiongerant:v0")) { origin case_input; }
    }
    evaluate truth(extinction_action_par_assemblee_exclue(entity_ref("urn:law:catalog:assembleenepeuteteindreactiongerant:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CLAUSERESTRICTIONACTIONSOCIALENONECRITE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": clause_subordonne_ou_renonce_action_sociale(entity_ref("urn:law:catalog:clauserestrictionactionsocialenonecrite:v0")) { origin case_input; }
    }
    evaluate truth(clause_action_sociale_reputee_non_ecrite(entity_ref("urn:law:catalog:clauserestrictionactionsocialenonecrite:v0")));
    expect truth_status == TRUE_ONLY;
}
