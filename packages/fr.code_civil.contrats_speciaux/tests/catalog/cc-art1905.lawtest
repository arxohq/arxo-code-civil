language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-INTERETSCONVENTIONNELSEXIGENTECRIT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": interets_stipules(entity_ref("urn:law:catalog:interetsconventionnelsexigentecrit:v0")) { origin case_input; }
        assert "cat-1": convention_interets_ecrite(entity_ref("urn:law:catalog:interetsconventionnelsexigentecrit:v0")) { origin case_input; }
    }
    evaluate truth(interets_conventionnels_exigibles(entity_ref("urn:law:catalog:interetsconventionnelsexigentecrit:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-INTERETSPEUVENTETRESTIPULES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": interets_stipules(entity_ref("urn:law:catalog:interetspeuventetrestipules:v0")) { origin case_input; }
    }
    evaluate truth(stipulation_interets_permises(entity_ref("urn:law:catalog:interetspeuventetrestipules:v0")));
    expect truth_status == TRUE_ONLY;
}
