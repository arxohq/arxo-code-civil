language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CONTINUATIONAPRESDECESASSOCIE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": deces_associe(entity_ref("urn:law:catalog:continuationapresdecesassocie:v0"), entity_ref("urn:law:catalog:continuationapresdecesassocie:v1")) { origin case_input; }
        assert "cat-1": aucune_clause_dissolution_deces(entity_ref("urn:law:catalog:continuationapresdecesassocie:v0")) { origin case_input; }
    }
    evaluate truth(societe_continue_apres_deces(entity_ref("urn:law:catalog:continuationapresdecesassocie:v0")));
    expect truth_status == TRUE_ONLY;
}
