language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-INDUSTRIEHORSCAPITAL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": associe(entity_ref("urn:law:catalog:industriehorscapital:v0"), entity_ref("urn:law:catalog:industriehorscapital:v1")) { origin case_input; }
        assert "cat-1": apport_en_industrie(entity_ref("urn:law:catalog:industriehorscapital:v0"), entity_ref("urn:law:catalog:industriehorscapital:v1")) { origin case_input; }
    }
    evaluate truth(apport_industrie_hors_capital(entity_ref("urn:law:catalog:industriehorscapital:v0"), entity_ref("urn:law:catalog:industriehorscapital:v1")));
    expect truth_status == TRUE_ONLY;
}
