language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ENGAGEMENTPRETTRANSMISAUXHERITIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": pret_a_usage(entity_ref("urn:law:catalog:engagementprettransmisauxheritiers:v0")) { origin case_input; }
    }
    evaluate truth(engagement_pret_transmis_aux_heritiers(entity_ref("urn:law:catalog:engagementprettransmisauxheritiers:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-INTUITUPERSONAEEXCLUTJOUISSANCEHERITIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": pret_conclu_en_consideration_personnelle_emprunteur(entity_ref("urn:law:catalog:intuitupersonaeexclutjouissanceheritiers:v0")) { origin case_input; }
    }
    evaluate truth(jouissance_heritiers_emprunteur_exclue(entity_ref("urn:law:catalog:intuitupersonaeexclutjouissanceheritiers:v0")));
    expect truth_status == TRUE_ONLY;
}
