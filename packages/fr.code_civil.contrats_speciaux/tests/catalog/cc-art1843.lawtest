language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-AUTEURACTESOCIETEENFORMATIONTENU" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_societe_formation(entity_ref("urn:law:catalog:auteuractesocieteenformationtenu:v0"), entity_ref("urn:law:catalog:auteuractesocieteenformationtenu:v1")) { origin case_input; }
    }
    evaluate truth(auteur_acte_formation_tenu(entity_ref("urn:law:catalog:auteuractesocieteenformationtenu:v0"), entity_ref("urn:law:catalog:auteuractesocieteenformationtenu:v1")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-REPRISEENGAGEMENTRETROAGITALORIGINE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": reprise_engagement_apres_immatriculation(entity_ref("urn:law:catalog:repriseengagementretroagitalorigine:v0")) { origin case_input; }
    }
    evaluate truth(engagement_repute_originairement_societe(entity_ref("urn:law:catalog:repriseengagementretroagitalorigine:v0")));
    expect truth_status == TRUE_ONLY;
}
