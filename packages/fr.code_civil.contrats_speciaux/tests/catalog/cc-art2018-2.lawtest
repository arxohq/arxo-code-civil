language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CESSIONCREANCEOPPOSABLEAUXTIERS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cession_creance_fiduciaire(entity_ref("urn:law:catalog:cessioncreanceopposableauxtiers:v0")) { origin case_input; }
    }
    evaluate truth(cession_creance_opposable_aux_tiers(entity_ref("urn:law:catalog:cessioncreanceopposableauxtiers:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-CESSIONCREANCEOPPOSABLEDEBITEURAPRESNOTIFICATION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": notification_cession_au_debiteur(entity_ref("urn:law:catalog:cessioncreanceopposabledebiteurapresnotification:v0")) { origin case_input; }
        assert "cat-1": cession_creance_fiduciaire(entity_ref("urn:law:catalog:cessioncreanceopposabledebiteurapresnotification:v0")) { origin case_input; }
    }
    evaluate truth(cession_creance_opposable_au_debiteur(entity_ref("urn:law:catalog:cessioncreanceopposabledebiteurapresnotification:v0")));
    expect truth_status == TRUE_ONLY;
}
