language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-PAIEMENTJEUFRAUDULEUXRESTITUE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_volontaire_jeu(entity_ref("urn:law:catalog:paiementjeufrauduleuxrestitue:v0")) { origin case_input; }
        assert "cat-1": fraude_du_gagnant(entity_ref("urn:law:catalog:paiementjeufrauduleuxrestitue:v0")) { origin case_input; }
    }
    evaluate truth(restitution_paiement_jeu(entity_ref("urn:law:catalog:paiementjeufrauduleuxrestitue:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-PAIEMENTJEUVOLONTAIRENONRESTITUE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": paiement_volontaire_jeu(entity_ref("urn:law:catalog:paiementjeuvolontairenonrestitue:v0")) { origin case_input; }
    }
    evaluate truth(paiement_jeu_non_restituable(entity_ref("urn:law:catalog:paiementjeuvolontairenonrestitue:v0")));
    expect truth_status == TRUE_ONLY;
}
