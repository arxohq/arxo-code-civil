language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-ACTEAUDELAMANDATEXCEDEPOUVOIRS" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_au_dela_du_mandat(entity_ref("urn:law:catalog:acteaudelamandatexcedepouvoirs:v0")) { origin case_input; }
    }
    evaluate truth(acte_excede_pouvoirs(entity_ref("urn:law:catalog:acteaudelamandatexcedepouvoirs:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-TRANSIGERNINCLUTPASCOMPROMETTRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": pouvoir_de_transiger(entity_ref("urn:law:catalog:transigerninclutpascompromettre:v0")) { origin case_input; }
    }
    evaluate truth(pouvoir_de_compromettre_exclu(entity_ref("urn:law:catalog:transigerninclutpascompromettre:v0")));
    expect truth_status == TRUE_ONLY;
}
