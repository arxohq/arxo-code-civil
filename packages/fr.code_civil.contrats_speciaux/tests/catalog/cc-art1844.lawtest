// 
test "CATALOG-VOTEUSUFRUITIERPOURBENEFICES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": decision_affectation_benefices(entity_ref("urn:law:catalog:voteusufruitierpourbenefices:v0")) { origin case_input; }
