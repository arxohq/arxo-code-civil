language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RENTEEXCESSIVEREDUCTIBLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": rente_excede_quotite_disponible(entity_ref("urn:law:catalog:renteexcessivereductible:v0")) { origin case_input; }
        assert "cat-1": rente_constituee_a_titre_gratuit(entity_ref("urn:law:catalog:renteexcessivereductible:v0")) { origin case_input; }
    }
    evaluate truth(rente_reductible(entity_ref("urn:law:catalog:renteexcessivereductible:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-RENTENULLEBENEFICIAIREINCAPABLE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": beneficiaire_incapable_de_recevoir(entity_ref("urn:law:catalog:rentenullebeneficiaireincapable:v0")) { origin case_input; }
    }
    evaluate truth(rente_nulle_incapacite_beneficiaire(entity_ref("urn:law:catalog:rentenullebeneficiaireincapable:v0")));
    expect truth_status == TRUE_ONLY;
}
