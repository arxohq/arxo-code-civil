language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-REVOCATIONGERANTNONINDIVISAIREMAJORITAIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": majorite_indivisaires_nombre_et_parts(entity_ref("urn:law:catalog:revocationgerantnonindivisairemajoritaire:v0")) { origin case_input; }
        assert "cat-1": gerant_non_indivisaire(entity_ref("urn:law:catalog:revocationgerantnonindivisairemajoritaire:v0")) { origin case_input; }
    }
    evaluate truth(revocation_gerant_non_indivisaire_valide(entity_ref("urn:law:catalog:revocationgerantnonindivisairemajoritaire:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-REVOCATIONJUDICIAIREPOURPERILINDIVISION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": fautes_gestion_met_en_peril_indivision(entity_ref("urn:law:catalog:revocationjudiciairepourperilindivision:v0")) { origin case_input; }
    }
    evaluate truth(revocation_judiciaire_gerant_indivision(entity_ref("urn:law:catalog:revocationjudiciairepourperilindivision:v0")));
    expect truth_status == TRUE_ONLY;
}
