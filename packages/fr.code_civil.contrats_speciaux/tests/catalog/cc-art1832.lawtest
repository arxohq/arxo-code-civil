language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CONTRIBUTIONAUXPERTESOBLIGATOIRE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": contrat_de_societe(entity_ref("urn:law:catalog:contributionauxpertesobligatoire:v0")) { origin case_input; }
    }
    evaluate truth(contribution_aux_pertes_obligatoire(entity_ref("urn:law:catalog:contributionauxpertesobligatoire:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-SOCIETEUNIPERSONNELLEAUTORISEE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": acte_unilateral_societe_autorise_par_loi(entity_ref("urn:law:catalog:societeunipersonnelleautorisee:v0")) { origin case_input; }
    }
    evaluate truth(societe_instituee_unilateralement(entity_ref("urn:law:catalog:societeunipersonnelleautorisee:v0")));
    expect truth_status == TRUE_ONLY;
}
