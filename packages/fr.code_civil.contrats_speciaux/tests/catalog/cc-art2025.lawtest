language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-INSUFFISANCERENDPATRIMOINECONSTITUANTGAGE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": insuffisance_patrimoine_fiduciaire(entity_ref("urn:law:catalog:insuffisancerendpatrimoineconstituantgage:v0")) { origin case_input; }
        assert "cat-1": aucune_stipulation_passif_fiduciaire(entity_ref("urn:law:catalog:insuffisancerendpatrimoineconstituantgage:v0")) { origin case_input; }
    }
    evaluate truth(patrimoine_constituant_gage_commun(entity_ref("urn:law:catalog:insuffisancerendpatrimoineconstituantgage:v0")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-LIMITATIONPASSIFOPPOSABLEAUCREANCIERACCEPTANT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": creancier_accepte_expressement_clause(entity_ref("urn:law:catalog:limitationpassifopposableaucreancieracceptant:v0")) { origin case_input; }
        assert "cat-1": clause_limitation_passif_patrimoine_fiduciaire(entity_ref("urn:law:catalog:limitationpassifopposableaucreancieracceptant:v0")) { origin case_input; }
    }
    evaluate truth(clause_limitation_passif_opposable(entity_ref("urn:law:catalog:limitationpassifopposableaucreancieracceptant:v0")));
    expect truth_status == TRUE_ONLY;
}
