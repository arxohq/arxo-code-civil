language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-OPERATIONTIERSBONNEFOIAPRESFINVALIDE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": operation_avec_tiers_apres_fin(entity_ref("urn:law:catalog:operationtiersbonnefoiapresfinvalide:v0"), entity_ref("urn:law:catalog:operationtiersbonnefoiapresfinvalide:v1")) { origin case_input; }
        assert "cat-1": tiers_de_bonne_foi(entity_ref("urn:law:catalog:operationtiersbonnefoiapresfinvalide:v0"), entity_ref("urn:law:catalog:operationtiersbonnefoiapresfinvalide:v1")) { origin case_input; }
    }
    evaluate truth(operation_apres_fin_valide(entity_ref("urn:law:catalog:operationtiersbonnefoiapresfinvalide:v0"), entity_ref("urn:law:catalog:operationtiersbonnefoiapresfinvalide:v1")));
    expect truth_status == TRUE_ONLY;
}
