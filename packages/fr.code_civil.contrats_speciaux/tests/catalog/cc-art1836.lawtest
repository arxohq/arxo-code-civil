language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-AUGMENTATIONENGAGEMENTAVECCONSENTEMENT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": augmentation_engagement_associe(entity_ref("urn:law:catalog:augmentationengagementavecconsentement:v0"), entity_ref("urn:law:catalog:augmentationengagementavecconsentement:v1")) { origin case_input; }
        assert "cat-1": consentement_associe_augmentation(entity_ref("urn:law:catalog:augmentationengagementavecconsentement:v0"), entity_ref("urn:law:catalog:augmentationengagementavecconsentement:v1")) { origin case_input; }
    }
    evaluate truth(augmentation_engagement_valide(entity_ref("urn:law:catalog:augmentationengagementavecconsentement:v0"), entity_ref("urn:law:catalog:augmentationengagementavecconsentement:v1")));
    expect truth_status == TRUE_ONLY;
}
