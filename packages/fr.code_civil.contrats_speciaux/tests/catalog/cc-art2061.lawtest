language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-CLAUSECOMPROMISSOIRENONOPPOSABLENONPROFESSIONNEL" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": partie_n_agit_pas_professionnellement(entity_ref("urn:law:catalog:clausecompromissoirenonopposablenonprofessionnel:v0"), entity_ref("urn:law:catalog:clausecompromissoirenonopposablenonprofessionnel:v1")) { origin case_input; }
        assert "cat-1": clause_compromissoire(entity_ref("urn:law:catalog:clausecompromissoirenonopposablenonprofessionnel:v0")) { origin case_input; }
        assert "cat-2": partie_a_accepte_clause(entity_ref("urn:law:catalog:clausecompromissoirenonopposablenonprofessionnel:v0"), entity_ref("urn:law:catalog:clausecompromissoirenonopposablenonprofessionnel:v1")) { origin case_input; }
    }
    evaluate truth(clause_compromissoire_non_opposable(entity_ref("urn:law:catalog:clausecompromissoirenonopposablenonprofessionnel:v0"), entity_ref("urn:law:catalog:clausecompromissoirenonopposablenonprofessionnel:v1")));
    expect truth_status == TRUE_ONLY;
}
