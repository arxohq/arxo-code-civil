language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-075-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": arrerages_rente_impayes(entity_ref("urn:cc13:075s:r")) { origin case_input; }
 assert "f2": rentier(entity_ref("urn:cc13:075s:r"), entity_ref("urn:cc13:075s:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirSaisirArrerages, ACTIVE); }
