language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-P02-rachat-onze-ans" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "t": terme_rachat_rente_ans(entity_ref("urn:cc13:p02:p"), 11) { origin case_input; } } evaluate truth(terme_rachat_rente_valide(entity_ref("urn:cc13:p02:p"))); expect truth_status == NEITHER; }
