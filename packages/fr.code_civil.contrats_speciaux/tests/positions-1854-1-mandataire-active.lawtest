language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-1854-1-mandataire-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": pourcentage_capital_demandeurs(entity_ref("urn:cc13:s45:s"), 5.0) { origin case_input; }
 assert "f2": associe(entity_ref("urn:cc13:s45:s"), entity_ref("urn:cc13:s45:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderMandataireConsultation, ACTIVE); }
