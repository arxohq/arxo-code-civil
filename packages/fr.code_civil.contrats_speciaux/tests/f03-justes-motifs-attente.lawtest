language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-F03-justes-motifs-attente" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "c": cause_fin_societe(entity_ref("urn:cc13:f03:s"), TribunalJustesMotifs) { origin case_input; } } evaluate truth(societe_prend_fin(entity_ref("urn:cc13:f03:s"))); expect truth_status == NEITHER; expect evaluation_status == REQUIRES_JUDGMENT; expect judgment_request(justes_motifs_de_dissolution, Court); }
