language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-046-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": aucune_convention_partage_anticipe(entity_ref("urn:cc13:z046s:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:z046s:s"), entity_ref("urn:cc13:z046s:p")) { origin case_input; }
 assert "f3": partage_biens_indivis_exerce(entity_ref("urn:cc13:z046s:s"), entity_ref("urn:cc13:z046s:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionPartagerBiensAvantDissolution, VIOLATED); expect position(P3PositionMaintenanceInterdictionPartagerBiensAvantDissolution, VIOLATED); }
test "CC13-positions-046-second-b" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": aucune_convention_partage_anticipe(entity_ref("urn:cc13:z046t:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:z046t:s"), entity_ref("urn:cc13:z046t:p")) { origin case_input; }
 assert "f3": partage_biens_indivis_exerce(entity_ref("urn:cc13:z046t:s"), entity_ref("urn:cc13:z046t:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionPartagerBiensAvantDissolution, VIOLATED); expect position(P3PositionMaintenanceInterdictionPartagerBiensAvantDissolution, VIOLATED); }
