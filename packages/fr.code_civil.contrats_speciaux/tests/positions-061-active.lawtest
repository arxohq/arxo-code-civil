language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-061-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": deposant_incapable(entity_ref("urn:cc13:061a:d")) { origin case_input; }
 assert "f2": depositaire_capable(entity_ref("urn:cc13:061a:d")) { origin case_input; }
 assert "f3": depositaire(entity_ref("urn:cc13:061a:d"), entity_ref("urn:cc13:061a:p")) { origin case_input; }
 assert "f4": deposant(entity_ref("urn:cc13:061a:d"), entity_ref("urn:cc13:061a:q")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirDepositaireCapable, ACTIVE); }
