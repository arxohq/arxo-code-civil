language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-2004-titre-second" {
 given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
        assert "f1": cause_fin_mandat(entity_ref("urn:cc13:p10:m"), Revocation) { origin case_input; }
        assert "f2": mandant(entity_ref("urn:cc13:p10:m"), entity_ref("urn:cc13:p10:principal")) { origin case_input; }
 }
 evaluate positions();
 expect position(P3PositionPouvoirExigerRemiseTitre, ACTIVE);
}
