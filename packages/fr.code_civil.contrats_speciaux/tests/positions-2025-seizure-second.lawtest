language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-2025-seizure-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": creance_conservation_ou_gestion_patrimoine(entity_ref("urn:cc13:p18:f")) { origin case_input; }
 assert "f2": creancier_fiducie(entity_ref("urn:cc13:p18:f"), entity_ref("urn:cc13:p18:creancier")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirSaisirPatrimoineFiduciaire, ACTIVE); }
