language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-M03-fin-revocation" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "c": cause_fin_mandat(entity_ref("urn:cc13:m03:m"), Revocation) { origin case_input; } } evaluate truth(mandat_termine(entity_ref("urn:cc13:m03:m"))); expect evaluation_status == COMPUTED; expect truth_status == TRUE_ONLY; }
