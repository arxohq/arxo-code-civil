language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-R01-bonne-foi-attente" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "d": convention_procedure_a_duree_determinee(entity_ref("urn:cc13:r01:p")) { origin case_input; } } evaluate truth(procedure_participative_conforme(entity_ref("urn:cc13:r01:p"))); expect truth_status == NEITHER; expect evaluation_status == REQUIRES_JUDGMENT; expect judgment_request(bonne_foi_procedure_participative, Court); }
