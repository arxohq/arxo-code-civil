language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-P03-restitution-violee" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_AN; } assert "c": pret_de_consommation(entity_ref("urn:cc13:p03:p")) { origin case_input; } assert "l": preteur(entity_ref("urn:cc13:p03:p"), entity_ref("urn:cc13:p03:l")) { origin case_input; } assert "b": emprunteur(entity_ref("urn:cc13:p03:p"), entity_ref("urn:cc13:p03:b")) { origin case_input; } assert "q": quantite_pretee(entity_ref("urn:cc13:p03:p"), 100) { origin case_input; } assert "d": pret_conclu_le(entity_ref("urn:cc13:p03:p"), @2024-01-01) { origin case_input; } assert "t": terme_du_pret(entity_ref("urn:cc13:p03:p"), @2025-01-01) { origin case_input; } assert "x": not quantite_qualite_restituees(entity_ref("urn:cc13:p03:p")) { origin adjudicated; } } evaluate positions(); expect position(RestituerMemeQuantiteEtQualite, VIOLATED); expect evaluation_status == COMPUTED; }
test "CC13-P03-restitution-satisfaite" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_AN; } assert "c": pret_de_consommation(entity_ref("urn:cc13:p03:p2")) { origin case_input; } assert "l": preteur(entity_ref("urn:cc13:p03:p2"), entity_ref("urn:cc13:p03:l2")) { origin case_input; } assert "b": emprunteur(entity_ref("urn:cc13:p03:p2"), entity_ref("urn:cc13:p03:b2")) { origin case_input; } assert "q": quantite_pretee(entity_ref("urn:cc13:p03:p2"), 100) { origin case_input; } assert "d": pret_conclu_le(entity_ref("urn:cc13:p03:p2"), @2024-01-01) { origin case_input; } assert "t": terme_du_pret(entity_ref("urn:cc13:p03:p2"), @2025-01-01) { origin case_input; } assert "x": quantite_qualite_restituees(entity_ref("urn:cc13:p03:p2")) { origin adjudicated; } } evaluate positions(); expect position(RestituerMemeQuantiteEtQualite, SATISFIED); expect evaluation_status == COMPUTED; }
