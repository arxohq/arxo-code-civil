language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-M06-acte-propriete-expres" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "a": acte_alienation_hypotheque_ou_propriete(entity_ref("urn:cc13:m06:m")) { origin case_input; } assert "p": pouvoir_expres(entity_ref("urn:cc13:m06:m")) { origin case_input; } } evaluate truth(acte_couvert_par_mandat(entity_ref("urn:cc13:m06:m"))); expect truth_status == TRUE_ONLY; }
