language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-065-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": fruits_percus_depot(entity_ref("urn:cc13:065a:d"), 100 EUR) { origin case_input; }
 assert "f2": depositaire(entity_ref("urn:cc13:065a:d"), entity_ref("urn:cc13:065a:p")) { origin case_input; }
 assert "f3": deposant(entity_ref("urn:cc13:065a:d"), entity_ref("urn:cc13:065a:q")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirRestituerFruitsDepot, ACTIVE); }
