language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-1843-3-gains-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": gains_activite_industrie(entity_ref("urn:cc13:s50:s"), entity_ref("urn:cc13:s50:p"), 100 EUR) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirRemettreGainsIndustrie, ACTIVE); }
