language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-034-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": assemblee_tente_eteindre_action_gerant(entity_ref("urn:cc13:z034b:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:z034b:s"), entity_ref("urn:cc13:z034b:p")) { origin case_input; }
 assert "f3": extinction_action_gerant_exercee(entity_ref("urn:cc13:z034b:s")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionEteindreActionGerant, VIOLATED); expect position(P3PositionMaintenanceInterdictionEteindreActionGerant, VIOLATED); }
test "CC13-positions-034-second-b" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": assemblee_tente_eteindre_action_gerant(entity_ref("urn:cc13:z034t:s")) { origin case_input; }
 assert "f2": acteur_societe(entity_ref("urn:cc13:z034t:s"), entity_ref("urn:cc13:z034t:p")) { origin case_input; }
 assert "f3": extinction_action_gerant_exercee(entity_ref("urn:cc13:z034t:s")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionEteindreActionGerant, VIOLATED); expect position(P3PositionMaintenanceInterdictionEteindreActionGerant, VIOLATED); }
