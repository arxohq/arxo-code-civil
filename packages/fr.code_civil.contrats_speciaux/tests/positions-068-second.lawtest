language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-068-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": sommes_dues_au_depositaire_non_payees(entity_ref("urn:cc13:068s:d")) { origin case_input; }
 assert "f2": depositaire(entity_ref("urn:cc13:068s:d"), entity_ref("urn:cc13:068s:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirRetenirDepot, ACTIVE); }
