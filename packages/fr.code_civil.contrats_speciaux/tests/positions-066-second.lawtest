language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-066-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": preuve_propriete_exigee_par_depositaire(entity_ref("urn:cc13:066s:d")) { origin case_input; }
 assert "f2": depositaire(entity_ref("urn:cc13:066s:d"), entity_ref("urn:cc13:066s:p")) { origin case_input; }
 assert "f3": exigence_preuve_propriete_exercee(entity_ref("urn:cc13:066s:d"), entity_ref("urn:cc13:066s:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionExigerPreuvePropriete, VIOLATED); expect position(P3PositionMaintenanceInterdictionExigerPreuvePropriete, VIOLATED); }

test "CC13-positions-066-second-b" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": preuve_propriete_exigee_par_depositaire(entity_ref("urn:cc13:066t:d")) { origin case_input; }
 assert "f2": depositaire(entity_ref("urn:cc13:066t:d"), entity_ref("urn:cc13:066t:p")) { origin case_input; }
 assert "f3": exigence_preuve_propriete_exercee(entity_ref("urn:cc13:066t:d"), entity_ref("urn:cc13:066t:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionExigerPreuvePropriete, VIOLATED); expect position(P3PositionMaintenanceInterdictionExigerPreuvePropriete, VIOLATED); }
