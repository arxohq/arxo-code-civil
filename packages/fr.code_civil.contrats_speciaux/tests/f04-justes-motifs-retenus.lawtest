language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-F04-justes-motifs-retenus" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "c": cause_fin_societe(entity_ref("urn:cc13:f04:s"), TribunalJustesMotifs) { origin case_input; } assert "j": justes_motifs_de_dissolution(entity_ref("urn:cc13:f04:s")) { origin adjudicated; } } evaluate truth(societe_prend_fin(entity_ref("urn:cc13:f04:s"))); expect truth_status == TRUE_ONLY; expect judgment_requests(0); }
