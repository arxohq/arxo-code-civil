language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-C03-agrement-six-mois" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_MOIS; } assert "n": derniere_notification_cession_le(entity_ref("urn:cc13:c03:s"), entity_ref("urn:cc13:c03:p"), @2026-01-15) { origin case_input; } assert "o": aucune_offre_achat(entity_ref("urn:cc13:c03:s"), entity_ref("urn:cc13:c03:p")) { origin case_input; } assert "e": examen_agrement_le(entity_ref("urn:cc13:c03:s"), entity_ref("urn:cc13:c03:p"), @2026-07-15) { origin case_input; } } evaluate truth(agrement_cession_acquis(entity_ref("urn:cc13:c03:s"), entity_ref("urn:cc13:c03:p"))); expect truth_status == NEITHER; }
