language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-S03-nullite-entree-vigueur" { given { context { legal_time @2025-10-01; decision_time @2025-10-01T09:00:00Z; knowledge_time @2025-10-01T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_AN; } assert "c": cause_nullite_survenue_le(entity_ref("urn:cc13:s03:s"), @2025-01-01) { origin case_input; } assert "a": action_nullite_introduite_le(entity_ref("urn:cc13:s03:s"), @2025-09-01) { origin case_input; } } evaluate truth(action_nullite_recevable(entity_ref("urn:cc13:s03:s"))); expect evaluation_status == COMPUTED; expect truth_status == TRUE_ONLY; }
