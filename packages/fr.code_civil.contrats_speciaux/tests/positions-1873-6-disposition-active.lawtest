language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-1873-6-disposition-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": meuble_exploitation_normale_ou_deperissable(entity_ref("urn:cc13:i19:c")) { origin case_input; }
 assert "f2": gerant_indivision_personne(entity_ref("urn:cc13:i19:c"), entity_ref("urn:cc13:i19:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDisposerMeubleIndivision, ACTIVE); }
