language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-D08-restitution-bloquee" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "r": reclamation_deposant(entity_ref("urn:cc13:d08:d")) { origin case_input; } assert "s": saisie_ou_opposition_restitution(entity_ref("urn:cc13:d08:d")) { origin adjudicated; } } evaluate truth(restitution_immediate_requise(entity_ref("urn:cc13:d08:d"))); expect truth_status == NEITHER; }
