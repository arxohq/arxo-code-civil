language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-L05-defaut-connu" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "d": defaut_chose_pretee_cause_prejudice(entity_ref("urn:cc13:l05:p")) { origin adjudicated; } assert "c": preteur_connaissait_defaut(entity_ref("urn:cc13:l05:p")) { origin case_input; } assert "a": preteur_n_a_pas_averti(entity_ref("urn:cc13:l05:p")) { origin case_input; } } evaluate truth(responsabilite_preteur_defaut(entity_ref("urn:cc13:l05:p"))); expect truth_status == TRUE_ONLY; }
