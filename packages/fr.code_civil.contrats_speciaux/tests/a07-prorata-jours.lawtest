language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-A07-prorata-jours" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "j": nombre_jours_vecus_periode(entity_ref("urn:cc13:a07:r"), 30) { origin case_input; } assert "m": montant_rente_par_jour(entity_ref("urn:cc13:a07:r"), 10 EUR) { origin case_input; } } evaluate truth(rente_acquise_prorata_jours(entity_ref("urn:cc13:a07:r"), 300 EUR)); expect truth_status == TRUE_ONLY; }
