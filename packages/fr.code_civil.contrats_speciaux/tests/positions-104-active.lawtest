language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-104-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": etablissement_public_autorise_par_decret(entity_ref("urn:cc13:104a:a")) { origin case_input; }
 assert "f2": etablissement_arbitrage(entity_ref("urn:cc13:104a:a"), entity_ref("urn:cc13:104a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirArbitrageEtablissement, ACTIVE); }
