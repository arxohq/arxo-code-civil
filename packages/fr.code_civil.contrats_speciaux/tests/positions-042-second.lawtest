language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-positions-042-second" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; }
 assert "f1": aucun_associe_acquereur(entity_ref("urn:cc13:q042b:s")) { origin case_input; }
 assert "f2": tiers_acquereur_designe_unanimement(entity_ref("urn:cc13:q042b:s")) { origin case_input; }
 assert "f3": acteur_societe(entity_ref("urn:cc13:q042b:s"), entity_ref("urn:cc13:q042b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirAcquerirPartParTiers, ACTIVE); }
