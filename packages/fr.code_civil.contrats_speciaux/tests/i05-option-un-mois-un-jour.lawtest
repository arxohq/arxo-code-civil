language "law.core" version "0.2"; package fr.code_civil.contrats_speciaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-I05-option-un-mois-un-jour" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_MOIS; } assert "m": mise_en_demeure_option_le(entity_ref("urn:cc13:i05:c"), @2026-01-31) { origin case_input; } assert "e": option_exercee_le(entity_ref("urn:cc13:i05:c"), @2026-03-01) { origin case_input; } } evaluate truth(option_acquisition_encore_ouverte(entity_ref("urn:cc13:i05:c"))); expect truth_status == NEITHER; }
