language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";
test "CC13-C05-reponse-gerant-active" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_MOIS; } assert "a": associe(entity_ref("urn:cc13:c05:s"), entity_ref("urn:cc13:c05:a")) { origin case_input; } assert "g": gerant(entity_ref("urn:cc13:c05:s"), entity_ref("urn:cc13:c05:g")) { origin case_input; } assert "q": question_ecrite_associe_le(entity_ref("urn:cc13:c05:s"), entity_ref("urn:cc13:c05:a"), @2026-09-01) { origin case_input; } } evaluate positions(); expect position(RepondreQuestionAssocie, ACTIVE); expect evaluation_status == COMPUTED; }
test "CC13-C05-reponse-gerant-satisfaite" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_CONTRATS_SPECIAUX_MOIS; } assert "a": associe(entity_ref("urn:cc13:c05:s2"), entity_ref("urn:cc13:c05:a2")) { origin case_input; } assert "g": gerant(entity_ref("urn:cc13:c05:s2"), entity_ref("urn:cc13:c05:g2")) { origin case_input; } assert "q": question_ecrite_associe_le(entity_ref("urn:cc13:c05:s2"), entity_ref("urn:cc13:c05:a2"), @2026-09-01) { origin case_input; } assert "r": reponse_ecrite_du_gerant(entity_ref("urn:cc13:c05:s2"), entity_ref("urn:cc13:c05:a2")) { origin adjudicated; } } evaluate positions(); expect position(RepondreQuestionAssocie, SATISFIED); expect evaluation_status == COMPUTED; }
