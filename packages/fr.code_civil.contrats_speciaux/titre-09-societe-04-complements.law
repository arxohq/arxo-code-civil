@source(CC_ART1832) {
    rule SocieteInstitueeParContrat(s: Societe) strict { label en unofficial "Civil Code declaration: societe Instituee Par Contrat";
        label fr official "Article 1832, alinéa 1. La société est instituée par le contrat d'au moins deux personnes affectant des biens ou leur industrie à une entreprise commune";
        when au_moins_deux_associes_conviennent(s) and affectation_entreprise_commune_partage_resultat(s);
        then societe_instituee_conventionnellement(s);
    }
    rule SocieteUnipersonnelleAutorisee(s: Societe) strict { label en unofficial "Civil Code declaration: societe Unipersonnelle Autorisee";
        label fr official "Article 1832, alinéa 2. La société peut être instituée par la volonté d'une seule personne dans les cas prévus par la loi";
        when acte_unilateral_societe_autorise_par_loi(s); then societe_instituee_unilateralement(s);
    }
    rule ContributionAuxPertesObligatoire(s: Societe) strict { label en unofficial "Civil Code declaration: contribution Aux Pertes Obligatoire";
        label fr official "Article 1832, alinéa 3. Les associés s'engagent à contribuer aux pertes";
        when contrat_de_societe(s); then contribution_aux_pertes_obligatoire(s);
    }
}

@source(CC_ART1844_16)
rule P3InterdictionOpposerNulliteTiersBonneFoi(s: Societe, p: Personne) strict {
    label fr official "Article 1844-16. La société et les associés ne peuvent opposer la nullité aux tiers de bonne foi";
    label en unofficial "Article 1844-16. The company and members must not assert nullity against good-faith third parties";
    when tiers_bonne_foi_nullite(s) and acteur_societe(s, p);
    then prohibition P3PositionInterdictionOpposerNulliteTiersBonneFoi {
        bearer p;
        action nullite_tiers_non_opposee_exercee(s, p);
        window [@2016-10-01, infinity];
    };
}

pub relation nullite_tiers_bonne_foi_opposee(s: Societe, p: Personne) kind derived {
    label fr official "nullité opposée au tiers de bonne foi en violation de l'article 1844-16";
    label en unofficial "nullity asserted against a good-faith third party in violation of Article 1844-16";
}
@source(CC_ART1844_16)
rule ViolationInterdictionOpposerNulliteTiersBonneFoi(s: Societe, p: Personne) strict {
    label fr official "nullité opposée au tiers de bonne foi en violation de l'article 1844-16";
    label en unofficial "nullity asserted against a good-faith third party in violation of Article 1844-16";
    when nullite_tiers_non_opposee_exercee(s, p);
    then nullite_tiers_bonne_foi_opposee(s, p);
}
@source(CC_ART1844_16)
rule P3MaintenanceInterdictionOpposerNulliteTiersBonneFoi(s: Societe, p: Personne) strict {
    label fr official "nullité opposée au tiers de bonne foi en violation de l'article 1844-16";
    label en unofficial "nullity asserted against a good-faith third party in violation of Article 1844-16";
    when tiers_bonne_foi_nullite(s) and acteur_societe(s, p);
    then duty P3PositionMaintenanceInterdictionOpposerNulliteTiersBonneFoi {
        bearer p;
        goal maintenance {
            condition not nullite_tiers_bonne_foi_opposee(s, p);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART1844_16)
rule P3PouvoirPersonneProtegeeOpposerNullite(s: Societe, p: Personne) strict {
    label fr official "Article 1844-16. La personne protégée peut opposer la nullité";
    label en unofficial "Article 1844-16. The protected person may assert nullity";
    when nullite_incapacite_ou_vice_consentement(s) and acteur_societe(s, p);
    then power P3PositionPouvoirOpposerNullitePersonneProtegee {
        holder p;
        over s;
        exercise nullite_protegee_opposee_exercee(s, p);
        effect nullite_opposable_par_personne_protegee(s);
        valid_when nullite_incapacite_ou_vice_consentement(s);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1846_2)
rule P3InterdictionInvoquerIrregulariteGerant(s: Societe, p: Personne) strict {
    label fr official "Article 1846-2. La société et les tiers ne peuvent invoquer l'irrégularité publiée";
    label en unofficial "Article 1846-2. The company and third parties must not assert the published irregularity";
    when nomination_ou_cessation_gerant_publiee(s) and acteur_societe(s, p);
    then prohibition P3PositionInterdictionInvoquerIrregulariteGerant {
        bearer p;
        action irregularite_gerant_invoquee(s, p);
        window [@2016-10-01, infinity];
    };
}

pub relation violation_irregularite_gerant_invoquee(s: Societe, p: Personne) kind derived {
    label fr official "irrégularité du gérant invoquée en violation de l'article 1846-2";
    label en unofficial "manager irregularity asserted in violation of Article 1846-2";
}
@source(CC_ART1846_2)
rule ViolationInterdictionInvoquerIrregulariteGerant(s: Societe, p: Personne) strict {
    label fr official "irrégularité du gérant invoquée en violation de l'article 1846-2";
    label en unofficial "manager irregularity asserted in violation of Article 1846-2";
    when irregularite_gerant_invoquee(s, p);
    then violation_irregularite_gerant_invoquee(s, p);
}
@source(CC_ART1846_2)
rule P3MaintenanceInterdictionInvoquerIrregulariteGerant(s: Societe, p: Personne) strict {
    label fr official "irrégularité du gérant invoquée en violation de l'article 1846-2";
    label en unofficial "manager irregularity asserted in violation of Article 1846-2";
    when nomination_ou_cessation_gerant_publiee(s) and acteur_societe(s, p);
    then duty P3PositionMaintenanceInterdictionInvoquerIrregulariteGerant {
        bearer p;
        goal maintenance {
            condition not violation_irregularite_gerant_invoquee(s, p);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART1847)
rule P3DevoirDirigeantAssumerObligationsGerant(s: Societe, p: Personne) strict {
    label fr official "Article 1847. Les dirigeants ont les obligations et responsabilités d'un gérant";
    label en unofficial "Article 1847. Directors have the obligations and responsibilities of a manager";
    when gerant_personne_morale(s) and acteur_societe(s, p);
    then duty P3PositionDevoirDirigeantAssumerObligationsGerant {
        bearer p;
        beneficiary s;
        goal achievement {
            condition obligations_dirigeant_assumees(s, p);
            window [@2016-10-01, infinity];
        }
    };
}

@source(CC_ART1832_1) {
    rule EpouxPeuventEtreAssocies(s: Societe) strict { label en unofficial "Civil Code declaration: epoux Peuvent Etre Associes";
        label fr official "Article 1832-1, alinéa 1. Deux époux peuvent être associés dans une même société";
        when epoux_associes_meme_societe(s); then association_epoux_admise(s);
    }
    rule LiberaliteEntreEpouxNonAnnuleeCommeDonationDeguisee(s: Societe) strict { label en unofficial "Civil Code declaration: liberalite Entre Epoux Non Annulee Comme Donation Deguisee";
        label fr official "Article 1832-1, alinéa 2. La libéralité réglée par acte authentique n'est pas annulée comme donation déguisée";
        when liberalite_societe_epoux_acte_authentique(s); then annulation_donation_deguisee_exclue(s);
    }
}

@source(CC_ART1834)
rule RegimeGeneralDesSocietesApplicable(s: Societe) strict { label en unofficial "Civil Code declaration: regime General Des Societes Applicable";
    label fr official "Article 1834. Le présent chapitre s'applique à toute société sauf dérogation légale liée à sa forme ou à son objet";
    when aucune_loi_speciale_derogatoire(s); then chapitre_societes_applicable(s);
}

@source(CC_ART1835)
rule StatutsSocieteFormellementConformes(s: Societe) strict { label en unofficial "Civil Code declaration: statuts Societe Formellement Conformes";
    label fr official "Article 1835. Les statuts sont écrits et comportent les mentions légales relatives aux apports, à la forme, à l'objet, au siège, au capital, à la durée et au fonctionnement";
    when statuts_ecrits(s) and statuts_mentions_obligatoires(s); then statuts_formellement_conformes(s);
}

@source(CC_ART1836) {
    rule ModificationStatutsSansClauseContraireUnanime(s: Societe) strict { label en unofficial "Civil Code declaration: modification Statuts Sans Clause Contraire Unanime";
        label fr official "Article 1836, alinéa 1. A défaut de clause contraire, les statuts ne sont modifiés que par accord unanime";
        when modification_statuts(s) and aucune_clause_majorite_statutaire(s) and unanimite_associes(s);
        then modification_statuts_valide(s);
    }
    rule AugmentationEngagementAvecConsentement(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: augmentation Engagement Avec Consentement";
        label fr official "Article 1836, alinéa 2. Les engagements d'un associé ne peuvent être augmentés sans son consentement";
        when augmentation_engagement_associe(s, p) and consentement_associe_augmentation(s, p);
        then augmentation_engagement_valide(s, p);
    }
}

@source(CC_ART1837) {
    rule LoiFrancaisePourSiegeEnFrance(s: Societe) strict { label en unofficial "Civil Code declaration: loi Francaise Pour Siege En France";
        label fr official "Article 1837, alinéa 1. La société dont le siège est en France est soumise à la loi française";
        when siege_sur_territoire_francais(s); then loi_francaise_applicable(s);
    }
    rule SiegeStatutaireDistinctNonOpposableParSociete(s: Societe) strict { label en unofficial "Civil Code declaration: siege Statutaire Distinct Non Opposable Par Societe";
        label fr official "Article 1837, alinéa 2. La société ne peut opposer son siège statutaire aux tiers lorsque son siège réel est ailleurs";
        when siege_statutaire_distinct_siege_reel(s); then siege_statutaire_non_opposable_par_societe(s);
    }
}

@source(CC_ART1842) {
    rule PersonnaliteMoraleParImmatriculation(s: Societe, d: Date) strict { label en unofficial "Civil Code declaration: personnalite Morale Par Immatriculation";
        label fr official "Article 1842, alinéa 1. Hors sociétés légalement exceptées, la personnalité morale est acquise à l'immatriculation";
        when societe_immatriculee_le(s, d) and societe_hors_exceptions_personnalite(s);
        then personnalite_morale_acquise(s);
    }
    rule RapportsAvantImmatriculationRegisParContrat(s: Societe) strict { label en unofficial "Civil Code declaration: rapports Avant Immatriculation Regis Par Contrat";
        label fr official "Article 1842, alinéa 2. Jusqu'à l'immatriculation, les rapports entre associés sont régis par le contrat et le droit commun des obligations";
        when societe_non_immatriculee(s); then rapports_preimmatriculation_regis_contrat(s);
    }
}

@source(CC_ART1843) {
    rule AuteurActeSocieteEnFormationTenu(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: auteur Acte Societe En Formation Tenu";
        label fr official "Article 1843. La personne ayant agi au nom de la société en formation est tenue des obligations nées de l'acte";
        when acte_societe_formation(s, p); then auteur_acte_formation_tenu(s, p);
    }
    rule SolidariteActeFormationSocieteCommerciale(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: solidarite Acte Formation Societe Commerciale";
        label fr official "Article 1843. L'auteur de l'acte est solidairement tenu lorsque la société en formation est commerciale";
        when acte_societe_formation(s, p) and societe_commerciale(s); then solidarite_acte_formation(s, p);
    }
    rule RepriseEngagementRetroagitALOrigine(s: Societe) strict { label en unofficial "Civil Code declaration: reprise Engagement Retroagit ALOrigine";
        label fr official "Article 1843. L'engagement repris après immatriculation est réputé avoir été contracté dès l'origine par la société";
        when reprise_engagement_apres_immatriculation(s); then engagement_repute_originairement_societe(s);
    }
}

@source(CC_ART1843_1)
rule PubliciteApportAvantImmatriculationRetroagit(s: Societe, d: Date) strict { label en unofficial "Civil Code declaration: publicite Apport Avant Immatriculation Retroagit";
    label fr official "Article 1843-1. La publicité antérieure de l'apport rétroagit à sa date si la société est ensuite immatriculée";
    when apport_soumis_publicite(s) and apport_publie_avant_immatriculation(s) and societe_immatriculee_le(s, d);
    then publicite_apport_retroagit(s);
}

@source(CC_ART1843_3) {
    rule AssocieDebiteurApportPromis(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: associe Debiteur Apport Promis";
        label fr official "Article 1843-3, alinéa 1. Chaque associé est débiteur de tout ce qu'il a promis d'apporter";
        when apport_promis_non_execute(s, p); then associe_debiteur_apport(s, p);
    }
    rule ApportNatureRealiseParTransfertEtMiseADisposition(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: apport Nature Realise Par Transfert Et Mise ADisposition";
        label fr official "Article 1843-3, alinéa 2. L'apport en nature est réalisé par transfert des droits et mise à disposition effective";
        when apport_nature_transfere_et_mis_disposition(s, p); then apport_nature_realise(s, p);
    }
    rule GarantieApportProprieteCommeVendeur(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: garantie Apport Propriete Comme Vendeur";
        label fr official "Article 1843-3, alinéa 3. L'apporteur en propriété garantit comme un vendeur";
        when apport_propriete(s, p); then garantie_apporteur_comme_vendeur(s, p);
    }
    rule GarantieApportJouissanceCommeBailleur(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: garantie Apport Jouissance Comme Bailleur";
        label fr official "Article 1843-3, alinéa 4. L'apporteur en jouissance garantit comme un bailleur";
        when apport_jouissance(s, p); then garantie_apporteur_comme_bailleur(s, p);
    }
    rule InteretsDePleinDroitSurApportNumeraireImpaye(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: interets De Plein Droit Sur Apport Numeraire Impaye";
        label fr official "Article 1843-3, alinéa 5. L'apport numéraire impayé produit de plein droit des intérêts";
        when apport_numeraire_impaye(s, p); then interets_apport_numeraire_dus(s, p);
    }
    rule GainsIndustrieDusALaSociete(s: Societe, p: Personne, m: Money) strict { label en unofficial "Civil Code declaration: gains Industrie Dus ALa Societe";
        label fr official "Article 1843-3, alinéa 6. L'associé apporteur en industrie doit à la société tous les gains de l'activité apportée";
        when gains_activite_industrie(s, p, m); then gains_industrie_a_restituer(s, p, m);
    }
}

@source(CC_ART1843_3)
rule P3DevoirRemettreGainsIndustrie(s: Societe, p: Personne, m: Money) strict {
    label fr official "Article 1843-3. L'associé apporteur en industrie doit à la société tous les gains";
    label en unofficial "Article 1843-3. The industrial contributor must remit all gains to the company";
    when gains_activite_industrie(s, p, m);
    then duty P3PositionDevoirRemettreGainsIndustrie {
        bearer p;
        beneficiary s;
        goal achievement {
            condition gains_industrie_remis(s, p, m);
            window [@2016-10-01, infinity];
        }
    };
}

@source(CC_ART1843_4) {
    rule ValeurDroitsSociauxDetermineeParExpert(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: valeur Droits Sociaux Determinee Par Expert";
        label fr official "Article 1843-4. En cas de contestation, la valeur des droits sociaux est déterminée par l'expert légalement désigné";
        when contestation_valeur_droits_sociaux(s, p) and expert_valeur_droits_designe(s, p);
        then evaluation_expert_applicable(s, p);
    }
    rule ExpertAppliqueReglesStatutairesEvaluation(s: Societe) strict { label en unofficial "Civil Code declaration: expert Applique Regles Statutaires Evaluation";
        label fr official "Article 1843-4. L'expert applique les règles de détermination de valeur prévues par les statuts ou la convention";
        when regles_statutaires_evaluation_existantes(s); then expert_tenu_appliquer_regles_evaluation(s);
    }
}

@source(CC_ART1843_5) {
    rule ActionSocialeAssocieRecevable(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: action Sociale Associe Recevable";
        label fr official "Article 1843-5, alinéa 1. Un associé peut exercer l'action sociale en responsabilité contre le gérant";
        when action_sociale_associe_contre_gerant(s, p); then action_sociale_recevable(s, p);
    }
    rule DommagesActionSocialeAllouesSociete(s: Societe, m: Money) strict { label en unofficial "Civil Code declaration: dommages Action Sociale Alloues Societe";
        label fr official "Article 1843-5, alinéa 1. Les dommages-intérêts obtenus par l'action sociale sont alloués à la société";
        when condamnation_gerant_dommages(s, m); then dommages_alloues_societe(s, m);
    }
    rule ClauseRestrictionActionSocialeNonEcrite(s: Societe) strict { label en unofficial "Civil Code declaration: clause Restriction Action Sociale Non Ecrite";
        label fr official "Article 1843-5, alinéa 2. La clause subordonnant l'action sociale ou y renonçant par avance est réputée non écrite";
        when clause_subordonne_ou_renonce_action_sociale(s); then clause_action_sociale_reputee_non_ecrite(s);
    }
    rule AssembleeNePeutEteindreActionGerant(s: Societe) strict { label en unofficial "Civil Code declaration: assemblee Ne Peut Eteindre Action Gerant";
        label fr official "Article 1843-5, alinéa 3. L'assemblée ne peut éteindre l'action en responsabilité contre le gérant";
        when assemblee_tente_eteindre_action_gerant(s); then extinction_action_par_assemblee_exclue(s);
    }
}

@source(CC_ART1843_5)
rule P3PouvoirExercerActionSociale(s: Societe, p: Personne) strict {
    label fr official "Article 1843-5. Un associé peut exercer l'action sociale en responsabilité contre le gérant";
    label en unofficial "Article 1843-5. A member may exercise the derivative liability action against the manager";
    when action_sociale_associe_contre_gerant(s, p);
    then power P3PositionPouvoirExercerActionSociale {
        holder p;
        over s;
        exercise action_sociale_responsabilite_exercee(s, p);
        effect action_sociale_recevable(s, p);
        valid_when action_sociale_associe_contre_gerant(s, p);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1844) {
    rule AssocieParticipeDecisionsCollectives(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: associe Participe Decisions Collectives";
        label fr official "Article 1844, alinéa 1. Tout associé participe aux décisions collectives";
        when associe(s, p); then participation_decisions_collectives_associe(s, p);
    }
    rule PartIndiviseRepresenteeParMandataireUnique(s: Societe) strict { label en unofficial "Civil Code declaration: part Indivise Representee Par Mandataire Unique";
        label fr official "Article 1844, alinéa 2. Les copropriétaires d'une part indivise sont représentés par un mandataire unique";
        when part_sociale_indivise(s); then mandataire_unique_part_indivise_designe(s);
    }
    rule VoteUsufruitierPourBenefices(s: Societe) strict { label en unofficial "Civil Code declaration: vote Usufruitier Pour Benefices";
        label fr official "Article 1844, alinéa 3. Le vote sur l'affectation des bénéfices appartient à l'usufruitier";
        when decision_affectation_benefices(s); then vote_usufruitier(s);
    }
    rule VoteNuProprietairePourAutresDecisions(s: Societe) strict { label en unofficial "Civil Code declaration: vote Nu Proprietaire Pour Autres Decisions";
        label fr official "Article 1844, alinéa 3. Le vote sur les autres décisions appartient par défaut au nu-propriétaire";
        when autre_decision_collective(s); then vote_nu_proprietaire(s);
    }
}

@source(CC_ART1844_3)
rule TransformationOuProrogationSansNouvellePersonneMorale(s: Societe) strict { label en unofficial "Civil Code declaration: transformation Ou Prorogation Sans Nouvelle Personne Morale";
    label fr official "Article 1844-3. La transformation régulière, la prorogation ou la modification statutaire ne crée pas une personne morale nouvelle";
    when transformation_reguliere_ou_prorogation(s); then aucune_personne_morale_nouvelle(s);
}

@source(CC_ART1844_4)
rule FusionOuScissionDecideeCommeModificationStatuts(s: Societe) strict { label en unofficial "Civil Code declaration: fusion Ou Scission Decidee Comme Modification Statuts";
    label fr official "Article 1844-4. La fusion ou la scission est décidée dans les conditions de modification des statuts";
    when fusion_ou_scission(s) and decision_conditions_modification_statuts(s); then operation_fusion_scission_valide(s);
}

@source(CC_ART1844_9) {
    rule PartageActifSelonParticipationBenefices(s: Societe, p: Personne, actif: Money, q: Rational) strict { label en unofficial "Civil Code declaration: partage Actif Selon Participation Benefices";
        label fr official "Article 1844-9, alinéa 1. Après dettes et remboursement du capital, l'actif est partagé selon la participation aux bénéfices";
        when actif_net_apres_dettes_capital(s, actif) and proportion_benefices_associe(s, p, q);
        then part_actif_associe(s, p, actif * q);
    }
    rule RepriseBienApporteEnNatureDemandable(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: reprise Bien Apporte En Nature Demandable";
        label fr official "Article 1844-9, alinéa 3. Le bien apporté retrouvé en nature est attribuable sur demande à l'apporteur, sous réserve de soulte";
        when bien_apporte_retrouve_en_nature(s, p); then attribution_bien_apporteur_demandable(s, p);
    }
}

@source(CC_ART1844_10) {
    rule NulliteSocieteLimiteeAuxCausesLegales(s: Societe) strict { label en unofficial "Civil Code declaration: nullite Societe Limitee Aux Causes Legales";
        label fr official "Article 1844-10, alinéa 1. La nullité de la société est limitée aux causes légales énumérées";
        effective [@2025-10-01, infinity);
        when cause_nullite_societe_limitee(s); then nullite_societe_admise(s);
    }
    rule ClauseContraireDispositionImperativeNonEcrite(s: Societe) strict { label en unofficial "Civil Code declaration: clause Contraire Disposition Imperative Non Ecrite";
        label fr official "Article 1844-10, alinéa 2. La clause contraire à une disposition impérative non sanctionnée par la nullité est réputée non écrite";
        effective [@2025-10-01, infinity);
        when clause_contraire_disposition_imperative(s); then clause_societe_reputee_non_ecrite(s);
    }
    rule ViolationStatutsSeuleNeCausePasNullite(s: Societe) strict { label en unofficial "Civil Code declaration: violation Statuts Seule Ne Cause Pas Nullite";
        label fr official "Article 1844-10, alinéa 4. Sauf texte contraire, la seule violation des statuts ne cause pas la nullité";
        effective [@2025-10-01, infinity);
        when violation_statuts_seule(s); then nullite_pour_violation_statuts_exclue(s);
    }
}

@source(CC_ART1844_10_1) {
    rule NulliteApportAnnulePartsEmises(s: Societe) strict { label en unofficial "Civil Code declaration: nullite Apport Annule Parts Emises";
        label fr official "Article 1844-10-1, alinéa 2. La nullité de l'apport annule les parts ou actions émises en contrepartie";
        effective [@2025-10-01, infinity);
        when nullite_apport_prononcee(s); then parts_emises_annulees(s);
    }
    rule NulliteTousApportsDissoutSociete(s: Societe) strict { label en unofficial "Civil Code declaration: nullite Tous Apports Dissout Societe";
        label fr official "Article 1844-10-1, alinéa 3. La nullité de tous les apports entraîne la dissolution";
        effective [@2025-10-01, infinity);
        when tous_apports_nuls(s); then dissolution_pour_nullite_apports(s);
    }
}

@source(CC_ART1844_11)
rule ActionNulliteEteinteSiCauseDisparue(s: Societe) strict { label en unofficial "Civil Code declaration: action Nullite Eteinte Si Cause Disparue";
    label fr official "Article 1844-11. L'action en nullité est éteinte si sa cause a disparu au jour du jugement au fond";
    effective [@2025-10-01, infinity);
    when cause_nullite_disparue_au_jugement(s); then action_nullite_eteinte(s);
}

@source(CC_ART1844_12_1)
rule NulliteDecisionSocialeSoumiseAuxTroisConditions(s: Societe) strict { label en unofficial "Civil Code declaration: nullite Decision Sociale Soumise Aux Trois Conditions";
    label fr official "Article 1844-12-1. La nullité d'une décision sociale suppose grief protégé, influence de l'irrégularité et conséquences non excessives";
    effective [@2025-10-01, infinity);
    when grief_interet_protege(s) and irregularite_influence_decision(s) and consequences_nullite_non_excessives(s);
    then nullite_decision_sociale_prononcable(s);
}

@source(CC_ART1844_15) {
    rule NulliteSocieteSansRetroactivite(s: Societe) strict { label en unofficial "Civil Code declaration: nullite Societe Sans Retroactivite";
        label fr official "Article 1844-15, alinéa 1. La nullité met fin au contrat de société sans rétroactivité";
        effective [@2025-10-01, infinity);
        when nullite_societe_prononcee(s); then nullite_sans_retroactivite(s);
    }
    rule NulliteSocieteEntraineLiquidation(s: Societe) strict { label en unofficial "Civil Code declaration: nullite Societe Entraine Liquidation";
        label fr official "Article 1844-15, alinéa 2. La nullité prononcée entraîne la liquidation selon les règles applicables";
        effective [@2025-10-01, infinity);
        when nullite_societe_prononcee(s); then liquidation_apres_nullite(s);
    }
}

@source(CC_ART1844_15_1)
rule IrregulariteOrganeNAnnulePasSesDecisions(s: Societe) strict { label en unofficial "Civil Code declaration: irregularite Organe NAnnule Pas Ses Decisions";
    label fr official "Article 1844-15-1. Sauf loi contraire, la nullité de nomination ou le maintien irrégulier d'un organe n'annule pas ses décisions";
    effective [@2025-10-01, infinity);
    when nomination_organe_nulle_ou_irreguliere(s); then decisions_organe_non_annulees(s);
}

@source(CC_ART1844_15_2)
rule EffetsNulliteDecisionPeuventEtreDifferes(s: Societe) strict { label en unofficial "Civil Code declaration: effets Nullite Decision Peuvent Etre Differes";
    label fr official "Article 1844-15-2. Les effets de la nullité peuvent être différés lorsque sa rétroactivité serait manifestement excessive";
    effective [@2025-10-01, infinity);
    when retroactivite_manifestement_excessive(s); then effets_nullite_differables(s);
}

@source(CC_ART1844_16) {
    rule NulliteNonOpposableAuxTiersDeBonneFoi(s: Societe) strict { label en unofficial "Civil Code declaration: nullite Non Opposable Aux Tiers De Bonne Foi";
        label fr official "Article 1844-16. La société et les associés ne peuvent opposer la nullité aux tiers de bonne foi";
        when tiers_bonne_foi_nullite(s); then nullite_non_opposable_tiers_bonne_foi(s);
    }
    rule IncapaciteOuViceOpposableParPersonneProtegee(s: Societe) strict { label en unofficial "Civil Code declaration: incapacite Ou Vice Opposable Par Personne Protegee";
        label fr official "Article 1844-16. La personne protégée peut opposer même aux tiers la nullité tirée de son incapacité ou d'un vice du consentement";
        when nullite_incapacite_ou_vice_consentement(s); then nullite_opposable_par_personne_protegee(s);
    }
}

@source(CC_ART1845) {
    rule ChapitreSocietesCivilesApplicable(s: Societe) strict { label en unofficial "Civil Code declaration: chapitre Societes Civiles Applicable";
        label fr official "Article 1845, alinéa 1. Le chapitre s'applique aux sociétés civiles sauf statut légal particulier";
        when societe_civile(s) and aucune_loi_speciale_derogatoire(s); then chapitre_societes_applicable(s);
    }
    rule SocieteSansAutreCaractereEstCivile(s: Societe) strict { label en unofficial "Civil Code declaration: societe Sans Autre Caractere Est Civile";
        label fr official "Article 1845, alinéa 2. Toute société à laquelle la loi n'attribue pas un autre caractère est civile";
        when societe_sans_caractere_commercial_legal(s); then caractere_civil_societe(s);
    }
}

@source(CC_ART1845_1)
rule CapitalSocieteCivileDiviseEnPartsEgales(s: Societe) strict { label en unofficial "Civil Code declaration: capital Societe Civile Divise En Parts Egales";
    label fr official "Article 1845-1, alinéa 1. Le capital de la société civile est divisé en parts égales";
    when societe_civile(s); then capital_divise_parts_egales(s);
}

@source(CC_ART1846_2)
rule IrregulariteGerantPublieeNonInvocable(s: Societe) strict { label en unofficial "Civil Code declaration: irregularite Gerant Publiee Non Invocable";
    label fr official "Article 1846-2. Après publication, ni la société ni les tiers ne peuvent invoquer l'irrégularité de la nomination ou de la cessation du gérant";
    when nomination_ou_cessation_gerant_publiee(s); then irregularite_gerant_non_invocable(s);
}

@source(CC_ART1847) {
    rule DirigeantsPersonneMoraleGeranteOntObligationsGerant(s: Societe) strict { label en unofficial "Civil Code declaration: dirigeants Personne Morale Gerante Ont Obligations Gerant";
        label fr official "Article 1847. Les dirigeants de la personne morale gérante ont les obligations et responsabilités d'un gérant en nom propre";
        when gerant_personne_morale(s); then dirigeants_memes_obligations_gerant(s);
    }
    rule PersonneMoraleGeranteSolidairementResponsable(s: Societe) strict { label en unofficial "Civil Code declaration: personne Morale Gerante Solidairement Responsable";
        label fr official "Article 1847. La personne morale gérante répond solidairement de ses dirigeants";
        when gerant_personne_morale(s); then responsabilite_solidaire_personne_morale_gerante(s);
    }
}

@source(CC_ART1848) {
    rule ActeGestionInterneAutoriseParInteretSocial(s: Societe) strict { label en unofficial "Civil Code declaration: acte Gestion Interne Autorise Par Interet Social";
        label fr official "Article 1848, alinéa 1. Dans les rapports internes, le gérant accomplit les actes de gestion demandés par l'intérêt social";
        when acte_gestion_interet_societe(s); then acte_gestion_interne_autorise(s);
    }
    rule GerantsExercentPouvoirsSeparement(s: Societe) strict { label en unofficial "Civil Code declaration: gerants Exercent Pouvoirs Separement";
        label fr official "Article 1848, alinéa 2. A défaut de règle statutaire, les gérants exercent séparément leurs pouvoirs";
        when pluralite_gerants(s); then pouvoirs_separes_gerants(s);
    }
}

@source(CC_ART1849) {
    rule ActeDansObjetEngageSocieteEnversTiers(s: Societe) strict { label en unofficial "Civil Code declaration: acte Dans Objet Engage Societe Envers Tiers";
        label fr official "Article 1849, alinéa 1. Le gérant engage la société envers les tiers par les actes entrant dans l'objet social";
        when acte_dans_objet_social(s); then societe_engagee_envers_tiers(s);
    }
    rule OppositionGerantConnueEstOpposableAuTiers(s: Societe) strict { label en unofficial "Civil Code declaration: opposition Gerant Connue Est Opposable Au Tiers";
        label fr official "Article 1849, alinéa 2. L'opposition d'un gérant est opposable au tiers qui en avait connaissance";
        when opposition_gerant_connue_du_tiers(s); then opposition_gerant_opposable_tiers(s);
    }
    rule LimitationStatutairePouvoirGerantInopposable(s: Societe) strict { label en unofficial "Civil Code declaration: limitation Statutaire Pouvoir Gerant Inopposable";
        label fr official "Article 1849, alinéa 3. La clause limitant les pouvoirs du gérant est inopposable aux tiers";
        when clause_limite_pouvoir_gerant(s); then clause_limite_pouvoir_inopposable_tiers(s);
    }
}

@source(CC_ART1850) {
    rule ResponsabiliteIndividuelleGerant(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: responsabilite Individuelle Gerant";
        label fr official "Article 1850, alinéa 1. Chaque gérant répond individuellement des infractions, violations statutaires et fautes de gestion";
        when faute_ou_violation_gerant(s, p); then responsabilite_individuelle_gerant(s, p);
    }
    rule ResponsabiliteSolidaireGerantsMemesFaits(s: Societe) strict { label en unofficial "Civil Code declaration: responsabilite Solidaire Gerants Memes Faits";
        label fr official "Article 1850, alinéa 2. Les gérants ayant participé aux mêmes faits sont solidairement responsables envers tiers et associés";
        when plusieurs_gerants_memes_faits(s); then responsabilite_solidaire_gerants(s);
    }
}

@source(CC_ART1853) {
    rule DecisionParAssembleeValide(s: Societe) strict { label en unofficial "Civil Code declaration: decision Par Assemblee Valide";
        label fr official "Article 1853. Les décisions sociales sont prises en assemblée";
        when decision_par_assemblee(s); then mode_decision_collective_valide(s);
    }
    rule ConsultationEcriteStatutaireValide(s: Societe) strict { label en unofficial "Civil Code declaration: consultation Ecrite Statutaire Valide";
        label fr official "Article 1853. Les statuts peuvent prévoir une consultation écrite, y compris électronique";
        when consultation_ecrite_prevue_statuts(s); then mode_decision_collective_valide(s);
    }
}

@source(CC_ART1843_5)
rule P3InterdictionEteindreActionGerant(s: Societe) strict {
    label fr official "Article 1843-5. L'assemblée ne peut éteindre l'action en responsabilité contre le gérant";
    label en unofficial "Article 1843-5. The assembly must not extinguish the liability action";
    when assemblee_tente_eteindre_action_gerant(s);
    then prohibition P3PositionInterdictionEteindreActionGerant {
        bearer s;
        action extinction_action_gerant_exercee(s);
        window [@2016-10-01, infinity];
    };
}

pub relation violation_extinction_action_gerant(s: Societe) kind derived {
    label fr official "action en responsabilité contre le gérant éteinte en violation de l'article 1843-5";
    label en unofficial "manager liability action extinguished in violation of Article 1843-5";
}
@source(CC_ART1843_5)
rule ViolationInterdictionEteindreActionGerant(s: Societe) strict {
    label fr official "action en responsabilité contre le gérant éteinte en violation de l'article 1843-5";
    label en unofficial "manager liability action extinguished in violation of Article 1843-5";
    when extinction_action_gerant_exercee(s);
    then violation_extinction_action_gerant(s);
}
@source(CC_ART1843_5)
rule P3MaintenanceInterdictionEteindreActionGerant(s: Societe) strict {
    label fr official "action en responsabilité contre le gérant éteinte en violation de l'article 1843-5";
    label en unofficial "manager liability action extinguished in violation of Article 1843-5";
    when assemblee_tente_eteindre_action_gerant(s);
    then duty P3PositionMaintenanceInterdictionEteindreActionGerant {
        bearer s;
        goal maintenance {
            condition not violation_extinction_action_gerant(s);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART1854)
rule DecisionParConsentementDansActeValide(s: Societe) strict { label en unofficial "Civil Code declaration: decision Par Consentement Dans Acte Valide";
    label fr official "Article 1854. Une décision peut résulter du consentement de tous les associés exprimé dans un acte";
    when consentement_tous_associes_dans_acte(s); then decision_unanime_par_acte_valide(s);
}

@source(CC_ART1853)
rule P3PouvoirConsultationEcrite(s: Societe, p: Personne) strict {
    label fr official "Article 1853. Les statuts peuvent prévoir une consultation écrite";
    label en unofficial "Article 1853. The articles may provide for written consultation";
    when consultation_ecrite_prevue_statuts(s) and acteur_societe(s, p);
    then power P3PositionPouvoirConsultationEcrite {
        holder p;
        over s;
        exercise consultation_ecrite_exercee(s, p);
        effect decision_prise_par_consultation_ecrite(s);
        valid_when consultation_ecrite_prevue_statuts(s);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1854)
rule P3PouvoirConsentementActe(s: Societe, p: Personne) strict {
    label fr official "Article 1854. Une décision peut résulter du consentement de tous les associés exprimé dans un acte";
    label en unofficial "Article 1854. A decision may result from all members' consent in an instrument";
    when consentement_tous_associes_dans_acte(s) and acteur_societe(s, p);
    then power P3PositionPouvoirConsentementActe {
        holder p;
        over s;
        exercise consentement_acte_exerce(s, p);
        effect decision_prise_par_acte_unanime(s);
        valid_when consentement_tous_associes_dans_acte(s);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1856)
rule RapportGestionAnnuelConforme(s: Societe) strict { label en unofficial "Civil Code declaration: rapport Gestion Annuel Conforme";
    label fr official "Article 1856. Le gérant rend compte au moins annuellement par un rapport écrit sur l'activité, les bénéfices et les pertes";
    when rapport_gestion_annuel_ecrit(s); then reddition_gestion_annuelle_conforme(s);
}

@source(CC_ART1860)
rule ProcedureCollectiveAssocieEntrainePerteQualiteEtRemboursement(s: Societe, p: Personne) strict { label en unofficial "Civil Code declaration: procedure Collective Associe Entraine Perte Qualite Et Remboursement";
    label fr official "Article 1860. Hors dissolution unanime ou statutaire, l'associé en procédure collective perd sa qualité et ses droits lui sont remboursés";
    when procedure_collective_associe(s, p) and aucune_dissolution_unanime_ou_statutaire(s);
    then associe_perd_qualite_et_rembourse(s, p);
}

@source(CC_ART1862) {
    rule AcquereursAssociesRepartisProportionnellement(s: Societe) strict { label en unofficial "Civil Code declaration: acquereurs Associes Repartis Proportionnellement";
        label fr official "Article 1862, alinéa 1. Plusieurs associés acquéreurs sont réputés acquérir proportionnellement à leurs parts antérieures";
        when plusieurs_associes_acquereurs(s); then acquisition_parts_proportionnelle(s);
    }
    rule TiersUnanimePeutAcquerirParts(s: Societe) strict { label en unofficial "Civil Code declaration: tiers Unanime Peut Acquerir Parts";
        label fr official "Article 1862, alinéa 2. A défaut d'associé acquéreur, un tiers désigné unanimement peut acquérir";
        when aucun_associe_acquereur(s) and tiers_acquereur_designe_unanimement(s); then solution_rachat_parts_valide(s);
    }
    rule SocietePeutRacheterPartsPourAnnulation(s: Societe) strict { label en unofficial "Civil Code declaration: societe Peut Racheter Parts Pour Annulation";
        label fr official "Article 1862, alinéa 2. La société peut racheter les parts en vue de leur annulation";
        when aucun_associe_acquereur(s) and rachat_parts_par_societe(s); then solution_rachat_parts_valide(s);
    }
    rule OffreAcquisitionNotifieeAuCedant(s: Societe) strict { label en unofficial "Civil Code declaration: offre Acquisition Notifiee Au Cedant";
        label fr official "Article 1862, alinéa 3. L'identité de l'acquéreur et le prix offert sont notifiés au cédant";
        when offre_acquisition_notifiee_cedant(s); then notification_offre_cession_conforme(s);
    }
}

@source(CC_ART1862)
rule P3PouvoirAcquerirPartParTiers(s: Societe, p: Personne) strict {
    label fr official "Article 1862. Un tiers désigné unanimement peut acquérir";
    label en unofficial "Article 1862. A unanimously designated third party may acquire";
    when aucun_associe_acquereur(s) and tiers_acquereur_designe_unanimement(s) and acteur_societe(s, p);
    then power P3PositionPouvoirAcquerirPartParTiers {
        holder p;
        over s;
        exercise acquisition_tiers_exercee(s, p);
        effect solution_rachat_parts_valide(s);
        valid_when tiers_acquereur_designe_unanimement(s);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1862)
rule P3PouvoirRacheterPartsSociete(s: Societe, p: Personne) strict {
    label fr official "Article 1862. La société peut racheter les parts en vue de leur annulation";
    label en unofficial "Article 1862. The company may buy back shares for cancellation";
    when aucun_associe_acquereur(s) and rachat_parts_par_societe(s) and acteur_societe(s, p);
    then power P3PositionPouvoirRacheterPartsSociete {
        holder p;
        over s;
        exercise rachat_parts_exerce(s, p);
        effect solution_rachat_parts_valide(s);
        valid_when rachat_parts_par_societe(s);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1865_1)
rule P3PouvoirCederFormeAutorisee(s: Societe, p: Personne) strict {
    label fr official "Article 1865-1. La cession doit prendre une forme d'acte autorisée";
    label en unofficial "Article 1865-1. The transfer must take an authorized form";
    when acte_cession_forme_autorisee(s) and acteur_societe(s, p);
    then power P3PositionPouvoirCederFormeAutorisee {
        holder p;
        over s;
        exercise cession_forme_exercee(s, p);
        effect forme_cession_immobiliere_valide(s);
        valid_when acte_cession_forme_autorisee(s);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1865) {
    rule CessionOpposableSocieteApresEcritEtFormalites(s: Societe) strict { label en unofficial "Civil Code declaration: cession Opposable Societe Apres Ecrit Et Formalites";
        label fr official "Article 1865, alinéa 1. La cession écrite accomplissant les formalités est opposable à la société";
        when cession_parts_constatee_ecrit(s) and formalites_opposabilite_societe_accomplies(s); then cession_opposable_societe(s);
    }
    rule CessionOpposableTiersApresPublicationRCS(s: Societe) strict { label en unofficial "Civil Code declaration: cession Opposable Tiers Apres Publication RCS";
        label fr official "Article 1865, alinéa 2. La cession est opposable aux tiers après les formalités et la publication au registre";
        when cession_parts_constatee_ecrit(s) and formalites_opposabilite_societe_accomplies(s) and publication_rcs_cession(s);
        then cession_opposable_tiers(s);
    }
}

@source(CC_ART1865_1)
rule FormeRenforceeCessionSocieteImmobiliere(s: Societe) strict { label en unofficial "Civil Code declaration: forme Renforcee Cession Societe Immobiliere";
    label fr official "Article 1865-1. La cession d'une personne morale à prépondérance immobilière doit prendre l'une des formes d'acte autorisées";
    when cession_personne_morale_preponderance_immobiliere(s) and acte_cession_forme_autorisee(s);
    then forme_cession_immobiliere_valide(s);
}

@source(CC_ART1866)
rule NantissementPartsSocialesAdmis(s: Societe) strict { label en unofficial "Civil Code declaration: nantissement Parts Sociales Admis";
    label fr official "Article 1866. Les parts sociales peuvent faire l'objet d'un nantissement";
    when nantissement_parts_sociales(s); then nantissement_parts_admis(s);
}

@source(CC_ART1866)
rule P3PouvoirNantirPartsSociales(s: Societe, p: Personne) strict {
    label fr official "Article 1866. Les parts sociales peuvent faire l'objet d'un nantissement";
    label en unofficial "Article 1866. Company shares may be pledged";
    when nantissement_parts_sociales(s) and acteur_societe(s, p);
    then power P3PositionPouvoirNantirPartsSociales {
        holder p;
        over s;
        exercise nantissement_parts_exerce(s, p);
        effect nantissement_parts_admis(s);
        valid_when nantissement_parts_sociales(s);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART1870_1)
rule HeritierNonAssocieRecoitValeurPartsAuDeces(s: Societe, p: Personne, m: Money) strict { label en unofficial "Civil Code declaration: heritier Non Associe Recoit Valeur Parts Au Deces";
    label fr official "Article 1870-1. L'héritier non associé reçoit la valeur des parts déterminée au jour du décès";
    when heritier_non_associe(s, p) and valeur_parts_au_deces(s, p, m); then paiement_valeur_parts_heritier_du(s, p, m);
}

@source(CC_ART1871_1) {
    rule ParticipationCivileSoumiseAuxReglesSocieteCivile(s: Societe) strict { label en unofficial "Civil Code declaration: participation Civile Soumise Aux Regles Societe Civile";
        label fr official "Article 1871-1. Sans organisation différente, la société en participation civile suit les règles des sociétés civiles";
        when organisation_participation_non_reglee(s) and societe_civile(s); then regles_societe_civile_applicables_participation(s);
    }
    rule ParticipationCommercialeSoumiseAuxReglesSNC(s: Societe) strict { label en unofficial "Civil Code declaration: participation Commerciale Soumise Aux Regles SNC";
        label fr official "Article 1871-1. Sans organisation différente, la société en participation commerciale suit les règles des sociétés en nom collectif";
        when organisation_participation_non_reglee(s) and societe_caractere_commercial(s); then regles_snc_applicables_participation(s);
    }
}

@source(CC_ART1872_2) {
    rule DissolutionParticipationIndetermineeParNotification(s: Societe) strict { label en unofficial "Civil Code declaration: dissolution Participation Indeterminee Par Notification";
        label fr official "Article 1872-2, alinéa 1. La participation à durée indéterminée est dissoute par notification de bonne foi non intempestive";
        when participation_duree_indeterminee(s) and notification_dissolution_bonne_foi_non_intempestive(s);
        then dissolution_participation_notifiee(s);
    }
    rule PartageAvantDissolutionExcluParDefaut(s: Societe) strict { label en unofficial "Civil Code declaration: partage Avant Dissolution Exclu Par Defaut";
        label fr official "Article 1872-2, alinéa 2. Sauf convention contraire, aucun associé ne peut partager les biens indivis avant dissolution";
        when aucune_convention_partage_anticipe(s); then partage_avant_dissolution_exclu(s);
    }
}

@source(CC_ART1872_2)
rule P3InterdictionPartagerBiensAvantDissolution(s: Societe, p: Personne) strict {
    label fr official "Article 1872-2. Aucun associé ne peut partager les biens indivis avant dissolution";
    label en unofficial "Article 1872-2. No partner may share undivided assets before dissolution";
    when aucune_convention_partage_anticipe(s) and acteur_societe(s, p);
    then prohibition P3PositionInterdictionPartagerBiensAvantDissolution {
        bearer p;
        action partage_biens_indivis_exerce(s, p);
        window [@2016-10-01, infinity];
    };
}

pub relation violation_partage_biens_indivis(s: Societe, p: Personne) kind derived {
    label fr official "partage des biens indivis avant dissolution en violation de l'article 1872-2";
    label en unofficial "undivided assets shared before dissolution in violation of Article 1872-2";
}
@source(CC_ART1872_2)
rule ViolationInterdictionPartagerBiensAvantDissolution(s: Societe, p: Personne) strict {
    label fr official "partage des biens indivis avant dissolution en violation de l'article 1872-2";
    label en unofficial "undivided assets shared before dissolution in violation of Article 1872-2";
    when partage_biens_indivis_exerce(s, p);
    then violation_partage_biens_indivis(s, p);
}
@source(CC_ART1872_2)
rule P3MaintenanceInterdictionPartagerBiensAvantDissolution(s: Societe, p: Personne) strict {
    label fr official "partage des biens indivis avant dissolution en violation de l'article 1872-2";
    label en unofficial "undivided assets shared before dissolution in violation of Article 1872-2";
    when aucune_convention_partage_anticipe(s) and acteur_societe(s, p);
    then duty P3PositionMaintenanceInterdictionPartagerBiensAvantDissolution {
        bearer p;
        goal maintenance {
            condition not violation_partage_biens_indivis(s, p);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART1873)
rule RegimeParticipationApplicableSocieteCreeeDeFait(s: Societe) strict { label en unofficial "Civil Code declaration: regime Participation Applicable Societe Creee De Fait";
    label fr official "Article 1873. Le régime des sociétés en participation s'applique aux sociétés créées de fait";
    when societe_creee_de_fait(s); then regles_societe_participation_applicables(s);
}
