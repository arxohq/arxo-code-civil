language "law.core" version "0.2";
package fr.code_civil.contrats_speciaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-contrats-speciaux";

use self::{
    Bien,
    CC_ART1838,
    CC_ART1844_1,
    CC_ART1844_7,
    CC_ART1844_8,
    CC_ART1852,
    CC_ART1854_1,
    CC_ART1861,
    CC_ART1869,
    CC_ART1870,
    CC_ART1871,
    CC_ART1872,
    CC_ART1872_1,
    CauseFinSociete,
    Personne,
    Societe,
    acte_accompli_au_nom_personnel,
    agrement_tous_associes,
    apport_en_industrie,
    associe,
    associe_peut_se_retirer,
    associe_retire_de_la_societe,
    associes_agissent_ouvertement,
    aucune_clause_dissolution_deces,
    bien_mis_a_disposition,
    cause_fin_societe,
    cession_parts_autorisee,
    clause_attribue_tout_profit,
    clause_exclut_tout_profit,
    clause_exonere_toute_perte,
    clause_impose_toute_perte,
    clause_reputee_non_ecrite,
    consultation_fusion_non_requise,
    contrat_de_societe,
    contribution_aux_pertes,
    deces_associe,
    decision_excede_pouvoirs_gerants,
    decision_hors_pouvoirs_valide,
    demande_mandataire_consultation_exercee,
    depourvue_personnalite_morale,
    dispense_de_publicite,
    dissolution_opposable_aux_tiers,
    dissolution_publiee,
    duree_societe_admissible,
    duree_societe_ans,
    justes_motifs_de_dissolution,
    liquidation_requise,
    mandataire_consultation_demandable,
    obligation_personnelle_envers_tiers,
    obligation_solidaire_envers_tiers,
    plus_faible_quote_part_capital,
    pourcentage_capital_demandeurs,
    pourcentage_parts_absorbee_detenu,
    preuve_par_tous_moyens,
    projet_cession_parts,
    proprietaire_envers_tiers,
    quote_part_benefices,
    quote_part_capital,
    remboursement_retrait,
    repartition_legale_applicable,
    retrait_autorise_unanimement,
    retrait_exerce,
    retrait_prevu_statuts,
