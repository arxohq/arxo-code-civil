// BEGIN GENERATED FRAGMENTS

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1582")
pub fragment CC_ART1582 in CC_COURANT {
    label fr official "Article 1582";
    kind article;
    locator "article/1582";
    text fr official """Article 1582
La vente est une convention par laquelle l'un s'oblige à livrer une chose, et l'autre à la payer.
Elle peut être faite par acte authentique ou sous seing privé.
""";
    content_hash "sha256:bcbee91247353a14c9af6759d4966321e14a8efcc2e4eef42168c41057f8a24e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1583")
pub fragment CC_ART1583 in CC_COURANT {
    label fr official "Article 1583";
    kind article;
    locator "article/1583";
    text fr official """Article 1583
Elle est parfaite entre les parties, et la propriété est acquise de droit à l'acheteur à l'égard du vendeur, dès qu'on est convenu de la chose et du prix, quoique la chose n'ait pas encore été livrée ni le prix payé.
""";
    content_hash "sha256:dd03664ca224ea154e6d1e2cfbc92796cfca61430468d2f387bc1d860833b530";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1584")
pub fragment CC_ART1584 in CC_COURANT {
    label fr official "Article 1584";
    kind article;
    locator "article/1584";
    text fr official """Article 1584
La vente peut être faite purement et simplement, ou sous une condition soit suspensive, soit résolutoire.
Elle peut aussi avoir pour objet deux ou plusieurs choses alternatives.
Dans tous ces cas, son effet est réglé par les principes généraux des conventions.
""";
    content_hash "sha256:403c5d08278933ea0b5bb5543edd8cf8040d5eeb60683e2df2e24aa67513ae3f";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1585")
pub fragment CC_ART1585 in CC_COURANT {
    label fr official "Article 1585";
    kind article;
    locator "article/1585";
    text fr official """Article 1585
Lorsque des marchandises ne sont pas vendues en bloc, mais au poids, au compte ou à la mesure, la vente n'est point parfaite, en ce sens que les choses vendues sont aux risques du vendeur jusqu'à ce qu'elles soient pesées, comptées ou mesurées ; mais l'acheteur peut en demander ou la délivrance ou des dommages-intérêts, s'il y a lieu, en cas d'inexécution de l'engagement.
""";
    content_hash "sha256:a5c8b5e60ff83037d18b0ebb1914cc8e9b0538c689ba6da6e033733641ab71ec";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1586")
pub fragment CC_ART1586 in CC_COURANT {
    label fr official "Article 1586";
    kind article;
    locator "article/1586";
    text fr official """Article 1586
Si, au contraire, les marchandises ont été vendues en bloc, la vente est parfaite, quoique les marchandises n'aient pas encore été pesées, comptées ou mesurées.
""";
    content_hash "sha256:43861c98014342aee5480b97d7e585436b8a27394154a59f387f53a59e181735";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1587")
pub fragment CC_ART1587 in CC_COURANT {
    label fr official "Article 1587";
    kind article;
    locator "article/1587";
    text fr official """Article 1587
A l'égard du vin, de l'huile, et des autres choses que l'on est dans l'usage de goûter avant d'en faire l'achat, il n'y a point de vente tant que l'acheteur ne les a pas goûtées et agréées.
""";
    content_hash "sha256:6801ca0bf2cf5dacc5d7ccbcc0d6a667a7e2c0c7c015c77c221bebae78f2e0b3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1588")
pub fragment CC_ART1588 in CC_COURANT {
    label fr official "Article 1588";
    kind article;
    locator "article/1588";
    text fr official """Article 1588
La vente faite à l'essai est toujours présumée faite sous une condition suspensive.
""";
    content_hash "sha256:28aeef6453b040233509baeb9c465d44a88ff320963736acba1514686a4e9bc3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1589")
pub fragment CC_ART1589 in CC_COURANT {
    label fr official "Article 1589";
    kind article;
    locator "article/1589";
    text fr official """Article 1589
La promesse de vente vaut vente, lorsqu'il y a consentement réciproque des deux parties sur la chose et sur le prix.
Si cette promesse s'applique à des terrains déjà lotis ou à lotir, son acceptation et la convention qui en résultera s'établiront par le paiement d'un acompte sur le prix, quel que soit le nom donné à cet acompte, et par la prise de possession du terrain.
La date de la convention, même régularisée ultérieurement, sera celle du versement du premier acompte.
""";
    content_hash "sha256:4151758165f5f7dc1b97138f184f67bf11138547521bbcc06b9099afc8bde683";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1589_1")
pub fragment CC_ART1589_1 in CC_COURANT {
    label fr official "Article 1589-1";
    kind article;
    locator "article/1589-1";
    text fr official """Article 1589-1
Est frappé de nullité tout engagement unilatéral souscrit en vue de l'acquisition d'un bien ou d'un droit immobilier pour lequel il est exigé ou reçu de celui qui s'engage un versement, quelle qu'en soit la cause et la forme.
""";
    content_hash "sha256:4e64b3664dcd28190cf33cb2f8d8f2b4bda6128185f0c63c49695a54e5a20953";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1589_2")
pub fragment CC_ART1589_2 in CC_COURANT {
    label fr official "Article 1589-2";
    kind article;
    locator "article/1589-2";
    text fr official """Article 1589-2
Est nulle et de nul effet toute promesse unilatérale de vente afférente à un immeuble, à un droit immobilier, à un fonds de commerce, à un droit à un bail portant sur tout ou partie d'un immeuble ou aux titres des sociétés visées aux articles 728 et 1655 ter du code général des impôts, si elle n'est pas constatée par un acte authentique ou par un acte sous seing privé enregistré dans le délai de dix jours à compter de la date de son acceptation par le bénéficiaire. Il en est de même de toute cession portant sur lesdites promesses qui n'a pas fait l'objet d'un acte authentique ou d'un acte sous seing privé enregistré dans les dix jours de sa date.
""";
    content_hash "sha256:b10566740cf7465930349102c98b04218b1155b136b0af32cf661aa22a53c2cf";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1590")
pub fragment CC_ART1590 in CC_COURANT {
    label fr official "Article 1590";
    kind article;
    locator "article/1590";
    text fr official """Article 1590
Si la promesse de vendre a été faite avec des arrhes chacun des contractants est maître de s'en départir,
Celui qui les a données, en les perdant,
Et celui qui les a reçues, en restituant le double.
""";
    content_hash "sha256:ae0d2a22decc87ecd25b6303f77b5a00dac6e23ed90e926300d9542daeaa672d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1591")
pub fragment CC_ART1591 in CC_COURANT {
    label fr official "Article 1591";
    kind article;
    locator "article/1591";
    text fr official """Article 1591
Le prix de la vente doit être déterminé et désigné par les parties.
""";
    content_hash "sha256:830658323bd211fb84320779ca17809d48153390853dbe017a537ac9c0a9bb6d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1592")
pub fragment CC_ART1592 in CC_COURANT {
    label fr official "Article 1592";
    kind article;
    locator "article/1592";
    text fr official """Article 1592
Il peut cependant être laissé à l'estimation d'un tiers ; si le tiers ne veut ou ne peut faire l'estimation, il n'y a point de vente, sauf estimation par un autre tiers.
""";
    content_hash "sha256:8ff577ca928c413779ed2558576654dd93189c82b904ed7fd1012164ec587d8d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1593")
pub fragment CC_ART1593 in CC_COURANT {
    label fr official "Article 1593";
    kind article;
    locator "article/1593";
    text fr official """Article 1593
Les frais d'actes et autres accessoires à la vente sont à la charge de l'acheteur.
""";
    content_hash "sha256:95b94546b4e084f2aa8fe03e2eb5692588ba1f22572ae20ca29922a9b9017bdc";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1594")
pub fragment CC_ART1594 in CC_COURANT {
    label fr official "Article 1594";
    kind article;
    locator "article/1594";
    text fr official """Article 1594
Tous ceux auxquels la loi ne l'interdit pas peuvent acheter ou vendre.
""";
    content_hash "sha256:d3122f583fbc808cab8332a24f541b90e067c792dcb5581ffb71c2141965ab15";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1596")
pub fragment CC_ART1596 in CC_COURANT {
    label fr official "Article 1596";
    kind article;
    locator "article/1596";
    text fr official """Article 1596
Ne peuvent se rendre adjudicataires, sous peine de nullité, ni par eux-mêmes, ni par personnes interposées :
Les tuteurs, des biens de ceux dont ils ont la tutelle ;
Les mandataires, des biens qu'ils sont chargés de vendre ;
Les administrateurs, de ceux des communes ou des établissements publics confiés à leurs soins ;
Les officiers publics, des biens nationaux dont les ventes se font par leur ministère ;
Les fiduciaires, des biens ou droits composant le patrimoine fiduciaire.
""";
    content_hash "sha256:3814d816085324c9d58cd79655eaaba344874eedbb399fa2175ad9d617851949";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1597")
pub fragment CC_ART1597 in CC_COURANT {
    label fr official "Article 1597";
    kind article;
    locator "article/1597";
    text fr official """Article 1597
Les juges, leurs suppléants, les magistrats remplissant le ministère public, les greffiers, huissiers, avocats, défenseurs officieux et notaires, ne peuvent devenir cessionnaires des procès, droits et actions litigieux qui sont de la compétence du tribunal dans le ressort duquel ils exercent leurs fonctions, à peine de nullité, et des dépens, dommages et intérêts.
""";
    content_hash "sha256:a98136eec2ba7a8ecf10683a85122ab8b851f9c9c44799ee21061128ef1a33b7";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1598")
pub fragment CC_ART1598 in CC_COURANT {
    label fr official "Article 1598";
    kind article;
    locator "article/1598";
    text fr official """Article 1598
Tout ce qui est dans le commerce peut être vendu lorsque des lois particulières n'en ont pas prohibé l'aliénation.
""";
    content_hash "sha256:4469942f3297435564cf1737041939054d18f776605fcb26f62863a82d7a2e75";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1599")
pub fragment CC_ART1599 in CC_COURANT {
    label fr official "Article 1599";
    kind article;
    locator "article/1599";
    text fr official """Article 1599
La vente de la chose d'autrui est nulle : elle peut donner lieu à des dommages-intérêts lorsque l'acheteur a ignoré que la chose fût à autrui.
""";
    content_hash "sha256:c81fb6ec25087327fd7e5effe8fc52eff21c219c198f77508aa8d9be73a4324c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1601")
pub fragment CC_ART1601 in CC_COURANT {
    label fr official "Article 1601";
    kind article;
    locator "article/1601";
    text fr official """Article 1601
Si au moment de la vente la chose vendue était périe en totalité, la vente serait nulle.
Si une partie seulement de la chose est périe, il est au choix de l'acquéreur d'abandonner la vente, ou de demander la partie conservée, en faisant déterminer le prix par la ventilation.
""";
    content_hash "sha256:773d96d96578f5ffe1b07ed3b3c7485d2eb725fbd2a77ef31917749c2ba58cea";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1601_1")
pub fragment CC_ART1601_1 in CC_COURANT {
    label fr official "Article 1601-1";
    kind article;
    locator "article/1601-1";
    text fr official """Article 1601-1
La vente d'immeubles à construire est celle par laquelle le vendeur s'oblige à édifier un immeuble dans un délai déterminé par le contrat.
Elle peut être conclue à terme ou en l'état futur d'achèvement.
""";
    content_hash "sha256:d0c6c8e01f36ad00705bd9a47810ba2154829f8e01e5109c87a7dd884999f6a9";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1601_2")
pub fragment CC_ART1601_2 in CC_COURANT {
    label fr official "Article 1601-2";
    kind article;
    locator "article/1601-2";
    text fr official """Article 1601-2
La vente à terme est le contrat par lequel le vendeur s'engage à livrer l'immeuble à son achèvement, l'acheteur s'engage à en prendre livraison et à en payer le prix à la date de livraison. Le transfert de propriété s'opère de plein droit par la constatation par acte authentique de l'achèvement de l'immeuble ; il produit ses effets rétroactivement au jour de la vente.
""";
    content_hash "sha256:b9d18be8813d325791b5381e9283fb35fd1e5a93779e55eb1a7cc65e20857ebb";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1601_3")
pub fragment CC_ART1601_3 in CC_COURANT {
    label fr official "Article 1601-3";
    kind article;
    locator "article/1601-3";
    text fr official """Article 1601-3
La vente en l'état futur d'achèvement est le contrat par lequel le vendeur transfère immédiatement à l'acquéreur ses droits sur le sol ainsi que la propriété des constructions existantes. Les ouvrages à venir deviennent la propriété de l'acquéreur au fur et à mesure de leur exécution ; l'acquéreur est tenu d'en payer le prix à mesure de l'avancement des travaux.
Le vendeur conserve les pouvoirs de maître de l'ouvrage jusqu'à la réception des travaux.
""";
    content_hash "sha256:d970c711079e4db421661eeb94e3be94d117271f0dc8252bcbf4be4c64bb8863";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1601_4")
pub fragment CC_ART1601_4 in CC_COURANT {
    label fr official "Article 1601-4";
    kind article;
    locator "article/1601-4";
    text fr official """Article 1601-4
La cession par l'acquéreur des droits qu'il tient d'une vente d'immeuble à construire substitue de plein droit le cessionnaire dans les obligations de l'acquéreur envers le vendeur.
Si la vente a été assortie d'un mandat, celui-ci se poursuit entre le vendeur et le cessionnaire.
Ces dispositions s'appliquent à toute mutation entre vifs, volontaire ou forcée, ou à cause de mort.
""";
    content_hash "sha256:0db88228e883c502f1af97870ff9cb5dcaf9a9d1666ab851eb2879faa168778c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1602")
pub fragment CC_ART1602 in CC_COURANT {
    label fr official "Article 1602";
    kind article;
    locator "article/1602";
    text fr official """Article 1602
Le vendeur est tenu d'expliquer clairement ce à quoi il s'oblige.
Tout pacte obscur ou ambigu s'interprète contre le vendeur.
""";
    content_hash "sha256:de1a780ac12b84d1b7b7e42352973c7307e69e7d84775d08afc019128067b896";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1603")
pub fragment CC_ART1603 in CC_COURANT {
    label fr official "Article 1603";
    kind article;
    locator "article/1603";
    text fr official """Article 1603
Il a deux obligations principales, celle de délivrer et celle de garantir la chose qu'il vend.
""";
    content_hash "sha256:764e59c3975ac43d294b0edeb53815c48c33ebc6c6e86f54b58c8ee5992f0a7a";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1604")
pub fragment CC_ART1604 in CC_COURANT {
    label fr official "Article 1604";
    kind article;
    locator "article/1604";
    text fr official """Article 1604
La délivrance est le transport de la chose vendue en la puissance et possession de l'acheteur.
""";
    content_hash "sha256:409f178ccee8395554c3016a4a8c9e5ab3761d241895e12e4f7f85a9b56b9de2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1605")
pub fragment CC_ART1605 in CC_COURANT {
    label fr official "Article 1605";
    kind article;
    locator "article/1605";
    text fr official """Article 1605
L'obligation de délivrer les immeubles est remplie de la part du vendeur lorsqu'il a remis les clefs, s'il s'agit d'un bâtiment, ou lorsqu'il a remis les titres de propriété.
""";
    content_hash "sha256:bed8eb547742341ecab0480213ef46975f84a962c314865cc891009cf26dd1b2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1606")
pub fragment CC_ART1606 in CC_COURANT {
    label fr official "Article 1606";
    kind article;
    locator "article/1606";
    text fr official """Article 1606
La délivrance des effets mobiliers s'opère :
Ou par la remise de la chose,
Ou par la remise des clefs des bâtiments qui les contiennent,
Ou même par le seul consentement des parties, si le transport ne peut pas s'en faire au moment de la vente, ou si l'acheteur les avait déjà en son pouvoir à un autre titre.
""";
    content_hash "sha256:b6c18dabc1ee212221d9a87d8c400673f80abd3c800bedf70a57e931c2139204";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1607")
pub fragment CC_ART1607 in CC_COURANT {
    label fr official "Article 1607";
    kind article;
    locator "article/1607";
    text fr official """Article 1607
La tradition des droits incorporels se fait, ou par la remise des titres, ou par l'usage que l'acquéreur en fait du consentement du vendeur.
""";
    content_hash "sha256:05c1ba113597fbc4ae8d7bd686f87fe4e50fe18dde1c8f23b81e5e386d4cf974";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1608")
pub fragment CC_ART1608 in CC_COURANT {
    label fr official "Article 1608";
    kind article;
    locator "article/1608";
    text fr official """Article 1608
Les frais de la délivrance sont à la charge du vendeur, et ceux de l'enlèvement à la charge de l'acheteur, s'il n'y a eu stipulation contraire.
""";
    content_hash "sha256:f879e1b32c5e4eb93ac7fbd0e9e3a1530741c36f66d28120be6b6ca0b78c8d9f";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1609")
pub fragment CC_ART1609 in CC_COURANT {
    label fr official "Article 1609";
    kind article;
    locator "article/1609";
    text fr official """Article 1609
La délivrance doit se faire au lieu où était, au temps de la vente, la chose qui en a fait l'objet, s'il n'en a été autrement convenu.
""";
    content_hash "sha256:833e588af0afdf8b435aeadc0639815af794fcbb4ffa308516356e7f6424ae90";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1610")
pub fragment CC_ART1610 in CC_COURANT {
    label fr official "Article 1610";
    kind article;
    locator "article/1610";
    text fr official """Article 1610
Si le vendeur manque à faire la délivrance dans le temps convenu entre les parties, l'acquéreur pourra, à son choix, demander la résolution de la vente, ou sa mise en possession, si le retard ne vient que du fait du vendeur.
""";
    content_hash "sha256:975a7f839963d155831826671c75bc92b156f6df19f12e6c6d871f06898170c4";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1611")
pub fragment CC_ART1611 in CC_COURANT {
    label fr official "Article 1611";
    kind article;
    locator "article/1611";
    text fr official """Article 1611
Dans tous les cas, le vendeur doit être condamné aux dommages et intérêts, s'il résulte un préjudice pour l'acquéreur, du défaut de délivrance au terme convenu.
""";
    content_hash "sha256:55a7df61fa18dbb5953e5c25c8533220a04d9d4846b227b83ce752ea22860451";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1612")
pub fragment CC_ART1612 in CC_COURANT {
    label fr official "Article 1612";
    kind article;
    locator "article/1612";
    text fr official """Article 1612
Le vendeur n'est pas tenu de délivrer la chose, si l'acheteur n'en paye pas le prix, et que le vendeur ne lui ait pas accordé un délai pour le paiement.
""";
    content_hash "sha256:57c4e4bfb8cb25ccbb9c999ec9d6bb7d7fbd9f2f9f9262527bb37fe020f42d54";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1613")
pub fragment CC_ART1613 in CC_COURANT {
    label fr official "Article 1613";
    kind article;
    locator "article/1613";
    text fr official """Article 1613
Il ne sera pas non plus obligé à la délivrance, quand même il aurait accordé un délai pour le paiement, si, depuis la vente, l'acheteur est tombé en faillite ou en état de déconfiture, en sorte que le vendeur se trouve en danger imminent de perdre le prix ; à moins que l'acheteur ne lui donne caution de payer au terme.
""";
    content_hash "sha256:bf6d3aa96aeb849ddac7b173c4e19074080f9e0507112d188cdc3084cf638185";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1614")
pub fragment CC_ART1614 in CC_COURANT {
    label fr official "Article 1614";
    kind article;
    locator "article/1614";
    text fr official """Article 1614
La chose doit être délivrée en l'état où elle se trouve au moment de la vente.
Depuis ce jour, tous les fruits appartiennent à l'acquéreur.
""";
    content_hash "sha256:555687591f63cfa2ee7923edec6f9d995de53b6a33ec1723b329d05601fc9765";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1615")
pub fragment CC_ART1615 in CC_COURANT {
    label fr official "Article 1615";
    kind article;
    locator "article/1615";
    text fr official """Article 1615
L'obligation de délivrer la chose comprend ses accessoires et tout ce qui a été destiné à son usage perpétuel.
""";
    content_hash "sha256:8b2e0231b3836d08edebc7eb6ca2bb7678adb131612706b68c48454dc2b61ad6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1616")
pub fragment CC_ART1616 in CC_COURANT {
    label fr official "Article 1616";
    kind article;
    locator "article/1616";
    text fr official """Article 1616
Le vendeur est tenu de délivrer la contenance telle qu'elle est portée au contrat, sous les modifications ci-après exprimées.
""";
    content_hash "sha256:fff5b27af1bc3b39607258450576d608c317ba80e571e6d4d7ae8ef56709a0a4";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1617")
pub fragment CC_ART1617 in CC_COURANT {
    label fr official "Article 1617";
    kind article;
    locator "article/1617";
    text fr official """Article 1617
Si la vente d'un immeuble a été faite avec indication de la contenance, à raison de tant la mesure, le vendeur est obligé de délivrer à l'acquéreur, s'il l'exige, la quantité indiquée au contrat ;
Et si la chose ne lui est pas possible, ou si l'acquéreur ne l'exige pas, le vendeur est obligé de souffrir une diminution proportionnelle du prix.
""";
    content_hash "sha256:e994c73118f62fb48b3858b6f79464eef31b55de9a74cdd76c49a637490e152e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1618")
pub fragment CC_ART1618 in CC_COURANT {
    label fr official "Article 1618";
    kind article;
    locator "article/1618";
    text fr official """Article 1618
Si, au contraire, dans le cas de l'article précédent, il se trouve une contenance plus grande que celle exprimée au contrat, l'acquéreur a le choix de fournir le supplément du prix, ou de se désister du contrat, si l'excédent est d'un vingtième au-dessus de la contenance déclarée.
""";
    content_hash "sha256:ba30a82d613453d974d4c1d3f8292311a201e057f0b216cb5bd88ea92e63e90a";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1619")
pub fragment CC_ART1619 in CC_COURANT {
    label fr official "Article 1619";
    kind article;
    locator "article/1619";
    text fr official """Article 1619
Dans tous les autres cas,
Soit que la vente soit faite d'un corps certain et limité,
Soit qu'elle ait pour objet des fonds distincts et séparés,
Soit qu'elle commence par la mesure, ou par la désignation de l'objet vendu suivie de la mesure,
L'expression de cette mesure ne donne lieu à aucun supplément de prix, en faveur du vendeur, pour l'excédent de mesure, ni en faveur de l'acquéreur, à aucune diminution du prix pour moindre mesure, qu'autant que la différence de la mesure réelle à celle exprimée au contrat est d'un vingtième en plus ou en moins, eu égard à la valeur de la totalité des objets vendus, s'il n'y a stipulation contraire.
""";
    content_hash "sha256:f1e7058658ded069018fbf37a67bc2aa62f967572ae3fd293729f0109ae974f6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1620")
pub fragment CC_ART1620 in CC_COURANT {
    label fr official "Article 1620";
    kind article;
    locator "article/1620";
    text fr official """Article 1620
Dans le cas où, suivant l'article précédent, il y a lieu à augmentation de prix pour excédent de mesure, l'acquéreur a le choix ou de se désister du contrat ou de fournir le supplément du prix, et ce, avec les intérêts s'il a gardé l'immeuble.
""";
    content_hash "sha256:3f9d73f959f31b14624e91db05918cdbf29df0a1ef538f056be968553ac051c8";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1621")
pub fragment CC_ART1621 in CC_COURANT {
    label fr official "Article 1621";
    kind article;
    locator "article/1621";
    text fr official """Article 1621
Dans tous les cas où l'acquéreur a le droit de se désister du contrat, le vendeur est tenu de lui restituer, outre le prix, s'il l'a reçu, les frais de ce contrat.
""";
    content_hash "sha256:28db1862da7fca968889b48aabb089fc4a6ae7f7cb26be93eaff58d60f038734";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1622")
pub fragment CC_ART1622 in CC_COURANT {
    label fr official "Article 1622";
    kind article;
    locator "article/1622";
    text fr official """Article 1622
L'action en supplément de prix de la part du vendeur, et celle en diminution de prix ou en résiliation du contrat de la part de l'acquéreur, doivent être intentées dans l'année, à compter du jour du contrat, à peine de déchéance.
""";
    content_hash "sha256:8d47b83ff18d087c6c2a8570d67ce6666e7599f58ce652103f7403cc82554601";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1623")
pub fragment CC_ART1623 in CC_COURANT {
    label fr official "Article 1623";
    kind article;
    locator "article/1623";
    text fr official """Article 1623
S'il a été vendu deux fonds par le même contrat, et pour un seul et même prix, avec désignation de la mesure de chacun, et qu'il se trouve moins de contenance en l'un et plus en l'autre, on fait compensation jusqu'à due concurrence ; et l'action, soit en supplément, soit en diminution du prix, n'a lieu que suivant les règles ci-dessus établies.
""";
    content_hash "sha256:2f9f83402113684640a38ff068484f20f15098c74522009e0aadcab0dede766f";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1624")
pub fragment CC_ART1624 in CC_COURANT {
    label fr official "Article 1624";
    kind article;
    locator "article/1624";
    text fr official """Article 1624
La question de savoir sur lequel, du vendeur ou de l'acquéreur, doit tomber la perte ou la détérioration de la chose vendue avant la livraison, est jugée d'après les règles prescrites au titre " Des contrats ou des obligations conventionnelles en général ".
""";
    content_hash "sha256:a8a073c079aed8d607155ba999c23a76d08677e1e329034d98fc619631e62dc2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1625")
pub fragment CC_ART1625 in CC_COURANT {
    label fr official "Article 1625";
    kind article;
    locator "article/1625";
    text fr official """Article 1625
La garantie que le vendeur doit à l'acquéreur a deux objets : le premier est la possession paisible de la chose vendue ; le second, les défauts cachés de cette chose ou les vices rédhibitoires.
""";
    content_hash "sha256:fdf1667ee4a74909864b52c5d620785b1fff6ffc0fc68e5cae6fb95c4afb5112";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1626")
pub fragment CC_ART1626 in CC_COURANT {
    label fr official "Article 1626";
    kind article;
    locator "article/1626";
    text fr official """Article 1626
Quoique lors de la vente il n'ait été fait aucune stipulation sur la garantie, le vendeur est obligé de droit à garantir l'acquéreur de l'éviction qu'il souffre dans la totalité ou partie de l'objet vendu, ou des charges prétendues sur cet objet, et non déclarées lors de la vente.
""";
    content_hash "sha256:88e1941d421695ad8d48df1fea5eb0e89778c6144b6701f5ed82065ce680767d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1627")
pub fragment CC_ART1627 in CC_COURANT {
    label fr official "Article 1627";
    kind article;
    locator "article/1627";
    text fr official """Article 1627
Les parties peuvent, par des conventions particulières, ajouter à cette obligation de droit ou en diminuer l'effet ; elles peuvent même convenir que le vendeur ne sera soumis à aucune garantie.
""";
    content_hash "sha256:e29d52c70a88c291d2e186ccdedc9a631f8526f707d0f385ba944e3bfa39d4c8";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1628")
pub fragment CC_ART1628 in CC_COURANT {
    label fr official "Article 1628";
    kind article;
    locator "article/1628";
    text fr official """Article 1628
Quoiqu'il soit dit que le vendeur ne sera soumis à aucune garantie, il demeure cependant tenu de celle qui résulte d'un fait qui lui est personnel : toute convention contraire est nulle.
""";
    content_hash "sha256:d620624edcc9edd1878b0e0aa7a9b64e173913bc5d73c6a34e5fe3d3a3b3ae08";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1629")
pub fragment CC_ART1629 in CC_COURANT {
    label fr official "Article 1629";
    kind article;
    locator "article/1629";
    text fr official """Article 1629
Dans le même cas de stipulation de non-garantie, le vendeur, en cas d'éviction, est tenu à la restitution du prix, à moins que l'acquéreur n'ait connu lors de la vente le danger de l'éviction ou qu'il n'ait acheté à ses périls et risques.
""";
    content_hash "sha256:6a9e6c232e20ba075b3746cd33e89875ee27e8094558f45ee3a9e2f8f092f703";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1630")
pub fragment CC_ART1630 in CC_COURANT {
    label fr official "Article 1630";
    kind article;
    locator "article/1630";
    text fr official """Article 1630
Lorsque la garantie a été promise, ou qu'il n'a rien été stipulé à ce sujet, si l'acquéreur est évincé, il a droit de demander contre le vendeur :
1° La restitution du prix ;
2° Celle des fruits, lorsqu'il est obligé de les rendre au propriétaire qui l'évince ;
3° Les frais faits sur la demande en garantie de l'acheteur, et ceux faits par le demandeur originaire ;
4° Enfin les dommages et intérêts, ainsi que les frais et loyaux coûts du contrat.
""";
    content_hash "sha256:5b73dcdf654c31eaf7695c99fdeb92c78a0a81e6544b0031f21fee345b302f25";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1631")
pub fragment CC_ART1631 in CC_COURANT {
    label fr official "Article 1631";
    kind article;
    locator "article/1631";
    text fr official """Article 1631
Lorsqu'à l'époque de l'éviction, la chose vendue se trouve diminuée de valeur, ou considérablement détériorée, soit par la négligence de l'acheteur, soit par des accidents de force majeure, le vendeur n'en est pas moins tenu de restituer la totalité du prix.
""";
    content_hash "sha256:7090b7ee7dd9f93b7857acdbfa41aa07db3de1496f70933e7376d13232ac31e7";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1632")
pub fragment CC_ART1632 in CC_COURANT {
    label fr official "Article 1632";
    kind article;
    locator "article/1632";
    text fr official """Article 1632
Mais si l'acquéreur a tiré profit des dégradations par lui faites, le vendeur a droit de retenir sur le prix une somme égale à ce profit.
""";
    content_hash "sha256:ba687530e9e85300d8c4eca63ef00a802d76c865135c258f957ebb6dc12f9a80";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1633")
pub fragment CC_ART1633 in CC_COURANT {
    label fr official "Article 1633";
    kind article;
    locator "article/1633";
    text fr official """Article 1633
Si la chose vendue se trouve avoir augmenté de prix à l'époque de l'éviction, indépendamment même du fait de l'acquéreur, le vendeur est tenu de lui payer ce qu'elle vaut au-dessus du prix de la vente.
""";
    content_hash "sha256:52e078cf746518b92514bc281791a919d7c48e5dda2d777f75b4c6940ff2c931";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1634")
pub fragment CC_ART1634 in CC_COURANT {
    label fr official "Article 1634";
    kind article;
    locator "article/1634";
    text fr official """Article 1634
Le vendeur est tenu de rembourser ou de faire rembourser à l'acquéreur, par celui qui l'évince, toutes les réparations et améliorations utiles qu'il aura faites au fonds.
""";
    content_hash "sha256:5e968cea6e15060adc8ad8269e8510ffeced04d5313aab086d85d8fc2971999c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1635")
pub fragment CC_ART1635 in CC_COURANT {
    label fr official "Article 1635";
    kind article;
    locator "article/1635";
    text fr official """Article 1635
Si le vendeur avait vendu de mauvaise foi le fonds d'autrui, il sera obligé de rembourser à l'acquéreur toutes les dépenses, même voluptuaires ou d'agrément, que celui-ci aura faites au fonds.
""";
    content_hash "sha256:dbff111b17741d587852f23dc3d2a054dd660a2171f597ec4e744269537ee610";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1636")
pub fragment CC_ART1636 in CC_COURANT {
    label fr official "Article 1636";
    kind article;
    locator "article/1636";
    text fr official """Article 1636
Si l'acquéreur n'est évincé que d'une partie de la chose, et qu'elle soit de telle conséquence, relativement au tout, que l'acquéreur n'eût point acheté sans la partie dont il a été évincé, il peut faire résilier la vente.
""";
    content_hash "sha256:c5f3c7ce0936bac856916e678f8b41a4e56022b7bc972051c452af963e438d92";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1637")
pub fragment CC_ART1637 in CC_COURANT {
    label fr official "Article 1637";
    kind article;
    locator "article/1637";
    text fr official """Article 1637
Si, dans le cas de l'éviction d'une partie du fonds vendu, la vente n'est pas résiliée, la valeur de la partie dont l'acquéreur se trouve évincé lui est remboursée suivant l'estimation à l'époque de l'éviction, et non proportionnellement au prix total de la vente, soit que la chose vendue ait augmenté ou diminué de valeur.
""";
    content_hash "sha256:ece4a1becbe73006070fb44afe4156bf54eaf21ec3abe33204a7c4a2ef44e5a9";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1638")
pub fragment CC_ART1638 in CC_COURANT {
    label fr official "Article 1638";
    kind article;
    locator "article/1638";
    text fr official """Article 1638
Si l'héritage vendu se trouve grevé, sans qu'il en ait été fait de déclaration, de servitudes non apparentes, et qu'elles soient de telle importance qu'il y ait lieu de présumer que l'acquéreur n'aurait pas acheté s'il en avait été instruit, il peut demander la résiliation du contrat, si mieux il n'aime se contenter d'une indemnité.
""";
    content_hash "sha256:e709fdd19deae2b5207a3527aeea87a790742ec8fbc4f2faa64a4c733c5ffb26";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1639")
pub fragment CC_ART1639 in CC_COURANT {
    label fr official "Article 1639";
    kind article;
    locator "article/1639";
    text fr official """Article 1639
Les autres questions auxquelles peuvent donner lieu les dommages et intérêts résultant pour l'acquéreur de l'inexécution de la vente doivent être décidées suivant les règles générales établies au titre " Des contrats ou des obligations conventionnelles en général ".
""";
    content_hash "sha256:e86ad9f4282f2c2046d85cc4a76bf2bf85c832ffb06936d232ccf6c1af4eb358";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1640")
pub fragment CC_ART1640 in CC_COURANT {
    label fr official "Article 1640";
    kind article;
    locator "article/1640";
    text fr official """Article 1640
La garantie pour cause d'éviction cesse lorsque l'acquéreur s'est laissé condamner par un jugement en dernier ressort, ou dont l'appel n'est plus recevable, sans appeler son vendeur, si celui-ci prouve qu'il existait des moyens suffisants pour faire rejeter la demande.
""";
    content_hash "sha256:4b2b191072507ad0ee1ddd7060a431b19b61b09ac20c7686772ea5702d7a6772";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1641")
pub fragment CC_ART1641 in CC_COURANT {
    label fr official "Article 1641";
    kind article;
    locator "article/1641";
    text fr official """Article 1641
Le vendeur est tenu de la garantie à raison des défauts cachés de la chose vendue qui la rendent impropre à l'usage auquel on la destine, ou qui diminuent tellement cet usage que l'acheteur ne l'aurait pas acquise, ou n'en aurait donné qu'un moindre prix, s'il les avait connus.
""";
    content_hash "sha256:559cd72074147bf0541f8faa7ede7095020776f4d5baccc3c4757dadd142b514";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1642")
pub fragment CC_ART1642 in CC_COURANT {
    label fr official "Article 1642";
    kind article;
    locator "article/1642";
    text fr official """Article 1642
Le vendeur n'est pas tenu des vices apparents et dont l'acheteur a pu se convaincre lui-même.
""";
    content_hash "sha256:364c9147c0c62faf1c4fae24dc6fd5e15315f38fb9f3880b92e0a77b700b96e1";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1642_1")
pub fragment CC_ART1642_1 in CC_COURANT {
    label fr official "Article 1642-1";
    kind article;
    locator "article/1642-1";
    text fr official """Article 1642-1
Le vendeur d'un immeuble à construire ne peut être déchargé, ni avant la réception des travaux, ni avant l'expiration d'un délai d'un mois après la prise de possession par l'acquéreur, des vices de construction ou des défauts de conformité alors apparents.
Il n'y aura pas lieu à résolution du contrat ou à diminution du prix si le vendeur s'oblige à réparer.
""";
    content_hash "sha256:3eaf5a06e36eb06a706765f0385186edf872caf3bce18c0419b777e5caa2f8a9";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1643")
pub fragment CC_ART1643 in CC_COURANT {
    label fr official "Article 1643";
    kind article;
    locator "article/1643";
    text fr official """Article 1643
Il est tenu des vices cachés, quand même il ne les aurait pas connus, à moins que, dans ce cas, il n'ait stipulé qu'il ne sera obligé à aucune garantie.
""";
    content_hash "sha256:0bd693a645b3bc25cb947f8d708303bbe00c0dac33a13e8261d20a9563e3ab2d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1644")
pub fragment CC_ART1644 in CC_COURANT {
    label fr official "Article 1644";
    kind article;
    locator "article/1644";
    text fr official """Article 1644
Dans le cas des articles 1641 et 1643, l'acheteur a le choix de rendre la chose et de se faire restituer le prix, ou de garder la chose et de se faire rendre une partie du prix.
""";
    content_hash "sha256:01e39588ec796de5649d6e99a6635da341f9ff0b5512f5e57421fb3d565b1167";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1645")
pub fragment CC_ART1645 in CC_COURANT {
    label fr official "Article 1645";
    kind article;
    locator "article/1645";
    text fr official """Article 1645
Si le vendeur connaissait les vices de la chose, il est tenu, outre la restitution du prix qu'il en a reçu, de tous les dommages et intérêts envers l'acheteur.
""";
    content_hash "sha256:a525f867eb0501c6dc2b924aa2bbeff55020ef8e5b3394e5bd83fcd6fd8d80df";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1646")
pub fragment CC_ART1646 in CC_COURANT {
    label fr official "Article 1646";
    kind article;
    locator "article/1646";
    text fr official """Article 1646
Si le vendeur ignorait les vices de la chose, il ne sera tenu qu'à la restitution du prix, et à rembourser à l'acquéreur les frais occasionnés par la vente.
""";
    content_hash "sha256:41a6abf54046c09001aa12e29d01231cf443eeb6082f4a63cd8abe81c94a8895";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1646_1")
pub fragment CC_ART1646_1 in CC_COURANT {
    label fr official "Article 1646-1";
    kind article;
    locator "article/1646-1";
    text fr official """Article 1646-1
Le vendeur d'un immeuble à construire est tenu, à compter de la réception des travaux, des obligations dont les architectes, entrepreneurs et autres personnes liées au maître de l'ouvrage par un contrat de louage d'ouvrage sont eux-mêmes tenus en application des articles 1792, 1792-1, 1792-2 et 1792-3 du présent code.
Ces garanties bénéficient aux propriétaires successifs de l'immeuble.
Il n'y aura pas lieu à résolution de la vente ou à diminution du prix si le vendeur s'oblige à réparer les dommages définis aux articles 1792, 1792-1 et 1792-2 du présent code et à assumer la garantie prévue à l'article 1792-3.
""";
    content_hash "sha256:ce8cb5f9987b77affed16687b0cd9e54c5dae9c678108ff01c89bd46cf554e23";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1647")
pub fragment CC_ART1647 in CC_COURANT {
    label fr official "Article 1647";
    kind article;
    locator "article/1647";
    text fr official """Article 1647
Si la chose qui avait des vices a péri par suite de sa mauvaise qualité, la perte est pour le vendeur, qui sera tenu envers l'acheteur à la restitution du prix et aux autres dédommagements expliqués dans les deux articles précédents.
Mais la perte arrivée par cas fortuit sera pour le compte de l'acheteur.
""";
    content_hash "sha256:5c3aaa74602e9b364acb0ab21b740aa9fd98a3ad74e3311fd076370d574843a2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1648")
pub fragment CC_ART1648 in CC_COURANT {
    label fr official "Article 1648";
    kind article;
    locator "article/1648";
    text fr official """Article 1648
L'action résultant des vices rédhibitoires doit être intentée par l'acquéreur dans un délai de deux ans à compter de la découverte du vice.
Dans le cas prévu par l'article 1642-1, l'action doit être introduite, à peine de forclusion, dans l'année qui suit la date à laquelle le vendeur peut être déchargé des vices ou des défauts de conformité apparents.
""";
    content_hash "sha256:8772d0fda184a24826c80d148921dab97a25e2be18ea5b894f10542bd483cda9";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1649")
pub fragment CC_ART1649 in CC_COURANT {
    label fr official "Article 1649";
    kind article;
    locator "article/1649";
    text fr official """Article 1649
Elle n'a pas lieu dans les ventes faites par autorité de justice.
""";
    content_hash "sha256:7163b96096b023bd372e8277bcfce4d393e39578d72c9f3c3c76016f0273f229";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1650")
pub fragment CC_ART1650 in CC_COURANT {
    label fr official "Article 1650";
    kind article;
    locator "article/1650";
    text fr official """Article 1650
La principale obligation de l'acheteur est de payer le prix au jour et au lieu réglés par la vente.
""";
    content_hash "sha256:ad031311eba7138bee793f4a871e41e9b7e8a9b468f1420af53878c9ea874a85";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1651")
pub fragment CC_ART1651 in CC_COURANT {
    label fr official "Article 1651";
    kind article;
    locator "article/1651";
    text fr official """Article 1651
S'il n'a rien été réglé à cet égard lors de la vente, l'acheteur doit payer au lieu et dans le temps où doit se faire la délivrance.
""";
    content_hash "sha256:446a852576e59a1fecbaac14b785b2205a94e1b1dd70977e6ca15dcc2b661f5a";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1652")
pub fragment CC_ART1652 in CC_COURANT {
    label fr official "Article 1652";
    kind article;
    locator "article/1652";
    text fr official """Article 1652
L'acheteur doit l'intérêt du prix de la vente jusqu'au paiement du capital, dans les trois cas suivants :
S'il a été ainsi convenu lors de la vente ;
Si la chose vendue et livrée produit des fruits ou autres revenus ;
Si l'acheteur a été sommé de payer.
Dans ce dernier cas, l'intérêt ne court que depuis la sommation.
""";
    content_hash "sha256:440ac34a78f451e6e5f975e140b0dfc515cc28680b010a257a96ba8344a06552";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1653")
pub fragment CC_ART1653 in CC_COURANT {
    label fr official "Article 1653";
    kind article;
    locator "article/1653";
    text fr official """Article 1653
Si l'acheteur est troublé ou a juste sujet de craindre d'être troublé par une action, soit hypothécaire, soit en revendication, il peut suspendre le paiement du prix jusqu'à ce que le vendeur ait fait cesser le trouble, si mieux n'aime celui-ci donner caution, ou à moins qu'il n'ait été stipulé que, nonobstant le trouble, l'acheteur paiera.
""";
    content_hash "sha256:2e91acdec95cb516ee0636b54da2145d86c764fa8b8bc476444977a9e2281084";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1654")
pub fragment CC_ART1654 in CC_COURANT {
    label fr official "Article 1654";
    kind article;
    locator "article/1654";
    text fr official """Article 1654
Si l'acheteur ne paye pas le prix, le vendeur peut demander la résolution de la vente.
""";
    content_hash "sha256:c11c8ebbfd93785db81598e58b20835dc2950200cd6bedbc6728ed3cff18a2a7";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1655")
pub fragment CC_ART1655 in CC_COURANT {
    label fr official "Article 1655";
    kind article;
    locator "article/1655";
    text fr official """Article 1655
La résolution de la vente d'immeubles est prononcée aussitôt si le vendeur est en danger de perdre la chose et le prix.
Si ce danger n'existe pas, le juge peut accorder à l'acquéreur un délai plus ou moins long suivant les circonstances.
Ce délai passé sans que l'acquéreur ait payé, la résolution de la vente sera prononcée.
""";
    content_hash "sha256:b91df4b70a154987ad4f6127909b8b0f44567e32af2721a1e18fbfb77da335be";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1656")
pub fragment CC_ART1656 in CC_COURANT {
    label fr official "Article 1656";
    kind article;
    locator "article/1656";
    text fr official """Article 1656
S'il a été stipulé lors de la vente d'immeubles que, faute du paiement du prix dans le terme convenu, la vente serait résolue de plein droit, l'acquéreur peut néanmoins payer après l'expiration du délai, tant qu'il n'a pas été mis en demeure par une sommation ; mais, après cette sommation, le juge ne peut pas lui accorder ce délai.
""";
    content_hash "sha256:7b887620bd8458b977cc22c14a6d2b9f369b3adc2075af3c891673637ebb35c3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1657")
pub fragment CC_ART1657 in CC_COURANT {
    label fr official "Article 1657";
    kind article;
    locator "article/1657";
    text fr official """Article 1657
En matière de vente de denrées et effets mobiliers, la résolution de la vente aura lieu de plein droit et sans sommation, au profit du vendeur, après l'expiration du terme convenu pour le retirement.
""";
    content_hash "sha256:49de5b5ecbbab26ddc2450bc4214e62a4a38adb6bff428cb013d47b26252af89";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1658")
pub fragment CC_ART1658 in CC_COURANT {
    label fr official "Article 1658";
    kind article;
    locator "article/1658";
    text fr official """Article 1658
Indépendamment des causes de nullité ou de résolution déjà expliquées dans ce titre, et de celles qui sont communes à toutes les conventions, le contrat de vente peut être résolu par l'exercice de la faculté de rachat et par la vileté du prix.
""";
    content_hash "sha256:044f4a439322ae2a10d3a159fecab099d3bb41fbcf87b7638512928976471378";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1659")
pub fragment CC_ART1659 in CC_COURANT {
    label fr official "Article 1659";
    kind article;
    locator "article/1659";
    text fr official """Article 1659
La faculté de rachat est un pacte par lequel le vendeur se réserve de reprendre la chose vendue, moyennant la restitution du prix principal et le remboursement dont il est parlé à l'article 1673.
""";
    content_hash "sha256:581ea5396c0c051da36639ca025f98bbb395f75e4a2b36fee35822c543f8e315";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1660")
pub fragment CC_ART1660 in CC_COURANT {
    label fr official "Article 1660";
    kind article;
    locator "article/1660";
    text fr official """Article 1660
La faculté de rachat ne peut être stipulée pour un terme excédant cinq années.
Si elle a été stipulée pour un terme plus long, elle est réduite à ce terme.
""";
    content_hash "sha256:7dee98d08cc546ae5689b97074c7c44de990b9ab7504205487de45b1e1771a5b";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1661")
pub fragment CC_ART1661 in CC_COURANT {
    label fr official "Article 1661";
    kind article;
    locator "article/1661";
    text fr official """Article 1661
Le terme fixé est de rigueur et ne peut être prolongé par le juge.
""";
    content_hash "sha256:056d24d6311a5e9819a36e2a67a29ad95dadb2c5639ce52180c5bfc8162ca0c8";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1662")
pub fragment CC_ART1662 in CC_COURANT {
    label fr official "Article 1662";
    kind article;
    locator "article/1662";
    text fr official """Article 1662
Faute par le vendeur d'avoir exercé son action en rachat dans le terme prescrit, l'acquéreur demeure propriétaire irrévocable.
""";
    content_hash "sha256:818762b34931a7efe31a79bae07522b4151269187819e45f8de37bb4d090f4e5";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1663")
pub fragment CC_ART1663 in CC_COURANT {
    label fr official "Article 1663";
    kind article;
    locator "article/1663";
    text fr official """Article 1663
Le délai court contre toutes personnes, même contre le mineur, sauf, s'il y a lieu, le recours contre qui de droit.
""";
    content_hash "sha256:335e4a05ee03e45121ddc578ed54363b6f5e5b925ac6c3f61af88a14f2cbf559";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1664")
pub fragment CC_ART1664 in CC_COURANT {
    label fr official "Article 1664";
    kind article;
    locator "article/1664";
    text fr official """Article 1664
Le vendeur à pacte de rachat peut exercer son action contre un second acquéreur, quand même la faculté de rachat n'aurait pas été déclarée dans le second contrat.
""";
    content_hash "sha256:4ee55a019249d331c6e2864b6dcb0326c687d73ae6cf1545400886d89cd37cce";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1665")
pub fragment CC_ART1665 in CC_COURANT {
    label fr official "Article 1665";
    kind article;
    locator "article/1665";
    text fr official """Article 1665
L'acquéreur à pacte de rachat exerce tous les droits de son vendeur ; il peut prescrire tant contre le véritable maître que contre ceux qui prétendraient des droits ou hypothèques sur la chose vendue.
""";
    content_hash "sha256:32dfc715da6fb681e1e9342e2bc62f164166391eaffe96febb0aefc5d166c507";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1666")
pub fragment CC_ART1666 in CC_COURANT {
    label fr official "Article 1666";
    kind article;
    locator "article/1666";
    text fr official """Article 1666
Il peut opposer le bénéfice de la discussion aux créanciers de son vendeur.
""";
    content_hash "sha256:acb419f75db3b214dfb39f78fc35ee76aae14224303cd09f39228de62e89ac58";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1667")
pub fragment CC_ART1667 in CC_COURANT {
    label fr official "Article 1667";
    kind article;
    locator "article/1667";
    text fr official """Article 1667
Si l'acquéreur à pacte de rachat d'une partie indivise d'un héritage s'est rendu adjudicataire de la totalité sur une licitation provoquée contre lui, il peut obliger le vendeur à retirer le tout lorsque celui-ci veut user du pacte.
""";
    content_hash "sha256:f5ff4a156568374d2d281bf3b013134bd770fdb76538fabbcd3d56c9800a001c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1668")
pub fragment CC_ART1668 in CC_COURANT {
    label fr official "Article 1668";
    kind article;
    locator "article/1668";
    text fr official """Article 1668
Si plusieurs ont vendu conjointement, et par un seul contrat, un héritage commun entre eux, chacun ne peut exercer l'action en rachat que pour la part qu'il y avait.
""";
    content_hash "sha256:b8557397c65675a314b44cae867b4688413f37c0706f16e5ad3d59b104c6c485";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1669")
pub fragment CC_ART1669 in CC_COURANT {
    label fr official "Article 1669";
    kind article;
    locator "article/1669";
    text fr official """Article 1669
Il en est de même si celui qui a vendu seul un héritage a laissé plusieurs héritiers.
Chacun de ces cohéritiers ne peut user de la faculté de rachat que pour la part qu'il prend pour la succession.
""";
    content_hash "sha256:a14571fbb26b545bec2afe112e00e6aab85e10ecab49593003c470660d5fdb47";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1670")
pub fragment CC_ART1670 in CC_COURANT {
    label fr official "Article 1670";
    kind article;
    locator "article/1670";
    text fr official """Article 1670
Mais, dans le cas des deux articles précédents, l'acquéreur peut exiger que tous les covendeurs ou tous les cohéritiers soient mis en cause, afin de se concilier entre eux pour la reprise de l'héritage entier ; et, s'ils ne se concilient pas, il sera renvoyé de la demande.
""";
    content_hash "sha256:335f8772b8bb8ef3a5a7e819b5a426a61101ad2f66b2ad1d4ae17a213dfae872";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1671")
pub fragment CC_ART1671 in CC_COURANT {
    label fr official "Article 1671";
    kind article;
    locator "article/1671";
    text fr official """Article 1671
Si la vente d'un héritage appartenant à plusieurs n'a pas été faite conjointement et de tout l'héritage ensemble, et que chacun n'ait vendu que la part qu'il y avait, ils peuvent exercer séparément l'action en rachat sur la portion qui leur appartenait ;
Et l'acquéreur ne peut forcer celui qui l'exercera de cette manière à retirer le tout.
""";
    content_hash "sha256:aff47e3b8bf417be3ae975a2e5e88aca9f89e3fab448fe807a0f02536473607a";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1672")
pub fragment CC_ART1672 in CC_COURANT {
    label fr official "Article 1672";
    kind article;
    locator "article/1672";
    text fr official """Article 1672
Si l'acquéreur a laissé plusieurs héritiers, l'action en rachat ne peut être exercée contre chacun d'eux que pour sa part, dans le cas où elle est encore indivise, et dans celui où la chose vendue a été partagée entre eux.
Mais s'il y a eu partage de la succession et que la chose vendue soit échue au lot de l'un des héritiers, l'action en rachat peut être intentée contre lui pour le tout.
""";
    content_hash "sha256:daf947eb4cd2425d2c9a7a42430f111ae2340f517103b6fb9eda2737384b616d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1673")
pub fragment CC_ART1673 in CC_COURANT {
    label fr official "Article 1673";
    kind article;
    locator "article/1673";
    text fr official """Article 1673
Le vendeur qui use du pacte de rachat doit rembourser non seulement le prix principal, mais encore les frais et loyaux coûts de la vente, les réparations nécessaires, et celles qui ont augmenté la valeur du fonds, jusqu'à concurrence de cette augmentation. Il ne peut entrer en possession qu'après avoir satisfait à toutes ces obligations.
Lorsque le vendeur rentre dans son héritage par l'effet du pacte de rachat, il le reprend, exempt de toutes les charges et hypothèques dont l'acquéreur l'aurait grevé, à la condition que ce pacte ait été régulièrement publié au fichier immobilier, antérieurement à la publication desdites charges et hypothèques. Il est tenu d'exécuter les baux faits sans fraude par l'acquéreur.
""";
    content_hash "sha256:0b8e6d19358f210afcd799abb7d8ce0564751c5b20a4a982c0ba5d32e2fa14ac";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1674")
pub fragment CC_ART1674 in CC_COURANT {
    label fr official "Article 1674";
    kind article;
    locator "article/1674";
    text fr official """Article 1674
Si le vendeur a été lésé de plus de sept douzièmes dans le prix d'un immeuble, il a le droit de demander la rescision de la vente, quand même il aurait expressément renoncé dans le contrat à la faculté de demander cette rescision, et qu'il aurait déclaré donner la plus-value.
""";
    content_hash "sha256:8de300de78c2ff0d94842f9286717d2eb0ea8a7991852acb41f42ed760a62b32";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1675")
pub fragment CC_ART1675 in CC_COURANT {
    label fr official "Article 1675";
    kind article;
    locator "article/1675";
    text fr official """Article 1675
Pour savoir s'il y a lésion de plus de sept douzièmes, il faut estimer l'immeuble suivant son état et sa valeur au moment de la vente.
En cas de promesse de vente unilatérale, la lésion s'apprécie au jour de la réalisation.
""";
    content_hash "sha256:b0261eb8d6ec820ebbc30d807f5d8302abb9cda88f0abac7369bc2f6c6cbe416";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1676")
pub fragment CC_ART1676 in CC_COURANT {
    label fr official "Article 1676";
    kind article;
    locator "article/1676";
    text fr official """Article 1676
La demande n'est plus recevable après l'expiration de deux années, à compter du jour de la vente.
Ce délai court et n'est pas suspendu pendant la durée du temps stipulé pour le pacte du rachat.
""";
    content_hash "sha256:7d54ad55474f5dcf12835b83de750be66416c9ef10bb465a1ad36e1adbb8d755";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1677")
pub fragment CC_ART1677 in CC_COURANT {
    label fr official "Article 1677";
    kind article;
    locator "article/1677";
    text fr official """Article 1677
La preuve de la lésion ne pourra être admise que par jugement, et dans le cas seulement où les faits articulés seraient assez vraisemblables et assez graves pour faire présumer la lésion.
""";
    content_hash "sha256:7cb52805dd56c5f09616205f5341a788994be088432bd974c29d4a7ab935e415";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1678")
pub fragment CC_ART1678 in CC_COURANT {
    label fr official "Article 1678";
    kind article;
    locator "article/1678";
    text fr official """Article 1678
Cette preuve ne pourra se faire que par un rapport de trois experts, qui seront tenus de dresser un seul procès-verbal commun, et de ne former qu'un seul avis à la pluralité des voix.
""";
    content_hash "sha256:bd7efad07508d99fbd0c6225829fd9d62c5061992a2331a2dbec5c30a7eceb93";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1679")
pub fragment CC_ART1679 in CC_COURANT {
    label fr official "Article 1679";
    kind article;
    locator "article/1679";
    text fr official """Article 1679
S'il y a des avis différents, le procès-verbal en contiendra les motifs, sans qu'il soit permis de faire connaître de quel avis chaque expert a été.
""";
    content_hash "sha256:23192545079d7017f6ad35566497717e977a1d3eebb50ea9fbc74fe118609369";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1680")
pub fragment CC_ART1680 in CC_COURANT {
    label fr official "Article 1680";
    kind article;
    locator "article/1680";
    text fr official """Article 1680
Les trois experts seront nommés d'office, à moins que les parties ne se soient accordées pour les nommer tous les trois conjointement.
""";
    content_hash "sha256:d6a734fe56b37ee0830ac2bf0c0a36760ae2a560c8c1892ecbb16527592fdcb6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1681")
pub fragment CC_ART1681 in CC_COURANT {
    label fr official "Article 1681";
    kind article;
    locator "article/1681";
    text fr official """Article 1681
Dans le cas où l'action en rescision est admise, l'acquéreur a le choix ou de rendre la chose en retirant le prix qu'il en a payé, ou de garder le fonds en payant le supplément du juste prix, sous la déduction du dixième du prix total.
Le tiers possesseur a le même droit, sauf sa garantie contre son vendeur.
""";
    content_hash "sha256:2aa4d0e7219cd53a4118e4d82de76f5aab891b5174dbcbfb79819496093127ae";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1682")
pub fragment CC_ART1682 in CC_COURANT {
    label fr official "Article 1682";
    kind article;
    locator "article/1682";
    text fr official """Article 1682
Si l'acquéreur préfère garder la chose en fournissant le supplément réglé par l'article précédent, il doit l'intérêt du supplément, du jour de la demande en rescision.
S'il préfère la rendre et recevoir le prix, il rend les fruits du jour de la demande.
L'intérêt du prix qu'il a payé lui est aussi compté du jour de la même demande, ou du jour du paiement, s'il n'a touché aucuns fruits.
""";
    content_hash "sha256:a193d122031851a0685e31fdc910c5b06ced1d24f95a4b33a400a4e5c173d0d0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1683")
pub fragment CC_ART1683 in CC_COURANT {
    label fr official "Article 1683";
    kind article;
    locator "article/1683";
    text fr official """Article 1683
La rescision pour lésion n'a pas lieu en faveur de l'acheteur.
""";
    content_hash "sha256:0d023efe6d45c0d1e4b06a05c83a0b78b0447d4db58c5dbd4e98a64dc8e2adc9";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1684")
pub fragment CC_ART1684 in CC_COURANT {
    label fr official "Article 1684";
    kind article;
    locator "article/1684";
    text fr official """Article 1684
Elle n'a pas lieu en toutes ventes qui, d'après la loi, ne peuvent être faites que d'autorité de justice.
""";
    content_hash "sha256:7d9c918cbfd11d36cdaa9096fc3ed96bc07a457c8298f753cc02e9b9b39b4be6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1685")
pub fragment CC_ART1685 in CC_COURANT {
    label fr official "Article 1685";
    kind article;
    locator "article/1685";
    text fr official """Article 1685
Les règles expliquées dans la section précédente pour les cas où plusieurs ont vendu conjointement ou séparément, et pour celui où le vendeur ou l'acheteur a laissé plusieurs héritiers, sont pareillement observées pour l'exercice de l'action en rescision.
""";
    content_hash "sha256:b95c38d102fe6a39d24ce99e7e862daa0e54fcf636b171dc2c23e2048cfeab60";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1686")
pub fragment CC_ART1686 in CC_COURANT {
    label fr official "Article 1686";
    kind article;
    locator "article/1686";
    text fr official """Article 1686
Si une chose commune à plusieurs ne peut être partagée commodément et sans perte ;
Ou si, dans un partage fait de gré à gré de biens communs, il s'en trouve quelques-uns qu'aucun des copartageants ne puisse ou ne veuille prendre,
La vente s'en fait aux enchères, et le prix en est partagé entre les copropriétaires.
""";
    content_hash "sha256:9b7f0e8e9805096a0aacf91e1b354f36316a0639b60f2051f72d9669abeb4976";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1687")
pub fragment CC_ART1687 in CC_COURANT {
    label fr official "Article 1687";
    kind article;
    locator "article/1687";
    text fr official """Article 1687
Chacun des copropriétaires est le maître de demander que les étrangers soient appelés à la licitation : ils sont nécessairement appelés, lorsque l'un des copropriétaires est mineur.
""";
    content_hash "sha256:521292ef99352b863dd7ee66e69e7681381d7df8ae54fd0b94018ce92ed91e80";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1688")
pub fragment CC_ART1688 in CC_COURANT {
    label fr official "Article 1688";
    kind article;
    locator "article/1688";
    text fr official """Article 1688
Le mode et les formalités à observer pour la licitation sont expliqués au titre " Des successions " et au code de procédure.
""";
    content_hash "sha256:14cdef9d5eb4cbebdca555728f7b445acbeeecc41fbf4f5ca96a6b0dba5daeba";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1689")
pub fragment CC_ART1689 in CC_COURANT {
    label fr official "Article 1689";
    kind article;
    locator "article/1689";
    text fr official """Article 1689
Dans le transport d'un droit ou d'une action sur un tiers, la délivrance s'opère entre le cédant et le cessionnaire par la remise du titre.
""";
    content_hash "sha256:ab5641068ef06cf4f34ad12be581a471a7754d9cb425dcd0a1a43c12645acb04";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1690")
pub fragment CC_ART1690 in CC_COURANT {
    label fr official "Article 1690";
    kind article;
    locator "article/1690";
    text fr official """Article 1690
Le cessionnaire n'est saisi à l'égard des tiers que par la signification du transport faite au débiteur.
Néanmoins, le cessionnaire peut être également saisi par l'acceptation du transport faite par le débiteur dans un acte authentique.
""";
    content_hash "sha256:19a9c4f42a5cf63d31265745a6f037e2106981c1c545f8779282b93a4e2d0a90";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1691")
pub fragment CC_ART1691 in CC_COURANT {
    label fr official "Article 1691";
    kind article;
    locator "article/1691";
    text fr official """Article 1691
Si, avant que le cédant ou le cessionnaire eût signifié le transport au débiteur, celui-ci avait payé le cédant, il sera valablement libéré.
""";
    content_hash "sha256:52557138ff0a5c8118a87d94be5efde9cbf20c1abf0a81507f7ea807767d3433";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1693")
pub fragment CC_ART1693 in CC_COURANT {
    label fr official "Article 1693";
    kind article;
    locator "article/1693";
    text fr official """Article 1693
Celui qui vend un droit incorporel doit en garantir l'existence au temps du transport, quoiqu'il soit fait sans garantie.
""";
    content_hash "sha256:73f065e698c5ad8d1f88cca8c4c8aad963d00900041b334d1e93c871226dc110";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1696")
pub fragment CC_ART1696 in CC_COURANT {
    label fr official "Article 1696";
    kind article;
    locator "article/1696";
    text fr official """Article 1696
Celui qui vend une succession sans en spécifier en détail les objets n'est tenu de garantir que sa qualité d'héritier.
""";
    content_hash "sha256:5f2c0b9b96b589013c73f2d9eae2153b9ea8ae5225492abe499f01453533cd34";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1697")
pub fragment CC_ART1697 in CC_COURANT {
    label fr official "Article 1697";
    kind article;
    locator "article/1697";
    text fr official """Article 1697
S'il avait déjà profité des fruits de quelque fonds, ou reçu le montant de quelque créance appartenant à cette succession, ou vendu quelques effets de la succession, il est tenu de les rembourser à l'acquéreur, s'il ne les a expressément réservés lors de la vente.
""";
    content_hash "sha256:f65f3639d410231c33acc01799d101789b9d68d840ecb554694cca9778a94788";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1698")
pub fragment CC_ART1698 in CC_COURANT {
    label fr official "Article 1698";
    kind article;
    locator "article/1698";
    text fr official """Article 1698
L'acquéreur doit de son côté rembourser au vendeur ce que celui-ci a payé pour les dettes et charges de la succession, et lui faire raison de tout ce dont il était créancier, s'il n'y a stipulation contraire.
""";
    content_hash "sha256:ae8c41e4ec79000462c1b66f57b80c213ab891734ce20966f659285d7312a44e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1699")
pub fragment CC_ART1699 in CC_COURANT {
    label fr official "Article 1699";
    kind article;
    locator "article/1699";
    text fr official """Article 1699
Celui contre lequel on a cédé un droit litigieux peut s'en faire tenir quitte par le cessionnaire, en lui remboursant le prix réel de la cession avec les frais et loyaux coûts, et avec les intérêts à compter du jour où le cessionnaire a payé le prix de la cession à lui faite.
""";
    content_hash "sha256:c215aef71acfbd2efa2feb67485c9033d2b8b0053f492de162598860bd876d64";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1700")
pub fragment CC_ART1700 in CC_COURANT {
    label fr official "Article 1700";
    kind article;
    locator "article/1700";
    text fr official """Article 1700
La chose est censée litigieuse dès qu'il y a procès et contestation sur le fond du droit.
""";
    content_hash "sha256:b76b5fd11de0483bb7e3dad1540188fd7a64b368f7dd6aa643d78ade585188bf";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1701")
pub fragment CC_ART1701 in CC_COURANT {
    label fr official "Article 1701";
    kind article;
    locator "article/1701";
    text fr official """Article 1701
La disposition portée en l'article 1699 cesse :
1° Dans le cas où la cession a été faite à un cohéritier ou copropriétaire du droit cédé ;
2° Lorsqu'elle a été faite à un créancier en paiement de ce qui lui est dû ;
3° Lorsqu'elle a été faite au possesseur de l'héritage sujet au droit litigieux.
""";
    content_hash "sha256:6f2b808dd1a2cff43b635e66a71e687d07e98b8f71fca1332cbf042673d8b636";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1701_1")
pub fragment CC_ART1701_1 in CC_COURANT {
    label fr official "Article 1701-1";
    kind article;
    locator "article/1701-1";
    text fr official """Article 1701-1
Les articles 1689 à 1691 et 1693 ne s'appliquent pas aux cessions régies par les articles 1321 à 1326 du présent code.
""";
    content_hash "sha256:818854dc782afd1f64e22737af2cf3865577ff12839a128a81a83ec71277b35c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1702")
pub fragment CC_ART1702 in CC_COURANT {
    label fr official "Article 1702";
    kind article;
    locator "article/1702";
    text fr official """Article 1702
L'échange est un contrat par lequel les parties se donnent respectivement une chose pour une autre.
""";
    content_hash "sha256:b067af07ddad459829e5a47dc8146d6b4058c8c87743cc8369e741f26cbc45bc";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1703")
pub fragment CC_ART1703 in CC_COURANT {
    label fr official "Article 1703";
    kind article;
    locator "article/1703";
    text fr official """Article 1703
L'échange s'opère par le seul consentement, de la même manière que la vente.
""";
    content_hash "sha256:65064c50947c36769e393e3d24375b22ffedaa4f4241d335bd997490fac6ebd2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1704")
pub fragment CC_ART1704 in CC_COURANT {
    label fr official "Article 1704";
    kind article;
    locator "article/1704";
    text fr official """Article 1704
Si l'un des copermutants a déjà reçu la chose à lui donnée en échange, et qu'il prouve ensuite que l'autre contractant n'est pas propriétaire de cette chose, il ne peut pas être forcé à livrer celle qu'il a promise en contre-échange, mais seulement à rendre celle qu'il a reçue.
""";
    content_hash "sha256:b04e181e5298166e856e607e44b20b950c0e828f259094c9ccea5b83ff56ffd6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1705")
pub fragment CC_ART1705 in CC_COURANT {
    label fr official "Article 1705";
    kind article;
    locator "article/1705";
    text fr official """Article 1705
Le copermutant qui est évincé de la chose qu'il a reçue en échange a le choix de conclure à des dommages et intérêts ou de répéter sa chose.
""";
    content_hash "sha256:b50f2fcc960855863305397d1103f386a847ab6937f96d1c28ec6b05bdf783a0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1706")
pub fragment CC_ART1706 in CC_COURANT {
    label fr official "Article 1706";
    kind article;
    locator "article/1706";
    text fr official """Article 1706
La rescision pour cause de lésion n'a pas lieu dans le contrat d'échange.
""";
    content_hash "sha256:2f1f87b22586e8046bc853296458ce871d9d029b025fbd6d8dd19cf481988b6c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1707")
pub fragment CC_ART1707 in CC_COURANT {
    label fr official "Article 1707";
    kind article;
    locator "article/1707";
    text fr official """Article 1707
Toutes les autres règles prescrites pour le contrat de vente s'appliquent d'ailleurs à l'échange.
""";
    content_hash "sha256:d72c9fdd03ba64b22d16460ab05ad15f593dbcd18b79e19bab8b363afd39604c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1708")
pub fragment CC_ART1708 in CC_COURANT {
    label fr official "Article 1708";
    kind article;
    locator "article/1708";
    text fr official """Article 1708
Il y a deux sortes de contrats de louage :
Celui des choses,
Et celui d'ouvrage.
""";
    content_hash "sha256:a82fb14825738a3055de0fe94b799b4a4018674c44f65cb93e362571a0db27d7";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1709")
pub fragment CC_ART1709 in CC_COURANT {
    label fr official "Article 1709";
    kind article;
    locator "article/1709";
    text fr official """Article 1709
Le louage des choses est un contrat par lequel l'une des parties s'oblige à faire jouir l'autre d'une chose pendant un certain temps, et moyennant un certain prix que celle-ci s'oblige de lui payer.
""";
    content_hash "sha256:72154efdb013c5e1e2d3a7d93670e77fd386f7330cae548f88c082edf00caec3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1710")
pub fragment CC_ART1710 in CC_COURANT {
    label fr official "Article 1710";
    kind article;
    locator "article/1710";
    text fr official """Article 1710
Le louage d'ouvrage est un contrat par lequel l'une des parties s'engage à faire quelque chose pour l'autre, moyennant un prix convenu entre elles.
""";
    content_hash "sha256:398cc3dad3ebab14163e8167de55f4d80e0b3ef55d41bdb350b6723db0a8a404";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1711")
pub fragment CC_ART1711 in CC_COURANT {
    label fr official "Article 1711";
    kind article;
    locator "article/1711";
    text fr official """Article 1711
Ces deux genres de louage se subdivisent encore en plusieurs espèces particulières :
On appelle " bail à loyer ", le louage des maisons et celui des meubles ;
" Bail à ferme ", celui des héritages ruraux ;
" Loyer ", le louage du travail ou du service ;
" Bail à cheptel ", celui des animaux dont le profit se partage entre le propriétaire et celui à qui il les confie.
Les devis, marché ou prix fait, pour l'entreprise d'un ouvrage moyennant un prix déterminé, sont aussi un louage, lorsque la matière est fournie par celui pour qui l'ouvrage se fait.
Ces trois dernières espèces ont des règles particulières.
""";
    content_hash "sha256:423a401ddcae424f535154660c4151b7f2254f10bcc8834c861e273beaad6951";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1712")
pub fragment CC_ART1712 in CC_COURANT {
    label fr official "Article 1712";
    kind article;
    locator "article/1712";
    text fr official """Article 1712
Les baux des biens nationaux, des biens des communes et des établissements publics sont soumis à des règlements particuliers.
""";
    content_hash "sha256:c037c376af2b63cb6eb7bd37ac2b6081b79df9e7e9fa60860565fe3c74ad368c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1713")
pub fragment CC_ART1713 in CC_COURANT {
    label fr official "Article 1713";
    kind article;
    locator "article/1713";
    text fr official """Article 1713
On peut louer toutes sortes de biens meubles ou immeubles.
""";
    content_hash "sha256:b0e0f66183c7a882225f6142d26fde68a28361d44f4120b4f13936d5d53f1316";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1714")
pub fragment CC_ART1714 in CC_COURANT {
    label fr official "Article 1714";
    kind article;
    locator "article/1714";
    text fr official """Article 1714
On peut louer ou par écrit ou verbalement, sauf, en ce qui concerne les biens ruraux, application des règles particulières aux baux à ferme et à métayage.
""";
    content_hash "sha256:a4a5170666e34f18aee5485f6fd07d4c950da7ba36af8cd9ffe3d0bfa093117c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1715")
pub fragment CC_ART1715 in CC_COURANT {
    label fr official "Article 1715";
    kind article;
    locator "article/1715";
    text fr official """Article 1715
Si le bail fait sans écrit n'a encore reçu aucune exécution, et que l'une des parties le nie, la preuve ne peut être reçue par témoins, quelque modique qu'en soit le prix, et quoiqu'on allègue qu'il y a eu des arrhes données.
Le serment peut seulement être déféré à celui qui nie le bail.
""";
    content_hash "sha256:fd0c4e01ff78460db91722aae2975f998f9cd6eebbde9987b294fbdb24388b22";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1716")
pub fragment CC_ART1716 in CC_COURANT {
    label fr official "Article 1716";
    kind article;
    locator "article/1716";
    text fr official """Article 1716
Lorsqu'il y aura contestation sur le prix du bail verbal dont l'exécution a commencé, et qu'il n'existera point de quittance, le propriétaire en sera cru sur son serment, si mieux n'aime le locataire demander l'estimation par experts ; auquel cas les frais de l'expertise restent à sa charge, si l'estimation excède le prix qu'il a déclaré.
""";
    content_hash "sha256:e2f7f26a3b97dd53901d9ab9647d329cd052fab31ae9c748922056a39acced83";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1717")
pub fragment CC_ART1717 in CC_COURANT {
    label fr official "Article 1717";
    kind article;
    locator "article/1717";
    text fr official """Article 1717
Le preneur a le droit de sous-louer, et même de céder son bail à un autre, si cette faculté ne lui a pas été interdite.
Elle peut être interdite pour le tout ou partie.
Cette clause est toujours de rigueur.
""";
    content_hash "sha256:fb7b706534d8fa101efe8b93e0662f90f9df33e92c1bc6230eeeace917bd0d94";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1718")
pub fragment CC_ART1718 in CC_COURANT {
    label fr official "Article 1718";
    kind article;
    locator "article/1718";
    text fr official """Article 1718
Les dispositions des deuxième et troisième alinéas de l'article 595 relatif aux baux passés par les usufruitiers sont applicables aux baux passés par le tuteur sans l'autorisation du conseil de famille.
""";
    content_hash "sha256:f5dac838997932163ff47565a521ae707d745f9f705c94326e63fffc7279be75";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1719")
pub fragment CC_ART1719 in CC_COURANT {
    label fr official "Article 1719";
    kind article;
    locator "article/1719";
    text fr official """Article 1719
Le bailleur est obligé, par la nature du contrat, et sans qu'il soit besoin d'aucune stipulation particulière :
1° De délivrer au preneur la chose louée et, s'il s'agit de son habitation principale, un logement décent. Lorsque des locaux loués à usage d'habitation sont impropres à cet usage, le bailleur ne peut se prévaloir de la nullité du bail ou de sa résiliation pour demander l'expulsion de l'occupant ;
2° D'entretenir cette chose en état de servir à l'usage pour lequel elle a été louée ;
3° D'en faire jouir paisiblement le preneur pendant la durée du bail ;
4° D'assurer également la permanence et la qualité des plantations.
""";
    content_hash "sha256:bf2f0d0d575c2f400e56fb8e4e8c55355a6b9869f275a5a41038ec60abbcb472";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1720")
pub fragment CC_ART1720 in CC_COURANT {
    label fr official "Article 1720";
    kind article;
    locator "article/1720";
    text fr official """Article 1720
Le bailleur est tenu de délivrer la chose en bon état de réparations de toute espèce.
Il doit y faire, pendant la durée du bail, toutes les réparations qui peuvent devenir nécessaires, autres que les locatives.
""";
    content_hash "sha256:405274007be40cf7f925d5674c4f69d2808ffab5da105f943d7c198266f208c0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1721")
pub fragment CC_ART1721 in CC_COURANT {
    label fr official "Article 1721";
    kind article;
    locator "article/1721";
    text fr official """Article 1721
Il est dû garantie au preneur pour tous les vices ou défauts de la chose louée qui en empêchent l'usage, quand même le bailleur ne les aurait pas connus lors du bail.
S'il résulte de ces vices ou défauts quelque perte pour le preneur, le bailleur est tenu de l'indemniser.
""";
    content_hash "sha256:06349bc99cddf5cb5e2be249256984d0fd674b28a4f1d828b57c997ccc8456fa";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1722")
pub fragment CC_ART1722 in CC_COURANT {
    label fr official "Article 1722";
    kind article;
    locator "article/1722";
    text fr official """Article 1722
Si, pendant la durée du bail, la chose louée est détruite en totalité par cas fortuit, le bail est résilié de plein droit ; si elle n'est détruite qu'en partie, le preneur peut, suivant les circonstances, demander ou une diminution du prix, ou la résiliation même du bail. Dans l'un et l'autre cas, il n'y a lieu à aucun dédommagement.
""";
    content_hash "sha256:9fe6b8c124ce521f8b92438dd8d5b201f51621c9ed3c365130b88ab51d427996";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1723")
pub fragment CC_ART1723 in CC_COURANT {
    label fr official "Article 1723";
    kind article;
    locator "article/1723";
    text fr official """Article 1723
Le bailleur ne peut, pendant la durée du bail, changer la forme de la chose louée.
""";
    content_hash "sha256:2c93b5315636a457e3f7ca481aeb56426027eebac554ccfaa712c8d66a335964";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1724")
pub fragment CC_ART1724 in CC_COURANT {
    label fr official "Article 1724";
    kind article;
    locator "article/1724";
    text fr official """Article 1724
Si, durant le bail, la chose louée a besoin de réparations urgentes et qui ne puissent être différées jusqu'à sa fin, le preneur doit les souffrir, quelque incommodité qu'elles lui causent, et quoiqu'il soit privé, pendant qu'elles se font, d'une partie de la chose louée.
Mais, si ces réparations durent plus de vingt et un jours, le prix du bail sera diminué à proportion du temps et de la partie de la chose louée dont il aura été privé.
Si les réparations sont de telle nature qu'elles rendent inhabitable ce qui est nécessaire au logement du preneur et de sa famille, celui-ci pourra faire résilier le bail.
""";
    content_hash "sha256:5a58f1db2376015945cea732fc156311dfb1198e5d682f4e11e1a3fae7c04928";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1725")
pub fragment CC_ART1725 in CC_COURANT {
    label fr official "Article 1725";
    kind article;
    locator "article/1725";
    text fr official """Article 1725
Le bailleur n'est pas tenu de garantir le preneur du trouble que des tiers apportent par voies de fait à sa jouissance, sans prétendre d'ailleurs aucun droit sur la chose louée ; sauf au preneur à les poursuivre en son nom personnel.
""";
    content_hash "sha256:27dc01a735c3e1b046e7048911d3c9a617e938e2f4d24687abb1c3ad4bec9d41";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1726")
pub fragment CC_ART1726 in CC_COURANT {
    label fr official "Article 1726";
    kind article;
    locator "article/1726";
    text fr official """Article 1726
Si, au contraire, le locataire ou le fermier ont été troublés dans leur jouissance par suite d'une action concernant la propriété du fonds, ils ont droit à une diminution proportionnée sur le prix du bail à loyer ou à ferme, pourvu que le trouble et l'empêchement aient été dénoncés au propriétaire.
""";
    content_hash "sha256:b590df47d7baea850656e870cea9bcb248be37684648910720cad7b6876eb7f4";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1727")
pub fragment CC_ART1727 in CC_COURANT {
    label fr official "Article 1727";
    kind article;
    locator "article/1727";
    text fr official """Article 1727
Si ceux qui ont commis les voies de fait, prétendent avoir quelque droit sur la chose louée, ou si le preneur est lui-même cité en justice pour se voir condamner au délaissement de la totalité ou de partie de cette chose, ou à souffrir l'exercice de quelque servitude, il doit appeler le bailleur en garantie, et doit être mis hors d'instance, s'il l'exige, en nommant le bailleur pour lequel il possède.
""";
    content_hash "sha256:61ef5f65b0b8fedeb11e9a41e38e5ee056684a39547a8723eb0b288354f12a83";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1728")
pub fragment CC_ART1728 in CC_COURANT {
    label fr official "Article 1728";
    kind article;
    locator "article/1728";
    text fr official """Article 1728
Le preneur est tenu de deux obligations principales :
1° D'user de la chose louée raisonnablement, et suivant la destination qui lui a été donnée par le bail, ou suivant celle présumée d'après les circonstances, à défaut de convention ;
2° De payer le prix du bail aux termes convenus.
""";
    content_hash "sha256:40e51e66313a2b81663a4d1e54436eaf2d857d857359986683d4b7564ff23f51";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1729")
pub fragment CC_ART1729 in CC_COURANT {
    label fr official "Article 1729";
    kind article;
    locator "article/1729";
    text fr official """Article 1729
Si le preneur n'use pas de la chose louée raisonnablement ou emploie la chose louée à un autre usage que celui auquel elle a été destinée, ou dont il puisse résulter un dommage pour le bailleur, celui-ci peut, suivant les circonstances, faire résilier le bail.
""";
    content_hash "sha256:045b2add2724cc958c99bcad09a77ceb3027770db151aba3116ab34d80264b1e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1730")
pub fragment CC_ART1730 in CC_COURANT {
    label fr official "Article 1730";
    kind article;
    locator "article/1730";
    text fr official """Article 1730
S'il a été fait un état des lieux entre le bailleur et le preneur, celui-ci doit rendre la chose telle qu'il l'a reçue, suivant cet état, excepté ce qui a péri ou a été dégradé par vétusté ou force majeure.
""";
    content_hash "sha256:a4e82e829078b1181dee5c801c27db8c7a2d0cb390180bcb35866edf214e75ad";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1731")
pub fragment CC_ART1731 in CC_COURANT {
    label fr official "Article 1731";
    kind article;
    locator "article/1731";
    text fr official """Article 1731
S'il n'a pas été fait d'état des lieux, le preneur est présumé les avoir reçus en bon état de réparations locatives, et doit les rendre tels, sauf la preuve contraire.
""";
    content_hash "sha256:716fb3d6323306ce63cab0f848459277bc718111297facdd59e37ab5ae254080";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1732")
pub fragment CC_ART1732 in CC_COURANT {
    label fr official "Article 1732";
    kind article;
    locator "article/1732";
    text fr official """Article 1732
Il répond des dégradations ou des pertes qui arrivent pendant sa jouissance, à moins qu'il ne prouve qu'elles ont eu lieu sans sa faute.
""";
    content_hash "sha256:688a2f7043857271ca3693711951f0a784dd32e4656875ca30b162190f110b69";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1733")
pub fragment CC_ART1733 in CC_COURANT {
    label fr official "Article 1733";
    kind article;
    locator "article/1733";
    text fr official """Article 1733
Il répond de l'incendie, à moins qu'il ne prouve :
Que l'incendie est arrivé par cas fortuit ou force majeure, ou par vice de construction.
Ou que le feu a été communiqué par une maison voisine.
""";
    content_hash "sha256:ce394667f37a8200a01b9807c5d148db68b293dc0689c902b2de168e52be1bf8";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1734")
pub fragment CC_ART1734 in CC_COURANT {
    label fr official "Article 1734";
    kind article;
    locator "article/1734";
    text fr official """Article 1734
S'il y a plusieurs locataires, tous sont responsables de l'incendie, proportionnellement à la valeur locative de la partie de l'immeuble qu'ils occupent ;
A moins qu'ils ne prouvent que l'incendie a commencé dans l'habitation de l'un d'eux, auquel cas celui-là seul en est tenu ;
Ou que quelques-uns ne prouvent que l'incendie n'a pu commencer chez eux, auquel cas ceux-là n'en sont pas tenus.
""";
    content_hash "sha256:95b563824b1b401b2b30b03a09f89e3e17efd7265dae7df57e822b5e10ca35d4";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1735")
pub fragment CC_ART1735 in CC_COURANT {
    label fr official "Article 1735";
    kind article;
    locator "article/1735";
    text fr official """Article 1735
Le preneur est tenu des dégradations et des pertes qui arrivent par le fait des personnes de sa maison ou de ses sous-locataires.
""";
    content_hash "sha256:77e451127cf9d1ab9bcf6b59078686f2d7d985d0a65c13e8ccb5b767da7cd731";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1736")
pub fragment CC_ART1736 in CC_COURANT {
    label fr official "Article 1736";
    kind article;
    locator "article/1736";
    text fr official """Article 1736
Si le bail a été fait sans écrit, l'une des parties ne pourra donner congé à l'autre qu'en observant les délais fixés par l'usage des lieux.
""";
    content_hash "sha256:e188355526eda9fb1c3c3b4ea80649c8aa9b38e709d5af71097133537df3776f";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1737")
pub fragment CC_ART1737 in CC_COURANT {
    label fr official "Article 1737";
    kind article;
    locator "article/1737";
    text fr official """Article 1737
Le bail cesse de plein droit à l'expiration du terme fixé, lorsqu'il a été fait par écrit, sans qu'il soit nécessaire de donner congé.
""";
    content_hash "sha256:c94f4aee3a532cd79794a6917c8773f5027a2ab0b88e9d57441220032a7e8196";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1738")
pub fragment CC_ART1738 in CC_COURANT {
    label fr official "Article 1738";
    kind article;
    locator "article/1738";
    text fr official """Article 1738
Si, à l'expiration des baux écrits, le preneur reste et est laissé en possession, il s'opère un nouveau bail dont l'effet est réglé par l'article relatif aux locations faites sans écrit.
""";
    content_hash "sha256:ae05b02f1948214342e5c8470c346ccbc85403ab2969f0f2bf5a432dcab2e271";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1739")
pub fragment CC_ART1739 in CC_COURANT {
    label fr official "Article 1739";
    kind article;
    locator "article/1739";
    text fr official """Article 1739
Lorsqu'il y a un congé signifié, le preneur quoiqu'il ait continué sa jouissance, ne peut invoquer la tacite reconduction.
""";
    content_hash "sha256:f8fc649050ea06550dca3a3cd75942b88077a70565332c3c88c3f1de9029a014";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1740")
pub fragment CC_ART1740 in CC_COURANT {
    label fr official "Article 1740";
    kind article;
    locator "article/1740";
    text fr official """Article 1740
Dans le cas des deux articles précédents, la caution donnée pour le bail ne s'étend pas aux obligations résultant de la prolongation.
""";
    content_hash "sha256:750b61d17880003e35d409019e78d357a8f89946dba4690d3d35789eb80f2487";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1741")
pub fragment CC_ART1741 in CC_COURANT {
    label fr official "Article 1741";
    kind article;
    locator "article/1741";
    text fr official """Article 1741
Le contrat de louage se résout par la perte de la chose louée, et par le défaut respectif du bailleur et du preneur de remplir leurs engagements.
""";
    content_hash "sha256:2dc5b37d9fc8df068e5f02c66ed22b32999959fa09a7c955816bf6e6cecfd3ab";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1742")
pub fragment CC_ART1742 in CC_COURANT {
    label fr official "Article 1742";
    kind article;
    locator "article/1742";
    text fr official """Article 1742
Le contrat de louage n'est point résolu par la mort du bailleur ni par celle du preneur.
""";
    content_hash "sha256:74d8c31e0de576c81b297f2cfdf86221dd223ff3f34c05b9f0ef56de9f239595";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1743")
pub fragment CC_ART1743 in CC_COURANT {
    label fr official "Article 1743";
    kind article;
    locator "article/1743";
    text fr official """Article 1743
Si le bailleur vend la chose louée, l'acquéreur ne peut expulser le fermier, le métayer ou le locataire qui a un bail authentique ou dont la date est certaine.
Il peut, toutefois, expulser le locataire de biens non ruraux s'il s'est réservé ce droit par le contrat de bail.
""";
    content_hash "sha256:e3ebf7c9ee8453e0bbdc5c8750fc814c8c07ab89af24c0a38510efa61ee196f3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1744")
pub fragment CC_ART1744 in CC_COURANT {
    label fr official "Article 1744";
    kind article;
    locator "article/1744";
    text fr official """Article 1744
S'il a été convenu lors du bail qu'en cas de vente l'acquéreur pourrait expulser le locataire et qu'il n'ait été fait aucune stipulation sur les dommages-intérêts, le bailleur est tenu d'indemniser le locataire de la manière suivante.
""";
    content_hash "sha256:4b153f7962bf3f7150b25c4bb5e1302775782ea7b3c8c38a75c182a08cd0c4ba";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1745")
pub fragment CC_ART1745 in CC_COURANT {
    label fr official "Article 1745";
    kind article;
    locator "article/1745";
    text fr official """Article 1745
S'il s'agit d'une maison, appartement ou boutique, le bailleur paye, à titre de dommages et intérêts, au locataire évincé, une somme égale au prix du loyer, pendant le temps qui, suivant l'usage des lieux, est accordé entre le congé et la sortie.
""";
    content_hash "sha256:a3f08334fb08756df2a0a6c17c1e14e40726629260da6f264e0b9050ad3aa0b6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1746")
pub fragment CC_ART1746 in CC_COURANT {
    label fr official "Article 1746";
    kind article;
    locator "article/1746";
    text fr official """Article 1746
S'il s'agit de biens ruraux, l'indemnité que le bailleur doit payer au fermier est du tiers du prix du bail pour tout le temps qui reste à courir.
""";
    content_hash "sha256:f0d0575610027aa91ad1b223cd59a0d749937c5200074b9303cc57aa9d454770";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1747")
pub fragment CC_ART1747 in CC_COURANT {
    label fr official "Article 1747";
    kind article;
    locator "article/1747";
    text fr official """Article 1747
L'indemnité se réglera par experts, s'il s'agit de manufactures, usines, ou autres établissements qui exigent de grandes avances.
""";
    content_hash "sha256:829d22ce501548308bf2e61149928bfc2c703bd75916710db857c044d15127fa";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1748")
pub fragment CC_ART1748 in CC_COURANT {
    label fr official "Article 1748";
    kind article;
    locator "article/1748";
    text fr official """Article 1748
L'acquéreur qui veut user de la faculté réservée par le bail d'expulser le locataire en cas de vente est, en outre, tenu de l'avertir au temps d'avance usité dans le lieu pour les congés.
""";
    content_hash "sha256:ff27d2346b6bcb824ec9561e7b512f71ca8b55508044104ef4ef2c61f0d1821e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1749")
pub fragment CC_ART1749 in CC_COURANT {
    label fr official "Article 1749";
    kind article;
    locator "article/1749";
    text fr official """Article 1749
Les locataires ne peuvent être expulsés qu'ils ne soient payés par le bailleur ou, à son défaut, par le nouvel acquéreur, des dommages et intérêts ci-dessus expliqués.
""";
    content_hash "sha256:5e2f14e60c7ab0b741d4d0180c628483e31263003001e93b4b82b9f7b8c7136e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1750")
pub fragment CC_ART1750 in CC_COURANT {
    label fr official "Article 1750";
    kind article;
    locator "article/1750";
    text fr official """Article 1750
Si le bail n'est pas fait par acte authentique, ou n'a point de date certaine, l'acquéreur n'est tenu d'aucuns dommages et intérêts.
""";
    content_hash "sha256:dd10228588d2a92a3033e33119979524e3ff3df7cb71b818ed1bf49685f2be3c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1751")
pub fragment CC_ART1751 in CC_COURANT {
    label fr official "Article 1751";
    kind article;
    locator "article/1751";
    text fr official """Article 1751
Le droit au bail du local, sans caractère professionnel ou commercial, qui sert effectivement à l'habitation de deux époux, quel que soit leur régime matrimonial et nonobstant toute convention contraire et même si le bail a été conclu avant le mariage, ou de deux partenaires liés par un pacte civil de solidarité, dès lors que les partenaires en font la demande conjointement, est réputé appartenir à l'un et à l'autre des époux ou partenaires liés par un pacte civil de solidarité.
En cas de divorce ou de séparation de corps, ce droit pourra être attribué, en considération des intérêts sociaux et familiaux en cause, par la juridiction saisie de la demande en divorce ou en séparation de corps, à l'un des époux, sous réserve des droits à récompense ou à indemnité au profit de l'autre époux.
En cas de décès d'un des époux ou d'un des partenaires liés par un pacte civil de solidarité, le conjoint ou le partenaire lié par un pacte civil de solidarité survivant cotitulaire du bail dispose d'un droit exclusif sur celui-ci sauf s'il y renonce expressément.
""";
    content_hash "sha256:4b11fe5d933abcc728afab6e2833fc3e768151d6e63dadc21a5afb2ceb45ac73";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1751_1")
pub fragment CC_ART1751_1 in CC_COURANT {
    label fr official "Article 1751-1";
    kind article;
    locator "article/1751-1";
    text fr official """Article 1751-1
En cas de dissolution du pacte civil de solidarité, l'un des partenaires peut saisir le juge compétent en matière de bail aux fins de se voir attribuer le droit au bail du local, sans caractère professionnel ou commercial, qui sert effectivement à l'habitation des deux partenaires, sous réserve des créances ou droits à indemnité au profit de l'autre partenaire. Le bailleur est appelé à l'instance. Le juge apprécie la demande en considération des intérêts sociaux et familiaux des parties.
""";
    content_hash "sha256:da43bf457030d2517af0e797a927c5b1d73b8d9b4e23a78358a2bc4e243377cc";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1752")
pub fragment CC_ART1752 in CC_COURANT {
    label fr official "Article 1752";
    kind article;
    locator "article/1752";
    text fr official """Article 1752
Le locataire qui ne garnit pas la maison de meubles suffisants, peut être expulsé, à moins qu'il ne donne des sûretés capables de répondre du loyer.
""";
    content_hash "sha256:17225b39eefa3a9e6c6075edb4155582e646b9d1e62b9082ada5feaa15ec666f";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1753")
pub fragment CC_ART1753 in CC_COURANT {
    label fr official "Article 1753";
    kind article;
    locator "article/1753";
    text fr official """Article 1753
Le sous-locataire n'est tenu envers le propriétaire que jusqu'à concurrence du prix de sa sous-location dont il peut être débiteur au moment de la saisie, et sans qu'il puisse opposer des paiements faits par anticipation.
Les paiements faits par le sous-locataire, soit en vertu d'une stipulation portée en son bail, soit en conséquence de l'usage des lieux, ne sont pas réputés faits par anticipation.
""";
    content_hash "sha256:5dab349c25db34e3a5ad6cced12a65e60440a46f0df8a951859b99676c9c1ccf";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1754")
pub fragment CC_ART1754 in CC_COURANT {
    label fr official "Article 1754";
    kind article;
    locator "article/1754";
    text fr official """Article 1754
Les réparations locatives ou de menu entretien dont le locataire est tenu, s'il n'y a clause contraire, sont celles désignées comme telles par l'usage des lieux, et, entre autres, les réparations à faire :
Aux âtres, contre-coeurs, chambranles et tablettes de cheminées ;
Au recrépiment du bas des murailles des appartements et autres lieux d'habitation à la hauteur d'un mètre ;
Aux pavés et carreaux des chambres, lorsqu'il y en a seulement quelques-uns de cassés ;
Aux vitres, à moins qu'elles ne soient cassées par la grêle ou autres accidents extraordinaires et de force majeure, dont le locataire ne peut être tenu ;
Aux portes, croisées, planches de cloison ou de fermeture de boutiques, gonds, targettes et serrures.
""";
    content_hash "sha256:bb2bf5b2f67b6945bd8eaabb9572a4cca1cc7fd6ebf14e977b139fa5cd6299db";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1755")
pub fragment CC_ART1755 in CC_COURANT {
    label fr official "Article 1755";
    kind article;
    locator "article/1755";
    text fr official """Article 1755
Aucune des réparations réputées locatives n'est à la charge des locataires quand elles ne sont occasionnées que par vétusté ou force majeure.
""";
    content_hash "sha256:ee4180828cd1046985ccef517de03fe6173cf6f7cab771f09a5d7a9c3a7f1dec";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1756")
pub fragment CC_ART1756 in CC_COURANT {
    label fr official "Article 1756";
    kind article;
    locator "article/1756";
    text fr official """Article 1756
Le curement des puits et celui des fosses d'aisances sont à la charge du bailleur s'il n'y a clause contraire.
""";
    content_hash "sha256:ffb3057f7c2ff7fc850fb7b2fc05b4e0374accf73bf53cf1e170f14dcc33f2ad";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1757")
pub fragment CC_ART1757 in CC_COURANT {
    label fr official "Article 1757";
    kind article;
    locator "article/1757";
    text fr official """Article 1757
Le bail des meubles fournis pour garnir une maison entière, un corps de logis entier, une boutique, ou tous autres appartements, est censé fait pour la durée ordinaire des baux de maison, corps de logis, boutiques ou autres appartements, selon l'usage des lieux.
""";
    content_hash "sha256:a13a805430db43502644a6cb8c097249eecfd5c515761ab9c8e5ae445865bf47";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1758")
pub fragment CC_ART1758 in CC_COURANT {
    label fr official "Article 1758";
    kind article;
    locator "article/1758";
    text fr official """Article 1758
Le bail d'un appartement meublé est censé fait à l'année, quand il a été fait à tant par an ;
Au mois, quand il a été fait à tant par mois ;
Au jour, quand il a été fait à tant par jour.
Si rien ne constate que le bail soit fait à tant par an, par mois ou par jour, la location est censée faite suivant l'usage des lieux.
""";
    content_hash "sha256:0606e154800837bda743f981aef4c4a0d921e34a9c85661e57462cae0882a752";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1759")
pub fragment CC_ART1759 in CC_COURANT {
    label fr official "Article 1759";
    kind article;
    locator "article/1759";
    text fr official """Article 1759
Si le locataire d'une maison ou d'un appartement continue sa jouissance après l'expiration du bail par écrit, sans opposition de la part du bailleur, il sera censé les occuper aux mêmes conditions, pour le terme fixé par l'usage des lieux, et ne pourra plus en sortir ni en être expulsé qu'après un congé donné suivant le délai fixé par l'usage des lieux.
""";
    content_hash "sha256:1282ee8f46ccc58c06ca9582354c7b78293398ff2b63af3371d7ec0dc9850ead";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1760")
pub fragment CC_ART1760 in CC_COURANT {
    label fr official "Article 1760";
    kind article;
    locator "article/1760";
    text fr official """Article 1760
En cas de résiliation par la faute du locataire, celui-ci est tenu de payer le prix du bail pendant le temps nécessaire à la relocation, sans préjudice des dommages et intérêts qui ont pu résulter de l'abus.
""";
    content_hash "sha256:d8d884d087dc6a291f9a1e7e8b8887853ed748f2fe5e9d6ee7dff4e6156c4ebc";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1761")
pub fragment CC_ART1761 in CC_COURANT {
    label fr official "Article 1761";
    kind article;
    locator "article/1761";
    text fr official """Article 1761
Le bailleur ne peut résoudre la location, encore qu'il déclare vouloir occuper par lui-même la maison louée, s'il n'y a eu convention contraire.
""";
    content_hash "sha256:06c7df57133931a407db5bbfd5f8c99dfdf9eb2a6895461359f79b2f11492f3e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1762")
pub fragment CC_ART1762 in CC_COURANT {
    label fr official "Article 1762";
    kind article;
    locator "article/1762";
    text fr official """Article 1762
S'il a été convenu, dans le contrat de louage, que le bailleur pourrait venir occuper la maison, il est tenu de signifier d'avance un congé aux époques déterminées par l'usage des lieux.
""";
    content_hash "sha256:94ccdd3f23227bc3b6b9ddbe9e534aa784a5c25182447a9df41b74267070f554";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1764")
pub fragment CC_ART1764 in CC_COURANT {
    label fr official "Article 1764";
    kind article;
    locator "article/1764";
    text fr official """Article 1764
En cas de contravention, le propriétaire a droit de rentrer en jouissance, et le preneur est condamné aux dommages-intérêts résultant de l'inexécution du bail.
""";
    content_hash "sha256:7654b2459f4c89ae66c64c0926193f2f74c39bf3cade49ec415a73ec6486f1de";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1765")
pub fragment CC_ART1765 in CC_COURANT {
    label fr official "Article 1765";
    kind article;
    locator "article/1765";
    text fr official """Article 1765
Si, dans un bail à ferme, on donne aux fonds une contenance moindre ou plus grande que celle qu'ils ont réellement, il n'y a lieu à augmentation ou diminution de prix pour le fermier, que dans les cas et suivant les règles exprimées au titre " De la vente ".
""";
    content_hash "sha256:0f76028e1a527153641319936a0243ae3c22cdfa7672928041afe2c3770b7ade";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1766")
pub fragment CC_ART1766 in CC_COURANT {
    label fr official "Article 1766";
    kind article;
    locator "article/1766";
    text fr official """Article 1766
Si le preneur d'un héritage rural ne le garnit pas des bestiaux et des ustensiles nécessaires à son exploitation, s'il abandonne la culture, s'il ne cultive pas raisonnablement, s'il emploie la chose louée à un autre usage que celui auquel elle a été destinée, ou, en général, s'il n'exécute pas les clauses du bail, et qu'il en résulte un dommage pour le bailleur, celui-ci peut, suivant les circonstances, faire résilier le bail.
En cas de résiliation provenant du fait du preneur, celui-ci est tenu des dommages et intérêts, ainsi qu'il est dit en l'article 1764.
""";
    content_hash "sha256:09a78b60609047fad5e38c795e908eea0cb573803a296761637254294c8c7bc1";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1767")
pub fragment CC_ART1767 in CC_COURANT {
    label fr official "Article 1767";
    kind article;
    locator "article/1767";
    text fr official """Article 1767
Tout preneur de bien rural est tenu d'engranger dans les lieux à ce destinés d'après le bail.
""";
    content_hash "sha256:ce17f771b54e21b56318bf20ffd1130197163c5ca5db89cb8f752c2b41a167aa";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1768")
pub fragment CC_ART1768 in CC_COURANT {
    label fr official "Article 1768";
    kind article;
    locator "article/1768";
    text fr official """Article 1768
Le preneur d'un bien rural est tenu, sous peine de tous dépens, dommages et intérêts, d'avertir le propriétaire des usurpations qui peuvent être commises sur les fonds.
Cet avertissement doit être donné dans le même délai que celui qui est réglé en cas d'assignation suivant la distance des lieux.
""";
    content_hash "sha256:f4b962469b108c65c1063492c6f2f44bf5d4a38a2acee244571558aecd357576";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1769")
pub fragment CC_ART1769 in CC_COURANT {
    label fr official "Article 1769";
    kind article;
    locator "article/1769";
    text fr official """Article 1769
Si le bail est fait pour plusieurs années, et que, pendant la durée du bail, la totalité ou la moitié d'une récolte au moins soit enlevée par des cas fortuits, le fermier peut demander une remise du prix de sa location, à moins qu'il ne soit indemnisé par les récoltes précédentes.
S'il n'est pas indemnisé, l'estimation de la remise ne peut avoir lieu qu'à la fin du bail, auquel temps il se fait une compensation de toutes les années de jouissance ;
Et, cependant, le juge peut provisoirement dispenser le preneur de payer une partie du prix en raison de la perte soufferte.
""";
    content_hash "sha256:632ee4d439d966a4159aa69443824cc99a8a21c66bb8909c4f80bbbb3699c993";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1770")
pub fragment CC_ART1770 in CC_COURANT {
    label fr official "Article 1770";
    kind article;
    locator "article/1770";
    text fr official """Article 1770
Si le bail n'est que d'une année, et que la perte soit de la totalité des fruits, ou au moins de la moitié, le preneur sera déchargé d'une partie proportionnelle du prix de la location.
Il ne pourra prétendre aucune remise si la perte est moindre de moitié.
""";
    content_hash "sha256:53b140d30714d19491e31f5f8c7274c987c457d6fb00207fd1da62e3784c1867";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1771")
pub fragment CC_ART1771 in CC_COURANT {
    label fr official "Article 1771";
    kind article;
    locator "article/1771";
    text fr official """Article 1771
Le fermier ne peut obtenir de remise lorsque la perte des fruits arrive après qu'ils sont séparés de la terre, à moins que le bail ne donne au propriétaire une quotité de la récolte en nature, auquel cas le propriétaire doit supporter sa part de la perte, pourvu que le preneur ne fût pas en demeure de lui délivrer sa portion de récolte.
Le fermier ne peut également demander une remise lorsque la cause du dommage était existante et connue à l'époque où le bail a été passé.
""";
    content_hash "sha256:cea276f42875b8329c5400e9d4ac2bbcad7f6647e40c315a5be90891559c4c8d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1772")
pub fragment CC_ART1772 in CC_COURANT {
    label fr official "Article 1772";
    kind article;
    locator "article/1772";
    text fr official """Article 1772
Le preneur peut être chargé des cas fortuits par une stipulation expresse.
""";
    content_hash "sha256:599b7824e665871d2a9b1196b1c2d054538b5a28585ca490fa223f50a5095cf0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1773")
pub fragment CC_ART1773 in CC_COURANT {
    label fr official "Article 1773";
    kind article;
    locator "article/1773";
    text fr official """Article 1773
Cette stipulation ne s'entend que des cas fortuits ordinaires, tels que grêle, feu du ciel, gelée ou coulure.
Elle ne s'entend pas des cas fortuits extraordinaires, tels que les ravages de la guerre, ou une inondation, auxquels le pays n'est pas ordinairement sujet, à moins que le preneur n'ait été chargé de tous les cas fortuits prévus ou imprévus.
""";
    content_hash "sha256:88488acc36464490a876324434bd503feca7aaded9ee7043b4794070e1cfd150";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1774")
pub fragment CC_ART1774 in CC_COURANT {
    label fr official "Article 1774";
    kind article;
    locator "article/1774";
    text fr official """Article 1774
Le bail, sans écrit, d'un fonds rural, est censé fait pour le temps qui est nécessaire afin que le preneur recueille tous les fruits de l'héritage affermé.
Ainsi le bail à ferme d'un pré, d'une vigne, et de tout autre fonds dont les fruits se recueillent en entier dans le cours de l'année, est censé fait pour un an.
Le bail des terres labourables, lorsqu'elles se divisent par soles ou saisons, est censé fait pour autant d'années qu'il y a de soles.
""";
    content_hash "sha256:d904ff080b62bb95210c49ded1a809d75af42c48049ed7c011e4b841d66d6fd3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1775")
pub fragment CC_ART1775 in CC_COURANT {
    label fr official "Article 1775";
    kind article;
    locator "article/1775";
    text fr official """Article 1775
Le bail des héritages ruraux quoique fait sans écrit, ne cesse à l'expiration du terme fixé par l'article précédent, que par l'effet d'un congé donné par écrit par l'une des parties à l'autre, six mois au moins avant ce terme.
A défaut d'un congé donné dans le délai ci-dessus spécifié, il s'opère un nouveau bail dont l'effet est réglé par l'article 1774.
Il en est de même si, à l'expiration des baux écrits, le preneur reste et est laissé en possession.
""";
    content_hash "sha256:63ec0f205968e898249973051a0e81dc70b22ce4907b998029c978d08eec7282";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1777")
pub fragment CC_ART1777 in CC_COURANT {
    label fr official "Article 1777";
    kind article;
    locator "article/1777";
    text fr official """Article 1777
Le fermier sortant doit laisser à celui qui lui succède dans la culture, les logements convenables et autres facilités pour les travaux de l'année suivante ; et réciproquement, le fermier entrant doit procurer à celui qui sort les logements convenables et autres facilités pour la consommation des fourrages, et pour les récoltes restant à faire.
Dans l'un et l'autre cas, on doit se conformer à l'usage des lieux.
""";
    content_hash "sha256:fe1390bde30c189b29444e6e1eb03688f8ca8e0bf7e624f53cc8e18f57ebeb8d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1778")
pub fragment CC_ART1778 in CC_COURANT {
    label fr official "Article 1778";
    kind article;
    locator "article/1778";
    text fr official """Article 1778
Le fermier sortant doit aussi laisser les pailles et engrais de l'année, s'il les a reçus lors de son entrée en jouissance ; et quand même il ne les aurait pas reçus, le propriétaire pourra les retenir suivant l'estimation.
""";
    content_hash "sha256:bc9618ba8573b0ad4831024e959a16667b5b9d8a973e1b623c6dc3af0bc37745";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1779")
pub fragment CC_ART1779 in CC_COURANT {
    label fr official "Article 1779";
    kind article;
    locator "article/1779";
    text fr official """Article 1779
Il y a trois espèces principales de louage d'ouvrage et d'industrie :
1° Le louage de service ;
2° Celui des voituriers, tant par terre que par eau, qui se chargent du transport des personnes ou des marchandises ;
3° Celui des architectes, entrepreneurs d'ouvrages et techniciens par suite d'études, devis ou marchés.
""";
    content_hash "sha256:f3be1cf3a56b86e83c97489602a699d657af2f3e834a032f3ab722708de4fc6c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1780")
pub fragment CC_ART1780 in CC_COURANT {
    label fr official "Article 1780";
    kind article;
    locator "article/1780";
    text fr official """Article 1780
On ne peut engager ses services qu'à temps, ou pour une entreprise déterminée.
Le louage de service, fait sans détermination de durée, peut toujours cesser par la volonté d'une des parties contractantes.
Néanmoins, la résiliation du contrat par la volonté d'un seul des contractants peut donner lieu à des dommages-intérêts.
Pour la fixation de l'indemnité à allouer, le cas échéant, il est tenu compte des usages, de la nature des services engagés, du temps écoulé, des retenues opérées et des versements effectués en vue d'une pension de retraite, et, en général, de toutes les circonstances qui peuvent justifier l'existence et déterminer l'étendue du préjudice causé.
Les parties ne peuvent renoncer à l'avance au droit éventuel de demander des dommages-intérêts en vertu des dispositions ci-dessus.
Les contestations auxquelles pourra donner lieu l'application des paragraphes précédents, lorsqu'elles seront portées devant les tribunaux civils et devant les cours d'appel, seront instruites comme affaires sommaires et jugées d'urgence.
""";
    content_hash "sha256:55f8afc6276c22f8e87df84e42e699b42279783300eb9dad1f85187b4b823e25";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1782")
pub fragment CC_ART1782 in CC_COURANT {
    label fr official "Article 1782";
    kind article;
    locator "article/1782";
    text fr official """Article 1782
Les voituriers par terre et par eau sont assujettis, pour la garde et la conservation des choses qui leur sont confiées, aux mêmes obligations que les aubergistes, dont il est parlé au titre " Du dépôt et du séquestre ".
""";
    content_hash "sha256:6dc3223f23c1ea43cc1f789496fa97a1d5b99803d2a3014b07deba1db22a1906";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1783")
pub fragment CC_ART1783 in CC_COURANT {
    label fr official "Article 1783";
    kind article;
    locator "article/1783";
    text fr official """Article 1783
Ils répondent non seulement de ce qu'ils ont déjà reçu dans leur bâtiment ou voiture, mais encore de ce qui leur a été remis sur le port ou dans l'entrepôt, pour être placé dans leur bâtiment ou voiture.
""";
    content_hash "sha256:ac792950da43749fc5d793458427146691cdc585af08f6054b0a4c461dd37206";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1784")
pub fragment CC_ART1784 in CC_COURANT {
    label fr official "Article 1784";
    kind article;
    locator "article/1784";
    text fr official """Article 1784
Ils sont responsables de la perte et des avaries des choses qui leur sont confiées, à moins qu'ils ne prouvent qu'elles ont été perdues et avariées par cas fortuit ou force majeure.
""";
    content_hash "sha256:c4c4ac1d20153f04f2fc2db2bc9cf7309870a313345cab5a5905cb2ffcadecdb";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1785")
pub fragment CC_ART1785 in CC_COURANT {
    label fr official "Article 1785";
    kind article;
    locator "article/1785";
    text fr official """Article 1785
Les entrepreneurs de voitures publiques par terre et par eau, et ceux des roulages publics, doivent tenir registre de l'argent, des effets et des paquets dont ils se chargent.
""";
    content_hash "sha256:2f43223374303f2fcca4ff383845f99bd24bd02f2544c03c5704986b1c00e2d2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1786")
pub fragment CC_ART1786 in CC_COURANT {
    label fr official "Article 1786";
    kind article;
    locator "article/1786";
    text fr official """Article 1786
Les entrepreneurs et directeurs de voitures et roulages publics, les maîtres de barques et navires, sont en outre assujettis à des règlements particuliers, qui font la loi entre eux et les autres citoyens.
""";
    content_hash "sha256:b33c0d6e456601ca2e30a29d3915830a6d744d09a8fb7f38fbc674ea0f384d11";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1787")
pub fragment CC_ART1787 in CC_COURANT {
    label fr official "Article 1787";
    kind article;
    locator "article/1787";
    text fr official """Article 1787
Lorsqu'on charge quelqu'un de faire un ouvrage, on peut convenir qu'il fournira seulement son travail ou son industrie, ou bien qu'il fournira aussi la matière.
""";
    content_hash "sha256:cf98da044b2d0ed1961791809fee96f024119137c59de9e8702ffbaea9e1585b";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1788")
pub fragment CC_ART1788 in CC_COURANT {
    label fr official "Article 1788";
    kind article;
    locator "article/1788";
    text fr official """Article 1788
Si, dans le cas où l'ouvrier fournit la matière, la chose vient à périr, de quelque manière que ce soit, avant d'être livrée, la perte en est pour l'ouvrier, à moins que le maître ne fût en demeure de recevoir la chose.
""";
    content_hash "sha256:34dacaa3146c39d8f39b38437ea2217b249ab94c9a1081059eba503576848b9e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1789")
pub fragment CC_ART1789 in CC_COURANT {
    label fr official "Article 1789";
    kind article;
    locator "article/1789";
    text fr official """Article 1789
Dans le cas où l'ouvrier fournit seulement son travail ou son industrie, si la chose vient à périr, l'ouvrier n'est tenu que de sa faute.
""";
    content_hash "sha256:2422dad3eccc570cd4b5e05d0effd8a39cf7b4a446559eee3d65d68d2e88dc69";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1790")
pub fragment CC_ART1790 in CC_COURANT {
    label fr official "Article 1790";
    kind article;
    locator "article/1790";
    text fr official """Article 1790
Si, dans le cas de l'article précédent la chose vient à périr, quoique sans aucune faute de la part de l'ouvrier, avant que l'ouvrage ait été reçu et sans que le maître fût en demeure de le vérifier, l'ouvrier n'a point de salaire à réclamer, à moins que la chose n'ait péri par le vice de la matière.
""";
    content_hash "sha256:f83dc1b3db5e91282d08702ccd1ad7c6c1ea94746b95c5397d763b625e5595c3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1791")
pub fragment CC_ART1791 in CC_COURANT {
    label fr official "Article 1791";
    kind article;
    locator "article/1791";
    text fr official """Article 1791
S'il s'agit d'un ouvrage à plusieurs pièces ou à la mesure, la vérification peut s'en faire par parties : elle est censée faite pour toutes les parties payées, si le maître paye l'ouvrier en proportion de l'ouvrage fait.
""";
    content_hash "sha256:795417f853b4d42f242ca4666c7f2454c47aa05739852f47a325cbe836acf3b9";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792")
pub fragment CC_ART1792 in CC_COURANT {
    label fr official "Article 1792";
    kind article;
    locator "article/1792";
    text fr official """Article 1792
Tout constructeur d'un ouvrage est responsable de plein droit, envers le maître ou l'acquéreur de l'ouvrage, des dommages, même résultant d'un vice du sol, qui compromettent la solidité de l'ouvrage ou qui, l'affectant dans l'un de ses éléments constitutifs ou l'un de ses éléments d'équipement, le rendent impropre à sa destination.
Une telle responsabilité n'a point lieu si le constructeur prouve que les dommages proviennent d'une cause étrangère.
""";
    content_hash "sha256:1d7cd32c7f2e348793b16e96ed00d8b81eb03c2969de3630dfc82fb1d522be56";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_1")
pub fragment CC_ART1792_1 in CC_COURANT {
    label fr official "Article 1792-1";
    kind article;
    locator "article/1792-1";
    text fr official """Article 1792-1
Est réputé constructeur de l'ouvrage :
1° Tout architecte, entrepreneur, technicien ou autre personne liée au maître de l'ouvrage par un contrat de louage d'ouvrage ;
2° Toute personne qui vend, après achèvement, un ouvrage qu'elle a construit ou fait construire ;
3° Toute personne qui, bien qu'agissant en qualité de mandataire du propriétaire de l'ouvrage, accomplit une mission assimilable à celle d'un locateur d'ouvrage.
""";
    content_hash "sha256:ce7a12afb0a3a38c8cdd1e40352e081a1e7fa9b094091561339850c874e0c122";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_2")
pub fragment CC_ART1792_2 in CC_COURANT {
    label fr official "Article 1792-2";
    kind article;
    locator "article/1792-2";
    text fr official """Article 1792-2
La présomption de responsabilité établie par l'article 1792 s'étend également aux dommages qui affectent la solidité des éléments d'équipement d'un ouvrage, mais seulement lorsque ceux-ci font indissociablement corps avec les ouvrages de viabilité, de fondation, d'ossature, de clos ou de couvert.
Un élément d'équipement est considéré comme formant indissociablement corps avec l'un des ouvrages de viabilité, de fondation, d'ossature, de clos ou de couvert lorsque sa dépose, son démontage ou son remplacement ne peut s'effectuer sans détérioration ou enlèvement de matière de cet ouvrage.
""";
    content_hash "sha256:a99d934f54b68712a3805819e6f2337c67e9423dbad0fcbe06b7de52b2697e6d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_3")
pub fragment CC_ART1792_3 in CC_COURANT {
    label fr official "Article 1792-3";
    kind article;
    locator "article/1792-3";
    text fr official """Article 1792-3
Les autres éléments d'équipement de l'ouvrage font l'objet d'une garantie de bon fonctionnement d'une durée minimale de deux ans à compter de sa réception.
""";
    content_hash "sha256:5e889d169984a7876af71862290d2ed762ec0a3126a78f8364fb892d7e2de6c4";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_4")
pub fragment CC_ART1792_4 in CC_COURANT {
    label fr official "Article 1792-4";
    kind article;
    locator "article/1792-4";
    text fr official """Article 1792-4
Le fabricant d'un ouvrage, d'une partie d'ouvrage ou d'un élément d'équipement conçu et produit pour satisfaire, en état de service, à des exigences précises et déterminées à l'avance, est solidairement responsable des obligations mises par les articles 1792, 1792-2 et 1792-3 à la charge du locateur d'ouvrage qui a mis en oeuvre, sans modification et conformément aux règles édictées par le fabricant, l'ouvrage, la partie d'ouvrage ou élément d'équipement considéré.
Sont assimilés à des fabricants pour l'application du présent article :
Celui qui a importé un ouvrage, une partie d'ouvrage ou un élément d'équipement fabriqué à l'étranger ;
Celui qui l'a présenté comme son oeuvre en faisant figurer sur lui son nom, sa marque ou tout autre signe distinctif.
""";
    content_hash "sha256:330679d003aa5275fce7b95a4222612310a290034b52ce112b385b850c9cb7a8";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_4_1")
pub fragment CC_ART1792_4_1 in CC_COURANT {
    label fr official "Article 1792-4-1";
    kind article;
    locator "article/1792-4-1";
    text fr official """Article 1792-4-1
Toute personne physique ou morale dont la responsabilité peut être engagée en vertu des articles 1792 à 1792-4 du présent code est déchargée des responsabilités et garanties pesant sur elle, en application des articles 1792 à 1792-2, après dix ans à compter de la réception des travaux ou, en application de l'article 1792-3, à l'expiration du délai visé à cet article.
""";
    content_hash "sha256:f8b3e7841685573ba2f62dbe3cbc860b094913036546226304132ab57d8a973e";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_4_2")
pub fragment CC_ART1792_4_2 in CC_COURANT {
    label fr official "Article 1792-4-2";
    kind article;
    locator "article/1792-4-2";
    text fr official """Article 1792-4-2
Les actions en responsabilité dirigées contre un sous-traitant en raison de dommages affectant un ouvrage ou des éléments d'équipement d'un ouvrage mentionnés aux articles 1792 et 1792-2 se prescrivent par dix ans à compter de la réception des travaux et, pour les dommages affectant ceux des éléments d'équipement de l'ouvrage mentionnés à l'article 1792-3, par deux ans à compter de cette même réception.
""";
    content_hash "sha256:6d13ffacec7517fddd25cf5ca1fd5eff00b805c8e4a70c56f9736db8595ef795";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_4_3")
pub fragment CC_ART1792_4_3 in CC_COURANT {
    label fr official "Article 1792-4-3";
    kind article;
    locator "article/1792-4-3";
    text fr official """Article 1792-4-3
En dehors des actions régies par les articles 1792-3, 1792-4-1 et 1792-4-2, les actions en responsabilité dirigées contre les constructeurs désignés aux articles 1792 et 1792-1 et leurs sous-traitants se prescrivent par dix ans à compter de la réception des travaux.
""";
    content_hash "sha256:708433712489cbed9941c64d14c021309875be9deed8cb42fea63225dd5943c0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_5")
pub fragment CC_ART1792_5 in CC_COURANT {
    label fr official "Article 1792-5";
    kind article;
    locator "article/1792-5";
    text fr official """Article 1792-5
Toute clause d'un contrat qui a pour objet, soit d'exclure ou de limiter la responsabilité prévue aux articles 1792, 1792-1 et 1792-2, soit d'exclure les garanties prévues aux articles 1792-3 et 1792-6 ou d'en limiter la portée, soit d'écarter ou de limiter la solidarité prévue à l'article 1792-4, est réputée non écrite.
""";
    content_hash "sha256:2159c3565e789f1408e60bda9f96d6e0526c87f247376434395a9825b4b4554d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_6")
pub fragment CC_ART1792_6 in CC_COURANT {
    label fr official "Article 1792-6";
    kind article;
    locator "article/1792-6";
    text fr official """Article 1792-6
La réception est l'acte par lequel le maître de l'ouvrage déclare accepter l'ouvrage avec ou sans réserves. Elle intervient à la demande de la partie la plus diligente, soit à l'amiable, soit à défaut judiciairement. Elle est, en tout état de cause, prononcée contradictoirement.
La garantie de parfait achèvement, à laquelle l'entrepreneur est tenu pendant un délai d'un an, à compter de la réception, s'étend à la réparation de tous les désordres signalés par le maître de l'ouvrage, soit au moyen de réserves mentionnées au procès-verbal de réception, soit par voie de notification écrite pour ceux révélés postérieurement à la réception.
Les délais nécessaires à l'exécution des travaux de réparation sont fixés d'un commun accord par le maître de l'ouvrage et l'entrepreneur concerné.
En l'absence d'un tel accord ou en cas d'inexécution dans le délai fixé, les travaux peuvent, après mise en demeure restée infructueuse, être exécutés aux frais et risques de l'entrepreneur défaillant.
L'exécution des travaux exigés au titre de la garantie de parfait achèvement est constatée d'un commun accord, ou, à défaut, judiciairement.
La garantie ne s'étend pas aux travaux nécessaires pour remédier aux effets de l'usure normale ou de l'usage.
""";
    content_hash "sha256:dac1e166a37706bf55339bb1b57b41ab3df979b3f45a319bb9c6d55d1131efbb";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1792_7")
pub fragment CC_ART1792_7 in CC_COURANT {
    label fr official "Article 1792-7";
    kind article;
    locator "article/1792-7";
    text fr official """Article 1792-7
Ne sont pas considérés comme des éléments d'équipement d'un ouvrage au sens des articles 1792, 1792-2, 1792-3 et 1792-4 les éléments d'équipement, y compris leurs accessoires, dont la fonction exclusive est de permettre l'exercice d'une activité professionnelle dans l'ouvrage.
""";
    content_hash "sha256:ef6150f470e7afa172d0d4831370b173920558b04f98080e877317d7475e24d7";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1793")
pub fragment CC_ART1793 in CC_COURANT {
    label fr official "Article 1793";
    kind article;
    locator "article/1793";
    text fr official """Article 1793
Lorsqu'un architecte ou un entrepreneur s'est chargé de la construction à forfait d'un bâtiment, d'après un plan arrêté et convenu avec le propriétaire du sol, il ne peut demander aucune augmentation de prix, ni sous le prétexte de l'augmentation de la main-d'oeuvre ou des matériaux, ni sous celui de changements ou d'augmentations faits sur ce plan, si ces changements ou augmentations n'ont pas été autorisés par écrit, et le prix convenu avec le propriétaire.
""";
    content_hash "sha256:0ac6deda5d8927e526d9891ed895c9409409314b6879216432927af6475d8c67";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1794")
pub fragment CC_ART1794 in CC_COURANT {
    label fr official "Article 1794";
    kind article;
    locator "article/1794";
    text fr official """Article 1794
Le maître peut résilier, par sa seule volonté, le marché à forfait, quoique l'ouvrage soit déjà commencé, en dédommageant l'entrepreneur de toutes ses dépenses, de tous ses travaux, et de tout ce qu'il aurait pu gagner dans cette entreprise.
""";
    content_hash "sha256:949eb2827415de0594af85b7d4595c9bf51826ccbfc656e9fd832f8c40c0781a";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1795")
pub fragment CC_ART1795 in CC_COURANT {
    label fr official "Article 1795";
    kind article;
    locator "article/1795";
    text fr official """Article 1795
Le contrat de louage d'ouvrage est dissous par la mort de l'ouvrier, de l'architecte ou entrepreneur.
""";
    content_hash "sha256:0848ccdc6a78285032f668538a1078916d18a73b5bb24d883ecdbf13dab106d5";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1796")
pub fragment CC_ART1796 in CC_COURANT {
    label fr official "Article 1796";
    kind article;
    locator "article/1796";
    text fr official """Article 1796
Mais le propriétaire est tenu de payer en proportion du prix porté par la convention, à leur succession, la valeur des ouvrages faits et celle des matériaux préparés, lors seulement que ces travaux ou ces matériaux peuvent lui être utiles.
""";
    content_hash "sha256:493ad37b9404c8ecf9910d2eacb6fc7f9f9aaaea1427dd5f61cdfccbbb22e22a";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1797")
pub fragment CC_ART1797 in CC_COURANT {
    label fr official "Article 1797";
    kind article;
    locator "article/1797";
    text fr official """Article 1797
L'entrepreneur répond du fait des personnes qu'il emploie.
""";
    content_hash "sha256:94ee03a32a982bf3e61bf87b8f6caf790409e98ec7095462f42946a40562892f";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1798")
pub fragment CC_ART1798 in CC_COURANT {
    label fr official "Article 1798";
    kind article;
    locator "article/1798";
    text fr official """Article 1798
Les maçons, charpentiers et autres ouvriers qui ont été employés à la construction d'un bâtiment ou d'autres ouvrages faits à l'entreprise, n'ont d'action contre celui pour lequel les ouvrages ont été faits, que jusqu'à concurrence de ce dont il se trouve débiteur envers l'entrepreneur, au moment où leur action est intentée.
""";
    content_hash "sha256:09a6a6d4a07827558a54aae2de3978b6639592c61946d5bc2681b0645c1c3c34";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1799")
pub fragment CC_ART1799 in CC_COURANT {
    label fr official "Article 1799";
    kind article;
    locator "article/1799";
    text fr official """Article 1799
Les maçons, charpentiers, serruriers et autres ouvriers qui font directement des marchés à prix fait, sont astreints aux règles prescrites dans la présente section : ils sont entrepreneurs dans la partie qu'ils traitent.
""";
    content_hash "sha256:6f7cb6753864d8b14d4002ceeba9b3d4c71a6821929d6292444bf593e051b51c";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1799_1")
pub fragment CC_ART1799_1 in CC_COURANT {
    label fr official "Article 1799-1";
    kind article;
    locator "article/1799-1";
    text fr official """Article 1799-1
Le maître de l'ouvrage qui conclut un marché de travaux privé visé au 3° de l'article 1779 doit garantir à l'entrepreneur le paiement des sommes dues lorsque celles-ci dépassent un seuil fixé par décret en Conseil d'Etat.
Lorsque le maître de l'ouvrage recourt à un crédit spécifique pour financer les travaux, l'établissement de crédit ne peut verser le montant du prêt à une personne autre que celles mentionnées au 3° de l'article 1779 tant que celles-ci n'ont pas reçu le paiement de l'intégralité de la créance née du marché correspondant au prêt. Les versements se font sur l'ordre écrit et sous la responsabilité exclusive du maître de l'ouvrage entre les mains de la personne ou d'un mandataire désigné à cet effet.
Lorsque le maître de l'ouvrage ne recourt pas à un crédit spécifique ou lorsqu'il y recourt partiellement, et à défaut de garantie résultant d'une stipulation particulière, le paiement est garanti par un cautionnement solidaire consenti par un établissement de crédit, une société de financement, une entreprise d'assurance ou un organisme de garantie collective, selon des modalités fixées par décret en Conseil d'Etat. Tant qu'aucune garantie n'a été fournie et que l'entrepreneur demeure impayé des travaux exécutés, celui-ci peut surseoir à l'exécution du contrat après mise en demeure restée sans effet à l'issue d'un délai de quinze jours.
Les dispositions de l'alinéa précédent ne s'appliquent pas lorsque le maître de l'ouvrage conclut un marché de travaux pour son propre compte et pour la satisfaction de besoins ne ressortissant pas à une activité professionnelle en rapport avec ce marché.
Les dispositions du présent article ne s'appliquent pas aux marchés conclus par un organisme visé à l'article L. 411-2 du code de la construction et de l'habitation, ou par une société d'économie mixte, pour des logements à usage locatif aidés par l'Etat et réalisés par cet organisme ou cette société.
""";
    content_hash "sha256:efc96a1befc951fba8dccb1303c0011e6ad9f698acf1ceb9717af3dc623fad41";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1800")
pub fragment CC_ART1800 in CC_COURANT {
    label fr official "Article 1800";
    kind article;
    locator "article/1800";
    text fr official """Article 1800
Le bail à cheptel est un contrat par lequel l'une des parties donne à l'autre un fonds de bétail pour le garder, le nourrir et le soigner, sous les conditions convenues entre elles.
""";
    content_hash "sha256:c638103df93290caaa4cfd8c8cb923eb66fe6691459ae8dab4ff5a1c085a3a21";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1801")
pub fragment CC_ART1801 in CC_COURANT {
    label fr official "Article 1801";
    kind article;
    locator "article/1801";
    text fr official """Article 1801
Il y a plusieurs sortes de cheptels :
Le cheptel simple ou ordinaire,
Le cheptel à moitié,
Le cheptel donné au fermier ou au métayer.
Il y a encore une quatrième espèce de contrat improprement appelée cheptel.
""";
    content_hash "sha256:7e7d73ff1297078d5deab3550365e0f25add4225021d87f80cc655301a760ee0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1802")
pub fragment CC_ART1802 in CC_COURANT {
    label fr official "Article 1802";
    kind article;
    locator "article/1802";
    text fr official """Article 1802
On peut donner à cheptel toute espèce d'animaux susceptibles de croît ou de profit pour l'agriculture ou le commerce.
""";
    content_hash "sha256:8ea828bbe11857c8a7ce1118fa41fa1f9e78a513501e035527b71f67dd4943dd";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1803")
pub fragment CC_ART1803 in CC_COURANT {
    label fr official "Article 1803";
    kind article;
    locator "article/1803";
    text fr official """Article 1803
A défaut de conventions particulières, ces contrats se règlent par les principes qui suivent.
""";
    content_hash "sha256:3c32a7f9da5ce070283d2b726d9c0cc0f7453a620de0cdef0efad0edc7e7176d";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1804")
pub fragment CC_ART1804 in CC_COURANT {
    label fr official "Article 1804";
    kind article;
    locator "article/1804";
    text fr official """Article 1804
Le bail à cheptel simple est un contrat par lequel on donne à un autre des bestiaux à garder, nourrir et soigner, à condition que le preneur profitera de la moitié du croît, et qu'il supportera aussi la moitié de la perte.
""";
    content_hash "sha256:2251930fa44c34d68e8b772412846af877d564e5b2ba07645a2c6e5d6ed6ed76";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1805")
pub fragment CC_ART1805 in CC_COURANT {
    label fr official "Article 1805";
    kind article;
    locator "article/1805";
    text fr official """Article 1805
L'état numératif, descriptif et estimatif des animaux remis, figurant au bail, n'en transporte pas la propriété au preneur. Il n'a d'autre objet que de servir de base au règlement à intervenir au jour où le contrat prend fin.
""";
    content_hash "sha256:d9a03a28a7f792cd8f64353e87ad72e8300fcc4fd6db5b4ec939f33f885995f8";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1806")
pub fragment CC_ART1806 in CC_COURANT {
    label fr official "Article 1806";
    kind article;
    locator "article/1806";
    text fr official """Article 1806
Le preneur doit les soins raisonnables à la conservation du cheptel.
""";
    content_hash "sha256:065fa8b525c65b177476fca1b1d16cfa28178458726730fe3c46d8dbe19fdc68";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1807")
pub fragment CC_ART1807 in CC_COURANT {
    label fr official "Article 1807";
    kind article;
    locator "article/1807";
    text fr official """Article 1807
Il n'est tenu du cas fortuit que lorsqu'il a été précédé de quelque faute de sa part, sans laquelle la perte ne serait pas arrivée.
""";
    content_hash "sha256:57cc660133d0fef7319eeb72903132115b507cd489af33a1e44126740f33a993";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1808")
pub fragment CC_ART1808 in CC_COURANT {
    label fr official "Article 1808";
    kind article;
    locator "article/1808";
    text fr official """Article 1808
En cas de contestation, le preneur est tenu de prouver le cas fortuit, et le bailleur est tenu de prouver la faute qu'il impute au preneur.
""";
    content_hash "sha256:f8efd60433df49e84d3d102fd4ac4b68d3e1a2ecedbe87aaf1bd891bd9339478";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1809")
pub fragment CC_ART1809 in CC_COURANT {
    label fr official "Article 1809";
    kind article;
    locator "article/1809";
    text fr official """Article 1809
Le preneur qui est déchargé par le cas fortuit est toujours tenu de rendre compte des peaux des bêtes.
""";
    content_hash "sha256:31f94926d5981c02e92838a55c7ca7ee6dafa07f167072e1bba1d6ff6591dc23";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1810")
pub fragment CC_ART1810 in CC_COURANT {
    label fr official "Article 1810";
    kind article;
    locator "article/1810";
    text fr official """Article 1810
Si le cheptel périt en entier sans la faute du preneur, la perte en est pour le bailleur.
S'il n'en périt qu'une partie, la perte est supportée en commun, d'après le prix de l'estimation originaire et celui de l'estimation à l'expiration du cheptel.
""";
    content_hash "sha256:7ced7aca26b03a5811d0f639568e23661d3fe7020e1782c22b94d3128fdbaad3";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1811")
pub fragment CC_ART1811 in CC_COURANT {
    label fr official "Article 1811";
    kind article;
    locator "article/1811";
    text fr official """Article 1811
On ne peut stipuler :
Que le preneur supportera la perte totale du cheptel, quoique arrivée par cas fortuit et sans sa faute.
Ou qu'il supportera, dans la perte, une part plus grande que dans le profit.
Ou que le bailleur prélèvera, à la fin du bail, quelque chose de plus que le cheptel qu'il a fourni.
Toute convention semblable est nulle.
Le preneur profite seul des laitages, du fumier et du travail des animaux donnés à cheptel.
La laine et le croît se partagent.
""";
    content_hash "sha256:0ee40985b2f836089fb7225722ba214102e01fcc784657c0584a8f1df7d2b065";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1812")
pub fragment CC_ART1812 in CC_COURANT {
    label fr official "Article 1812";
    kind article;
    locator "article/1812";
    text fr official """Article 1812
Le preneur ne peut disposer d'aucune bête du troupeau, soit du fonds, soit du croît, sans le consentement du bailleur, qui ne peut lui-même en disposer sans le consentement du preneur.
""";
    content_hash "sha256:7a38f6fa2517b5565188b51750e4fe5f2fe7e828fdf767d5cf38ad6b50b1bdc2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1813")
pub fragment CC_ART1813 in CC_COURANT {
    label fr official "Article 1813";
    kind article;
    locator "article/1813";
    text fr official """Article 1813
Lorsque le cheptel est donné au fermier d'autrui, il doit être notifié au propriétaire de qui ce fermier tient ; sans quoi il peut le saisir et le faire vendre pour ce que son fermier lui doit.
""";
    content_hash "sha256:6828530f1e79207df3f9b85168da9eb2365e33bedddcab944a7b8398e9332c1f";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1814")
pub fragment CC_ART1814 in CC_COURANT {
    label fr official "Article 1814";
    kind article;
    locator "article/1814";
    text fr official """Article 1814
Le preneur ne pourra tondre sans en prévenir le bailleur.
""";
    content_hash "sha256:32696a6f9d02ed6b8867d5c3a7a686006fabae0a008d50cc58b7ce0f030c50f4";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1815")
pub fragment CC_ART1815 in CC_COURANT {
    label fr official "Article 1815";
    kind article;
    locator "article/1815";
    text fr official """Article 1815
S'il n'y a pas de temps fixé par la convention pour la durée du cheptel, il est censé fait pour trois ans.
""";
    content_hash "sha256:12fc6ce432b1cf70e59ad3bfa96967c8af126f0b1aaebdc86842ac90a67380e5";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1816")
pub fragment CC_ART1816 in CC_COURANT {
    label fr official "Article 1816";
    kind article;
    locator "article/1816";
    text fr official """Article 1816
Le bailleur peut en demander plus tôt la résolution si le preneur ne remplit pas ses obligations.
""";
    content_hash "sha256:4aa86ceed223436a56c581d3225b3b49708d580fe003b6fe839d7fc795d530c6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1817")
pub fragment CC_ART1817 in CC_COURANT {
    label fr official "Article 1817";
    kind article;
    locator "article/1817";
    text fr official """Article 1817
A la fin du bail, ou lors de sa résolution, le bailleur prélève des animaux de chaque espèce, de manière à obtenir un même fonds de bétail que celui qu'il a remis, notamment quant au nombre, à la race, à l'âge, au poids et à la qualité des bêtes : l'excédent se partage.
S'il n'existe pas assez d'animaux pour reconstituer le fonds de bétail tel qu'il est ci-dessus défini, les parties se font raison de la perte sur la base de la valeur des animaux au jour où le contrat prend fin.
Toute convention aux termes de laquelle le preneur, à la fin du bail ou lors de sa résolution, doit laisser un fonds de bétail d'une valeur égale au prix de l'estimation de celui qu'il aura reçu, est nulle.
""";
    content_hash "sha256:4f411271566d7861b2fa9061e84ead7f6018281287283be9be4643259cee2ded";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1818")
pub fragment CC_ART1818 in CC_COURANT {
    label fr official "Article 1818";
    kind article;
    locator "article/1818";
    text fr official """Article 1818
Le cheptel à moitié est une société dans laquelle chacun des contractants fournit la moitié des bestiaux, qui demeurent communs pour le profit ou pour la perte.
""";
    content_hash "sha256:ecad48bba47728c1219d652654e818bda9aa3df786f02aafc6e9fda82730b091";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1819")
pub fragment CC_ART1819 in CC_COURANT {
    label fr official "Article 1819";
    kind article;
    locator "article/1819";
    text fr official """Article 1819
Le preneur profite seul, comme dans le cheptel simple, des laitages, du fumier et des travaux des bêtes.
Le bailleur n'a droit qu'à la moitié des laines et du croît.
Toute convention contraire est nulle, à moins que le bailleur ne soit propriétaire de la métairie dont le preneur est fermier ou métayer.
""";
    content_hash "sha256:21792b1fdbe69fd8c1757e42e8ce14048adb554e9f35232afba3d84be64a72d0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1820")
pub fragment CC_ART1820 in CC_COURANT {
    label fr official "Article 1820";
    kind article;
    locator "article/1820";
    text fr official """Article 1820
Toutes les autres règles du cheptel simple s'appliquent au cheptel à moitié.
""";
    content_hash "sha256:04a1ecf3617c3cecd65517e2e53a37d0d289e3ff0a4a6dfb1463e2ddcb624edf";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1821")
pub fragment CC_ART1821 in CC_COURANT {
    label fr official "Article 1821";
    kind article;
    locator "article/1821";
    text fr official """Article 1821
Ce cheptel (appelé aussi cheptel de fer) est celui par lequel le propriétaire d'une exploitation rurale la donne à ferme à charge qu'à l'expiration du bail, le fermier laissera un même fonds de bétail que celui qu'il a reçu.
""";
    content_hash "sha256:957b345720d44b6e37097b83f68bdb91db854d4f8729c960f5229207d7fe73e8";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1822")
pub fragment CC_ART1822 in CC_COURANT {
    label fr official "Article 1822";
    kind article;
    locator "article/1822";
    text fr official """Article 1822
L'état numératif, descriptif et estimatif des animaux remis, figurant au bail, n'en transporte pas la propriété au preneur ; il n'a d'autre objet que de servir de base au règlement à intervenir au moment où le contrat prend fin.
""";
    content_hash "sha256:0f50e91835919b591866c2a721d78457d845907d5e883ca433ca1cb4ff2ad636";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1823")
pub fragment CC_ART1823 in CC_COURANT {
    label fr official "Article 1823";
    kind article;
    locator "article/1823";
    text fr official """Article 1823
Tous les profits appartiennent au fermier pendant la durée de son bail, s'il n'y a convention contraire.
""";
    content_hash "sha256:3f1ce5a8df17c0b18cdf21c4d8f655ba27145081e0d793583183d3b32943f5f7";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1824")
pub fragment CC_ART1824 in CC_COURANT {
    label fr official "Article 1824";
    kind article;
    locator "article/1824";
    text fr official """Article 1824
Dans les cheptels donnés au fermier, le fumier n'est point dans les profits personnels des preneurs, mais appartient à la métairie, à l'exploitation de laquelle il doit être uniquement employé.
""";
    content_hash "sha256:20849ba15d842b52f508251f76e14560359c9834744261d8e2761320d189da73";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1825")
pub fragment CC_ART1825 in CC_COURANT {
    label fr official "Article 1825";
    kind article;
    locator "article/1825";
    text fr official """Article 1825
La perte, même totale et par cas fortuit, est en entier pour le fermier, s'il n'y a convention contraire.
""";
    content_hash "sha256:8248b2f12b91bc7e2d6cb9f35ac9ffdb5827a428c7ce094472473a56a661f8f7";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1826")
pub fragment CC_ART1826 in CC_COURANT {
    label fr official "Article 1826";
    kind article;
    locator "article/1826";
    text fr official """Article 1826
A la fin du bail ou lors de sa résolution, le preneur doit laisser des animaux de chaque espèce formant un même fonds de bétail que celui qu'il a reçu, notamment quant au nombre, à la race, à l'âge, au poids et à la qualité des bêtes.
S'il y a un excédent, il lui appartient.
S'il y a un déficit, le règlement entre les parties est fait sur la base de la valeur des animaux au jour où le contrat prend fin.
Toute convention aux termes de laquelle le preneur, à la fin du bail ou lors de sa résolution, doit laisser un fonds de bétail d'une valeur égale au prix de l'estimation de celui qu'il a reçu est nulle.
""";
    content_hash "sha256:be73df862c1a6dc91350115993c84ea1bf9723f9eb6ec399dfb931d1e182fee2";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1827")
pub fragment CC_ART1827 in CC_COURANT {
    label fr official "Article 1827";
    kind article;
    locator "article/1827";
    text fr official """Article 1827
Si le cheptel périt en entier sans la faute du métayer, la perte est pour le bailleur.
""";
    content_hash "sha256:64763cb28e2baa5377fcc3aa640c6f752ceaa1a36d07ac57872e2cada6cf3997";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1828")
pub fragment CC_ART1828 in CC_COURANT {
    label fr official "Article 1828";
    kind article;
    locator "article/1828";
    text fr official """Article 1828
On peut stipuler que le métayer délaissera au bailleur sa part de la toison à un prix inférieur à la valeur ordinaire ;
Que le bailleur aura une plus grande part du profit ;
Qu'il aura la moitié des laitages ;
Mais on ne peut pas stipuler que le métayer sera tenu de toute la perte.
""";
    content_hash "sha256:16ee2fb83d0f013829e3ba27451d3a729f62270b2d434b613f0fe9b5ac8d3c20";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1829")
pub fragment CC_ART1829 in CC_COURANT {
    label fr official "Article 1829";
    kind article;
    locator "article/1829";
    text fr official """Article 1829
Ce cheptel finit avec le bail de métayage.
""";
    content_hash "sha256:2ed25d833d815319321675a671fc7f70541f9df783c965bcf08d30dbd12865e1";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1830")
pub fragment CC_ART1830 in CC_COURANT {
    label fr official "Article 1830";
    kind article;
    locator "article/1830";
    text fr official """Article 1830
Il est d'ailleurs soumis à toutes les règles du cheptel simple.
""";
    content_hash "sha256:bdb6bb207a50a62a6eec7c25c25dee98c6ba2c4401fb92a7529cd529585938cb";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1831")
pub fragment CC_ART1831 in CC_COURANT {
    label fr official "Article 1831";
    kind article;
    locator "article/1831";
    text fr official """Article 1831
Lorsqu'une ou plusieurs vaches sont données pour les loger et les nourrir, le bailleur en conserve la propriété : il a seulement le profit des veaux qui en naissent.
""";
    content_hash "sha256:cdeb4ef39e50d5b5c23f1cc9b85c8b078db59c6e98cd890714d0a25c6b6eaca6";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1831_1")
pub fragment CC_ART1831_1 in CC_COURANT {
    label fr official "Article 1831-1";
    kind article;
    locator "article/1831-1";
    text fr official """Article 1831-1
Le contrat de promotion immobilière est un mandat d'intérêt commun par lequel une personne dite " promoteur immobilier " s'oblige envers le maître d'un ouvrage à faire procéder, pour un prix convenu, au moyen de contrats de louage d'ouvrage, à la réalisation d'un programme de construction d'un ou de plusieurs édifices ainsi qu'à procéder elle-même ou à faire procéder, moyennant une rémunération convenue, à tout ou partie des opérations juridiques, administratives et financières concourant au même objet. Ce promoteur est garant de l'exécution des obligations mises à la charge des personnes avec lesquelles il a traité au nom du maître de l'ouvrage. Il est notamment tenu des obligations résultant des articles 1792, 1792-1, 1792-2 et 1792-3 du présent code.
Si le promoteur s'engage à exécuter lui-même partie des opérations du programme, il est tenu, quant à ces opérations, des obligations d'un locateur d'ouvrage.
""";
    content_hash "sha256:f8fff953f87b9f730e73f86aedcb80c889028fc0db5ab83ae75582a1e13336c0";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1831_2")
pub fragment CC_ART1831_2 in CC_COURANT {
    label fr official "Article 1831-2";
    kind article;
    locator "article/1831-2";
    text fr official """Article 1831-2
Le contrat emporte pouvoir pour le promoteur de conclure les contrats, recevoir les travaux, liquider les marchés et généralement celui d'accomplir, à concurrence du prix global convenu, au nom du maître de l'ouvrage, tous les actes qu'exige la réalisation du programme.
Toutefois, le promoteur n'engage le maître de l'ouvrage, par les emprunts qu'il contracte ou par les actes de disposition qu'il passe, qu'en vertu d'un mandat spécial contenu dans le contrat ou dans un acte postérieur.
Le maître de l'ouvrage est tenu d'exécuter les engagements contractés en son nom par le promoteur en vertu des pouvoirs que celui-ci tient de la loi ou de la convention.
""";
    content_hash "sha256:b23fc8c1f2d0aedc64aa3923fc8f5fca3c2be799b5d2d88e9e7af690cf593adb";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1831_3")
pub fragment CC_ART1831_3 in CC_COURANT {
    label fr official "Article 1831-3";
    kind article;
    locator "article/1831-3";
    text fr official """Article 1831-3
Si, avant l'achèvement du programme, le maître de l'ouvrage cède les droits qu'il a sur celui-ci, le cessionnaire lui est substitué de plein droit, activement et passivement, dans l'ensemble du contrat. Le cédant est garant de l'exécution des obligations mises à la charge du maître de l'ouvrage par le contrat cédé.
Les mandats spéciaux donnés au promoteur se poursuivent entre celui-ci et le cessionnaire.
Le promoteur ne peut se substituer un tiers dans l'exécution des obligations qu'il a contractées envers le maître de l'ouvrage sans l'accord de celui-ci.
Le contrat de promotion immobilière n'est opposable aux tiers qu'à partir de la date de sa mention au fichier immobilier.
""";
    content_hash "sha256:6054cfe55e98ad176f84fca6b2181acc84f3bbb73944af37ad93e2da0c3a5e44";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1831_4")
pub fragment CC_ART1831_4 in CC_COURANT {
    label fr official "Article 1831-4";
    kind article;
    locator "article/1831-4";
    text fr official """Article 1831-4
La mission du promoteur ne s'achève à la livraison de l'ouvrage que si les comptes de construction ont été définitivement arrêtés entre le maître de l'ouvrage et le promoteur, le tout sans préjudicier aux actions en responsabilité qui peuvent appartenir au maître de l'ouvrage contre le promoteur.
""";
    content_hash "sha256:7cdca7b7e0ab1cdefd486db05258115705a863fae6aa17c10ba1dc735ea85d47";
}

@id("urn:fr:corpus:clir:code-civil-vente-louage#CC_ART1831_5")
pub fragment CC_ART1831_5 in CC_COURANT {
    label fr official "Article 1831-5";
    kind article;
    locator "article/1831-5";
    text fr official """Article 1831-5
Le règlement judiciaire ou la liquidation des biens n'entraîne pas de plein droit la résiliation du contrat de promotion immobilière. Toute stipulation contraire est réputée non écrite.
""";
    content_hash "sha256:23618f486d9a38e2f652622e22f3a4048032e8e0de2cac7d1b7ca55de8347a0d";
}

// END GENERATED FRAGMENTS
