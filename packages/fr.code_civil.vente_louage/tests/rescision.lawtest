language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

test "urn:query:fr-code-civil-vente-louage-rescision-sous-cinq-douziemes" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_VENTE_LOUAGE_AN; }
        assert "i": vente_immobiliere(entity_ref("urn:fr:cc12:r:v")) { origin case_input; }
        assert "v": valeur_de_l_immeuble_a_la_vente(entity_ref("urn:fr:cc12:r:v"), 120000 EUR) { origin case_input; }
        assert "p": prix_paye(entity_ref("urn:fr:cc12:r:v"), 49999 EUR) { origin case_input; }
    }
    evaluate truth(lesion_superieure_a_sept_douziemes(entity_ref("urn:fr:cc12:r:v")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

