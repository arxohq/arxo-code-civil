// Article 1792-4-1 : la décharge décennale elle-même, gardée par une paire —
// la date d'échéance exacte et le jour suivant. Sans cette paire, la mutation
// « dix ans → neuf ans » ne faisait rougir aucun témoin de cette famille.

test "urn:query:fr-code-civil-vente-louage-1792-4-1-decharge-au-jour-exact" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_VENTE_LOUAGE_AN; }
        assert "rec": reception_ouvrage_le(entity_ref("urn:fr:cc12:d1:m"), @2015-03-10) { origin case_input; }
    }
    evaluate truth(constructeur_decharge_responsabilite_decennale_le(entity_ref("urn:fr:cc12:d1:m"), @2025-03-10));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

test "urn:query:fr-code-civil-vente-louage-1792-4-1-decharge-pas-un-jour-plus-tot" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_VENTE_LOUAGE_AN; }
        assert "rec": reception_ouvrage_le(entity_ref("urn:fr:cc12:d2:m"), @2015-03-10) { origin case_input; }
    }
    evaluate truth(constructeur_decharge_responsabilite_decennale_le(entity_ref("urn:fr:cc12:d2:m"), @2025-03-09));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
    evaluate truth(constructeur_decharge_responsabilite_decennale_le(entity_ref("urn:fr:cc12:d2:m"), @2025-03-11));
    expect truth_status == NEITHER;
}
