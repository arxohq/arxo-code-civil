test "urn:positions:fr-code-civil-vente-louage-1831-2-engagement-first" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "contract": contrat_de_promotion_en_vigueur(entity_ref("urn:fr:cc12:p:pos1")) { origin case_input; }
        assert "promoter": promoteur(entity_ref("urn:fr:cc12:p:pos1"), entity_ref("urn:fr:cc12:p:promoter1")) { origin case_input; }
        assert "owner": maitre_de_promotion(entity_ref("urn:fr:cc12:p:pos1"), entity_ref("urn:fr:cc12:p:owner1")) { origin case_input; }
        assert "valid": engagement_valablement_contracte_au_nom_du_maitre(entity_ref("urn:fr:cc12:p:pos1")) { origin case_input; }
    }
    evaluate positions();
    expect position(ExecuterEngagementDuPromoteur, ACTIVE);
}

