language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Garantie d'éviction (articles 1625 à 1640). Chaque norme est gardée par une
// paire : le cas où elle joue, et le cas voisin où l'une de ses conditions
// manque. Les montants sont en euros et sur des valeurs 10-lisses.

test "urn:query:fr-code-civil-vente-louage-eviction-garantie-de-droit" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "sale": vente_en_vigueur(entity_ref("urn:fr:cc12:e1:v")) { origin case_input; }
        assert "ev": eviction_subie_en_totalite(entity_ref("urn:fr:cc12:e1:v")) { origin adjudicated; }
    }
    evaluate truth(garantie_d_eviction_due(entity_ref("urn:fr:cc12:e1:v")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

