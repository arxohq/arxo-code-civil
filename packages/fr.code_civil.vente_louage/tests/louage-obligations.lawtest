        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "lease": bail_en_vigueur(entity_ref("urn:fr:cc12:q:pos1734")) { origin case_input; }
        assert "lessee": preneur(entity_ref("urn:fr:cc12:q:pos1734"), entity_ref("urn:fr:cc12:q:lessee1734")) { origin case_input; }
        assert "lessor": bailleur(entity_ref("urn:fr:cc12:q:pos1734"), entity_ref("urn:fr:cc12:q:lessor1734")) { origin case_input; }
        assert "fire": incendie_survenu(entity_ref("urn:fr:cc12:q:pos1734")) { origin case_input; }
        assert "many": plusieurs_locataires(entity_ref("urn:fr:cc12:q:pos1734")) { origin case_input; }
        assert "origin": incendie_commence_chez_un_locataire(entity_ref("urn:fr:cc12:q:pos1734"), entity_ref("urn:fr:cc12:q:lessee1734")) { origin case_input; }
    }
    evaluate positions();
    expect position(P4DevoirAssumerIncendieSeul1734Actif, ACTIVE);
}

