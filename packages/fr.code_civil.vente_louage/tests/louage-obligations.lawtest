language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Louage des choses : qualification, troubles, responsabilité du preneur, fin
// du bail, vente de la chose louée, réparations. Montants 10-lisses :
// l'indemnité du fermier de l'article 1746 est le tiers de 36 000 EUR, soit
// 12 000 EUR — et 15 000 EUR est rejeté.

test "urn:query:fr-code-civil-vente-louage-1709-qualification" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "l": bailleur(entity_ref("urn:fr:cc12:q1:b"), entity_ref("urn:fr:cc12:q1:l")) { origin case_input; }
        assert "p": preneur(entity_ref("urn:fr:cc12:q1:b"), entity_ref("urn:fr:cc12:q1:p")) { origin case_input; }
        assert "c": chose_louee(entity_ref("urn:fr:cc12:q1:b"), entity_ref("urn:fr:cc12:q1:c")) { origin case_input; }
        assert "j": obligation_de_faire_jouir_pendant_un_certain_temps(entity_ref("urn:fr:cc12:q1:b")) { origin case_input; }
        assert "pr": prix_du_bail_convenu(entity_ref("urn:fr:cc12:q1:b"), 9000 EUR) { origin case_input; }
    }
    evaluate truth(louage_de_choses_qualifie(entity_ref("urn:fr:cc12:q1:b")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

