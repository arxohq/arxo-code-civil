language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Vices cachés (1642 à 1647), résolution stipulée (1656), faculté de rachat
// (1659 à 1673) et rescision pour lésion (1677 à 1685). Les montants sont
// 10-lisses : 120 000 EUR de valeur, 45 000 EUR de prix — la lésion est de
// plus de sept douzièmes (45 000 × 12 = 540 000 < 120 000 × 5 = 600 000), et
// le supplément de l'article 1681 vaut 120 000 × 9/10 − 45 000 = 63 000 EUR.

test "urn:query:fr-code-civil-vente-louage-vice-apparent-non-garanti" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "v": vice_de_la_chose(entity_ref("urn:fr:cc12:x1:v"), entity_ref("urn:fr:cc12:x1:x")) { origin case_input; }
        assert "app": vice_apparent(entity_ref("urn:fr:cc12:x1:v"), entity_ref("urn:fr:cc12:x1:x")) { origin case_input; }
    }
    evaluate truth(vendeur_non_tenu_des_vices_apparents(entity_ref("urn:fr:cc12:x1:v"), entity_ref("urn:fr:cc12:x1:x")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

