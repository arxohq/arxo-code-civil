language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

test "urn:query:one-sale-four-canons-code-civil" {
    given {
        context { legal_time @2026-09-20; decision_time @2026-09-20T09:00:00Z; knowledge_time @2026-09-20T09:00:00Z; timezone "Europe/Paris"; }
        assert "sale": vente_en_vigueur(entity_ref("urn:case:one-sale-2026")) { origin case_input; }
        assert "seller": vendeur(entity_ref("urn:case:one-sale-2026"), entity_ref("urn:case:one-sale-2026:seller")) { origin case_input; }
        assert "buyer": acheteur(entity_ref("urn:case:one-sale-2026"), entity_ref("urn:case:one-sale-2026:buyer")) { origin case_input; }
    }
    evaluate positions();
    expect position(ExpliquerClairementLesObligations, ACTIVE);
    expect position(GarantirLaChoseVendue, ACTIVE);
}
