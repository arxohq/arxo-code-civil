language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

test "urn:positions:fr-code-civil-vente-louage-e0179-1811-part-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "lessee": preneur_de_cheptel(entity_ref("urn:fr:cc12:e0179:1811f:c"), entity_ref("urn:fr:cc12:e0179:1811f:p")) { origin case_input; }
        assert "stipulation": stipulation_de_part_de_perte_superieure_au_profit(entity_ref("urn:fr:cc12:e0179:1811f:c")) { origin case_input; }
    }
    evaluate positions();
    expect position(NePasStipulerPartSuperieure, ACTIVE);
}

test "urn:positions:fr-code-civil-vente-louage-e0179-1811-prelevement-third" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "lessee": preneur_de_cheptel(entity_ref("urn:fr:cc12:e0179:1811g:c"), entity_ref("urn:fr:cc12:e0179:1811g:p")) { origin case_input; }
        assert "stipulation": stipulation_de_prelevement_supplementaire_du_bailleur(entity_ref("urn:fr:cc12:e0179:1811g:c")) { origin case_input; }
    }
    evaluate positions();
    expect position(NePasPreleverSupplementCheptel, ACTIVE);
}
