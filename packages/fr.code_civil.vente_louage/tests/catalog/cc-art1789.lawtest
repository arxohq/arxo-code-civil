language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-PERTETRAVAILSEULFAUTE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": ouvrier_du_marche(entity_ref("urn:law:catalog:pertetravailseulfaute:v0"), entity_ref("urn:law:catalog:pertetravailseulfaute:v1")) { origin case_input; }
        assert "cat-1": travail_seul_fourni(entity_ref("urn:law:catalog:pertetravailseulfaute:v0")) { origin case_input; }
        assert "cat-2": faute_de_l_ouvrier_etablie(entity_ref("urn:law:catalog:pertetravailseulfaute:v0")) { origin case_input; }
        assert "cat-3": chose_du_marche_perie_avant_livraison(entity_ref("urn:law:catalog:pertetravailseulfaute:v0")) { origin case_input; }
    }
    evaluate truth(ouvrier_responsable_de_la_perte(entity_ref("urn:law:catalog:pertetravailseulfaute:v0")));
    expect truth_status == TRUE_ONLY;
}
