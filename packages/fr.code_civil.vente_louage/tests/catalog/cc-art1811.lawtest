language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-POSITIONDEVOIRMAINTENIRNULLITEPARTSUPERIEURE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": stipulation_de_part_de_perte_superieure_au_profit(entity_ref("urn:law:catalog:positiondevoirmaintenirnullitepartsuperieure:v0")) { origin case_input; }
        assert "cat-1": preneur_de_cheptel(entity_ref("urn:law:catalog:positiondevoirmaintenirnullitepartsuperieure:v0"), entity_ref("urn:law:catalog:positiondevoirmaintenirnullitepartsuperieure:v1")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(MaintenirNullitePartSuperieure, ACTIVE);
}

// 
test "CATALOG-POSITIONDEVOIRMAINTENIRNULLITEPRELEVEMENT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": preneur_de_cheptel(entity_ref("urn:law:catalog:positiondevoirmaintenirnulliteprelevement:v0"), entity_ref("urn:law:catalog:positiondevoirmaintenirnulliteprelevement:v1")) { origin case_input; }
        assert "cat-1": stipulation_de_prelevement_supplementaire_du_bailleur(entity_ref("urn:law:catalog:positiondevoirmaintenirnulliteprelevement:v0")) { origin case_input; }
    }
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect position(MaintenirNullitePrelevement, ACTIVE);
}
