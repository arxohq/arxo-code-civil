language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-REPARATIONECARTERESOLUTIONOUDIMINUTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": vendeur_s_oblige_a_reparer_vices_apparents(entity_ref("urn:law:catalog:reparationecarteresolutionoudiminution:v0")) { origin case_input; }
        assert "cat-1": vente_d_immeuble_a_construire(entity_ref("urn:law:catalog:reparationecarteresolutionoudiminution:v0")) { origin case_input; }
    }
    evaluate truth(resolution_ou_diminution_exclue_par_reparation(entity_ref("urn:law:catalog:reparationecarteresolutionoudiminution:v0")));
    expect truth_status == TRUE_ONLY;
}
