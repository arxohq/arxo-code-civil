language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-LIEUDEDELIVRANCEPARDEFAUT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": absence_de_lieu_de_delivrance_convenu(entity_ref("urn:law:catalog:lieudedelivrancepardefaut:v0")) { origin case_input; }
        assert "cat-1": lieu_de_la_chose_au_jour_de_la_vente(entity_ref("urn:law:catalog:lieudedelivrancepardefaut:v0"), entity_ref("urn:law:catalog:lieudedelivrancepardefaut:v1")) { origin case_input; }
    }
    evaluate truth(lieu_de_delivrance_applicable(entity_ref("urn:law:catalog:lieudedelivrancepardefaut:v0"), entity_ref("urn:law:catalog:lieudedelivrancepardefaut:v1")));
    expect truth_status == TRUE_ONLY;
}
