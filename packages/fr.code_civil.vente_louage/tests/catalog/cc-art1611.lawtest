language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-DOMMAGESINTERETSPOURDEFAUTDEDELIVRANCE" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": delivrance_non_faite_au_terme_convenu(entity_ref("urn:law:catalog:dommagesinteretspourdefautdedelivrance:v0")) { origin case_input; }
        assert "cat-1": prejudice_du_defaut_de_delivrance(entity_ref("urn:law:catalog:dommagesinteretspourdefautdedelivrance:v0")) { origin case_input; }
    }
    evaluate truth(dommages_interets_dus_pour_defaut_de_delivrance(entity_ref("urn:law:catalog:dommagesinteretspourdefautdedelivrance:v0")));
    expect truth_status == TRUE_ONLY;
}
