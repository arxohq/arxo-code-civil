language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

test "urn:query:fr-code-civil-vente-louage-echange-reciproque" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "a": echangiste_premier(entity_ref("urn:fr:cc12:e:x"), entity_ref("urn:fr:cc12:e:a")) { origin case_input; }
        assert "b": echangiste_second(entity_ref("urn:fr:cc12:e:x"), entity_ref("urn:fr:cc12:e:b")) { origin case_input; }
        assert "x": chose_remise_par_premier(entity_ref("urn:fr:cc12:e:x"), entity_ref("urn:fr:cc12:e:c1")) { origin case_input; }
        assert "y": chose_remise_par_second(entity_ref("urn:fr:cc12:e:x"), entity_ref("urn:fr:cc12:e:c2")) { origin case_input; }
        assert "consent": consentement_reciproque_a_l_echange(entity_ref("urn:fr:cc12:e:x")) { origin case_input; }
    }
    evaluate truth(echange_parfait(entity_ref("urn:fr:cc12:e:x")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

test "urn:query:fr-code-civil-vente-louage-echange-par-seul-consentement" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "consent": consentement_reciproque_a_l_echange(entity_ref("urn:fr:cc12:e:c")) { origin case_input; }
    }
