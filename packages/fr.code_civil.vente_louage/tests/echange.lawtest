    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

test "urn:positions:fr-code-civil-vente-louage-1704-refus" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "holder": copermutant_protege_par_article_1704(entity_ref("urn:fr:cc12:pos1704:e"), entity_ref("urn:fr:cc12:pos1704:p")) { origin case_input; }
        assert "received": chose_recue_en_echange(entity_ref("urn:fr:cc12:pos1704:e")) { origin case_input; }
        assert "nonowner": autre_contractant_non_proprietaire_prouve(entity_ref("urn:fr:cc12:pos1704:e")) { origin case_input; }
    }
    evaluate positions();
    expect position(RefuserLivraisonNonProprietaire, ACTIVE);
}

test "urn:positions:fr-code-civil-vente-louage-1704-refus-exerce" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "holder": copermutant_protege_par_article_1704(entity_ref("urn:fr:cc12:pos1704b:e"), entity_ref("urn:fr:cc12:pos1704b:p")) { origin case_input; }
        assert "received": chose_recue_en_echange(entity_ref("urn:fr:cc12:pos1704b:e")) { origin case_input; }
        assert "nonowner": autre_contractant_non_proprietaire_prouve(entity_ref("urn:fr:cc12:pos1704b:e")) { origin case_input; }
        assert "refused": livraison_refusee_pour_non_propriete(entity_ref("urn:fr:cc12:pos1704b:e")) { origin case_input; }
    }
    evaluate positions();
    expect position(RefuserLivraisonNonProprietaire, ACTIVE);
}

