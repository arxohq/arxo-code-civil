test "urn:positions:fr-code-civil-vente-louage-e0179-1697-remboursement-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "estate": vente_d_une_succession_sans_specifier_les_objets(entity_ref("urn:fr:cc12:e0179:1697:t2")) { origin case_input; }
        assert "assignor": cedant(entity_ref("urn:fr:cc12:e0179:1697:t2"), entity_ref("urn:fr:cc12:e0179:1697:c2")) { origin case_input; }
        assert "assignee": cessionnaire(entity_ref("urn:fr:cc12:e0179:1697:t2"), entity_ref("urn:fr:cc12:e0179:1697:a2")) { origin case_input; }
        assert "fruits": vendeur_a_profite_des_fruits_ou_creances_de_la_succession(entity_ref("urn:fr:cc12:e0179:1697:t2")) { origin case_input; }
        assert "unreserved": fruits_ou_creances_non_reserves(entity_ref("urn:fr:cc12:e0179:1697:t2")) { origin case_input; }
