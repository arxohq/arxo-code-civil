language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

test "urn:positions:fr-code-civil-vente-louage-e0179-1693-garantie-existence-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "right": vente_d_un_droit_incorporel(entity_ref("urn:fr:cc12:e0179:1693:t2")) { origin case_input; }
        assert "assignor": cedant(entity_ref("urn:fr:cc12:e0179:1693:t2"), entity_ref("urn:fr:cc12:e0179:1693:c2")) { origin case_input; }
        assert "assignee": cessionnaire(entity_ref("urn:fr:cc12:e0179:1693:t2"), entity_ref("urn:fr:cc12:e0179:1693:a2")) { origin case_input; }
    }
    evaluate positions();
    expect position(P4DevoirGarantirExistenceDroit1693Actif, ACTIVE);
}

