        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "farmer": fermier_sortant(entity_ref("urn:fr:cc12:pos1769b:b"), entity_ref("urn:fr:cc12:pos1769b:p")) { origin case_input; }
        assert "multi": bail_a_ferme_pluriannuel(entity_ref("urn:fr:cc12:pos1769b:b")) { origin case_input; }
        assert "loss": perte_atteint_la_moitie_de_la_recolte(entity_ref("urn:fr:cc12:pos1769b:b")) { origin case_input; }
        assert "claim": demande_remise_du_prix_par_fermier(entity_ref("urn:fr:cc12:pos1769b:b")) { origin case_input; }
    }
    evaluate positions();
    expect position(PouvoirRemisePrixFermier, ACTIVE);
}

