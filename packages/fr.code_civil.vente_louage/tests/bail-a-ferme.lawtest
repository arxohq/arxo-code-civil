// Bail à ferme (1764 à 1778). La moitié de récolte est gardée par une paire
// exacte : sur 100 unités, 50 perdues atteignent la moitié (50 × 2 = 100 ≥ 100)
// et 49 ne l'atteignent pas (49 × 2 = 98 < 100).

test "urn:query:fr-code-civil-vente-louage-1764-contravention-rentree-en-jouissance" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "f": bail_a_ferme(entity_ref("urn:fr:cc12:r1:b")) { origin case_input; }
        assert "c": contravention_du_preneur_rural(entity_ref("urn:fr:cc12:r1:b")) { origin adjudicated; }
    }
    evaluate truth(proprietaire_peut_rentrer_en_jouissance(entity_ref("urn:fr:cc12:r1:b")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    evaluate truth(dommages_interets_de_l_inexecution_du_bail(entity_ref("urn:fr:cc12:r1:b")));
    expect truth_status == TRUE_ONLY;
}

