    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "a": animaux_susceptibles_de_croit_ou_de_profit(entity_ref("urn:fr:cc12:c1:c")) { origin case_input; }
        assert "f": fonds_de_betail_remis(entity_ref("urn:fr:cc12:c1:c")) { origin case_input; }
    }
    evaluate truth(cheptel_qualifie(entity_ref("urn:fr:cc12:c1:c")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    evaluate truth(regles_suppletives_du_cheptel_applicables(entity_ref("urn:fr:cc12:c1:c")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(laitages_fumier_et_travail_au_preneur(entity_ref("urn:fr:cc12:c1:c")));
    expect truth_status == TRUE_ONLY;
    evaluate truth(laine_et_croit_partages(entity_ref("urn:fr:cc12:c1:c")));
    expect truth_status == TRUE_ONLY;
}

