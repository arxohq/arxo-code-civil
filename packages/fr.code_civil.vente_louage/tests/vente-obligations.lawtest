test "urn:query:fr-code-civil-vente-louage-obligations-vendeur-actives" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "sale": vente_en_vigueur(entity_ref("urn:fr:cc12:vo:v1")) { origin case_input; }
        assert "seller": vendeur(entity_ref("urn:fr:cc12:vo:v1"), entity_ref("urn:fr:cc12:vo:s1")) { origin case_input; }
        assert "buyer": acheteur(entity_ref("urn:fr:cc12:vo:v1"), entity_ref("urn:fr:cc12:vo:a1")) { origin case_input; }
    }
    evaluate positions();
    expect position(ExpliquerClairementLesObligations, ACTIVE);
    expect position(GarantirLaChoseVendue, ACTIVE);
    expect position(DelivrerAccessoiresEtUsagePerpetuel, ACTIVE);
}

