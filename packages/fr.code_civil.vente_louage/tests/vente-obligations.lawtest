        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "sale": vente_en_vigueur(entity_ref("urn:fr:cc12:vo:v5")) { origin case_input; }
        assert "seller": vendeur(entity_ref("urn:fr:cc12:vo:v5"), entity_ref("urn:fr:cc12:vo:s5")) { origin case_input; }
        assert "buyer": acheteur(entity_ref("urn:fr:cc12:vo:v5"), entity_ref("urn:fr:cc12:vo:a5")) { origin case_input; }
        assert "terms": jour_et_lieu_du_paiement_convenus(entity_ref("urn:fr:cc12:vo:v5")) { origin case_input; }
    }
    evaluate positions();
    expect position(PayerLePrixAuJourEtLieuConvenus, ACTIVE);
}

