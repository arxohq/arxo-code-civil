        assert "thing": chose_vendue(entity_ref("urn:fr:cc12:pos1582b:v"), entity_ref("urn:fr:cc12:pos1582b:c")) { origin case_input; }
        assert "price": prix_convenu(entity_ref("urn:fr:cc12:pos1582b:v"), 1000 EUR) { origin case_input; }
        assert "delivered": chose_delivree(entity_ref("urn:fr:cc12:pos1582b:v")) { origin case_input; }
        assert "paid": prix_paye_integralement(entity_ref("urn:fr:cc12:pos1582b:v")) { origin case_input; }
    }
    evaluate positions();
    expect position(DelivrerLaChose, SATISFIED);
    expect position(PayerLePrix, SATISFIED);
}

