language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Formation (1584 à 1601) et contenance (1616 à 1623). Le vingtième est gardé
// par une paire exacte : sur 1000 unités déclarées, 1050 atteint le vingtième
// (50 × 20 = 1000 ≥ 1000) et 1049 ne l'atteint pas (49 × 20 = 980 < 1000).
// Le délai d'un an de l'article 1622 est gardé du jour d'échéance et du jour
// suivant.

test "urn:positions:fr-code-civil-vente-louage-1582-delivery-price" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "seller": vendeur(entity_ref("urn:fr:cc12:pos1582:v"), entity_ref("urn:fr:cc12:pos1582:s")) { origin case_input; }
        assert "buyer": acheteur(entity_ref("urn:fr:cc12:pos1582:v"), entity_ref("urn:fr:cc12:pos1582:a")) { origin case_input; }
        assert "thing": chose_vendue(entity_ref("urn:fr:cc12:pos1582:v"), entity_ref("urn:fr:cc12:pos1582:c")) { origin case_input; }
        assert "price": prix_convenu(entity_ref("urn:fr:cc12:pos1582:v"), 1000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(DelivrerLaChose, ACTIVE);
    expect position(PayerLePrix, ACTIVE);
}

test "urn:positions:fr-code-civil-vente-louage-1582-delivery-price-second" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
