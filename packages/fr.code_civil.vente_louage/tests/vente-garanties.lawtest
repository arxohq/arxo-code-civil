    }
    evaluate truth(vendeur_peut_etre_decharge_le(entity_ref("urn:fr:cc12:g5:v"), @2024-02-10));
    expect truth_status == TRUE_ONLY;
    evaluate truth(action_vices_apparents_recevable(entity_ref("urn:fr:cc12:g5:v")));
