// d'appartement meublé (1758).

test "urn:query:fr-code-civil-vente-louage-1655-danger-resolution-aussitot" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "imm": vente_immobiliere(entity_ref("urn:fr:cc12:t1:v")) { origin case_input; }
        assert "np": acheteur_n_a_pas_paye_le_prix(entity_ref("urn:fr:cc12:t1:v")) { origin case_input; }
        assert "dg": danger_de_perdre_la_chose_et_le_prix(entity_ref("urn:fr:cc12:t1:v")) { origin adjudicated; }
    }
    evaluate truth(resolution_immobiliere_prononcee_aussitot(entity_ref("urn:fr:cc12:t1:v")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    evaluate truth(juge_peut_accorder_un_delai_a_l_acquereur(entity_ref("urn:fr:cc12:t1:v")));
    expect truth_status == NEITHER;
}

