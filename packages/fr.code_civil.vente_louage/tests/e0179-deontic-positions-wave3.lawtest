test "urn:positions:fr-code-civil-vente-louage-e0179-1642-1-reparation-active" {
    given {
        context { decision_time @2026-09-21T09:00:00Z; knowledge_time @2026-09-21T09:00:00Z; legal_time @2026-09-21; timezone "Europe/Paris"; }
        assert "sale": vente_d_immeuble_a_construire(entity_ref("urn:fr:cc12:e0179:1642-1:e:v")) { origin case_input; }
