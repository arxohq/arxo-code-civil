language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";

// Incapacités (1596, 1597), cession de l'acquéreur d'immeuble à construire
// (1601-4), rachat opposé aux tiers (1663, 1664, 1666), marchés à prix fait
// (1799) et cheptel simple (1804). La liste fermée de l'article 1596 est
// gardée par une paire : une qualité de la liste, et un voisin hors liste.

test "urn:query:fr-code-civil-vente-louage-1596-adjudication-du-tuteur-nulle" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; }
        assert "q": adjudicataire_en_qualite(entity_ref("urn:fr:cc12:i1:v"), entity_ref("urn:fr:cc12:i1:p"), Tuteur) { origin case_input; }
    }
    evaluate truth(adjudication_nulle(entity_ref("urn:fr:cc12:i1:v")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}

