// Code civil — Livre III, titres VI à VIII bis (CC-12).
// Le paquet reçoit les faits du contrat et ne remplace ni les lois spéciales du
// logement, ni les régimes matrimoniaux, ni les seuils fixés par décret.

language "law.core" version "0.2";
package fr.code_civil.vente_louage version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-vente-louage";
import fr.code_civil.core version "0.1.0";

type Personne = fr.code_civil.core::Personne;
type Bien = fr.code_civil.core::Bien;

pub entity Vente {
    label fr official "Vente : convention par laquelle l'un s'oblige à livrer une chose, et l'autre à la payer (article 1582)";
    label en unofficial "Sale: agreement by which one party undertakes to deliver a thing and the other to pay for it (Article 1582)";
}
pub entity Bail {
    label fr official "Bail : louage de choses par lequel l'une des parties s'oblige à faire jouir l'autre d'une chose pendant un certain temps (titre VIII, chapitre II)";
    label en unofficial "Lease: hire of things by which one party undertakes to let the other enjoy a thing for a time (Title VIII, Chapter II)";
}
pub entity Marche {
    label fr official "Marché de louage d'ouvrage et d'industrie : devis, marché ou bail à ouvrage (titre VIII, chapitre III)";
    label en unofficial "Contract for work and services: estimate, contract or hire of work (Title VIII, Chapter III)";
}
pub entity Chose : Bien {
    label fr official "Chose qui fait l'objet de la vente ou du louage";
    label en unofficial "Thing forming the object of the sale or of the lease";
}
pub entity Vice {
    label fr official "Défaut caché de la chose vendue, ou vice rédhibitoire (article 1641)";
    label en unofficial "Latent defect of the thing sold, or redhibitory defect (Article 1641)";
}
pub entity PromotionImmobiliere {
    label fr official "Contrat de promotion immobilière : mandat d'intérêt commun de réalisation d'un programme de construction (article 1831-1)";
    label en unofficial "Property development contract: mandate of common interest for carrying out a construction programme (Article 1831-1)";
}
pub entity Echange {
    label fr official "Échange : contrat par lequel les parties se donnent respectivement une chose pour une autre (article 1702)";
    label en unofficial "Exchange: contract by which the parties give each other one thing for another (Article 1702)";
}
pub entity Cheptel {
    label fr official "Bail à cheptel : contrat par lequel l'une des parties donne à l'autre un fonds de bétail (article 1800)";
    label en unofficial "Cattle lease: contract by which one party gives the other a stock of livestock (Article 1800)";
}
pub entity Lieu {
    label fr official "Lieu où la délivrance doit se faire (article 1609)";
    label en unofficial "Place where delivery is to be made (Article 1609)";
}

pub enum OptionVice {
    label fr official "Choix de l'acheteur en cas de vice caché : rendre la chose ou la garder (article 1644)";
    label en unofficial "Buyer's choice in case of a latent defect: return the thing or keep it (Article 1644)";
    RendreLaChose, GarderLaChose
}

pub relation vendeur(v: Vente, p: Personne) kind empirical {
    key(v);
    label fr official "le vendeur, tenu de délivrer et de garantir la chose qu'il vend (articles 1582 et 1603)";
    label en unofficial "the seller, bound to deliver and to warrant the thing sold (Articles 1582 and 1603)";
}
pub relation acheteur(v: Vente, p: Personne) kind empirical {
    key(v);
    label fr official "l'acheteur, tenu de payer le prix au jour et au lieu réglés par la vente (articles 1582 et 1650)";
    label en unofficial "the buyer, bound to pay the price on the day and at the place fixed by the sale (Articles 1582 and 1650)";
}
pub relation chose_vendue(v: Vente, c: Chose) kind empirical {
    key(v);
    label fr official "la chose que le vendeur s'oblige à livrer (article 1582)";
    label en unofficial "the thing the seller undertakes to deliver (Article 1582)";
}
pub relation prix_convenu(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "le prix que l'acheteur s'oblige à payer, déterminé et désigné par les parties (articles 1582 et 1591)";
    label en unofficial "the price the buyer undertakes to pay, determined and designated by the parties (Articles 1582 and 1591)";
}
pub relation vente_immobiliere(v: Vente) kind empirical {
    label fr official "la vente porte sur un immeuble (article 1674)";
    label en unofficial "the sale concerns immovable property (Article 1674)";
}
pub relation vente_mobiliere_ou_denrees(v: Vente) kind empirical {
    label fr official "la vente porte sur des denrées et effets mobiliers (article 1657)";
    label en unofficial "the sale concerns foodstuffs and movable effects (Article 1657)";
}
pub relation vente_judiciaire(v: Vente) kind empirical {
    label fr official "la vente est faite par autorité de justice (article 1649)";
    label en unofficial "the sale is made by judicial authority (Article 1649)";
}
pub relation vente_non_judiciaire(v: Vente) kind empirical {
    label fr official "la vente n'est pas faite par autorité de justice (article 1649 a contrario)";
    label en unofficial "the sale is not made by judicial authority (Article 1649 a contrario)";
}
pub relation vente_conclue_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour de la vente, d'où court le délai de rescision (article 1676)";
    label en unofficial "day of the sale, from which the rescission period runs (Article 1676)";
}
pub relation vice_de_la_chose(v: Vente, x: Vice) kind empirical {
    label fr official "défaut caché de la chose vendue invoqué par l'acheteur (article 1641)";
    label en unofficial "latent defect of the thing sold invoked by the buyer (Article 1641)";
}
pub relation vice_decouvert_le(v: Vente, x: Vice, d: Date) kind empirical {
    key(v, x);
    label fr official "jour de la découverte du vice, d'où court le délai de deux ans (article 1648, alinéa 1)";
    label en unofficial "day the defect was discovered, from which the two-year period runs (Article 1648, first paragraph)";
}
pub relation vice_rend_impropre_a_l_usage(v: Vente, x: Vice) kind empirical {
    label fr official "le défaut rend la chose impropre à l'usage auquel on la destine (article 1641)";
    label en unofficial "the defect makes the thing unfit for the use for which it is intended (Article 1641)";
}
pub relation vice_diminue_tellement_l_usage(v: Vente, x: Vice) kind empirical {
    label fr official "le défaut diminue tellement l'usage de la chose (article 1641)";
    label en unofficial "the defect so diminishes the use of the thing (Article 1641)";
}
pub relation acheteur_n_aurait_pas_acquis_ou_aurait_paye_moins(v: Vente, x: Vice) kind empirical {
    label fr official "l'acheteur n'aurait pas acquis la chose, ou n'en aurait donné qu'un moindre prix, s'il avait connu le défaut (article 1641)";
    label en unofficial "the buyer would not have bought the thing, or would have given a lesser price, had he known of the defect (Article 1641)";
}
pub relation vice_connu_de_l_acheteur(v: Vente, x: Vice) kind empirical {
    label fr official "le vice était apparent et l'acheteur a pu s'en convaincre lui-même (article 1642)";
    label en unofficial "the defect was apparent and the buyer could see it for himself (Article 1642)";
}
pub relation vice_non_connu_de_l_acheteur(v: Vente, x: Vice) kind empirical {
    label fr official "le défaut était caché pour l'acheteur (article 1641)";
    label en unofficial "the defect was latent as regards the buyer (Article 1641)";
}
pub relation action_en_garantie_introduite_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour où l'acquéreur a intenté l'action résultant des vices rédhibitoires (article 1648, alinéa 1)";
    label en unofficial "day the buyer brought the action arising from redhibitory defects (Article 1648, first paragraph)";
}
pub relation vente_d_immeuble_a_construire(v: Vente) kind empirical {
    label fr official "la vente est une vente d'immeuble à construire (articles 1601-1 et 1642-1)";
    label en unofficial "the sale is a sale of a building to be constructed (Articles 1601-1 and 1642-1)";
}
pub relation reception_des_travaux_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour de la réception des travaux de l'immeuble à construire (article 1642-1)";
    label en unofficial "day of acceptance of the works on the building to be constructed (Article 1642-1)";
}
pub relation prise_de_possession_par_acquereur_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour de la prise de possession par l'acquéreur (article 1642-1)";
    label en unofficial "day the buyer took possession (Article 1642-1)";
}
pub relation vendeur_peut_etre_decharge_le(v: Vente, d: Date) kind derived {
    key(v);
    label fr official "jour à partir duquel le vendeur d'un immeuble à construire peut être déchargé des vices apparents : un mois après la prise de possession, la réception étant faite (article 1642-1, alinéa 1)";
    label en unofficial "day from which the seller of a building to be constructed may be discharged of apparent defects: one month after the taking of possession, acceptance having occurred (Article 1642-1, first paragraph)";
}
pub relation action_vices_apparents_introduite_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour où l'action relative aux vices apparents de l'immeuble à construire a été introduite (article 1648, alinéa 2)";
    label en unofficial "day the action concerning apparent defects of the building to be constructed was brought (Article 1648, second paragraph)";
}
pub relation action_vices_apparents_recevable(v: Vente) kind derived {
    label fr official "l'action relative aux vices apparents est introduite dans l'année suivant la date de décharge, à peine de forclusion (article 1648, alinéa 2)";
    label en unofficial "the action concerning apparent defects is brought within the year following the discharge date, on pain of foreclosure (Article 1648, second paragraph)";
}
pub relation vendeur_s_oblige_a_reparer_vices_apparents(v: Vente) kind empirical {
    label fr official "le vendeur d'un immeuble à construire s'oblige à réparer les vices ou défauts apparents (article 1642-1, alinéa 2)";
    label en unofficial "the seller of a building to be constructed undertakes to repair the apparent defects or non-conformities (Article 1642-1, second paragraph)";
}
pub relation resolution_ou_diminution_exclue_par_reparation(v: Vente) kind derived {
    label fr official "il n'y a pas lieu à résolution du contrat ou à diminution du prix si le vendeur s'oblige à réparer (article 1642-1, alinéa 2)";
    label en unofficial "there is no ground for rescission of the contract or reduction of the price if the seller undertakes to repair (Article 1642-1, second paragraph)";
}
pub relation valeur_de_l_immeuble_a_la_vente(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "valeur de l'immeuble estimée suivant son état et sa valeur au moment de la vente (article 1675, alinéa 1)";
    label en unofficial "value of the building estimated according to its condition and value at the time of the sale (Article 1675, first paragraph)";
}
pub relation prix_paye(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "prix reçu par le vendeur, comparé à la valeur de l'immeuble pour mesurer la lésion (articles 1674 et 1675)";
    label en unofficial "price received by the seller, compared with the value of the building to measure the injury (Articles 1674 and 1675)";
}
pub relation action_en_rescision_introduite_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour où la demande en rescision pour lésion a été formée (article 1676, alinéa 1)";
    label en unofficial "day the claim for rescission for injury was brought (Article 1676, first paragraph)";
}
pub relation pacte_de_rachat_en_cours(v: Vente) kind empirical {
    label fr official "un pacte de rachat est stipulé et court encore (article 1676, alinéa 2)";
    label en unofficial "a right of redemption is stipulated and is still running (Article 1676, second paragraph)";
}
pub relation delai_de_rescision_non_suspendu(v: Vente) kind derived {
    label fr official "le délai de deux ans court et n'est pas suspendu pendant la durée du temps stipulé pour le pacte de rachat (article 1676, alinéa 2)";
    label en unofficial "the two-year period runs and is not suspended during the time stipulated for the right of redemption (Article 1676, second paragraph)";
}
pub relation demande_de_rescision_par_acheteur(v: Vente) kind empirical {
    label fr official "la rescision pour lésion est demandée par l'acheteur (article 1683)";
    label en unofficial "rescission for injury is claimed by the buyer (Article 1683)";
}
pub relation rescision_acheteur_exclue(v: Vente) kind derived {
    label fr official "la rescision pour lésion n'a pas lieu en faveur de l'acheteur (article 1683)";
    label en unofficial "rescission for injury does not lie in favour of the buyer (Article 1683)";
}
pub relation terme_de_rachat_stipule_en_annees(v: Vente, n: Integer) kind empirical {
    key(v);
    label fr official "terme en années stipulé pour la faculté de rachat (article 1660, alinéa 1)";
    label en unofficial "term in years stipulated for the right of redemption (Article 1660, first paragraph)";
}
pub relation terme_de_rachat_applicable_en_annees(v: Vente, n: Integer) kind derived {
    key(v);
    label fr official "terme applicable de la faculté de rachat, réduit à cinq années si un terme plus long a été stipulé (article 1660)";
    label en unofficial "applicable term of the right of redemption, reduced to five years if a longer term was stipulated (Article 1660)";
}
pub relation date_de_delivrance(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour où la délivrance a été faite ou doit se faire (article 1610)";
    label en unofficial "day delivery was made or is to be made (Article 1610)";
}
pub relation date_de_paiement(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour où le prix a été payé ou doit l'être (article 1650)";
    label en unofficial "day the price was paid or is to be paid (Article 1650)";
}
pub relation vente_en_vigueur(v: Vente) kind empirical {
    label fr official "la vente est formée et produit ses effets entre les parties (article 1583)";
    label en unofficial "the sale is formed and produces its effects between the parties (Article 1583)";
}
pub relation obligations_du_vendeur_clairement_expliquees(v: Vente) kind empirical {
    label fr official "le vendeur a expliqué clairement ce à quoi il s'oblige (article 1602, alinéa 1)";
    label en unofficial "the seller has clearly explained what he binds himself to (Article 1602, first paragraph)";
}
pub relation garantie_de_la_chose_assuree(v: Vente) kind empirical {
    label fr official "le vendeur assure la garantie de la chose qu'il vend (article 1603)";
    label en unofficial "the seller provides the warranty of the thing he sells (Article 1603)";
}
pub relation garantie_de_la_chose_fournie(v: Vente) kind empirical {
    label fr official "le vendeur a fourni la garantie de la chose vendue (article 1625)";
    label en unofficial "the seller provided the warranty of the thing sold (Article 1625)";
}
pub relation frais_de_delivrance_supportes_par_vendeur(v: Vente) kind derived {
    label fr official "les frais de la délivrance sont à la charge du vendeur (article 1608)";
    label en unofficial "the costs of delivery are borne by the seller (Article 1608)";
}
pub relation frais_de_delivrance_payes_par_vendeur(v: Vente) kind empirical {
    label fr official "le vendeur a payé les frais de délivrance (article 1608)";
    label en unofficial "the seller paid the delivery costs (Article 1608)";
}
pub relation frais_d_enlevement_supportes_par_acheteur(v: Vente) kind derived {
    label fr official "les frais de l'enlèvement sont à la charge de l'acheteur (article 1608)";
    label en unofficial "the costs of removal are borne by the buyer (Article 1608)";
}
pub relation frais_d_enlevement_payes_par_acheteur(v: Vente) kind empirical {
    label fr official "l'acheteur a payé les frais d'enlèvement (article 1608)";
    label en unofficial "the buyer paid the removal costs (Article 1608)";
}
pub relation absence_de_stipulation_contraire_sur_frais(v: Vente) kind empirical {
    label fr official "il n'y a eu aucune stipulation contraire sur la charge des frais (article 1608)";
    label en unofficial "there was no stipulation to the contrary on who bears the costs (Article 1608)";
}
pub relation lieu_de_la_chose_au_jour_de_la_vente(v: Vente, l: Lieu) kind empirical {
    key(v);
    label fr official "lieu où était la chose au temps de la vente (article 1609)";
    label en unofficial "place where the thing was at the time of the sale (Article 1609)";
}
pub relation lieu_de_delivrance_convenu(v: Vente, l: Lieu) kind empirical {
    key(v);
    label fr official "lieu de délivrance dont les parties sont autrement convenues (article 1609)";
    label en unofficial "place of delivery otherwise agreed by the parties (Article 1609)";
}
pub relation lieu_de_delivrance_applicable(v: Vente, l: Lieu) kind derived {
    key(v);
    label fr official "lieu où la délivrance doit se faire (article 1609)";
    label en unofficial "place where delivery is to be made (Article 1609)";
}
pub relation absence_de_lieu_de_delivrance_convenu(v: Vente) kind empirical {
    label fr official "il n'a pas été autrement convenu du lieu de la délivrance (article 1609)";
    label en unofficial "no other place of delivery was agreed (Article 1609)";
}
pub relation delivrance_non_faite_au_terme_convenu(v: Vente) kind empirical {
    label fr official "le vendeur manque à faire la délivrance dans le temps convenu entre les parties (article 1610)";
    label en unofficial "the seller fails to make delivery within the time agreed between the parties (Article 1610)";
}
pub relation retard_imputable_au_vendeur(v: Vente) kind empirical {
    label fr official "le retard ne vient que du fait du vendeur (article 1610)";
    label en unofficial "the delay arises solely from the seller's own act (Article 1610)";
}
pub relation acheteur_peut_demander_resolution(v: Vente) kind derived {
    label fr official "l'acquéreur peut, à son choix, demander la résolution de la vente (article 1610)";
    label en unofficial "the buyer may, at his choice, claim rescission of the sale (Article 1610)";
}
pub relation acheteur_peut_demander_mise_en_possession(v: Vente) kind derived {
    label fr official "l'acquéreur peut, à son choix, demander sa mise en possession (article 1610)";
    label en unofficial "the buyer may, at his choice, claim to be put in possession (Article 1610)";
}
pub relation demande_resolution_pour_retard(v: Vente) kind empirical {
    label fr official "l'acquéreur a demandé la résolution pour retard de délivrance (article 1610)";
    label en unofficial "the buyer requested termination for delayed delivery (Article 1610)";
}
pub relation demande_mise_en_possession_pour_retard(v: Vente) kind empirical {
    label fr official "l'acquéreur a demandé sa mise en possession pour retard de délivrance (article 1610)";
    label en unofficial "the buyer requested possession for delayed delivery (Article 1610)";
}
pub relation prejudice_du_defaut_de_delivrance(v: Vente) kind empirical {
    label fr official "il résulte un préjudice pour l'acquéreur du défaut de délivrance au terme convenu (article 1611)";
    label en unofficial "the buyer suffers a prejudice from the failure to deliver at the agreed term (Article 1611)";
}
pub relation dommages_interets_dus_pour_defaut_de_delivrance(v: Vente) kind derived {
    label fr official "le vendeur doit être condamné aux dommages et intérêts (article 1611)";
    label en unofficial "the seller must be ordered to pay damages (Article 1611)";
}
pub relation dommages_interets_payes_pour_defaut_de_delivrance(v: Vente) kind empirical {
    label fr official "le vendeur a payé les dommages-intérêts pour défaut de délivrance (article 1611)";
    label en unofficial "the seller paid damages for failure to deliver (Article 1611)";
}
pub relation acheteur_n_a_pas_paye_le_prix(v: Vente) kind empirical {
    label fr official "l'acheteur ne paye pas le prix (articles 1612 et 1654)";
    label en unofficial "the buyer does not pay the price (Articles 1612 and 1654)";
}
pub relation aucun_delai_de_paiement_accorde(v: Vente) kind empirical {
    label fr official "le vendeur n'a pas accordé de délai pour le paiement (article 1612)";
    label en unofficial "the seller has not granted any time for payment (Article 1612)";
}
pub relation acheteur_en_faillite_ou_deconfiture(v: Vente) kind empirical {
    label fr official "depuis la vente, l'acheteur est tombé en faillite ou en état de déconfiture (article 1613)";
    label en unofficial "since the sale, the buyer has become bankrupt or insolvent (Article 1613)";
}
pub relation danger_imminent_de_perdre_le_prix(v: Vente) kind empirical {
    label fr official "le vendeur se trouve en danger imminent de perdre le prix (article 1613)";
    label en unofficial "the seller is in imminent danger of losing the price (Article 1613)";
}
pub relation aucune_caution_de_paiement_au_terme(v: Vente) kind empirical {
    label fr official "l'acheteur ne donne pas caution de payer au terme (article 1613)";
    label en unofficial "the buyer does not give security to pay at term (Article 1613)";
}
pub relation vendeur_peut_suspendre_delivrance(v: Vente) kind derived {
    label fr official "le vendeur n'est pas tenu de délivrer la chose (articles 1612 et 1613)";
    label en unofficial "the seller is not bound to deliver the thing (Articles 1612 and 1613)";
}
pub relation vendeur_a_suspendu_delivrance(v: Vente) kind empirical {
    label fr official "le vendeur a suspendu la délivrance (articles 1612 et 1613)";
    label en unofficial "the seller suspended delivery (Articles 1612 and 1613)";
}
pub relation etat_de_la_chose_au_jour_de_la_vente_respecte(v: Vente) kind empirical {
    label fr official "la chose est délivrée en l'état où elle se trouve au moment de la vente (article 1614, alinéa 1)";
    label en unofficial "the thing is delivered in the condition it is in at the time of the sale (Article 1614, first paragraph)";
}
pub relation fruits_appartiennent_a_l_acheteur(v: Vente) kind derived {
    label fr official "depuis le jour de la vente, tous les fruits appartiennent à l'acquéreur (article 1614, alinéa 2)";
    label en unofficial "from the day of the sale, all fruits belong to the buyer (Article 1614, second paragraph)";
}
pub relation accessoires_et_usage_perpetuel_delivres(v: Vente) kind empirical {
    label fr official "l'obligation de délivrer comprend les accessoires et tout ce qui a été destiné à l'usage perpétuel de la chose (article 1615)";
    label en unofficial "the obligation to deliver includes the accessories and all that has been intended for the perpetual use of the thing (Article 1615)";
}
pub relation jour_et_lieu_du_paiement_convenus(v: Vente) kind empirical {
    label fr official "le jour et le lieu du paiement ont été réglés par la vente (article 1650)";
    label en unofficial "the day and place of payment have been fixed by the sale (Article 1650)";
}
pub relation absence_de_jour_et_lieu_du_paiement_convenus(v: Vente) kind empirical {
    label fr official "rien n'a été réglé lors de la vente quant au jour et au lieu du paiement (article 1651)";
    label en unofficial "nothing was settled at the sale as to the day and place of payment (Article 1651)";
}
pub relation paiement_du_prix_du_a_la_delivrance(v: Vente) kind derived {
    label fr official "l'acheteur doit payer au lieu et dans le temps où doit se faire la délivrance (article 1651)";
    label en unofficial "the buyer must pay at the place and time where delivery is to be made (Article 1651)";
}
pub relation prix_paye_a_la_delivrance(v: Vente) kind empirical {
    label fr official "l'acheteur a payé le prix au lieu et au temps de la délivrance (article 1651)";
    label en unofficial "the buyer paid at the place and time of delivery (Article 1651)";
}
pub relation interets_du_prix_dus(v: Vente) kind derived {
    label fr official "l'acheteur doit l'intérêt du prix de la vente jusqu'au paiement du capital (article 1652)";
    label en unofficial "the buyer owes interest on the price of the sale until payment of the capital (Article 1652)";
}
pub relation interets_du_prix_payes(v: Vente) kind empirical {
    label fr official "l'acheteur a payé les intérêts du prix de la vente (article 1652)";
    label en unofficial "the buyer paid interest on the sale price (Article 1652)";
}
pub relation interets_convenus(v: Vente) kind empirical {
    label fr official "il a été convenu lors de la vente que l'acheteur devrait l'intérêt du prix (article 1652)";
    label en unofficial "it was agreed at the sale that the buyer would owe interest on the price (Article 1652)";
}
pub relation chose_livree_produit_fruits_ou_revenus(v: Vente) kind empirical {
    label fr official "la chose vendue et livrée produit des fruits ou autres revenus (article 1652)";
    label en unofficial "the thing sold and delivered produces fruits or other income (Article 1652)";
}
pub relation acheteur_somme_de_payer(v: Vente) kind empirical {
    label fr official "l'acheteur a été sommé de payer ; l'intérêt ne court que depuis la sommation (article 1652)";
    label en unofficial "the buyer has been summoned to pay; interest runs only from the summons (Article 1652)";
}
pub relation trouble_ou_crainte_legitime_d_eviction(v: Vente) kind empirical {
    label fr official "l'acheteur est troublé ou a juste sujet de craindre d'être troublé par une action hypothécaire ou en revendication (article 1653)";
    label en unofficial "the buyer is disturbed or has just cause to fear being disturbed by a mortgage or revendication action (Article 1653)";
}
pub relation vendeur_n_a_pas_fait_cesser_le_trouble(v: Vente) kind empirical {
    label fr official "le vendeur n'a pas fait cesser le trouble (article 1653)";
    label en unofficial "the seller has not put an end to the disturbance (Article 1653)";
}
pub relation vendeur_n_a_pas_donne_caution(v: Vente) kind empirical {
    label fr official "le vendeur n'a pas donné caution (article 1653)";
    label en unofficial "the seller has not given security (Article 1653)";
}
pub relation aucune_clause_imposant_paiement_malgre_trouble(v: Vente) kind empirical {
    label fr official "il n'a pas été stipulé que, nonobstant le trouble, l'acheteur paiera (article 1653)";
    label en unofficial "it was not stipulated that, notwithstanding the disturbance, the buyer will pay (Article 1653)";
}
pub relation acheteur_peut_suspendre_paiement(v: Vente) kind derived {
    label fr official "l'acheteur peut suspendre le paiement du prix (article 1653)";
    label en unofficial "the buyer may suspend payment of the price (Article 1653)";
}
pub relation paiement_suspendu_par_acheteur(v: Vente) kind empirical {
    label fr official "l'acheteur a suspendu le paiement du prix (article 1653)";
    label en unofficial "the buyer suspended payment of the price (Article 1653)";
}
pub relation vendeur_peut_demander_resolution(v: Vente) kind derived {
    label fr official "le vendeur peut demander la résolution de la vente (article 1654)";
    label en unofficial "the seller may claim rescission of the sale (Article 1654)";
}
pub relation demande_resolution_par_vendeur(v: Vente) kind empirical {
    label fr official "le vendeur a demandé la résolution de la vente (article 1654)";
    label en unofficial "the seller requested rescission of the sale (Article 1654)";
}
pub relation resolution_demandee_par_vendeur(v: Vente) kind institutional {
    label fr official "la résolution de la vente est demandée par le vendeur (article 1654)";
    label en unofficial "rescission of the sale was requested by the seller (Article 1654)";
}
pub relation chose_delivree(v: Vente) kind empirical {
    label fr official "la chose vendue a été délivrée à l'acheteur (article 1604)";
    label en unofficial "the thing sold has been delivered to the buyer (Article 1604)";
}
pub relation prix_paye_integralement(v: Vente) kind empirical {
    label fr official "le prix a été intégralement payé par l'acheteur (article 1650)";
    label en unofficial "the price has been paid in full by the buyer (Article 1650)";
}
pub relation paiement_du_prix_au_jour_et_lieu_convenus(v: Vente) kind empirical {
    label fr official "l'acheteur a payé le prix au jour et au lieu réglés par la vente (article 1650)";
    label en unofficial "the buyer paid the price on the day and at the place fixed by the sale (Article 1650)";
}
pub relation terme_de_retirement_expire(v: Vente) kind empirical {
    label fr official "le terme convenu pour le retirement est expiré (article 1657)";
    label en unofficial "the term agreed for taking delivery has expired (Article 1657)";
}

pub relation garantie_des_vices_ouverte(v: Vente, x: Vice) kind derived {
    label fr official "le vendeur est tenu de la garantie à raison du défaut caché de la chose vendue (article 1641)";
    label en unofficial "the seller is liable on the warranty by reason of the latent defect of the thing sold (Article 1641)";
}
pub relation garantie_des_vices_fournie(v: Vente) kind empirical {
    label fr official "le vendeur a fourni la garantie du vice caché (article 1641)";
    label en unofficial "the seller provided the latent-defect warranty (Article 1641)";
}
pub relation garantie_des_vices_exclue(v: Vente) kind derived {
    label fr official "l'action résultant des vices rédhibitoires n'a pas lieu dans les ventes faites par autorité de justice (article 1649)";
    label en unofficial "the action arising from redhibitory defects does not lie in sales made by judicial authority (Article 1649)";
}
pub relation choix_de_l_acheteur(v: Vente, o: OptionVice) kind derived {
    label fr official "l'acheteur a le choix de rendre la chose et de se faire restituer le prix, ou de garder la chose et de se faire rendre une partie du prix (article 1644)";
    label en unofficial "the buyer has the choice of returning the thing and recovering the price, or keeping the thing and recovering part of the price (Article 1644)";
}
pub relation choix_du_remede_exerce(v: Vente) kind empirical {
    label fr official "l'acheteur a exercé son choix entre rendre ou garder la chose (article 1644)";
    label en unofficial "the buyer exercised the choice between returning or keeping the thing (Article 1644)";
}
pub relation action_en_garantie_recevable(v: Vente) kind derived {
    label fr official "l'action résultant des vices rédhibitoires est intentée dans le délai de deux ans à compter de la découverte du vice (article 1648, alinéa 1)";
    label en unofficial "the action arising from redhibitory defects is brought within two years from the discovery of the defect (Article 1648, first paragraph)";
}
pub relation lesion_superieure_a_sept_douziemes(v: Vente) kind derived {
    label fr official "le vendeur a été lésé de plus de sept douzièmes dans le prix d'un immeuble (articles 1674 et 1675)";
    label en unofficial "the seller has been injured by more than seven twelfths in the price of a building (Articles 1674 and 1675)";
}
pub relation action_en_rescision_recevable(v: Vente) kind derived {
    label fr official "la demande en rescision est formée avant l'expiration de deux années à compter du jour de la vente (articles 1674 et 1676)";
    label en unofficial "the claim for rescission is brought before the expiry of two years from the day of the sale (Articles 1674 and 1676)";
}
pub relation rescision_pour_lesion_demandee(v: Vente) kind institutional {
    label fr official "le vendeur lésé a formé la demande en rescision (articles 1674 et 1676)";
    label en unofficial "the injured seller has brought the claim for rescission (Articles 1674 and 1676)";
}
pub relation demande_rescision_pour_lesion(v: Vente) kind empirical {
    label fr official "le vendeur lésé a demandé la rescision pour lésion (articles 1674 et 1676)";
    label en unofficial "the injured seller requested rescission for lesion (Articles 1674 and 1676)";
}
pub relation resolution_de_plein_droit(v: Vente) kind derived {
    label fr official "en matière de vente de denrées et effets mobiliers, la résolution a lieu de plein droit et sans sommation au profit du vendeur (article 1657)";
    label en unofficial "in a sale of foodstuffs and movable effects, rescission takes place by operation of law and without summons in favour of the seller (Article 1657)";
}
pub relation accord_sur_la_chose(v: Vente) kind empirical {
    label fr official "les parties sont convenues de la chose (articles 1583 et 1589)";
    label en unofficial "the parties have agreed on the thing (Articles 1583 and 1589)";
}
pub relation accord_sur_le_prix(v: Vente) kind empirical {
    label fr official "les parties sont convenues du prix (articles 1583, 1589 et 1591)";
    label en unofficial "the parties have agreed on the price (Articles 1583, 1589 and 1591)";
}
pub relation promesse_reciproque_de_vente(v: Vente) kind empirical {
    label fr official "la promesse de vente est faite avec consentement réciproque des deux parties sur la chose et sur le prix (article 1589)";
    label en unofficial "the promise of sale is made with the reciprocal consent of both parties on the thing and on the price (Article 1589)";
}
pub relation vente_parfaite(v: Vente) kind derived {
    label fr official "la vente est parfaite entre les parties (articles 1583 et 1589)";
    label en unofficial "the sale is complete between the parties (Articles 1583 and 1589)";
}
pub relation propriete_acquise_a_l_acheteur(v: Vente) kind derived {
    label fr official "la propriété est acquise de droit à l'acheteur à l'égard du vendeur, quoique la chose n'ait pas encore été livrée ni le prix payé (article 1583)";
    label en unofficial "ownership is acquired as of right by the buyer as against the seller, although the thing has not yet been delivered nor the price paid (Article 1583)";
}
pub relation prix_determine_par_les_parties(v: Vente) kind empirical {
    label fr official "le prix de la vente est déterminé et désigné par les parties (article 1591)";
    label en unofficial "the price of the sale is determined and designated by the parties (Article 1591)";
}
pub relation chose_appartient_a_un_tiers(v: Vente) kind empirical {
    label fr official "la chose vendue appartient à autrui (article 1599)";
    label en unofficial "the thing sold belongs to another (Article 1599)";
}
pub relation vente_nulle(v: Vente) kind derived {
    label fr official "la vente est nulle (article 1599)";
    label en unofficial "the sale is void (Article 1599)";
}
pub relation vente_sous_condition_suspensive(v: Vente) kind empirical {
    label fr official "la vente est faite sous une condition suspensive (article 1584, alinéa 1)";
    label en unofficial "the sale is made subject to a condition precedent (Article 1584, first paragraph)";
}
pub relation vente_sous_condition_resolutoire(v: Vente) kind empirical {
    label fr official "la vente est faite sous une condition résolutoire (article 1584, alinéa 1)";
    label en unofficial "the sale is made subject to a condition subsequent (Article 1584, first paragraph)";
}

pub relation bailleur(b: Bail, p: Personne) kind empirical {
    key(b);
    label fr official "le bailleur, obligé de délivrer, d'entretenir et de faire jouir paisiblement le preneur (article 1719)";
    label en unofficial "the lessor, bound to deliver, maintain and let the lessee peaceably enjoy the thing (Article 1719)";
}
pub relation preneur(b: Bail, p: Personne) kind empirical {
    key(b);
    label fr official "le preneur, tenu d'user raisonnablement de la chose louée et d'en payer le prix (article 1728)";
    label en unofficial "the lessee, bound to use the leased thing reasonably and to pay its price (Article 1728)";
}
pub relation chose_louee(b: Bail, c: Chose) kind empirical {
    key(b);
    label fr official "la chose donnée à bail (article 1719)";
    label en unofficial "the thing let on lease (Article 1719)";
}
pub relation bail_en_vigueur(b: Bail) kind empirical {
    label fr official "le bail est en cours entre les parties (article 1719)";
    label en unofficial "the lease is running between the parties (Article 1719)";
}
pub relation jouissance_paisible_assuree(b: Bail) kind empirical {
    label fr official "le bailleur fait jouir paisiblement le preneur pendant la durée du bail (article 1719, 3°)";
    label en unofficial "the lessor lets the lessee peaceably enjoy the thing for the term of the lease (Article 1719, 3)";
}
pub relation permanence_et_qualite_des_plantations_assurees(b: Bail) kind empirical {
    label fr official "le bailleur assure la permanence et la qualité des plantations (article 1719, 4°)";
    label en unofficial "the lessor ensures the permanence and quality of the plantings (Article 1719, 4)";
}
pub relation chose_louee_en_bon_etat_de_reparations(b: Bail) kind empirical {
    label fr official "le bailleur délivre la chose en bon état de réparations de toute espèce (article 1720, alinéa 1)";
    label en unofficial "the lessor delivers the thing in good repair of every kind (Article 1720, first paragraph)";
}
pub relation reparations_necessaires_non_locatives_effectuees(b: Bail) kind empirical {
    label fr official "le bailleur fait, pendant la durée du bail, toutes les réparations devenues nécessaires autres que locatives (article 1720, alinéa 2)";
    label en unofficial "the lessor makes, during the lease, all repairs that become necessary other than tenant's repairs (Article 1720, second paragraph)";
}
pub relation vice_ou_defaut_empeche_usage(b: Bail) kind empirical {
    label fr official "un vice ou défaut de la chose louée en empêche l'usage, quand même le bailleur ne l'aurait pas connu lors du bail (article 1721, alinéa 1)";
    label en unofficial "a defect of the leased thing prevents its use, even if the lessor did not know of it at the time of the lease (Article 1721, first paragraph)";
}
pub relation perte_causee_au_preneur_par_vice(b: Bail) kind empirical {
    label fr official "il résulte de ce vice ou défaut quelque perte pour le preneur (article 1721, alinéa 2)";
    label en unofficial "some loss results for the lessee from that defect (Article 1721, second paragraph)";
}
pub relation indemnisation_du_preneur_due(b: Bail) kind derived {
    label fr official "le bailleur est tenu d'indemniser le preneur (article 1721, alinéa 2)";
    label en unofficial "the lessor is bound to indemnify the lessee (Article 1721, second paragraph)";
}
pub relation forme_de_la_chose_louee_changee_par_bailleur(b: Bail) kind empirical {
    label fr official "le bailleur a changé la forme de la chose louée pendant la durée du bail (article 1723)";
    label en unofficial "the lessor has changed the form of the leased thing during the lease (Article 1723)";
}
pub relation usage_raisonnable_de_la_chose_louee(b: Bail) kind empirical {
    label fr official "le preneur use raisonnablement de la chose louée (article 1728, 1°)";
    label en unofficial "the lessee uses the leased thing reasonably (Article 1728, 1)";
}
pub relation usage_conforme_a_la_destination(b: Bail) kind empirical {
    label fr official "le preneur use de la chose suivant la destination qui lui a été donnée par le bail (article 1728, 1°)";
    label en unofficial "the lessee uses the thing according to the purpose given to it by the lease (Article 1728, 1)";
}
pub relation prix_du_bail_paye_aux_termes_convenus(b: Bail) kind empirical {
    label fr official "le preneur paye le prix du bail aux termes convenus (article 1728, 2°)";
    label en unofficial "the lessee pays the price of the lease at the agreed terms (Article 1728, 2)";
}
pub relation preneur_supporte_reparations_urgentes(b: Bail) kind empirical {
    label fr official "le preneur souffre les réparations urgentes qui ne peuvent être différées jusqu'à la fin du bail (article 1724, alinéa 1)";
    label en unofficial "the lessee endures urgent repairs that cannot be deferred to the end of the lease (Article 1724, first paragraph)";
}
pub relation faculte_de_sous_louer_non_interdite(b: Bail) kind empirical {
    label fr official "la faculté de sous-louer ou de céder le bail n'a pas été interdite au preneur (article 1717, alinéas 1 et 2)";
    label en unofficial "the power to sublet or assign the lease has not been forbidden to the lessee (Article 1717, first and second paragraphs)";
}
pub relation preneur_peut_sous_louer(b: Bail) kind derived {
    label fr official "le preneur a le droit de sous-louer et même de céder son bail à un autre (article 1717, alinéa 1)";
    label en unofficial "the lessee has the right to sublet and even to assign his lease to another (Article 1717, first paragraph)";
}
pub relation sous_location_exercee_par_preneur(b: Bail) kind empirical {
    label fr official "le preneur a sous-loué ou cédé le bail (article 1717)";
    label en unofficial "the lessee sublet or assigned the lease (Article 1717)";
}
pub relation terme_ecrit_expire(b: Bail) kind empirical {
    label fr official "le terme fixé par le bail fait par écrit est expiré (article 1737)";
    label en unofficial "the term fixed by the lease made in writing has expired (Article 1737)";
}
pub relation bail_cesse_de_plein_droit(b: Bail) kind derived {
    label fr official "le bail cesse de plein droit à l'expiration du terme fixé, sans qu'il soit nécessaire de donner congé (article 1737)";
    label en unofficial "the lease ends by operation of law on expiry of the fixed term, without any need to give notice (Article 1737)";
}
pub relation conge_signifie(b: Bail) kind empirical {
    label fr official "un congé a été signifié (article 1739)";
    label en unofficial "notice to quit has been served (Article 1739)";
}
pub relation tacite_reconduction_exclue(b: Bail) kind derived {
    label fr official "le preneur, quoiqu'il ait continué sa jouissance, ne peut invoquer la tacite reconduction (article 1739)";
    label en unofficial "the lessee, although he has continued his enjoyment, cannot rely on tacit renewal (Article 1739)";
}
pub relation droit_de_reprise_pour_occupation_reserve(b: Bail) kind empirical {
    label fr official "il a été convenu dans le contrat de louage que le bailleur pourrait venir occuper la maison (article 1762)";
    label en unofficial "it was agreed in the lease that the lessor could come and occupy the house (Article 1762)";
}
pub relation conge_de_reprise_soumis_a_l_usage_local(b: Bail) kind derived {
    label fr official "le bailleur est tenu de signifier d'avance un congé aux époques déterminées par l'usage des lieux (article 1762)";
    label en unofficial "the lessor must give prior notice at the times determined by local usage (Article 1762)";
}
pub relation conge_de_reprise_signifie(b: Bail) kind empirical {
    label fr official "le bailleur a signifié le congé de reprise dans le délai usité (article 1762)";
    label en unofficial "the lessor served the repossession notice within the customary period (Article 1762)";
}
pub relation deces_du_bailleur_ou_du_preneur(b: Bail) kind empirical {
    label fr official "le bailleur ou le preneur est décédé pendant le bail (article 1742)";
    label en unofficial "the lessor or the lessee has died during the lease (Article 1742)";
}
pub relation bail_non_resolu_par_deces(b: Bail) kind derived {
    label fr official "le contrat de louage n'est point résolu par la mort du bailleur ni par celle du preneur (article 1742)";
    label en unofficial "the lease is not dissolved by the death of the lessor or of the lessee (Article 1742)";
}
pub relation destruction_totale_par_cas_fortuit(b: Bail) kind empirical {
    label fr official "la chose louée est détruite en totalité par cas fortuit pendant la durée du bail (article 1722)";
    label en unofficial "the leased thing is totally destroyed by fortuitous event during the lease (Article 1722)";
}
pub relation destruction_partielle_par_cas_fortuit(b: Bail) kind empirical {
    label fr official "la chose louée n'est détruite qu'en partie par cas fortuit (article 1722)";
    label en unofficial "the leased thing is only partly destroyed by fortuitous event (Article 1722)";
}
pub relation reparations_urgentes_non_differables(b: Bail) kind empirical {
    label fr official "la chose louée a besoin de réparations urgentes qui ne peuvent être différées jusqu'à la fin du bail (article 1724, alinéa 1)";
    label en unofficial "the leased thing needs urgent repairs that cannot be deferred to the end of the lease (Article 1724, first paragraph)";
}
pub relation jours_de_reparations(b: Bail, n: Integer) kind empirical {
    key(b);
    label fr official "durée des réparations en jours, comparée aux vingt et un jours de l'article 1724 (article 1724, alinéa 2)";
    label en unofficial "duration of the repairs in days, compared with the twenty-one days of Article 1724 (Article 1724, second paragraph)";
}
pub relation bail_ecrit(b: Bail) kind empirical {
    label fr official "le bail a été fait par écrit (articles 1737 et 1738)";
    label en unofficial "the lease was made in writing (Articles 1737 and 1738)";
}
pub relation bail_sans_ecrit(b: Bail) kind empirical {
    label fr official "le bail a été fait sans écrit (article 1736)";
    label en unofficial "the lease was made without writing (Article 1736)";
}
pub relation usage_local_delai_de_conge(b: Bail, n: Integer) kind empirical {
    key(b);
    label fr official "délai de congé fixé par l'usage des lieux, en mois (articles 1736 et 1759)";
    label en unofficial "notice period fixed by local usage, in months (Articles 1736 and 1759)";
}
pub relation bail_expire(b: Bail) kind empirical {
    label fr official "le bail écrit est arrivé à expiration (articles 1738 et 1759)";
    label en unofficial "the written lease has expired (Articles 1738 and 1759)";
}
pub relation preneur_laisse_en_jouissance(b: Bail) kind empirical {
    label fr official "le preneur reste et est laissé en possession après l'expiration du bail écrit (article 1738)";
    label en unofficial "the lessee remains and is left in possession after the expiry of the written lease (Article 1738)";
}
pub relation absence_opposition_du_bailleur(b: Bail) kind empirical {
    label fr official "le locataire continue sa jouissance sans opposition de la part du bailleur (article 1759)";
    label en unofficial "the tenant continues his enjoyment without opposition from the lessor (Article 1759)";
}
pub relation bail_renouvele_par_tacite_reconduction(b: Bail) kind derived {
    label fr official "il s'opère un nouveau bail par tacite reconduction, aux mêmes conditions et pour le terme fixé par l'usage des lieux (articles 1738 et 1759)";
    label en unofficial "a new lease arises by tacit renewal, on the same terms and for the term fixed by local usage (Articles 1738 and 1759)";
}
pub relation bail_resilie_de_plein_droit(b: Bail) kind derived {
    label fr official "le bail est résilié de plein droit par la destruction totale de la chose louée (article 1722)";
    label en unofficial "the lease is terminated by operation of law by the total destruction of the leased thing (Article 1722)";
}
pub relation preneur_peut_demander_diminution_de_prix(b: Bail) kind derived {
    label fr official "le preneur peut demander une diminution du prix du bail (articles 1722 et 1724, alinéa 2)";
    label en unofficial "the lessee may claim a reduction of the price of the lease (Articles 1722 and 1724, second paragraph)";
}
pub relation demande_diminution_pour_reparations(b: Bail) kind empirical {
    label fr official "le preneur a demandé une diminution du prix pour réparations urgentes (article 1724)";
    label en unofficial "the lessee requested a rent reduction for urgent repairs (Article 1724)";
}
pub relation preneur_peut_demander_resiliation(b: Bail) kind derived {
    label fr official "le preneur peut demander la résiliation du bail (article 1722)";
    label en unofficial "the lessee may claim termination of the lease (Article 1722)";
}
pub relation demande_resiliation_apres_destruction_partielle(b: Bail) kind empirical {
    label fr official "le preneur a demandé la résiliation après destruction partielle (article 1722)";
    label en unofficial "the lessee requested termination after partial destruction (Article 1722)";
}
pub relation conge_soumis_a_l_usage_local(b: Bail) kind derived {
    label fr official "l'une des parties ne peut donner congé à l'autre qu'en observant les délais fixés par l'usage des lieux (article 1736)";
    label en unofficial "neither party may give notice to the other except by observing the periods fixed by local usage (Article 1736)";
}
pub relation sous_locataire(b: Bail, p: Personne) kind empirical {
    key(b);
    label fr official "le sous-locataire, tenu envers le propriétaire jusqu'à concurrence du prix de sa sous-location (article 1753, alinéa 1)";
    label en unofficial "the subtenant, liable to the owner up to the amount of the price of his sublease (Article 1753, first paragraph)";
}
pub relation proprietaire_du_bien_sous_loue(b: Bail, p: Personne) kind empirical {
    key(b);
    label fr official "le propriétaire du bien sous-loué, envers qui le sous-locataire est tenu (article 1753, alinéa 1)";
    label en unofficial "the owner of the sublet property, to whom the subtenant is liable (Article 1753, first paragraph)";
}
pub relation dette_de_sous_location_a_la_saisie(b: Bail, m: Money) kind empirical {
    key(b);
    label fr official "prix de la sous-location dont le sous-locataire peut être débiteur au moment de la saisie (article 1753, alinéa 1)";
    label en unofficial "price of the sublease which the subtenant may owe at the time of the seizure (Article 1753, first paragraph)";
}
pub relation plafond_du_sous_locataire_envers_proprietaire(b: Bail, m: Money) kind derived {
    key(b);
    label fr official "limite de ce dont le sous-locataire est tenu envers le propriétaire (article 1753, alinéa 1)";
    label en unofficial "limit of what the subtenant owes to the owner (Article 1753, first paragraph)";
}
pub relation chose_louee_vendue(b: Bail) kind empirical {
    label fr official "le bailleur vend la chose louée (article 1743, alinéa 1)";
    label en unofficial "the lessor sells the leased thing (Article 1743, first paragraph)";
}
pub relation acquereur_de_la_chose_louee(b: Bail, p: Personne) kind empirical {
    key(b);
    label fr official "l'acquéreur de la chose louée (article 1743, alinéa 1)";
    label en unofficial "the buyer of the leased thing (Article 1743, first paragraph)";
}
pub relation bail_authentique_ou_a_date_certaine(b: Bail) kind empirical {
    label fr official "le preneur a un bail authentique ou dont la date est certaine (article 1743, alinéa 1)";
    label en unofficial "the lessee has a lease in authentic form or of certain date (Article 1743, first paragraph)";
}
pub relation bail_de_bien_non_rural(b: Bail) kind empirical {
    label fr official "le bail porte sur des biens non ruraux (article 1743, alinéa 2)";
    label en unofficial "the lease concerns non-rural property (Article 1743, second paragraph)";
}
pub relation droit_d_expulser_reserve_par_le_bail(b: Bail) kind empirical {
    label fr official "l'acquéreur s'est réservé le droit d'expulser le locataire par le contrat de bail (article 1743, alinéa 2)";
    label en unofficial "the buyer reserved the right to evict the tenant by the lease (Article 1743, second paragraph)";
}
pub relation acquereur_ne_peut_expulser_le_preneur(b: Bail) kind derived {
    label fr official "l'acquéreur ne peut expulser le fermier, le métayer ou le locataire (article 1743, alinéa 1)";
    label en unofficial "the buyer may not evict the farmer, the sharecropper or the tenant (Article 1743, first paragraph)";
}
pub relation acquereur_peut_expulser_le_preneur(b: Bail) kind derived {
    label fr official "l'acquéreur peut expulser le locataire de biens non ruraux (article 1743, alinéa 2)";
    label en unofficial "the buyer may evict the tenant of non-rural property (Article 1743, second paragraph)";
}
pub relation bail_d_habitation_sans_caractere_professionnel_ou_commercial(b: Bail) kind empirical {
    label fr official "le local loué est sans caractère professionnel ou commercial (article 1751, alinéa 1)";
    label en unofficial "the leased premises are of no professional or commercial character (Article 1751, first paragraph)";
}
pub relation local_sert_effectivement_a_l_habitation_de_deux_epoux(b: Bail) kind empirical {
    label fr official "le local sert effectivement à l'habitation de deux époux ou de deux partenaires (article 1751, alinéa 1)";
    label en unofficial "the premises actually serve as the dwelling of two spouses or of two partners (Article 1751, first paragraph)";
}
pub relation epoux_titulaires_du_bail(b: Bail, premier: Personne, second: Personne) kind empirical {
    label fr official "les deux époux, quel que soit leur régime matrimonial et même si le bail a été conclu avant le mariage (article 1751, alinéa 1)";
    label en unofficial "the two spouses, whatever their matrimonial regime and even if the lease was concluded before the marriage (Article 1751, first paragraph)";
}
pub relation partenaires_pacs_titulaires_du_bail(b: Bail, premier: Personne, second: Personne) kind empirical {
    label fr official "les deux partenaires liés par un pacte civil de solidarité (article 1751, alinéa 1)";
    label en unofficial "the two partners bound by a civil solidarity pact (Article 1751, first paragraph)";
}
pub relation demande_conjointe_des_partenaires_pacs(b: Bail) kind empirical {
    label fr official "les partenaires liés par un pacte civil de solidarité en font la demande conjointement (article 1751, alinéa 1)";
    label en unofficial "the partners bound by a civil solidarity pact make the request jointly (Article 1751, first paragraph)";
}
pub relation droit_au_bail_appartient_aux_deux_titulaires(b: Bail, premier: Personne, second: Personne) kind derived {
    label fr official "le droit au bail est réputé appartenir à l'un et à l'autre des époux ou partenaires (article 1751, alinéa 1)";
    label en unofficial "the right to the lease is deemed to belong to each of the spouses or partners (Article 1751, first paragraph)";
}

pub relation ouvrier_du_marche(m: Marche, p: Personne) kind empirical {
    key(m);
    label fr official "l'ouvrier chargé de l'ouvrage (articles 1788 et 1789)";
    label en unofficial "the worker undertaking the work (Articles 1788 and 1789)";
}
pub relation maitre_de_l_ouvrage(m: Marche, p: Personne) kind empirical {
    key(m);
    label fr official "le maître de l'ouvrage, pour qui l'ouvrage est fait (articles 1788 et 1790)";
    label en unofficial "the owner for whom the work is done (Articles 1788 and 1790)";
}
pub relation ouvrier_fournit_matiere(m: Marche) kind empirical {
    label fr official "l'ouvrier fournit la matière (article 1788)";
    label en unofficial "the worker supplies the material (Article 1788)";
}
pub relation chose_du_marche_perie_avant_livraison(m: Marche) kind empirical {
    label fr official "la chose vient à périr avant d'être livrée (articles 1788 à 1790)";
    label en unofficial "the thing perishes before delivery (Articles 1788 to 1790)";
}
pub relation maitre_en_demeure_de_recevoir(m: Marche) kind empirical {
    label fr official "le maître est en demeure de recevoir la chose (article 1788)";
    label en unofficial "the owner is in default in taking delivery of the thing (Article 1788)";
}
pub relation maitre_non_en_demeure_de_recevoir(m: Marche) kind empirical {
    label fr official "le maître n'est pas en demeure de recevoir ou de vérifier la chose (articles 1788 et 1790)";
    label en unofficial "the owner is not in default in receiving or checking the thing (Articles 1788 and 1790)";
}
pub relation perte_a_la_charge_de_l_ouvrier(m: Marche) kind derived {
    label fr official "la perte est pour l'ouvrier (article 1788)";
    label en unofficial "the loss falls on the worker (Article 1788)";
}
pub relation travail_seul_fourni(m: Marche) kind empirical {
    label fr official "l'ouvrier fournit seulement son travail ou son industrie (articles 1789 et 1790)";
    label en unofficial "the worker supplies only his labour or skill (Articles 1789 and 1790)";
}
pub relation faute_de_l_ouvrier_etablie(m: Marche) kind empirical {
    label fr official "la faute de l'ouvrier est établie (article 1789)";
    label en unofficial "the worker's fault is established (Article 1789)";
}
pub relation ouvrier_responsable_de_la_perte(m: Marche) kind derived {
    label fr official "l'ouvrier n'est tenu que de sa faute (article 1789)";
    label en unofficial "the worker is liable only for his own fault (Article 1789)";
}
pub relation perte_supportee_par_ouvrier(m: Marche) kind empirical {
    label fr official "l'ouvrier a supporté la perte due à sa faute";
    label en unofficial "the worker bore the loss due to his fault";
}
pub relation seuil_decret_1799_1(m: Marche, n: Money) kind empirical {
    label fr official "seuil fixé par décret en Conseil d'État au-delà duquel le paiement doit être garanti (article 1799-1, alinéa 1)";
    label en unofficial "threshold fixed by decree of the Conseil d'Etat above which payment must be secured (Article 1799-1, first paragraph)";
}
pub relation absence_de_faute_de_l_ouvrier_etablie(m: Marche) kind empirical {
    label fr official "la chose a péri sans aucune faute de la part de l'ouvrier (article 1790)";
    label en unofficial "the thing perished without any fault on the worker's part (Article 1790)";
}
pub relation absence_de_vice_de_la_matiere(m: Marche) kind empirical {
    label fr official "la chose n'a pas péri par le vice de la matière (article 1790)";
    label en unofficial "the thing did not perish through a defect of the material (Article 1790)";
}
pub relation ouvrier_sans_salaire_pour_perte(m: Marche) kind derived {
    label fr official "l'ouvrier n'a point de salaire à réclamer (article 1790)";
    label en unofficial "the worker has no wages to claim (Article 1790)";
}
pub relation constructeur_du_marche(m: Marche, p: Personne) kind empirical {
    key(m);
    label fr official "le constructeur de l'ouvrage (article 1792, alinéa 1)";
    label en unofficial "the builder of the work (Article 1792, first paragraph)";
}
pub relation acquereur_de_l_ouvrage(m: Marche, p: Personne) kind empirical {
    key(m);
    label fr official "le maître ou l'acquéreur de l'ouvrage, envers qui le constructeur est responsable (article 1792, alinéa 1)";
    label en unofficial "the owner or the buyer of the work, to whom the builder is liable (Article 1792, first paragraph)";
}
pub relation dommage_compromet_solidite_ouvrage(m: Marche) kind empirical {
    label fr official "le dommage compromet la solidité de l'ouvrage (article 1792, alinéa 1)";
    label en unofficial "the damage compromises the solidity of the work (Article 1792, first paragraph)";
}
pub relation dommage_rend_ouvrage_impropre_destination(m: Marche) kind empirical {
    label fr official "le dommage, affectant l'ouvrage dans l'un de ses éléments constitutifs ou d'équipement, le rend impropre à sa destination (article 1792, alinéa 1)";
    label en unofficial "the damage, affecting the work in one of its constituent or equipment elements, makes it unfit for its purpose (Article 1792, first paragraph)";
}
pub relation absence_de_cause_etrangere_etablie(m: Marche) kind empirical {
    label fr official "le constructeur ne prouve pas que les dommages proviennent d'une cause étrangère (article 1792, alinéa 2)";
    label en unofficial "the builder does not prove that the damage arises from an external cause (Article 1792, second paragraph)";
}
pub relation responsabilite_constructeur_de_plein_droit(m: Marche) kind derived {
    label fr official "le constructeur est responsable de plein droit envers le maître ou l'acquéreur de l'ouvrage (article 1792, alinéa 1)";
    label en unofficial "the builder is liable by operation of law to the owner or buyer of the work (Article 1792, first paragraph)";
}
pub relation dommage_element_equipement_bon_fonctionnement(m: Marche) kind empirical {
    label fr official "le dommage affecte un autre élément d'équipement de l'ouvrage, couvert par la garantie de bon fonctionnement (article 1792-3)";
    label en unofficial "the damage affects another equipment element of the work, covered by the warranty of proper working order (Article 1792-3)";
}
pub relation reception_ouvrage_le(m: Marche, d: Date) kind empirical {
    key(m);
    label fr official "jour de la réception de l'ouvrage, d'où courent les garanties (articles 1792-3, 1792-4-1 et 1792-6)";
    label en unofficial "day of acceptance of the work, from which the warranties run (Articles 1792-3, 1792-4-1 and 1792-6)";
}
pub relation action_garantie_equipement_introduite_le(m: Marche, d: Date) kind empirical {
    key(m);
    label fr official "jour où l'action fondée sur la garantie de bon fonctionnement a été introduite (article 1792-3)";
    label en unofficial "day the action based on the warranty of proper working order was brought (Article 1792-3)";
}
pub relation action_garantie_equipement_recevable(m: Marche) kind derived {
    label fr official "l'action est introduite dans la durée minimale de deux ans à compter de la réception (article 1792-3)";
    label en unofficial "the action is brought within the minimum two-year period from acceptance (Article 1792-3)";
}
pub relation constructeur_decharge_responsabilite_decennale_le(m: Marche, d: Date) kind derived {
    key(m);
    label fr official "jour où le constructeur est déchargé des responsabilités et garanties des articles 1792 à 1792-2 : dix ans à compter de la réception des travaux (article 1792-4-1)";
    label en unofficial "day the builder is discharged of the liabilities and warranties of Articles 1792 to 1792-2: ten years from acceptance of the works (Article 1792-4-1)";
}
pub relation clause_exclut_ou_limite_garanties_constructeur(m: Marche) kind empirical {
    label fr official "une clause du contrat exclut ou limite la responsabilité ou les garanties des articles 1792 à 1792-6 (article 1792-5)";
    label en unofficial "a clause of the contract excludes or limits the liability or warranties of Articles 1792 to 1792-6 (Article 1792-5)";
}
pub relation clause_reputee_non_ecrite(m: Marche) kind derived {
    label fr official "la clause est réputée non écrite (article 1792-5)";
    label en unofficial "the clause is deemed unwritten (Article 1792-5)";
}
pub relation reception_contradictoire_prononcee(m: Marche) kind empirical {
    label fr official "la réception est prononcée contradictoirement (article 1792-6, alinéa 1)";
    label en unofficial "acceptance is pronounced in adversarial form (Article 1792-6, first paragraph)";
}
pub relation desordre_signale_par_reserve_ou_notification(m: Marche) kind empirical {
    label fr official "le désordre est signalé par le maître de l'ouvrage au moyen de réserves ou par notification écrite (article 1792-6, alinéa 2)";
    label en unofficial "the defect is reported by the owner by means of reservations or by written notice (Article 1792-6, second paragraph)";
}
pub relation action_parfait_achevement_introduite_le(m: Marche, d: Date) kind empirical {
    key(m);
    label fr official "jour où la garantie de parfait achèvement a été mise en oeuvre (article 1792-6, alinéa 2)";
    label en unofficial "day the warranty of perfect completion was invoked (Article 1792-6, second paragraph)";
}
pub relation garantie_parfait_achevement_ouverte(m: Marche) kind derived {
    label fr official "l'entrepreneur est tenu de la garantie de parfait achèvement pendant un délai d'un an à compter de la réception (article 1792-6, alinéa 2)";
    label en unofficial "the contractor owes the warranty of perfect completion for one year from acceptance (Article 1792-6, second paragraph)";
}
pub relation construction_a_forfait_selon_plan_convenu(m: Marche) kind empirical {
    label fr official "l'architecte ou l'entrepreneur s'est chargé de la construction à forfait d'un bâtiment d'après un plan arrêté et convenu avec le propriétaire du sol (article 1793)";
    label en unofficial "the architect or contractor undertook the construction of a building at a fixed price under a plan settled and agreed with the owner of the land (Article 1793)";
}
pub relation changement_non_autorise_par_ecrit(m: Marche) kind empirical {
    label fr official "les changements ou augmentations faits sur le plan n'ont pas été autorisés par écrit et le prix convenu avec le propriétaire (article 1793)";
    label en unofficial "the changes or additions to the plan were not authorised in writing with the price agreed with the owner (Article 1793)";
}
pub relation changement_autorise_par_ecrit(m: Marche) kind empirical {
    label fr official "les changements ou augmentations ont été autorisés par écrit et leur prix convenu";
    label en unofficial "the changes or additions were authorised in writing and priced by agreement";
}
pub relation augmentation_de_prix_exclue(m: Marche) kind derived {
    label fr official "l'architecte ou l'entrepreneur ne peut demander aucune augmentation de prix (article 1793)";
    label en unofficial "the architect or contractor may not claim any increase of price (Article 1793)";
}
pub relation augmentation_reclamee_par_constructeur(m: Marche) kind empirical {
    label fr official "le constructeur a réclamé une augmentation de prix";
    label en unofficial "the builder claimed a price increase";
}
pub relation augmentation_reclamee_avec_autorisation(m: Marche) kind empirical {
    label fr official "le constructeur a réclamé l'augmentation autorisée";
    label en unofficial "the builder claimed the authorised increase";
}
pub relation resiliation_unilaterale_par_maitre(m: Marche) kind empirical {
    label fr official "le maître résilie par sa seule volonté le marché à forfait (article 1794)";
    label en unofficial "the owner terminates the fixed-price contract by his sole will (Article 1794)";
}
pub relation indemnisation_integrale_entrepreneur_due(m: Marche) kind derived {
    label fr official "le maître dédommage l'entrepreneur de toutes ses dépenses, de tous ses travaux et de tout ce qu'il aurait pu gagner (article 1794)";
    label en unofficial "the owner compensates the contractor for all his outlay, all his work and all he could have earned (Article 1794)";
}
pub relation deces_ouvrier_architecte_ou_entrepreneur(m: Marche) kind empirical {
    label fr official "l'ouvrier, l'architecte ou l'entrepreneur est décédé (article 1795)";
    label en unofficial "the worker, architect or contractor has died (Article 1795)";
}
pub relation marche_dissous_par_deces(m: Marche) kind derived {
    label fr official "le contrat de louage d'ouvrage est dissous (article 1795)";
    label en unofficial "the contract for work is dissolved (Article 1795)";
}
pub relation dommage_cause_par_personne_employee(m: Marche) kind empirical {
    label fr official "le dommage est causé par une personne que l'entrepreneur emploie (article 1797)";
    label en unofficial "the damage is caused by a person the contractor employs (Article 1797)";
}
pub relation entrepreneur_responsable_du_fait_des_employes(m: Marche) kind derived {
    label fr official "l'entrepreneur répond du fait des personnes qu'il emploie (article 1797)";
    label en unofficial "the contractor answers for the acts of the persons he employs (Article 1797)";
}
pub relation sommes_dues_entrepreneur(m: Marche, n: Money) kind empirical {
    key(m);
    label fr official "sommes dues à l'entrepreneur au titre du marché de travaux privé (article 1799-1, alinéa 1)";
    label en unofficial "sums owed to the contractor under the private works contract (Article 1799-1, first paragraph)";
}
pub relation garantie_de_paiement_due(m: Marche) kind derived {
    label fr official "le maître de l'ouvrage doit garantir à l'entrepreneur le paiement des sommes dues (article 1799-1, alinéa 1)";
    label en unofficial "the owner must secure to the contractor the payment of the sums owed (Article 1799-1, first paragraph)";
}
pub relation absence_de_garantie_de_paiement(m: Marche) kind empirical {
    label fr official "aucune garantie n'a été fournie à l'entrepreneur (article 1799-1, alinéa 3)";
    label en unofficial "no security has been furnished to the contractor (Article 1799-1, third paragraph)";
}
pub relation entrepreneur_impaye_travaux_executes(m: Marche) kind empirical {
    label fr official "l'entrepreneur demeure impayé des travaux exécutés (article 1799-1, alinéa 3)";
    label en unofficial "the contractor remains unpaid for the works carried out (Article 1799-1, third paragraph)";
}
pub relation mise_en_demeure_de_garantir_le(m: Marche, d: Date) kind empirical {
    key(m);
    label fr official "jour de la mise en demeure adressée au maître de l'ouvrage (article 1799-1, alinéa 3)";
    label en unofficial "day of the formal notice served on the owner (Article 1799-1, third paragraph)";
}
pub relation suspension_execution_le(m: Marche, d: Date) kind empirical {
    key(m);
    label fr official "jour où l'entrepreneur surseoit à l'exécution du contrat (article 1799-1, alinéa 3)";
    label en unofficial "day the contractor suspends performance of the contract (Article 1799-1, third paragraph)";
}
pub relation entrepreneur_peut_suspendre_execution(m: Marche) kind derived {
    label fr official "l'entrepreneur peut surseoir à l'exécution du contrat, la mise en demeure étant restée sans effet à l'issue d'un délai de quinze jours (article 1799-1, alinéa 3)";
    label en unofficial "the contractor may suspend performance of the contract, the formal notice having remained without effect after fifteen days (Article 1799-1, third paragraph)";
}

pub relation promoteur(p: PromotionImmobiliere, x: Personne) kind empirical {
    key(p);
    label fr official "le promoteur immobilier (article 1831-1, alinéa 1)";
    label en unofficial "the property developer (Article 1831-1, first paragraph)";
}
pub relation maitre_de_promotion(p: PromotionImmobiliere, x: Personne) kind empirical {
    key(p);
    label fr official "le maître de l'ouvrage envers qui le promoteur s'oblige (article 1831-1, alinéa 1)";
    label en unofficial "the owner to whom the developer binds himself (Article 1831-1, first paragraph)";
}
pub relation programme_de_construction_realise(p: PromotionImmobiliere) kind empirical {
    label fr official "le programme de construction a été réalisé et l'ouvrage livré (article 1831-4)";
    label en unofficial "the construction programme has been carried out and the work delivered (Article 1831-4)";
}
pub relation comptes_de_construction_definitivement_arretes(p: PromotionImmobiliere) kind empirical {
    label fr official "les comptes de construction ont été définitivement arrêtés entre le maître de l'ouvrage et le promoteur (article 1831-4)";
    label en unofficial "the construction accounts have been definitively settled between the owner and the developer (Article 1831-4)";
}
pub relation mission_du_promoteur_achevee(p: PromotionImmobiliere) kind derived {
    label fr official "la mission du promoteur s'achève à la livraison de l'ouvrage (article 1831-4)";
    label en unofficial "the developer's mission ends on delivery of the work (Article 1831-4)";
}
pub relation contrat_de_promotion_en_vigueur(p: PromotionImmobiliere) kind empirical {
    label fr official "le contrat de promotion immobilière est en vigueur entre les parties (article 1831-1)";
    label en unofficial "the property development contract is in force between the parties (Article 1831-1)";
}
pub relation prix_global_convenu(p: PromotionImmobiliere, m: Money) kind empirical {
    key(p);
    label fr official "prix global convenu, limite des pouvoirs du promoteur (article 1831-2, alinéa 1)";
    label en unofficial "overall agreed price, the limit of the developer's powers (Article 1831-2, first paragraph)";
}
pub relation obligations_des_locateurs_executees(p: PromotionImmobiliere) kind empirical {
    label fr official "les obligations mises à la charge des personnes avec lesquelles le promoteur a traité sont exécutées (article 1831-1, alinéa 1)";
    label en unofficial "the obligations of the persons with whom the developer has contracted are performed (Article 1831-1, first paragraph)";
}
pub relation promoteur_garant_des_locateurs(p: PromotionImmobiliere) kind derived {
    label fr official "le promoteur est garant de l'exécution des obligations mises à la charge des personnes avec lesquelles il a traité au nom du maître de l'ouvrage (article 1831-1, alinéa 1)";
    label en unofficial "the developer guarantees the performance of the obligations of the persons with whom he contracted in the owner's name (Article 1831-1, first paragraph)";
}
pub relation actes_de_realisation_dans_prix_global(p: PromotionImmobiliere) kind empirical {
    label fr official "les actes qu'exige la réalisation du programme restent à concurrence du prix global convenu (article 1831-2, alinéa 1)";
    label en unofficial "the acts required to carry out the programme remain within the overall agreed price (Article 1831-2, first paragraph)";
}
pub relation pouvoir_general_du_promoteur(p: PromotionImmobiliere) kind derived {
    label fr official "le contrat emporte pouvoir pour le promoteur d'accomplir, au nom du maître de l'ouvrage, tous les actes qu'exige la réalisation du programme (article 1831-2, alinéa 1)";
    label en unofficial "the contract confers on the developer the power to perform, in the owner's name, all acts required to carry out the programme (Article 1831-2, first paragraph)";
}
pub relation emprunt_ou_acte_de_disposition(p: PromotionImmobiliere) kind empirical {
    label fr official "le promoteur contracte un emprunt ou passe un acte de disposition (article 1831-2, alinéa 2)";
    label en unofficial "the developer takes out a loan or executes an act of disposal (Article 1831-2, second paragraph)";
}
pub relation mandat_special_donne_au_promoteur(p: PromotionImmobiliere) kind empirical {
    label fr official "un mandat spécial est contenu dans le contrat ou dans un acte postérieur (article 1831-2, alinéa 2)";
    label en unofficial "a special mandate is contained in the contract or in a later instrument (Article 1831-2, second paragraph)";
}
pub relation promoteur_peut_engager_maitre_par_acte_special(p: PromotionImmobiliere) kind derived {
    label fr official "le promoteur n'engage le maître de l'ouvrage qu'en vertu d'un mandat spécial (article 1831-2, alinéa 2)";
    label en unofficial "the developer binds the owner only by virtue of a special mandate (Article 1831-2, second paragraph)";
}
pub relation engagement_valablement_contracte_au_nom_du_maitre(p: PromotionImmobiliere) kind empirical {
    label fr official "l'engagement a été contracté au nom du maître de l'ouvrage en vertu des pouvoirs que le promoteur tient de la loi ou de la convention (article 1831-2, alinéa 3)";
    label en unofficial "the undertaking was contracted in the owner's name by virtue of the powers the developer holds from the law or the agreement (Article 1831-2, third paragraph)";
}
pub relation engagement_execute_par_maitre(p: PromotionImmobiliere) kind empirical {
    label fr official "le maître de l'ouvrage exécute l'engagement contracté en son nom (article 1831-2, alinéa 3)";
    label en unofficial "the owner performs the undertaking contracted in his name (Article 1831-2, third paragraph)";
}
pub relation cession_avant_achevement(p: PromotionImmobiliere) kind empirical {
    label fr official "le maître de l'ouvrage cède, avant l'achèvement du programme, les droits qu'il a sur celui-ci (article 1831-3, alinéa 1)";
    label en unofficial "the owner assigns, before completion of the programme, the rights he has in it (Article 1831-3, first paragraph)";
}
pub relation cessionnaire_substitue_activement_et_passivement(p: PromotionImmobiliere) kind derived {
    label fr official "le cessionnaire est substitué de plein droit au maître de l'ouvrage, activement et passivement, dans l'ensemble du contrat (article 1831-3, alinéa 1)";
    label en unofficial "the assignee is substituted by operation of law for the owner, actively and passively, in the whole contract (Article 1831-3, first paragraph)";
}
pub relation cedant_garant_des_obligations_du_maitre(p: PromotionImmobiliere) kind derived {
    label fr official "le cédant est garant de l'exécution des obligations mises à la charge du maître de l'ouvrage par le contrat cédé (article 1831-3, alinéa 1)";
    label en unofficial "the assignor guarantees the performance of the obligations imposed on the owner by the assigned contract (Article 1831-3, first paragraph)";
}
pub relation substitution_du_promoteur_sans_accord_du_maitre(p: PromotionImmobiliere) kind empirical {
    label fr official "le promoteur se substitue un tiers sans l'accord du maître de l'ouvrage (article 1831-3, alinéa 3)";
    label en unofficial "the developer substitutes a third party without the owner's consent (Article 1831-3, third paragraph)";
}
pub relation substitution_du_promoteur_interdite(p: PromotionImmobiliere) kind derived {
    label fr official "le promoteur ne peut se substituer un tiers dans l'exécution des obligations qu'il a contractées envers le maître de l'ouvrage (article 1831-3, alinéa 3)";
    label en unofficial "the developer may not substitute a third party in performing the obligations he contracted towards the owner (Article 1831-3, third paragraph)";
}
pub relation mention_au_fichier_immobilier_le(p: PromotionImmobiliere, d: Date) kind empirical {
    key(p);
    label fr official "date de la mention du contrat au fichier immobilier (article 1831-3, alinéa 4)";
    label en unofficial "date of the entry of the contract in the land register (Article 1831-3, fourth paragraph)";
}
pub relation contrat_promotion_opposable_aux_tiers_le(p: PromotionImmobiliere, d: Date) kind derived {
    key(p);
    label fr official "jour à partir duquel le contrat de promotion immobilière est opposable aux tiers (article 1831-3, alinéa 4)";
    label en unofficial "day from which the property development contract is enforceable against third parties (Article 1831-3, fourth paragraph)";
}
pub relation reglement_ou_liquidation_du_promoteur(p: PromotionImmobiliere) kind empirical {
    label fr official "le règlement judiciaire ou la liquidation des biens est ouvert (article 1831-5)";
    label en unofficial "judicial settlement or liquidation of assets is opened (Article 1831-5)";
}
pub relation contrat_non_resilie_de_plein_droit(p: PromotionImmobiliere) kind derived {
    label fr official "le règlement judiciaire ou la liquidation des biens n'entraîne pas de plein droit la résiliation du contrat de promotion immobilière (article 1831-5)";
    label en unofficial "judicial settlement or liquidation of assets does not by operation of law terminate the property development contract (Article 1831-5)";
}
pub relation clause_resiliation_automatique_insolvabilite(p: PromotionImmobiliere) kind empirical {
    label fr official "une stipulation prévoit la résiliation de plein droit du contrat en cas de règlement judiciaire ou de liquidation (article 1831-5)";
    label en unofficial "a stipulation provides for automatic termination of the contract upon judicial settlement or liquidation (Article 1831-5)";
}
pub relation clause_promotion_reputee_non_ecrite(p: PromotionImmobiliere) kind derived {
    label fr official "toute stipulation contraire est réputée non écrite (article 1831-5)";
    label en unofficial "any stipulation to the contrary is deemed unwritten (Article 1831-5)";
}

pub relation echangiste_premier(e: Echange, p: Personne) kind empirical {
    key(e);
    label fr official "le premier échangiste (article 1702)";
    label en unofficial "the first party to the exchange (Article 1702)";
}
pub relation echangiste_second(e: Echange, p: Personne) kind empirical {
    key(e);
    label fr official "le second échangiste (article 1702)";
    label en unofficial "the second party to the exchange (Article 1702)";
}
pub relation chose_remise_par_premier(e: Echange, c: Chose) kind empirical {
    key(e);
    label fr official "la chose donnée par le premier échangiste (article 1702)";
    label en unofficial "the thing given by the first party to the exchange (Article 1702)";
}
pub relation chose_remise_par_second(e: Echange, c: Chose) kind empirical {
    key(e);
    label fr official "la chose donnée par le second échangiste (article 1702)";
    label en unofficial "the thing given by the second party to the exchange (Article 1702)";
}
pub relation consentement_reciproque_a_l_echange(e: Echange) kind empirical {
    label fr official "les parties consentent réciproquement à l'échange (article 1703)";
    label en unofficial "the parties reciprocally consent to the exchange (Article 1703)";
}
pub relation echange_parfait(e: Echange) kind derived {
    label fr official "l'échange s'opère par le seul consentement, de la même manière que la vente (article 1703)";
    label en unofficial "the exchange is effected by mere consent, in the same way as a sale (Article 1703)";
}
pub relation bailleur_de_cheptel(c: Cheptel, p: Personne) kind empirical {
    key(c);
    label fr official "la partie qui donne le fonds de bétail (article 1800)";
    label en unofficial "the party who gives the stock of livestock (Article 1800)";
}
pub relation preneur_de_cheptel(c: Cheptel, p: Personne) kind empirical {
    key(c);
    label fr official "la partie qui reçoit le fonds de bétail pour le garder, le nourrir et le soigner (article 1800)";
    label en unofficial "the party who receives the stock of livestock to keep, feed and care for it (Article 1800)";
}
pub relation fonds_de_betail_remis(c: Cheptel) kind empirical {
    label fr official "un fonds de bétail est donné à l'autre partie sous les conditions convenues (article 1800)";
    label en unofficial "a stock of livestock is given to the other party on the agreed conditions (Article 1800)";
}
pub relation cheptel_qualifie(c: Cheptel) kind derived {
    label fr official "le contrat est un bail à cheptel (article 1800)";
    label en unofficial "the contract is a cattle lease (Article 1800)";
}

pub deadline policy CC_VENTE_LOUAGE_AN {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// --- Titre VI, chapitre IV, section II : de la garantie en cas d'éviction (1625 à 1640) ---

pub relation garantie_due_possession_paisible(v: Vente) kind derived {
    label fr official "premier objet de la garantie due par le vendeur : la possession paisible de la chose vendue (article 1625)";
    label en unofficial "first object of the warranty owed by the seller: peaceable possession of the thing sold (Article 1625)";
}
pub relation garantie_due_defauts_caches(v: Vente) kind derived {
    label fr official "second objet de la garantie due par le vendeur : les défauts cachés de la chose ou vices rédhibitoires (article 1625)";
    label en unofficial "second object of the warranty owed by the seller: latent defects of the thing or redhibitory defects (Article 1625)";
}
pub relation eviction_subie_en_totalite(v: Vente) kind empirical {
    label fr official "l'acquéreur souffre l'éviction dans la totalité de l'objet vendu (article 1626)";
    label en unofficial "the buyer suffers eviction as to the whole of the object sold (Article 1626)";
}
pub relation eviction_subie_en_partie(v: Vente) kind empirical {
    label fr official "l'acquéreur souffre l'éviction dans une partie de l'objet vendu (article 1626)";
    label en unofficial "the buyer suffers eviction as to part of the object sold (Article 1626)";
}
pub relation charges_pretendues_non_declarees(v: Vente) kind empirical {
    label fr official "des charges sont prétendues sur l'objet vendu et n'ont pas été déclarées lors de la vente (article 1626)";
    label en unofficial "charges are claimed on the object sold and were not declared at the sale (Article 1626)";
}
pub relation garantie_d_eviction_due(v: Vente) kind derived {
    label fr official "le vendeur est obligé de droit à garantir l'acquéreur de l'éviction (article 1626)";
    label en unofficial "the seller is bound as of right to warrant the buyer against eviction (Article 1626)";
}
pub relation garantie_eviction_fournie(v: Vente) kind empirical {
    label fr official "le vendeur a fourni la garantie contre l'éviction à l'acquéreur (article 1626)";
    label en unofficial "the seller provided the warranty against eviction to the buyer (Article 1626)";
}
pub relation clause_de_non_garantie_stipulee(v: Vente) kind empirical {
    label fr official "les parties ont convenu que le vendeur ne serait soumis à aucune garantie (article 1627)";
    label en unofficial "the parties have agreed that the seller would be subject to no warranty (Article 1627)";
}
pub relation garantie_conventionnellement_ecartee(v: Vente) kind derived {
    label fr official "les parties peuvent, par des conventions particulières, diminuer l'effet de l'obligation de garantie ou l'écarter (article 1627)";
    label en unofficial "the parties may, by particular agreements, reduce the effect of the warranty obligation or set it aside (Article 1627)";
}
pub relation eviction_resulte_du_fait_personnel_du_vendeur(v: Vente) kind empirical {
    label fr official "l'éviction résulte d'un fait personnel au vendeur (article 1628)";
    label en unofficial "the eviction results from an act personal to the seller (Article 1628)";
}
pub relation garantie_du_fait_personnel_due(v: Vente) kind derived {
    label fr official "le vendeur demeure tenu de la garantie qui résulte d'un fait qui lui est personnel, quoiqu'il ait été dit qu'il ne serait soumis à aucune garantie (article 1628)";
    label en unofficial "the seller remains liable on the warranty arising from an act personal to him, although it was said he would be subject to no warranty (Article 1628)";
}
pub relation convention_ecartant_la_garantie_du_fait_personnel(v: Vente) kind empirical {
    label fr official "une convention écarte la garantie du fait personnel du vendeur (article 1628)";
    label en unofficial "an agreement sets aside the warranty for the seller's personal act (Article 1628)";
}
pub relation convention_contraire_nulle(v: Vente) kind derived {
    label fr official "toute convention écartant la garantie du fait personnel est nulle (article 1628)";
    label en unofficial "any agreement setting aside the warranty for the personal act is void (Article 1628)";
}
pub relation acheteur_connaissait_le_danger_d_eviction(v: Vente) kind empirical {
    label fr official "l'acquéreur a connu lors de la vente le danger de l'éviction (article 1629)";
    label en unofficial "the buyer knew at the sale of the danger of eviction (Article 1629)";
}
pub relation achat_aux_perils_et_risques(v: Vente) kind empirical {
    label fr official "l'acquéreur a acheté à ses périls et risques (article 1629)";
    label en unofficial "the buyer bought at his own peril and risk (Article 1629)";
}
pub relation restitution_du_prix_due_malgre_non_garantie(v: Vente) kind derived {
    label fr official "en cas de stipulation de non-garantie, le vendeur est tenu, en cas d'éviction, à la restitution du prix (article 1629)";
    label en unofficial "where non-warranty is stipulated, the seller is bound, in case of eviction, to restore the price (Article 1629)";
}
pub relation garantie_promise_ou_non_stipulee(v: Vente) kind empirical {
    label fr official "la garantie a été promise, ou il n'a rien été stipulé à ce sujet (article 1630)";
    label en unofficial "the warranty was promised, or nothing was stipulated on the subject (Article 1630)";
}
pub relation restitution_du_prix_due(v: Vente) kind derived {
    label fr official "l'acquéreur évincé a droit de demander contre le vendeur la restitution du prix (article 1630, 1°)";
    label en unofficial "the evicted buyer has the right to claim from the seller restitution of the price (Article 1630, 1)"; 
}
pub relation prix_restitue_apres_eviction(v: Vente) kind empirical {
    label fr official "le vendeur a restitué le prix après l'éviction (article 1630)";
    label en unofficial "the seller restored the price after eviction (Article 1630)";
}
pub relation fruits_rendus_au_proprietaire_evincant(v: Vente) kind empirical {
    label fr official "l'acquéreur est obligé de rendre les fruits au propriétaire qui l'évince (article 1630, 2°)";
    label en unofficial "the buyer is obliged to return the fruits to the owner who evicts him (Article 1630, 2)";
}
pub relation restitution_des_fruits_due(v: Vente) kind derived {
    label fr official "l'acquéreur évincé a droit de demander contre le vendeur la restitution des fruits (article 1630, 2°)";
    label en unofficial "the evicted buyer has the right to claim from the seller restitution of the fruits (Article 1630, 2)";
}
pub relation frais_de_la_demande_en_garantie_faits(v: Vente) kind empirical {
    label fr official "des frais ont été faits sur la demande en garantie de l'acheteur et par le demandeur originaire (article 1630, 3°)";
    label en unofficial "costs were incurred on the buyer's warranty claim and by the original claimant (Article 1630, 3)";
}
pub relation remboursement_des_frais_de_garantie_du(v: Vente) kind derived {
    label fr official "l'acquéreur évincé a droit de demander contre le vendeur les frais faits sur la demande en garantie (article 1630, 3°)";
    label en unofficial "the evicted buyer has the right to claim from the seller the costs incurred on the warranty claim (Article 1630, 3)";
}
pub relation dommages_interets_et_loyaux_couts_dus(v: Vente) kind derived {
    label fr official "l'acquéreur évincé a droit de demander contre le vendeur les dommages et intérêts ainsi que les frais et loyaux coûts du contrat (article 1630, 4°)";
    label en unofficial "the evicted buyer has the right to claim from the seller damages as well as the costs and lawful expenses of the contract (Article 1630, 4)";
}
pub relation chose_diminuee_de_valeur_a_l_eviction(v: Vente) kind empirical {
    label fr official "à l'époque de l'éviction, la chose vendue se trouve diminuée de valeur ou considérablement détériorée, par la négligence de l'acheteur ou par force majeure (article 1631)";
    label en unofficial "at the time of the eviction, the thing sold is diminished in value or considerably deteriorated, through the buyer's negligence or force majeure (Article 1631)";
}
pub relation restitution_de_la_totalite_du_prix_due(v: Vente) kind derived {
    label fr official "le vendeur n'en est pas moins tenu de restituer la totalité du prix (article 1631)";
    label en unofficial "the seller is nonetheless bound to restore the whole of the price (Article 1631)";
}
pub relation prix_total_restitue(v: Vente) kind empirical {
    label fr official "le vendeur a restitué la totalité du prix à l'acquéreur (article 1631)";
    label en unofficial "the seller restored the whole price to the buyer (Article 1631)";
}
pub relation profit_tire_des_degradations(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "profit que l'acquéreur a tiré des dégradations par lui faites (article 1632)";
    label en unofficial "profit the buyer derived from the deteriorations he caused (Article 1632)";
}
pub relation retenue_du_vendeur_sur_le_prix(v: Vente, m: Money) kind derived {
    key(v);
    label fr official "somme égale à ce profit que le vendeur a droit de retenir sur le prix (article 1632)";
    label en unofficial "sum equal to that profit which the seller is entitled to retain out of the price (Article 1632)";
}
pub relation chose_augmentee_de_prix_a_l_eviction(v: Vente) kind empirical {
    label fr official "la chose vendue se trouve avoir augmenté de prix à l'époque de l'éviction, indépendamment même du fait de l'acquéreur (article 1633)";
    label en unofficial "the thing sold has increased in price at the time of the eviction, even independently of the buyer's act (Article 1633)";
}
pub relation valeur_au_dessus_du_prix_de_vente(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "ce que la chose vaut au-dessus du prix de la vente (article 1633)";
    label en unofficial "what the thing is worth above the price of the sale (Article 1633)";
}
pub relation supplement_de_valeur_du_a_l_acquereur(v: Vente, m: Money) kind derived {
    key(v);
    label fr official "le vendeur est tenu de payer à l'acquéreur ce que la chose vaut au-dessus du prix de la vente (article 1633)";
    label en unofficial "the seller is bound to pay the buyer what the thing is worth above the price of the sale (Article 1633)";
}
pub relation supplement_de_valeur_paye(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "le vendeur a payé à l'acquéreur le supplément de valeur (article 1633)";
    label en unofficial "the seller paid the buyer the value supplement (Article 1633)";
}
pub relation reparations_et_ameliorations_utiles_faites(v: Vente) kind empirical {
    label fr official "l'acquéreur a fait au fonds des réparations et améliorations utiles (article 1634)";
    label en unofficial "the buyer made useful repairs and improvements to the land (Article 1634)";
}
pub relation remboursement_des_ameliorations_utiles_du(v: Vente) kind derived {
    label fr official "le vendeur est tenu de rembourser ou de faire rembourser à l'acquéreur toutes les réparations et améliorations utiles (article 1634)";
    label en unofficial "the seller must reimburse, or have reimbursed to the buyer, all useful repairs and improvements (Article 1634)";
}
pub relation ameliorations_utiles_remboursees(v: Vente) kind empirical {
    label fr official "les réparations et améliorations utiles ont été remboursées à l'acquéreur (article 1634)";
    label en unofficial "useful repairs and improvements were reimbursed to the buyer (Article 1634)";
}
pub relation vendeur_de_mauvaise_foi_du_fonds_d_autrui(v: Vente) kind empirical {
    label fr official "le vendeur avait vendu de mauvaise foi le fonds d'autrui (article 1635)";
    label en unofficial "the seller had sold another's land in bad faith (Article 1635)";
}
pub relation depenses_voluptuaires_ou_d_agrement_faites(v: Vente) kind empirical {
    label fr official "l'acquéreur a fait au fonds des dépenses voluptuaires ou d'agrément (article 1635)";
    label en unofficial "the buyer made voluptuary or ornamental expenses on the land (Article 1635)";
}
pub relation remboursement_de_toutes_les_depenses_du(v: Vente) kind derived {
    label fr official "le vendeur est obligé de rembourser à l'acquéreur toutes les dépenses, même voluptuaires ou d'agrément (article 1635)";
    label en unofficial "the seller must reimburse the buyer all expenses, even voluptuary or ornamental ones (Article 1635)";
}
pub relation partie_evincee_de_telle_consequence(v: Vente) kind empirical {
    label fr official "la partie dont l'acquéreur est évincé est de telle conséquence, relativement au tout, qu'il n'eût point acheté sans elle (article 1636)";
    label en unofficial "the part of which the buyer is evicted is of such consequence, relative to the whole, that he would not have bought without it (Article 1636)";
}
pub relation acheteur_peut_faire_resilier_la_vente(v: Vente) kind derived {
    label fr official "l'acquéreur peut faire résilier la vente (article 1636)";
    label en unofficial "the buyer may have the sale terminated (Article 1636)";
}
pub relation vente_non_resiliee_apres_eviction_partielle(v: Vente) kind empirical {
    label fr official "dans le cas de l'éviction d'une partie du fonds vendu, la vente n'est pas résiliée (article 1637)";
    label en unofficial "in the case of eviction from part of the land sold, the sale is not terminated (Article 1637)";
}
pub relation valeur_de_la_partie_evincee_a_l_eviction(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "valeur de la partie dont l'acquéreur se trouve évincé, suivant l'estimation à l'époque de l'éviction (article 1637)";
    label en unofficial "value of the part of which the buyer is evicted, according to the valuation at the time of the eviction (Article 1637)";
}
pub relation remboursement_de_la_partie_evincee_du(v: Vente, m: Money) kind derived {
    key(v);
    label fr official "la valeur de la partie dont l'acquéreur est évincé lui est remboursée suivant l'estimation à l'époque de l'éviction, et non proportionnellement au prix total de la vente (article 1637)";
    label en unofficial "the value of the part of which the buyer is evicted is reimbursed to him according to the valuation at the time of the eviction, and not in proportion to the total price of the sale (Article 1637)";
}
pub relation servitudes_non_apparentes_non_declarees(v: Vente) kind empirical {
    label fr official "l'héritage vendu se trouve grevé de servitudes non apparentes, sans qu'il en ait été fait de déclaration (article 1638)";
    label en unofficial "the estate sold is burdened with non-apparent servitudes, without any declaration having been made (Article 1638)";
}
pub relation servitudes_de_telle_importance(v: Vente) kind empirical {
    label fr official "les servitudes sont de telle importance qu'il y a lieu de présumer que l'acquéreur n'aurait pas acheté s'il en avait été instruit (article 1638)";
    label en unofficial "the servitudes are of such importance that the buyer may be presumed not to have bought had he been informed of them (Article 1638)";
}
pub relation acquereur_peut_demander_resiliation_pour_servitudes(v: Vente) kind derived {
    label fr official "l'acquéreur peut demander la résiliation du contrat pour servitudes non apparentes non déclarées (article 1638)";
    label en unofficial "the buyer may claim termination of the contract for undeclared non-apparent servitudes (Article 1638)";
}
pub relation demande_resiliation_pour_servitudes(v: Vente) kind empirical {
    label fr official "l'acquéreur a demandé la résiliation pour servitudes non apparentes (article 1638)";
    label en unofficial "the buyer requested termination for undeclared non-apparent servitudes (Article 1638)";
}
pub relation resiliation_demandee_pour_servitudes(v: Vente) kind institutional {
    label fr official "la résiliation pour servitudes est demandée par l'acquéreur (article 1638)";
    label en unofficial "termination for servitudes was requested by the buyer (Article 1638)";
}
pub relation indemnisation_choisie_pour_servitudes(v: Vente) kind empirical {
    label fr official "l'acquéreur a choisi l'indemnité au lieu de la résiliation (article 1638)";
    label en unofficial "the buyer chose indemnity instead of termination (Article 1638)";
}
pub relation acquereur_prefere_une_indemnite(v: Vente) kind empirical {
    label fr official "l'acquéreur aime mieux se contenter d'une indemnité (article 1638)";
    label en unofficial "the buyer prefers to be satisfied with an indemnity (Article 1638)";
}
pub relation indemnite_pour_servitudes_due(v: Vente) kind derived {
    label fr official "une indemnité est due à l'acquéreur pour les servitudes non apparentes non déclarées (article 1638)";
    label en unofficial "an indemnity is owed to the buyer for the undeclared non-apparent servitudes (Article 1638)";
}
pub relation condamnation_en_dernier_ressort_sans_appeler_le_vendeur(v: Vente) kind empirical {
    label fr official "l'acquéreur s'est laissé condamner par un jugement en dernier ressort, ou dont l'appel n'est plus recevable, sans appeler son vendeur (article 1640)";
    label en unofficial "the buyer allowed himself to be condemned by a judgment in last resort, or whose appeal is no longer admissible, without calling his seller (Article 1640)";
}
pub relation vendeur_prouve_moyens_suffisants(v: Vente) kind empirical {
    label fr official "le vendeur prouve qu'il existait des moyens suffisants pour faire rejeter la demande (article 1640)";
    label en unofficial "the seller proves that sufficient means existed to have the claim dismissed (Article 1640)";
}
pub relation garantie_d_eviction_cesse(v: Vente) kind derived {
    label fr official "la garantie pour cause d'éviction cesse (article 1640)";
    label en unofficial "the warranty for cause of eviction ceases (Article 1640)";
}

// --- Titre VI : vices cachés (1642 à 1647), résolution (1656), rachat (1659 à 1673), rescision (1677 à 1685) ---

pub relation vice_apparent(v: Vente, x: Vice) kind empirical {
    label fr official "le vice est apparent et l'acheteur a pu s'en convaincre lui-même (article 1642)";
    label en unofficial "the defect is apparent and the buyer could see it for himself (Article 1642)";
}
pub relation vendeur_non_tenu_des_vices_apparents(v: Vente, x: Vice) kind derived {
    label fr official "le vendeur n'est pas tenu des vices apparents (article 1642)";
    label en unofficial "the seller is not liable for apparent defects (Article 1642)";
}
pub relation clause_de_non_garantie_des_vices(v: Vente) kind empirical {
    label fr official "le vendeur a stipulé qu'il ne serait obligé à aucune garantie des vices cachés (article 1643)";
    label en unofficial "the seller stipulated that he would owe no warranty for latent defects (Article 1643)";
}
pub relation vendeur_tenu_des_vices_meme_ignores(v: Vente, x: Vice) kind derived {
    label fr official "le vendeur est tenu des vices cachés quand même il ne les aurait pas connus, à moins qu'il n'ait stipulé n'être obligé à aucune garantie (article 1643)";
    label en unofficial "the seller is liable for latent defects even if he did not know of them, unless he stipulated that he owed no warranty (Article 1643)";
}
pub relation vendeur_connaissait_les_vices(v: Vente, x: Vice) kind empirical {
    label fr official "le vendeur connaissait les vices de la chose (article 1645)";
    label en unofficial "the seller knew of the defects of the thing (Article 1645)";
}
pub relation vendeur_ignorait_les_vices(v: Vente, x: Vice) kind empirical {
    label fr official "le vendeur ignorait les vices de la chose (article 1646)";
    label en unofficial "the seller was unaware of the defects of the thing (Article 1646)";
}
pub relation restitution_du_prix_et_dommages_interets_dus(v: Vente) kind derived {
    label fr official "le vendeur qui connaissait les vices est tenu, outre la restitution du prix, de tous les dommages et intérêts envers l'acheteur (article 1645)";
    label en unofficial "a seller who knew of the defects owes, besides restitution of the price, all damages to the buyer (Article 1645)";
}
pub relation dommages_interets_des_vices_payes(v: Vente) kind empirical {
    label fr official "le vendeur a payé les dommages-intérêts dus pour les vices connus (article 1645)";
    label en unofficial "the seller paid damages due for known defects (Article 1645)";
}
pub relation restitution_du_prix_et_frais_de_la_vente_dus(v: Vente) kind derived {
    label fr official "le vendeur qui ignorait les vices n'est tenu qu'à la restitution du prix et au remboursement des frais occasionnés par la vente (article 1646)";
    label en unofficial "a seller unaware of the defects owes only restitution of the price and reimbursement of the costs occasioned by the sale (Article 1646)";
}
pub relation garanties_des_constructeurs_dues_par_le_vendeur(v: Vente) kind derived {
    label fr official "le vendeur d'un immeuble à construire est tenu, à compter de la réception des travaux, des obligations des articles 1792, 1792-1, 1792-2 et 1792-3 (article 1646-1, alinéa 1)";
    label en unofficial "the seller of a building to be constructed owes, from acceptance of the works, the obligations of Articles 1792, 1792-1, 1792-2 and 1792-3 (Article 1646-1, first paragraph)";
}
pub relation proprietaire_successif_de_l_immeuble(v: Vente, p: Personne) kind empirical {
    label fr official "propriétaire successif de l'immeuble, à qui les garanties bénéficient (article 1646-1, alinéa 2)";
    label en unofficial "successive owner of the building, to whom the warranties accrue (Article 1646-1, second paragraph)";
}
pub relation garanties_beneficient_au_proprietaire_successif(v: Vente, p: Personne) kind derived {
    label fr official "ces garanties bénéficient aux propriétaires successifs de l'immeuble (article 1646-1, alinéa 2)";
    label en unofficial "these warranties accrue to the successive owners of the building (Article 1646-1, second paragraph)";
}
pub relation chose_perie_par_sa_mauvaise_qualite(v: Vente) kind empirical {
    label fr official "la chose qui avait des vices a péri par suite de sa mauvaise qualité (article 1647, alinéa 1)";
    label en unofficial "the defective thing perished as a result of its poor quality (Article 1647, first paragraph)";
}
pub relation chose_perie_par_cas_fortuit(v: Vente) kind empirical {
    label fr official "la perte est arrivée par cas fortuit (article 1647, alinéa 2)";
    label en unofficial "the loss occurred by fortuitous event (Article 1647, second paragraph)";
}
pub relation perte_pour_le_vendeur(v: Vente) kind derived {
    label fr official "la perte est pour le vendeur, tenu envers l'acheteur à la restitution du prix (article 1647, alinéa 1)";
    label en unofficial "the loss falls on the seller, liable to the buyer for restitution of the price (Article 1647, first paragraph)";
}
pub relation perte_pour_l_acheteur(v: Vente) kind derived {
    label fr official "la perte arrivée par cas fortuit est pour le compte de l'acheteur (article 1647, alinéa 2)";
    label en unofficial "a loss occurring by fortuitous event is for the buyer's account (Article 1647, second paragraph)";
}
pub relation clause_de_resolution_de_plein_droit_pour_prix_impaye(v: Vente) kind empirical {
    label fr official "il a été stipulé lors de la vente d'immeubles que, faute du paiement du prix dans le terme convenu, la vente serait résolue de plein droit (article 1656)";
    label en unofficial "it was stipulated at the sale of immovables that, in default of payment of the price within the agreed term, the sale would be terminated by operation of law (Article 1656)";
}
pub relation sommation_de_payer_faite(v: Vente) kind empirical {
    label fr official "l'acquéreur a été mis en demeure par une sommation (article 1656)";
    label en unofficial "the buyer has been put in default by a summons (Article 1656)";
}
pub relation acquereur_peut_encore_payer(v: Vente) kind derived {
    label fr official "l'acquéreur peut néanmoins payer après l'expiration du délai, tant qu'il n'a pas été mis en demeure par une sommation (article 1656)";
    label en unofficial "the buyer may nevertheless pay after the term expires, so long as he has not been put in default by a summons (Article 1656)";
}
pub relation paiement_tardif_par_acquereur(v: Vente) kind empirical {
    label fr official "l'acquéreur a payé après l'expiration du délai avant sommation (article 1656)";
    label en unofficial "the buyer paid after expiry and before summons (Article 1656)";
}
pub relation juge_ne_peut_plus_accorder_de_delai(v: Vente) kind derived {
    label fr official "après la sommation, le juge ne peut pas accorder de délai à l'acquéreur (article 1656)";
    label en unofficial "after the summons, the court may not grant the buyer any further time (Article 1656)";
}
pub relation pacte_de_rachat_stipule(v: Vente) kind empirical {
    label fr official "le vendeur s'est réservé, par un pacte de rachat, de reprendre la chose vendue (article 1659)";
    label en unofficial "the seller reserved, by a redemption pact, the right to take back the thing sold (Article 1659)";
}
pub relation terme_de_rachat_de_rigueur(v: Vente) kind derived {
    label fr official "le terme fixé pour le rachat est de rigueur et ne peut être prolongé par le juge (article 1661)";
    label en unofficial "the term fixed for redemption is strict and may not be extended by the court (Article 1661)";
}
pub relation action_en_rachat_exercee_dans_le_terme(v: Vente) kind empirical {
    label fr official "le vendeur a exercé son action en rachat dans le terme prescrit (article 1662)";
    label en unofficial "the seller exercised his action for redemption within the prescribed term (Article 1662)";
}
pub relation action_en_rachat_non_exercee_dans_le_terme(v: Vente) kind empirical {
    label fr official "le vendeur n'a pas exercé son action en rachat dans le terme prescrit (article 1662)";
    label en unofficial "the seller did not exercise his action for redemption within the prescribed term (Article 1662)";
}
pub relation acquereur_proprietaire_irrevocable(v: Vente) kind derived {
    label fr official "l'acquéreur demeure propriétaire irrévocable (article 1662)";
    label en unofficial "the buyer remains irrevocable owner (Article 1662)";
}
pub relation prix_principal_rembourse(v: Vente) kind empirical {
    label fr official "le vendeur a remboursé le prix principal de la vente (article 1673, alinéa 1)";
    label en unofficial "the seller has repaid the principal price of the sale (Article 1673, first paragraph)";
}
pub relation frais_et_loyaux_couts_rembourses(v: Vente) kind empirical {
    label fr official "le vendeur a remboursé les frais et loyaux coûts de la vente (article 1673, alinéa 1)";
    label en unofficial "the seller has repaid the costs and lawful expenses of the sale (Article 1673, first paragraph)";
}
pub relation reparations_necessaires_remboursees(v: Vente) kind empirical {
    label fr official "le vendeur a remboursé les réparations nécessaires et celles qui ont augmenté la valeur du fonds, jusqu'à concurrence de cette augmentation (article 1673, alinéa 1)";
    label en unofficial "the seller has repaid the necessary repairs and those that increased the value of the land, up to that increase (Article 1673, first paragraph)";
}
pub relation vendeur_peut_entrer_en_possession(v: Vente) kind derived {
    label fr official "le vendeur ne peut entrer en possession qu'après avoir satisfait à toutes les obligations de l'article 1673 (article 1673, alinéa 1)";
    label en unofficial "the seller may enter into possession only after satisfying all the obligations of Article 1673 (Article 1673, first paragraph)";
}
pub relation pacte_publie_au_fichier_immobilier_avant_les_charges(v: Vente) kind empirical {
    label fr official "le pacte de rachat a été régulièrement publié au fichier immobilier antérieurement à la publication des charges et hypothèques (article 1673, alinéa 2)";
    label en unofficial "the redemption pact was duly published in the land register before the publication of the charges and mortgages (Article 1673, second paragraph)";
}
pub relation heritage_repris_exempt_de_charges(v: Vente) kind derived {
    label fr official "le vendeur reprend l'héritage exempt de toutes les charges et hypothèques dont l'acquéreur l'aurait grevé (article 1673, alinéa 2)";
    label en unofficial "the seller takes back the estate free of all charges and mortgages with which the buyer may have burdened it (Article 1673, second paragraph)";
}
pub relation baux_faits_sans_fraude_par_l_acquereur(v: Vente) kind empirical {
    label fr official "des baux ont été faits sans fraude par l'acquéreur (article 1673, alinéa 2)";
    label en unofficial "leases were made without fraud by the buyer (Article 1673, second paragraph)";
}
pub relation vendeur_tenu_d_executer_les_baux(v: Vente) kind derived {
    label fr official "le vendeur est tenu d'exécuter les baux faits sans fraude par l'acquéreur (article 1673, alinéa 2)";
    label en unofficial "the seller must perform the leases made without fraud by the buyer (Article 1673, second paragraph)";
}
pub relation faits_articules_vraisemblables_et_graves(v: Vente) kind empirical {
    label fr official "les faits articulés sont assez vraisemblables et assez graves pour faire présumer la lésion (article 1677)";
    label en unofficial "the facts pleaded are sufficiently likely and serious to give rise to a presumption of injury (Article 1677)";
}
pub relation preuve_de_la_lesion_admise(v: Vente) kind derived {
    label fr official "la preuve de la lésion est admise par jugement (article 1677)";
    label en unofficial "proof of the injury is admitted by judgment (Article 1677)";
}
pub relation rapport_de_trois_experts_produit(v: Vente) kind empirical {
    label fr official "la preuve est faite par un rapport de trois experts, dressé en un seul procès-verbal commun et ne formant qu'un seul avis à la pluralité des voix (article 1678)";
    label en unofficial "proof is made by a report of three experts, drawn up in a single common record and forming a single opinion by majority (Article 1678)";
}
pub relation preuve_de_la_lesion_recevable(v: Vente) kind derived {
    label fr official "la preuve de la lésion est recevable : elle est admise par jugement et faite par le rapport de trois experts (articles 1677 et 1678)";
    label en unofficial "proof of the injury is admissible: admitted by judgment and made by the report of three experts (Articles 1677 and 1678)";
}
pub relation experts_nommes_conjointement_par_les_parties(v: Vente) kind empirical {
    label fr official "les parties se sont accordées pour nommer les trois experts conjointement (article 1680)";
    label en unofficial "the parties agreed to appoint the three experts jointly (Article 1680)";
}
pub relation experts_nommes_d_office(v: Vente) kind derived {
    label fr official "les trois experts sont nommés d'office, à moins que les parties ne se soient accordées pour les nommer conjointement (article 1680)";
    label en unofficial "the three experts are appointed by the court unless the parties agreed to appoint them jointly (Article 1680)";
}
pub relation acquereur_choisit_de_rendre_la_chose(v: Vente) kind empirical {
    label fr official "l'acquéreur choisit de rendre la chose en retirant le prix qu'il en a payé (article 1681, alinéa 1)";
    label en unofficial "the buyer chooses to return the thing and withdraw the price he paid (Article 1681, first paragraph)";
}
pub relation acquereur_choisit_de_garder_le_fonds(v: Vente) kind empirical {
    label fr official "l'acquéreur choisit de garder le fonds en payant le supplément du juste prix (article 1681, alinéa 1)";
    label en unofficial "the buyer chooses to keep the land by paying the supplement of the fair price (Article 1681, first paragraph)";
}
pub relation restitution_du_prix_paye_a_l_acquereur_due(v: Vente) kind derived {
    label fr official "l'acquéreur qui rend la chose retire le prix qu'il en a payé (article 1681, alinéa 1)";
    label en unofficial "the buyer who returns the thing withdraws the price he paid (Article 1681, first paragraph)";
}
pub relation supplement_du_juste_prix_du(v: Vente) kind derived {
    label fr official "l'acquéreur qui garde le fonds paie le supplément du juste prix, sous la déduction du dixième du prix total (article 1681, alinéa 1)";
    label en unofficial "the buyer who keeps the land pays the supplement of the fair price, less one tenth of the total price (Article 1681, first paragraph)";
}
pub relation interet_du_supplement_du_du_jour_de_la_demande(v: Vente) kind derived {
    label fr official "l'acquéreur qui garde la chose doit l'intérêt du supplément, du jour de la demande en rescision (article 1682, alinéa 1)";
    label en unofficial "the buyer who keeps the thing owes interest on the supplement from the day of the claim for rescission (Article 1682, first paragraph)";
}
pub relation interet_du_supplement_paye(v: Vente) kind empirical {
    label fr official "l'acquéreur a payé l'intérêt du supplément depuis la demande en rescision (article 1682)";
    label en unofficial "the buyer paid interest on the supplement from the rescission claim (Article 1682)";
}
pub relation fruits_rendus_du_jour_de_la_demande(v: Vente) kind derived {
    label fr official "l'acquéreur qui rend la chose rend les fruits du jour de la demande (article 1682, alinéa 2)";
    label en unofficial "the buyer who returns the thing returns the fruits from the day of the claim (Article 1682, second paragraph)";
}
pub relation vente_faite_d_autorite_de_justice_par_la_loi(v: Vente) kind empirical {
    label fr official "la vente ne peut, d'après la loi, être faite que d'autorité de justice (article 1684)";
    label en unofficial "under the law, the sale can only be made by judicial authority (Article 1684)";
}
pub relation rescision_exclue_vente_d_autorite_de_justice(v: Vente) kind derived {
    label fr official "la rescision pour lésion n'a pas lieu dans les ventes qui, d'après la loi, ne peuvent être faites que d'autorité de justice (article 1684)";
    label en unofficial "rescission for injury does not lie in sales which, under the law, can only be made by judicial authority (Article 1684)";
}
pub relation supplement_offert_par_l_acquereur(v: Vente, m: Money) kind empirical {
    key(v);
    label fr official "supplément que l'acquéreur qui garde le fonds offre de payer (article 1681, alinéa 1)";
    label en unofficial "supplement the buyer who keeps the land offers to pay (Article 1681, first paragraph)";
}
pub relation supplement_conforme_a_l_article_1681(v: Vente, m: Money) kind derived {
    key(v);
    label fr official "le supplément offert est celui qu'exige l'article 1681 : le juste prix moins le prix payé, sous la déduction du dixième du prix total (article 1681, alinéa 1)";
    label en unofficial "the supplement offered is the one Article 1681 requires: the fair price less the price paid, minus one tenth of the total price (Article 1681, first paragraph)";
}

// --- Titre VIII, chapitre II : louage des choses, suite (1709 à 1761) ---

pub relation obligation_de_faire_jouir_pendant_un_certain_temps(b: Bail) kind empirical {
    label fr official "l'une des parties s'oblige à faire jouir l'autre d'une chose pendant un certain temps (article 1709)";
    label en unofficial "one party undertakes to let the other enjoy a thing for a certain time (Article 1709)";
}
pub relation prix_du_bail_convenu(b: Bail, m: Money) kind empirical {
    key(b);
    label fr official "certain prix que le preneur s'oblige à payer au bailleur (article 1709)";
    label en unofficial "certain price the lessee undertakes to pay the lessor (Article 1709)";
}
pub relation louage_de_choses_qualifie(b: Bail) kind derived {
    label fr official "le contrat est un louage de choses (article 1709)";
    label en unofficial "the contract is a lease of things (Article 1709)";
}
pub relation forme_de_la_chose_louee_inchangeable(b: Bail) kind derived {
    label fr official "le bailleur ne peut, pendant la durée du bail, changer la forme de la chose louée (article 1723)";
    label en unofficial "the lessor may not, during the lease, change the form of the leased thing (Article 1723)";
}
pub relation trouble_de_fait_par_des_tiers_sans_droit(b: Bail) kind empirical {
    label fr official "des tiers apportent par voies de fait un trouble à la jouissance, sans prétendre aucun droit sur la chose louée (article 1725)";
    label en unofficial "third parties disturb the enjoyment by acts of force, without claiming any right over the leased thing (Article 1725)";
}
pub relation bailleur_non_tenu_du_trouble_de_fait(b: Bail) kind derived {
    label fr official "le bailleur n'est pas tenu de garantir le preneur du trouble de fait causé par des tiers sans droit (article 1725)";
    label en unofficial "the lessor is not bound to warrant the lessee against a disturbance of fact by third parties without right (Article 1725)";
}
pub relation preneur_peut_poursuivre_en_son_nom_personnel(b: Bail) kind derived {
    label fr official "le preneur peut poursuivre en son nom personnel les auteurs des voies de fait (article 1725)";
    label en unofficial "the lessee may sue in his own name the authors of the acts of force (Article 1725)";
}
pub relation trouble_par_action_concernant_la_propriete(b: Bail) kind empirical {
    label fr official "le locataire ou le fermier a été troublé dans sa jouissance par suite d'une action concernant la propriété du fonds (article 1726)";
    label en unofficial "the tenant or farmer was disturbed in his enjoyment by an action concerning ownership of the land (Article 1726)";
}
pub relation trouble_denonce_au_proprietaire(b: Bail) kind empirical {
    label fr official "le trouble et l'empêchement ont été dénoncés au propriétaire (article 1726)";
    label en unofficial "the disturbance and hindrance were notified to the owner (Article 1726)";
}
pub relation diminution_proportionnee_du_prix_due(b: Bail) kind derived {
    label fr official "le preneur a droit à une diminution proportionnée sur le prix du bail à loyer ou à ferme (article 1726)";
    label en unofficial "the lessee is entitled to a proportionate reduction of the rent or farm rent (Article 1726)";
}
pub relation tiers_pretendent_un_droit_ou_preneur_cite_en_justice(b: Bail) kind empirical {
    label fr official "les auteurs des voies de fait prétendent un droit sur la chose louée, ou le preneur est cité en justice pour délaissement ou servitude (article 1727)";
    label en unofficial "the authors of the acts of force claim a right over the leased thing, or the lessee is summoned to court for surrender or a servitude (Article 1727)";
}
pub relation preneur_doit_appeler_le_bailleur_en_garantie(b: Bail) kind derived {
    label fr official "le preneur doit appeler le bailleur en garantie (article 1727)";
    label en unofficial "the lessee must call the lessor in warranty (Article 1727)";
}
pub relation appel_en_garantie_par_preneur(b: Bail) kind empirical {
    label fr official "le preneur a appelé le bailleur en garantie (article 1727)";
    label en unofficial "the lessee called the lessor in warranty (Article 1727)";
}
pub relation preneur_exige_d_etre_mis_hors_d_instance(b: Bail) kind empirical {
    label fr official "le preneur exige d'être mis hors d'instance en nommant le bailleur pour lequel il possède (article 1727)";
    label en unofficial "the lessee requires to be dismissed from the proceedings by naming the lessor for whom he possesses (Article 1727)";
}
pub relation preneur_mis_hors_d_instance(b: Bail) kind derived {
    label fr official "le preneur doit être mis hors d'instance, s'il l'exige, en nommant le bailleur pour lequel il possède (article 1727)";
    label en unofficial "the lessee must be dismissed from the proceedings, if he so requires, by naming the lessor for whom he possesses (Article 1727)";
}
pub relation usage_deraisonnable_de_la_chose_louee(b: Bail) kind empirical {
    label fr official "le preneur n'use pas de la chose louée raisonnablement (article 1729)";
    label en unofficial "the lessee does not use the leased thing reasonably (Article 1729)";
}
pub relation usage_autre_que_la_destination(b: Bail) kind empirical {
    label fr official "le preneur emploie la chose louée à un autre usage que celui auquel elle a été destinée, ou dont il peut résulter un dommage pour le bailleur (article 1729)";
    label en unofficial "the lessee uses the leased thing for a purpose other than that for which it was intended, or from which damage to the lessor may result (Article 1729)";
}
pub relation bailleur_peut_faire_resilier_le_bail(b: Bail) kind derived {
    label fr official "le bailleur peut, suivant les circonstances, faire résilier le bail (article 1729)";
    label en unofficial "the lessor may, according to the circumstances, have the lease terminated (Article 1729)";
}
pub relation demande_resiliation_par_bailleur(b: Bail) kind empirical {
    label fr official "le bailleur a demandé la résiliation du bail pour usage fautif (article 1729)";
    label en unofficial "the lessor requested termination for wrongful use (Article 1729)";
}
pub relation resiliation_demandee_par_bailleur(b: Bail) kind institutional {
    label fr official "la résiliation du bail est demandée par le bailleur (article 1729)";
    label en unofficial "termination of the lease was requested by the lessor (Article 1729)";
}
pub relation etat_des_lieux_dresse(b: Bail) kind empirical {
    label fr official "un état des lieux a été fait entre le bailleur et le preneur (article 1730)";
    label en unofficial "an inventory of fixtures was made between the lessor and the lessee (Article 1730)";
}
pub relation perte_ou_degradation_par_vetuste_ou_force_majeure(b: Bail) kind empirical {
    label fr official "ce qui a péri ou a été dégradé l'a été par vétusté ou force majeure (article 1730)";
    label en unofficial "what perished or was damaged was so by age or force majeure (Article 1730)";
}
pub relation restitution_conforme_a_l_etat_des_lieux_due(b: Bail) kind derived {
    label fr official "le preneur doit rendre la chose telle qu'il l'a reçue suivant l'état des lieux, excepté ce qui a péri ou a été dégradé par vétusté ou force majeure (article 1730)";
    label en unofficial "the lessee must return the thing as he received it according to the inventory, save what perished or was damaged by age or force majeure (Article 1730)";
}
pub relation restitution_conforme_a_l_etat_des_lieux_effectuee(b: Bail) kind empirical {
    label fr official "le preneur a rendu la chose conformément à l'état des lieux (article 1730)";
    label en unofficial "the lessee returned the thing according to the inventory (Article 1730)";
}
pub relation preuve_contraire_du_mauvais_etat_initial(b: Bail) kind empirical {
    label fr official "la preuve contraire du bon état de réparations locatives à l'entrée est rapportée (article 1731)";
    label en unofficial "proof to the contrary of the good state of tenant's repairs on entry is adduced (Article 1731)";
}
pub relation preneur_presume_avoir_recu_en_bon_etat(b: Bail) kind derived {
    label fr official "à défaut d'état des lieux, le preneur est présumé les avoir reçus en bon état de réparations locatives et doit les rendre tels, sauf la preuve contraire (article 1731)";
    label en unofficial "in the absence of an inventory, the lessee is presumed to have received the premises in good tenantable repair and must return them so, save proof to the contrary (Article 1731)";
}
pub relation degradations_ou_pertes_pendant_la_jouissance(b: Bail) kind empirical {
    label fr official "des dégradations ou des pertes sont arrivées pendant la jouissance du preneur (article 1732)";
    label en unofficial "deteriorations or losses occurred during the lessee's enjoyment (Article 1732)";
}
pub relation preneur_prouve_l_absence_de_faute(b: Bail) kind empirical {
    label fr official "le preneur prouve que les dégradations ou pertes ont eu lieu sans sa faute (article 1732)";
    label en unofficial "the lessee proves that the deteriorations or losses occurred without his fault (Article 1732)";
}
pub relation preneur_repond_des_degradations(b: Bail) kind derived {
    label fr official "le preneur répond des dégradations ou des pertes qui arrivent pendant sa jouissance, à moins qu'il ne prouve qu'elles ont eu lieu sans sa faute (article 1732)";
    label en unofficial "the lessee answers for deteriorations or losses occurring during his enjoyment, unless he proves they occurred without his fault (Article 1732)";
}
pub relation incendie_survenu(b: Bail) kind empirical {
    label fr official "un incendie est survenu dans la chose louée (article 1733)";
    label en unofficial "a fire occurred in the leased thing (Article 1733)";
}
pub relation incendie_par_cas_fortuit_force_majeure_ou_vice_de_construction(b: Bail) kind empirical {
    label fr official "le preneur prouve que l'incendie est arrivé par cas fortuit ou force majeure, ou par vice de construction (article 1733)";
    label en unofficial "the lessee proves that the fire occurred by fortuitous event or force majeure, or by a construction defect (Article 1733)";
}
pub relation feu_communique_par_une_maison_voisine(b: Bail) kind empirical {
    label fr official "le preneur prouve que le feu a été communiqué par une maison voisine (article 1733)";
    label en unofficial "the lessee proves that the fire spread from a neighbouring house (Article 1733)";
}
pub relation preneur_repond_de_l_incendie(b: Bail) kind derived {
    label fr official "le preneur répond de l'incendie, à moins qu'il ne prouve l'une des trois causes nommées (article 1733)";
    label en unofficial "the lessee answers for the fire, unless he proves one of the three named causes (Article 1733)";
}
pub relation plusieurs_locataires(b: Bail) kind empirical {
    label fr official "il y a plusieurs locataires dans l'immeuble (article 1734, alinéa 1)";
    label en unofficial "there are several tenants in the building (Article 1734, first paragraph)";
}
pub relation incendie_commence_chez_un_locataire(b: Bail, p: Personne) kind empirical {
    label fr official "il est prouvé que l'incendie a commencé dans l'habitation de ce locataire (article 1734, alinéa 2)";
    label en unofficial "it is proved that the fire began in that tenant's dwelling (Article 1734, second paragraph)";
}
pub relation locataire_prouve_que_le_feu_n_a_pu_commencer_chez_lui(b: Bail, p: Personne) kind empirical {
    label fr official "ce locataire prouve que l'incendie n'a pu commencer chez lui (article 1734, alinéa 3)";
    label en unofficial "that tenant proves that the fire could not have begun on his premises (Article 1734, third paragraph)";
}
pub relation locataire_de_l_immeuble(b: Bail, p: Personne) kind empirical {
    label fr official "locataire de l'immeuble, partie à la responsabilité de l'incendie (article 1734)";
    label en unofficial "tenant of the building, party to liability for the fire (Article 1734)";
}
pub relation locataire_seul_tenu_de_l_incendie(b: Bail, p: Personne) kind derived {
    label fr official "s'il est prouvé que l'incendie a commencé dans l'habitation de l'un d'eux, celui-là seul en est tenu (article 1734, alinéa 2)";
    label en unofficial "if it is proved that the fire began in the dwelling of one of them, he alone is liable (Article 1734, second paragraph)";
}
pub relation locataire_non_tenu_de_l_incendie(b: Bail, p: Personne) kind derived {
    label fr official "le locataire qui prouve que l'incendie n'a pu commencer chez lui n'en est pas tenu (article 1734, alinéa 3)";
    label en unofficial "a tenant who proves that the fire could not have begun on his premises is not liable (Article 1734, third paragraph)";
}
pub relation locataire_tenu_proportionnellement_a_la_valeur_locative(b: Bail, p: Personne) kind derived {
    label fr official "tous les locataires sont responsables de l'incendie, proportionnellement à la valeur locative de la partie de l'immeuble qu'ils occupent (article 1734, alinéa 1)";
    label en unofficial "all tenants are liable for the fire, in proportion to the rental value of the part of the building they occupy (Article 1734, first paragraph)";
}
pub relation responsabilite_proportionnelle_assumee(b: Bail, p: Personne) kind empirical {
    label fr official "le locataire a assumé sa responsabilité proportionnelle pour l'incendie (article 1734)";
    label en unofficial "the tenant assumed proportional liability for the fire (Article 1734)";
}
pub relation degradation_par_les_personnes_de_la_maison_du_preneur(b: Bail) kind empirical {
    label fr official "des dégradations ou pertes arrivent par le fait des personnes de la maison du preneur ou de ses sous-locataires (article 1735)";
    label en unofficial "deteriorations or losses occur through the act of the persons of the lessee's household or of his subtenants (Article 1735)";
}
pub relation preneur_tenu_du_fait_de_sa_maison(b: Bail) kind derived {
    label fr official "le preneur est tenu des dégradations et des pertes qui arrivent par le fait des personnes de sa maison ou de ses sous-locataires (article 1735)";
    label en unofficial "the lessee is liable for deteriorations and losses occurring through the act of the persons of his household or of his subtenants (Article 1735)";
}
pub relation degradations_des_personnes_reparees(b: Bail) kind empirical {
    label fr official "le preneur a réparé les dégradations imputables aux personnes de sa maison (article 1735)";
    label en unofficial "the lessee repaired damage attributable to persons of his household (Article 1735)";
}
pub relation caution_donnee_pour_le_bail(b: Bail) kind empirical {
    label fr official "une caution a été donnée pour le bail (article 1740)";
    label en unofficial "a surety was given for the lease (Article 1740)";
}
pub relation caution_non_etendue_a_la_prolongation(b: Bail) kind derived {
    label fr official "la caution donnée pour le bail ne s'étend pas aux obligations résultant de la prolongation par tacite reconduction (article 1740)";
    label en unofficial "the surety given for the lease does not extend to obligations arising from the tacit renewal (Article 1740)";
}
pub relation perte_de_la_chose_louee(b: Bail) kind empirical {
    label fr official "la chose louée a péri (article 1741)";
    label en unofficial "the leased thing has perished (Article 1741)";
}
pub relation defaut_de_remplir_les_engagements(b: Bail) kind empirical {
    label fr official "le bailleur ou le preneur a manqué de remplir ses engagements (article 1741)";
    label en unofficial "the lessor or the lessee has failed to fulfil his undertakings (Article 1741)";
}
pub relation contrat_de_louage_resolu(b: Bail) kind derived {
    label fr official "le contrat de louage se résout par la perte de la chose louée et par le défaut respectif de remplir les engagements (article 1741)";
    label en unofficial "the lease is dissolved by the loss of the leased thing and by the respective failure to fulfil the undertakings (Article 1741)";
}
pub relation aucune_stipulation_sur_les_dommages_interets(b: Bail) kind empirical {
    label fr official "il n'a été fait aucune stipulation sur les dommages-intérêts dus au locataire expulsé en cas de vente (article 1744)";
    label en unofficial "no stipulation was made on the damages owed to the tenant evicted upon a sale (Article 1744)";
}
pub relation bailleur_tenu_d_indemniser_le_locataire(b: Bail) kind derived {
    label fr official "le bailleur est tenu d'indemniser le locataire expulsé en cas de vente (article 1744)";
    label en unofficial "the lessor must indemnify the tenant evicted upon a sale (Article 1744)";
}
pub relation bail_de_maison_appartement_ou_boutique(b: Bail) kind empirical {
    label fr official "le bail porte sur une maison, un appartement ou une boutique (article 1745)";
    label en unofficial "the lease concerns a house, a flat or a shop (Article 1745)";
}
pub relation loyer_du_temps_entre_conge_et_sortie(b: Bail, m: Money) kind empirical {
    key(b);
    label fr official "prix du loyer pendant le temps qui, suivant l'usage des lieux, est accordé entre le congé et la sortie (article 1745)";
    label en unofficial "amount of rent for the time which, according to local usage, is allowed between notice and departure (Article 1745)";
}
pub relation indemnite_du_locataire_evince(b: Bail, m: Money) kind derived {
    key(b);
    label fr official "somme égale au prix du loyer pendant le temps accordé entre le congé et la sortie, payée à titre de dommages et intérêts au locataire évincé (article 1745)";
    label en unofficial "sum equal to the rent for the time allowed between notice and departure, paid as damages to the evicted tenant (Article 1745)";
}
pub relation bail_de_biens_ruraux(b: Bail) kind empirical {
    label fr official "le bail porte sur des biens ruraux (article 1746)";
    label en unofficial "the lease concerns rural property (Article 1746)";
}
pub relation prix_du_bail_pour_le_temps_restant(b: Bail, m: Money) kind empirical {
    key(b);
    label fr official "prix du bail pour tout le temps qui reste à courir (article 1746)";
    label en unofficial "price of the lease for all the time remaining to run (Article 1746)";
}
pub relation indemnite_du_fermier_evince(b: Bail, m: Money) kind derived {
    key(b);
    label fr official "l'indemnité due au fermier est du tiers du prix du bail pour tout le temps qui reste à courir (article 1746)";
    label en unofficial "the indemnity owed to the farmer is one third of the price of the lease for all the time remaining to run (Article 1746)";
}
pub relation etablissement_exigeant_de_grandes_avances(b: Bail) kind empirical {
    label fr official "il s'agit de manufactures, usines ou autres établissements qui exigent de grandes avances (article 1747)";
    label en unofficial "the case concerns factories, works or other establishments requiring large advances (Article 1747)";
}
pub relation indemnite_reglee_par_experts(b: Bail) kind derived {
    label fr official "l'indemnité se règle par experts (article 1747)";
    label en unofficial "the indemnity is settled by experts (Article 1747)";
}
pub relation acquereur_a_averti_au_temps_usite(b: Bail) kind empirical {
    label fr official "l'acquéreur a averti le locataire au temps d'avance usité dans le lieu pour les congés (article 1748)";
    label en unofficial "the buyer gave the tenant the advance notice customary in the place (Article 1748)";
}
pub relation expulsion_subordonnee_a_l_avertissement(b: Bail) kind derived {
    label fr official "l'acquéreur qui veut user de la faculté d'expulser doit en outre avertir le locataire au temps d'avance usité (article 1748)";
    label en unofficial "the buyer who wishes to exercise the power to evict must also warn the tenant with the customary advance notice (Article 1748)";
}
pub relation avertissement_donne_par_acquereur(b: Bail) kind empirical {
    label fr official "l'acquéreur a donné l'avertissement préalable à l'expulsion (article 1748)";
    label en unofficial "the buyer gave the advance warning before eviction (Article 1748)";
}
pub relation dommages_interets_payes_au_locataire(b: Bail) kind empirical {
    label fr official "le locataire a été payé des dommages et intérêts par le bailleur ou par le nouvel acquéreur (article 1749)";
    label en unofficial "the tenant has been paid damages by the lessor or by the new buyer (Article 1749)";
}
pub relation expulsion_interdite_avant_paiement(b: Bail) kind derived {
    label fr official "les locataires ne peuvent être expulsés qu'ils ne soient payés des dommages et intérêts (article 1749)";
    label en unofficial "tenants may not be evicted until they have been paid the damages (Article 1749)";
}
pub relation expulsion_tentee_avant_paiement(b: Bail) kind empirical {
    label fr official "l'expulsion a été tentée avant paiement des dommages-intérêts (article 1749)";
    label en unofficial "eviction was attempted before damages were paid (Article 1749)";
}
pub relation acquereur_non_tenu_de_dommages_interets(b: Bail) kind derived {
    label fr official "si le bail n'est pas fait par acte authentique ou n'a point de date certaine, l'acquéreur n'est tenu d'aucuns dommages et intérêts (article 1750)";
    label en unofficial "if the lease is not in authentic form or has no certain date, the buyer owes no damages (Article 1750)";
}
pub relation dissolution_du_pacs(b: Bail) kind empirical {
    label fr official "le pacte civil de solidarité est dissous (article 1751-1)";
    label en unofficial "the civil solidarity pact is dissolved (Article 1751-1)";
}
pub relation partenaire_demande_l_attribution_du_bail(b: Bail, p: Personne) kind empirical {
    label fr official "l'un des partenaires saisit le juge aux fins de se voir attribuer le droit au bail (article 1751-1)";
    label en unofficial "one of the partners applies to the court to be awarded the right to the lease (Article 1751-1)";
}
pub relation attribution_du_bail_soumise_au_juge(b: Bail, p: Personne) kind derived {
    label fr official "le juge apprécie la demande d'attribution du bail en considération des intérêts sociaux et familiaux des parties, le bailleur appelé à l'instance (article 1751-1)";
    label en unofficial "the court assesses the application for award of the lease in the light of the parties' social and family interests, the lessor being joined to the proceedings (Article 1751-1)";
}
pub relation maison_non_garnie_de_meubles_suffisants(b: Bail) kind empirical {
    label fr official "le locataire ne garnit pas la maison de meubles suffisants (article 1752)";
    label en unofficial "the tenant does not furnish the house with sufficient movables (Article 1752)";
}
pub relation suretes_capables_de_repondre_du_loyer_donnees(b: Bail) kind empirical {
    label fr official "le locataire donne des sûretés capables de répondre du loyer (article 1752)";
    label en unofficial "the tenant gives security capable of answering for the rent (Article 1752)";
}
pub relation locataire_peut_etre_expulse_faute_de_meubles(b: Bail) kind derived {
    label fr official "le locataire qui ne garnit pas la maison de meubles suffisants peut être expulsé, à moins qu'il ne donne des sûretés capables de répondre du loyer (article 1752)";
    label en unofficial "a tenant who does not furnish the house with sufficient movables may be evicted, unless he gives security capable of answering for the rent (Article 1752)";
}
pub relation expulsion_tentee_faute_de_meubles(b: Bail) kind empirical {
    label fr official "l'expulsion a été tentée faute de meubles suffisants (article 1752)";
    label en unofficial "eviction was attempted for insufficient furniture (Article 1752)";
}
pub relation clause_contraire_sur_les_reparations_locatives(b: Bail) kind empirical {
    label fr official "une clause contraire règle la charge des réparations locatives ou de menu entretien (article 1754)";
    label en unofficial "a clause to the contrary governs liability for tenant's or minor upkeep repairs (Article 1754)";
}
pub relation reparation_designee_locative_par_l_usage_des_lieux(b: Bail) kind empirical {
    label fr official "la réparation est désignée comme locative ou de menu entretien par l'usage des lieux (article 1754)";
    label en unofficial "the repair is designated as a tenant's or minor upkeep repair by local usage (Article 1754)";
}
pub relation reparation_occasionnee_par_vetuste_ou_force_majeure(b: Bail) kind empirical {
    label fr official "la réparation n'est occasionnée que par vétusté ou force majeure (article 1755)";
    label en unofficial "the repair is occasioned only by age or force majeure (Article 1755)";
}
pub relation reparation_a_la_charge_du_locataire(b: Bail) kind derived {
    label fr official "la réparation locative ou de menu entretien est à la charge du locataire, s'il n'y a clause contraire (article 1754)";
    label en unofficial "the tenant's or minor upkeep repair is borne by the tenant, unless there is a clause to the contrary (Article 1754)";
}
pub relation reparation_locative_effectuee(b: Bail) kind empirical {
    label fr official "le locataire a effectué la réparation locative à sa charge (article 1754)";
    label en unofficial "the tenant performed the repair borne by him (Article 1754)";
}
pub relation reparation_non_a_la_charge_du_locataire(b: Bail) kind derived {
    label fr official "aucune des réparations réputées locatives n'est à la charge du locataire quand elles ne sont occasionnées que par vétusté ou force majeure (article 1755)";
    label en unofficial "no repair deemed a tenant's repair is borne by the tenant where it is occasioned only by age or force majeure (Article 1755)";
}
pub relation curement_de_puits_ou_de_fosses(b: Bail) kind empirical {
    label fr official "le curement des puits ou celui des fosses d'aisances est en cause (article 1756)";
    label en unofficial "the cleaning of wells or of cesspits is at issue (Article 1756)";
}
pub relation clause_contraire_sur_le_curement(b: Bail) kind empirical {
    label fr official "une clause contraire met le curement à la charge du preneur (article 1756)";
    label en unofficial "a clause to the contrary places the cleaning on the lessee (Article 1756)";
}
pub relation curement_a_la_charge_du_bailleur(b: Bail) kind derived {
    label fr official "le curement des puits et celui des fosses d'aisances sont à la charge du bailleur, s'il n'y a clause contraire (article 1756)";
    label en unofficial "the cleaning of wells and of cesspits is borne by the lessor, unless there is a clause to the contrary (Article 1756)";
}
pub relation resiliation_par_la_faute_du_locataire(b: Bail) kind empirical {
    label fr official "le bail est résilié par la faute du locataire (article 1760)";
    label en unofficial "the lease is terminated through the tenant's fault (Article 1760)";
}
pub relation loyer_du_pendant_la_relocation(b: Bail) kind derived {
    label fr official "le locataire est tenu de payer le prix du bail pendant le temps nécessaire à la relocation, sans préjudice des dommages et intérêts (article 1760)";
    label en unofficial "the tenant must pay the rent for the time needed to re-let, without prejudice to damages (Article 1760)";
}
pub relation bailleur_declare_vouloir_occuper_lui_meme(b: Bail) kind empirical {
    label fr official "le bailleur déclare vouloir occuper par lui-même la maison louée (article 1761)";
    label en unofficial "the lessor declares that he wishes to occupy the leased house himself (Article 1761)";
}
pub relation convention_contraire_sur_la_reprise(b: Bail) kind empirical {
    label fr official "une convention contraire permet au bailleur de résoudre la location pour occuper lui-même (article 1761)";
    label en unofficial "an agreement to the contrary allows the lessor to end the lease in order to occupy the premises himself (Article 1761)";
}
pub relation bailleur_ne_peut_resoudre_pour_occuper(b: Bail) kind derived {
    label fr official "le bailleur ne peut résoudre la location, encore qu'il déclare vouloir occuper par lui-même la maison louée, s'il n'y a eu convention contraire (article 1761)";
    label en unofficial "the lessor may not end the lease, even if he declares he wishes to occupy the leased house himself, unless there is an agreement to the contrary (Article 1761)";
}
pub relation resolution_tentee_pour_occuper(b: Bail) kind empirical {
    label fr official "le bailleur a tenté de résoudre le bail pour occuper lui-même (article 1761)";
    label en unofficial "the lessor attempted to terminate to occupy the house himself (Article 1761)";
}

// --- Titre VI, chapitres I à III : formation, délivrance et contenance (1584 à 1624) ---

pub relation marchandises_vendues_au_poids_au_compte_ou_a_la_mesure(v: Vente) kind empirical {
    label fr official "les marchandises ne sont pas vendues en bloc, mais au poids, au compte ou à la mesure (article 1585)";
    label en unofficial "the goods are not sold in bulk, but by weight, count or measure (Article 1585)";
}
pub relation marchandises_pesees_comptees_ou_mesurees(v: Vente) kind empirical {
    label fr official "les choses vendues ont été pesées, comptées ou mesurées (article 1585)";
    label en unofficial "the things sold have been weighed, counted or measured (Article 1585)";
}
pub relation choses_aux_risques_du_vendeur(v: Vente) kind derived {
    label fr official "les choses vendues sont aux risques du vendeur jusqu'à ce qu'elles soient pesées, comptées ou mesurées (article 1585)";
    label en unofficial "the things sold are at the seller's risk until they are weighed, counted or measured (Article 1585)";
}
pub relation marchandises_vendues_en_bloc(v: Vente) kind empirical {
    label fr official "les marchandises ont été vendues en bloc (article 1586)";
    label en unofficial "the goods were sold in bulk (Article 1586)";
}
pub relation chose_que_l_on_goute_avant_l_achat(v: Vente) kind empirical {
    label fr official "il s'agit du vin, de l'huile ou d'une autre chose que l'on est dans l'usage de goûter avant d'en faire l'achat (article 1587)";
    label en unofficial "the case concerns wine, oil or another thing customarily tasted before purchase (Article 1587)";
}
pub relation chose_goutee_et_agreee(v: Vente) kind empirical {
    label fr official "l'acheteur a goûté et agréé la chose (article 1587)";
    label en unofficial "the buyer has tasted and approved the thing (Article 1587)";
}
pub relation point_de_vente_avant_agrement(v: Vente) kind derived {
    label fr official "il n'y a point de vente tant que l'acheteur n'a pas goûté et agréé la chose (article 1587)";
    label en unofficial "there is no sale so long as the buyer has not tasted and approved the thing (Article 1587)";
}
pub relation vente_faite_a_l_essai(v: Vente) kind empirical {
    label fr official "la vente a été faite à l'essai (article 1588)";
    label en unofficial "the sale was made on trial (Article 1588)";
}
pub relation vente_presumee_sous_condition_suspensive(v: Vente) kind derived {
    label fr official "la vente faite à l'essai est toujours présumée faite sous une condition suspensive (article 1588)";
    label en unofficial "a sale made on trial is always presumed made subject to a condition precedent (Article 1588)";
}
pub relation engagement_unilateral_avec_versement_pour_bien_immobilier(v: Vente) kind empirical {
    label fr official "un engagement unilatéral a été souscrit en vue de l'acquisition d'un bien ou d'un droit immobilier, avec versement exigé ou reçu de celui qui s'engage (article 1589-1)";
    label en unofficial "a unilateral undertaking was made with a view to acquiring immovable property or a right therein, with a payment demanded from or received from the person undertaking (Article 1589-1)";
}
pub relation engagement_unilateral_nul(v: Vente) kind derived {
    label fr official "tout engagement unilatéral souscrit avec versement est frappé de nullité (article 1589-1)";
    label en unofficial "any unilateral undertaking made with a payment is void (Article 1589-1)";
}
pub relation promesse_unilaterale_de_vente_immobiliere(v: Vente) kind empirical {
    label fr official "il s'agit d'une promesse unilatérale de vente afférente à un immeuble, à un droit immobilier, à un fonds de commerce ou à un droit au bail (article 1589-2)";
    label en unofficial "the case concerns a unilateral promise of sale relating to a building, a right in immovable property, a business or a right to a lease (Article 1589-2)";
}
pub relation promesse_constatee_par_acte_authentique_ou_enregistre(v: Vente) kind empirical {
    label fr official "la promesse est constatée par un acte authentique ou par un acte sous seing privé enregistré dans le délai de dix jours à compter de son acceptation (article 1589-2)";
    label en unofficial "the promise is recorded by an authentic instrument or by a private deed registered within ten days from its acceptance (Article 1589-2)";
}
pub relation promesse_unilaterale_nulle(v: Vente) kind derived {
    label fr official "la promesse unilatérale de vente non constatée dans les formes est nulle et de nul effet (article 1589-2)";
    label en unofficial "a unilateral promise of sale not recorded in the required form is void and of no effect (Article 1589-2)";
}
pub relation arrhes_donnees_a_la_promesse(v: Vente) kind empirical {
    label fr official "la promesse de vendre a été faite avec des arrhes (article 1590)";
    label en unofficial "the promise to sell was made with earnest money (Article 1590)";
}
pub relation chacun_maitre_de_se_departir(v: Vente) kind derived {
    label fr official "chacun des contractants est maître de s'en départir : celui qui a donné les arrhes en les perdant, celui qui les a reçues en restituant le double (article 1590)";
    label en unofficial "each party is free to withdraw: the giver by forfeiting the earnest money, the receiver by returning double (Article 1590)";
}
pub relation prix_laisse_a_l_estimation_d_un_tiers(v: Vente) kind empirical {
    label fr official "le prix a été laissé à l'estimation d'un tiers (article 1592)";
    label en unofficial "the price was left to the valuation of a third party (Article 1592)";
}
pub relation tiers_ne_veut_ou_ne_peut_estimer(v: Vente) kind empirical {
    label fr official "le tiers ne veut ou ne peut faire l'estimation (article 1592)";
    label en unofficial "the third party will not or cannot make the valuation (Article 1592)";
}
pub relation estimation_par_un_autre_tiers(v: Vente) kind empirical {
    label fr official "un autre tiers a fait l'estimation (article 1592)";
    label en unofficial "another third party has made the valuation (Article 1592)";
}
pub relation point_de_vente_faute_d_estimation(v: Vente) kind derived {
    label fr official "si le tiers ne veut ou ne peut faire l'estimation, il n'y a point de vente, sauf estimation par un autre tiers (article 1592)";
    label en unofficial "if the third party will not or cannot make the valuation, there is no sale, save valuation by another third party (Article 1592)";
}
pub relation frais_d_actes_et_accessoires_a_la_charge_de_l_acheteur(v: Vente) kind derived {
    label fr official "les frais d'actes et autres accessoires à la vente sont à la charge de l'acheteur (article 1593)";
    label en unofficial "the costs of instruments and other accessories to the sale are borne by the buyer (Article 1593)";
}
pub relation chose_perie_en_totalite_au_moment_de_la_vente(v: Vente) kind empirical {
    label fr official "au moment de la vente, la chose vendue était périe en totalité (article 1601, alinéa 1)";
    label en unofficial "at the time of the sale, the thing sold had wholly perished (Article 1601, first paragraph)";
}
pub relation partie_de_la_chose_perie(v: Vente) kind empirical {
    label fr official "une partie seulement de la chose est périe au moment de la vente (article 1601, alinéa 2)";
    label en unofficial "only part of the thing has perished at the time of the sale (Article 1601, second paragraph)";
}
pub relation acquereur_peut_abandonner_ou_demander_la_partie_conservee(v: Vente) kind derived {
    label fr official "il est au choix de l'acquéreur d'abandonner la vente, ou de demander la partie conservée en faisant déterminer le prix par la ventilation (article 1601, alinéa 2)";
    label en unofficial "it is at the buyer's choice to abandon the sale or to claim the preserved part with the price fixed by apportionment (Article 1601, second paragraph)";
}
pub relation clefs_du_batiment_remises(v: Vente) kind empirical {
    label fr official "le vendeur a remis les clefs, s'il s'agit d'un bâtiment (article 1605)";
    label en unofficial "the seller has handed over the keys, in the case of a building (Article 1605)";
}
pub relation titres_de_propriete_remis(v: Vente) kind empirical {
    label fr official "le vendeur a remis les titres de propriété (article 1605)";
    label en unofficial "the seller has handed over the title deeds (Article 1605)";
}
pub relation remise_de_la_chose_mobiliere(v: Vente) kind empirical {
    label fr official "la délivrance des effets mobiliers s'opère par la remise de la chose (article 1606)";
    label en unofficial "delivery of movable effects is effected by handing over the thing (Article 1606)";
}
pub relation remise_des_clefs_des_batiments_qui_les_contiennent(v: Vente) kind empirical {
    label fr official "la délivrance des effets mobiliers s'opère par la remise des clefs des bâtiments qui les contiennent (article 1606)";
    label en unofficial "delivery of movable effects is effected by handing over the keys of the buildings containing them (Article 1606)";
}
pub relation seul_consentement_des_parties_a_la_delivrance(v: Vente) kind empirical {
    label fr official "la délivrance s'opère par le seul consentement des parties, le transport ne pouvant se faire au moment de la vente ou l'acheteur ayant déjà la chose en son pouvoir (article 1606)";
    label en unofficial "delivery is effected by the mere consent of the parties, transport being impossible at the time of the sale or the buyer already having the thing in his power (Article 1606)";
}
pub relation remise_des_titres_du_droit_incorporel(v: Vente) kind empirical {
    label fr official "la tradition des droits incorporels se fait par la remise des titres (article 1607)";
    label en unofficial "delivery of incorporeal rights is made by handing over the instruments (Article 1607)";
}
pub relation usage_du_droit_incorporel_du_consentement_du_vendeur(v: Vente) kind empirical {
    label fr official "la tradition des droits incorporels se fait par l'usage que l'acquéreur en fait du consentement du vendeur (article 1607)";
    label en unofficial "delivery of incorporeal rights is made by the buyer's use of them with the seller's consent (Article 1607)";
}
pub relation delivrance_accomplie(v: Vente) kind derived {
    label fr official "l'obligation de délivrer est remplie de la part du vendeur (articles 1605 à 1607)";
    label en unofficial "the obligation to deliver is fulfilled on the seller's part (Articles 1605 to 1607)";
}
pub relation vente_avec_indication_de_la_contenance_a_tant_la_mesure(v: Vente) kind empirical {
    label fr official "la vente d'un immeuble a été faite avec indication de la contenance, à raison de tant la mesure (article 1617)";
    label en unofficial "the sale of a building was made with an indication of area, at so much per measure (Article 1617)";
}
pub relation contenance_reelle(v: Vente, n: Integer) kind empirical {
    key(v);
    label fr official "contenance réelle de l'immeuble, en unités de mesure (articles 1617 à 1619)";
    label en unofficial "actual area of the building, in units of measure (Articles 1617 to 1619)";
}
pub relation contenance_portee_au_contrat(v: Vente, n: Integer) kind empirical {
    key(v);
    label fr official "contenance telle qu'elle est portée au contrat, en unités de mesure (article 1616)";
    label en unofficial "area as stated in the contract, in units of measure (Article 1616)";
}
pub relation contenance_due_par_le_vendeur(v: Vente, n: Integer) kind derived {
    key(v);
    label fr official "le vendeur est tenu de délivrer la contenance telle qu'elle est portée au contrat (article 1616)";
    label en unofficial "the seller must deliver the area as stated in the contract (Article 1616)";
}
pub relation contenance_livree_conforme_au_contrat(v: Vente, n: Integer) kind empirical {
    key(v);
    label fr official "la contenance livrée est conforme à celle portée au contrat (article 1616)";
    label en unofficial "the delivered area conforms to the area stated in the contract (Article 1616)";
}
pub relation delivrance_de_la_quantite_indiquee_impossible(v: Vente) kind empirical {
    label fr official "il n'est pas possible au vendeur de délivrer la quantité indiquée au contrat (article 1617)";
    label en unofficial "it is not possible for the seller to deliver the quantity stated in the contract (Article 1617)";
}
pub relation acquereur_exige_la_quantite_indiquee(v: Vente) kind empirical {
    label fr official "l'acquéreur exige la quantité indiquée au contrat (article 1617)";
    label en unofficial "the buyer requires the quantity stated in the contract (Article 1617)";
}
pub relation vendeur_doit_delivrer_la_quantite_indiquee(v: Vente) kind derived {
    label fr official "le vendeur est obligé de délivrer à l'acquéreur, s'il l'exige, la quantité indiquée au contrat (article 1617)";
    label en unofficial "the seller must deliver to the buyer, if he requires it, the quantity stated in the contract (Article 1617)";
}
pub relation quantite_indiquee_livree(v: Vente) kind empirical {
    label fr official "la quantité indiquée au contrat a été livrée à l'acquéreur (article 1617)";
    label en unofficial "the quantity stated in the contract was delivered to the buyer (Article 1617)";
}
pub relation diminution_proportionnelle_du_prix_due(v: Vente) kind derived {
    label fr official "le vendeur est obligé de souffrir une diminution proportionnelle du prix (article 1617)";
    label en unofficial "the seller must suffer a proportionate reduction of the price (Article 1617)";
}
pub relation excedent_de_contenance_d_un_vingtieme(v: Vente) kind derived {
    label fr official "l'excédent de contenance est d'un vingtième au-dessus de la contenance déclarée (article 1618)";
    label en unofficial "the excess area is one twentieth above the declared area (Article 1618)";
}
pub relation acquereur_a_le_choix_du_supplement_ou_du_desistement(v: Vente) kind derived {
    label fr official "l'acquéreur a le choix de fournir le supplément du prix ou de se désister du contrat (article 1618)";
    label en unofficial "the buyer has the choice of supplying the supplement of the price or withdrawing from the contract (Article 1618)";
}
pub relation vente_de_corps_certain_ou_de_fonds_distincts(v: Vente) kind empirical {
    label fr official "la vente est faite d'un corps certain et limité, ou a pour objet des fonds distincts et séparés, ou commence par la mesure (article 1619)";
    label en unofficial "the sale is of a specific and limited body, or has distinct and separate lands as its object, or begins with the measure (Article 1619)";
}
pub relation difference_de_mesure_d_un_vingtieme(v: Vente) kind derived {
    label fr official "la différence de la mesure réelle à celle exprimée au contrat est d'un vingtième en plus ou en moins (article 1619)";
    label en unofficial "the difference between the actual measure and that expressed in the contract is one twentieth more or less (Article 1619)";
}
pub relation stipulation_contraire_sur_la_mesure(v: Vente) kind empirical {
    label fr official "il y a stipulation contraire sur les conséquences de la différence de mesure (article 1619)";
    label en unofficial "there is a stipulation to the contrary on the consequences of the difference of measure (Article 1619)";
}
pub relation aucun_supplement_ni_diminution_de_prix(v: Vente) kind derived {
    label fr official "l'expression de la mesure ne donne lieu à aucun supplément ni à aucune diminution du prix (article 1619)";
    label en unofficial "the statement of the measure gives rise to no supplement and no reduction of the price (Article 1619)";
}
pub relation acquereur_se_desiste_du_contrat(v: Vente) kind empirical {
    label fr official "l'acquéreur se désiste du contrat (article 1621)";
    label en unofficial "the buyer withdraws from the contract (Article 1621)";
}
pub relation restitution_du_prix_et_des_frais_du_contrat_due(v: Vente) kind derived {
    label fr official "le vendeur est tenu de restituer, outre le prix s'il l'a reçu, les frais de ce contrat (article 1621)";
    label en unofficial "the seller must return, besides the price if received, the costs of that contract (Article 1621)";
}
pub relation action_en_contenance_introduite_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour où l'action en supplément, en diminution du prix ou en résiliation a été intentée (article 1622)";
    label en unofficial "day the action for supplement, reduction of price or termination was brought (Article 1622)";
}
pub relation contrat_conclu_le(v: Vente, d: Date) kind empirical {
    key(v);
    label fr official "jour du contrat, d'où court le délai d'un an de l'article 1622 (article 1622)";
    label en unofficial "day of the contract, from which the one-year period of Article 1622 runs (Article 1622)";
}
pub relation action_en_contenance_recevable(v: Vente) kind derived {
    label fr official "l'action en supplément de prix, en diminution de prix ou en résiliation est intentée dans l'année à compter du jour du contrat, à peine de déchéance (article 1622)";
    label en unofficial "the action for supplement, reduction of price or termination is brought within one year from the day of the contract, on pain of forfeiture (Article 1622)";
}
pub relation action_en_contenance_engagee(v: Vente) kind institutional {
    label fr official "l'acquéreur a engagé l'action en supplément de prix, en diminution de prix ou en résiliation (article 1622)";
    label en unofficial "the buyer has brought the action for a price supplement, price reduction or termination (Article 1622)";
}
pub relation action_en_contenance_exercee(v: Vente) kind empirical {
    label fr official "l'acquéreur a exercé l'action en contenance dans l'année (article 1622)";
    label en unofficial "the buyer exercised the action concerning area within one year (Article 1622)";
}

// --- Titre VII, suite (1704 à 1707) et titre VIII, chapitre III, suite (1779 à 1799) ---

pub relation chose_recue_en_echange(e: Echange) kind empirical {
    label fr official "l'un des copermutants a déjà reçu la chose à lui donnée en échange (article 1704)";
    label en unofficial "one of the exchangers has already received the thing given to him in exchange (Article 1704)";
}
pub relation autre_contractant_non_proprietaire_prouve(e: Echange) kind empirical {
    label fr official "il est prouvé que l'autre contractant n'est pas propriétaire de la chose remise (article 1704)";
    label en unofficial "it is proved that the other party is not the owner of the thing delivered (Article 1704)";
}
pub relation copermutant_protege_par_article_1704(e: Echange, p: Personne) kind empirical {
    label fr official "copermutant protégé par l'article 1704";
    label en unofficial "exchanger protected by Article 1704";
}
pub relation livraison_refusee_pour_non_propriete(e: Echange) kind empirical {
    label fr official "le copermutant a refusé de livrer pour cause de non-propriété";
    label en unofficial "the exchanger refused delivery because of non-ownership";
}
pub relation copermutant_non_force_de_livrer(e: Echange) kind derived {
    label fr official "le copermutant ne peut être forcé à livrer celle qu'il a promise en contre-échange, mais seulement à rendre celle qu'il a reçue (article 1704)";
    label en unofficial "the exchanger may not be forced to deliver what he promised in counter-exchange, but only to return what he received (Article 1704)";
}
pub relation copermutant_evince(e: Echange) kind empirical {
    label fr official "le copermutant est évincé de la chose qu'il a reçue en échange (article 1705)";
    label en unofficial "the exchanger is evicted from the thing he received in exchange (Article 1705)";
}
pub relation choix_entre_dommages_interets_et_repetition(e: Echange) kind derived {
    label fr official "le copermutant évincé a le choix de conclure à des dommages et intérêts ou de répéter sa chose (article 1705)";
    label en unofficial "the evicted exchanger has the choice of claiming damages or recovering his thing (Article 1705)";
}
pub relation suite_d_eviction_choisie_par_le_copermutant(e: Echange) kind institutional {
    label fr official "le copermutant évincé a choisi entre les dommages et intérêts et la répétition de sa chose (article 1705)";
    label en unofficial "the evicted exchanger has chosen between damages and recovery of his thing (Article 1705)";
}
pub relation rescision_pour_lesion_exclue_dans_l_echange(e: Echange) kind derived {
    label fr official "la rescision pour cause de lésion n'a pas lieu dans le contrat d'échange (article 1706)";
    label en unofficial "rescission for injury does not lie in a contract of exchange (Article 1706)";
}
pub relation services_engages_a_temps_ou_pour_une_entreprise_determinee(m: Marche) kind empirical {
    label fr official "les services sont engagés à temps ou pour une entreprise déterminée (article 1780, alinéa 1)";
    label en unofficial "the services are engaged for a time or for a determined undertaking (Article 1780, first paragraph)";
}
pub relation louage_de_service_sans_determination_de_duree(m: Marche) kind empirical {
    label fr official "le louage de service est fait sans détermination de durée (article 1780, alinéa 2)";
    label en unofficial "the hire of services is made without any determined duration (Article 1780, second paragraph)";
}
pub relation louage_de_service_peut_cesser_par_volonte_unilaterale(m: Marche) kind derived {
    label fr official "le louage de service fait sans détermination de durée peut toujours cesser par la volonté d'une des parties (article 1780, alinéa 2)";
    label en unofficial "a hire of services made without determined duration may always end by the will of one of the parties (Article 1780, second paragraph)";
}
pub relation renonciation_anticipee_aux_dommages_interets(m: Marche) kind empirical {
    label fr official "les parties ont renoncé à l'avance au droit de demander des dommages-intérêts (article 1780, alinéa 5)";
    label en unofficial "the parties waived in advance the right to claim damages (Article 1780, fifth paragraph)";
}
pub relation renonciation_anticipee_sans_effet(m: Marche) kind derived {
    label fr official "les parties ne peuvent renoncer à l'avance au droit éventuel de demander des dommages-intérêts (article 1780, alinéa 5)";
    label en unofficial "the parties may not waive in advance the possible right to claim damages (Article 1780, fifth paragraph)";
}
pub relation voiturier_du_marche(m: Marche, p: Personne) kind empirical {
    key(m);
    label fr official "voiturier par terre ou par eau chargé du transport des personnes ou des marchandises (articles 1779, 2° et 1782)";
    label en unofficial "carrier by land or water charged with transporting persons or goods (Articles 1779, 2 and 1782)";
}
pub relation chose_confiee_au_voiturier(m: Marche) kind empirical {
    label fr official "la chose a été confiée au voiturier (article 1784)";
    label en unofficial "the thing was entrusted to the carrier (Article 1784)";
}
pub relation chose_remise_sur_le_port_ou_dans_l_entrepot(m: Marche) kind empirical {
    label fr official "la chose a été remise sur le port ou dans l'entrepôt, pour être placée dans le bâtiment ou la voiture (article 1783)";
    label en unofficial "the thing was handed over on the quay or in the warehouse, to be placed in the vessel or vehicle (Article 1783)";
}
pub relation perte_ou_avarie_de_la_chose_transportee(m: Marche) kind empirical {
    label fr official "la chose confiée au voiturier a été perdue ou avariée (article 1784)";
    label en unofficial "the thing entrusted to the carrier was lost or damaged (Article 1784)";
}
pub relation voiturier_prouve_cas_fortuit_ou_force_majeure(m: Marche) kind empirical {
    label fr official "le voiturier prouve que la chose a été perdue ou avariée par cas fortuit ou force majeure (article 1784)";
    label en unofficial "the carrier proves that the thing was lost or damaged by fortuitous event or force majeure (Article 1784)";
}
pub relation voiturier_responsable_de_la_perte_ou_de_l_avarie(m: Marche) kind derived {
    label fr official "le voiturier est responsable de la perte et des avaries des choses qui lui sont confiées, à moins qu'il ne prouve le cas fortuit ou la force majeure (article 1784)";
    label en unofficial "the carrier is liable for the loss and damage of the things entrusted to him, unless he proves fortuitous event or force majeure (Article 1784)";
}
pub relation voiturier_repond_des_choses_remises_avant_chargement(m: Marche) kind derived {
    label fr official "le voiturier répond de ce qui lui a été remis sur le port ou dans l'entrepôt, comme de ce qu'il a déjà reçu dans son bâtiment ou sa voiture (article 1783)";
    label en unofficial "the carrier answers for what was handed to him on the quay or in the warehouse, as for what he has already received in his vessel or vehicle (Article 1783)";
}
pub relation ouvrage_a_plusieurs_pieces_ou_a_la_mesure(m: Marche) kind empirical {
    label fr official "il s'agit d'un ouvrage à plusieurs pièces ou à la mesure (article 1791)";
    label en unofficial "the work consists of several pieces or is measured (Article 1791)";
}
pub relation maitre_paye_en_proportion_de_l_ouvrage_fait(m: Marche) kind empirical {
    label fr official "le maître paye l'ouvrier en proportion de l'ouvrage fait (article 1791)";
    label en unofficial "the owner pays the worker in proportion to the work done (Article 1791)";
}
pub relation verification_censee_faite_pour_les_parties_payees(m: Marche) kind derived {
    label fr official "la vérification est censée faite pour toutes les parties payées (article 1791)";
    label en unofficial "the inspection is deemed made for all the parts paid for (Article 1791)";
}
pub relation lie_au_maitre_par_un_contrat_de_louage_d_ouvrage(m: Marche, p: Personne) kind empirical {
    label fr official "architecte, entrepreneur, technicien ou autre personne liée au maître de l'ouvrage par un contrat de louage d'ouvrage (article 1792-1, 1°)";
    label en unofficial "architect, contractor, technician or other person bound to the owner by a contract for work (Article 1792-1, 1)";
}
pub relation vend_apres_achevement_un_ouvrage_construit(m: Marche, p: Personne) kind empirical {
    label fr official "personne qui vend, après achèvement, un ouvrage qu'elle a construit ou fait construire (article 1792-1, 2°)";
    label en unofficial "person who sells, after completion, a work he built or had built (Article 1792-1, 2)";
}
pub relation mandataire_accomplissant_mission_de_locateur(m: Marche, p: Personne) kind empirical {
    label fr official "personne qui, agissant en qualité de mandataire du propriétaire, accomplit une mission assimilable à celle d'un locateur d'ouvrage (article 1792-1, 3°)";
    label en unofficial "person who, acting as the owner's agent, performs a mission comparable to that of a contractor for work (Article 1792-1, 3)";
}
pub relation repute_constructeur_de_l_ouvrage(m: Marche, p: Personne) kind derived {
    label fr official "est réputé constructeur de l'ouvrage (article 1792-1)";
    label en unofficial "is deemed builder of the work (Article 1792-1)";
}
pub relation dommage_affecte_la_solidite_d_un_element_d_equipement(m: Marche) kind empirical {
    label fr official "le dommage affecte la solidité des éléments d'équipement de l'ouvrage (article 1792-2, alinéa 1)";
    label en unofficial "the damage affects the solidity of the equipment elements of the work (Article 1792-2, first paragraph)";
}
pub relation element_indissociablement_incorpore(m: Marche) kind empirical {
    label fr official "l'élément d'équipement fait indissociablement corps avec les ouvrages de viabilité, de fondation, d'ossature, de clos ou de couvert (article 1792-2)";
    label en unofficial "the equipment element forms an indissociable body with the works of services, foundation, frame, enclosure or roofing (Article 1792-2)";
}
pub relation element_a_fonction_exclusivement_professionnelle(m: Marche) kind empirical {
    label fr official "la fonction exclusive de l'élément d'équipement est de permettre l'exercice d'une activité professionnelle dans l'ouvrage (article 1792-7)";
    label en unofficial "the exclusive function of the equipment element is to allow a professional activity to be carried on in the work (Article 1792-7)";
}
pub relation element_hors_du_champ_des_garanties(m: Marche) kind derived {
    label fr official "l'élément d'équipement à fonction exclusivement professionnelle n'est pas considéré comme un élément d'équipement au sens des articles 1792 à 1792-4 (article 1792-7)";
    label en unofficial "an equipment element with an exclusively professional function is not treated as an equipment element within Articles 1792 to 1792-4 (Article 1792-7)";
}
pub relation presomption_de_responsabilite_etendue_a_l_element(m: Marche) kind derived {
    label fr official "la présomption de responsabilité de l'article 1792 s'étend aux dommages affectant la solidité des éléments d'équipement indissociables (article 1792-2)";
    label en unofficial "the presumption of liability of Article 1792 extends to damage affecting the solidity of indissociable equipment elements (Article 1792-2)";
}
pub relation fabricant_de_l_element_d_equipement(m: Marche, p: Personne) kind empirical {
    label fr official "fabricant d'un ouvrage, d'une partie d'ouvrage ou d'un élément d'équipement conçu et produit pour satisfaire à des exigences précises et déterminées à l'avance (article 1792-4, alinéa 1)";
    label en unofficial "manufacturer of a work, part of a work or equipment element designed and produced to meet precise and predetermined requirements (Article 1792-4, first paragraph)";
}
pub relation element_mis_en_oeuvre_sans_modification(m: Marche) kind empirical {
    label fr official "le locateur d'ouvrage a mis en oeuvre l'élément sans modification et conformément aux règles édictées par le fabricant (article 1792-4, alinéa 1)";
    label en unofficial "the contractor implemented the element without modification and in accordance with the manufacturer's rules (Article 1792-4, first paragraph)";
}
pub relation fabricant_solidairement_responsable(m: Marche, p: Personne) kind derived {
    label fr official "le fabricant est solidairement responsable des obligations mises par les articles 1792, 1792-2 et 1792-3 à la charge du locateur d'ouvrage (article 1792-4, alinéa 1)";
    label en unofficial "the manufacturer is jointly and severally liable for the obligations imposed by Articles 1792, 1792-2 and 1792-3 on the contractor (Article 1792-4, first paragraph)";
}
pub relation sous_traitant_du_marche(m: Marche, p: Personne) kind empirical {
    label fr official "sous-traitant du marché de travaux (article 1792-4-2)";
    label en unofficial "subcontractor of the works contract (Article 1792-4-2)";
}
pub relation action_contre_sous_traitant_introduite_le(m: Marche, d: Date) kind empirical {
    key(m);
    label fr official "jour où l'action en responsabilité dirigée contre le sous-traitant a été introduite (article 1792-4-2)";
    label en unofficial "day the liability action against the subcontractor was brought (Article 1792-4-2)";
}
pub relation action_contre_sous_traitant_recevable(m: Marche) kind derived {
    label fr official "l'action dirigée contre le sous-traitant pour les dommages des articles 1792 et 1792-2 se prescrit par dix ans à compter de la réception des travaux (article 1792-4-2)";
    label en unofficial "the action against the subcontractor for the damage of Articles 1792 and 1792-2 is prescribed by ten years from acceptance of the works (Article 1792-4-2)";
}
pub relation action_contre_constructeur_introduite_le(m: Marche, d: Date) kind empirical {
    key(m);
    label fr official "jour où l'action en responsabilité dirigée contre le constructeur hors des articles 1792-3, 1792-4-1 et 1792-4-2 a été introduite (article 1792-4-3)";
    label en unofficial "day the liability action against the builder outside Articles 1792-3, 1792-4-1 and 1792-4-2 was brought (Article 1792-4-3)";
}
pub relation action_contre_constructeur_recevable(m: Marche) kind derived {
    label fr official "l'action en responsabilité dirigée contre les constructeurs et leurs sous-traitants se prescrit par dix ans à compter de la réception des travaux (article 1792-4-3)";
    label en unofficial "the liability action against builders and their subcontractors is prescribed by ten years from acceptance of the works (Article 1792-4-3)";
}
pub relation ouvrages_faits_et_materiaux_prepares(m: Marche) kind empirical {
    label fr official "des ouvrages ont été faits et des matériaux préparés avant le décès (article 1796)";
    label en unofficial "works were done and materials prepared before the death (Article 1796)";
}
pub relation travaux_ou_materiaux_utiles_au_proprietaire(m: Marche) kind empirical {
    label fr official "ces travaux ou ces matériaux peuvent être utiles au propriétaire (article 1796)";
    label en unofficial "those works or materials may be useful to the owner (Article 1796)";
}
pub relation paiement_a_la_succession_du(m: Marche) kind derived {
    label fr official "le propriétaire est tenu de payer à la succession, en proportion du prix porté par la convention, la valeur des ouvrages faits et des matériaux préparés, lors seulement qu'ils peuvent lui être utiles (article 1796)";
    label en unofficial "the owner must pay the estate, in proportion to the contract price, the value of the works done and materials prepared, only where they may be useful to him (Article 1796)";
}
pub relation ouvrier_employe_a_la_construction(m: Marche, p: Personne) kind empirical {
    label fr official "maçon, charpentier ou autre ouvrier employé à la construction d'un bâtiment ou d'autres ouvrages faits à l'entreprise (article 1798)";
    label en unofficial "mason, carpenter or other worker employed in the construction of a building or other contracted works (Article 1798)";
}
pub relation maitre_debiteur_envers_l_entrepreneur(m: Marche, n: Money) kind empirical {
    key(m);
    label fr official "somme dont le maître se trouve débiteur envers l'entrepreneur au moment où l'action de l'ouvrier est intentée (article 1798)";
    label en unofficial "sum the owner owes the contractor at the time the worker's action is brought (Article 1798)";
}
pub relation action_directe_de_l_ouvrier_limitee(m: Marche, p: Personne, n: Money) kind derived {
    label fr official "l'ouvrier n'a d'action contre celui pour lequel les ouvrages ont été faits que jusqu'à concurrence de ce dont il se trouve débiteur envers l'entrepreneur (article 1798)";
    label en unofficial "the worker has an action against the person for whom the works were done only up to the amount the latter owes the contractor (Article 1798)";
}

// --- Titre VIII, chapitre II, section III : du bail à ferme (1764 à 1778) ---

pub relation bail_a_ferme(b: Bail) kind empirical {
    label fr official "le bail porte sur un héritage rural : c'est un bail à ferme (articles 1711 et 1764 et suivants)";
    label en unofficial "the lease concerns a rural estate: it is a farm lease (Articles 1711 and 1764 et seq.)";
}
pub relation contravention_du_preneur_rural(b: Bail) kind empirical {
    label fr official "le preneur a contrevenu au bail à ferme (article 1764)";
    label en unofficial "the lessee has contravened the farm lease (Article 1764)";
}
pub relation proprietaire_peut_rentrer_en_jouissance(b: Bail) kind derived {
    label fr official "en cas de contravention, le propriétaire a droit de rentrer en jouissance (article 1764)";
    label en unofficial "in case of contravention, the owner is entitled to resume enjoyment (Article 1764)";
}
pub relation dommages_interets_de_l_inexecution_du_bail(b: Bail) kind derived {
    label fr official "le preneur est condamné aux dommages-intérêts résultant de l'inexécution du bail (article 1764)";
    label en unofficial "the lessee is ordered to pay the damages resulting from the non-performance of the lease (Article 1764)";
}
pub relation heritage_non_garni_de_bestiaux_et_ustensiles(b: Bail) kind empirical {
    label fr official "le preneur d'un héritage rural ne le garnit pas des bestiaux et des ustensiles nécessaires à son exploitation (article 1766, alinéa 1)";
    label en unofficial "the lessee of a rural estate does not stock it with the livestock and implements needed to work it (Article 1766, first paragraph)";
}
pub relation culture_abandonnee_ou_deraisonnable(b: Bail) kind empirical {
    label fr official "le preneur abandonne la culture ou ne cultive pas raisonnablement (article 1766, alinéa 1)";
    label en unofficial "the lessee abandons the cultivation or does not cultivate reasonably (Article 1766, first paragraph)";
}
pub relation clauses_du_bail_rural_inexecutees(b: Bail) kind empirical {
    label fr official "le preneur n'exécute pas les clauses du bail (article 1766, alinéa 1)";
    label en unofficial "the lessee does not perform the clauses of the lease (Article 1766, first paragraph)";
}
pub relation dommage_pour_le_bailleur_rural(b: Bail) kind empirical {
    label fr official "il en résulte un dommage pour le bailleur (article 1766, alinéa 1)";
    label en unofficial "damage to the lessor results from it (Article 1766, first paragraph)";
}
pub relation bailleur_rural_peut_faire_resilier(b: Bail) kind derived {
    label fr official "le bailleur peut, suivant les circonstances, faire résilier le bail à ferme (article 1766, alinéa 1)";
    label en unofficial "the lessor may, according to the circumstances, have the farm lease terminated (Article 1766, first paragraph)";
}
pub relation usurpation_commise_sur_les_fonds(b: Bail) kind empirical {
    label fr official "des usurpations ont été commises sur les fonds affermés (article 1768, alinéa 1)";
    label en unofficial "encroachments were committed on the leased land (Article 1768, first paragraph)";
}
pub relation avertissement_des_usurpations_donne(b: Bail) kind empirical {
    label fr official "le preneur a averti le propriétaire des usurpations dans le délai réglé en cas d'assignation suivant la distance des lieux (article 1768)";
    label en unofficial "the lessee warned the owner of the encroachments within the period fixed for summonses according to distance (Article 1768)";
}
pub relation preneur_tenu_des_depens_faute_d_avertissement(b: Bail) kind derived {
    label fr official "le preneur est tenu, sous peine de tous dépens, dommages et intérêts, d'avertir le propriétaire des usurpations (article 1768, alinéa 1)";
    label en unofficial "the lessee is bound, on pain of all costs and damages, to warn the owner of encroachments (Article 1768, first paragraph)";
}
pub relation bail_a_ferme_pluriannuel(b: Bail) kind empirical {
    label fr official "le bail à ferme est fait pour plusieurs années (article 1769, alinéa 1)";
    label en unofficial "the farm lease is made for several years (Article 1769, first paragraph)";
}
pub relation bail_a_ferme_d_une_annee(b: Bail) kind empirical {
    label fr official "le bail à ferme n'est que d'une année (article 1770, alinéa 1)";
    label en unofficial "the farm lease is for one year only (Article 1770, first paragraph)";
}
pub relation recolte_totale(b: Bail, n: Integer) kind empirical {
    key(b);
    label fr official "récolte entière de l'année, en unités de mesure, servant à apprécier la moitié des articles 1769 et 1770";
    label en unofficial "the whole year's crop, in units of measure, used to assess the half of Articles 1769 and 1770";
}
pub relation recolte_enlevee_par_cas_fortuit(b: Bail, n: Integer) kind empirical {
    key(b);
    label fr official "part de la récolte enlevée par des cas fortuits, en unités de mesure (articles 1769 et 1770)";
    label en unofficial "part of the crop carried off by fortuitous events, in units of measure (Articles 1769 and 1770)";
}
pub relation perte_atteint_la_moitie_de_la_recolte(b: Bail) kind derived {
    label fr official "la totalité ou la moitié d'une récolte au moins a été enlevée par des cas fortuits (articles 1769 et 1770)";
    label en unofficial "the whole or at least half of a crop was carried off by fortuitous events (Articles 1769 and 1770)";
}
pub relation fermier_indemnise_par_les_recoltes_precedentes(b: Bail) kind empirical {
    label fr official "le fermier est indemnisé par les récoltes précédentes (article 1769, alinéa 1)";
    label en unofficial "the farmer is compensated by the previous crops (Article 1769, first paragraph)";
}
pub relation perte_apres_separation_des_fruits(b: Bail) kind empirical {
    label fr official "la perte des fruits est arrivée après qu'ils sont séparés de la terre (article 1771, alinéa 1)";
    label en unofficial "the loss of the fruits occurred after they were separated from the soil (Article 1771, first paragraph)";
}
pub relation bail_donne_au_proprietaire_une_quotite_en_nature(b: Bail) kind empirical {
    label fr official "le bail donne au propriétaire une quotité de la récolte en nature (article 1771, alinéa 1)";
    label en unofficial "the lease gives the owner a share of the crop in kind (Article 1771, first paragraph)";
}
pub relation preneur_en_demeure_de_delivrer_la_portion(b: Bail) kind empirical {
    label fr official "le preneur était en demeure de délivrer au propriétaire sa portion de récolte (article 1771, alinéa 1)";
    label en unofficial "the lessee was in default in delivering the owner his share of the crop (Article 1771, first paragraph)";
}
pub relation proprietaire_supporte_sa_part_de_la_perte(b: Bail) kind derived {
    label fr official "le propriétaire doit supporter sa part de la perte, pourvu que le preneur ne fût pas en demeure de lui délivrer sa portion de récolte (article 1771, alinéa 1)";
    label en unofficial "the owner must bear his share of the loss, provided the lessee was not in default in delivering his share of the crop (Article 1771, first paragraph)";
}
pub relation cause_du_dommage_existante_et_connue_au_bail(b: Bail) kind empirical {
    label fr official "la cause du dommage était existante et connue à l'époque où le bail a été passé (article 1771, alinéa 2)";
    label en unofficial "the cause of the damage existed and was known when the lease was made (Article 1771, second paragraph)";
}
pub relation stipulation_expresse_des_cas_fortuits(b: Bail) kind empirical {
    label fr official "le preneur a été chargé des cas fortuits par une stipulation expresse (article 1772)";
    label en unofficial "the lessee was charged with fortuitous events by an express stipulation (Article 1772)";
}
pub relation stipulation_de_tous_les_cas_fortuits_prevus_ou_imprevus(b: Bail) kind empirical {
    label fr official "le preneur a été chargé de tous les cas fortuits prévus ou imprévus (article 1773, alinéa 2)";
    label en unofficial "the lessee was charged with all fortuitous events, foreseen or unforeseen (Article 1773, second paragraph)";
}
pub relation cas_fortuit_extraordinaire(b: Bail) kind empirical {
    label fr official "le cas fortuit est extraordinaire : ravages de la guerre ou inondation à laquelle le pays n'est pas ordinairement sujet (article 1773, alinéa 2)";
    label en unofficial "the fortuitous event is extraordinary: ravages of war or a flood to which the region is not ordinarily subject (Article 1773, second paragraph)";
}
pub relation preneur_charge_du_cas_fortuit(b: Bail) kind derived {
    label fr official "le preneur est chargé du cas fortuit survenu (articles 1772 et 1773)";
    label en unofficial "the lessee bears the fortuitous event that occurred (Articles 1772 and 1773)";
}
pub relation remise_du_prix_de_location_due(b: Bail) kind derived {
    label fr official "le fermier peut demander une remise du prix de sa location (articles 1769 et 1770)";
    label en unofficial "the farmer may claim a reduction of the price of his lease (Articles 1769 and 1770)";
}
pub relation remise_du_prix_demandee_par_le_fermier(b: Bail) kind institutional {
    label fr official "le fermier a demandé la remise du prix de sa location (article 1769)";
    label en unofficial "the farmer has sought a reduction of the rent (Article 1769)";
}
pub relation demande_remise_du_prix_par_fermier(b: Bail) kind empirical {
    label fr official "le fermier a demandé la remise du prix (article 1769)";
    label en unofficial "the farmer requested a rent reduction (Article 1769)";
}
pub relation estimation_de_la_remise_a_la_fin_du_bail(b: Bail) kind derived {
    label fr official "l'estimation de la remise ne peut avoir lieu qu'à la fin du bail, où se fait la compensation de toutes les années de jouissance (article 1769, alinéa 2)";
    label en unofficial "the reduction can be assessed only at the end of the lease, when all the years of enjoyment are set off (Article 1769, second paragraph)";
}
pub relation conge_ecrit_six_mois_avant_le_terme(b: Bail) kind empirical {
    label fr official "un congé a été donné par écrit par l'une des parties à l'autre, six mois au moins avant le terme (article 1775, alinéa 1)";
    label en unofficial "a written notice was given by one party to the other at least six months before the term (Article 1775, first paragraph)";
}
pub relation bail_rural_sans_ecrit_renouvele(b: Bail) kind derived {
    label fr official "à défaut de congé écrit six mois au moins avant le terme, il s'opère un nouveau bail rural (article 1775, alinéa 2)";
    label en unofficial "in default of written notice at least six months before the term, a new farm lease arises (Article 1775, second paragraph)";
}
pub relation fermier_sortant(b: Bail, p: Personne) kind empirical {
    key(b);
    label fr official "le fermier sortant (articles 1777 et 1778)";
    label en unofficial "the outgoing farmer (Articles 1777 and 1778)";
}
pub relation fermier_entrant(b: Bail, p: Personne) kind empirical {
    key(b);
    label fr official "le fermier entrant (article 1777)";
    label en unofficial "the incoming farmer (Article 1777)";
}
pub relation logements_convenables_dus_au_fermier_entrant(b: Bail) kind derived {
    label fr official "le fermier sortant doit laisser au fermier entrant les logements convenables et autres facilités pour les travaux de l'année suivante, suivant l'usage des lieux (article 1777, alinéas 1 et 2)";
    label en unofficial "the outgoing farmer must leave the incoming farmer suitable housing and other facilities for the following year's work, according to local usage (Article 1777, first and second paragraphs)";
}
pub relation logements_convenables_dus_au_fermier_sortant(b: Bail) kind derived {
    label fr official "le fermier entrant doit procurer au fermier sortant les logements convenables et autres facilités pour la consommation des fourrages et les récoltes restant à faire (article 1777, alinéas 1 et 2)";
    label en unofficial "the incoming farmer must provide the outgoing farmer with suitable housing and other facilities for consuming the fodder and for the crops still to be gathered (Article 1777, first and second paragraphs)";
}
pub relation pailles_et_engrais_recus_a_l_entree(b: Bail) kind empirical {
    label fr official "le fermier sortant a reçu les pailles et engrais lors de son entrée en jouissance (article 1778)";
    label en unofficial "the outgoing farmer received the straw and manure when he entered into enjoyment (Article 1778)";
}
pub relation pailles_et_engrais_a_laisser(b: Bail) kind derived {
    label fr official "le fermier sortant doit laisser les pailles et engrais de l'année s'il les a reçus lors de son entrée en jouissance (article 1778)";
    label en unofficial "the outgoing farmer must leave the year's straw and manure if he received them when he entered into enjoyment (Article 1778)";
}
pub relation pailles_et_engrais_laisses(b: Bail) kind empirical {
    label fr official "le fermier sortant a laissé les pailles et engrais (article 1778)";
    label en unofficial "the outgoing farmer left the straw and manure (Article 1778)";
}
pub relation proprietaire_peut_retenir_pailles_suivant_estimation(b: Bail) kind derived {
    label fr official "quand même le fermier sortant n'aurait pas reçu les pailles et engrais, le propriétaire peut les retenir suivant l'estimation (article 1778)";
    label en unofficial "even if the outgoing farmer did not receive the straw and manure, the owner may retain them subject to valuation (Article 1778)";
}

// --- Titre VIII, chapitre II, section IV : du bail à cheptel (1801 à 1831) ---

pub enum EspeceDeCheptel {
    label fr official "espèces de cheptel : simple ou ordinaire, à moitié, donné au fermier ou au métayer (article 1801)";
    label en unofficial "kinds of livestock lease: simple or ordinary, by halves, given to the farmer or the sharecropper (Article 1801)";
    CheptelSimple, CheptelAMoitie, CheptelDonneAuFermier, CheptelDonneAuMetayer
}
pub relation espece_du_cheptel(c: Cheptel, e: EspeceDeCheptel) kind empirical {
    key(c);
    label fr official "espèce à laquelle appartient le cheptel (article 1801)";
    label en unofficial "kind to which the livestock lease belongs (Article 1801)";
}
pub relation animaux_susceptibles_de_croit_ou_de_profit(c: Cheptel) kind empirical {
    label fr official "les animaux donnés sont susceptibles de croît ou de profit pour l'agriculture ou le commerce (article 1802)";
    label en unofficial "the animals given are capable of increase or profit for agriculture or trade (Article 1802)";
}
pub relation conventions_particulieres_du_cheptel(c: Cheptel) kind empirical {
    label fr official "les parties ont fait des conventions particulières qui règlent le contrat (article 1803)";
    label en unofficial "the parties made particular agreements governing the contract (Article 1803)";
}
pub relation regles_suppletives_du_cheptel_applicables(c: Cheptel) kind derived {
    label fr official "à défaut de conventions particulières, ces contrats se règlent par les principes qui suivent (article 1803)";
    label en unofficial "in the absence of particular agreements, these contracts are governed by the following principles (Article 1803)";
}
pub relation etat_numeratif_descriptif_et_estimatif_au_bail(c: Cheptel) kind empirical {
    label fr official "l'état numératif, descriptif et estimatif des animaux remis figure au bail (articles 1805 et 1822)";
    label en unofficial "the enumerative, descriptive and valuation statement of the animals delivered appears in the lease (Articles 1805 and 1822)";
}
pub relation propriete_non_transferee_au_preneur(c: Cheptel) kind derived {
    label fr official "l'état numératif ne transporte pas la propriété des animaux au preneur ; il sert de base au règlement au jour où le contrat prend fin (articles 1805 et 1822)";
    label en unofficial "the statement does not transfer ownership of the animals to the lessee; it serves as a basis for the settlement when the contract ends (Articles 1805 and 1822)";
}
pub relation soins_raisonnables_a_la_conservation(c: Cheptel) kind derived {
    label fr official "le preneur doit les soins raisonnables à la conservation du cheptel (article 1806)";
    label en unofficial "the lessee owes reasonable care to the preservation of the livestock (Article 1806)";
}
pub relation soins_du_cheptel_assures(c: Cheptel) kind empirical {
    label fr official "le preneur a assuré les soins raisonnables du cheptel";
    label en unofficial "the lessee provided reasonable care for the livestock";
}
pub relation faute_du_preneur_prealable_au_cas_fortuit(c: Cheptel) kind empirical {
    label fr official "le cas fortuit a été précédé d'une faute du preneur, sans laquelle la perte ne serait pas arrivée (article 1807)";
    label en unofficial "the fortuitous event was preceded by a fault of the lessee, without which the loss would not have occurred (Article 1807)";
}
pub relation cas_fortuit_du_cheptel(c: Cheptel) kind empirical {
    label fr official "la perte du cheptel est arrivée par cas fortuit (articles 1807 et 1808)";
    label en unofficial "the loss of the livestock occurred by fortuitous event (Articles 1807 and 1808)";
}
pub relation preneur_tenu_du_cas_fortuit(c: Cheptel) kind derived {
    label fr official "le preneur n'est tenu du cas fortuit que lorsqu'il a été précédé de quelque faute de sa part (article 1807)";
    label en unofficial "the lessee is liable for the fortuitous event only where it was preceded by some fault of his own (Article 1807)";
}
pub relation perte_fortuite_supportee_par_preneur(c: Cheptel) kind empirical {
    label fr official "le preneur a supporté la perte fortuite précédée de sa faute";
    label en unofficial "the lessee bore the fortuitous loss preceded by his fault";
}
pub relation preneur_decharge_par_le_cas_fortuit(c: Cheptel) kind derived {
    label fr official "le preneur est déchargé par le cas fortuit survenu sans faute de sa part (articles 1807 et 1810)";
    label en unofficial "the lessee is discharged by the fortuitous event occurring without any fault of his own (Articles 1807 and 1810)";
}
pub relation compte_des_peaux_du(c: Cheptel) kind derived {
    label fr official "le preneur déchargé par le cas fortuit est toujours tenu de rendre compte des peaux des bêtes (article 1809)";
    label en unofficial "a lessee discharged by the fortuitous event must still account for the hides of the animals (Article 1809)";
}
pub relation cheptel_peri_en_entier(c: Cheptel) kind empirical {
    label fr official "le cheptel a péri en entier (articles 1810 et 1827)";
    label en unofficial "the livestock has wholly perished (Articles 1810 and 1827)";
}
pub relation cheptel_peri_en_partie(c: Cheptel) kind empirical {
    label fr official "une partie seulement du cheptel a péri (article 1810, alinéa 2)";
    label en unofficial "only part of the livestock has perished (Article 1810, second paragraph)";
}
pub relation perte_pour_le_bailleur_du_cheptel(c: Cheptel) kind derived {
    label fr official "si le cheptel périt en entier sans la faute du preneur, la perte est pour le bailleur (articles 1810 et 1827)";
    label en unofficial "if the livestock wholly perishes without the lessee's fault, the loss falls on the lessor (Articles 1810 and 1827)";
}
pub relation perte_supportee_en_commun(c: Cheptel) kind derived {
    label fr official "s'il n'en périt qu'une partie, la perte est supportée en commun, d'après l'estimation originaire et celle de l'expiration du cheptel (article 1810, alinéa 2)";
    label en unofficial "if only part perishes, the loss is borne in common, on the original valuation and that at the expiry of the lease (Article 1810, second paragraph)";
}
pub relation stipulation_de_perte_totale_a_la_charge_du_preneur(c: Cheptel) kind empirical {
    label fr official "il est stipulé que le preneur supportera la perte totale du cheptel, quoique arrivée par cas fortuit et sans sa faute (article 1811)";
    label en unofficial "it is stipulated that the lessee will bear the total loss of the livestock, even by fortuitous event and without his fault (Article 1811)";
}
pub relation stipulation_de_part_de_perte_superieure_au_profit(c: Cheptel) kind empirical {
    label fr official "il est stipulé que le preneur supportera dans la perte une part plus grande que dans le profit (article 1811)";
    label en unofficial "it is stipulated that the lessee will bear a greater share in the loss than in the profit (Article 1811)";
}
pub relation stipulation_de_prelevement_supplementaire_du_bailleur(c: Cheptel) kind empirical {
    label fr official "il est stipulé que le bailleur prélèvera, à la fin du bail, quelque chose de plus que le cheptel qu'il a fourni (article 1811)";
    label en unofficial "it is stipulated that the lessor will take, at the end of the lease, something more than the livestock he supplied (Article 1811)";
}
pub relation convention_de_cheptel_nulle(c: Cheptel) kind derived {
    label fr official "toute convention semblable est nulle (article 1811)";
    label en unofficial "any such agreement is void (Article 1811)";
}
pub relation stipulation_metayer_nulle_invoquee(c: Cheptel) kind empirical {
    label fr official "le métayer a invoqué la nullité de la stipulation de perte";
    label en unofficial "the sharecropper invoked the nullity of the loss stipulation";
}
pub relation stipulation_nulle_invoquee(c: Cheptel) kind empirical {
    label fr official "le preneur a invoqué la nullité de la stipulation interdite";
    label en unofficial "the lessee invoked the nullity of the prohibited stipulation";
}
pub relation laitages_fumier_et_travail_au_preneur(c: Cheptel) kind derived {
    label fr official "le preneur profite seul des laitages, du fumier et du travail des animaux donnés à cheptel (articles 1811 et 1819)";
    label en unofficial "the lessee alone benefits from the dairy produce, the manure and the work of the animals (Articles 1811 and 1819)";
}
pub relation laine_et_croit_partages(c: Cheptel) kind derived {
    label fr official "la laine et le croît se partagent (article 1811)";
    label en unofficial "the wool and the increase are shared (Article 1811)";
}
pub relation consentement_de_l_autre_partie_a_la_disposition(c: Cheptel) kind empirical {
    label fr official "l'autre partie a consenti à la disposition d'une bête du troupeau (article 1812)";
    label en unofficial "the other party consented to the disposal of an animal from the herd (Article 1812)";
}
pub relation disposition_d_une_bete_interdite(c: Cheptel) kind derived {
    label fr official "aucune des parties ne peut disposer d'une bête du troupeau, du fonds ou du croît, sans le consentement de l'autre (article 1812)";
    label en unofficial "neither party may dispose of an animal of the herd, of the stock or of the increase, without the other's consent (Article 1812)";
}
pub relation cheptel_donne_au_fermier_d_autrui(c: Cheptel) kind empirical {
    label fr official "le cheptel est donné au fermier d'autrui (article 1813)";
    label en unofficial "the livestock is given to another's farmer (Article 1813)";
}
pub relation notification_au_proprietaire_du_fonds_faite(c: Cheptel) kind empirical {
    label fr official "le cheptel a été notifié au propriétaire de qui le fermier tient (article 1813)";
    label en unofficial "the livestock lease was notified to the owner from whom the farmer holds (Article 1813)";
}
pub relation proprietaire_peut_saisir_et_faire_vendre(c: Cheptel) kind derived {
    label fr official "à défaut de notification, le propriétaire peut saisir le cheptel et le faire vendre pour ce que son fermier lui doit (article 1813)";
    label en unofficial "in default of notice, the owner may seize the livestock and have it sold for what his farmer owes him (Article 1813)";
}
pub relation cheptel_saisi_par_le_proprietaire(c: Cheptel) kind institutional {
    label fr official "le propriétaire a saisi le cheptel pour le faire vendre en paiement de ce que son fermier lui doit (article 1813)";
    label en unofficial "the owner has attached the livestock to have it sold for what his farmer owes him (Article 1813)";
}
pub relation saisie_du_cheptel_exercee(c: Cheptel) kind empirical {
    label fr official "le propriétaire a saisi et fait vendre le cheptel";
    label en unofficial "the owner seized and had the livestock sold";
}
pub relation bailleur_prevenu_de_la_tonte(c: Cheptel) kind empirical {
    label fr official "le preneur a prévenu le bailleur avant de tondre (article 1814)";
    label en unofficial "the lessee warned the lessor before shearing (Article 1814)";
}
pub relation tonte_interdite_sans_avertissement(c: Cheptel) kind derived {
    label fr official "le preneur ne peut tondre sans en prévenir le bailleur (article 1814)";
    label en unofficial "the lessee may not shear without warning the lessor (Article 1814)";
}
pub relation tonte_exercee_sans_avertissement(c: Cheptel) kind empirical {
    label fr official "le preneur a tondu sans avertir le bailleur";
    label en unofficial "the lessee sheared without warning the lessor";
}
pub relation duree_du_cheptel_fixee_par_convention(c: Cheptel, n: Integer) kind empirical {
    key(c);
    label fr official "durée du cheptel fixée par la convention, en années (article 1815)";
    label en unofficial "duration of the livestock lease fixed by the agreement, in years (Article 1815)";
}
pub relation duree_du_cheptel_applicable(c: Cheptel, n: Integer) kind derived {
    key(c);
    label fr official "s'il n'y a pas de temps fixé par la convention, le cheptel est censé fait pour trois ans (article 1815)";
    label en unofficial "if no time is fixed by the agreement, the livestock lease is deemed made for three years (Article 1815)";
}
pub relation duree_du_cheptel_convenue(c: Cheptel) kind empirical {
    label fr official "un temps a été fixé par la convention pour la durée du cheptel (article 1815)";
    label en unofficial "a time was fixed by the agreement for the duration of the livestock lease (Article 1815)";
}
pub relation preneur_de_cheptel_manque_a_ses_obligations(c: Cheptel) kind empirical {
    label fr official "le preneur ne remplit pas ses obligations (article 1816)";
    label en unofficial "the lessee does not fulfil his obligations (Article 1816)";
}
pub relation bailleur_peut_demander_la_resolution_du_cheptel(c: Cheptel) kind derived {
    label fr official "le bailleur peut demander plus tôt la résolution du cheptel si le preneur ne remplit pas ses obligations (article 1816)";
    label en unofficial "the lessor may seek early dissolution of the livestock lease if the lessee does not fulfil his obligations (Article 1816)";
}
pub relation resolution_anticipee_du_cheptel_demandee(c: Cheptel) kind institutional {
    label fr official "le bailleur a demandé la résolution anticipée du cheptel (article 1816)";
    label en unofficial "the lessor has sought early dissolution of the livestock lease (Article 1816)";
}
pub relation demande_resolution_du_cheptel_exercee(c: Cheptel) kind empirical {
    label fr official "le bailleur a demandé la résolution anticipée du cheptel";
    label en unofficial "the lessor sought early dissolution of the livestock lease";
}
pub relation fin_du_cheptel_ou_resolution(c: Cheptel) kind empirical {
    label fr official "le bail à cheptel prend fin ou est résolu (articles 1817 et 1826)";
    label en unofficial "the livestock lease ends or is dissolved (Articles 1817 and 1826)";
}
pub relation animaux_suffisants_pour_reconstituer_le_fonds(c: Cheptel) kind empirical {
    label fr official "il existe assez d'animaux pour reconstituer le fonds de bétail quant au nombre, à la race, à l'âge, au poids et à la qualité (articles 1817 et 1826)";
    label en unofficial "there are enough animals to reconstitute the stock as to number, breed, age, weight and quality (Articles 1817 and 1826)";
}
pub relation bailleur_preleve_le_fonds_et_partage_l_excedent(c: Cheptel) kind derived {
    label fr official "le bailleur prélève des animaux de chaque espèce de manière à obtenir un même fonds de bétail, et l'excédent se partage (article 1817, alinéa 1)";
    label en unofficial "the lessor takes animals of each kind so as to obtain the same stock, and the excess is shared (Article 1817, first paragraph)";
}
pub relation fonds_preleve_et_excedent_partage(c: Cheptel) kind empirical {
    label fr official "le fonds a été prélevé et l'excédent partagé";
    label en unofficial "the stock was taken back and the excess shared";
}
pub relation reglement_sur_la_valeur_au_jour_de_la_fin(c: Cheptel) kind derived {
    label fr official "s'il n'existe pas assez d'animaux, les parties se font raison de la perte sur la base de la valeur des animaux au jour où le contrat prend fin (articles 1817 et 1826)";
    label en unofficial "if there are not enough animals, the parties settle the loss on the value of the animals at the day the contract ends (Articles 1817 and 1826)";
}
pub relation stipulation_de_valeur_egale_a_l_estimation(c: Cheptel) kind empirical {
    label fr official "il est stipulé que le preneur doit laisser un fonds de bétail d'une valeur égale au prix de l'estimation de celui qu'il a reçu (articles 1817 et 1826)";
    label en unofficial "it is stipulated that the lessee must leave a stock of a value equal to the valuation price of the one he received (Articles 1817 and 1826)";
}
pub relation chacun_fournit_la_moitie_des_bestiaux(c: Cheptel) kind empirical {
    label fr official "chacun des contractants fournit la moitié des bestiaux, qui demeurent communs pour le profit ou pour la perte (article 1818)";
    label en unofficial "each party supplies half the livestock, which remains common for profit or loss (Article 1818)";
}
pub relation cheptel_a_moitie_qualifie(c: Cheptel) kind derived {
    label fr official "le cheptel à moitié est une société dans laquelle chacun fournit la moitié des bestiaux (article 1818)";
    label en unofficial "a livestock lease by halves is a partnership in which each supplies half the livestock (Article 1818)";
}
pub relation bailleur_proprietaire_de_la_metairie(c: Cheptel) kind empirical {
    label fr official "le bailleur est propriétaire de la métairie dont le preneur est fermier ou métayer (article 1819, alinéa 3)";
    label en unofficial "the lessor owns the sharecropping farm of which the lessee is farmer or sharecropper (Article 1819, third paragraph)";
}
pub relation convention_contraire_sur_les_laitages(c: Cheptel) kind empirical {
    label fr official "une convention contraire règle les laitages, le fumier et les travaux des bêtes (article 1819, alinéa 3)";
    label en unofficial "an agreement to the contrary governs the dairy produce, the manure and the work of the animals (Article 1819, third paragraph)";
}
pub relation convention_contraire_sur_les_laitages_nulle(c: Cheptel) kind derived {
    label fr official "toute convention contraire est nulle, à moins que le bailleur ne soit propriétaire de la métairie (article 1819, alinéa 3)";
    label en unofficial "any agreement to the contrary is void, unless the lessor owns the sharecropping farm (Article 1819, third paragraph)";
}
pub relation cheptel_de_fer_qualifie(c: Cheptel) kind derived {
    label fr official "le cheptel donné au fermier, dit cheptel de fer, oblige le fermier à laisser à l'expiration du bail un même fonds de bétail (article 1821)";
    label en unofficial "the livestock lease given to the farmer, called iron stock, obliges him to leave the same stock at the end of the lease (Article 1821)";
}
pub relation convention_contraire_sur_les_profits_du_fermier(c: Cheptel) kind empirical {
    label fr official "une convention contraire règle les profits pendant la durée du bail (article 1823)";
    label en unofficial "an agreement to the contrary governs the profits during the lease (Article 1823)";
}
pub relation profits_au_fermier_pendant_le_bail(c: Cheptel) kind derived {
    label fr official "tous les profits appartiennent au fermier pendant la durée de son bail, s'il n'y a convention contraire (article 1823)";
    label en unofficial "all profits belong to the farmer during his lease, unless otherwise agreed (Article 1823)";
}
pub relation fumier_appartient_a_la_metairie(c: Cheptel) kind derived {
    label fr official "dans les cheptels donnés au fermier, le fumier appartient à la métairie et doit être uniquement employé à son exploitation (article 1824)";
    label en unofficial "in livestock leases given to the farmer, the manure belongs to the farm and must be used only in working it (Article 1824)";
}
pub relation fumier_employe_a_l_exploitation(c: Cheptel) kind empirical {
    label fr official "le fumier a été employé à l'exploitation de la métairie";
    label en unofficial "the manure was used in the farm's operation";
}
pub relation convention_contraire_sur_la_perte_du_fermier(c: Cheptel) kind empirical {
    label fr official "une convention contraire règle la charge de la perte du cheptel de fer (article 1825)";
    label en unofficial "an agreement to the contrary governs who bears the loss of the iron stock (Article 1825)";
}
pub relation perte_totale_pour_le_fermier(c: Cheptel) kind derived {
    label fr official "la perte, même totale et par cas fortuit, est en entier pour le fermier, s'il n'y a convention contraire (article 1825)";
    label en unofficial "the loss, even total and by fortuitous event, falls entirely on the farmer, unless otherwise agreed (Article 1825)";
}
pub relation excedent_appartient_au_preneur(c: Cheptel) kind derived {
    label fr official "s'il y a un excédent à la fin du cheptel donné au fermier, il appartient au preneur (article 1826, alinéa 2)";
    label en unofficial "if there is an excess at the end of the iron-stock lease, it belongs to the lessee (Article 1826, second paragraph)";
}
pub relation cheptel_donne_au_metayer(c: Cheptel) kind empirical {
    label fr official "le cheptel est donné au métayer (articles 1827 à 1830)";
    label en unofficial "the livestock is given to the sharecropper (Articles 1827 to 1830)";
}
pub relation stipulation_de_toute_la_perte_a_la_charge_du_metayer(c: Cheptel) kind empirical {
    label fr official "il est stipulé que le métayer sera tenu de toute la perte (article 1828)";
    label en unofficial "it is stipulated that the sharecropper will bear the whole loss (Article 1828)";
}
pub relation bail_de_metayage_fini(c: Cheptel) kind empirical {
    label fr official "le bail de métayage a pris fin (article 1829)";
    label en unofficial "the sharecropping lease has ended (Article 1829)";
}
pub relation cheptel_du_metayer_fini(c: Cheptel) kind derived {
    label fr official "ce cheptel finit avec le bail de métayage (article 1829)";
    label en unofficial "this livestock lease ends with the sharecropping lease (Article 1829)";
}
pub relation vaches_donnees_pour_loger_et_nourrir(c: Cheptel) kind empirical {
    label fr official "une ou plusieurs vaches sont données pour les loger et les nourrir (article 1831)";
    label en unofficial "one or more cows are given to be housed and fed (Article 1831)";
}
pub relation bailleur_conserve_la_propriete_des_vaches(c: Cheptel) kind derived {
    label fr official "le bailleur conserve la propriété des vaches et n'a que le profit des veaux qui en naissent (article 1831)";
    label en unofficial "the lessor keeps ownership of the cows and has only the profit of the calves born of them (Article 1831)";
}

// --- Titre VI, chapitres VII et VIII : licitation et transport de créances (1686 à 1701-1) ---

pub entity Cession {
    label fr official "transport d'un droit ou d'une action sur un tiers (articles 1689 à 1701-1)";
    label en unofficial "assignment of a right or action against a third party (Articles 1689 to 1701-1)";
}
pub relation cedant(t: Cession, p: Personne) kind empirical {
    key(t);
    label fr official "le cédant du droit ou de l'action (article 1689)";
    label en unofficial "the assignor of the right or action (Article 1689)";
}
pub relation cessionnaire(t: Cession, p: Personne) kind empirical {
    key(t);
    label fr official "le cessionnaire du droit ou de l'action (article 1689)";
    label en unofficial "the assignee of the right or action (Article 1689)";
}
pub relation debiteur_cede(t: Cession, p: Personne) kind empirical {
    key(t);
    label fr official "le débiteur cédé (articles 1690 et 1691)";
    label en unofficial "the assigned debtor (Articles 1690 and 1691)";
}
pub relation titre_remis_au_cessionnaire(t: Cession) kind empirical {
    label fr official "le titre a été remis par le cédant au cessionnaire (article 1689)";
    label en unofficial "the instrument was handed by the assignor to the assignee (Article 1689)";
}
pub relation delivrance_du_droit_cede_operee(t: Cession) kind derived {
    label fr official "dans le transport d'un droit, la délivrance s'opère entre le cédant et le cessionnaire par la remise du titre (article 1689)";
    label en unofficial "in the assignment of a right, delivery is effected between assignor and assignee by handing over the instrument (Article 1689)";
}
pub relation signification_du_transport_au_debiteur(t: Cession) kind empirical {
    label fr official "la signification du transport a été faite au débiteur (article 1690, alinéa 1)";
    label en unofficial "notice of the assignment was served on the debtor (Article 1690, first paragraph)";
}
pub relation acceptation_du_transport_par_acte_authentique(t: Cession) kind empirical {
    label fr official "le débiteur a accepté le transport dans un acte authentique (article 1690, alinéa 2)";
    label en unofficial "the debtor accepted the assignment in an authentic instrument (Article 1690, second paragraph)";
}
pub relation cessionnaire_saisi_a_l_egard_des_tiers(t: Cession) kind derived {
    label fr official "le cessionnaire est saisi à l'égard des tiers par la signification du transport ou par son acceptation en acte authentique (article 1690)";
    label en unofficial "the assignee is vested as against third parties by the notice of assignment or by its acceptance in an authentic instrument (Article 1690)";
}
pub relation debiteur_a_paye_le_cedant(t: Cession) kind empirical {
    label fr official "le débiteur a payé le cédant (article 1691)";
    label en unofficial "the debtor paid the assignor (Article 1691)";
}
pub relation debiteur_valablement_libere(t: Cession) kind derived {
    label fr official "si le débiteur avait payé le cédant avant la signification du transport, il est valablement libéré (article 1691)";
    label en unofficial "if the debtor paid the assignor before notice of the assignment, he is validly discharged (Article 1691)";
}
pub relation vente_d_un_droit_incorporel(t: Cession) kind empirical {
    label fr official "l'objet vendu est un droit incorporel (article 1693)";
    label en unofficial "the object sold is an incorporeal right (Article 1693)";
}
pub relation cession_sans_garantie(t: Cession) kind empirical {
    label fr official "la cession est faite sans garantie (article 1693)";
    label en unofficial "the assignment is made without warranty (Article 1693)";
}
pub relation garantie_de_l_existence_du_droit_due(t: Cession) kind derived {
    label fr official "celui qui vend un droit incorporel doit en garantir l'existence au temps du transport, quoique la vente soit faite sans garantie (article 1693)";
    label en unofficial "one who sells an incorporeal right must warrant its existence at the time of the assignment, although the sale is made without warranty (Article 1693)";
}
pub relation vente_d_une_succession_sans_specifier_les_objets(t: Cession) kind empirical {
    label fr official "le vendeur vend une succession sans en spécifier en détail les objets (article 1696)";
    label en unofficial "the seller sells an estate without specifying its objects in detail (Article 1696)";
}
pub relation garantie_limitee_a_la_qualite_d_heritier(t: Cession) kind derived {
    label fr official "celui qui vend une succession sans en spécifier les objets n'est tenu de garantir que sa qualité d'héritier (article 1696)";
    label en unofficial "one who sells an estate without specifying its objects warrants only his capacity as heir (Article 1696)";
}
pub relation vendeur_a_profite_des_fruits_ou_creances_de_la_succession(t: Cession) kind empirical {
    label fr official "le vendeur a profité des fruits, reçu une créance ou vendu des effets de la succession (article 1697)";
    label en unofficial "the seller enjoyed the fruits, received a claim or sold effects of the estate (Article 1697)";
}
pub relation reserve_expresse_lors_de_la_vente(t: Cession) kind empirical {
    label fr official "le vendeur les a expressément réservés lors de la vente (article 1697)";
    label en unofficial "the seller expressly reserved them at the sale (Article 1697)";
}
pub relation remboursement_a_l_acquereur_de_la_succession_du(t: Cession) kind derived {
    label fr official "le vendeur est tenu de rembourser à l'acquéreur les fruits, créances et effets de la succession dont il a profité, s'il ne les a expressément réservés (article 1697)";
    label en unofficial "the seller must reimburse the buyer the fruits, claims and effects of the estate he enjoyed, unless he expressly reserved them (Article 1697)";
}
pub relation dettes_et_charges_payees_par_le_vendeur(t: Cession) kind empirical {
    label fr official "le vendeur a payé des dettes et charges de la succession (article 1698)";
    label en unofficial "the seller paid debts and charges of the estate (Article 1698)";
}
pub relation stipulation_contraire_sur_les_dettes(t: Cession) kind empirical {
    label fr official "une stipulation contraire règle le remboursement des dettes et charges (article 1698)";
    label en unofficial "a stipulation to the contrary governs the reimbursement of debts and charges (Article 1698)";
}
pub relation remboursement_au_vendeur_de_la_succession_du(t: Cession) kind derived {
    label fr official "l'acquéreur doit rembourser au vendeur ce que celui-ci a payé pour les dettes et charges de la succession, s'il n'y a stipulation contraire (article 1698)";
    label en unofficial "the buyer must reimburse the seller what he paid for the debts and charges of the estate, unless otherwise stipulated (Article 1698)";
}
pub relation proces_et_contestation_sur_le_fond_du_droit(t: Cession) kind empirical {
    label fr official "il y a procès et contestation sur le fond du droit (article 1700)";
    label en unofficial "there is litigation and a dispute on the substance of the right (Article 1700)";
}
pub relation droit_litigieux(t: Cession) kind derived {
    label fr official "la chose est censée litigieuse dès qu'il y a procès et contestation sur le fond du droit (article 1700)";
    label en unofficial "the thing is deemed litigious as soon as there is litigation and a dispute on the substance of the right (Article 1700)";
}
pub relation cession_a_un_coheritier_ou_coproprietaire(t: Cession) kind empirical {
    label fr official "la cession a été faite à un cohéritier ou copropriétaire du droit cédé (article 1701, 1°)";
    label en unofficial "the assignment was made to a co-heir or co-owner of the assigned right (Article 1701, 1)";
}
pub relation cession_a_un_creancier_en_paiement(t: Cession) kind empirical {
    label fr official "la cession a été faite à un créancier en paiement de ce qui lui est dû (article 1701, 2°)";
    label en unofficial "the assignment was made to a creditor in payment of what is owed to him (Article 1701, 2)";
}
pub relation cession_au_possesseur_de_l_heritage(t: Cession) kind empirical {
    label fr official "la cession a été faite au possesseur de l'héritage sujet au droit litigieux (article 1701, 3°)";
    label en unofficial "the assignment was made to the possessor of the estate subject to the litigious right (Article 1701, 3)";
}
pub relation retrait_litigieux_ouvert(t: Cession) kind derived {
    label fr official "celui contre lequel on a cédé un droit litigieux peut s'en faire tenir quitte par le cessionnaire, en lui remboursant le prix réel de la cession, les frais et loyaux coûts et les intérêts (article 1699)";
    label en unofficial "the person against whom a litigious right was assigned may be discharged by the assignee, on repaying the real price of the assignment, the costs and lawful expenses and the interest (Article 1699)";
}
pub relation cession_regie_par_les_articles_1321_a_1326(t: Cession) kind empirical {
    label fr official "la cession est régie par les articles 1321 à 1326 du présent code (article 1701-1)";
    label en unofficial "the assignment is governed by Articles 1321 to 1326 of this code (Article 1701-1)";
}
pub relation articles_1689_a_1693_inapplicables(t: Cession) kind derived {
    label fr official "les articles 1689 à 1691 et 1693 ne s'appliquent pas aux cessions régies par les articles 1321 à 1326 (article 1701-1)";
    label en unofficial "Articles 1689 to 1691 and 1693 do not apply to assignments governed by Articles 1321 to 1326 (Article 1701-1)";
}
pub entity Licitation {
    label fr official "licitation d'une chose commune à plusieurs (articles 1686 à 1688)";
    label en unofficial "auction sale of a thing held in common (Articles 1686 to 1688)";
}
pub relation coproprietaire(l: Licitation, p: Personne) kind empirical {
    label fr official "copropriétaire de la chose commune (articles 1686 et 1687)";
    label en unofficial "co-owner of the thing held in common (Articles 1686 and 1687)";
}
pub relation chose_commune_non_partageable_commodement(l: Licitation) kind empirical {
    label fr official "la chose commune à plusieurs ne peut être partagée commodément et sans perte (article 1686)";
    label en unofficial "the thing held in common cannot be conveniently divided without loss (Article 1686)";
}
pub relation bien_qu_aucun_copartageant_ne_veut_prendre(l: Licitation) kind empirical {
    label fr official "dans un partage de gré à gré, il se trouve des biens qu'aucun des copartageants ne peut ou ne veut prendre (article 1686)";
    label en unofficial "in an amicable partition, there are assets none of the sharers can or will take (Article 1686)";
}
pub relation vente_aux_encheres_et_partage_du_prix(l: Licitation) kind derived {
    label fr official "la vente s'en fait aux enchères et le prix en est partagé entre les copropriétaires (article 1686)";
    label en unofficial "the sale is made by auction and the price is shared among the co-owners (Article 1686)";
}
pub relation coproprietaire_demande_l_appel_des_etrangers(l: Licitation) kind empirical {
    label fr official "l'un des copropriétaires demande que les étrangers soient appelés à la licitation (article 1687)";
    label en unofficial "one of the co-owners requests that strangers be called to the auction (Article 1687)";
}
pub relation coproprietaire_mineur(l: Licitation, p: Personne) kind empirical {
    label fr official "l'un des copropriétaires est mineur (article 1687)";
    label en unofficial "one of the co-owners is a minor (Article 1687)";
}
pub relation etrangers_appeles_a_la_licitation(l: Licitation) kind derived {
    label fr official "les étrangers sont appelés à la licitation ; ils le sont nécessairement lorsque l'un des copropriétaires est mineur (article 1687)";
    label en unofficial "strangers are called to the auction; they necessarily are where one of the co-owners is a minor (Article 1687)";
}
pub relation danger_de_perdre_la_chose_et_le_prix(v: Vente) kind empirical {
    label fr official "le vendeur est en danger de perdre la chose et le prix (article 1655, alinéa 1)";
    label en unofficial "the seller is in danger of losing both the thing and the price (Article 1655, first paragraph)";
}
pub relation resolution_immobiliere_prononcee_aussitot(v: Vente) kind derived {
    label fr official "la résolution de la vente d'immeubles est prononcée aussitôt si le vendeur est en danger de perdre la chose et le prix (article 1655, alinéa 1)";
    label en unofficial "the rescission of a sale of immovables is pronounced at once if the seller is in danger of losing both the thing and the price (Article 1655, first paragraph)";
}
pub relation juge_peut_accorder_un_delai_a_l_acquereur(v: Vente) kind derived {
    label fr official "si ce danger n'existe pas, le juge peut accorder à l'acquéreur un délai plus ou moins long suivant les circonstances (article 1655, alinéa 2)";
    label en unofficial "if that danger does not exist, the court may grant the buyer a longer or shorter time according to the circumstances (Article 1655, second paragraph)";
}
pub relation delai_judiciaire_passe_sans_paiement(v: Vente) kind empirical {
    label fr official "le délai accordé par le juge est passé sans que l'acquéreur ait payé (article 1655, alinéa 3)";
    label en unofficial "the time granted by the court has elapsed without the buyer paying (Article 1655, third paragraph)";
}
pub relation resolution_prononcee_apres_le_delai(v: Vente) kind derived {
    label fr official "ce délai passé sans que l'acquéreur ait payé, la résolution de la vente est prononcée (article 1655, alinéa 3)";
    label en unofficial "that time having elapsed without the buyer paying, the rescission of the sale is pronounced (Article 1655, third paragraph)";
}
pub relation augmentation_de_prix_pour_excedent_de_mesure(v: Vente) kind derived {
    label fr official "il y a lieu à augmentation de prix pour excédent de mesure suivant l'article 1619 (article 1620)";
    label en unofficial "there is ground for an increase of price for excess measure under Article 1619 (Article 1620)";
}
pub relation acquereur_a_garde_l_immeuble(v: Vente) kind empirical {
    label fr official "l'acquéreur a gardé l'immeuble (article 1620)";
    label en unofficial "the buyer kept the building (Article 1620)";
}
pub relation interets_du_supplement_de_prix_dus(v: Vente) kind derived {
    label fr official "l'acquéreur qui fournit le supplément du prix en doit les intérêts s'il a gardé l'immeuble (article 1620)";
    label en unofficial "the buyer who supplies the supplement of the price owes interest on it if he kept the building (Article 1620)";
}
pub relation deux_fonds_vendus_par_le_meme_contrat_pour_un_seul_prix(v: Vente) kind empirical {
    label fr official "deux fonds ont été vendus par le même contrat pour un seul et même prix, avec désignation de la mesure de chacun (article 1623)";
    label en unofficial "two lands were sold by the same contract for a single price, with the measure of each stated (Article 1623)";
}
pub relation moins_de_contenance_en_l_un_et_plus_en_l_autre(v: Vente) kind empirical {
    label fr official "il se trouve moins de contenance en l'un des fonds et plus en l'autre (article 1623)";
    label en unofficial "one of the lands is found short in area and the other in excess (Article 1623)";
}
pub relation compensation_jusqu_a_due_concurrence(v: Vente) kind derived {
    label fr official "on fait compensation jusqu'à due concurrence entre le manque et l'excédent des deux fonds (article 1623)";
    label en unofficial "a set-off is made up to the due amount between the shortfall and the excess of the two lands (Article 1623)";
}
pub relation bail_d_appartement_meuble_a_tant_par_an(b: Bail) kind empirical {
    label fr official "le bail d'un appartement meublé a été fait à tant par an (article 1758, alinéa 1)";
    label en unofficial "the lease of a furnished flat was made at so much per year (Article 1758, first paragraph)";
}
pub relation bail_d_appartement_meuble_a_tant_par_mois(b: Bail) kind empirical {
    label fr official "le bail d'un appartement meublé a été fait à tant par mois (article 1758, alinéa 2)";
    label en unofficial "the lease of a furnished flat was made at so much per month (Article 1758, second paragraph)";
}
pub relation bail_d_appartement_meuble_a_tant_par_jour(b: Bail) kind empirical {
    label fr official "le bail d'un appartement meublé a été fait à tant par jour (article 1758, alinéa 3)";
    label en unofficial "the lease of a furnished flat was made at so much per day (Article 1758, third paragraph)";
}
pub enum PeriodeDuBailMeuble {
    label fr official "période à laquelle le bail d'un appartement meublé est censé fait : l'année, le mois, le jour ou l'usage des lieux (article 1758)";
    label en unofficial "period for which the lease of a furnished flat is deemed made: the year, the month, the day or local usage (Article 1758)";
    Annee, Mois, Jour, UsageDesLieux
}
pub relation periode_du_bail_meuble(b: Bail, p: PeriodeDuBailMeuble) kind derived {
    key(b);
    label fr official "période à laquelle le bail d'un appartement meublé est censé fait (article 1758)";
    label en unofficial "period for which the lease of a furnished flat is deemed made (Article 1758)";
}

// --- Titre VI, incapacités (1596, 1597), vente d'immeuble à construire (1601-4),
//     rachat contre les tiers (1663, 1664, 1666), marchés à prix fait (1799),
//     cheptel simple (1804) ---

pub enum QualiteInterditeDAdjudication {
    label fr official "qualités qui interdisent de se rendre adjudicataire, sous peine de nullité (article 1596)";
    label en unofficial "capacities that bar a person from becoming a successful bidder, on pain of nullity (Article 1596)";
    Tuteur, Mandataire, Administrateur, OfficierPublic, Fiduciaire
}
pub relation adjudicataire_en_qualite(v: Vente, p: Personne, q: QualiteInterditeDAdjudication) kind empirical {
    label fr official "la personne se rend adjudicataire, par elle-même ou par personne interposée, des biens qu'elle détient en cette qualité (article 1596)";
    label en unofficial "the person becomes successful bidder, personally or through an intermediary, for the assets he holds in that capacity (Article 1596)";
}
pub relation adjudication_nulle(v: Vente) kind derived {
    label fr official "l'adjudication est nulle (article 1596)";
    label en unofficial "the adjudication is void (Article 1596)";
}
pub relation auxiliaire_de_justice_du_ressort(v: Vente, p: Personne) kind empirical {
    label fr official "juge, suppléant, magistrat du ministère public, greffier, huissier, avocat, défenseur officieux ou notaire exerçant dans le ressort du tribunal compétent (article 1597)";
    label en unofficial "judge, deputy, public prosecutor, clerk, bailiff, advocate, unofficial defender or notary practising in the district of the competent court (Article 1597)";
}
pub relation cession_de_droit_litigieux_du_ressort(v: Vente) kind empirical {
    label fr official "la cession porte sur des procès, droits et actions litigieux de la compétence du tribunal dans le ressort duquel la personne exerce ses fonctions (article 1597)";
    label en unofficial "the assignment concerns litigation, rights and actions within the jurisdiction of the court in whose district the person practises (Article 1597)";
}
pub relation cession_a_un_auxiliaire_de_justice_nulle(v: Vente) kind derived {
    label fr official "les auxiliaires de justice ne peuvent devenir cessionnaires des droits litigieux de leur ressort, à peine de nullité et des dépens, dommages et intérêts (article 1597)";
    label en unofficial "officers of the court may not become assignees of litigious rights in their district, on pain of nullity and of costs and damages (Article 1597)";
}
pub relation cession_des_droits_de_l_acquereur_d_immeuble_a_construire(v: Vente) kind empirical {
    label fr official "l'acquéreur cède les droits qu'il tient d'une vente d'immeuble à construire (article 1601-4, alinéa 1)";
    label en unofficial "the buyer assigns the rights he holds under a sale of a building to be constructed (Article 1601-4, first paragraph)";
}
pub relation cessionnaire_substitue_aux_obligations_envers_le_vendeur(v: Vente) kind derived {
    label fr official "la cession substitue de plein droit le cessionnaire dans les obligations de l'acquéreur envers le vendeur (article 1601-4, alinéa 1)";
    label en unofficial "the assignment substitutes the assignee by operation of law in the buyer's obligations towards the seller (Article 1601-4, first paragraph)";
}
pub relation vente_assortie_d_un_mandat(v: Vente) kind empirical {
    label fr official "la vente d'immeuble à construire a été assortie d'un mandat (article 1601-4, alinéa 2)";
    label en unofficial "the sale of a building to be constructed was accompanied by a mandate (Article 1601-4, second paragraph)";
}
pub relation mandat_poursuivi_avec_le_cessionnaire(v: Vente) kind derived {
    label fr official "le mandat se poursuit entre le vendeur et le cessionnaire (article 1601-4, alinéa 2)";
    label en unofficial "the mandate continues between the seller and the assignee (Article 1601-4, second paragraph)";
}
pub relation second_acquereur_du_bien_rachetable(v: Vente, p: Personne) kind empirical {
    label fr official "un second acquéreur a acquis la chose soumise au pacte de rachat (article 1664)";
    label en unofficial "a second buyer acquired the thing subject to the redemption pact (Article 1664)";
}
pub relation faculte_de_rachat_declaree_au_second_contrat(v: Vente) kind empirical {
    label fr official "la faculté de rachat a été déclarée dans le second contrat (article 1664)";
    label en unofficial "the right of redemption was declared in the second contract (Article 1664)";
}
pub relation action_en_rachat_ouverte_contre_le_second_acquereur(v: Vente, p: Personne) kind derived {
    label fr official "le vendeur à pacte de rachat peut exercer son action contre un second acquéreur, quand même la faculté n'aurait pas été déclarée dans le second contrat (article 1664)";
    label en unofficial "the seller with a redemption pact may bring his action against a second buyer, even if the right was not declared in the second contract (Article 1664)";
}
pub relation vendeur_mineur_ou_protege(v: Vente) kind empirical {
    label fr official "le vendeur à pacte de rachat est mineur (article 1663)";
    label en unofficial "the seller with a redemption pact is a minor (Article 1663)";
}
pub relation delai_de_rachat_court_contre_toutes_personnes(v: Vente) kind derived {
    label fr official "le délai de rachat court contre toutes personnes, même contre le mineur, sauf le recours contre qui de droit (article 1663)";
    label en unofficial "the redemption period runs against all persons, even against a minor, save recourse against whoever is answerable (Article 1663)";
}
pub relation creancier_du_vendeur_a_pacte_de_rachat(v: Vente, p: Personne) kind empirical {
    label fr official "créancier du vendeur à pacte de rachat poursuivant l'acquéreur (article 1666)";
    label en unofficial "creditor of the seller with a redemption pact proceeding against the buyer (Article 1666)";
}
pub relation benefice_de_discussion_opposable_aux_creanciers(v: Vente) kind derived {
    label fr official "l'acquéreur à pacte de rachat peut opposer le bénéfice de la discussion aux créanciers de son vendeur (article 1666)";
    label en unofficial "the buyer under a redemption pact may plead the benefit of discussion against his seller's creditors (Article 1666)";
}
pub relation poursuite_des_creanciers_ecartee(v: Vente) kind institutional {
    label fr official "la poursuite des créanciers du vendeur est écartée par le bénéfice de discussion (article 1666)";
    label en unofficial "the seller's creditors' pursuit is barred by the benefit of discussion (Article 1666)";
}
pub relation marche_a_prix_fait_conclu_directement(m: Marche) kind empirical {
    label fr official "des maçons, charpentiers, serruriers ou autres ouvriers font directement des marchés à prix fait (article 1799)";
    label en unofficial "masons, carpenters, locksmiths or other workers make fixed-price contracts directly (Article 1799)";
}
pub relation ouvrier_est_entrepreneur_dans_sa_partie(m: Marche) kind derived {
    label fr official "les ouvriers qui font directement des marchés à prix fait sont entrepreneurs dans la partie qu'ils traitent et astreints aux règles de la présente section (article 1799)";
    label en unofficial "workers who make fixed-price contracts directly are contractors in the part they handle and are subject to the rules of this section (Article 1799)";
}
pub relation cheptel_simple_qualifie(c: Cheptel) kind derived {
    label fr official "le bail à cheptel simple donne des bestiaux à garder, nourrir et soigner, à condition que le preneur profite de la moitié du croît et supporte la moitié de la perte (article 1804)";
    label en unofficial "a simple livestock lease gives animals to keep, feed and care for, on condition that the lessee takes half the increase and bears half the loss (Article 1804)";
}
pub relation preneur_profite_de_la_moitie_du_croit(c: Cheptel) kind derived {
    label fr official "le preneur profite de la moitié du croît (article 1804)";
    label en unofficial "the lessee takes half the increase (Article 1804)";
}
pub relation preneur_supporte_la_moitie_de_la_perte(c: Cheptel) kind derived {
    label fr official "le preneur supporte la moitié de la perte (article 1804)";
    label en unofficial "the lessee bears half the loss (Article 1804)";
}
