// Louage des choses, suite : qualification (1709), troubles de la jouissance
// (1723 à 1727), obligations et responsabilité du preneur (1729 à 1735),
// résolution (1740, 1741, 1760, 1761), vente de la chose louée et indemnités
// du locataire expulsé (1744 à 1750), attribution du bail après dissolution
// d'un PACS (1751-1), garnissement (1752) et réparations (1754 à 1756).
//
// Les montants de 1745 et 1746 sont VÉRIFIÉS et non calculés : la fraction du
// tiers de l'article 1746 est écrite sans division, par multiplication croisée,
// comme la lésion de l'article 1674.

// --- Qualification et forme de la chose louée -------------------------------

@source(CC_ART1709)
rule QualificationDuLouageDeChoses(b: Bail, l: Personne, p: Personne, c: Chose, prix: Money) strict {
    label fr official "Article 1709. Le louage des choses fait jouir l'autre d'une chose pendant un certain temps, moyennant un certain prix";
    label en unofficial "Article 1709. A lease of things lets the other enjoy a thing for a certain time, for a certain price";
    when bailleur(b, l) and preneur(b, p) and chose_louee(b, c)
        and obligation_de_faire_jouir_pendant_un_certain_temps(b) and prix_du_bail_convenu(b, prix);
    then louage_de_choses_qualifie(b);
}

@source(CC_ART1723)
rule FormeDeLaChoseLoueeInchangeable(b: Bail) strict {
    label fr official "Article 1723. Le bailleur ne peut, pendant la durée du bail, changer la forme de la chose louée";
    label en unofficial "Article 1723. The lessor may not, during the lease, change the form of the leased thing";
    when bail_en_vigueur(b);
    then forme_de_la_chose_louee_inchangeable(b);
}

@source(CC_ART1723)
rule PositionFormeDeLaChoseLoueeInchangeable(b: Bail, l: Personne, p: Personne) strict {
    label fr official "Article 1723. Interdiction faite au bailleur de changer la forme de la chose louée";
    label en unofficial "Article 1723. Prohibition on the lessor changing the form of the leased thing";
    when bail_en_vigueur(b) and bailleur(b, l) and preneur(b, p);
    then prohibition NePasChangerLaFormeDeLaChoseLouee {
        bearer l; beneficiary p;
        action forme_de_la_chose_louee_changee_par_bailleur(b);
        window [@1804-03-21, infinity);
    };
}

@source(CC_ART1723)
rule PositionMaintenirFormeDeLaChoseLouee(b: Bail, l: Personne, p: Personne) strict {
    label fr official "Article 1723. Obligation du bailleur de maintenir la forme de la chose louée";
    label en unofficial "Article 1723. Lessor's duty to maintain the form of the leased thing";
    when bail_en_vigueur(b) and bailleur(b, l) and preneur(b, p);
    then duty MaintenirLaFormeDeLaChoseLouee {
        bearer l; beneficiary p;
        maintain not forme_de_la_chose_louee_changee_par_bailleur(b) during [@1804-03-21, infinity);
    };
}

// --- Troubles de la jouissance : la ligne de partage est le DROIT prétendu ---

@source(CC_ART1725)
rule BailleurNonTenuDuTroubleDeFait(b: Bail) strict {
    label fr official "Article 1725. Le bailleur n'est pas tenu de garantir le preneur du trouble que des tiers apportent par voies de fait, sans prétendre aucun droit";
    label en unofficial "Article 1725. The lessor need not warrant the lessee against a disturbance by third parties by acts of force, claiming no right";
    when trouble_de_fait_par_des_tiers_sans_droit(b);
    then bailleur_non_tenu_du_trouble_de_fait(b);
}

@source(CC_ART1725)
rule PreneurPoursuitEnSonNomPersonnel(b: Bail) strict {
    label fr official "Article 1725. Sauf au preneur à poursuivre en son nom personnel les auteurs des voies de fait";
    label en unofficial "Article 1725. Save for the lessee to sue in his own name the authors of the acts of force";
    when trouble_de_fait_par_des_tiers_sans_droit(b);
    then preneur_peut_poursuivre_en_son_nom_personnel(b);
}

// Article 1726 : la diminution suppose une dénonciation — le texte la pose en
// condition expresse (« pourvu que »), non en formalité facultative.
@source(CC_ART1726)
rule DiminutionProportionneePourTroubleDeDroit(b: Bail) strict {
    label fr official "Article 1726. Le preneur troublé par une action concernant la propriété a droit à une diminution proportionnée, pourvu que le trouble ait été dénoncé au propriétaire";
    label en unofficial "Article 1726. A lessee disturbed by an action concerning ownership is entitled to a proportionate reduction, provided the disturbance was notified to the owner";
    when trouble_par_action_concernant_la_propriete(b) and trouble_denonce_au_proprietaire(b);
    then diminution_proportionnee_du_prix_due(b);
}
pub relation demande_diminution_prix_pour_trouble_exercee(b: Bail) kind empirical {
    label fr official "demande de diminution du prix pour trouble exercée";
    label en unofficial "request for rent reduction due to disturbance exercised";
}
@source(CC_ART1726)
rule P4PouvoirDemanderDiminutionTrouble1726(b: Bail, p: Personne) strict {
    label fr official "Article 1726. Pouvoir du preneur de demander une diminution proportionnée";
    label en unofficial "Article 1726. Lessee's power to request a proportionate reduction";
    when bail_en_vigueur(b) and preneur(b, p)
        and trouble_par_action_concernant_la_propriete(b)
        and trouble_denonce_au_proprietaire(b);
    then power P4PouvoirDemanderDiminutionTrouble1726Actif {
        holder p;
        exercise demande_diminution_prix_pour_trouble_exercee(b);
        valid_when trouble_denonce_au_proprietaire(b);
        effect diminution_proportionnee_du_prix_due(b);
        window [@1804-03-21, infinity);
    };
}

@source(CC_ART1727)
rule AppelDuBailleurEnGarantie(b: Bail) strict {
    label fr official "Article 1727. Si les tiers prétendent un droit ou si le preneur est cité en justice, il doit appeler le bailleur en garantie";
    label en unofficial "Article 1727. If third parties claim a right or the lessee is summoned to court, he must call the lessor in warranty";
    when tiers_pretendent_un_droit_ou_preneur_cite_en_justice(b);
    then preneur_doit_appeler_le_bailleur_en_garantie(b);
}

@source(CC_ART1727)
rule PositionDevoirAppelEnGarantie(b: Bail, p: Personne) strict {
    label fr official "Article 1727. Devoir du preneur d'appeler le bailleur en garantie";
    label en unofficial "Article 1727. Lessee's duty to call the lessor in warranty";
    when bail_en_vigueur(b) and preneur(b, p)
        and tiers_pretendent_un_droit_ou_preneur_cite_en_justice(b);
    then duty AppelerBailleurEnGarantie {
        bearer p;
        achieve appel_en_garantie_par_preneur(b) during [@1804-03-21, infinity);
    };
}

@source(CC_ART1727)
rule MiseHorsDInstanceDuPreneur(b: Bail) strict {
    label fr official "Article 1727. Le preneur doit être mis hors d'instance, s'il l'exige, en nommant le bailleur pour lequel il possède";
    label en unofficial "Article 1727. The lessee must be dismissed from the proceedings, if he so requires, by naming the lessor for whom he possesses";
    when preneur_doit_appeler_le_bailleur_en_garantie(b) and preneur_exige_d_etre_mis_hors_d_instance(b);
    then preneur_mis_hors_d_instance(b);
}

// --- Obligations et responsabilité du preneur -------------------------------

@source(CC_ART1729)
rule ResiliationPourUsageDeraisonnable(b: Bail) strict {
    label fr official "Article 1729. Si le preneur n'use pas de la chose louée raisonnablement, le bailleur peut, suivant les circonstances, faire résilier le bail";
    label en unofficial "Article 1729. If the lessee does not use the leased thing reasonably, the lessor may, according to the circumstances, have the lease terminated";
    when usage_deraisonnable_de_la_chose_louee(b);
    then bailleur_peut_faire_resilier_le_bail(b);
}

@source(CC_ART1729)
rule ResiliationPourUsageContraireALaDestination(b: Bail) strict {
    label fr official "Article 1729. Si le preneur emploie la chose à un autre usage que celui auquel elle a été destinée, le bailleur peut faire résilier le bail";
    label en unofficial "Article 1729. If the lessee uses the thing for a purpose other than that intended, the lessor may have the lease terminated";
    when usage_autre_que_la_destination(b);
    then bailleur_peut_faire_resilier_le_bail(b);
}

@source(CC_ART1729)
rule PositionPouvoirResiliationUsageDeraisonnable(b: Bail, l: Personne) strict {
    label fr official "Article 1729. Pouvoir du bailleur de demander la résiliation pour usage déraisonnable";
    label en unofficial "Article 1729. Lessor's power to seek termination for unreasonable use";
    when bail_en_vigueur(b) and bailleur(b, l) and usage_deraisonnable_de_la_chose_louee(b);
    then power PouvoirResiliationUsageDeraisonnable {
        holder l;
        exercise demande_resiliation_par_bailleur(b);
        valid_when usage_deraisonnable_de_la_chose_louee(b);
        effect resiliation_demandee_par_bailleur(b);
        window [@1804-03-21, infinity);
    };
}

@source(CC_ART1729)
rule PositionPouvoirResiliationUsageDestination(b: Bail, l: Personne) strict {
    label fr official "Article 1729. Pouvoir du bailleur de demander la résiliation pour usage contraire à la destination";
    label en unofficial "Article 1729. Lessor's power to seek termination for use contrary to purpose";
    when bail_en_vigueur(b) and bailleur(b, l) and usage_autre_que_la_destination(b);
    then power PouvoirResiliationUsageDestination {
        holder l;
        exercise demande_resiliation_par_bailleur(b);
        valid_when usage_autre_que_la_destination(b);
        effect resiliation_demandee_par_bailleur(b);
        window [@1804-03-21, infinity);
    };
}

// Articles 1730 et 1731 : deux régimes exclusifs, séparés par l'existence d'un
// état des lieux. Le second est une présomption renversable, et la preuve
// contraire est un fait du cas, non un silence.
@source(CC_ART1730)
rule RestitutionSuivantLEtatDesLieux(b: Bail) strict {
    label fr official "Article 1730. S'il a été fait un état des lieux, le preneur doit rendre la chose telle qu'il l'a reçue, excepté ce qui a péri par vétusté ou force majeure";
    label en unofficial "Article 1730. If an inventory was made, the lessee must return the thing as he received it, save what perished by age or force majeure";
    when etat_des_lieux_dresse(b);
    then restitution_conforme_a_l_etat_des_lieux_due(b);
}

@source(CC_ART1730)
rule PositionDevoirRestitutionEtatDesLieux(b: Bail, p: Personne) strict {
    label fr official "Article 1730. Devoir du preneur de restituer selon l'état des lieux";
    label en unofficial "Article 1730. Lessee's duty to return according to the inventory";
    when bail_en_vigueur(b) and preneur(b, p) and etat_des_lieux_dresse(b);
    then duty RestituerSelonEtatDesLieux {
        bearer p;
        achieve restitution_conforme_a_l_etat_des_lieux_effectuee(b) during [@1804-03-21, infinity);
    };
}

// L'exception de l'article 1730 porte sur CE QUI a péri, non sur l'obligation
// entière : elle est donc une conclusion propre, et non une condition négative
// de la restitution.
@source(CC_ART1730)
rule VetusteEtForceMajeureHorsDeLaRestitution(b: Bail) strict {
    label fr official "Article 1730. Est excepté de la restitution ce qui a péri ou a été dégradé par vétusté ou force majeure";
    label en unofficial "Article 1730. What perished or was damaged by age or force majeure is excepted from the return";
    when etat_des_lieux_dresse(b) and perte_ou_degradation_par_vetuste_ou_force_majeure(b);
    then reparation_non_a_la_charge_du_locataire(b);
}

@source(CC_ART1731)
rule PresomptionDeBonEtatADefautDEtatDesLieux(b: Bail) strict {
    label fr official "Article 1731. À défaut d'état des lieux, le preneur est présumé les avoir reçus en bon état de réparations locatives, sauf la preuve contraire";
    label en unofficial "Article 1731. In the absence of an inventory, the lessee is presumed to have received the premises in good tenantable repair, save proof to the contrary";
    when bail_en_vigueur(b) and not_known(etat_des_lieux_dresse(b))
        and not_known(preuve_contraire_du_mauvais_etat_initial(b));
    then preneur_presume_avoir_recu_en_bon_etat(b);
}

@source(CC_ART1732)
rule PreneurRepondDesDegradations(b: Bail) strict {
    label fr official "Article 1732. Le preneur répond des dégradations ou des pertes qui arrivent pendant sa jouissance, à moins qu'il ne prouve qu'elles ont eu lieu sans sa faute";
    label en unofficial "Article 1732. The lessee answers for deteriorations or losses occurring during his enjoyment, unless he proves they occurred without his fault";
    when degradations_ou_pertes_pendant_la_jouissance(b)
        and not_known(preneur_prouve_l_absence_de_faute(b));
    then preneur_repond_des_degradations(b);
}
pub relation degradations_reparees_par_preneur(b: Bail) kind empirical {
    label fr official "dégradations ou pertes réparées par le preneur";
    label en unofficial "deterioration or loss repaired by the lessee";
}
@source(CC_ART1732)
rule P4DevoirRepondreDegradations1732(b: Bail, p: Personne, l: Personne) strict {
    label fr official "Article 1732. Le preneur doit répondre des dégradations ou pertes pendant sa jouissance";
    label en unofficial "Article 1732. The lessee must answer for deterioration or loss during enjoyment";
    when bail_en_vigueur(b) and preneur(b, p) and bailleur(b, l)
        and degradations_ou_pertes_pendant_la_jouissance(b);
    then duty P4DevoirRepondreDegradations1732Actif {
        bearer p;
        beneficiary l;
        achieve degradations_reparees_par_preneur(b) during [@1804-03-21, infinity);
    };
}

// Article 1733 : trois causes libératoires nommées, et elles seules.
@source(CC_ART1733)
rule PreneurRepondDeLIncendie(b: Bail) strict {
    label fr official "Article 1733. Le preneur répond de l'incendie, à moins qu'il ne prouve le cas fortuit, la force majeure, le vice de construction ou la communication par une maison voisine";
    label en unofficial "Article 1733. The lessee answers for the fire, unless he proves fortuitous event, force majeure, a construction defect or spread from a neighbouring house";
    when incendie_survenu(b)
        and not_known(incendie_par_cas_fortuit_force_majeure_ou_vice_de_construction(b))
        and not_known(feu_communique_par_une_maison_voisine(b));
    then preneur_repond_de_l_incendie(b);
}
pub relation incendie_indemnise_par_preneur(b: Bail) kind empirical {
    label fr official "incendie indemnisé par le preneur";
    label en unofficial "fire indemnified by the lessee";
}
@source(CC_ART1733)
rule P4DevoirRepondreIncendie1733(b: Bail, p: Personne, l: Personne) strict {
    label fr official "Article 1733. Le preneur doit répondre de l'incendie hors causes libératoires";
    label en unofficial "Article 1733. The lessee must answer for the fire absent exculpatory causes";
    when bail_en_vigueur(b) and preneur(b, p) and bailleur(b, l)
        and incendie_survenu(b)
        and not_known(incendie_par_cas_fortuit_force_majeure_ou_vice_de_construction(b))
        and not_known(feu_communique_par_une_maison_voisine(b));
    then duty P4DevoirRepondreIncendie1733Actif {
        bearer p;
        beneficiary l;
        achieve incendie_indemnise_par_preneur(b) during [@1804-03-21, infinity);
    };
}

// Article 1734 : la responsabilité proportionnelle est la règle, et les deux
// preuves nommées la déplacent. La proportion elle-même se règle sur les
// valeurs locatives que le cas établit ; le paquet dit QUI répond, non combien.
@source(CC_ART1734)
rule TousLesLocatairesTenusProportionnellement(b: Bail, p: Personne) strict {
    label fr official "Article 1734, alinéa 1. S'il y a plusieurs locataires, tous sont responsables de l'incendie, proportionnellement à la valeur locative de la partie qu'ils occupent";
    label en unofficial "Article 1734, first paragraph. If there are several tenants, all are liable for the fire in proportion to the rental value of the part they occupy";
    when incendie_survenu(b) and plusieurs_locataires(b) and locataire_de_l_immeuble(b, p)
        and not_known(locataire_prouve_que_le_feu_n_a_pu_commencer_chez_lui(b, p));
    then locataire_tenu_proportionnellement_a_la_valeur_locative(b, p);
}

@source(CC_ART1734)
rule PositionDevoirResponsabiliteProportionnelle(b: Bail, p: Personne) strict {
    label fr official "Article 1734. Devoir du locataire d'assumer la responsabilité proportionnelle de l'incendie";
    label en unofficial "Article 1734. Tenant's duty to assume proportional fire liability";
    when incendie_survenu(b) and plusieurs_locataires(b) and locataire_de_l_immeuble(b, p)
        and not_known(locataire_prouve_que_le_feu_n_a_pu_commencer_chez_lui(b, p));
    then duty AssumerResponsabiliteProportionnelle {
        bearer p;
        achieve responsabilite_proportionnelle_assumee(b, p) during [@1804-03-21, infinity);
    };
}

@source(CC_ART1734)
rule LocataireSeulTenuSiLIncendieACommenceChezLui(b: Bail, p: Personne) strict {
    label fr official "Article 1734, alinéa 2. S'il est prouvé que l'incendie a commencé dans l'habitation de l'un d'eux, celui-là seul en est tenu";
    label en unofficial "Article 1734, second paragraph. If it is proved that the fire began in the dwelling of one of them, he alone is liable";
    when incendie_survenu(b) and plusieurs_locataires(b) and incendie_commence_chez_un_locataire(b, p);
    then locataire_seul_tenu_de_l_incendie(b, p);
}
pub relation incendie_repare_par_locataire(b: Bail, p: Personne) kind empirical {
    label fr official "incendie réparé par le locataire responsable";
    label en unofficial "fire repaired by the liable tenant";
}
@source(CC_ART1734)
rule P4DevoirAssumerIncendieSeul1734(b: Bail, p: Personne, l: Personne) strict {
    label fr official "Article 1734. Le locataire chez qui a commencé l'incendie doit en répondre seul";
    label en unofficial "Article 1734. The tenant where the fire began must answer for it alone";
    when bail_en_vigueur(b) and preneur(b, p) and bailleur(b, l)
        and incendie_survenu(b) and plusieurs_locataires(b)
        and incendie_commence_chez_un_locataire(b, p);
    then duty P4DevoirAssumerIncendieSeul1734Actif {
        bearer p;
        beneficiary l;
        achieve incendie_repare_par_locataire(b, p) during [@1804-03-21, infinity);
    };
}

@source(CC_ART1734)
rule LocataireHorsDeCauseSIlProuveQueLeFeuNAPuCommencerChezLui(b: Bail, p: Personne) strict {
    label fr official "Article 1734, alinéa 3. Le locataire qui prouve que l'incendie n'a pu commencer chez lui n'en est pas tenu";
    label en unofficial "Article 1734, third paragraph. A tenant who proves the fire could not have begun on his premises is not liable";
    when incendie_survenu(b) and plusieurs_locataires(b)
        and locataire_prouve_que_le_feu_n_a_pu_commencer_chez_lui(b, p);
    then locataire_non_tenu_de_l_incendie(b, p);
}

@source(CC_ART1735)
rule PreneurTenuDuFaitDeSaMaison(b: Bail) strict {
    label fr official "Article 1735. Le preneur est tenu des dégradations et des pertes qui arrivent par le fait des personnes de sa maison ou de ses sous-locataires";
    label en unofficial "Article 1735. The lessee is liable for deteriorations and losses occurring through the act of his household or his subtenants";
    when degradation_par_les_personnes_de_la_maison_du_preneur(b);
    then preneur_tenu_du_fait_de_sa_maison(b);
}

@source(CC_ART1735)
rule PositionDevoirReparerDegradationsDeLaMaison(b: Bail, p: Personne) strict {
    label fr official "Article 1735. Devoir du preneur de réparer les dégradations de sa maison";
    label en unofficial "Article 1735. Lessee's duty to repair household damage";
    when bail_en_vigueur(b) and preneur(b, p)
        and degradation_par_les_personnes_de_la_maison_du_preneur(b);
    then duty ReparerDegradationsDeLaMaison {
        bearer p;
        achieve degradations_des_personnes_reparees(b) during [@1804-03-21, infinity);
    };
}

// --- Fin du bail -------------------------------------------------------------

@source(CC_ART1740)
rule CautionNonEtendueALaProlongation(b: Bail) strict {
    label fr official "Article 1740. La caution donnée pour le bail ne s'étend pas aux obligations résultant de la prolongation";
    label en unofficial "Article 1740. The surety given for the lease does not extend to obligations arising from the extension";
    when caution_donnee_pour_le_bail(b) and bail_renouvele_par_tacite_reconduction(b);
    then caution_non_etendue_a_la_prolongation(b);
}

@source(CC_ART1741)
rule ResolutionParLaPerteDeLaChose(b: Bail) strict {
    label fr official "Article 1741. Le contrat de louage se résout par la perte de la chose louée";
    label en unofficial "Article 1741. The lease is dissolved by the loss of the leased thing";
    when perte_de_la_chose_louee(b);
    then contrat_de_louage_resolu(b);
}

@source(CC_ART1741)
rule ResolutionParLeDefautDeRemplirLesEngagements(b: Bail) strict {
    label fr official "Article 1741. Le contrat de louage se résout par le défaut respectif du bailleur et du preneur de remplir leurs engagements";
    label en unofficial "Article 1741. The lease is dissolved by the respective failure of lessor and lessee to fulfil their undertakings";
    when defaut_de_remplir_les_engagements(b);
    then contrat_de_louage_resolu(b);
}

@source(CC_ART1760)
rule LoyerDuPendantLaRelocation(b: Bail) strict {
    label fr official "Article 1760. En cas de résiliation par la faute du locataire, celui-ci paie le prix du bail pendant le temps nécessaire à la relocation";
    label en unofficial "Article 1760. Upon termination through the tenant's fault, he pays the rent for the time needed to re-let";
    when resiliation_par_la_faute_du_locataire(b);
    then loyer_du_pendant_la_relocation(b);
}
pub relation loyer_relocation_paye_par_locataire(b: Bail) kind empirical {
    label fr official "loyer de relocation payé par le locataire";
    label en unofficial "reletting-period rent paid by the lessee";
}
@source(CC_ART1760)
rule P4DevoirPayerLoyerRelocation1760(b: Bail, p: Personne, l: Personne) strict {
    label fr official "Article 1760. Le locataire doit payer le loyer pendant la relocation";
    label en unofficial "Article 1760. The lessee must pay rent during reletting";
    when preneur(b, p) and bailleur(b, l)
        and resiliation_par_la_faute_du_locataire(b);
    then duty P4DevoirPayerLoyerRelocation1760Actif {
        bearer p;
        beneficiary l;
        achieve loyer_relocation_paye_par_locataire(b) during [@1804-03-21, infinity);
    };
}

@source(CC_ART1761)
rule BailleurNePeutResoudrePourOccuper(b: Bail) strict {
    label fr official "Article 1761. Le bailleur ne peut résoudre la location pour occuper lui-même la maison louée, s'il n'y a eu convention contraire";
    label en unofficial "Article 1761. The lessor may not end the lease in order to occupy the leased house himself, unless there is an agreement to the contrary";
    when bailleur_declare_vouloir_occuper_lui_meme(b)
        and not_known(convention_contraire_sur_la_reprise(b));
    then bailleur_ne_peut_resoudre_pour_occuper(b);
}

@source(CC_ART1761)
rule PositionInterdictionResolutionPourOccupation(b: Bail, l: Personne) strict {
    label fr official "Article 1761. Interdiction au bailleur de résilier pour occuper lui-même";
    label en unofficial "Article 1761. Prohibition on the lessor terminating to occupy himself";
    when bailleur(b, l) and bailleur_declare_vouloir_occuper_lui_meme(b)
        and not_known(convention_contraire_sur_la_reprise(b));
    then prohibition NePasResoudrePourOccupation {
        bearer l;
        action resolution_tentee_pour_occuper(b);
        window [@1804-03-21, infinity);
    };
}

@source(CC_ART1761)
rule MaintenanceInterdictionResolutionPourOccupation(b: Bail, l: Personne) strict {
    label fr official "Article 1761. Le bailleur doit maintenir l'interdiction de résilier pour occuper lui-même";
    label en unofficial "Article 1761. The lessor must maintain the prohibition on terminating to occupy the premises himself";
    when bailleur(b, l) and bailleur_declare_vouloir_occuper_lui_meme(b)
        and not_known(convention_contraire_sur_la_reprise(b));
    then duty MaintenanceInterdictionResolutionPourOccupationDuty {
        bearer l;
        goal maintenance {
            condition not resolution_tentee_pour_occuper(b);
            window [@1804-03-21, infinity);
        };
    };
}

// --- Vente de la chose louée : l'indemnité du locataire expulsé --------------

@source(CC_ART1744)
rule BailleurTenuDIndemniserLeLocataireExpulse(b: Bail) strict {
    label fr official "Article 1744. Si le bail réserve à l'acquéreur la faculté d'expulser sans stipulation sur les dommages-intérêts, le bailleur est tenu d'indemniser le locataire";
    label en unofficial "Article 1744. If the lease reserves to the buyer the power to evict without stipulating damages, the lessor must indemnify the tenant";
    when chose_louee_vendue(b) and droit_d_expulser_reserve_par_le_bail(b)
        and aucune_stipulation_sur_les_dommages_interets(b);
    then bailleur_tenu_d_indemniser_le_locataire(b);
}
pub relation indemnisation_locataire_expulse_versee(b: Bail) kind empirical {
    label fr official "indemnité du locataire expulsé versée";
    label en unofficial "indemnity paid to the evicted tenant";
}
@source(CC_ART1744)
rule P4DevoirIndemniserLocataireExpulse1744(b: Bail, l: Personne, p: Personne) strict {
    label fr official "Article 1744. Le bailleur doit indemniser le locataire expulsé";
    label en unofficial "Article 1744. The lessor must indemnify the evicted tenant";
    when bailleur(b, l) and preneur(b, p)
        and chose_louee_vendue(b)
        and droit_d_expulser_reserve_par_le_bail(b)
        and aucune_stipulation_sur_les_dommages_interets(b);
    then duty P4DevoirIndemniserLocataireExpulse1744Actif {
        bearer l;
        beneficiary p;
        achieve indemnisation_locataire_expulse_versee(b) during [@1804-03-21, infinity);
    };
}

// Article 1745 : « une somme égale au prix du loyer » — l'égalité est vérifiée,
// non recalculée : le loyer du délai d'usage est un fait du lieu.
@source(CC_ART1745)
rule IndemniteEgaleAuLoyerDuDelaiDUsage(b: Bail, loyer: Money) strict {
    label fr official "Article 1745. S'il s'agit d'une maison, d'un appartement ou d'une boutique, le bailleur paie une somme égale au prix du loyer du temps accordé entre le congé et la sortie";
    label en unofficial "Article 1745. For a house, flat or shop, the lessor pays a sum equal to the rent for the time allowed between notice and departure";
    when bailleur_tenu_d_indemniser_le_locataire(b) and bail_de_maison_appartement_ou_boutique(b)
        and loyer_du_temps_entre_conge_et_sortie(b, loyer);
    then indemnite_du_locataire_evince(b, loyer);
}

// Article 1746 : le tiers est écrit sans division — trois indemnités valent le
// prix du bail restant à courir.
@source(CC_ART1746)
rule IndemniteDuTiersPourBienRural(b: Bail, reste: Money, indemnite: Money) strict {
    label fr official "Article 1746. S'il s'agit de biens ruraux, l'indemnité due au fermier est du tiers du prix du bail pour tout le temps qui reste à courir";
    label en unofficial "Article 1746. For rural property, the indemnity owed to the farmer is one third of the price of the lease for all the time remaining to run";
    when bailleur_tenu_d_indemniser_le_locataire(b) and bail_de_biens_ruraux(b)
        and prix_du_bail_pour_le_temps_restant(b, reste)
        and loyer_du_temps_entre_conge_et_sortie(b, indemnite)
        and indemnite * 3 == reste;
    then indemnite_du_fermier_evince(b, indemnite);
}

@source(CC_ART1747)
rule IndemniteRegleeParExperts(b: Bail) strict {
    label fr official "Article 1747. L'indemnité se règle par experts s'il s'agit d'établissements qui exigent de grandes avances";
    label en unofficial "Article 1747. The indemnity is settled by experts for establishments requiring large advances";
    when bailleur_tenu_d_indemniser_le_locataire(b) and etablissement_exigeant_de_grandes_avances(b);
    then indemnite_reglee_par_experts(b);
}

@source(CC_ART1748)
rule ExpulsionSubordonneeALAvertissement(b: Bail) strict {
    label fr official "Article 1748. L'acquéreur qui veut user de la faculté d'expulser est tenu d'avertir le locataire au temps d'avance usité dans le lieu";
    label en unofficial "Article 1748. The buyer who wishes to exercise the power to evict must warn the tenant with the customary advance notice";
    when acquereur_peut_expulser_le_preneur(b) and acquereur_a_averti_au_temps_usite(b);
    then expulsion_subordonnee_a_l_avertissement(b);
}

@source(CC_ART1749)
rule ExpulsionInterditeAvantPaiement(b: Bail) strict {
    label fr official "Article 1749. Les locataires ne peuvent être expulsés qu'ils ne soient payés des dommages et intérêts par le bailleur ou le nouvel acquéreur";
    label en unofficial "Article 1749. Tenants may not be evicted until they are paid the damages by the lessor or the new buyer";
    when bailleur_tenu_d_indemniser_le_locataire(b)
        and not_known(dommages_interets_payes_au_locataire(b));
    then expulsion_interdite_avant_paiement(b);
}

@source(CC_ART1749)
rule PositionInterdictionExpulsionAvantIndemnisation(b: Bail, p: Personne) strict {
    label fr official "Article 1749. Interdiction d'expulser le locataire avant indemnisation";
    label en unofficial "Article 1749. Prohibition on evicting the tenant before indemnification";
    when preneur(b, p) and bailleur_tenu_d_indemniser_le_locataire(b)
        and not_known(dommages_interets_payes_au_locataire(b));
    then prohibition NePasExpulserAvantIndemnisation {
        bearer p;
        action expulsion_tentee_avant_paiement(b);
        window [@1804-03-21, infinity);
    };
}

@source(CC_ART1749)
rule MaintenanceInterdictionExpulsionAvantIndemnisation(b: Bail, p: Personne) strict {
    label fr official "Article 1749. Le bailleur doit maintenir l'interdiction d'expulser avant indemnisation";
    label en unofficial "Article 1749. The lessor must maintain the prohibition on eviction before indemnification";
    when preneur(b, p) and bailleur_tenu_d_indemniser_le_locataire(b)
        and not_known(dommages_interets_payes_au_locataire(b));
    then duty MaintenanceInterdictionExpulsionAvantIndemnisationDuty {
        bearer p;
        goal maintenance {
            condition not expulsion_tentee_avant_paiement(b);
            window [@1804-03-21, infinity);
        };
    };
}

// Article 1750 : le miroir de 1743 — pas de date certaine, pas de dommages.
@source(CC_ART1750)
rule AcquereurNonTenuSansDateCertaine(b: Bail) strict {
    label fr official "Article 1750. Si le bail n'est pas fait par acte authentique ou n'a point de date certaine, l'acquéreur n'est tenu d'aucuns dommages et intérêts";
    label en unofficial "Article 1750. If the lease is not in authentic form or has no certain date, the buyer owes no damages";
    when chose_louee_vendue(b) and not_known(bail_authentique_ou_a_date_certaine(b));
    then acquereur_non_tenu_de_dommages_interets(b);
}

@source(CC_ART1751_1)
rule AttributionDuBailApresDissolutionDuPacs(b: Bail, p: Personne) strict {
    label fr official "Article 1751-1. En cas de dissolution du PACS, le juge apprécie la demande d'attribution du droit au bail en considération des intérêts sociaux et familiaux";
    label en unofficial "Article 1751-1. Upon dissolution of a civil solidarity pact, the court assesses the claim for award of the lease in the light of social and family interests";
    when bail_d_habitation_sans_caractere_professionnel_ou_commercial(b)
        and dissolution_du_pacs(b) and partenaire_demande_l_attribution_du_bail(b, p);
    then attribution_du_bail_soumise_au_juge(b, p);
}

// --- Garnissement et réparations --------------------------------------------

@source(CC_ART1752)
rule ExpulsionFauteDeMeublesSuffisants(b: Bail) strict {
    label fr official "Article 1752. Le locataire qui ne garnit pas la maison de meubles suffisants peut être expulsé, à moins qu'il ne donne des sûretés";
    label en unofficial "Article 1752. A tenant who does not furnish the house with sufficient movables may be evicted, unless he gives security";
    when maison_non_garnie_de_meubles_suffisants(b)
        and not_known(suretes_capables_de_repondre_du_loyer_donnees(b));
    then locataire_peut_etre_expulse_faute_de_meubles(b);
}

@source(CC_ART1752)
rule PositionInterdictionExpulsionSansSuretes(b: Bail, p: Personne) strict {
    label fr official "Article 1752. Interdiction d'expulser faute de meubles lorsque des sûretés sont absentes";
    label en unofficial "Article 1752. Prohibition on eviction for insufficient furniture";
    when preneur(b, p) and maison_non_garnie_de_meubles_suffisants(b)
        and not_known(suretes_capables_de_repondre_du_loyer_donnees(b));
    then prohibition NePasExpulserFauteDeMeubles {
        bearer p;
        action expulsion_tentee_faute_de_meubles(b);
        window [@1804-03-21, infinity);
    };
}

@source(CC_ART1752)
rule MaintenanceInterdictionExpulsionSansSuretes(b: Bail, p: Personne) strict {
    label fr official "Article 1752. Le bailleur doit maintenir l'interdiction d'expulser faute de meubles";
    label en unofficial "Article 1752. The lessor must maintain the prohibition on eviction for insufficient furniture";
    when preneur(b, p) and maison_non_garnie_de_meubles_suffisants(b)
        and not_known(suretes_capables_de_repondre_du_loyer_donnees(b));
    then duty MaintenanceInterdictionExpulsionSansSuretesDuty {
        bearer p;
        goal maintenance {
            condition not expulsion_tentee_faute_de_meubles(b);
            window [@1804-03-21, infinity);
        };
    };
}

@source(CC_ART1754)
rule ReparationsLocativesALaChargeDuLocataire(b: Bail) strict {
    label fr official "Article 1754. Les réparations locatives ou de menu entretien désignées par l'usage des lieux sont à la charge du locataire, s'il n'y a clause contraire";
    label en unofficial "Article 1754. Tenant's or minor upkeep repairs designated by local usage are borne by the tenant, unless there is a clause to the contrary";
    when reparation_designee_locative_par_l_usage_des_lieux(b)
        and not_known(clause_contraire_sur_les_reparations_locatives(b))
        and not_known(reparation_occasionnee_par_vetuste_ou_force_majeure(b));
    then reparation_a_la_charge_du_locataire(b);
}

@source(CC_ART1754)
rule PositionDevoirEffectuerReparationLocative(b: Bail, p: Personne) strict {
    label fr official "Article 1754. Devoir du locataire d'effectuer les réparations locatives";
    label en unofficial "Article 1754. Tenant's duty to perform tenant repairs";
    when preneur(b, p) and reparation_designee_locative_par_l_usage_des_lieux(b)
        and not_known(clause_contraire_sur_les_reparations_locatives(b))
        and not_known(reparation_occasionnee_par_vetuste_ou_force_majeure(b));
    then duty EffectuerReparationLocative {
        bearer p;
        achieve reparation_locative_effectuee(b) during [@1804-03-21, infinity);
    };
}

@source(CC_ART1755)
rule VetusteEtForceMajeureHorsDesReparationsLocatives(b: Bail) strict {
    label fr official "Article 1755. Aucune des réparations réputées locatives n'est à la charge du locataire quand elles ne sont occasionnées que par vétusté ou force majeure";
    label en unofficial "Article 1755. No repair deemed a tenant's repair is borne by the tenant where it is occasioned only by age or force majeure";
    when reparation_designee_locative_par_l_usage_des_lieux(b)
        and reparation_occasionnee_par_vetuste_ou_force_majeure(b);
    then reparation_non_a_la_charge_du_locataire(b);
}

@source(CC_ART1756)
rule CurementALaChargeDuBailleur(b: Bail) strict {
    label fr official "Article 1756. Le curement des puits et celui des fosses d'aisances sont à la charge du bailleur, s'il n'y a clause contraire";
    label en unofficial "Article 1756. The cleaning of wells and cesspits is borne by the lessor, unless there is a clause to the contrary";
    when curement_de_puits_ou_de_fosses(b) and not_known(clause_contraire_sur_le_curement(b));
    then curement_a_la_charge_du_bailleur(b);
}
pub relation curement_effectue_par_bailleur(b: Bail) kind empirical {
    label fr official "curement effectué par le bailleur";
    label en unofficial "well or cesspit cleaning performed by the lessor";
}
@source(CC_ART1756)
rule P4DevoirCurementBailleur1756(b: Bail, l: Personne) strict {
    label fr official "Article 1756. Le bailleur doit prendre en charge le curement des puits et fosses";
    label en unofficial "Article 1756. The lessor must bear well and cesspit cleaning";
    when bailleur(b, l) and curement_de_puits_ou_de_fosses(b)
        and not_known(clause_contraire_sur_le_curement(b));
    then duty P4DevoirCurementBailleur1756Actif {
        bearer l;
        achieve curement_effectue_par_bailleur(b) during [@1804-03-21, infinity);
    };
}
