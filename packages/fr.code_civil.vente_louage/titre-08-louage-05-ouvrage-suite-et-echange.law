    Marche,
    Personne,
    action_contre_constructeur_introduite_le,
    action_contre_constructeur_recevable,
    action_contre_sous_traitant_introduite_le,
    action_contre_sous_traitant_recevable,
    action_directe_de_l_ouvrier_limitee,
    autre_contractant_non_proprietaire_prouve,
    choix_entre_dommages_interets_et_repetition,
    chose_confiee_au_voiturier,
    chose_recue_en_echange,
    chose_remise_sur_le_port_ou_dans_l_entrepot,
    consentement_reciproque_a_l_echange,
    copermutant_evince,
    copermutant_non_force_de_livrer,
    copermutant_protege_par_article_1704,
    dommage_affecte_la_solidite_d_un_element_d_equipement,
    element_a_fonction_exclusivement_professionnelle,
    element_hors_du_champ_des_garanties,
    element_indissociablement_incorpore,
    element_mis_en_oeuvre_sans_modification,
    fabricant_de_l_element_d_equipement,
    fabricant_solidairement_responsable,
    lie_au_maitre_par_un_contrat_de_louage_d_ouvrage,
    livraison_refusee_pour_non_propriete,
    louage_de_service_peut_cesser_par_volonte_unilaterale,
    louage_de_service_sans_determination_de_duree,
    maitre_debiteur_envers_l_entrepreneur,
    maitre_paye_en_proportion_de_l_ouvrage_fait,
    mandataire_accomplissant_mission_de_locateur,
    marche_dissous_par_deces,
    ouvrage_a_plusieurs_pieces_ou_a_la_mesure,
    ouvrages_faits_et_materiaux_prepares,
