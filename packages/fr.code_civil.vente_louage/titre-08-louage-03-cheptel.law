    profits_au_fermier_pendant_le_bail,
    proprietaire_peut_saisir_et_faire_vendre,
    propriete_non_transferee_au_preneur,
    reglement_sur_la_valeur_au_jour_de_la_fin,
    regles_suppletives_du_cheptel_applicables,
    resolution_anticipee_du_cheptel_demandee,
    saisie_du_cheptel_exercee,
