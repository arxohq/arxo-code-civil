language "law.core" version "0.2";
package fr.code_civil_1804 version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-1804";

// Widow, one living child, one predeceased child represented by a grandchild:
// C1 1/2, G 1/2 (745, 739); the widow has no intestate share (767).
test "urn:query:fr-code-civil-1804-successions-representation" {
    given {
        context { decision_time @1804-03-21T12:00:00Z; knowledge_time @1804-03-21T12:00:00Z; legal_time @1804-03-21; timezone "UTC"; deadline_policy OECD_CODE_CIVIL_1804_PRESCRIPTION; }
        assert "s1": doctrine.ius_privatum::mortuus(entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s2": doctrine.ius_privatum::sine_testamento(entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s3": doctrine.ius_privatum::coniuges(entity_ref("urn:fr:cc1804:s:D"), entity_ref("urn:fr:cc1804:s:E")) { origin case_input; }
        assert "s4": doctrine.ius_privatum::filius(entity_ref("urn:fr:cc1804:s:C1"), entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s5": doctrine.ius_privatum::filius(entity_ref("urn:fr:cc1804:s:C2"), entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s6": prededece(entity_ref("urn:fr:cc1804:s:C2"), entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s7": doctrine.ius_privatum::filius(entity_ref("urn:fr:cc1804:s:G"), entity_ref("urn:fr:cc1804:s:C2")) { origin case_input; }
        assert "s8": existe_a_l_ouverture(entity_ref("urn:fr:cc1804:s:C1"), entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s9": existe_a_l_ouverture(entity_ref("urn:fr:cc1804:s:G"), entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s10": existe_a_l_ouverture(entity_ref("urn:fr:cc1804:s:E"), entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
        assert "s11": concourt(entity_ref("urn:fr:cc1804:s:C1"), entity_ref("urn:fr:cc1804:s:G"), entity_ref("urn:fr:cc1804:s:D")) { origin case_input; }
    }
    evaluate truth(part_successorale(entity_ref("urn:fr:cc1804:s:G"), entity_ref("urn:fr:cc1804:s:D"), 1 / 2));
    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
