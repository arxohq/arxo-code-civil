language "law.core" version "0.2";
package fr.code_civil_1804 version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-1804";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-RESTITUTIONCONTREPRIX" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": achete_en_foire(entity_ref("urn:law:catalog:restitutioncontreprix:v1"), entity_ref("urn:law:catalog:restitutioncontreprix:v2")) { origin case_input; }
        assert "cat-1": revendication_meuble_perdu(entity_ref("urn:law:catalog:restitutioncontreprix:v0"), entity_ref("urn:law:catalog:restitutioncontreprix:v1"), entity_ref("urn:law:catalog:restitutioncontreprix:v2")) { origin case_input; }
    }
    evaluate truth(restitution_contre_prix(entity_ref("urn:law:catalog:restitutioncontreprix:v0"), entity_ref("urn:law:catalog:restitutioncontreprix:v1"), entity_ref("urn:law:catalog:restitutioncontreprix:v2")));
    expect truth_status == TRUE_ONLY;
}
