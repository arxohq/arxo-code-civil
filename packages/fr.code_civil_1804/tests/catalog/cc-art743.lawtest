language "law.core" version "0.2";
package fr.code_civil_1804 version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-1804";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-PRESENCEDEDEUXSOUCHES" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": deux_souches(entity_ref("urn:law:catalog:presencededeuxsouches:v0"), entity_ref("urn:law:catalog:presencededeuxsouches:v1"), entity_ref("urn:law:catalog:presencededeuxsouches:v2")) { origin case_input; }
    }
    evaluate truth(presence_de_deux_souches(entity_ref("urn:law:catalog:presencededeuxsouches:v2")));
    expect truth_status == TRUE_ONLY;
}

// 
test "CATALOG-UNREPRESENTANT" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": representant(entity_ref("urn:law:catalog:unrepresentant:v0"), entity_ref("urn:law:catalog:unrepresentant:v1"), entity_ref("urn:law:catalog:unrepresentant:v2")) { origin case_input; }
    }
    evaluate truth(nombre_de_representans(entity_ref("urn:law:catalog:unrepresentant:v1"), entity_ref("urn:law:catalog:unrepresentant:v2"), 1));
    expect truth_status == TRUE_ONLY;
}
