// CODE CIVIL DES FRANÇAIS (1804) — fifth link of the comparative private-law
// chain (DECISION-0091, IUS-PRIVATUM-CHAIN F6). First edition, not the
// current text (fork 2 of the decision): the line is history.
//
// SCOPE — the article list (SCOPE in the sync script) from eleven pinned
// Wikisource titles: spouses and paternal power, property, intestate
// succession (731–767), liberalities (913–914), contracts and obligations, delicts, sale, loan, deposit,
// prescription. Outside the list is “hors de la chaîne comparative”, not a debt.
//
// TYPES come from the dictionary (DECISION-0091 §3), via E-0098 aliases.

language "law.core" version "0.2";
package fr.code_civil_1804 version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-1804";
import doctrine.ius_privatum version "0.1.0";

source CC_1804 {
    kind code;
    jurisdiction FR;
    number "loi du 30 ventôse an XII";
    label fr official "Code civil des Français";
    label en unofficial "Civil Code of the French (Napoleonic Code), 1804";
}

edition CC_1804_WIKISOURCE of CC_1804 {
    label fr official "Code civil des Français, édition originale et seule officielle, Paris, an XII (1804)";
    label en unofficial "First 1804 edition, French Wikisource transcription of the facsimile";
    language fr;
    officiality unofficial;
    materialization_status PINNED_UNOFFICIAL_COPY;
    adopted @1804-03-21;
    in_force [@1804-03-21, infinity);
}

publication CC_1804_WIKISOURCE_TEXT of CC_1804_WIKISOURCE {
    media_type "text/plain; charset=utf-8";
    uri "https://fr.wikisource.org/wiki/Code_civil_des_Fran%C3%A7ais_1804";
    retrieved_at @2026-09-02T19:30:00Z;
    content_hash "sha256:937250dc71c05a99509cf88a64173e38d5b110a9e3ef478e72fb7078c40760ff";
    local_path "sources/code-civil-1804/fr.txt";
}

type Persona = doctrine.ius_privatum::Persona;
type Res = doctrine.ius_privatum::Res;
type Causa = doctrine.ius_privatum::Causa;
