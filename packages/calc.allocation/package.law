// calc.allocation — распределение денежной суммы по долям либо по очередям
// с явным округлением (DECISION-0123, каталог P04).
//
// ЧТО ЭТОТ ПАКЕТ ДЕЛАЕТ. Ему передают СУММУ, набор ПОЛУЧАТЕЛЕЙ с их долями
// (веса) либо требованиями и очередями (претензии с рангом), ТОЧНОСТЬ и
// минимальную ЕДИНИЦУ денег, а также ПОЛИТИКУ остатка округления. Он
// возвращает долю каждого получателя, ранг его претензии на остаток, сумму
// распределённого, нераспределённый остаток и недоплату по каждому
// требованию. Всё это — обычные правила Law DSL: считают их движки из CLIR,
// а не инструмент вокруг них.
//
// ЧЕГО ОН НЕ ЗНАЕТ, И ЭТО ГРАНИЦА, А НЕ ПРОБЕЛ. Ни одной юрисдикции, ни
// одного акта, ни одной очереди кредиторов по закону. Кто и на каком
// основании отнёс требование к первой очереди, почему доли равны 5:3:1 и кто
// первым претендует на копейку остатка — знает предметный пакет; здесь это
// факты (DECISION-0123 §2). Нормативного источника у пакета НЕТ — @source-
// якорей в его правилах нет ни одного, и sources.law здесь не заводится.
//
// ДВА РЕЖИМА, И ОНИ РАЗНЫЕ ПО СУЩЕСТВУ.
//
//   Proportional — сумма делится между всеми получателями пропорционально
//   весам. Верхних пределов долей нет; остаток округления распределяется по
//   политике остатка. Сумма долей и явно названного остатка ТОЧНО равна
//   исходной сумме.
//
//   Sequential — получатели несут ТРЕБОВАНИЯ (претензии) и РАНГ очереди.
//   Очереди удовлетворяются по возрастанию ранга: каждая получает не больше
//   суммы своих требований и не больше того, что осталось после предыдущих.
//   Внутри очереди, которой не хватило, сумма делится пропорционально
//   требованиям — тем же методом, что и в первом режиме. Требование не
//   покрывается сверх себя; что осталось после последней очереди, названо
//   остатком распределения (он возвращается тому, кому решит потребитель).
//
// МЕТОД ОКРУГЛЕНИЯ ОДИН — НАИБОЛЬШИЕ ОСТАТКИ (Гамильтон). Точная доля
// усекается вниз к объявленной точности (`div_round … "DOWN"`); сумма
// усечённых долей не дотягивает до суммы очереди на целое число минимальных
// единиц; эти единицы по одной получают те, чья отброшенная дробная часть
// больше. Равные дробные части разводит ЯВНЫЙ приоритет получателя; если
// равенство не разведено и на нём стоит граница раздачи — пакет НЕ выбирает
// победителя: он называет неразрешённое равенство и итог не выдаёт.
//
// ПОЛИТИКА ОСТАТКА — ДВЕ:
//   LargestRemainder — единицы остатка раздаются по наибольшим остаткам;
//   Withheld         — доли остаются усечёнными, остаток округления
//                      НЕ раздаётся и виден как остаток распределения.
// Умолчания у политики нет: сумма без объявленной политики неполна.
//
// ЕДИНИЦА И ТОЧНОСТЬ ПЕРЕДАЮТСЯ ОБЕ, И ПАКЕТ СВЕРЯЕТ ИХ МЕЖДУ СОБОЙ.
// Точность нужна округлению §50, единица — раздаче остатка (прибавить
// «одну копейку» можно только копейкой, а денежный литерал пакету писать
// нечем: валюта у него не своя). Единица обязана быть НАИМЕНЬШЕЙ при
// объявленной точности: усечение единицы к точности возвращает её саму, а
// усечение её половины — нуль. Иная единица есть дефект, а не соглашение.
//
// ВАЛЮТА ОДНА. Сумма, единица и требования одной валюты — иначе арифметика
// §50 отказывает CURRENCY_MISMATCH на исполнении. Статически пакет этого
// не проверяет: сравнить валюты двух значений средствами языка нельзя.

language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// --- Носители ---------------------------------------------------------------
//
// Allocation — одно распределение: одна сумма, один набор получателей, одна
// политика. Recipient — позиция в нём: лицо, требование, статья расходов —
// пакету безразлично. Два распределения не делят получателей: у позиции
// один владелец, иначе её доли смешались бы.

pub entity Allocation { label ru official "распределение: одна сумма, один набор получателей, одна политика"; }
pub entity Recipient { label ru official "получатель: позиция распределения"; }

// --- Режим распределения -----------------------------------------------------

pub enum AllocationMode {
    label ru official "режим распределения";
    Proportional,
        Sequential
    }

// --- Политика остатка округления ---------------------------------------------

pub enum RemainderPolicy {
    label ru official "политика остатка округления";
    LargestRemainder,
        Withheld
    }

// --- Дефекты входа -----------------------------------------------------------
//
// Названы поимённо: «распределение неверно» без указания, ЧЕМ именно, — не
// диагностика. Каждый дефект выводится ПОЛОЖИТЕЛЬНЫМ правилом (§115: not без
// отрицательного продюсера не срабатывает никогда), и наличие хотя бы одного
// снимает вычисление целиком: молча исправлять вход пакет не вправе.
//
// ForeignInput — получателю подан вход чужого режима: вес при Sequential,
// требование или ранг при Proportional. Молча проигнорировать его значило бы
// оставить потребителя в уверенности, что вход прочитан.

pub enum AllocationDefect {
    label ru official "дефект входа, снимающий вычисление";
    ModeMissing,
        ModeAmbiguous,
        TotalMissing,
        TotalAmbiguous,
        TotalNegative,
        TotalNotRepresentable,
        PrecisionMissing,
        PrecisionAmbiguous,
        PrecisionNegative,
        UnitMissing,
        UnitAmbiguous,
        UnitNotPositive,
        UnitNotMinimal,
        RemainderPolicyMissing,
        RemainderPolicyAmbiguous,
        NoRecipients,
        WeightMissing,
        WeightAmbiguous,
        WeightNotPositive,
        ClaimMissing,
        ClaimAmbiguous,
        ClaimNotPositive,
        ClaimNotRepresentable,
        RankMissing,
        RankAmbiguous,
        RankNotPositive,
        PriorityAmbiguous,
        PriorityDuplicate,
        ForeignInput
    }
