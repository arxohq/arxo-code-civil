language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Единица 0.02 при точности 2: усечение её половины (0.01) к точности даёт
// 0.01, а не нуль — единица не наименьшая. Дефект назван, вычисление
// снято: единица раздачи остатка не может быть двумя копейками.
test "единица крупнее шага точности — дефект, а не соглашение" {
    given {

        assert "13-defect-unit-not-minimal-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "13-defect-unit-not-minimal-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.00 EUR) { origin case_input; }
        assert "13-defect-unit-not-minimal-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "13-defect-unit-not-minimal-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.02 EUR) { origin case_input; }
        assert "13-defect-unit-not-minimal-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "13-defect-unit-not-minimal-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "13-defect-unit-not-minimal-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "13-defect-unit-not-minimal-8": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "13-defect-unit-not-minimal-9": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
    }

    evaluate truth(allocation_defect(entity_ref("urn:calc:allocation:test:alloc"), UnitNotMinimal));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
