language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Режим Sequential, а получателю подан вес. Молча проигнорировать его
// значило бы оставить потребителя в уверенности, что вход прочитан; дефект
// назван на получателе.
test "вес при распределении по очередям — вход чужого режима" {
    given {

        assert "14-defect-foreign-input-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Sequential) { origin case_input; }
        assert "14-defect-foreign-input-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.00 KZT) { origin case_input; }
        assert "14-defect-foreign-input-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "14-defect-foreign-input-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 KZT) { origin case_input; }
        assert "14-defect-foreign-input-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "14-defect-foreign-input-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "14-defect-foreign-input-7": recipient_rank(entity_ref("urn:calc:allocation:test:r1"), 1) { origin case_input; }
        assert "14-defect-foreign-input-8": recipient_claim(entity_ref("urn:calc:allocation:test:r1"), 100.00 KZT) { origin case_input; }
        assert "14-defect-foreign-input-9": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
    }

    evaluate truth(recipient_defect(entity_ref("urn:calc:allocation:test:alloc"), entity_ref("urn:calc:allocation:test:r1"), ForeignInput));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
