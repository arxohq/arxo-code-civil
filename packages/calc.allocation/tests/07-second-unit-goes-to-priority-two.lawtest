language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Тот же мир, что в тесте 06: двух единиц остатка хватает на приоритеты 1 и
// 2. Получатель r2 берёт 17; r4 с нулевой дробной частью — ровно 50.
test "при двух единицах остатка вторую берёт второй по приоритету" {
    given {

        assert "07-second-unit-goes-to-priority-two-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100 EUR) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 0) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 1 EUR) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-8": recipient_priority(entity_ref("urn:calc:allocation:test:r1"), 1) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-9": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-10": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-11": recipient_priority(entity_ref("urn:calc:allocation:test:r2"), 2) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-12": recipient_of(entity_ref("urn:calc:allocation:test:r3"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-13": recipient_weight(entity_ref("urn:calc:allocation:test:r3"), 1.0) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-14": recipient_priority(entity_ref("urn:calc:allocation:test:r3"), 3) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-15": recipient_of(entity_ref("urn:calc:allocation:test:r4"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "07-second-unit-goes-to-priority-two-16": recipient_weight(entity_ref("urn:calc:allocation:test:r4"), 3.0) { origin case_input; }
    }

    evaluate truth(share_amount(entity_ref("urn:calc:allocation:test:alloc"), entity_ref("urn:calc:allocation:test:r2"), 17 EUR));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
