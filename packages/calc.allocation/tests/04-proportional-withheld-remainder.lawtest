language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Политика Withheld: те же три равных веса, каждый получает усечённые
// 33.33, а 0.01 никому не раздаётся и показан остатком распределения.
// Приоритеты здесь не нужны: раздачи нет — нет и равенства, которое надо
// разводить.
test "при удержании остатка доли остаются усечёнными, а остаток виден" {
    given {

        assert "04-proportional-withheld-remainder-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "04-proportional-withheld-remainder-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.00 EUR) { origin case_input; }
        assert "04-proportional-withheld-remainder-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "04-proportional-withheld-remainder-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 EUR) { origin case_input; }
        assert "04-proportional-withheld-remainder-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), Withheld) { origin case_input; }
        assert "04-proportional-withheld-remainder-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "04-proportional-withheld-remainder-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "04-proportional-withheld-remainder-8": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "04-proportional-withheld-remainder-9": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
        assert "04-proportional-withheld-remainder-10": recipient_of(entity_ref("urn:calc:allocation:test:r3"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "04-proportional-withheld-remainder-11": recipient_weight(entity_ref("urn:calc:allocation:test:r3"), 1.0) { origin case_input; }
    }

    evaluate truth(allocation_remainder(entity_ref("urn:calc:allocation:test:alloc"), 0.01 EUR));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
