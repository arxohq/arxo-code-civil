language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// 100 на веса 1 : 1 : 1 : 3 при точности 0. Точные доли 16.66…, 16.66…,
// 16.66…, 50; усечённые 16, 16, 16, 50 — сумма 98, остаток ДВЕ единицы.
// Трое с равной дробной частью разведены приоритетами 1, 2, 3: единицы
// берут r1 и r2, r3 остаётся с 16. У r4 дробная часть нулевая, его ранг 3,
// и единица ему не положена при любом числе единиц: остаток всегда меньше
// числа получателей с положительной дробной частью.
test "получатель с нулевой отброшенной частью единицы остатка не получает" {
    given {

        assert "06-zero-fraction-never-takes-a-unit-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100 EUR) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 0) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 1 EUR) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-8": recipient_priority(entity_ref("urn:calc:allocation:test:r1"), 1) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-9": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-10": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-11": recipient_priority(entity_ref("urn:calc:allocation:test:r2"), 2) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-12": recipient_of(entity_ref("urn:calc:allocation:test:r3"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-13": recipient_weight(entity_ref("urn:calc:allocation:test:r3"), 1.0) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-14": recipient_priority(entity_ref("urn:calc:allocation:test:r3"), 3) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-15": recipient_of(entity_ref("urn:calc:allocation:test:r4"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "06-zero-fraction-never-takes-a-unit-16": recipient_weight(entity_ref("urn:calc:allocation:test:r4"), 3.0) { origin case_input; }
    }

    evaluate truth(share_amount(entity_ref("urn:calc:allocation:test:alloc"), entity_ref("urn:calc:allocation:test:r3"), 16 EUR));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
