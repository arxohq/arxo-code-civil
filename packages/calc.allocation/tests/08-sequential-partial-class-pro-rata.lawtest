language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Форма пяти очередей исполнительного производства, сведённая к трём.
// Сумма 1000.00. Первая очередь (300 + 200) покрыта целиком. Второй (600 +
// 400 = 1000) остаётся 500 — ровно половина: r3 получает 300.00, r4 —
// 200.00, без остатка округления. Третьей очереди не остаётся ничего.
test "очередь, которой не хватило, делится пропорционально требованиям" {
    given {

        assert "08-sequential-partial-class-pro-rata-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Sequential) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 1000.00 KZT) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 KZT) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-7": recipient_rank(entity_ref("urn:calc:allocation:test:r1"), 1) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-8": recipient_claim(entity_ref("urn:calc:allocation:test:r1"), 300.00 KZT) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-9": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-10": recipient_rank(entity_ref("urn:calc:allocation:test:r2"), 1) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-11": recipient_claim(entity_ref("urn:calc:allocation:test:r2"), 200.00 KZT) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-12": recipient_of(entity_ref("urn:calc:allocation:test:r3"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-13": recipient_rank(entity_ref("urn:calc:allocation:test:r3"), 2) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-14": recipient_claim(entity_ref("urn:calc:allocation:test:r3"), 600.00 KZT) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-15": recipient_of(entity_ref("urn:calc:allocation:test:r4"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-16": recipient_rank(entity_ref("urn:calc:allocation:test:r4"), 2) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-17": recipient_claim(entity_ref("urn:calc:allocation:test:r4"), 400.00 KZT) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-18": recipient_of(entity_ref("urn:calc:allocation:test:r5"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-19": recipient_rank(entity_ref("urn:calc:allocation:test:r5"), 3) { origin case_input; }
        assert "08-sequential-partial-class-pro-rata-20": recipient_claim(entity_ref("urn:calc:allocation:test:r5"), 100.00 KZT) { origin case_input; }
    }

    evaluate truth(share_amount(entity_ref("urn:calc:allocation:test:alloc"), entity_ref("urn:calc:allocation:test:r3"), 300.00 KZT));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
