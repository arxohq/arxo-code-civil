language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Единственное требование 600.00 при сумме 1000.00: доля равна требованию,
// излишек 400.00 назван остатком распределения. Кому он возвращается —
// решает потребитель; пакет его не присваивает никому.
test "сумма сверх всех требований остаётся остатком распределения" {
    given {

        assert "11-sequential-surplus-is-remainder-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Sequential) { origin case_input; }
        assert "11-sequential-surplus-is-remainder-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 1000.00 KZT) { origin case_input; }
        assert "11-sequential-surplus-is-remainder-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "11-sequential-surplus-is-remainder-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 KZT) { origin case_input; }
        assert "11-sequential-surplus-is-remainder-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "11-sequential-surplus-is-remainder-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "11-sequential-surplus-is-remainder-7": recipient_rank(entity_ref("urn:calc:allocation:test:r1"), 1) { origin case_input; }
        assert "11-sequential-surplus-is-remainder-8": recipient_claim(entity_ref("urn:calc:allocation:test:r1"), 600.00 KZT) { origin case_input; }
    }

    evaluate truth(allocation_remainder(entity_ref("urn:calc:allocation:test:alloc"), 400.00 KZT));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
