language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Пара к тесту 02: раз доля не выведена ни у кого из троих, счёт долей не
// равен счёту получателей, и `allocation_settled` не выводится. Вердикт —
// NEITHER: не «распределение не завершено» как установленный факт, а
// «завершённость не выведена» — отрицательного продюсера у неё нет (§115).
test "неразрешённое равенство оставляет распределение незавершённым" {
    given {

        assert "03-unresolved-tie-blocks-settlement-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.00 EUR) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 EUR) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-8": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-9": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-10": recipient_of(entity_ref("urn:calc:allocation:test:r3"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "03-unresolved-tie-blocks-settlement-11": recipient_weight(entity_ref("urn:calc:allocation:test:r3"), 1.0) { origin case_input; }
    }

    evaluate truth(allocation_settled(entity_ref("urn:calc:allocation:test:alloc")));

    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
