language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Всё подано, кроме режима. Дефект выводится счётом, а не отрицанием:
// `not allocation_mode(a, m)` не сработал бы никогда (§115).
test "распределение без режима неприменимо" {
    given {

        assert "15-defect-mode-missing-1": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.00 EUR) { origin case_input; }
        assert "15-defect-mode-missing-2": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "15-defect-mode-missing-3": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 EUR) { origin case_input; }
        assert "15-defect-mode-missing-4": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "15-defect-mode-missing-5": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "15-defect-mode-missing-6": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
    }

    evaluate truth(allocation_defect(entity_ref("urn:calc:allocation:test:alloc"), ModeMissing));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
