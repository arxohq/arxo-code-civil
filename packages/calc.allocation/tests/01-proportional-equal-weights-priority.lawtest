language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// 100.00 на три равных веса: точные доли 33.333…, усечённые — 33.33 у каждого,
// остаток округления 0.01 — ОДНА единица. Отброшенные дробные части равны, и
// разводит их только приоритет: получатель r2 (приоритет 1) получает 33.34,
// r1 и r3 — по 33.33. Сумма долей — ровно 100.00; свойство ниже проверяет это
// на любом завершённом распределении мира.
test "три равных веса: единица остатка достаётся получателю с приоритетом 1" {
    given {
        context {
            decision_time @2026-09-04T12:00:00Z;
            knowledge_time @2026-09-04T12:00:00Z;
            legal_time @2026-09-04;
            timezone "UTC";
        }

        assert "01-proportional-equal-weights-priority-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "01-proportional-equal-weights-priority-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.00 EUR) { origin case_input; }
        assert "01-proportional-equal-weights-priority-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "01-proportional-equal-weights-priority-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 EUR) { origin case_input; }
        assert "01-proportional-equal-weights-priority-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "01-proportional-equal-weights-priority-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "01-proportional-equal-weights-priority-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "01-proportional-equal-weights-priority-8": recipient_priority(entity_ref("urn:calc:allocation:test:r1"), 2) { origin case_input; }
        assert "01-proportional-equal-weights-priority-9": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "01-proportional-equal-weights-priority-10": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
        assert "01-proportional-equal-weights-priority-11": recipient_priority(entity_ref("urn:calc:allocation:test:r2"), 1) { origin case_input; }
        assert "01-proportional-equal-weights-priority-12": recipient_of(entity_ref("urn:calc:allocation:test:r3"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "01-proportional-equal-weights-priority-13": recipient_weight(entity_ref("urn:calc:allocation:test:r3"), 1.0) { origin case_input; }
        assert "01-proportional-equal-weights-priority-14": recipient_priority(entity_ref("urn:calc:allocation:test:r3"), 3) { origin case_input; }
    }

    evaluate truth(share_amount(entity_ref("urn:calc:allocation:test:alloc"), entity_ref("urn:calc:allocation:test:r2"), 33.34 EUR));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}

// Свойство §270: у всякого завершённого распределения с раздачей остатка
// нераспределённого не остаётся. Домен — завершённые распределения мира,
// мощность 1: увидев 0, вердикт читать нельзя.
property SettledLargestRemainderLeavesNothing {
    forall x in collect a: Allocation where allocation_settled(a);
    expect allocation_remainder(x, 0.00 EUR);
}
