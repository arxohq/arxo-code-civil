language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// Мир теста 13 (единица не наименьшая): годности нет, фондов очередей нет,
// долей нет, завершённость не выведена. NEITHER, а не FALSE_ONLY: у
// завершённости нет отрицательного продюсера.
test "при дефекте входа распределение не выводится" {
    given {

        assert "16-defect-withholds-settlement-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "16-defect-withholds-settlement-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.00 EUR) { origin case_input; }
        assert "16-defect-withholds-settlement-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "16-defect-withholds-settlement-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.02 EUR) { origin case_input; }
        assert "16-defect-withholds-settlement-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "16-defect-withholds-settlement-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "16-defect-withholds-settlement-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "16-defect-withholds-settlement-8": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "16-defect-withholds-settlement-9": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
    }

    evaluate truth(allocation_settled(entity_ref("urn:calc:allocation:test:alloc")));

    expect result_kind == PROPOSITION;
    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
