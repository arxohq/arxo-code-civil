language "law.core" version "0.2";
package calc.allocation version "0.1.0";
namespace "urn:law:calc:allocation";

// 100.005 при точности 2: остаток округления не был бы целым числом
// единиц, и раздача по единице оставила бы неназванный хвост. Дефект
// назван до всякого счёта.
test "сумма со знаками ниже точности не распределяется" {
    given {

        assert "17-defect-total-not-representable-1": allocation_mode(entity_ref("urn:calc:allocation:test:alloc"), Proportional) { origin case_input; }
        assert "17-defect-total-not-representable-2": allocation_total(entity_ref("urn:calc:allocation:test:alloc"), 100.005 EUR) { origin case_input; }
        assert "17-defect-total-not-representable-3": allocation_precision(entity_ref("urn:calc:allocation:test:alloc"), 2) { origin case_input; }
        assert "17-defect-total-not-representable-4": allocation_unit(entity_ref("urn:calc:allocation:test:alloc"), 0.01 EUR) { origin case_input; }
        assert "17-defect-total-not-representable-5": allocation_remainder_policy(entity_ref("urn:calc:allocation:test:alloc"), LargestRemainder) { origin case_input; }
        assert "17-defect-total-not-representable-6": recipient_of(entity_ref("urn:calc:allocation:test:r1"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "17-defect-total-not-representable-7": recipient_weight(entity_ref("urn:calc:allocation:test:r1"), 1.0) { origin case_input; }
        assert "17-defect-total-not-representable-8": recipient_of(entity_ref("urn:calc:allocation:test:r2"), entity_ref("urn:calc:allocation:test:alloc")) { origin case_input; }
        assert "17-defect-total-not-representable-9": recipient_weight(entity_ref("urn:calc:allocation:test:r2"), 1.0) { origin case_input; }
    }

    evaluate truth(allocation_defect(entity_ref("urn:calc:allocation:test:alloc"), TotalNotRepresentable));

    expect result_kind == PROPOSITION;
    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
}
