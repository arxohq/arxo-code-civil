language "law.core" version "0.2"; package fr.code_civil.regimes_matrimoniaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-regimes-matrimoniaux";
test "CC11-A01-donation-sans-consentement" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "n": nature_de_l_acte(entity_ref("urn:cc11:a1"), DonationEntreVifs) { origin case_input; } } evaluate truth(acte_outrepasse_les_pouvoirs(entity_ref("urn:cc11:a1"))); expect evaluation_status == COMPUTED; expect truth_status == TRUE_ONLY; expect applied(ConsentementDonation); }
