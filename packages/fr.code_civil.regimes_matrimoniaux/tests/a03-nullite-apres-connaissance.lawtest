language "law.core" version "0.2"; package fr.code_civil.regimes_matrimoniaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-regimes-matrimoniaux";
test "CC11-A03-nullite-apres-deux-ans-depuis-connaissance" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; deadline_policy CC_REGIMES_AN; } assert "n": nature_de_l_acte(entity_ref("urn:cc11:a3"), AlienationOuDroitReel) { origin case_input; } assert "au": acte_de_l_union(entity_ref("urn:cc11:u4"), entity_ref("urn:cc11:a3")) { origin case_input; } assert "k": connaissance_de_l_acte_le(entity_ref("urn:cc11:a3"), @2021-06-01) { origin case_input; } assert "d": evenement_de_dissolution(entity_ref("urn:cc11:u4"), Divorce, @2024-01-01) { origin case_input; } assert "f": action_en_nullite_introduite_le(entity_ref("urn:cc11:a3"), @2023-06-02) { origin case_input; } } evaluate truth(action_en_nullite_recevable(entity_ref("urn:cc11:a3"))); expect evaluation_status == COMPUTED; expect truth_status == NEITHER; }
