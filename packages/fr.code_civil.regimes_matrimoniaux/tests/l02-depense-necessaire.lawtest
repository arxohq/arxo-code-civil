language "law.core" version "0.2"; package fr.code_civil.regimes_matrimoniaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-regimes-matrimoniaux";
test "CC11-L02-depense-necessaire-plancher-depense" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } assert "d": depense_faite(entity_ref("urn:cc11:on"), 300 EUR) { origin case_input; } assert "p": profit_subsistant(entity_ref("urn:cc11:on"), 100 EUR) { origin case_input; } assert "n": depense_necessaire(entity_ref("urn:cc11:on")) { origin case_input; } } evaluate truth(montant_de_recompense(entity_ref("urn:cc11:on"), 300 EUR)); expect evaluation_status == COMPUTED; expect truth_status == TRUE_ONLY; expect applied(MontantDepenseNecessaire); }
