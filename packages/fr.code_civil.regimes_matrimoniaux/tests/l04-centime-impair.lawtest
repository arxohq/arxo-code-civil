language "law.core" version "0.2"; package fr.code_civil.regimes_matrimoniaux version "0.1.0"; namespace "urn:fr:corpus:clir:code-civil-regimes-matrimoniaux";
test "CC11-L04-centime-impair-demi-exacte" { given { context { legal_time @2026-09-16; decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; timezone "Europe/Paris"; } } evaluate 100.01 EUR * (1 / 2); expect result_kind == DATA; expect value == 50.005 EUR; }
