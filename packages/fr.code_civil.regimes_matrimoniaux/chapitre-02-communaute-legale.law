// CHAPITRE II — DU RÉGIME EN COMMUNAUTÉ (articles 1400 à 1491).
// Layers: qualification -> debts -> powers -> dissolution -> rewards ->
// balances -> withdrawals -> equal division. Aggregates are only read by the
// next layer and use `collect all` with the operation as the second binder.

language "law.core" version "0.2";
package fr.code_civil.regimes_matrimoniaux version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-regimes-matrimoniaux";

use self::{
    ActePatrimonial,
    Bien,
    CC_ART1400,
    CC_ART1401,
    CC_ART1402,
    CC_ART1403,
    CC_ART1404,
    CC_ART1405,
    CC_ART1406,
