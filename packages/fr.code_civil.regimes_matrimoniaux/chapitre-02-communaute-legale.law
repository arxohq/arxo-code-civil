    acquis_en_echange_d_un_propre,
    acquis_par_succession_donation_ou_legs,
    acquis_pendant_le_mariage,
    acte_de_l_union,
    action_en_nullite_introduite_le,
    auteur_de_l_acte,
    bien_de_l_union,
    bien_disponible_pour_prelevement,
    bien_retrouve_dans_le_patrimoine_emprunteur,
