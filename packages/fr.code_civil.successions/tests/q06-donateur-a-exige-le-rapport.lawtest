language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 846 : le donateur a expressément exigé le rapport.
test "urn:query:fr-code-civil-successions-q06-donateur-a-exige-le-rapport" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:par:q06:S"), entity_ref("urn:fr:cc:successions:par:q06:H"), entity_ref("urn:fr:cc:successions:par:q06:L"), DonationEnAvancementDePartSuccessorale) { origin case_input; }
        assert "f2": donataire_non_heritier_presomptif(entity_ref("urn:fr:cc:successions:par:q06:S"), entity_ref("urn:fr:cc:successions:par:q06:L")) { origin case_input; }
        assert "f3": rapport_expressement_exige(entity_ref("urn:fr:cc:successions:par:q06:S"), entity_ref("urn:fr:cc:successions:par:q06:L")) { origin case_input; }
    }
    evaluate truth(rapport_du(entity_ref("urn:fr:cc:successions:par:q06:S"), entity_ref("urn:fr:cc:successions:par:q06:H"), entity_ref("urn:fr:cc:successions:par:q06:L")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RapportDeLaDonationEnAvancementDePart);
}
