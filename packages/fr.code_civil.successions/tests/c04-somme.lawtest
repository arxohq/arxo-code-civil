language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Garde : 1/4 + 1/4 + 1/4 + 1/4 = 1.
test "urn:query:fr-code-civil-successions-c04-somme" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:c:S"), entity_ref("urn:fr:cc:successions:c:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:c:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:c:S"), entity_ref("urn:fr:cc:successions:c:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:c:F"), entity_ref("urn:fr:cc:successions:c:P"), entity_ref("urn:fr:cc:successions:c:D")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:c:F"), entity_ref("urn:fr:cc:successions:c:M"), entity_ref("urn:fr:cc:successions:c:D")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:c:F"), entity_ref("urn:fr:cc:successions:c:P"), entity_ref("urn:fr:cc:successions:c:B1")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:c:F"), entity_ref("urn:fr:cc:successions:c:M"), entity_ref("urn:fr:cc:successions:c:B1")) { origin case_input; }
        assert "f8": filiation(entity_ref("urn:fr:cc:successions:c:F"), entity_ref("urn:fr:cc:successions:c:P"), entity_ref("urn:fr:cc:successions:c:B2")) { origin case_input; }
        assert "f9": filiation(entity_ref("urn:fr:cc:successions:c:F"), entity_ref("urn:fr:cc:successions:c:M"), entity_ref("urn:fr:cc:successions:c:B2")) { origin case_input; }
        assert "f10": filiation(entity_ref("urn:fr:cc:successions:c:F"), entity_ref("urn:fr:cc:successions:c:B2"), entity_ref("urn:fr:cc:successions:c:N1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:c:S"), entity_ref("urn:fr:cc:successions:c:P")) { origin case_input; }
        assert "f12": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:c:S"), entity_ref("urn:fr:cc:successions:c:M")) { origin case_input; }
        assert "f13": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:c:S"), entity_ref("urn:fr:cc:successions:c:B1")) { origin case_input; }
        assert "f14": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:c:S"), entity_ref("urn:fr:cc:successions:c:N1")) { origin case_input; }
        assert "f15": predecede(entity_ref("urn:fr:cc:successions:c:S"), entity_ref("urn:fr:cc:successions:c:B2")) { origin case_input; }
    }
    evaluate truth(succession_entierement_devolue(entity_ref("urn:fr:cc:successions:c:S"), ));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
