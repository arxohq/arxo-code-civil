language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 790 : déclaration le 31 décembre 2025 — inventaire à déposer au plus tard le 28 février 2026.
test "urn:query:fr-code-civil-successions-o23-deux-mois-pour-l-inventaire" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": option_exercee_le(entity_ref("urn:fr:cc:successions:opt:o23:S"), entity_ref("urn:fr:cc:successions:opt:o23:H"), AcceptationAConcurrenceDeLActifNet, @2025-12-31) { origin case_input; }
    }
    evaluate truth(fin_du_delai_d_inventaire(entity_ref("urn:fr:cc:successions:opt:o23:S"), entity_ref("urn:fr:cc:successions:opt:o23:H"), @2026-02-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DeuxMoisPourLInventaire);
}
