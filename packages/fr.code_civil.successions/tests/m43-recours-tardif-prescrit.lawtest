language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-9, alinéa 2 : recours le 1er mars 2026 — prescrit.
test "urn:query:fr-code-civil-successions-m43-recours-tardif-prescrit" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": realisation_de_l_actif_subsistant_le(entity_ref("urn:fr:cc:successions:adm:m43:S"), @2024-02-29) { origin case_input; }
        assert "f2": recours_contre_les_legataires_le(entity_ref("urn:fr:cc:successions:adm:m43:S"), entity_ref("urn:fr:cc:successions:adm:m43:P"), @2026-03-01) { origin case_input; }
    }
    evaluate truth(recours_contre_les_legataires_prescrit(entity_ref("urn:fr:cc:successions:adm:m43:S"), entity_ref("urn:fr:cc:successions:adm:m43:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RecoursTardifPrescrit);
}
