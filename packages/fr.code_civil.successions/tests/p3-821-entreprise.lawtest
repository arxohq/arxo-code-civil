language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

test "urn:query:p3-821-entreprise-a" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": maintien_entreprise_admissible(entity_ref("urn:p3:821:a:i"), entity_ref("urn:p3:821:a:p")) { origin case_input; }
    }
    evaluate positions();
    expect position(P3PositionPouvoirDemanderMaintienEntreprise, ACTIVE);
}

test "urn:query:p3-821-entreprise-b" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": maintien_entreprise_admissible(entity_ref("urn:p3:821:b:i"), entity_ref("urn:p3:821:b:p")) { origin case_input; }
    }
    evaluate positions();
    expect position(P3PositionPouvoirDemanderMaintienEntreprise, ACTIVE);
}
