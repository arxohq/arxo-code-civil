language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 801, alinéa 2 : l'acceptation à concurrence de l'actif net empêche la renonciation.
test "urn:query:fr-code-civil-successions-o26-actif-net-empeche-la-renonciation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": option_exercee_le(entity_ref("urn:fr:cc:successions:opt:o26:S"), entity_ref("urn:fr:cc:successions:opt:o26:H"), AcceptationAConcurrenceDeLActifNet, @2025-12-31) { origin case_input; }
    }
    evaluate truth(renonciation_impossible(entity_ref("urn:fr:cc:successions:opt:o26:S"), entity_ref("urn:fr:cc:successions:opt:o26:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ActifNetEmpecheLaRenonciation);
}
