language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-14, alinéa 2 : préemption notifiée le 1er mars 2026, hors du mois.
test "urn:query:fr-code-civil-successions-i20-preemption-le-lendemain" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": notification_de_la_cession_le(entity_ref("urn:fr:cc:successions:ind:i20:I"), entity_ref("urn:fr:cc:successions:ind:i20:cedant"), @2026-01-31) { origin case_input; }
        assert "f2": preemption_notifiee_le(entity_ref("urn:fr:cc:successions:ind:i20:I"), entity_ref("urn:fr:cc:successions:ind:i20:p"), @2026-03-01) { origin case_input; }
    }
    evaluate truth(preemption_exercee_a_temps(entity_ref("urn:fr:cc:successions:ind:i20:I"), entity_ref("urn:fr:cc:successions:ind:i20:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
