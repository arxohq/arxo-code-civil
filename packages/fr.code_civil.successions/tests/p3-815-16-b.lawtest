language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-815-16-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": cession_sans_notification(entity_ref("urn:p3:81516:81516b:i")) { origin case_input; }
  assert "f2": action_en_nullite_de_la_cession_le(entity_ref("urn:p3:81516:81516b:i"), @2026-01-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderNulliteCession, ACTIVE); }
