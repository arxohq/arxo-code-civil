language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 809-1 : un tiers sans qualité ne saisit pas le juge.
test "urn:query:fr-code-civil-successions-m08-requete-d-un-tiers-sans-qualite" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": requete_presentee_par(entity_ref("urn:fr:cc:successions:adm:m08:S"), entity_ref("urn:fr:cc:successions:adm:m08:P"), TiersSansQualite) { origin case_input; }
    }
    evaluate truth(requete_recevable(entity_ref("urn:fr:cc:successions:adm:m08:S"), entity_ref("urn:fr:cc:successions:adm:m08:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
