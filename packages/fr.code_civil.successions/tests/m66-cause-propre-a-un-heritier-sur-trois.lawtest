language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 812-4, dernier alinéa : le décès d'un héritier sur trois ne met pas fin au mandat.
test "urn:query:fr-code-civil-successions-m66-cause-propre-a-un-heritier-sur-trois" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": mandat_de_la_succession(entity_ref("urn:fr:cc:successions:adm:m66:M"), entity_ref("urn:fr:cc:successions:adm:m66:S")) { origin case_input; }
        assert "f2": mandataire_jouit_de_la_pleine_capacite_civile(entity_ref("urn:fr:cc:successions:adm:m66:M")) { origin case_input; }
        assert "f3": mandat_donne_le(entity_ref("urn:fr:cc:successions:adm:m66:M"), @2024-01-15) { origin case_input; }
        assert "f4": cause_de_fin_du_mandat(entity_ref("urn:fr:cc:successions:adm:m66:M"), DecesDeLHeritierInteresse) { origin case_input; }
        assert "f5": nombre_d_heritiers_vises(entity_ref("urn:fr:cc:successions:adm:m66:M"), 3) { origin case_input; }
        assert "f6": cause_propre_a_un_seul_heritier(entity_ref("urn:fr:cc:successions:adm:m66:M"), entity_ref("urn:fr:cc:successions:adm:m66:P")) { origin case_input; }
    }
    evaluate truth(mandat_termine(entity_ref("urn:fr:cc:successions:adm:m66:M")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
