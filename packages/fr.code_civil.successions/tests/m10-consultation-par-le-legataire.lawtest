language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 809-2, alinéa 3 : le légataire de somme d'argent justifie de son titre.
test "urn:query:fr-code-civil-successions-m10-consultation-par-le-legataire" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": inventaire_estimatif_dresse(entity_ref("urn:fr:cc:successions:adm:m10:S")) { origin case_input; }
        assert "f2": titre_justifie(entity_ref("urn:fr:cc:successions:adm:m10:S"), entity_ref("urn:fr:cc:successions:adm:m10:P")) { origin case_input; }
        assert "f3": qualite_du_creancier(entity_ref("urn:fr:cc:successions:adm:m10:S"), entity_ref("urn:fr:cc:successions:adm:m10:P"), LegataireDeSommeDArgent) { origin case_input; }
    }
    evaluate truth(consultation_de_l_inventaire_ouverte(entity_ref("urn:fr:cc:successions:adm:m10:S"), entity_ref("urn:fr:cc:successions:adm:m10:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ConsultationParLeLegataireDeSommeDArgent);
}
