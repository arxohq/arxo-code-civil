language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-9, alinéa 2 : recours le 28 février 2026 — encore dans le délai.
test "urn:query:fr-code-civil-successions-m44-recours-le-dernier-jour" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": realisation_de_l_actif_subsistant_le(entity_ref("urn:fr:cc:successions:adm:m44:S"), @2024-02-29) { origin case_input; }
        assert "f2": recours_contre_les_legataires_le(entity_ref("urn:fr:cc:successions:adm:m44:S"), entity_ref("urn:fr:cc:successions:adm:m44:P"), @2026-02-28) { origin case_input; }
    }
    evaluate truth(recours_contre_les_legataires_prescrit(entity_ref("urn:fr:cc:successions:adm:m44:S"), entity_ref("urn:fr:cc:successions:adm:m44:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
