language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 763 : décès le 31 mars 2026 — jouissance gratuite jusqu'au 31 mars 2027.
test "urn:query:fr-code-civil-successions-c09-une-annee-de-jouissance-gratuite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:cj:c09:S"), entity_ref("urn:fr:cc:successions:cj:c09:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:cj:c09:S"), @2026-03-31) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:cj:c09:S"), entity_ref("urn:fr:cc:successions:cj:c09:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:cj:c09:F"), entity_ref("urn:fr:cc:successions:cj:c09:D"), entity_ref("urn:fr:cc:successions:cj:c09:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:cj:c09:F"), entity_ref("urn:fr:cc:successions:cj:c09:E"), entity_ref("urn:fr:cc:successions:cj:c09:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:cj:c09:F"), entity_ref("urn:fr:cc:successions:cj:c09:D"), entity_ref("urn:fr:cc:successions:cj:c09:C2")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:cj:c09:F"), entity_ref("urn:fr:cc:successions:cj:c09:E"), entity_ref("urn:fr:cc:successions:cj:c09:C2")) { origin case_input; }
        assert "f8": mariage(entity_ref("urn:fr:cc:successions:cj:c09:F"), entity_ref("urn:fr:cc:successions:cj:c09:D"), entity_ref("urn:fr:cc:successions:cj:c09:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c09:S"), entity_ref("urn:fr:cc:successions:cj:c09:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c09:S"), entity_ref("urn:fr:cc:successions:cj:c09:C1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c09:S"), entity_ref("urn:fr:cc:successions:cj:c09:C2")) { origin case_input; }
        assert "f12": occupait_le_logement_a_titre_principal(entity_ref("urn:fr:cc:successions:cj:c09:S"), entity_ref("urn:fr:cc:successions:cj:c09:E")) { origin case_input; }
        assert "f13": logement_des_epoux_ou_de_la_succession(entity_ref("urn:fr:cc:successions:cj:c09:S")) { origin case_input; }
    }
    evaluate truth(jouissance_gratuite_du_logement_jusqu_au(entity_ref("urn:fr:cc:successions:cj:c09:S"), entity_ref("urn:fr:cc:successions:cj:c09:E"), @2027-03-31));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(UneAnneeDeJouissanceGratuite);
}
