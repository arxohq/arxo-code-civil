language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-8 : la réalisation ne peut avoir lieu qu'à l'expiration du délai.
test "urn:query:fr-code-civil-successions-m39-realisation-prematuree" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": notification_du_projet_de_realisation_le(entity_ref("urn:fr:cc:successions:adm:m39:S"), entity_ref("urn:fr:cc:successions:adm:m39:P"), @2026-06-15) { origin case_input; }
        assert "f2": realisation_de_l_actif_subsistant_le(entity_ref("urn:fr:cc:successions:adm:m39:S"), @2026-09-15) { origin case_input; }
    }
    evaluate truth(realisation_prematuree(entity_ref("urn:fr:cc:successions:adm:m39:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RealisationAvantLExpirationDuDelai);
}
