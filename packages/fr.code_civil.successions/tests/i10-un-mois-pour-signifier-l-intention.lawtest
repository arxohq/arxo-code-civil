language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-5-1, alinéa 3 : intention recueillie le 31 janvier 2026 — signification jusqu'au 28 février 2026.
test "urn:query:fr-code-civil-successions-i10-un-mois-pour-signifier-l-intention" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": intention_d_aliener_recueillie_le(entity_ref("urn:fr:cc:successions:ind:i10:I"), @2026-01-31) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_signification(entity_ref("urn:fr:cc:successions:ind:i10:I"), @2026-02-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(UnMoisPourSignifier);
}
