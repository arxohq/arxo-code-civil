test "urn:query:p3-796-passif-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": heritier_regleur(entity_ref("urn:p3:796:a:s"), entity_ref("urn:p3:796:a:h")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirReglerPassifSuccession, ACTIVE); }
