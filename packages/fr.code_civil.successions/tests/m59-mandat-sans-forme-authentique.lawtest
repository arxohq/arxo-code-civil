language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 812-1-1, alinéa 3 : le mandat est donné et accepté en la forme authentique.
test "urn:query:fr-code-civil-successions-m59-mandat-sans-forme-authentique" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": mandat_de_la_succession(entity_ref("urn:fr:cc:successions:adm:m59:M"), entity_ref("urn:fr:cc:successions:adm:m59:S")) { origin case_input; }
        assert "f2": mandataire_jouit_de_la_pleine_capacite_civile(entity_ref("urn:fr:cc:successions:adm:m59:M")) { origin case_input; }
        assert "f3": mandat_donne_le(entity_ref("urn:fr:cc:successions:adm:m59:M"), @2024-01-15) { origin case_input; }
        assert "f4": terme_prevu_le(entity_ref("urn:fr:cc:successions:adm:m59:M"), @2026-01-15) { origin case_input; }
        assert "f5": interet_serieux_et_legitime(entity_ref("urn:fr:cc:successions:adm:m59:M")) { origin adjudicated; }
        assert "f6": accepte_avant_le_deces_du_mandant(entity_ref("urn:fr:cc:successions:adm:m59:M")) { origin case_input; }
    }
    evaluate truth(mandat_non_valable(entity_ref("urn:fr:cc:successions:adm:m59:M")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(MandatNonValableFauteDeFormeAuthentique);
}
