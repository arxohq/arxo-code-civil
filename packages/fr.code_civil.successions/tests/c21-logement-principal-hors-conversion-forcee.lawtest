language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 760, alinéa 3 : le conjoint usufruitier refuse la conversion de son logement principal.
test "urn:query:fr-code-civil-successions-c21-logement-principal-hors-conversion-forcee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:cj:c21:S"), @2026-03-31) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:cj:c21:F"), entity_ref("urn:fr:cc:successions:cj:c21:D"), entity_ref("urn:fr:cc:successions:cj:c21:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:cj:c21:F"), entity_ref("urn:fr:cc:successions:cj:c21:E"), entity_ref("urn:fr:cc:successions:cj:c21:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:cj:c21:F"), entity_ref("urn:fr:cc:successions:cj:c21:D"), entity_ref("urn:fr:cc:successions:cj:c21:C2")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:cj:c21:F"), entity_ref("urn:fr:cc:successions:cj:c21:E"), entity_ref("urn:fr:cc:successions:cj:c21:C2")) { origin case_input; }
        assert "f8": mariage(entity_ref("urn:fr:cc:successions:cj:c21:F"), entity_ref("urn:fr:cc:successions:cj:c21:D"), entity_ref("urn:fr:cc:successions:cj:c21:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:C1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:C2")) { origin case_input; }
        assert "f12": conjoint_decede_sans_opter(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:E")) { origin case_input; }
        assert "f13": occupait_le_logement_a_titre_principal(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:E")) { origin case_input; }
        assert "f14": conversion_du_logement_refusee_par_le_conjoint(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:E")) { origin case_input; }
    }
    evaluate truth(conversion_du_logement_exclue(entity_ref("urn:fr:cc:successions:cj:c21:S"), entity_ref("urn:fr:cc:successions:cj:c21:E")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(LogementPrincipalHorsConversionForcee);
}
