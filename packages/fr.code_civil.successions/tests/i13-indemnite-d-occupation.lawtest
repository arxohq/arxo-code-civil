language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-9, alinéa 2 : l'indivisaire occupe seul la maison indivise.
test "urn:query:fr-code-civil-successions-i13-indemnite-d-occupation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": usage_privatif(entity_ref("urn:fr:cc:successions:ind:i13:I"), entity_ref("urn:fr:cc:successions:ind:i13:p")) { origin case_input; }
    }
    evaluate truth(indemnite_d_occupation_due(entity_ref("urn:fr:cc:successions:ind:i13:I"), entity_ref("urn:fr:cc:successions:ind:i13:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(IndemniteDOccupation);
}
