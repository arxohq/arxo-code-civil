language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-813-9-devoir-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": mission_du_mandataire_successoral_terminee(entity_ref("urn:p3:813-9:d:a:s")) { origin case_input; }
  assert "f2": mandataire_successoral(entity_ref("urn:p3:813-9:d:a:s"), entity_ref("urn:p3:813-9:d:a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirCesserActesApresFinMission, ACTIVE); }
test "urn:query:p3-813-9-devoir-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": mission_du_mandataire_successoral_terminee(entity_ref("urn:p3:813-9:d:b:s")) { origin case_input; }
  assert "f2": mandataire_successoral(entity_ref("urn:p3:813-9:d:b:s"), entity_ref("urn:p3:813-9:d:b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirCesserActesApresFinMission, ACTIVE); }
