language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-3 : projet à 120 000 EUR, adjudication à 95 000 EUR — perte de 25 000 EUR.
test "urn:query:fr-code-civil-successions-m21-perte-a-la-charge-du-demandeur" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": adjudication_exigee_par(entity_ref("urn:fr:cc:successions:adm:m21:S"), entity_ref("urn:fr:cc:successions:adm:m21:P")) { origin case_input; }
        assert "f2": prix_convenu_dans_le_projet(entity_ref("urn:fr:cc:successions:adm:m21:S"), 120000.00 EUR) { origin case_input; }
        assert "f3": prix_de_l_adjudication(entity_ref("urn:fr:cc:successions:adm:m21:S"), 95000.00 EUR) { origin case_input; }
    }
    evaluate truth(perte_supportee_par_le_creancier(entity_ref("urn:fr:cc:successions:adm:m21:S"), entity_ref("urn:fr:cc:successions:adm:m21:P"), 25000.00 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PerteALaChargeDuDemandeurDeLAdjudication);
}
