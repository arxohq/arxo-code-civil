language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

test "urn:query:fr-code-civil-successions-p3-864-a" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": creance_de_la_masse_contre(entity_ref("urn:fr:cc:successions:p3-864-a:S"), entity_ref("urn:fr:cc:successions:p3-864-a:H"), 50000 EUR) { origin case_input; }
        assert "f2": droits_dans_la_masse(entity_ref("urn:fr:cc:successions:p3-864-a:S"), entity_ref("urn:fr:cc:successions:p3-864-a:H"), 30000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(P3DevoirAllotirDette864Actif, ACTIVE);
}

test "urn:query:fr-code-civil-successions-p3-864-b" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": creance_de_la_masse_contre(entity_ref("urn:fr:cc:successions:p3-864-b:S"), entity_ref("urn:fr:cc:successions:p3-864-b:H"), 12000 EUR) { origin case_input; }
        assert "f2": droits_dans_la_masse(entity_ref("urn:fr:cc:successions:p3-864-b:S"), entity_ref("urn:fr:cc:successions:p3-864-b:H"), 12000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(P3DevoirAllotirDette864Actif, ACTIVE);
}
