language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-813-9-interdiction-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": mission_du_mandataire_successoral_terminee(entity_ref("urn:p3:813-9:a:s")) { origin case_input; }
  assert "f2": mandataire_successoral(entity_ref("urn:p3:813-9:a:s"), entity_ref("urn:p3:813-9:a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionActeApresFinMission, ACTIVE); }
test "urn:query:p3-813-9-interdiction-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": mission_du_mandataire_successoral_terminee(entity_ref("urn:p3:813-9:b:s")) { origin case_input; }
  assert "f2": mandataire_successoral(entity_ref("urn:p3:813-9:b:s"), entity_ref("urn:p3:813-9:b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionActeApresFinMission, ACTIVE); }
