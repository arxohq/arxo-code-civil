language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-4, alinéa 2 : toute autre dette attend le projet de règlement.
test "urn:query:fr-code-civil-successions-m26-autre-dette-subordonnee-au-projet" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": dette_a_payer(entity_ref("urn:fr:cc:successions:adm:m26:S"), AutreDetteSuccessorale) { origin case_input; }
    }
    evaluate truth(paiement_subordonne_au_projet(entity_ref("urn:fr:cc:successions:adm:m26:S"), AutreDetteSuccessorale));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(AutreDetteSubordonneeAuProjet);
}
