language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 809, 3° : appréciation le 30 septembre 2024 — le délai n'est pas expiré.
test "urn:query:fr-code-civil-successions-m06-le-dernier-jour-des-six-mois-ne-suffit-pas" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:adm:m06:S"), @2024-03-31) { origin case_input; }
        assert "f2": date_d_appreciation_de_la_curatelle(entity_ref("urn:fr:cc:successions:adm:m06:S"), @2024-09-30) { origin case_input; }
        assert "f3": aucune_option_des_heritiers_connus_constatee(entity_ref("urn:fr:cc:successions:adm:m06:S")) { origin adjudicated; }
    }
    evaluate truth(succession_vacante(entity_ref("urn:fr:cc:successions:adm:m06:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
