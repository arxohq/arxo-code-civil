language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 728 : maintenu dans ses droits par déclaration testamentaire, C1 n est pas exclu : 1/2.
test "urn:query:fr-code-civil-successions-f03-pardon-du-defunt" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:f2:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:f2:F"), entity_ref("urn:fr:cc:successions:f2:D"), entity_ref("urn:fr:cc:successions:f2:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:f2:F"), entity_ref("urn:fr:cc:successions:f2:D"), entity_ref("urn:fr:cc:successions:f2:C2")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:f2:F"), entity_ref("urn:fr:cc:successions:f2:C1"), entity_ref("urn:fr:cc:successions:f2:G")) { origin case_input; }
        assert "f7": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:C1")) { origin case_input; }
        assert "f8": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:C2")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:G")) { origin case_input; }
        assert "j1": condamne_peine_criminelle_mort_volontaire(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:C1")) { origin adjudicated; }
        assert "j2": maintenu_par_declaration_testamentaire(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:C1")) { origin adjudicated; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:f2:S"), entity_ref("urn:fr:cc:successions:f2:C1"), 1 / 2));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CapableDeSucceder);
}
