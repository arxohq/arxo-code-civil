language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

test "urn:query:fr-code-civil-successions-p3-889-a" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": part_effectivement_recue(entity_ref("urn:fr:cc:successions:p3-889-a:S"), entity_ref("urn:fr:cc:successions:p3-889-a:H"), 74000 EUR) { origin case_input; }
        assert "f2": droits_dans_la_masse(entity_ref("urn:fr:cc:successions:p3-889-a:S"), entity_ref("urn:fr:cc:successions:p3-889-a:H"), 100000 EUR) { origin case_input; }
        assert "f3": complement_de_part_du(entity_ref("urn:fr:cc:successions:p3-889-a:S"), entity_ref("urn:fr:cc:successions:p3-889-a:H")) { origin case_input; }
    }
    evaluate positions();
    expect position(P3PouvoirExercerComplementPart889Actif, ACTIVE);
}

test "urn:query:fr-code-civil-successions-p3-889-b" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": part_effectivement_recue(entity_ref("urn:fr:cc:successions:p3-889-b:S"), entity_ref("urn:fr:cc:successions:p3-889-b:H"), 70000 EUR) { origin case_input; }
        assert "f2": droits_dans_la_masse(entity_ref("urn:fr:cc:successions:p3-889-b:S"), entity_ref("urn:fr:cc:successions:p3-889-b:H"), 100000 EUR) { origin case_input; }
        assert "f3": complement_de_part_du(entity_ref("urn:fr:cc:successions:p3-889-b:S"), entity_ref("urn:fr:cc:successions:p3-889-b:H")) { origin case_input; }
    }
    evaluate positions();
    expect position(P3PouvoirExercerComplementPart889Actif, ACTIVE);
}
