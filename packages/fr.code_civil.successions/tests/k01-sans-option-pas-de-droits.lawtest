language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 757 : sans option enregistrée, les droits du conjoint ne sont pas établis (758-3/758-4 : vague B4).
test "urn:query:fr-code-civil-successions-k01-sans-option-pas-de-droits" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:k:S"), entity_ref("urn:fr:cc:successions:k:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:k:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:k:S"), entity_ref("urn:fr:cc:successions:k:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:k:F"), entity_ref("urn:fr:cc:successions:k:D"), entity_ref("urn:fr:cc:successions:k:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:k:F"), entity_ref("urn:fr:cc:successions:k:E"), entity_ref("urn:fr:cc:successions:k:C1")) { origin case_input; }
        assert "f6": mariage(entity_ref("urn:fr:cc:successions:k:F"), entity_ref("urn:fr:cc:successions:k:D"), entity_ref("urn:fr:cc:successions:k:E")) { origin case_input; }
        assert "f7": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:k:S"), entity_ref("urn:fr:cc:successions:k:E")) { origin case_input; }
        assert "f8": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:k:S"), entity_ref("urn:fr:cc:successions:k:C1")) { origin case_input; }
    }
    evaluate truth(droits_du_conjoint(entity_ref("urn:fr:cc:successions:k:S"), entity_ref("urn:fr:cc:successions:k:E"), QuartEnPropriete));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
