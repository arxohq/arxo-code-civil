language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-5-1, alinéa 4 : signification le 15 mars 2026 — opposition jusqu'au 15 juin 2026.
test "urn:query:fr-code-civil-successions-i11-trois-mois-d-opposition" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": signification_aux_autres_le(entity_ref("urn:fr:cc:successions:ind:i11:I"), @2026-03-15) { origin case_input; }
    }
    evaluate truth(fin_du_delai_d_opposition(entity_ref("urn:fr:cc:successions:ind:i11:I"), @2026-06-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(TroisMoisDOpposition);
}
