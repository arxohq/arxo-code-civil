language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-15 : substitution déclarée le 30 juin 2026.
test "urn:query:fr-code-civil-successions-i25-substitution-le-dernier-jour" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": adjudication_le(entity_ref("urn:fr:cc:successions:ind:i25:I"), @2026-05-31) { origin case_input; }
        assert "f2": substitution_declaree_le(entity_ref("urn:fr:cc:successions:ind:i25:I"), entity_ref("urn:fr:cc:successions:ind:i25:p"), @2026-06-30) { origin case_input; }
    }
    evaluate truth(substitution_recevable(entity_ref("urn:fr:cc:successions:ind:i25:I"), entity_ref("urn:fr:cc:successions:ind:i25:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(SubstitutionDansLeMois);
}
