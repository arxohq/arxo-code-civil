language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 784, 1° : payer les frais funéraires n'emporte pas acceptation.
test "urn:query:fr-code-civil-successions-o19-frais-funeraires-sans-acceptation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": acte_accompli(entity_ref("urn:fr:cc:successions:opt:o19:S"), entity_ref("urn:fr:cc:successions:opt:o19:H"), PaiementDesFraisFunerairesOuDettesUrgentes) { origin case_input; }
    }
    evaluate truth(acte_sans_acceptation(entity_ref("urn:fr:cc:successions:opt:o19:S"), entity_ref("urn:fr:cc:successions:opt:o19:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PaiementUrgentSansAcceptation);
}
