test "urn:query:p3-813-accord-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": administration_confiee_d_un_commun_accord(entity_ref("urn:p3:813:a:s"), entity_ref("urn:p3:813:a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirConfierAdministrationParAccord, ACTIVE); }
test "urn:query:p3-813-accord-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
