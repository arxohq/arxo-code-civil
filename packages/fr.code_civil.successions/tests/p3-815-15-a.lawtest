language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-815-15-a" {
 given {
  context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": adjudication_le(entity_ref("urn:p3:81515:a:i"), @2026-01-31) { origin case_input; }
  assert "f2": substitution_declaree_le(entity_ref("urn:p3:81515:a:i"), entity_ref("urn:p3:81515:a:p"), @2026-02-10) { origin case_input; }
 }
 evaluate positions(); expect position(P3PositionPouvoirExercerSubstitution, ACTIVE);
}
