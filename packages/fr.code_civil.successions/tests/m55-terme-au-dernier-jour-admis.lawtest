language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 812-1-1 : terme au 15 janvier 2026 — la durée n'est pas excédée.
test "urn:query:fr-code-civil-successions-m55-terme-au-dernier-jour-admis" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": mandat_de_la_succession(entity_ref("urn:fr:cc:successions:adm:m55:M"), entity_ref("urn:fr:cc:successions:adm:m55:S")) { origin case_input; }
        assert "f2": mandataire_jouit_de_la_pleine_capacite_civile(entity_ref("urn:fr:cc:successions:adm:m55:M")) { origin case_input; }
        assert "f3": mandat_donne_le(entity_ref("urn:fr:cc:successions:adm:m55:M"), @2024-01-15) { origin case_input; }
        assert "f4": terme_prevu_le(entity_ref("urn:fr:cc:successions:adm:m55:M"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(duree_du_mandat_excessive(entity_ref("urn:fr:cc:successions:adm:m55:M")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
