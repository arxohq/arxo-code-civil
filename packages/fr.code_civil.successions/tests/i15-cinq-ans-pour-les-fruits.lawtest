language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-10, alinéa 3 : fruits perçus le 30 juin 2020 — recherche jusqu'au 30 juin 2025.
test "urn:query:fr-code-civil-successions-i15-cinq-ans-pour-les-fruits" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": fruits_percus_le(entity_ref("urn:fr:cc:successions:ind:i15:I"), @2020-06-30) { origin case_input; }
    }
    evaluate truth(fin_de_la_recherche_des_fruits(entity_ref("urn:fr:cc:successions:ind:i15:I"), @2025-06-30));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CinqAnsPourRechercherLesFruits);
}
