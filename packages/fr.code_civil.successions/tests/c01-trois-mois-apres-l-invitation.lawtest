language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 758-3 : invitation écrite le 31 janvier 2026 — le conjoint a jusqu'au 30 avril 2026.
test "urn:query:fr-code-civil-successions-c01-trois-mois-apres-l-invitation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:cj:c01:S"), entity_ref("urn:fr:cc:successions:cj:c01:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:cj:c01:S"), @2026-03-31) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:cj:c01:S"), entity_ref("urn:fr:cc:successions:cj:c01:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:cj:c01:F"), entity_ref("urn:fr:cc:successions:cj:c01:D"), entity_ref("urn:fr:cc:successions:cj:c01:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:cj:c01:F"), entity_ref("urn:fr:cc:successions:cj:c01:E"), entity_ref("urn:fr:cc:successions:cj:c01:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:cj:c01:F"), entity_ref("urn:fr:cc:successions:cj:c01:D"), entity_ref("urn:fr:cc:successions:cj:c01:C2")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:cj:c01:F"), entity_ref("urn:fr:cc:successions:cj:c01:E"), entity_ref("urn:fr:cc:successions:cj:c01:C2")) { origin case_input; }
        assert "f8": mariage(entity_ref("urn:fr:cc:successions:cj:c01:F"), entity_ref("urn:fr:cc:successions:cj:c01:D"), entity_ref("urn:fr:cc:successions:cj:c01:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c01:S"), entity_ref("urn:fr:cc:successions:cj:c01:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c01:S"), entity_ref("urn:fr:cc:successions:cj:c01:C1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c01:S"), entity_ref("urn:fr:cc:successions:cj:c01:C2")) { origin case_input; }
        assert "f12": invitation_ecrite_a_opter_le(entity_ref("urn:fr:cc:successions:cj:c01:S"), entity_ref("urn:fr:cc:successions:cj:c01:E"), @2026-01-31) { origin case_input; }
    }
    evaluate truth(fin_du_delai_d_option_du_conjoint(entity_ref("urn:fr:cc:successions:cj:c01:S"), entity_ref("urn:fr:cc:successions:cj:c01:E"), @2026-04-30));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(TroisMoisApresLInvitation);
}
