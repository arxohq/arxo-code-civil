language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 767 : le juge retient que le conjoint est dans le besoin.
test "urn:query:fr-code-civil-successions-c22-pension-du-conjoint-dans-le-besoin" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:cj:c22:S"), entity_ref("urn:fr:cc:successions:cj:c22:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:cj:c22:S"), @2026-03-31) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:cj:c22:S"), entity_ref("urn:fr:cc:successions:cj:c22:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:cj:c22:F"), entity_ref("urn:fr:cc:successions:cj:c22:D"), entity_ref("urn:fr:cc:successions:cj:c22:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:cj:c22:F"), entity_ref("urn:fr:cc:successions:cj:c22:E"), entity_ref("urn:fr:cc:successions:cj:c22:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:cj:c22:F"), entity_ref("urn:fr:cc:successions:cj:c22:D"), entity_ref("urn:fr:cc:successions:cj:c22:C2")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:cj:c22:F"), entity_ref("urn:fr:cc:successions:cj:c22:E"), entity_ref("urn:fr:cc:successions:cj:c22:C2")) { origin case_input; }
        assert "f8": mariage(entity_ref("urn:fr:cc:successions:cj:c22:F"), entity_ref("urn:fr:cc:successions:cj:c22:D"), entity_ref("urn:fr:cc:successions:cj:c22:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c22:S"), entity_ref("urn:fr:cc:successions:cj:c22:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c22:S"), entity_ref("urn:fr:cc:successions:cj:c22:C1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c22:S"), entity_ref("urn:fr:cc:successions:cj:c22:C2")) { origin case_input; }
        assert "f12": dans_le_besoin(entity_ref("urn:fr:cc:successions:cj:c22:S"), entity_ref("urn:fr:cc:successions:cj:c22:E")) { origin adjudicated; }
    }
    evaluate truth(creance_d_aliments_contre_la_succession(entity_ref("urn:fr:cc:successions:cj:c22:S"), entity_ref("urn:fr:cc:successions:cj:c22:E")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PensionDuConjointDansLeBesoin);
}
