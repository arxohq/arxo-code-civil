language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-790-inventaire-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": option_exercee_le(entity_ref("urn:p3:790:a:s"), entity_ref("urn:p3:790:a:h"), AcceptationAConcurrenceDeLActifNet, @2026-01-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirDeposerInventaire, ACTIVE); }
test "urn:query:p3-790-inventaire-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": option_exercee_le(entity_ref("urn:p3:790:b:s"), entity_ref("urn:p3:790:b:h"), AcceptationAConcurrenceDeLActifNet, @2025-07-15) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirDeposerInventaire, ACTIVE); }
