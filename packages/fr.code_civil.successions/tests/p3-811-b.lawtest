  assert "f2": etat_demandeur_envoi(entity_ref("urn:p3:811:811b:s"), entity_ref("urn:p3:811:811b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirEtatDemanderEnvoiPossession, ACTIVE); }
