language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-777-nullite-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": vice_decouvert_ou_violence_cessee_le(entity_ref("urn:p3:777:a:s"), entity_ref("urn:p3:777:a:h"), @2025-01-01) { origin case_input; }
  assert "f2": date_d_appreciation_de_l_option(entity_ref("urn:p3:777:a:s"), entity_ref("urn:p3:777:a:h"), @2026-01-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderNulliteOption, ACTIVE); }
test "urn:query:p3-777-nullite-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": vice_decouvert_ou_violence_cessee_le(entity_ref("urn:p3:777:b:s"), entity_ref("urn:p3:777:b:h"), @2024-06-15) { origin case_input; }
  assert "f2": date_d_appreciation_de_l_option(entity_ref("urn:p3:777:b:s"), entity_ref("urn:p3:777:b:h"), @2025-06-15) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderNulliteOption, ACTIVE); }
