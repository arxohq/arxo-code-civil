language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 860-1 : le rapport d'une somme d'argent est égal à son montant, 30 000 EUR.
test "urn:query:fr-code-civil-successions-q16-rapport-d-une-somme-d-argent" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:par:q16:S"), entity_ref("urn:fr:cc:successions:par:q16:H"), entity_ref("urn:fr:cc:successions:par:q16:L"), DonationEnAvancementDePartSuccessorale) { origin case_input; }
        assert "f2": somme_d_argent_donnee(entity_ref("urn:fr:cc:successions:par:q16:S"), entity_ref("urn:fr:cc:successions:par:q16:L"), 30000 EUR) { origin case_input; }
    }
    evaluate truth(valeur_rapportable(entity_ref("urn:fr:cc:successions:par:q16:S"), entity_ref("urn:fr:cc:successions:par:q16:H"), 30000 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RapportDUneSommeDArgent);
}
