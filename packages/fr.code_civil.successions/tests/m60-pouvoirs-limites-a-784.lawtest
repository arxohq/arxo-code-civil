language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 812-1-3 : tant qu'aucun héritier visé n'a accepté.
test "urn:query:fr-code-civil-successions-m60-pouvoirs-limites-a-784" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": mandat_de_la_succession(entity_ref("urn:fr:cc:successions:adm:m60:M"), entity_ref("urn:fr:cc:successions:adm:m60:S")) { origin case_input; }
        assert "f2": mandataire_jouit_de_la_pleine_capacite_civile(entity_ref("urn:fr:cc:successions:adm:m60:M")) { origin case_input; }
        assert "f3": mandat_donne_le(entity_ref("urn:fr:cc:successions:adm:m60:M"), @2024-01-15) { origin case_input; }
        assert "f4": heritier_vise_par_le_mandat(entity_ref("urn:fr:cc:successions:adm:m60:M"), entity_ref("urn:fr:cc:successions:adm:m60:P")) { origin case_input; }
    }
    evaluate truth(pouvoirs_du_mandataire_limites_a_784(entity_ref("urn:fr:cc:successions:adm:m60:M")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PouvoirsLimitesTantQueNulHeritierNAccepte);
}
