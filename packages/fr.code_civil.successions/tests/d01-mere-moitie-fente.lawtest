language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 738-1 : parent unique et ascendant de l autre branche : moitié à la mère.
test "urn:query:fr-code-civil-successions-d01-mere-moitie-fente" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:d:S"), entity_ref("urn:fr:cc:successions:d:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:d:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:d:S"), entity_ref("urn:fr:cc:successions:d:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:d:F"), entity_ref("urn:fr:cc:successions:d:P"), entity_ref("urn:fr:cc:successions:d:D")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:d:F"), entity_ref("urn:fr:cc:successions:d:M"), entity_ref("urn:fr:cc:successions:d:D")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:d:F"), entity_ref("urn:fr:cc:successions:d:GF"), entity_ref("urn:fr:cc:successions:d:P")) { origin case_input; }
        assert "f7": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:d:S"), entity_ref("urn:fr:cc:successions:d:M")) { origin case_input; }
        assert "f8": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:d:S"), entity_ref("urn:fr:cc:successions:d:GF")) { origin case_input; }
        assert "f9": predecede(entity_ref("urn:fr:cc:successions:d:S"), entity_ref("urn:fr:cc:successions:d:P")) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:d:S"), entity_ref("urn:fr:cc:successions:d:M"), 1 / 2));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(UnParentAvecAscendantsDeLAutreBranche);
}
