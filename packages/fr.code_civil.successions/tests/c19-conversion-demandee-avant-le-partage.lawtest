language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 760, alinéa 1 : demande du 1er mai 2026, partage définitif du 30 juin 2026.
test "urn:query:fr-code-civil-successions-c19-conversion-demandee-avant-le-partage" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:cj:c19:S"), entity_ref("urn:fr:cc:successions:cj:c19:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:cj:c19:S"), @2026-03-31) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:cj:c19:S"), entity_ref("urn:fr:cc:successions:cj:c19:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:cj:c19:F"), entity_ref("urn:fr:cc:successions:cj:c19:D"), entity_ref("urn:fr:cc:successions:cj:c19:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:cj:c19:F"), entity_ref("urn:fr:cc:successions:cj:c19:E"), entity_ref("urn:fr:cc:successions:cj:c19:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:cj:c19:F"), entity_ref("urn:fr:cc:successions:cj:c19:D"), entity_ref("urn:fr:cc:successions:cj:c19:C2")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:cj:c19:F"), entity_ref("urn:fr:cc:successions:cj:c19:E"), entity_ref("urn:fr:cc:successions:cj:c19:C2")) { origin case_input; }
        assert "f8": mariage(entity_ref("urn:fr:cc:successions:cj:c19:F"), entity_ref("urn:fr:cc:successions:cj:c19:D"), entity_ref("urn:fr:cc:successions:cj:c19:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c19:S"), entity_ref("urn:fr:cc:successions:cj:c19:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c19:S"), entity_ref("urn:fr:cc:successions:cj:c19:C1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c19:S"), entity_ref("urn:fr:cc:successions:cj:c19:C2")) { origin case_input; }
        assert "f12": demande_de_conversion_le(entity_ref("urn:fr:cc:successions:cj:c19:S"), @2026-05-01) { origin case_input; }
        assert "f13": partage_definitif_le(entity_ref("urn:fr:cc:successions:cj:c19:S"), @2026-06-30) { origin case_input; }
    }
    evaluate truth(demande_de_conversion_recevable(entity_ref("urn:fr:cc:successions:cj:c19:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ConversionDemandeeAvantLePartage);
}
