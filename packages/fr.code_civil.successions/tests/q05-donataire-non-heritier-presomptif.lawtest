language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 846 : le donataire n'était pas héritier présomptif lors de la donation.
test "urn:query:fr-code-civil-successions-q05-donataire-non-heritier-presomptif" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:par:q05:S"), entity_ref("urn:fr:cc:successions:par:q05:H"), entity_ref("urn:fr:cc:successions:par:q05:L"), DonationEnAvancementDePartSuccessorale) { origin case_input; }
        assert "f2": donataire_non_heritier_presomptif(entity_ref("urn:fr:cc:successions:par:q05:S"), entity_ref("urn:fr:cc:successions:par:q05:L")) { origin case_input; }
    }
    evaluate truth(dispense_de_rapport(entity_ref("urn:fr:cc:successions:par:q05:S"), entity_ref("urn:fr:cc:successions:par:q05:L")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DonataireNonHeritierPresomptif);
}
