language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-16 : action du 2 mars 2026, hors des cinq ans.
test "urn:query:fr-code-civil-successions-i27-nullite-de-la-cession-le-lendemain" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": cession_sans_notification(entity_ref("urn:fr:cc:successions:ind:i27:I")) { origin case_input; }
        assert "f2": cession_operee_le(entity_ref("urn:fr:cc:successions:ind:i27:I"), @2021-03-01) { origin case_input; }
        assert "f3": action_en_nullite_de_la_cession_le(entity_ref("urn:fr:cc:successions:ind:i27:I"), @2026-03-02) { origin case_input; }
    }
    evaluate truth(nullite_de_la_cession_encourue(entity_ref("urn:fr:cc:successions:ind:i27:I")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
