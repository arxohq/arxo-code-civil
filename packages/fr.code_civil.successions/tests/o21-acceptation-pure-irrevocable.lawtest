language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 786 : l'acceptant pur et simple ne peut plus renoncer.
test "urn:query:fr-code-civil-successions-o21-acceptation-pure-irrevocable" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": option_exercee_le(entity_ref("urn:fr:cc:successions:opt:o21:S"), entity_ref("urn:fr:cc:successions:opt:o21:H"), AcceptationPureEtSimple, @2026-03-01) { origin case_input; }
    }
    evaluate truth(renonciation_impossible(entity_ref("urn:fr:cc:successions:opt:o21:S"), entity_ref("urn:fr:cc:successions:opt:o21:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(AcceptationPureIrrevocable);
}
