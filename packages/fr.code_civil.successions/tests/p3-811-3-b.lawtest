language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-811-3-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": etat_expose_a_des_dommages_et_interets(entity_ref("urn:p3:8113:8113b:s")) { origin case_input; }
  assert "f2": heritier_se_presente(entity_ref("urn:p3:8113:8113b:s"), entity_ref("urn:p3:8113:8113b:h")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderDommagesEtat, ACTIVE); }
