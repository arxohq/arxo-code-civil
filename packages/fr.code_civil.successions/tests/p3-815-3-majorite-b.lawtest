language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-815-3-majorite-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": acte_valablement_accompli(entity_ref("urn:p3:8153m:8153majoriteb:i")) { origin case_input; }
  assert "f2": acte_majoritaire_exerce(entity_ref("urn:p3:8153m:8153majoriteb:i"), entity_ref("urn:p3:8153m:8153majoriteb:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirAccomplirActeMajoritaire, ACTIVE); }
