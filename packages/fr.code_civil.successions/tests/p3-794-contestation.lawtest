language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-794-contestation-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": publicite_de_la_declaration_le(entity_ref("urn:p3:794:a:s"), @2026-01-01) { origin case_input; }
  assert "f2": creance_declaree_le(entity_ref("urn:p3:794:a:s"), entity_ref("urn:p3:794:a:h"), @2026-02-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirContesterValeurOuPrix, ACTIVE); }
test "urn:query:p3-794-contestation-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": publicite_de_la_declaration_le(entity_ref("urn:p3:794:b:s"), @2025-05-10) { origin case_input; }
  assert "f2": creance_declaree_le(entity_ref("urn:p3:794:b:s"), entity_ref("urn:p3:794:b:h"), @2025-06-10) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirContesterValeurOuPrix, ACTIVE); }
