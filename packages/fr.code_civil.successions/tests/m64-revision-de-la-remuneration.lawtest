language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 812-3 : le juge retient le caractère excessif de la rémunération (§47.3).
test "urn:query:fr-code-civil-successions-m64-revision-de-la-remuneration" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": mandat_de_la_succession(entity_ref("urn:fr:cc:successions:adm:m64:M"), entity_ref("urn:fr:cc:successions:adm:m64:S")) { origin case_input; }
        assert "f2": mandataire_jouit_de_la_pleine_capacite_civile(entity_ref("urn:fr:cc:successions:adm:m64:M")) { origin case_input; }
        assert "f3": mandat_donne_le(entity_ref("urn:fr:cc:successions:adm:m64:M"), @2024-01-15) { origin case_input; }
        assert "f4": remuneration_prevue_au_mandat(entity_ref("urn:fr:cc:successions:adm:m64:M")) { origin case_input; }
        assert "f5": remuneration_expressement_determinee(entity_ref("urn:fr:cc:successions:adm:m64:M")) { origin case_input; }
        assert "f6": remuneration_excessive(entity_ref("urn:fr:cc:successions:adm:m64:M")) { origin adjudicated; }
    }
    evaluate truth(revision_de_la_remuneration_ouverte(entity_ref("urn:fr:cc:successions:adm:m64:M")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RevisionDeLaRemuneration);
}
