language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-810-1-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": curateur_succession(entity_ref("urn:p3:8101:810-1b:s"), entity_ref("urn:p3:8101:810-1b:p")) { origin case_input; }
  assert "f2": acte_du_curateur_le(entity_ref("urn:p3:8101:810-1b:s"), ActePurementConservatoire, @2026-03-01) { origin case_input; }
  assert "f3": fin_du_delai_de_six_mois(entity_ref("urn:p3:8101:810-1b:s"), @2026-06-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirActeConservatoireCurateur, ACTIVE); }
