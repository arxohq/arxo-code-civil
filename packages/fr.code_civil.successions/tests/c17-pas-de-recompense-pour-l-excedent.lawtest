language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 765, alinéa 3 : droit viager 90 000 EUR, droits successoraux 80 000 EUR.
test "urn:query:fr-code-civil-successions-c17-pas-de-recompense-pour-l-excedent" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:cj:c17:S"), @2026-03-31) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:cj:c17:F"), entity_ref("urn:fr:cc:successions:cj:c17:D"), entity_ref("urn:fr:cc:successions:cj:c17:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:cj:c17:F"), entity_ref("urn:fr:cc:successions:cj:c17:E"), entity_ref("urn:fr:cc:successions:cj:c17:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:cj:c17:F"), entity_ref("urn:fr:cc:successions:cj:c17:D"), entity_ref("urn:fr:cc:successions:cj:c17:C2")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:cj:c17:F"), entity_ref("urn:fr:cc:successions:cj:c17:E"), entity_ref("urn:fr:cc:successions:cj:c17:C2")) { origin case_input; }
        assert "f8": mariage(entity_ref("urn:fr:cc:successions:cj:c17:F"), entity_ref("urn:fr:cc:successions:cj:c17:D"), entity_ref("urn:fr:cc:successions:cj:c17:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:C1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:C2")) { origin case_input; }
        assert "f12": valeur_du_droit_viager(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:E"), 90000 EUR) { origin case_input; }
        assert "f13": valeur_des_droits_successoraux(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:E"), 80000 EUR) { origin case_input; }
    }
    evaluate truth(pas_de_recompense_pour_l_excedent(entity_ref("urn:fr:cc:successions:cj:c17:S"), entity_ref("urn:fr:cc:successions:cj:c17:E")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PasDeRecompensePourLExcedent);
}
