language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 757-2 : ni descendants ni père et mère : le conjoint recueille tout.
test "urn:query:fr-code-civil-successions-e04-conjoint-seul-totalite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:e3:S"), entity_ref("urn:fr:cc:successions:e3:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:e3:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:e3:S"), entity_ref("urn:fr:cc:successions:e3:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:e3:F"), entity_ref("urn:fr:cc:successions:e3:P"), entity_ref("urn:fr:cc:successions:e3:D")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:e3:F"), entity_ref("urn:fr:cc:successions:e3:M"), entity_ref("urn:fr:cc:successions:e3:D")) { origin case_input; }
        assert "f6": mariage(entity_ref("urn:fr:cc:successions:e3:F"), entity_ref("urn:fr:cc:successions:e3:D"), entity_ref("urn:fr:cc:successions:e3:E")) { origin case_input; }
        assert "f7": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:e3:S"), entity_ref("urn:fr:cc:successions:e3:E")) { origin case_input; }
        assert "f8": predecede(entity_ref("urn:fr:cc:successions:e3:S"), entity_ref("urn:fr:cc:successions:e3:P")) { origin case_input; }
        assert "f9": predecede(entity_ref("urn:fr:cc:successions:e3:S"), entity_ref("urn:fr:cc:successions:e3:M")) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:e3:S"), entity_ref("urn:fr:cc:successions:e3:E"), 1 / 1));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ConjointSeul);
}
