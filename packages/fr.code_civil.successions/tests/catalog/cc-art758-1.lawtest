language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Порождённые сценарии-свидетельства каталога вопросов (DECISION-0190):
// мир выполняет посылки правила, запрос спрашивает его вывод.
// Собраны corpus/tools/questions_catalog/build_catalog.py по CLIR пакета;
// правка руками — только вместе с каталогом.

// 
test "CATALOG-P3WAVE3VIOLATIONCEDERDROITSCONJOINTAVANTOPTION" {
    given {
        context { decision_time @2026-08-25T12:00:00Z; knowledge_time @2026-08-25T12:00:00Z; legal_time @2026-08-25; timezone "Asia/Almaty"; }
        assert "cat-0": cession_droits_conjoint_exercee(entity_ref("urn:law:catalog:p3wave3violationcederdroitsconjointavantoption:v0"), entity_ref("urn:law:catalog:p3wave3violationcederdroitsconjointavantoption:v1")) { origin case_input; }
    }
    evaluate truth(violation_ceder_droits_conjoint_avant_option(entity_ref("urn:law:catalog:p3wave3violationcederdroitsconjointavantoption:v0"), entity_ref("urn:law:catalog:p3wave3violationcederdroitsconjointavantoption:v1")));
    expect truth_status == TRUE_ONLY;
}
