language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-14, alinéa 3 : préemption du 10 février 2026 — vente jusqu'au 10 avril 2026.
test "urn:query:fr-code-civil-successions-i21-deux-mois-pour-realiser-la-vente" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": preemption_notifiee_le(entity_ref("urn:fr:cc:successions:ind:i21:I"), entity_ref("urn:fr:cc:successions:ind:i21:p"), @2026-02-10) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_realisation(entity_ref("urn:fr:cc:successions:ind:i21:I"), entity_ref("urn:fr:cc:successions:ind:i21:p"), @2026-04-10));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DeuxMoisPourRealiserLaVente);
}
