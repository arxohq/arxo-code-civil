language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 775 : l'héritier est mort sans opter, sa succession s'ouvre le 28 février 2026 — quatre mois jusqu'au 28 juin 2026.
test "urn:query:fr-code-civil-successions-o09-quatre-mois-des-heritiers-de-l-heritier" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:opt:o09:S"), @2025-06-01) { origin case_input; }
        assert "f2": heritier_de_l_heritier_decede_sans_opter(entity_ref("urn:fr:cc:successions:opt:o09:S"), entity_ref("urn:fr:cc:successions:opt:o09:H"), entity_ref("urn:fr:cc:successions:opt:o09:S2")) { origin case_input; }
        assert "f3": ouverte_le(entity_ref("urn:fr:cc:successions:opt:o09:S2"), @2026-02-28) { origin case_input; }
    }
    evaluate truth(sommation_possible_a_compter_du(entity_ref("urn:fr:cc:successions:opt:o09:S"), entity_ref("urn:fr:cc:successions:opt:o09:H"), @2026-06-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(QuatreMoisDesHeritiersDeLHeritierDecede);
}
