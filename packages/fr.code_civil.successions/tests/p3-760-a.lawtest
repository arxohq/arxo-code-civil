  assert "f2": demande_de_conversion_le(entity_ref("urn:p3:760:760a:s"), @2026-01-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionConversionLogementContreVolonte, ACTIVE); }
