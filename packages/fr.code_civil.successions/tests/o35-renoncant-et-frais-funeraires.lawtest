language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 806 : le fils renonce à la succession de sa mère, mais reste tenu des frais funéraires selon ses moyens.
test "urn:query:fr-code-civil-successions-o35-renoncant-et-frais-funeraires" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": option_exercee_le(entity_ref("urn:fr:cc:successions:opt:o35:S"), entity_ref("urn:fr:cc:successions:opt:o35:H"), Renonciation, @2026-02-01) { origin case_input; }
        assert "f2": frais_funeraires_d_un_ascendant_ou_descendant(entity_ref("urn:fr:cc:successions:opt:o35:S")) { origin case_input; }
    }
    evaluate truth(tenu_des_frais_funeraires(entity_ref("urn:fr:cc:successions:opt:o35:S"), entity_ref("urn:fr:cc:successions:opt:o35:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RenoncantTenuDesFraisFuneraires);
}
