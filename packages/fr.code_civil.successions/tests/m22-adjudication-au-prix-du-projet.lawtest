language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-3 : l'adjudication atteint le prix convenu — aucune perte.
test "urn:query:fr-code-civil-successions-m22-adjudication-au-prix-du-projet" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": adjudication_exigee_par(entity_ref("urn:fr:cc:successions:adm:m22:S"), entity_ref("urn:fr:cc:successions:adm:m22:P")) { origin case_input; }
        assert "f2": prix_convenu_dans_le_projet(entity_ref("urn:fr:cc:successions:adm:m22:S"), 120000.00 EUR) { origin case_input; }
        assert "f3": prix_de_l_adjudication(entity_ref("urn:fr:cc:successions:adm:m22:S"), 120000.00 EUR) { origin case_input; }
    }
    evaluate truth(perte_supportee_par_le_creancier(entity_ref("urn:fr:cc:successions:adm:m22:S"), entity_ref("urn:fr:cc:successions:adm:m22:P"), 0.00 EUR));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
