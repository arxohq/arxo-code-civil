  assert "f1": acceptations_mixtes_constatees(entity_ref("urn:p3:792-2:a:s")) { origin case_input; }
  assert "f2": difficultes_recouvrement_constatees(entity_ref("urn:p3:792-2:a:s")) { origin case_input; }
  assert "f3": creancier_successoral(entity_ref("urn:p3:792-2:a:s"), entity_ref("urn:p3:792-2:a:h")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirProvoquerPartageParCreancier, ACTIVE); }
