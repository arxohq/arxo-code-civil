language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 843, alinéa 1 : don fait expressément hors part successorale.
test "urn:query:fr-code-civil-successions-q02-don-hors-part-successorale" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:par:q02:S"), entity_ref("urn:fr:cc:successions:par:q02:H"), entity_ref("urn:fr:cc:successions:par:q02:L"), DonationHorsPartSuccessorale) { origin case_input; }
    }
    evaluate truth(rapport_du(entity_ref("urn:fr:cc:successions:par:q02:S"), entity_ref("urn:fr:cc:successions:par:q02:H"), entity_ref("urn:fr:cc:successions:par:q02:L")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
