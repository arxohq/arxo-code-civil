language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-5, alinéa 3 : publicité le 31 janvier 2026, dernier jour le 28 février 2026.
test "urn:query:fr-code-civil-successions-m34-un-mois-pour-contester-le-projet" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": projet_de_reglement_publie_le(entity_ref("urn:fr:cc:successions:adm:m34:S"), @2026-01-31) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_contestation_du_projet(entity_ref("urn:fr:cc:successions:adm:m34:S"), @2026-02-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(UnMoisPourContesterLeProjet);
}
