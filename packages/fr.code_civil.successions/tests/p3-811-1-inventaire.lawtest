language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-811-1-inventaire-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": autorite_administrative_succession(entity_ref("urn:p3:811-1:a:s"), entity_ref("urn:p3:811-1:a:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirFaireDresserInventaireAutorite, ACTIVE); }
test "urn:query:p3-811-1-inventaire-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": autorite_administrative_succession(entity_ref("urn:p3:811-1:b:s"), entity_ref("urn:p3:811-1:b:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionDevoirFaireDresserInventaireAutorite, ACTIVE); }
