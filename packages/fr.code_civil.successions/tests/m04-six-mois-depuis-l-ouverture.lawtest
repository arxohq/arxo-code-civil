language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 809, 3° : ouverture le 31 mars 2024, six mois au 30 septembre 2024.
test "urn:query:fr-code-civil-successions-m04-six-mois-depuis-l-ouverture" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:adm:m04:S"), @2024-03-31) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_six_mois(entity_ref("urn:fr:cc:successions:adm:m04:S"), @2024-09-30));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(SixMoisDepuisLOuverture);
}
