language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-5-1, alinéas 4 et 5 : procès-verbal du 16 juin 2026, après les trois mois.
test "urn:query:fr-code-civil-successions-i12-alienation-soumise-au-tribunal" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": total_des_parts(entity_ref("urn:fr:cc:successions:ind:i12:I"), 3000) { origin case_input; }
        assert "f2": parts_favorables(entity_ref("urn:fr:cc:successions:ind:i12:I"), 2000) { origin case_input; }
        assert "f3": signification_aux_autres_le(entity_ref("urn:fr:cc:successions:ind:i12:I"), @2026-03-15) { origin case_input; }
        assert "f4": opposition_ou_silence_constate_le(entity_ref("urn:fr:cc:successions:ind:i12:I"), @2026-06-16) { origin case_input; }
    }
    evaluate truth(alienation_soumise_au_tribunal(entity_ref("urn:fr:cc:successions:ind:i12:I")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(AlienationSoumiseAuTribunal);
}
