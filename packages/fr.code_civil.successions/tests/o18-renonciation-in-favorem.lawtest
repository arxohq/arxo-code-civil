language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 783, 1° : renoncer au profit d'un frère désigné, c'est accepter.
test "urn:query:fr-code-civil-successions-o18-renonciation-in-favorem" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": acte_accompli(entity_ref("urn:fr:cc:successions:opt:o18:S"), entity_ref("urn:fr:cc:successions:opt:o18:H"), RenonciationAuProfitDeCoheritiersDetermines) { origin case_input; }
    }
    evaluate truth(acte_emportant_acceptation(entity_ref("urn:fr:cc:successions:opt:o18:S"), entity_ref("urn:fr:cc:successions:opt:o18:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RenonciationInFavoremEmporteAcceptation);
}
