language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 881 : demande du 1er juin 2026, hors des deux ans.
test "urn:query:fr-code-civil-successions-q34-preference-prescrite" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:par:q34:S"), @2024-05-31) { origin case_input; }
        assert "f2": preference_demandee_le(entity_ref("urn:fr:cc:successions:par:q34:S"), entity_ref("urn:fr:cc:successions:par:q34:cr"), @2026-06-01) { origin case_input; }
    }
    evaluate truth(preference_sur_les_meubles_prescrite(entity_ref("urn:fr:cc:successions:par:q34:S"), entity_ref("urn:fr:cc:successions:par:q34:cr")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PreferencePrescrite);
}
