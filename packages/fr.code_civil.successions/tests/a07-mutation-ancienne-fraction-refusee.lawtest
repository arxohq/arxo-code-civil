language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Mutation du cas a : l ancienne fraction 3/16 n est plus vraie pour G1.
test "urn:query:fr-code-civil-successions-a07-mutation-ancienne-fraction-refusee" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:a2:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:a2:F"), entity_ref("urn:fr:cc:successions:a2:D"), entity_ref("urn:fr:cc:successions:a2:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:a2:F"), entity_ref("urn:fr:cc:successions:a2:D"), entity_ref("urn:fr:cc:successions:a2:C2")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:a2:F"), entity_ref("urn:fr:cc:successions:a2:E"), entity_ref("urn:fr:cc:successions:a2:C1")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:a2:F"), entity_ref("urn:fr:cc:successions:a2:E"), entity_ref("urn:fr:cc:successions:a2:C2")) { origin case_input; }
        assert "f8": filiation(entity_ref("urn:fr:cc:successions:a2:F"), entity_ref("urn:fr:cc:successions:a2:C2"), entity_ref("urn:fr:cc:successions:a2:G1")) { origin case_input; }
        assert "f9": mariage(entity_ref("urn:fr:cc:successions:a2:F"), entity_ref("urn:fr:cc:successions:a2:D"), entity_ref("urn:fr:cc:successions:a2:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:E")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:C1")) { origin case_input; }
        assert "f12": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:G1")) { origin case_input; }
        assert "f13": predecede(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:C2")) { origin case_input; }
        assert "f14": option_du_conjoint(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:E"), QuartEnPropriete) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:a2:S"), entity_ref("urn:fr:cc:successions:a2:G1"), 3 / 16));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
