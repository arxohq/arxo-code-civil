language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 772 : sommation le 15 juin 2026 — l'héritier a jusqu'au 15 août 2026.
test "urn:query:fr-code-civil-successions-o05-deux-mois-apres-la-sommation" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:opt:o05:S"), @2026-01-31) { origin case_input; }
        assert "f2": sommation_d_opter_le(entity_ref("urn:fr:cc:successions:opt:o05:S"), entity_ref("urn:fr:cc:successions:opt:o05:H"), @2026-06-15) { origin case_input; }
    }
    evaluate truth(fin_du_delai_apres_sommation(entity_ref("urn:fr:cc:successions:opt:o05:S"), entity_ref("urn:fr:cc:successions:opt:o05:H"), @2026-08-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DeuxMoisApresLaSommation);
}
