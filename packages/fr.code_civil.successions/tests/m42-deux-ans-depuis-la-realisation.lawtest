language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-9, alinéa 2 : réalisation le 29 février 2024, prescription au 28 février 2026.
test "urn:query:fr-code-civil-successions-m42-deux-ans-depuis-la-realisation" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": realisation_de_l_actif_subsistant_le(entity_ref("urn:fr:cc:successions:adm:m42:S"), @2024-02-29) { origin case_input; }
    }
    evaluate truth(fin_du_recours_contre_les_legataires(entity_ref("urn:fr:cc:successions:adm:m42:S"), @2026-02-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DeuxAnsDepuisLaRealisation);
}
