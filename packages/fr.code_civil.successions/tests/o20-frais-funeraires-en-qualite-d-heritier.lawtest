language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 784 : le même paiement fait en prenant la qualité d'héritier n'est plus purement conservatoire.
test "urn:query:fr-code-civil-successions-o20-frais-funeraires-en-qualite-d-heritier" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": acte_accompli(entity_ref("urn:fr:cc:successions:opt:o20:S"), entity_ref("urn:fr:cc:successions:opt:o20:H"), PaiementDesFraisFunerairesOuDettesUrgentes) { origin case_input; }
        assert "f2": titre_ou_qualite_d_heritier_pris(entity_ref("urn:fr:cc:successions:opt:o20:S"), entity_ref("urn:fr:cc:successions:opt:o20:H")) { origin case_input; }
    }
    evaluate truth(acte_sans_acceptation(entity_ref("urn:fr:cc:successions:opt:o20:S"), entity_ref("urn:fr:cc:successions:opt:o20:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
