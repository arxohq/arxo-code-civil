language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 814 : un héritier au moins a accepté, la mésentente justifiant la désignation.
test "urn:query:fr-code-civil-successions-m79-actes-d-administration-autorisables" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": motif_de_designation(entity_ref("urn:fr:cc:successions:adm:m79:S"), MesententeEntreLesHeritiers) { origin case_input; }
        assert "f2": option_exercee_le(entity_ref("urn:fr:cc:successions:adm:m79:S"), entity_ref("urn:fr:cc:successions:adm:m79:P"), AcceptationPureEtSimple, @2026-04-01) { origin case_input; }
    }
    evaluate truth(actes_d_administration_autorisables(entity_ref("urn:fr:cc:successions:adm:m79:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ActesDAdministrationAutorisables);
}
