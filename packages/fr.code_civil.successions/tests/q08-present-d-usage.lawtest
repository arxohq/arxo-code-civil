language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 852 : le présent d'usage ne se rapporte pas.
test "urn:query:fr-code-civil-successions-q08-present-d-usage" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:par:q08:S"), entity_ref("urn:fr:cc:successions:par:q08:H"), entity_ref("urn:fr:cc:successions:par:q08:L"), PresentDUsage) { origin case_input; }
    }
    evaluate truth(dispense_de_rapport(entity_ref("urn:fr:cc:successions:par:q08:S"), entity_ref("urn:fr:cc:successions:par:q08:L")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PresentDUsageNonRapportable);
}
