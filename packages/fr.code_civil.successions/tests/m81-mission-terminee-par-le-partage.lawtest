language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 813-9, alinéa 2 : la mission cesse par la signature de l'acte de partage.
test "urn:query:fr-code-civil-successions-m81-mission-terminee-par-le-partage" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": partage_realise_le(entity_ref("urn:fr:cc:successions:adm:m81:S"), @2026-06-30) { origin case_input; }
    }
    evaluate truth(mission_du_mandataire_successoral_terminee(entity_ref("urn:fr:cc:successions:adm:m81:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(MissionTermineeParLActeDePartage);
}
