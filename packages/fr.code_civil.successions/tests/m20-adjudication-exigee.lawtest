language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-3, alinéa 3 : tout créancier peut exiger l'adjudication.
test "urn:query:fr-code-civil-successions-m20-adjudication-exigee" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": adjudication_exigee_par(entity_ref("urn:fr:cc:successions:adm:m20:S"), entity_ref("urn:fr:cc:successions:adm:m20:P")) { origin case_input; }
    }
    evaluate truth(adjudication_obligatoire(entity_ref("urn:fr:cc:successions:adm:m20:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(AdjudicationExigeeParUnCreancier);
}
