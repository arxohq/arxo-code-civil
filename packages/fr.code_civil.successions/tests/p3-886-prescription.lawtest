language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-886-prescription-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": fin_de_l_action_en_garantie(entity_ref("urn:p3:886:pa:s"), entity_ref("urn:p3:886:pa:h"), @2024-01-01) { origin case_input; }
  assert "f2": action_en_garantie_le(entity_ref("urn:p3:886:pa:s"), entity_ref("urn:p3:886:pa:h"), @2025-01-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionActionGarantiePrescrite, ACTIVE); }
test "urn:query:p3-886-prescription-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": fin_de_l_action_en_garantie(entity_ref("urn:p3:886:pb:s"), entity_ref("urn:p3:886:pb:h"), @2023-06-15) { origin case_input; }
  assert "f2": action_en_garantie_le(entity_ref("urn:p3:886:pb:s"), entity_ref("urn:p3:886:pb:h"), @2025-06-15) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionActionGarantiePrescrite, ACTIVE); }
