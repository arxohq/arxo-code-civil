language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 811-3 : formalités omises et héritier qui se présente.
test "urn:query:fr-code-civil-successions-m50-etat-expose-a-des-dommages" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": formalites_de_l_etat_omises_constatees(entity_ref("urn:fr:cc:successions:adm:m50:S")) { origin adjudicated; }
        assert "f2": heritier_se_presente(entity_ref("urn:fr:cc:successions:adm:m50:S"), entity_ref("urn:fr:cc:successions:adm:m50:P")) { origin case_input; }
    }
    evaluate truth(etat_expose_a_des_dommages_et_interets(entity_ref("urn:fr:cc:successions:adm:m50:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(EtatExposeADesDommagesEtInterets);
}
