language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 757-1 al. 2 : père prédécédé, sa part échoit au conjoint : 3/4.
test "urn:query:fr-code-civil-successions-e03-conjoint-trois-quarts-un-parent" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:e2:S"), entity_ref("urn:fr:cc:successions:e2:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:e2:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:e2:S"), entity_ref("urn:fr:cc:successions:e2:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:e2:F"), entity_ref("urn:fr:cc:successions:e2:P"), entity_ref("urn:fr:cc:successions:e2:D")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:e2:F"), entity_ref("urn:fr:cc:successions:e2:M"), entity_ref("urn:fr:cc:successions:e2:D")) { origin case_input; }
        assert "f6": mariage(entity_ref("urn:fr:cc:successions:e2:F"), entity_ref("urn:fr:cc:successions:e2:D"), entity_ref("urn:fr:cc:successions:e2:E")) { origin case_input; }
        assert "f7": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:e2:S"), entity_ref("urn:fr:cc:successions:e2:E")) { origin case_input; }
        assert "f8": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:e2:S"), entity_ref("urn:fr:cc:successions:e2:M")) { origin case_input; }
        assert "f9": predecede(entity_ref("urn:fr:cc:successions:e2:S"), entity_ref("urn:fr:cc:successions:e2:P")) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:e2:S"), entity_ref("urn:fr:cc:successions:e2:E"), 3 / 4));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ConjointAvecUnSeulParent);
}
