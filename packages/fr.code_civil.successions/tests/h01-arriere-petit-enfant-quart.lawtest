language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 752, 753 : souche C1 = 1/2 ; subdivisions G1 1/4, G2 1/4 → GG1 1/4.
test "urn:query:fr-code-civil-successions-h01-arriere-petit-enfant-quart" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:h:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:h:F"), entity_ref("urn:fr:cc:successions:h:D"), entity_ref("urn:fr:cc:successions:h:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:h:F"), entity_ref("urn:fr:cc:successions:h:D"), entity_ref("urn:fr:cc:successions:h:C2")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:h:F"), entity_ref("urn:fr:cc:successions:h:C1"), entity_ref("urn:fr:cc:successions:h:G1")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:h:F"), entity_ref("urn:fr:cc:successions:h:C1"), entity_ref("urn:fr:cc:successions:h:G2")) { origin case_input; }
        assert "f8": filiation(entity_ref("urn:fr:cc:successions:h:F"), entity_ref("urn:fr:cc:successions:h:G2"), entity_ref("urn:fr:cc:successions:h:GG1")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:C2")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:G1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:GG1")) { origin case_input; }
        assert "f12": predecede(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:C1")) { origin case_input; }
        assert "f13": predecede(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:G2")) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:h:S"), entity_ref("urn:fr:cc:successions:h:GG1"), 1 / 4));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
