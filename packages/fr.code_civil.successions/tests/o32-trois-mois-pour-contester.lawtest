language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 794, alinéa 2 : publicité le 15 janvier 2026 — contestation jusqu'au 15 avril 2026.
test "urn:query:fr-code-civil-successions-o32-trois-mois-pour-contester" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": publicite_de_la_declaration_le(entity_ref("urn:fr:cc:successions:opt:o32:S"), @2026-01-15) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_contestation(entity_ref("urn:fr:cc:successions:opt:o32:S"), @2026-04-15));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(TroisMoisPourContester);
}
