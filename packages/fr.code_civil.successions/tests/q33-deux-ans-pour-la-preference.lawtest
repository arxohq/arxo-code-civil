language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 881 : succession ouverte le 31 mai 2024 — préférence sur les meubles jusqu'au 31 mai 2026.
test "urn:query:fr-code-civil-successions-q33-deux-ans-pour-la-preference" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:par:q33:S"), @2024-05-31) { origin case_input; }
    }
    evaluate truth(fin_de_la_preference_sur_les_meubles(entity_ref("urn:fr:cc:successions:par:q33:S"), @2026-05-31));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DeuxAnsPourLaPreference);
}
