test "urn:query:p3-892-complement-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": bien_indivis_omis(entity_ref("urn:p3:892:a:s")) { origin case_input; }
  assert "f2": heritier_demandeur_partage_complementaire(entity_ref("urn:p3:892:a:s"), entity_ref("urn:p3:892:a:h")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderPartageComplementaire, ACTIVE); }
test "urn:query:p3-892-complement-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
