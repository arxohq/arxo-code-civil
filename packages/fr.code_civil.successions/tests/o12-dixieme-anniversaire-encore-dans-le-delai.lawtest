language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 780 : appréciée le 20 mai 2020, dernier jour des dix ans.
test "urn:query:fr-code-civil-successions-o12-dixieme-anniversaire-encore-dans-le-delai" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:opt:o12:S"), @2010-05-20) { origin case_input; }
        assert "f2": date_d_appreciation_de_l_option(entity_ref("urn:fr:cc:successions:opt:o12:S"), entity_ref("urn:fr:cc:successions:opt:o12:H"), @2020-05-20) { origin case_input; }
    }
    evaluate truth(repute_renoncant(entity_ref("urn:fr:cc:successions:opt:o12:S"), entity_ref("urn:fr:cc:successions:opt:o12:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
