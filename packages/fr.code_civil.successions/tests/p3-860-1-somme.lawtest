language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

test "urn:query:fr-code-civil-successions-p3-860-1-a" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:p3-8601-a:S"), entity_ref("urn:fr:cc:successions:p3-8601-a:H"), entity_ref("urn:fr:cc:successions:p3-8601-a:L"), DonationEnAvancementDePartSuccessorale) { origin case_input; }
        assert "f2": somme_d_argent_donnee(entity_ref("urn:fr:cc:successions:p3-8601-a:S"), entity_ref("urn:fr:cc:successions:p3-8601-a:L"), 30000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(P3DevoirRapporterSomme8601Actif, ACTIVE);
}

test "urn:query:fr-code-civil-successions-p3-860-1-b" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:p3-8601-b:S"), entity_ref("urn:fr:cc:successions:p3-8601-b:H"), entity_ref("urn:fr:cc:successions:p3-8601-b:L"), DonationEnAvancementDePartSuccessorale) { origin case_input; }
        assert "f2": somme_d_argent_donnee(entity_ref("urn:fr:cc:successions:p3-8601-b:S"), entity_ref("urn:fr:cc:successions:p3-8601-b:L"), 45000 EUR) { origin case_input; }
    }
    evaluate positions();
    expect position(P3DevoirRapporterSomme8601Actif, ACTIVE);
}
