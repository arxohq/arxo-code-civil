language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-812-5-restitution-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": restitution_exclue(entity_ref("urn:p3:8125restitution:8125restitutiona:m")) { origin case_input; }
  assert "f2": mandataire_designe(entity_ref("urn:p3:8125restitution:8125restitutiona:m"), entity_ref("urn:p3:8125restitution:8125restitutiona:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionDemanderRestitutionApresRevocation, ACTIVE); }
