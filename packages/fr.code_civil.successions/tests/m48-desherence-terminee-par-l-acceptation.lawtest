language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 811-2 : la déshérence prend fin par l'acceptation d'un héritier.
test "urn:query:fr-code-civil-successions-m48-desherence-terminee-par-l-acceptation" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": envoi_en_possession_demande_au_tribunal(entity_ref("urn:fr:cc:successions:adm:m48:S")) { origin case_input; }
        assert "f2": option_exercee_le(entity_ref("urn:fr:cc:successions:adm:m48:S"), entity_ref("urn:fr:cc:successions:adm:m48:P"), AcceptationPureEtSimple, @2026-05-04) { origin case_input; }
    }
    evaluate truth(desherence_terminee(entity_ref("urn:fr:cc:successions:adm:m48:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DesherenceTermineeParLAcceptationPure);
}
