language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 786, alinéa 3 : dette découverte le 28 février 2026 — action en décharge jusqu'au 28 juillet 2026.
test "urn:query:fr-code-civil-successions-o22-cinq-mois-pour-la-decharge" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": connaissance_de_la_dette_le(entity_ref("urn:fr:cc:successions:opt:o22:S"), entity_ref("urn:fr:cc:successions:opt:o22:H"), @2026-02-28) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_decharge(entity_ref("urn:fr:cc:successions:opt:o22:S"), entity_ref("urn:fr:cc:successions:opt:o22:H"), @2026-07-28));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CinqMoisPourLaDecharge);
}
