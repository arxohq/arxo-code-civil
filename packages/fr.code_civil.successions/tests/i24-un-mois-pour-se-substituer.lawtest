language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-15 : adjudication du 31 mai 2026 — substitution jusqu'au 30 juin 2026.
test "urn:query:fr-code-civil-successions-i24-un-mois-pour-se-substituer" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": adjudication_le(entity_ref("urn:fr:cc:successions:ind:i24:I"), @2026-05-31) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_substitution(entity_ref("urn:fr:cc:successions:ind:i24:I"), @2026-06-30));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(UnMoisPourSeSubstituer);
}
