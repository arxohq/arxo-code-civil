language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 748 al. 1 : dans la branche maternelle, l arrière-grand-mère seule : 1/2.
test "urn:query:fr-code-civil-successions-g02-fente-branche-maternelle-arriere-grand-mere" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:g:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:g:F"), entity_ref("urn:fr:cc:successions:g:P"), entity_ref("urn:fr:cc:successions:g:D")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:g:F"), entity_ref("urn:fr:cc:successions:g:M"), entity_ref("urn:fr:cc:successions:g:D")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:g:F"), entity_ref("urn:fr:cc:successions:g:GF"), entity_ref("urn:fr:cc:successions:g:P")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:g:F"), entity_ref("urn:fr:cc:successions:g:GM"), entity_ref("urn:fr:cc:successions:g:P")) { origin case_input; }
        assert "f8": filiation(entity_ref("urn:fr:cc:successions:g:F"), entity_ref("urn:fr:cc:successions:g:MGM"), entity_ref("urn:fr:cc:successions:g:M")) { origin case_input; }
        assert "f9": filiation(entity_ref("urn:fr:cc:successions:g:F"), entity_ref("urn:fr:cc:successions:g:MGGM"), entity_ref("urn:fr:cc:successions:g:MGM")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:GF")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:GM")) { origin case_input; }
        assert "f12": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:MGGM")) { origin case_input; }
        assert "f13": predecede(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:P")) { origin case_input; }
        assert "f14": predecede(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:M")) { origin case_input; }
        assert "f15": predecede(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:MGM")) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:g:S"), entity_ref("urn:fr:cc:successions:g:MGGM"), 1 / 2));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
}
