language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 732 : le conjoint divorcé n est pas successible ; père et mère moitié chacun (736).
test "urn:query:fr-code-civil-successions-e05-divorce-exclut-le-conjoint" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:e4:S"), entity_ref("urn:fr:cc:successions:e4:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:e4:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:e4:S"), entity_ref("urn:fr:cc:successions:e4:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:e4:F"), entity_ref("urn:fr:cc:successions:e4:P"), entity_ref("urn:fr:cc:successions:e4:D")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:e4:F"), entity_ref("urn:fr:cc:successions:e4:M"), entity_ref("urn:fr:cc:successions:e4:D")) { origin case_input; }
        assert "f6": mariage(entity_ref("urn:fr:cc:successions:e4:F"), entity_ref("urn:fr:cc:successions:e4:D"), entity_ref("urn:fr:cc:successions:e4:E")) { origin case_input; }
        assert "f7": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:e4:S"), entity_ref("urn:fr:cc:successions:e4:E")) { origin case_input; }
        assert "f8": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:e4:S"), entity_ref("urn:fr:cc:successions:e4:P")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:e4:S"), entity_ref("urn:fr:cc:successions:e4:M")) { origin case_input; }
        assert "f10": divorce_prononce(entity_ref("urn:fr:cc:successions:e4:S"), entity_ref("urn:fr:cc:successions:e4:E")) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:e4:S"), entity_ref("urn:fr:cc:successions:e4:P"), 1 / 2));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PereEtMereSansCollateraux);
}
