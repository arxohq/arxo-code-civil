language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 790 : inventaire déposé le 28 février 2026 — dans le délai.
test "urn:query:fr-code-civil-successions-o25-inventaire-depose-le-dernier-jour" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": option_exercee_le(entity_ref("urn:fr:cc:successions:opt:o25:S"), entity_ref("urn:fr:cc:successions:opt:o25:H"), AcceptationAConcurrenceDeLActifNet, @2025-12-31) { origin case_input; }
        assert "f2": inventaire_depose_le(entity_ref("urn:fr:cc:successions:opt:o25:S"), entity_ref("urn:fr:cc:successions:opt:o25:H"), @2026-02-28) { origin case_input; }
    }
    evaluate truth(repute_acceptant_pur_et_simple(entity_ref("urn:fr:cc:successions:opt:o25:S"), entity_ref("urn:fr:cc:successions:opt:o25:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
