language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 815-14, alinéa 2 : préemption notifiée le 28 février 2026.
test "urn:query:fr-code-civil-successions-i19-preemption-le-dernier-jour" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": notification_de_la_cession_le(entity_ref("urn:fr:cc:successions:ind:i19:I"), entity_ref("urn:fr:cc:successions:ind:i19:cedant"), @2026-01-31) { origin case_input; }
        assert "f2": preemption_notifiee_le(entity_ref("urn:fr:cc:successions:ind:i19:I"), entity_ref("urn:fr:cc:successions:ind:i19:p"), @2026-02-28) { origin case_input; }
    }
    evaluate truth(preemption_exercee_a_temps(entity_ref("urn:fr:cc:successions:ind:i19:I"), entity_ref("urn:fr:cc:successions:ind:i19:p")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PreemptionDansLeMois);
}
