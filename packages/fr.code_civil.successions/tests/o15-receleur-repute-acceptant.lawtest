language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 778 : le recel est constaté — réputé acceptant pur et simple malgré sa renonciation.
test "urn:query:fr-code-civil-successions-o15-receleur-repute-acceptant" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": option_exercee_le(entity_ref("urn:fr:cc:successions:opt:o15:S"), entity_ref("urn:fr:cc:successions:opt:o15:H"), Renonciation, @2026-02-01) { origin case_input; }
        assert "f2": recel_ou_dissimulation_constate(entity_ref("urn:fr:cc:successions:opt:o15:S"), entity_ref("urn:fr:cc:successions:opt:o15:H")) { origin adjudicated; }
    }
    evaluate truth(repute_acceptant_pur_et_simple(entity_ref("urn:fr:cc:successions:opt:o15:S"), entity_ref("urn:fr:cc:successions:opt:o15:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ReceleurReputeAcceptant);
}
