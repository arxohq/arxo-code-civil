language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 813, alinéa 2 : un héritier a accepté à concurrence de l'actif net.
test "urn:query:fr-code-civil-successions-m73-designation-judiciaire-obligatoire" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": option_exercee_le(entity_ref("urn:fr:cc:successions:adm:m73:S"), entity_ref("urn:fr:cc:successions:adm:m73:P"), AcceptationAConcurrenceDeLActifNet, @2026-04-01) { origin case_input; }
    }
    evaluate truth(designation_judiciaire_obligatoire(entity_ref("urn:fr:cc:successions:adm:m73:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DesignationJudiciaireObligatoire);
}
