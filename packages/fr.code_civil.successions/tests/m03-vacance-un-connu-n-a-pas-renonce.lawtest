language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 809, 2° : deux renonciations sur trois héritiers connus — pas de vacance.
test "urn:query:fr-code-civil-successions-m03-vacance-un-connu-n-a-pas-renonce" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": nombre_d_heritiers_connus(entity_ref("urn:fr:cc:successions:adm:m03:S"), 3) { origin case_input; }
        assert "f2": nombre_d_heritiers_connus_renoncants(entity_ref("urn:fr:cc:successions:adm:m03:S"), 2) { origin case_input; }
    }
    evaluate truth(succession_vacante(entity_ref("urn:fr:cc:successions:adm:m03:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
