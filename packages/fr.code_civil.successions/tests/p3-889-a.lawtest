language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-889-a" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": part_effectivement_recue(entity_ref("urn:p3:889:889a:s"), entity_ref("urn:p3:889:889a:h"), 20 EUR) { origin case_input; }
  assert "f2": droits_dans_la_masse(entity_ref("urn:p3:889:889a:s"), entity_ref("urn:p3:889:889a:h"), 100 EUR) { origin case_input; }
  assert "f3": partage_realise_le(entity_ref("urn:p3:889:889a:s"), @2026-01-01) { origin case_input; }
  assert "f4": action_en_complement_le(entity_ref("urn:p3:889:889a:s"), entity_ref("urn:p3:889:889a:h"), @2026-02-01) { origin case_input; }
 } evaluate positions(); expect position(P3PositionPouvoirDemanderComplementPart, ACTIVE); }
