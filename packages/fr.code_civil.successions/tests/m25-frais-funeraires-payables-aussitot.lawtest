language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 810-4, alinéa 2 : les frais funéraires n'attendent pas le projet.
test "urn:query:fr-code-civil-successions-m25-frais-funeraires-payables-aussitot" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": dette_a_payer(entity_ref("urn:fr:cc:successions:adm:m25:S"), FraisFuneraires) { origin case_input; }
    }
    evaluate truth(paiement_immediat_permis(entity_ref("urn:fr:cc:successions:adm:m25:S"), FraisFuneraires));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(FraisFunerairesPayablesAussitot);
}
