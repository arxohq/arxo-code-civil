language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-810-4-projet-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": curateur_succession(entity_ref("urn:p3:8104projet:8104projetb:s"), entity_ref("urn:p3:8104projet:8104projetb:p")) { origin case_input; }
  assert "f2": dette_a_payer(entity_ref("urn:p3:8104projet:8104projetb:s"), AutreDetteSuccessorale) { origin case_input; }
  assert "f3": paiement_subordonne_au_projet(entity_ref("urn:p3:8104projet:8104projetb:s"), AutreDetteSuccessorale) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionPayerDetteAvantProjet, ACTIVE); }
