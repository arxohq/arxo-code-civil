language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 884, alinéa 1 : éviction procédant d'une cause antérieure au partage.
test "urn:query:fr-code-civil-successions-q21-garantie-des-lots" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": cause_anterieure_au_partage(entity_ref("urn:fr:cc:successions:par:q21:S"), entity_ref("urn:fr:cc:successions:par:q21:H")) { origin case_input; }
    }
    evaluate truth(garantie_des_lots_due(entity_ref("urn:fr:cc:successions:par:q21:S"), entity_ref("urn:fr:cc:successions:par:q21:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(GarantieDesLots);
}
