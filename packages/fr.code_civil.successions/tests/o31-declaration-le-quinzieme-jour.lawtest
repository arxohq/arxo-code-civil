language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 794 : déclarée le 16 mars 2026, quinzième jour — dans le délai.
test "urn:query:fr-code-civil-successions-o31-declaration-le-quinzieme-jour" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": conservation_ou_alienation_le(entity_ref("urn:fr:cc:successions:opt:o31:S"), entity_ref("urn:fr:cc:successions:opt:o31:H"), @2026-03-01) { origin case_input; }
        assert "f2": declaration_au_tribunal_le(entity_ref("urn:fr:cc:successions:opt:o31:S"), entity_ref("urn:fr:cc:successions:opt:o31:H"), @2026-03-16) { origin case_input; }
    }
    evaluate truth(declaration_tardive_au_tribunal(entity_ref("urn:fr:cc:successions:opt:o31:S"), entity_ref("urn:fr:cc:successions:opt:o31:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == NEITHER;
}
