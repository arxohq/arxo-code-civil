language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 757, 753 : conjoint 1/4 en propriété ; souches 3/4 : C1 3/8, petits-enfants 3/16 chacun.
test "urn:query:fr-code-civil-successions-a01-conjoint-quart-avec-souche" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:a:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:a:F"), entity_ref("urn:fr:cc:successions:a:D"), entity_ref("urn:fr:cc:successions:a:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:a:F"), entity_ref("urn:fr:cc:successions:a:D"), entity_ref("urn:fr:cc:successions:a:C2")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:a:F"), entity_ref("urn:fr:cc:successions:a:E"), entity_ref("urn:fr:cc:successions:a:C1")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:a:F"), entity_ref("urn:fr:cc:successions:a:E"), entity_ref("urn:fr:cc:successions:a:C2")) { origin case_input; }
        assert "f8": filiation(entity_ref("urn:fr:cc:successions:a:F"), entity_ref("urn:fr:cc:successions:a:C2"), entity_ref("urn:fr:cc:successions:a:G1")) { origin case_input; }
        assert "f9": filiation(entity_ref("urn:fr:cc:successions:a:F"), entity_ref("urn:fr:cc:successions:a:C2"), entity_ref("urn:fr:cc:successions:a:G2")) { origin case_input; }
        assert "f10": mariage(entity_ref("urn:fr:cc:successions:a:F"), entity_ref("urn:fr:cc:successions:a:D"), entity_ref("urn:fr:cc:successions:a:E")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:E")) { origin case_input; }
        assert "f12": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:C1")) { origin case_input; }
        assert "f13": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:G1")) { origin case_input; }
        assert "f14": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:G2")) { origin case_input; }
        assert "f15": predecede(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:C2")) { origin case_input; }
        assert "f16": option_du_conjoint(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:E"), QuartEnPropriete) { origin case_input; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:a:S"), entity_ref("urn:fr:cc:successions:a:E"), 1 / 4));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PartDuConjointQuart);
}
