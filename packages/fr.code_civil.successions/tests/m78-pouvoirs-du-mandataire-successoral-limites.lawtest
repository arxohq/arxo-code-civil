language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 813-4 : tant qu'aucun héritier n'a accepté.
test "urn:query:fr-code-civil-successions-m78-pouvoirs-du-mandataire-successoral-limites" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": motif_de_designation(entity_ref("urn:fr:cc:successions:adm:m78:S"), MesententeEntreLesHeritiers) { origin case_input; }
    }
    evaluate truth(pouvoirs_du_mandataire_successoral_limites_a_784(entity_ref("urn:fr:cc:successions:adm:m78:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PouvoirsDuMandataireSuccessoralLimites);
}
