language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 777 : dol découvert le 1er avril 2025 — action prescrite le 1er avril 2030.
test "urn:query:fr-code-civil-successions-o10-cinq-ans-pour-la-nullite-de-l-option" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": vice_decouvert_ou_violence_cessee_le(entity_ref("urn:fr:cc:successions:opt:o10:S"), entity_ref("urn:fr:cc:successions:opt:o10:H"), @2025-04-01) { origin case_input; }
    }
    evaluate truth(nullite_de_l_option_prescrite_le(entity_ref("urn:fr:cc:successions:opt:o10:S"), entity_ref("urn:fr:cc:successions:opt:o10:H"), @2030-04-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CinqAnsPourLaNulliteDeLOption);
}
