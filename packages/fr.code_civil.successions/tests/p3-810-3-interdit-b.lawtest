language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";
test "urn:query:p3-810-3-interdit-b" { given { context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
  assert "f1": adjudication_obligatoire(entity_ref("urn:p3:8103i:8103interditb:s")) { origin case_input; }
  assert "f2": adjudication_exigee_par(entity_ref("urn:p3:8103i:8103interditb:s"), entity_ref("urn:p3:8103i:8103interditb:p")) { origin case_input; }
 } evaluate positions(); expect position(P3PositionInterdictionVenteSansAdjudication, ACTIVE); }
