language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 809-1 : succession vacante et requête du ministère public.
test "urn:query:fr-code-civil-successions-m09-curatelle-confiee-au-domaine" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": aucun_reclamant_ni_heritier_connu_constate(entity_ref("urn:fr:cc:successions:adm:m09:S")) { origin adjudicated; }
        assert "f2": requete_presentee_par(entity_ref("urn:fr:cc:successions:adm:m09:S"), entity_ref("urn:fr:cc:successions:adm:m09:P"), MinisterePublic) { origin case_input; }
    }
    evaluate truth(curatelle_confiee_a_l_autorite_du_domaine(entity_ref("urn:fr:cc:successions:adm:m09:S")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(CuratelleConfiee);
}
