language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 813-7 : manquement caractérisé du mandataire successoral.
test "urn:query:fr-code-civil-successions-m80-dessaisissement-pour-manquement" {
    given {
        context { decision_time @2026-09-17T09:00:00Z; knowledge_time @2026-09-17T09:00:00Z; legal_time @2026-09-17; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": manquement_caracterise_constate(entity_ref("urn:fr:cc:successions:adm:m80:S"), entity_ref("urn:fr:cc:successions:adm:m80:P")) { origin adjudicated; }
    }
    evaluate truth(dessaisissement_du_mandataire_possible(entity_ref("urn:fr:cc:successions:adm:m80:S"), entity_ref("urn:fr:cc:successions:adm:m80:P")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(DessaisissementPourManquement);
}
