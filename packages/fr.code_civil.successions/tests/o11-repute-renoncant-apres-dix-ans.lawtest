language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 780 : succession ouverte le 20 mai 2010, aucune option, appréciée le 21 mai 2020 — réputé renonçant.
test "urn:query:fr-code-civil-successions-o11-repute-renoncant-apres-dix-ans" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": ouverte_le(entity_ref("urn:fr:cc:successions:opt:o11:S"), @2010-05-20) { origin case_input; }
        assert "f2": date_d_appreciation_de_l_option(entity_ref("urn:fr:cc:successions:opt:o11:S"), entity_ref("urn:fr:cc:successions:opt:o11:H"), @2020-05-21) { origin case_input; }
    }
    evaluate truth(repute_renoncant(entity_ref("urn:fr:cc:successions:opt:o11:S"), entity_ref("urn:fr:cc:successions:opt:o11:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ReputeRenoncantApresDixAns);
}
