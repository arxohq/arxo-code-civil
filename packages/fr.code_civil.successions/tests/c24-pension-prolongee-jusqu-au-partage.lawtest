language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 767 : indivision, partage achevé le 1er janvier 2028 — le délai se prolonge jusque-là.
test "urn:query:fr-code-civil-successions-c24-pension-prolongee-jusqu-au-partage" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:cj:c24:S"), entity_ref("urn:fr:cc:successions:cj:c24:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:cj:c24:S"), @2026-03-31) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:cj:c24:S"), entity_ref("urn:fr:cc:successions:cj:c24:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:cj:c24:F"), entity_ref("urn:fr:cc:successions:cj:c24:D"), entity_ref("urn:fr:cc:successions:cj:c24:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:cj:c24:F"), entity_ref("urn:fr:cc:successions:cj:c24:E"), entity_ref("urn:fr:cc:successions:cj:c24:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:cj:c24:F"), entity_ref("urn:fr:cc:successions:cj:c24:D"), entity_ref("urn:fr:cc:successions:cj:c24:C2")) { origin case_input; }
        assert "f7": filiation(entity_ref("urn:fr:cc:successions:cj:c24:F"), entity_ref("urn:fr:cc:successions:cj:c24:E"), entity_ref("urn:fr:cc:successions:cj:c24:C2")) { origin case_input; }
        assert "f8": mariage(entity_ref("urn:fr:cc:successions:cj:c24:F"), entity_ref("urn:fr:cc:successions:cj:c24:D"), entity_ref("urn:fr:cc:successions:cj:c24:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c24:S"), entity_ref("urn:fr:cc:successions:cj:c24:E")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c24:S"), entity_ref("urn:fr:cc:successions:cj:c24:C1")) { origin case_input; }
        assert "f11": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:cj:c24:S"), entity_ref("urn:fr:cc:successions:cj:c24:C2")) { origin case_input; }
        assert "f12": indivision_jusqu_au_partage(entity_ref("urn:fr:cc:successions:cj:c24:S")) { origin case_input; }
        assert "f13": partage_definitif_le(entity_ref("urn:fr:cc:successions:cj:c24:S"), @2028-01-01) { origin case_input; }
    }
    evaluate truth(fin_du_delai_de_la_pension(entity_ref("urn:fr:cc:successions:cj:c24:S"), entity_ref("urn:fr:cc:successions:cj:c24:E"), @2028-01-01));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(PensionDuConjointProlongeeJusquAuPartage);
}
