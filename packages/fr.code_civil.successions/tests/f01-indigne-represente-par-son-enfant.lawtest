language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 726, 755 : l indigne vivant est représenté par son enfant : G 1/2.
test "urn:query:fr-code-civil-successions-f01-indigne-represente-par-son-enfant" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:f:S"), entity_ref("urn:fr:cc:successions:f:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:f:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:f:S"), entity_ref("urn:fr:cc:successions:f:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:f:F"), entity_ref("urn:fr:cc:successions:f:D"), entity_ref("urn:fr:cc:successions:f:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:f:F"), entity_ref("urn:fr:cc:successions:f:D"), entity_ref("urn:fr:cc:successions:f:C2")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:f:F"), entity_ref("urn:fr:cc:successions:f:C1"), entity_ref("urn:fr:cc:successions:f:G")) { origin case_input; }
        assert "f7": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:f:S"), entity_ref("urn:fr:cc:successions:f:C1")) { origin case_input; }
        assert "f8": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:f:S"), entity_ref("urn:fr:cc:successions:f:C2")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:f:S"), entity_ref("urn:fr:cc:successions:f:G")) { origin case_input; }
        assert "j1": condamne_peine_criminelle_mort_volontaire(entity_ref("urn:fr:cc:successions:f:S"), entity_ref("urn:fr:cc:successions:f:C1")) { origin adjudicated; }
    }
    evaluate truth(part_hereditaire(entity_ref("urn:fr:cc:successions:f:S"), entity_ref("urn:fr:cc:successions:f:G"), 1 / 2));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RepresentableIndigne);
}
