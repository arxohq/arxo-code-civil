language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 864, alinéa 1 : le copartageant débiteur est alloti de sa dette.
test "urn:query:fr-code-civil-successions-q18-alloti-de-sa-dette" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": creance_de_la_masse_contre(entity_ref("urn:fr:cc:successions:par:q18:S"), entity_ref("urn:fr:cc:successions:par:q18:H"), 50000 EUR) { origin case_input; }
        assert "f2": droits_dans_la_masse(entity_ref("urn:fr:cc:successions:par:q18:S"), entity_ref("urn:fr:cc:successions:par:q18:H"), 30000 EUR) { origin case_input; }
    }
    evaluate truth(alloti_de_sa_dette(entity_ref("urn:fr:cc:successions:par:q18:S"), entity_ref("urn:fr:cc:successions:par:q18:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(AllotiDeSaDette);
}
