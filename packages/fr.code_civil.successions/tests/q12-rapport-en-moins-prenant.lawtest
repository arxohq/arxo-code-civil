language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 858 : le rapport se fait en moins prenant.
test "urn:query:fr-code-civil-successions-q12-rapport-en-moins-prenant" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:par:q12:S"), entity_ref("urn:fr:cc:successions:par:q12:H"), entity_ref("urn:fr:cc:successions:par:q12:L"), DonationEnAvancementDePartSuccessorale) { origin case_input; }
    }
    evaluate truth(rapport_en_moins_prenant(entity_ref("urn:fr:cc:successions:par:q12:S"), entity_ref("urn:fr:cc:successions:par:q12:H")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(RapportEnMoinsPrenant);
}
