language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 757 : en présence d un enfant non issu des deux époux, le quart en propriété, quelle que soit l option.
test "urn:query:fr-code-civil-successions-i01-enfant-non-commun-quart-impose" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": defunt(entity_ref("urn:fr:cc:successions:i:S"), entity_ref("urn:fr:cc:successions:i:D")) { origin case_input; }
        assert "f2": ouverte_le(entity_ref("urn:fr:cc:successions:i:S"), @2026-03-01) { origin case_input; }
        assert "f3": famille(entity_ref("urn:fr:cc:successions:i:S"), entity_ref("urn:fr:cc:successions:i:F")) { origin case_input; }
        assert "f4": filiation(entity_ref("urn:fr:cc:successions:i:F"), entity_ref("urn:fr:cc:successions:i:D"), entity_ref("urn:fr:cc:successions:i:C1")) { origin case_input; }
        assert "f5": filiation(entity_ref("urn:fr:cc:successions:i:F"), entity_ref("urn:fr:cc:successions:i:E"), entity_ref("urn:fr:cc:successions:i:C1")) { origin case_input; }
        assert "f6": filiation(entity_ref("urn:fr:cc:successions:i:F"), entity_ref("urn:fr:cc:successions:i:D"), entity_ref("urn:fr:cc:successions:i:C2")) { origin case_input; }
        assert "f7": mariage(entity_ref("urn:fr:cc:successions:i:F"), entity_ref("urn:fr:cc:successions:i:D"), entity_ref("urn:fr:cc:successions:i:E")) { origin case_input; }
        assert "f8": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:i:S"), entity_ref("urn:fr:cc:successions:i:E")) { origin case_input; }
        assert "f9": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:i:S"), entity_ref("urn:fr:cc:successions:i:C1")) { origin case_input; }
        assert "f10": existe_a_l_ouverture(entity_ref("urn:fr:cc:successions:i:S"), entity_ref("urn:fr:cc:successions:i:C2")) { origin case_input; }
        assert "f11": option_du_conjoint(entity_ref("urn:fr:cc:successions:i:S"), entity_ref("urn:fr:cc:successions:i:E"), Usufruit) { origin case_input; }
    }
    evaluate truth(droits_du_conjoint(entity_ref("urn:fr:cc:successions:i:S"), entity_ref("urn:fr:cc:successions:i:E"), QuartEnPropriete));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(ConjointQuartImpose);
}
