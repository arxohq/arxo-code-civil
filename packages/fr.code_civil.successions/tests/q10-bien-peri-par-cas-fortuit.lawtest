language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

// Art. 855, alinéa 1 : le bien donné a péri par cas fortuit, sans faute du donataire.
test "urn:query:fr-code-civil-successions-q10-bien-peri-par-cas-fortuit" {
    given {
        context { decision_time @2026-09-16T09:00:00Z; knowledge_time @2026-09-16T09:00:00Z; legal_time @2026-09-16; timezone "Europe/Paris"; deadline_policy CC_SUCCESSIONS_CALENDRIER; }
        assert "f1": liberalite_recue(entity_ref("urn:fr:cc:successions:par:q10:S"), entity_ref("urn:fr:cc:successions:par:q10:H"), entity_ref("urn:fr:cc:successions:par:q10:L"), DonationEnAvancementDePartSuccessorale) { origin case_input; }
        assert "f2": bien_peri_par_cas_fortuit(entity_ref("urn:fr:cc:successions:par:q10:S"), entity_ref("urn:fr:cc:successions:par:q10:L")) { origin case_input; }
    }
    evaluate truth(dispense_de_rapport(entity_ref("urn:fr:cc:successions:par:q10:S"), entity_ref("urn:fr:cc:successions:par:q10:L")));
    expect evaluation_status == COMPUTED;
    expect truth_status == TRUE_ONLY;
    expect applied(BienPeriParCasFortuit);
}
