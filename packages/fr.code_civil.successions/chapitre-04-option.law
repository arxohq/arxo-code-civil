// CHAPITRE IV — DE L'OPTION DE L'HÉRITIER (articles 768 à 808).
//
// L'option est un calendrier. Le chapitre fixe à quel moment l'héritier peut
// être pressé et ce qui arrive s'il se tait :
//
//   — quatre mois depuis l'ouverture avant toute sommation (771) ; deux mois
//     après la sommation, faute de quoi il est réputé acceptant pur et simple
//     (772) ; l'héritier subséquent et les héritiers de l'héritier décédé
//     sans opter ont leurs quatre mois propres (774, 775) ;
//   — dix ans pour opter, faute de quoi il est réputé renonçant, avec les
//     points de départ différés de l'article 780 ;
//   — cinq ans pour attaquer l'option viciée (777) ;
//   — acceptation pure et simple par cession ou renonciation « in favorem »
//     (783), actes conservatoires qui n'emportent pas acceptation (784), et
//     l'irrévocabilité de l'acceptation, sauf décharge d'une dette ignorée
//     demandée dans les cinq mois (786) ;
//   — l'acceptation à concurrence de l'actif net : inventaire dans les deux
//     mois (790), déclaration des créanciers dans les quinze mois (792),
//     quinze jours pour déclarer la conservation ou l'aliénation et trois
//     mois pour la contester (794), deux mois pour payer (797), déchéance
//     pour omission de mauvaise foi (800) ;
//   — la renonciation, qui ne se présume pas, et sa révocation (804 à 807).
//
// Le recel (778) et la mauvaise foi (800) sont des faits constatés par le juge
// (origine `adjudicated`) ; les motifs « sérieux et légitimes » d'une
// prorogation (772, 790) sont une appréciation (jugement §47.3). Le paquet ne
// fabrique jamais un silence : l'absence d'option ou d'inventaire est
// constatée, pas déduite d'un dossier vide.

language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

use self::{
    CC_ART768,
    CC_ART770,
    CC_ART771,
    CC_ART772,
    CC_ART774,
    CC_ART775,
    CC_ART777,
    CC_ART778,
    CC_ART780,
    CC_ART783,
    CC_ART784,
    CC_ART786,
    CC_ART790,
    CC_ART792,
    CC_ART792_1,
    CC_ART792_2,
    CC_ART793,
    CC_ART794,
    CC_ART795,
    CC_ART796,
    CC_ART797,
    CC_ART800,
    CC_ART801,
    CC_ART806,
    CC_ART807,
    Personne,
    Succession,
    ouverte_le,
};

pub enum ModaliteDeLOption {
    label fr official "Modalité de l'option de l'héritier (article 768)";
    label en unofficial "Form of the heir's option (Article 768)";
    AcceptationPureEtSimple,
    AcceptationAConcurrenceDeLActifNet,
    Renonciation
}

@source(CC_ART807)
rule P3PouvoirRevoquerRenonciation(s: Succession, h: Personne) strict {
    label fr official "Article 807. L'héritier peut révoquer sa renonciation";
    label en unofficial "Article 807. The heir may revoke the renunciation";
    when revocation_de_la_renonciation_possible(s, h);
    then power P3PositionPouvoirRevoquerRenonciation {
        holder h;
        over s;
        exercise revocation_renonciation_exercee(s, h);
        effect renonciation_revoquee(s, h);
        valid_when revocation_de_la_renonciation_possible(s, h);
        window [@2016-10-01, infinity];
    };
}

@source(CC_ART806)
rule P3DevoirPayerFraisFunerairesRenoncant(s: Succession, h: Personne) strict {
    label fr official "Article 806. Le renonçant reste tenu des frais funéraires de l'ascendant ou du descendant";
    label en unofficial "Article 806. The renouncing heir remains liable for funeral expenses";
    when tenu_des_frais_funeraires(s, h);
    then duty P3PositionDevoirPayerFraisFunerairesRenoncant {
        bearer h;
        goal achievement {
            condition frais_funeraires_exercee(s, h);
            window [@2016-10-01, infinity];
        };
    };
}

@source(CC_ART768, CC_ART780)
rule P3PouvoirExercerOption(s: Succession, h: Personne, fin: Date) strict {
    label fr official "Articles 768 et 780. L'héritier peut exercer l'option dans le délai de dix ans";
    label en unofficial "Articles 768 and 780. The heir may exercise the option within ten years";
    when fin_de_la_faculte_d_option(s, h, fin);
    then power P3PositionPouvoirExercerOption {
        holder h;
        over s;
        exercise option_exercee_le(s, h, AcceptationPureEtSimple, fin);
        effect option_de_l_heritier_exercee(s, h, fin);
        valid_when fin_de_la_faculte_d_option(s, h, fin);
        window [@2016-10-01, infinity];
    };
}

pub enum ActeDuSuccessible {
    label fr official "Acte accompli par le successible, dont il faut dire s'il emporte acceptation (articles 783, 784)";
    label en unofficial "Act done by the successor, to be classified as implying acceptance or not (Articles 783, 784)";
    CessionDeSesDroitsSuccessifs,
    RenonciationAuProfitDeCoheritiersDetermines,
    RenonciationATitreOnereux,
    PaiementDesFraisFunerairesOuDettesUrgentes,
    RecouvrementDesFruitsOuVenteDeBiensPerissables,
    ActeEvitantLAggravationDuPassif,
    RuptureDuContratDuSalarieDuDefunt,
    OperationCouranteDeLEntreprise,
    RenouvellementDeBail
}

// --- Entrées du cas --------------------------------------------------------------------------

pub relation option_exercee_le(s: Succession, h: Personne, modalite: ModaliteDeLOption, jour: Date) kind empirical {
    label fr official "l'héritier a exercé cette option ce jour (articles 768, 782, 787, 804)";
    label en unofficial "the heir exercised this option on this day (Articles 768, 782, 787, 804)";
}
pub relation frais_funeraires_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "paiement des frais funéraires exercé";
    label en unofficial "funeral expenses payment exercised";
}
pub relation option_conditionnelle_ou_a_terme(s: Succession, h: Personne) kind empirical {
    label fr official "l'option a été exercée sous condition ou à terme (article 768, alinéa 2)";
    label en unofficial "the option was exercised subject to a condition or a term (Article 768, paragraph 2)";
}
pub relation sommation_d_opter_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour de la sommation extrajudiciaire de prendre parti (article 771, alinéa 2)";
    label en unofficial "day of the extrajudicial notice to take a decision (Article 771, paragraph 2)";
}
pub relation aucune_option_ni_prorogation_constatee(s: Succession, h: Personne) kind empirical {
    origin adjudicated;
    label fr official "il est constaté que l'héritier n'a ni pris parti ni sollicité de délai supplémentaire (article 772)";
    label en unofficial "it is established that the heir neither decided nor applied for more time (Article 772)";
}
pub relation date_d_appreciation_de_l_option(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour auquel la situation de l'héritier est appréciée";
    label en unofficial "day on which the heir's situation is assessed";
}
pub relation connaissance_de_la_renonciation_ou_de_l_indignite_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour où l'héritier de rang subséquent a eu connaissance de la renonciation ou de l'indignité de l'héritier de premier rang (article 774)";
    label en unofficial "day the subsequent-rank heir learned of the first-rank heir's renunciation or unworthiness (Article 774)";
}
pub relation heritier_de_l_heritier_decede_sans_opter(s: Succession, h: Personne, succession_du_defunt_heritier: Succession) kind empirical {
    key(s, h);
    label fr official "l'héritier agit du chef d'un héritier décédé sans avoir opté, dont la succession est celle-ci (article 775)";
    label en unofficial "the heir acts on behalf of an heir who died without opting, whose estate is this one (Article 775)";
}
pub relation vice_decouvert_ou_violence_cessee_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour où l'erreur ou le dol a été découvert, ou où la violence a cessé (article 777)";
    label en unofficial "day the mistake or fraud was discovered, or the duress ended (Article 777)";
}
pub relation recel_ou_dissimulation_constate(s: Succession, h: Personne) kind empirical {
    origin adjudicated;
    label fr official "l'héritier a recelé des biens ou dissimulé l'existence d'un cohéritier (article 778)";
    label en unofficial "the heir concealed estate property or hid a co-heir's existence (Article 778)";
}
pub relation conjoint_laisse_en_jouissance(s: Succession, h: Personne, succession_du_conjoint: Succession) kind empirical {
    key(s, h);
    label fr official "l'héritier a laissé le conjoint survivant en jouissance des biens héréditaires ; la succession du conjoint est celle-ci (article 780, alinéa 3)";
    label en unofficial "the heir left the surviving spouse in enjoyment of the estate; the spouse's estate is this one (Article 780, paragraph 3)";
}
pub relation acte_accompli(s: Succession, h: Personne, acte: ActeDuSuccessible) kind empirical {
    label fr official "acte accompli par le successible (articles 783, 784)";
    label en unofficial "act done by the successor (Articles 783, 784)";
}
pub relation titre_ou_qualite_d_heritier_pris(s: Succession, h: Personne) kind empirical {
    label fr official "le successible a pris le titre ou la qualité d'héritier dans l'acte (article 784)";
    label en unofficial "the successor took the title or capacity of heir in the act (Article 784)";
}
pub relation connaissance_de_la_dette_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour où l'héritier a eu connaissance de l'existence et de l'importance de la dette (article 786)";
    label en unofficial "day the heir learned of the debt's existence and size (Article 786)";
}
pub relation inventaire_depose_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour du dépôt de l'inventaire au tribunal (article 790)";
    label en unofficial "day the inventory was filed with the court (Article 790)";
}
pub relation aucun_inventaire_depose_constate(s: Succession, h: Personne) kind empirical {
    origin adjudicated;
    label fr official "il est constaté qu'aucun inventaire n'a été déposé et qu'aucune prorogation n'a été demandée (article 790)";
    label en unofficial "it is established that no inventory was filed and no extension sought (Article 790)";
}
pub relation publicite_de_la_declaration_le(s: Succession, jour: Date) kind empirical {
    key(s);
    label fr official "jour de la publicité nationale de la déclaration d'acceptation à concurrence de l'actif net (article 788)";
    label en unofficial "day of national publication of the declaration of acceptance up to net assets (Article 788)";
}
pub relation creance_declaree_le(s: Succession, creancier: Personne, jour: Date) kind empirical {
    key(s, creancier);
    label fr official "jour où le créancier successoral a déclaré sa créance au domicile élu (article 792)";
    label en unofficial "day the estate creditor lodged his claim at the chosen address (Article 792)";
}
pub relation creance_assortie_de_surete(s: Succession, creancier: Personne) kind empirical {
    label fr official "la créance est assortie d'une sûreté sur les biens de la succession (article 792)";
    label en unofficial "the claim is secured on estate property (Article 792)";
}
pub relation creancier_successoral(s: Succession, creancier: Personne) kind empirical {
    label fr official "créancier de la succession";
    label en unofficial "estate creditor";
}
pub relation conservation_ou_alienation_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour de la décision de conserver ou d'aliéner un bien de la succession (article 794)";
    label en unofficial "day of the decision to keep or sell an estate asset (Article 794)";
}
pub relation declaration_au_tribunal_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour de la déclaration de la conservation ou de l'aliénation au tribunal (article 794)";
    label en unofficial "day the keeping or sale was declared to the court (Article 794)";
}
pub relation omission_de_mauvaise_foi_constatee(s: Succession, h: Personne) kind empirical {
    origin adjudicated;
    label fr official "l'héritier a omis sciemment et de mauvaise foi des éléments de l'inventaire, ou n'a pas affecté aux créanciers la valeur des biens (article 800, alinéa 4)";
    label en unofficial "the heir knowingly and in bad faith left items out of the inventory, or did not apply asset values to creditors (Article 800, paragraph 4)";
}
pub relation deja_acceptee_par_un_autre_ou_etat_envoye(s: Succession) kind empirical {
    label fr official "la succession a déjà été acceptée par un autre héritier, ou l'État a été envoyé en possession (article 807)";
    label en unofficial "the estate was already accepted by another heir, or the State was put in possession (Article 807)";
}
pub relation frais_funeraires_d_un_ascendant_ou_descendant(s: Succession) kind empirical {
    label fr official "la succession est celle d'un ascendant ou d'un descendant du renonçant, avec des frais funéraires (article 806)";
    label en unofficial "the estate is that of an ascendant or descendant of the renouncing heir, with funeral expenses (Article 806)";
}

// --- Résultats -------------------------------------------------------------------------------

pub relation option_nulle(s: Succession, h: Personne) kind derived {
    label fr official "l'option conditionnelle ou à terme est nulle (article 768, alinéa 2)";
    label en unofficial "a conditional or term option is void (Article 768, paragraph 2)";
}
pub relation option_prematuree_sans_effet(s: Succession, h: Personne) kind derived {
    label fr official "l'option ne peut être exercée avant l'ouverture de la succession (article 770)";
    label en unofficial "the option cannot be exercised before the estate opens (Article 770)";
}
pub relation option_prematuree_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "exercice prématuré de l'option (article 770)";
    label en unofficial "premature exercise of the option (Article 770)";
}
pub relation sommation_possible_a_compter_du(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "premier jour où l'héritier peut être sommé de prendre parti : quatre mois depuis le point de départ (articles 771, 774, 775)";
    label en unofficial "first day the heir can be given notice to decide: four months from the starting point (Articles 771, 774, 775)";
}
pub relation sommation_prematuree(s: Succession, h: Personne) kind derived {
    label fr official "la sommation est faite avant l'expiration du délai de quatre mois (article 771)";
    label en unofficial "the notice was given before the four-month period expired (Article 771)";
}
pub relation fin_du_delai_apres_sommation(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "dernier jour des deux mois qui suivent la sommation (article 772)";
    label en unofficial "last day of the two months following the notice (Article 772)";
}
pub relation repute_acceptant_pur_et_simple(s: Succession, h: Personne) kind derived {
    label fr official "l'héritier est réputé acceptant pur et simple (articles 772, 778, 790, 800)";
    label en unofficial "the heir is deemed to have accepted outright (Articles 772, 778, 790, 800)";
}
pub relation fin_de_la_faculte_d_option(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "dernier jour des dix ans de la faculté d'option (article 780)";
    label en unofficial "last day of the ten-year option period (Article 780)";
}
pub relation option_de_l_heritier_exercee(s: Succession, h: Personne, jour: Date) kind institutional {
    label fr official "l'héritier a exercé son option dans le délai (articles 768 et 780)";
    label en unofficial "the heir has exercised the option within the time limit (Articles 768 and 780)";
}
pub relation repute_renoncant(s: Succession, h: Personne) kind derived {
    label fr official "l'héritier qui n'a pas pris parti dans les dix ans est réputé renonçant (article 780, alinéa 2)";
    label en unofficial "an heir who did not decide within ten years is deemed to have renounced (Article 780, paragraph 2)";
}
pub relation nullite_de_l_option_prescrite_le(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "l'action en nullité de l'option viciée se prescrit ce jour : cinq ans (article 777)";
    label en unofficial "the action to annul a vitiated option is time-barred on this day: five years (Article 777)";
}
pub relation sans_part_dans_les_biens_receles(s: Succession, h: Personne) kind derived {
    label fr official "le receleur ne peut prétendre à aucune part dans les biens recelés (article 778)";
    label en unofficial "the concealer can claim no share of the concealed property (Article 778)";
}
pub relation reclamation_part_biens_receles_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "réclamation d'une part dans les biens recelés";
    label en unofficial "claim to a share in concealed property";
}
pub relation option_ou_prorogation_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "prise de parti ou demande de délai exercée (article 772)";
    label en unofficial "decision or extension request exercised (Article 772)";
}
pub relation acte_emportant_acceptation(s: Succession, h: Personne) kind derived {
    label fr official "l'acte emporte acceptation pure et simple (article 783)";
    label en unofficial "the act implies outright acceptance (Article 783)";
}
pub relation acte_sans_acceptation(s: Succession, h: Personne) kind derived {
    label fr official "l'acte conservatoire ou d'administration provisoire n'emporte pas acceptation (article 784)";
    label en unofficial "the protective or provisional-management act does not imply acceptance (Article 784)";
}
pub relation decharge_demandee_hors_delai(s: Succession, h: Personne) kind derived {
    label fr official "l'action en décharge d'une dette ignorée n'est pas introduite dans les cinq mois (article 786)";
    label en unofficial "the action for release from an unknown debt was not brought within five months (Article 786)";
}
pub relation fin_du_delai_de_decharge(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "dernier jour des cinq mois pour demander la décharge d'une dette ignorée (article 786)";
    label en unofficial "last day of the five months to seek release from an unknown debt (Article 786)";
}
pub relation fin_du_delai_d_inventaire(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "dernier jour des deux mois pour déposer l'inventaire (article 790)";
    label en unofficial "last day of the two months to file the inventory (Article 790)";
}
pub relation fin_du_delai_de_declaration_des_creances(s: Succession, jour: Date) kind derived {
    key(s);
    label fr official "dernier jour des quinze mois pour déclarer les créances (article 792)";
    label en unofficial "last day of the fifteen months to lodge claims (Article 792)";
}
pub relation creance_eteinte_a_l_egard_de_la_succession(s: Succession, creancier: Personne) kind derived {
    label fr official "la créance non assortie de sûreté et non déclarée dans les quinze mois est éteinte à l'égard de la succession (article 792)";
    label en unofficial "an unsecured claim not lodged within fifteen months is extinguished against the estate (Article 792)";
}
pub relation declaration_tardive_au_tribunal(s: Succession, h: Personne) kind derived {
    label fr official "la conservation ou l'aliénation n'est pas déclarée dans les quinze jours (article 794) : l'aliénation non déclarée engage l'héritier sur ses biens personnels (article 795)";
    label en unofficial "the keeping or sale was not declared within fifteen days (Article 794): an undeclared sale binds the heir's own assets (Article 795)";
}
pub relation fin_du_delai_de_contestation(s: Succession, jour: Date) kind derived {
    key(s);
    label fr official "dernier jour des trois mois pour contester la valeur du bien conservé ou le prix de l'aliénation (article 794)";
    label en unofficial "last day of the three months to challenge the value of the kept asset or the sale price (Article 794)";
}
pub relation fin_du_delai_de_paiement(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "dernier jour des deux mois pour payer les créanciers (article 797)";
    label en unofficial "last day of the two months to pay the creditors (Article 797)";
}
pub relation paiement_creanciers_exerce(s: Succession, h: Personne) kind empirical {
    label fr official "paiement des créanciers de la succession exercé";
    label en unofficial "estate creditors paid";
}
pub relation contestation_valeur_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "contestation de la valeur ou du prix exercée";
    label en unofficial "challenge to value or price exercised";
}
pub relation valeur_ou_prix_conteste(s: Succession, h: Personne) kind institutional {
    label fr official "le créancier successoral a contesté la valeur ou le prix déclaré (article 794)";
    label en unofficial "the estate creditor has contested the declared value or price (Article 794)";
}
pub relation action_nullite_option_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "action en nullité de l'option exercée";
    label en unofficial "action to annul the option exercised";
}
pub relation nullite_de_l_option_demandee(s: Succession, h: Personne) kind institutional {
    label fr official "l'héritier a exercé l'action en nullité de son option (article 777)";
    label en unofficial "the heir has brought the action for nullity of the option (Article 777)";
}
pub relation action_decharge_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "action en décharge de la dette exercée";
    label en unofficial "release action for the debt exercised";
}
pub relation heritage_regle_passif_exerce(s: Succession, h: Personne) kind empirical {
    label fr official "règlement du passif de la succession exercé";
    label en unofficial "estate liabilities settled";
}
pub relation heritier_regleur(s: Succession, h: Personne) kind empirical {
    label fr official "héritier chargé du règlement du passif";
    label en unofficial "heir responsible for settling liabilities";
}
@source(CC_ART795)
pub relation declaration_conservation_non_publiee(s: Succession, h: Personne) kind empirical {
    label fr official "déclaration de conservation non publiée";
    label en unofficial "unpublished retention declaration";
}
pub relation declaration_conservation_opposable_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "opposabilité de la déclaration de conservation exercée";
    label en unofficial "opposability of the retention declaration exercised";
}
pub relation sommation_prematuree_exercee(s: Succession, h: Personne) kind empirical {
    label fr official "sommation prématurée d'opter exercée";
    label en unofficial "premature notice to decide exercised";
}
pub relation renonciation_impossible(s: Succession, h: Personne) kind derived {
    label fr official "l'acceptation, pure et simple ou à concurrence de l'actif net, empêche toute renonciation (articles 786, 801)";
    label en unofficial "acceptance, outright or up to net assets, prevents any renunciation (Articles 786, 801)";
}
