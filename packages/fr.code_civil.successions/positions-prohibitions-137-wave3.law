@source(CC_ART765)
pub relation violation_recompenser_excedent_droit_viager(s: Succession, c: Personne) kind derived {
    label fr official "Article 765. récompense excédant le droit viager exercée";
    label en unofficial "Article 765. reward exceeding the life interest exercised";
