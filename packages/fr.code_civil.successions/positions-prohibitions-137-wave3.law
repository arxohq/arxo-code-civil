@source(CC_ART792_1)
pub relation violation_voie_execution_pendant_declaration(s: Succession, h: Personne) kind derived {
    label fr official "Article 792-1. voie d'exécution pendant la déclaration";
    label en unofficial "Article 792-1. enforcement during the declaration";
}
@source(CC_ART792_1)
rule P3Wave3ViolationVoieExecutionPendantDeclaration(s: Succession, h: Personne) strict {
    label fr official "Article 792-1. interdiction de la voie d'exécution pendant la déclaration";
    label en unofficial "Article 792-1. prohibition on enforcement during the declaration";
    when voie_execution_ou_surete_exercee(s, h);
    then violation_voie_execution_pendant_declaration(s, h);
}
@source(CC_ART792_1)
rule DeriveP3Wave3MaintenanceVoieExecutionPendantDeclaration(
    s: Succession, h: Personne, publicite: Date
) strict {
    label fr official "Article 792-1. devoir de maintenir l'interdiction de l'exécution pendant la déclaration";
    label en unofficial "Article 792-1. duty to maintain the prohibition on enforcement during the declaration";
    when publicite_de_la_declaration_le(s, publicite) and creancier_successoral(s, h);
    then duty P3Wave3MaintenanceVoieExecutionPendantDeclaration {
        bearer h;
        goal maintenance {
            condition not voie_execution_ou_surete_exercee(s, h);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART801)
pub relation violation_renoncer_apres_actif_net(s: Succession, h: Personne) kind derived {
    label fr official "Article 801. renonciation après l'acceptation à concurrence de l'actif net";
    label en unofficial "Article 801. renunciation after acceptance up to net assets";
}
@source(CC_ART801)
rule P3Wave3ViolationRenoncerApresActifNet(s: Succession, h: Personne) strict {
    label fr official "Article 801. interdiction de renoncer après l'acceptation à concurrence de l'actif net";
    label en unofficial "Article 801. prohibition on renouncing after acceptance up to net assets";
    when renonciation_exercee(s, h);
    then violation_renoncer_apres_actif_net(s, h);
}
@source(CC_ART801)
rule DeriveP3Wave3MaintenanceRenoncerApresActifNet(s: Succession, h: Personne, jour: Date) strict {
    label fr official "Article 801. devoir de maintenir l'interdiction de renoncer après acceptation";
    label en unofficial "Article 801. duty to maintain the prohibition on renouncing after acceptance";
    when option_exercee_le(s, h, AcceptationAConcurrenceDeLActifNet, jour);
    then duty P3Wave3MaintenanceRenoncerApresActifNet {
        bearer h;
        goal maintenance {
            condition not renonciation_exercee(s, h);
            window [@2016-10-01, infinity);
        }
    };
}
