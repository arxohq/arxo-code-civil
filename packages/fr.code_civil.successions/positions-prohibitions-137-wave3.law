}
@source(CC_ART778)
rule DeriveP3Wave3MaintenanceReclamerBiensReceles(s: Succession, h: Personne) strict {
    label fr official "Article 778. devoir de maintenir l'interdiction de réclamer les biens recelés";
    label en unofficial "Article 778. duty to maintain the prohibition on claiming concealed assets";
    when recel_ou_dissimulation_constate(s, h);
    then duty P3Wave3MaintenanceReclamerBiensReceles {
        bearer h;
        goal maintenance {
            condition not reclamation_part_biens_receles_exercee(s, h);
