@source(CC_ART771)
rule P3Wave3ViolationSommationAvantQuatreMois(s: Succession, h: Personne) strict {
    label fr official "Article 771. interdiction de la sommation avant quatre mois";
    label en unofficial "Article 771. prohibition on summons before four months";
    when sommation_prematuree_exercee(s, h);
    then violation_sommation_avant_quatre_mois(s, h);
}
@source(CC_ART771)
rule DeriveP3Wave3MaintenanceSommationAvantQuatreMois(s: Succession, h: Personne) strict {
    label fr official "Article 771. devoir de maintenir l'interdiction de la sommation prématurée";
    label en unofficial "Article 771. duty to maintain the prohibition on premature summons";
    when sommation_prematuree(s, h);
    then duty P3Wave3MaintenanceSommationAvantQuatreMois {
        bearer h;
        goal maintenance {
            condition not sommation_prematuree_exercee(s, h);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART778)
