language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

use self::{
    CC_ART729_1,
    CC_ART758_1,
    CC_ART760,
    CC_ART765,
    CC_ART770,
    CC_ART771,
    CC_ART778,
    CC_ART792_1,
    CC_ART801,
    CC_ART813_2,
    CC_ART813_9,
    CC_ART886,
    ModaliteDeLOption,
    Personne,
    Succession,
    acte_apres_fin_mission_exerce,
    action_en_garantie_prescrite,
    administration_confiee_d_un_commun_accord,
    cession_droits_conjoint_exercee,
    conversion_du_logement_exclue,
    conversion_logement_exercee,
    creancier_successoral,
    designation_conventionnelle_exercee,
    designation_judiciaire_obligatoire,
    droits_incessibles,
    exclu_pour_indignite,
    garantie_eviction_exercee,
    jouissance_parentale_reclamee,
    mandataire_successoral,
    mission_du_mandataire_successoral_terminee,
    option_exercee_le,
    option_prematuree_exercee,
    ouverte_le,
    pas_de_recompense_pour_l_excedent,
    publicite_de_la_declaration_le,
    recel_ou_dissimulation_constate,
    reclamation_part_biens_receles_exercee,
    recompense_excedent_exercee,
    renonciation_exercee,
    sommation_prematuree,
    sommation_prematuree_exercee,
    voie_execution_ou_surete_exercee,
};

// §137 : maintenance и нарушение для оставшихся двенадцати запретов.

@source(CC_ART813_2)
pub relation violation_designation_conventionnelle_mandataire(s: Succession, p: Personne) kind derived {
    label fr official "Article 813-2. désignation conventionnelle du mandataire exercée";
    label en unofficial "Article 813-2. conventional appointment of the representative exercised";
}
@source(CC_ART813_2)
rule P3Wave3ViolationDesignationConventionnelleMandataire(s: Succession, p: Personne) strict {
    label fr official "Article 813-2. interdiction de la désignation conventionnelle exercée";
    label en unofficial "Article 813-2. prohibition on exercising the conventional appointment";
    when designation_conventionnelle_exercee(s, p);
    then violation_designation_conventionnelle_mandataire(s, p);
}
@source(CC_ART813_2)
rule DeriveP3Wave3MaintenanceDesignationConventionnelleMandataire(s: Succession, p: Personne) strict {
    label fr official "Article 813-2. devoir de maintenir l'interdiction de la désignation conventionnelle";
    label en unofficial "Article 813-2. duty to maintain the prohibition on the conventional appointment";
    when designation_judiciaire_obligatoire(s) and administration_confiee_d_un_commun_accord(s, p);
    then duty P3Wave3MaintenanceDesignationConventionnelleMandataire {
        bearer p;
        goal maintenance {
            condition not designation_conventionnelle_exercee(s, p);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART813_9)
pub relation violation_acte_apres_fin_mission(s: Succession, p: Personne) kind derived {
    label fr official "Article 813-9. acte accompli après la fin de la mission";
    label en unofficial "Article 813-9. act performed after the end of the mission";
}
@source(CC_ART813_9)
rule P3Wave3ViolationActeApresFinMission(s: Succession, p: Personne) strict {
    label fr official "Article 813-9. interdiction de l'acte après la fin de la mission";
    label en unofficial "Article 813-9. prohibition on the act after the end of the mission";
    when acte_apres_fin_mission_exerce(s, p);
    then violation_acte_apres_fin_mission(s, p);
}
@source(CC_ART813_9)
rule DeriveP3Wave3MaintenanceActeApresFinMission(s: Succession, p: Personne) strict {
    label fr official "Article 813-9. devoir de maintenir l'interdiction de l'acte après la mission";
    label en unofficial "Article 813-9. duty to maintain the prohibition on the act after the mission";
    when mission_du_mandataire_successoral_terminee(s) and mandataire_successoral(s, p);
    then duty P3Wave3MaintenanceActeApresFinMission {
        bearer p;
        goal maintenance {
            condition not acte_apres_fin_mission_exerce(s, p);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART729_1)
pub relation violation_jouissance_indigne(s: Succession, p: Personne) kind derived {
    label fr official "Article 729-1. jouissance parentale réclamée par l'indigne";
    label en unofficial "Article 729-1. parental enjoyment claimed by the unworthy heir";
}
@source(CC_ART729_1)
rule P3Wave3ViolationJouissanceIndigne(s: Succession, p: Personne) strict {
    label fr official "Article 729-1. interdiction de la jouissance parentale de l'indigne";
    label en unofficial "Article 729-1. prohibition on the unworthy heir's parental enjoyment";
    when jouissance_parentale_reclamee(s, p);
    then violation_jouissance_indigne(s, p);
}
@source(CC_ART729_1)
rule DeriveP3Wave3MaintenanceJouissanceIndigne(s: Succession, p: Personne) strict {
    label fr official "Article 729-1. devoir de maintenir l'interdiction de la jouissance de l'indigne";
    label en unofficial "Article 729-1. duty to maintain the prohibition on the unworthy heir's enjoyment";
    when exclu_pour_indignite(s, p);
    then duty P3Wave3MaintenanceJouissanceIndigne {
        bearer p;
        goal maintenance {
            condition not jouissance_parentale_reclamee(s, p);
            window [@2016-10-01, infinity);
        }
    };
}

