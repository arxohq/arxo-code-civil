@source(CC_ART758_1)
pub relation violation_ceder_droits_conjoint_avant_option(s: Succession, c: Personne) kind derived {
    label fr official "Article 758-1. cession des droits du conjoint avant l'option";
    label en unofficial "Article 758-1. assignment of the spouse's rights before election";
}
@source(CC_ART758_1)
rule P3Wave3ViolationCederDroitsConjointAvantOption(s: Succession, c: Personne) strict {
    label fr official "Article 758-1. interdiction de céder les droits du conjoint avant l'option";
    label en unofficial "Article 758-1. prohibition on assigning the spouse's rights before election";
    when cession_droits_conjoint_exercee(s, c);
    then violation_ceder_droits_conjoint_avant_option(s, c);
}
@source(CC_ART758_1)
rule DeriveP3Wave3MaintenanceCederDroitsConjointAvantOption(s: Succession, c: Personne) strict {
    label fr official "Article 758-1. devoir de maintenir l'interdiction de céder avant l'option";
    label en unofficial "Article 758-1. duty to maintain the prohibition on assignment before election";
    when droits_incessibles(s, c);
    then duty P3Wave3MaintenanceCederDroitsConjointAvantOption {
        bearer c;
        goal maintenance {
            condition not cession_droits_conjoint_exercee(s, c);
