@source(CC_ART886)
rule DeriveP3Wave3MaintenanceActionGarantiePrescrite(s: Succession, h: Personne) strict {
    label fr official "Article 886. devoir de maintenir l'interdiction de l'action prescrite";
    label en unofficial "Article 886. duty to maintain the prohibition on the time-barred action";
