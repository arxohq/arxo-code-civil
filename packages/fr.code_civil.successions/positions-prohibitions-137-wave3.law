@source(CC_ART765)
rule DeriveP3Wave3MaintenanceRecompenserExcedentDroitViager(s: Succession, c: Personne) strict {
    label fr official "Article 765. devoir de maintenir l'interdiction de dépasser le droit viager";
    label en unofficial "Article 765. duty to maintain the prohibition on exceeding the life interest";
    when pas_de_recompense_pour_l_excedent(s, c);
    then duty P3Wave3MaintenanceRecompenserExcedentDroitViager {
        bearer c;
        goal maintenance {
            condition not recompense_excedent_exercee(s, c);
