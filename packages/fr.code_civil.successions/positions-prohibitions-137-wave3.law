@source(CC_ART770)
pub relation violation_option_avant_ouverture(s: Succession, h: Personne) kind derived {
    label fr official "Article 770. option exercée avant l'ouverture";
    label en unofficial "Article 770. election exercised before opening";
}
@source(CC_ART770)
rule P3Wave3ViolationOptionAvantOuverture(s: Succession, h: Personne) strict {
    label fr official "Article 770. interdiction de l'option avant l'ouverture";
    label en unofficial "Article 770. prohibition on election before opening";
    when option_prematuree_exercee(s, h);
    then violation_option_avant_ouverture(s, h);
}
@source(CC_ART770)
rule DeriveP3Wave3MaintenanceOptionAvantOuverture(
    s: Succession, h: Personne, m: ModaliteDeLOption, jour: Date, ouverture: Date
) strict {
    label fr official "Article 770. devoir de maintenir l'interdiction de l'option prématurée";
    label en unofficial "Article 770. duty to maintain the prohibition on premature election";
    when option_exercee_le(s, h, m, jour) and ouverte_le(s, ouverture) and jour < ouverture;
    then duty P3Wave3MaintenanceOptionAvantOuverture {
        bearer h;
        goal maintenance {
            condition not option_prematuree_exercee(s, h);
            window [@2016-10-01, infinity);
        }
    };
}

@source(CC_ART771)
