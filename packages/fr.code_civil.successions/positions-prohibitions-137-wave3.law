@source(CC_ART760)
pub relation violation_conversion_logement_contre_volonte(s: Succession, c: Personne) kind derived {
    label fr official "Article 760. conversion du logement contre la volonté exercée";
    label en unofficial "Article 760. conversion of the dwelling against the will exercised";
}
@source(CC_ART760)
rule P3Wave3ViolationConversionLogementContreVolonte(s: Succession, c: Personne) strict {
    label fr official "Article 760. interdiction de convertir le logement contre la volonté";
    label en unofficial "Article 760. prohibition on converting the dwelling against the will";
    when conversion_logement_exercee(s, c);
    then violation_conversion_logement_contre_volonte(s, c);
}
@source(CC_ART760)
rule DeriveP3Wave3MaintenanceConversionLogementContreVolonte(s: Succession, c: Personne) strict {
    label fr official "Article 760. devoir de maintenir l'interdiction de convertir le logement";
    label en unofficial "Article 760. duty to maintain the prohibition on converting the dwelling";
