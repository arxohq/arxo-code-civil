// CHAPITRE V — DE L'ADMINISTRATION DE LA SUCCESSION : SUCCESSION VACANTE,
// DÉSHÉRENCE, MANDAT À EFFET POSTHUME, MANDATAIRE SUCCESSORAL
// (articles 809 à 814-1).
//
// Trois régimes, un même sujet : QUI agit pour une succession que les
// héritiers n'administrent pas, et JUSQU'OÙ vont ses pouvoirs.
//
//   — la VACANCE (809) a trois causes : personne ne réclame et nul héritier
//     n'est connu ; tous les héritiers connus ont renoncé ; six mois se sont
//     écoulés depuis l'ouverture sans que les héritiers connus aient opté.
//     Le juge confie alors la curatelle à l'autorité chargée du domaine, sur
//     requête d'une personne qualifiée (809-1) ;
//   — les POUVOIRS DU CURATEUR se déplient dans le temps : pendant les six
//     mois qui suivent l'ouverture, actes purement conservatoires, de
//     surveillance, d'administration provisoire et vente des biens
//     périssables (810-1) ; ensuite, l'ensemble des actes conservatoires et
//     d'administration, et la vente jusqu'à l'apurement du passif — la vente
//     d'un bien dont la conservation est difficile ou onéreuse restant
//     possible même le passif apuré (810-2) ;
//   — le PAIEMENT : le curateur paie seul, jusqu'à concurrence de l'actif,
//     et n'anticipe le projet de règlement que pour les frais de conservation,
//     les frais funéraires et de dernière maladie, les impôts, les loyers et
//     les dettes urgentes (810-4) ; le projet suit l'ordre de l'article 796
//     (810-5) ; un mois pour le contester, trois mois pour s'opposer à la
//     réalisation (810-8), deux ans pour le recours contre les légataires
//     remplis (810-9) ;
//   — la DÉSHÉRENCE : l'État demande l'envoi en possession (811), et la
//     déshérence prend fin par l'acceptation d'un héritier (811-2) ;
//   — le MANDAT À EFFET POSTHUME (812 à 812-7) : intérêt sérieux et légitime
//     précisément motivé, forme authentique, acceptation avant le décès du
//     mandant, deux ans — cinq en raison de l'inaptitude, de l'âge ou de
//     biens professionnels —, sept causes d'extinction, et une renonciation
//     qui ne produit effet que trois mois après sa notification ;
//   — le MANDATAIRE SUCCESSORAL (813 à 814-1) : conventionnel entre héritiers,
//     mais judiciaire dès qu'un héritier a accepté à concurrence de l'actif
//     net ; tant que nul n'a accepté, ses pouvoirs sont ceux de l'article 784.
//
// L'ORDRE DE PAIEMENT DE L'ARTICLE 796 est une comparaison, non un montant :
// `paye_avant` se déduit d'abord de la classe (inscrit, déclaré, legs de
// somme d'argent), puis, à classe égale, du rang de la sûreté ou du numéro
// d'ordre de la déclaration. Deux couches, comme le texte.
//
// Le silence n'est jamais fabriqué : l'absence d'option des héritiers connus,
// l'omission des formalités de l'État et le défaut de compte rendu annuel
// sont des faits CONSTATÉS (origine `adjudicated`), non déduits d'un dossier
// vide. L'« intérêt sérieux et légitime » du mandat et le caractère excessif
// d'une rémunération sont des appréciations (jugement §47.3).

language "law.core" version "0.2";
package fr.code_civil.successions version "0.1.0";
namespace "urn:fr:corpus:clir:code-civil-successions";

use self::{
    ActeSurBienIndivis,
    CC_ART787,
    CC_ART796,
    CC_ART809,
    CC_ART809_1,
    CC_ART809_2,
    CC_ART810_1,
    CC_ART810_12,
    CC_ART810_2,
    CC_ART810_3,
    CC_ART810_4,
    CC_ART810_5,
    CC_ART810_8,
    CC_ART810_9,
    CC_ART811,
    CC_ART811_1,
    CC_ART811_2,
    CC_ART811_3,
    CC_ART812,
    CC_ART812_1_1,
    CC_ART812_1_3,
    CC_ART812_2,
    CC_ART812_3,
    CC_ART812_4,
    CC_ART812_5,
    CC_ART812_6,
    CC_ART812_7,
    CC_ART813,
    CC_ART813_1,
    CC_ART813_2,
    CC_ART813_4,
    CC_ART813_7,
    CC_ART813_9,
    CC_ART814,
    CC_ART814_1,
    ModaliteDeLOption,
    Personne,
    Succession,
    creance_declaree_le,
    option_exercee_le,
    ouverte_le,
    partage_realise_le,
};

pub entity Mandat {
    label fr official "Mandat à effet posthume donné par le défunt (articles 812 à 812-7)";
    label en unofficial "Posthumous mandate given by the deceased (Articles 812 to 812-7)";
}

pub enum QualiteDuRequerant {
    label fr official "Qualité de celui qui saisit le juge d'une demande de curatelle (article 809-1)";
    label en unofficial "Capacity of the person applying to the judge for a curatorship (Article 809-1)";
    Creancier,
    AdministrateurDuPatrimoineDuDefunt,
    Notaire,
    AutrePersonneInteressee,
    MinisterePublic,
    TiersSansQualite
}

pub enum ActeDuCurateur {
    label fr official "Acte accompli par le curateur, dont il faut dire s'il est permis à sa date (articles 810-1, 810-2)";
    label en unofficial "Act done by the curator, to be classified as permitted on its date (Articles 810-1, 810-2)";
    ActePurementConservatoire,
    ActeDeSurveillance,
    AdministrationProvisoire,
    VenteDeBiensPerissables,
    ActeDAdministration,
    VenteDeBiensMeubles,
    VenteDeBiensImmeubles,
    VenteDUnBienDeConservationOnereuse
}

pub enum EtatDuPassif {
    label fr official "État du passif de la succession sous curatelle (article 810-2)";
    label en unofficial "State of the estate's liabilities under curatorship (Article 810-2)";
    PassifNonApure,
    PassifApure
}

pub enum DetteDeLaSuccession {
    label fr official "Dette de la succession, dont il faut dire si elle se paie sans attendre le projet de règlement (article 810-4)";
    label en unofficial "Debt of the estate, to be classified as payable before the settlement plan (Article 810-4)";
    FraisDeConservationDuPatrimoine,
    FraisFuneraires,
    FraisDeDerniereMaladie,
    ImpotsDusParLeDefunt,
    LoyersDeLaSuccession,
    DetteSuccessoraleUrgente,
    AutreDetteSuccessorale
}

pub enum QualiteDuCreancier {
    label fr official "Qualité du créancier ou du légataire dans le projet de règlement du passif (articles 796, 810-5)";
    label en unofficial "Capacity of the creditor or legatee in the liability settlement plan (Articles 796, 810-5)";
    CreancierInscrit,
    CreancierDeclare,
    LegataireDeSommeDArgent
}

pub enum CauseDeFinDeCuratelle {
    label fr official "Cause de cessation de la curatelle (article 810-12)";
    label en unofficial "Ground on which the curatorship ends (Article 810-12)";
    AffectationIntegraleDeLActif,
    RealisationTotaleEtConsignation,
    RestitutionAuxHeritiersReconnus,
    EnvoiEnPossessionDeLEtat,
    AutreCirconstanceDeLaCuratelle
}

pub enum CauseDeFinDuMandat {
    label fr official "Cause d'extinction du mandat à effet posthume (article 812-4)";
    label en unofficial "Ground on which the posthumous mandate ends (Article 812-4)";
    ArriveeDuTermePrevu,
    RenonciationDuMandataire,
    RevocationJudiciaire,
    MandatConventionnelEntreLesHeritiersEtLeMandataire,
    AlienationDesBiensParLesHeritiers,
    DisparitionDuMandataire,
    DecesDeLHeritierInteresse,
    AutreCirconstanceDuMandat
}

pub enum MotifDeDesignation {
    label fr official "Motif justifiant la désignation judiciaire d'un mandataire successoral (article 813-1)";
    label en unofficial "Ground justifying the judicial appointment of an estate administrator (Article 813-1)";
    InertieDesHeritiers,
    CarenceDesHeritiers,
    FauteDesHeritiers,
    MesententeEntreLesHeritiers,
    OppositionDInteretsEntreLesHeritiers,
    ComplexiteDeLaSituationSuccessorale,
    AucunMotifParticulier
}

// --- Entrées du cas : la vacance et la curatelle -----------------------------------------------

pub relation aucun_reclamant_ni_heritier_connu_constate(s: Succession) kind empirical {
    origin adjudicated;
    label fr official "il est constaté que personne ne se présente pour réclamer la succession et qu'il n'y a pas d'héritier connu (article 809, 1°)";
    label en unofficial "it is established that nobody claims the estate and that no heir is known (Article 809, 1°)";
}
pub relation nombre_d_heritiers_connus(s: Succession, n: Integer) kind empirical {
    key(s);
    label fr official "nombre d'héritiers connus de la succession (article 809, 2°)";
    label en unofficial "number of known heirs of the estate (Article 809, 2°)";
}
pub relation nombre_d_heritiers_connus_renoncants(s: Succession, n: Integer) kind empirical {
    key(s);
    label fr official "nombre d'héritiers connus ayant renoncé à la succession (article 809, 2°)";
    label en unofficial "number of known heirs who renounced the estate (Article 809, 2°)";
}
pub relation aucune_option_des_heritiers_connus_constatee(s: Succession) kind empirical {
    origin adjudicated;
    label fr official "il est constaté qu'aucun héritier connu n'a opté, de manière tacite ou expresse (article 809, 3°)";
    label en unofficial "it is established that no known heir has opted, tacitly or expressly (Article 809, 3°)";
}
pub relation date_d_appreciation_de_la_curatelle(s: Succession, jour: Date) kind empirical {
    key(s);
    label fr official "jour auquel la situation de la succession vacante est appréciée";
    label en unofficial "day on which the vacant estate's situation is assessed";
}
pub relation requete_presentee_par(s: Succession, demandeur: Personne, qualite: QualiteDuRequerant) kind empirical {
    key(s, demandeur);
    label fr official "requête en curatelle présentée au juge par cette personne en cette qualité (article 809-1)";
    label en unofficial "application for curatorship brought before the judge by this person in this capacity (Article 809-1)";
}
pub relation saisie_curatelle_exercee(s: Succession, demandeur: Personne) kind empirical {
    label fr official "saisine du juge aux fins de curatelle exercée";
    label en unofficial "curatorship application exercised";
}
pub relation juge_saisi_d_une_demande_de_curatelle(s: Succession, demandeur: Personne) kind institutional {
    label fr official "le juge est saisi d'une demande de curatelle de la succession (article 809-1)";
    label en unofficial "the judge is seised of an application for curatorship of the estate (Article 809-1)";
}
pub relation autorite_administrative_succession(s: Succession, p: Personne) kind empirical {
    label fr official "autorité administrative chargée du domaine";
    label en unofficial "administrative authority in charge of State property";
}
pub relation acte_apres_fin_mission_exerce(s: Succession, p: Personne) kind empirical {
    label fr official "acte accompli après la fin de la mission du mandataire successoral";
    label en unofficial "act performed after the estate administrator's mission ended";
}
pub relation acte_apres_fin_mission_interdit(s: Succession, p: Personne) kind empirical {
    label fr official "acte interdit après la fin de la mission du mandataire successoral";
    label en unofficial "act prohibited after the estate administrator's mission ended";
}
pub relation compte_rendu_gestion_exerce(m: Mandat, p: Personne) kind empirical {
    label fr official "compte rendu de gestion du mandataire exercé";
    label en unofficial "agent's management account rendered";
}
pub relation renonciation_notifiee_exercee(m: Mandat, p: Personne) kind empirical {
    label fr official "notification de la renonciation du mandataire exercée";
    label en unofficial "agent's renunciation notification exercised";
}
pub relation administration_confiee_exercee(s: Succession, p: Personne) kind empirical {
    label fr official "administration de la succession confiée par accord exercée";
    label en unofficial "agreed entrustment of estate administration exercised";
}
pub relation administration_de_la_succession_confiee(s: Succession, p: Personne) kind institutional {
    label fr official "l'administration de la succession est confiée d'un commun accord à la personne désignée (article 813)";
    label en unofficial "administration of the estate is entrusted by common agreement to the person designated (Article 813)";
}
pub relation inventaire_estimatif_dresse(s: Succession) kind empirical {
    label fr official "l'inventaire estimatif article par article de l'actif et du passif a été dressé (article 809-2)";
    label en unofficial "the itemised valuation inventory of assets and liabilities has been drawn up (Article 809-2)";
}
pub relation curateur_succession(s: Succession, p: Personne) kind empirical {
    label fr official "curateur de la succession";
    label en unofficial "estate curator";
}
pub relation inventaire_exerce(s: Succession, p: Personne) kind empirical {
    label fr official "établissement de l'inventaire exercé";
    label en unofficial "inventory preparation exercised";
}
pub relation titre_justifie(s: Succession, p: Personne) kind empirical {
    label fr official "le créancier ou le légataire de somme d'argent justifie de son titre (article 809-2, alinéa 3)";
    label en unofficial "the creditor or money legatee produces evidence of their title (Article 809-2, paragraph 3)";
}
pub relation acte_du_curateur_le(s: Succession, acte: ActeDuCurateur, jour: Date) kind empirical {
    label fr official "acte accompli par le curateur ce jour (articles 810-1, 810-2)";
    label en unofficial "act done by the curator on this day (Articles 810-1, 810-2)";
}
pub relation acte_conservatoire_exerce(s: Succession, p: Personne) kind empirical {
    label fr official "acte conservatoire du curateur exercé";
    label en unofficial "curator conservatory act exercised";
}
pub relation mandataire_motif(s: Succession, p: Personne) kind empirical {
    label fr official "motif de désignation du mandataire successoral";
    label en unofficial "ground for estate administrator appointment";
}
pub relation designation_mandataire_exercee(s: Succession, p: Personne) kind empirical {
    label fr official "désignation du mandataire successoral exercée";
    label en unofficial "estate administrator appointment exercised";
}
pub relation mandataire_successoral_admis(s: Succession, p: Personne) kind derived {
    label fr official "mandataire successoral désigné par le juge";
    label en unofficial "estate administrator appointed by the judge";
}
pub relation etat_du_passif(s: Succession, etat: EtatDuPassif) kind empirical {
    key(s);
    label fr official "le passif de la succession est apuré ou ne l'est pas (article 810-2)";
    label en unofficial "the estate's liabilities are discharged or are not (Article 810-2)";
}
pub relation adjudication_exigee_par(s: Succession, creancier: Personne) kind empirical {
    label fr official "un créancier exige que la vente amiable envisagée soit faite par adjudication (article 810-3, alinéa 3)";
    label en unofficial "a creditor requires that the intended private sale be made by auction (Article 810-3, paragraph 3)";
}
pub relation prix_convenu_dans_le_projet(s: Succession, montant: Money) kind empirical {
    key(s);
    label fr official "prix convenu dans le projet de vente amiable (article 810-3, alinéa 3)";
    label en unofficial "price agreed in the intended private sale (Article 810-3, paragraph 3)";
}
pub relation prix_de_l_adjudication(s: Succession, montant: Money) kind empirical {
    key(s);
    label fr official "prix obtenu par l'adjudication (article 810-3, alinéa 3)";
    label en unofficial "price obtained at auction (Article 810-3, paragraph 3)";
}
pub relation dette_a_payer(s: Succession, dette: DetteDeLaSuccession) kind empirical {
    label fr official "dette dont le paiement est envisagé par le curateur (article 810-4)";
    label en unofficial "debt whose payment the curator contemplates (Article 810-4)";
}
pub relation actif_de_la_succession(s: Succession, montant: Money) kind empirical {
    key(s);
    label fr official "montant de l'actif de la succession sous curatelle (article 810-4, alinéa 1)";
    label en unofficial "amount of the assets of the estate under curatorship (Article 810-4, paragraph 1)";
}
pub relation passif_declare(s: Succession, montant: Money) kind empirical {
    key(s);
    label fr official "montant des dettes déclarées au curateur (articles 809-3, 810-4)";
    label en unofficial "amount of the debts declared to the curator (Articles 809-3, 810-4)";
}
pub relation qualite_du_creancier(s: Succession, creancier: Personne, qualite: QualiteDuCreancier) kind empirical {
    key(s, creancier);
    label fr official "qualité en laquelle le créancier ou le légataire figure au projet de règlement (articles 796, 810-5)";
    label en unofficial "capacity in which the creditor or legatee appears in the settlement plan (Articles 796, 810-5)";
}
pub relation rang_de_la_surete(s: Succession, creancier: Personne, rang: Integer) kind empirical {
    key(s, creancier);
    label fr official "rang de la sûreté assortissant la créance inscrite (article 796, alinéa 2)";
    label en unofficial "rank of the security attached to the registered claim (Article 796, paragraph 2)";
}
pub relation ordre_de_la_declaration(s: Succession, creancier: Personne, numero: Integer) kind empirical {
    key(s, creancier);
    label fr official "numéro d'ordre de la déclaration de créance (article 796, alinéa 3)";
    label en unofficial "sequence number of the claim declaration (Article 796, paragraph 3)";
}
pub relation projet_de_reglement_publie_le(s: Succession, jour: Date) kind empirical {
    key(s);
    label fr official "jour de la publicité du projet de règlement du passif (article 810-5, alinéa 3)";
    label en unofficial "day the liability settlement plan was published (Article 810-5, paragraph 3)";
}
pub relation creancier_non_integralement_desinteresse(s: Succession, creancier: Personne) kind empirical {
    label fr official "le créancier n'est pas intégralement désintéressé par le projet de règlement (article 810-5, alinéa 3)";
    label en unofficial "the creditor is not fully paid under the settlement plan (Article 810-5, paragraph 3)";
}
pub relation saisine_contre_le_projet_le(s: Succession, creancier: Personne, jour: Date) kind empirical {
    key(s, creancier);
    label fr official "jour où le créancier saisit le juge pour contester le projet de règlement (article 810-5, alinéa 3)";
    label en unofficial "day the creditor applies to the judge against the settlement plan (Article 810-5, paragraph 3)";
}
pub relation compte_remis_le(s: Succession, jour: Date) kind empirical {
    key(s);
    label fr official "jour de la remise du compte des opérations du curateur (articles 810-7, 810-9)";
    label en unofficial "day the curator's account of operations was delivered (Articles 810-7, 810-9)";
}
pub relation notification_du_projet_de_realisation_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour de la notification du projet de réalisation à l'héritier connu (article 810-8)";
    label en unofficial "day the plan for realising the remaining assets was notified to the known heir (Article 810-8)";
}
pub relation reclamation_de_la_succession_le(s: Succession, h: Personne, jour: Date) kind empirical {
    key(s, h);
    label fr official "jour où l'héritier s'oppose à la réalisation en réclamant la succession (article 810-8)";
    label en unofficial "day the heir objects to the realisation by claiming the estate (Article 810-8)";
}
pub relation realisation_de_l_actif_subsistant_le(s: Succession, jour: Date) kind empirical {
    key(s);
    label fr official "jour de la réalisation de la totalité de l'actif subsistant (articles 810-8, 810-9)";
    label en unofficial "day the whole remaining asset was realised (Articles 810-8, 810-9)";
}
pub relation legataire_rempli_de_ses_droits(s: Succession, p: Personne) kind empirical {
    label fr official "le légataire a été rempli de ses droits (article 810-9, alinéa 1)";
    label en unofficial "the legatee has received their entitlement in full (Article 810-9, paragraph 1)";
}
pub relation recours_contre_les_legataires_le(s: Succession, creancier: Personne, jour: Date) kind empirical {
    key(s, creancier);
    label fr official "jour où le créancier exerce son recours contre les légataires remplis (article 810-9, alinéa 2)";
    label en unofficial "day the creditor brings their claim against the legatees paid in full (Article 810-9, paragraph 2)";
}
pub relation cause_de_fin_de_la_curatelle(s: Succession, cause: CauseDeFinDeCuratelle) kind empirical {
    label fr official "cause invoquée pour mettre fin à la curatelle (article 810-12)";
    label en unofficial "ground relied on to end the curatorship (Article 810-12)";
}

// --- Entrées du cas : la déshérence ------------------------------------------------------------

pub relation etat_pretend_a_la_succession(s: Succession) kind empirical {
    label fr official "l'État prétend à la succession d'une personne décédée sans héritier ou à une succession abandonnée (article 811)";
    label en unofficial "the State claims the estate of a person who died without heirs, or an abandoned estate (Article 811)";
}
pub relation envoi_en_possession_demande_au_tribunal(s: Succession) kind empirical {
    label fr official "l'État a demandé l'envoi en possession au tribunal (article 811)";
    label en unofficial "the State has applied to the court for possession (Article 811)";
}
pub relation etat_demandeur_envoi(s: Succession, p: Personne) kind empirical {
    label fr official "État demandant l'envoi en possession";
    label en unofficial "State applying for possession";
}
pub relation formalites_de_l_etat_omises_constatees(s: Succession) kind empirical {
    origin adjudicated;
    label fr official "il est constaté que l'État n'a pas accompli les formalités qui lui incombent (article 811-3)";
    label en unofficial "it is established that the State failed to complete the formalities incumbent on it (Article 811-3)";
}
pub relation heritier_se_presente(s: Succession, h: Personne) kind empirical {
    label fr official "un héritier se présente après l'envoi en possession de l'État (articles 811-2, 811-3)";
    label en unofficial "an heir comes forward after the State was put in possession (Articles 811-2, 811-3)";
}

// --- Entrées du cas : le mandat à effet posthume ------------------------------------------------

pub relation mandat_de_la_succession(m: Mandat, s: Succession) kind empirical {
    key(m);
    label fr official "succession sur laquelle porte le mandat à effet posthume (article 812)";
    label en unofficial "estate to which the posthumous mandate relates (Article 812)";
}
pub relation mandataire_designe(m: Mandat, p: Personne) kind empirical {
    label fr official "personne à laquelle le mandat à effet posthume est donné (article 812)";
    label en unofficial "person to whom the posthumous mandate is given (Article 812)";
}
pub relation heritier_vise_par_le_mandat(m: Mandat, h: Personne) kind empirical {
    label fr official "héritier identifié pour le compte et dans l'intérêt duquel le mandat est donné (article 812)";
    label en unofficial "identified heir for whose account and in whose interest the mandate is given (Article 812)";
}
pub relation nombre_d_heritiers_vises(m: Mandat, n: Integer) kind empirical {
    key(m);
    label fr official "nombre d'héritiers visés par le mandat (article 812-4, dernier alinéa)";
    label en unofficial "number of heirs covered by the mandate (Article 812-4, last paragraph)";
}
pub relation mandataire_jouit_de_la_pleine_capacite_civile(m: Mandat) kind empirical {
    label fr official "le mandataire jouit de la pleine capacité civile (article 812, alinéa 3)";
    label en unofficial "the agent has full civil capacity (Article 812, paragraph 3)";
}
pub relation biens_professionnels_compris(m: Mandat) kind empirical {
    label fr official "des biens professionnels sont compris dans le patrimoine successoral (article 812, alinéa 3)";
    label en unofficial "professional assets are included in the estate (Article 812, paragraph 3)";
}
pub relation mandataire_frappe_d_une_interdiction_de_gerer(m: Mandat) kind empirical {
    label fr official "le mandataire est frappé d'une interdiction de gérer (article 812, alinéa 3)";
    label en unofficial "the agent is barred from managing (Article 812, paragraph 3)";
}
pub relation mandataire_est_le_notaire_charge_du_reglement(m: Mandat) kind empirical {
    label fr official "le mandataire est le notaire chargé du règlement de la succession (article 812, alinéa 4)";
    label en unofficial "the agent is the notary in charge of settling the estate (Article 812, paragraph 4)";
}
pub relation motivation_precise_du_mandat(m: Mandat) kind empirical {
    label fr official "le mandat est précisément motivé (article 812-1-1, alinéa 1)";
    label en unofficial "the mandate states its grounds precisely (Article 812-1-1, paragraph 1)";
}
pub relation forme_authentique(m: Mandat) kind empirical {
    label fr official "le mandat est donné et accepté en la forme authentique (article 812-1-1, alinéa 3)";
    label en unofficial "the mandate is given and accepted in authentic form (Article 812-1-1, paragraph 3)";
}
pub relation accepte_avant_le_deces_du_mandant(m: Mandat) kind empirical {
    label fr official "le mandat a été accepté par le mandataire avant le décès du mandant (article 812-1-1, alinéa 4)";
    label en unofficial "the mandate was accepted by the agent before the principal's death (Article 812-1-1, paragraph 4)";
}
pub relation mandat_donne_le(m: Mandat, jour: Date) kind empirical {
    key(m);
    label fr official "jour où le mandat prend effet (article 812-1-1, alinéa 2)";
    label en unofficial "day on which the mandate takes effect (Article 812-1-1, paragraph 2)";
}
pub relation terme_prevu_le(m: Mandat, jour: Date) kind empirical {
    key(m);
    label fr official "terme prévu par le mandat (articles 812-1-1, 812-4, 1°)";
    label en unofficial "term set by the mandate (Articles 812-1-1, 812-4, 1°)";
}
pub relation inaptitude_age_ou_biens_professionnels(m: Mandat) kind empirical {
    label fr official "l'inaptitude ou l'âge du ou des héritiers, ou la nécessité de gérer des biens professionnels, est invoquée (article 812-1-1, alinéa 2)";
    label en unofficial "the heirs' incapacity or age, or the need to manage professional assets, is relied on (Article 812-1-1, paragraph 2)";
}
pub relation remuneration_prevue_au_mandat(m: Mandat) kind empirical {
    label fr official "le mandat prévoit une rémunération (article 812-2)";
    label en unofficial "the mandate provides for remuneration (Article 812-2)";
}
pub relation remuneration_expressement_determinee(m: Mandat) kind empirical {
    label fr official "la rémunération est expressément déterminée dans le mandat (article 812-2, alinéa 2)";
    label en unofficial "the remuneration is expressly fixed in the mandate (Article 812-2, paragraph 2)";
}
pub relation remuneration_privant_de_la_reserve(m: Mandat) kind empirical {
    label fr official "la rémunération a pour effet de priver les héritiers de tout ou partie de leur réserve (article 812-3)";
    label en unofficial "the remuneration deprives the heirs of all or part of their reserved share (Article 812-3)";
}
pub relation cause_de_fin_du_mandat(m: Mandat, cause: CauseDeFinDuMandat) kind empirical {
    label fr official "cause d'extinction invoquée contre le mandat (article 812-4)";
    label en unofficial "ground of extinction relied on against the mandate (Article 812-4)";
}
pub relation cause_propre_a_un_seul_heritier(m: Mandat, h: Personne) kind empirical {
    label fr official "la cause d'extinction ne concerne que cet héritier (article 812-4, dernier alinéa)";
    label en unofficial "the ground of extinction concerns only this heir (Article 812-4, last paragraph)";
}
pub relation revocation_pour_disparition_de_l_interet(m: Mandat) kind empirical {
    label fr official "la révocation est intervenue pour disparition de l'intérêt sérieux et légitime (article 812-5, alinéa 1)";
    label en unofficial "the revocation was ordered because the serious and legitimate interest disappeared (Article 812-5, paragraph 1)";
}
pub relation revocation_pour_mauvaise_execution(m: Mandat) kind empirical {
    label fr official "la révocation est intervenue en raison d'une mauvaise exécution de la mission (article 812-5, alinéa 2)";
    label en unofficial "the revocation was ordered because the agent performed the mission badly (Article 812-5, paragraph 2)";
}
pub relation renonciation_notifiee_le(m: Mandat, jour: Date) kind empirical {
    key(m);
    label fr official "jour de la notification aux héritiers intéressés de la renonciation du mandataire (article 812-6)";
    label en unofficial "day the agent's renunciation was notified to the interested heirs (Article 812-6)";
}
pub relation convention_contraire_sur_la_renonciation(m: Mandat) kind empirical {
    label fr official "une convention contraire règle la prise d'effet de la renonciation (article 812-6, alinéa 2)";
    label en unofficial "an agreement to the contrary governs when the renunciation takes effect (Article 812-6, paragraph 2)";
}
pub relation compte_rendu_annuel_omis_constate(m: Mandat) kind empirical {
    origin adjudicated;
    label fr official "il est constaté que le mandataire n'a pas rendu compte de sa gestion (article 812-7)";
    label en unofficial "it is established that the agent did not account for their management (Article 812-7)";
}

// --- Entrées du cas : le mandataire successoral --------------------------------------------------

pub relation administration_confiee_d_un_commun_accord(s: Succession, p: Personne) kind empirical {
    label fr official "les héritiers ont confié d'un commun accord l'administration de la succession à cette personne (article 813, alinéa 1)";
    label en unofficial "the heirs jointly entrusted the administration of the estate to this person (Article 813, paragraph 1)";
}
pub relation motif_de_designation(s: Succession, motif: MotifDeDesignation) kind empirical {
    label fr official "motif invoqué à l'appui de la désignation judiciaire d'un mandataire successoral (article 813-1)";
    label en unofficial "ground relied on for the judicial appointment of an estate administrator (Article 813-1)";
}
pub relation convention_d_indivision_conclue(s: Succession) kind empirical {
    label fr official "une convention d'indivision a été conclue entre les héritiers (article 813-9, alinéa 2)";
    label en unofficial "the heirs concluded a joint-ownership agreement (Article 813-9, paragraph 2)";
}
pub relation execution_complete_constatee(s: Succession) kind empirical {
    origin adjudicated;
    label fr official "le juge constate l'exécution complète de la mission confiée au mandataire successoral (article 813-9, alinéa 2)";
    label en unofficial "the judge finds that the estate administrator's mission has been fully performed (Article 813-9, paragraph 2)";
}
pub relation manquement_caracterise_constate(s: Succession, p: Personne) kind empirical {
    origin adjudicated;
    label fr official "il est constaté un manquement caractérisé du mandataire successoral dans l'exercice de sa mission (article 813-7)";
    label en unofficial "a characterised breach by the estate administrator in performing the mission is established (Article 813-7)";
}

// --- Appréciations déléguées au juge (§47.3, DECISION-0194) --------------------------------------

@source(CC_ART812_1_1)
pub external judgment relation interet_serieux_et_legitime(m: Mandat) {
    authority Court;
    label fr official "le mandat est justifié par un intérêt sérieux et légitime au regard de la personne de l'héritier ou du patrimoine successoral (article 812-1-1)";
    label en unofficial "the mandate is justified by a serious and legitimate interest in the heir or in the estate (Article 812-1-1)";
}

@source(CC_ART812_3, CC_ART812_5)
pub external judgment relation remuneration_excessive(m: Mandat) {
    authority Court;
    label fr official "la rémunération est excessive au regard de la durée ou de la charge résultant du mandat (articles 812-3, 812-5)";
    label en unofficial "the remuneration is excessive in view of the duration or burden of the mandate (Articles 812-3, 812-5)";
}

// --- Résultats : la vacance et la curatelle --------------------------------------------------

pub relation succession_vacante(s: Succession) kind derived {
    label fr official "la succession est vacante (article 809)";
    label en unofficial "the estate is vacant (Article 809)";
}
pub relation fin_du_delai_de_six_mois(s: Succession, jour: Date) kind derived {
    key(s);
    label fr official "dernier jour des six mois qui suivent l'ouverture de la succession (articles 809, 3°, 810-1)";
    label en unofficial "last day of the six months following the opening of the succession (Articles 809, 3°, 810-1)";
}
pub relation requete_recevable(s: Succession, demandeur: Personne) kind derived {
    label fr official "la requête en curatelle émane d'une personne qualifiée (article 809-1)";
    label en unofficial "the application for curatorship comes from a qualified person (Article 809-1)";
}
pub relation curatelle_confiee_a_l_autorite_du_domaine(s: Succession) kind derived {
    label fr official "la curatelle de la succession vacante est confiée à l'autorité administrative chargée du domaine (article 809-1)";
    label en unofficial "the curatorship of the vacant estate is entrusted to the administrative authority in charge of State property (Article 809-1)";
}
pub relation inventaire_estimatif_requis(s: Succession) kind derived {
    label fr official "le curateur doit faire dresser l'inventaire estimatif (article 809-2)";
    label en unofficial "the curator must have the valuation inventory drawn up (Article 809-2)";
}
pub relation consultation_de_l_inventaire_ouverte(s: Succession, p: Personne) kind derived {
    label fr official "le créancier ou le légataire de somme d'argent peut consulter l'inventaire et en obtenir copie (article 809-2, alinéa 3)";
    label en unofficial "the creditor or money legatee may consult the inventory and obtain a copy (Article 809-2, paragraph 3)";
}
pub relation inventaire_consulte(s: Succession, p: Personne) kind institutional {
    label fr official "le créancier ou le légataire de somme d'argent a consulté l'inventaire ou en a obtenu copie (article 809-2, alinéa 3)";
    label en unofficial "the creditor or legatee of a sum of money has consulted the inventory or obtained a copy (Article 809-2, paragraph 3)";
}
pub relation acte_du_curateur_permis(s: Succession, acte: ActeDuCurateur) kind derived {
    label fr official "l'acte est au nombre de ceux que le curateur peut accomplir à cette date (articles 810-1, 810-2)";
    label en unofficial "the act is one the curator may perform on that date (Articles 810-1, 810-2)";
}
pub relation acte_du_curateur_accompli(s: Succession, acte: ActeDuCurateur) kind institutional {
    label fr official "le curateur a accompli l'acte au nombre de ceux qu'il peut accomplir à cette date (articles 810-1, 810-2)";
    label en unofficial "the curator has performed an act among those he may perform on that date (Articles 810-1, 810-2)";
}
pub relation acte_du_curateur_interdit(s: Succession, acte: ActeDuCurateur) kind derived {
    label fr official "l'acte excède les pouvoirs du curateur à cette date (articles 810-1, 810-2)";
    label en unofficial "the act exceeds the curator's powers on that date (Articles 810-1, 810-2)";
}
@source(CC_ART810_3)
pub relation adjudication_obligatoire(s: Succession) kind derived {
    label fr official "la vente doit être faite par adjudication (article 810-3, alinéa 3)";
    label en unofficial "the sale must be made by auction (Article 810-3, paragraph 3)";
}
pub relation perte_supportee_par_le_creancier(s: Succession, creancier: Personne, montant: Money) kind derived {
    label fr official "perte dont le créancier qui a demandé l'adjudication est tenu envers les autres créanciers (article 810-3, alinéa 3)";
    label en unofficial "loss borne, towards the other creditors, by the creditor who required the auction (Article 810-3, paragraph 3)";
}
pub relation curateur_seul_habilite_a_payer(s: Succession) kind derived {
    label fr official "le curateur est seul habilité à payer les créanciers de la succession (article 810-4, alinéa 1)";
    label en unofficial "only the curator may pay the estate's creditors (Article 810-4, paragraph 1)";
}
pub relation dettes_acquittees_jusqu_a_concurrence(s: Succession, montant: Money) kind derived {
    key(s);
    label fr official "montant jusqu'à concurrence duquel le curateur est tenu d'acquitter les dettes (article 810-4, alinéa 1)";
    label en unofficial "amount up to which the curator must discharge the debts (Article 810-4, paragraph 1)";
}
pub relation paiement_immediat_permis(s: Succession, dette: DetteDeLaSuccession) kind derived {
    label fr official "la dette peut être payée sans attendre le projet de règlement du passif (article 810-4, alinéa 2)";
    label en unofficial "the debt may be paid without awaiting the settlement plan (Article 810-4, paragraph 2)";
}
pub relation dette_payee_sans_attendre_le_projet(s: Succession, dette: DetteDeLaSuccession) kind institutional {
    label fr official "la dette est payée sans attendre le projet de règlement du passif (article 810-4, alinéa 2)";
    label en unofficial "the debt is paid without waiting for the draft settlement of liabilities (Article 810-4, paragraph 2)";
}
@source(CC_ART810_4)
pub relation paiement_subordonne_au_projet(s: Succession, dette: DetteDeLaSuccession) kind derived {
    label fr official "la dette ne peut être payée qu'au vu du projet de règlement du passif (article 810-4, alinéa 2)";
    label en unofficial "the debt may be paid only under the settlement plan (Article 810-4, paragraph 2)";
}
pub relation classe_de_paiement(s: Succession, creancier: Personne, classe: Integer) kind derived {
    key(s, creancier);
    label fr official "rang de la classe dans laquelle le créancier ou le légataire est payé (article 796)";
    label en unofficial "rank of the class in which the creditor or legatee is paid (Article 796)";
}
pub relation paye_avant(s: Succession, premier: Personne, second: Personne) kind derived {
    label fr official "le projet de règlement paie le premier avant le second (articles 796, 810-5)";
    label en unofficial "the settlement plan pays the first before the second (Articles 796, 810-5)";
}
pub relation fin_du_delai_de_contestation_du_projet(s: Succession, jour: Date) kind derived {
    key(s);
    label fr official "dernier jour du mois suivant la publicité du projet de règlement (article 810-5, alinéa 3)";
    label en unofficial "last day of the month following publication of the settlement plan (Article 810-5, paragraph 3)";
}
pub relation contestation_du_projet_recevable(s: Succession, creancier: Personne) kind derived {
    label fr official "la contestation du projet de règlement est recevable (article 810-5, alinéa 3)";
    label en unofficial "the challenge to the settlement plan is admissible (Article 810-5, paragraph 3)";
}
pub relation projet_de_reglement_conteste(s: Succession, creancier: Personne) kind institutional {
    label fr official "le créancier non désintéressé a contesté le projet de règlement du passif (article 810-5, alinéa 3)";
    label en unofficial "the unpaid creditor has contested the draft settlement of liabilities (Article 810-5, paragraph 3)";
}
pub relation contestation_du_projet_tardive(s: Succession, creancier: Personne) kind derived {
    label fr official "la contestation du projet de règlement est tardive (article 810-5, alinéa 3)";
    label en unofficial "the challenge to the settlement plan is out of time (Article 810-5, paragraph 3)";
}
pub relation fin_du_delai_d_opposition_a_la_realisation(s: Succession, h: Personne, jour: Date) kind derived {
    key(s, h);
    label fr official "dernier jour des trois mois pour s'opposer à la réalisation en réclamant la succession (article 810-8)";
    label en unofficial "last day of the three months to object to the realisation by claiming the estate (Article 810-8)";
}
pub relation opposition_a_la_realisation_recevable(s: Succession, h: Personne) kind derived {
    label fr official "l'opposition de l'héritier à la réalisation est recevable (article 810-8)";
    label en unofficial "the heir's objection to the realisation is admissible (Article 810-8)";
}
pub relation opposition_a_la_realisation_formee(s: Succession, h: Personne) kind institutional {
    label fr official "l'héritier s'est opposé à la réalisation en réclamant la succession (article 810-8)";
    label en unofficial "the heir has opposed the sale by claiming the estate (Article 810-8)";
}
pub relation realisation_prematuree(s: Succession) kind derived {
    label fr official "la réalisation a eu lieu avant l'expiration du délai d'opposition (article 810-8)";
    label en unofficial "the realisation took place before the objection period expired (Article 810-8)";
}
@source(CC_ART810_9)
pub relation creancier_limite_a_l_actif_subsistant(s: Succession, creancier: Personne) kind derived {
    label fr official "le créancier qui déclare après la remise du compte ne peut prétendre qu'à l'actif subsistant (article 810-9, alinéa 1)";
    label en unofficial "a creditor declaring after the account is delivered may claim only the remaining assets (Article 810-9, paragraph 1)";
}
pub relation recours_contre_les_legataires_ouvert(s: Succession, creancier: Personne, legataire: Personne) kind derived {
    label fr official "le créancier tardif a un recours contre le légataire rempli de ses droits (article 810-9, alinéa 1)";
    label en unofficial "the late creditor has a claim against the legatee paid in full (Article 810-9, paragraph 1)";
}
pub relation fin_du_recours_contre_les_legataires(s: Succession, jour: Date) kind derived {
    key(s);
    label fr official "dernier jour des deux ans de prescription du recours contre les légataires (article 810-9, alinéa 2)";
    label en unofficial "last day of the two-year limitation of the claim against the legatees (Article 810-9, paragraph 2)";
}
pub relation recours_contre_les_legataires_prescrit(s: Succession, creancier: Personne) kind derived {
    label fr official "le recours du créancier contre les légataires est prescrit (article 810-9, alinéa 2)";
    label en unofficial "the creditor's claim against the legatees is time-barred (Article 810-9, paragraph 2)";
}
pub relation curatelle_terminee(s: Succession) kind derived {
    label fr official "la curatelle prend fin (article 810-12)";
    label en unofficial "the curatorship ends (Article 810-12)";
}

// --- Résultats : la déshérence -------------------------------------------------------------

pub relation envoi_en_possession_a_demander(s: Succession) kind derived {
    label fr official "l'État doit demander l'envoi en possession au tribunal (article 811)";
    label en unofficial "the State must apply to the court to be put in possession (Article 811)";
}
pub relation inventaire_a_la_charge_de_l_autorite(s: Succession) kind derived {
    label fr official "l'autorité administrative fait procéder à l'inventaire qui n'a pas été établi (article 811-1)";
    label en unofficial "the administrative authority has the missing inventory drawn up (Article 811-1)";
}
pub relation desherence_terminee(s: Succession) kind derived {
    label fr official "la déshérence de la succession prend fin (article 811-2)";
    label en unofficial "the escheat of the estate ends (Article 811-2)";
}
pub relation etat_expose_a_des_dommages_et_interets(s: Succession) kind derived {
    label fr official "l'État peut être condamné à des dommages et intérêts envers les héritiers (article 811-3)";
    label en unofficial "the State may be ordered to pay damages to the heirs (Article 811-3)";
}
pub relation dommages_et_interets_demandes_a_l_etat(s: Succession) kind institutional {
    label fr official "les héritiers ont demandé la condamnation de l'État à des dommages et intérêts (article 811-3)";
    label en unofficial "the heirs have sought an award of damages against the State (Article 811-3)";
}

// --- Résultats : le mandat à effet posthume --------------------------------------------------

pub relation mandataire_apte(m: Mandat) kind derived {
    label fr official "le mandataire remplit les conditions de l'article 812";
    label en unofficial "the agent meets the conditions of Article 812";
}
pub relation mandataire_inapte(m: Mandat) kind derived {
    label fr official "le mandataire ne peut recevoir le mandat (article 812, alinéas 3 et 4)";
    label en unofficial "the agent cannot receive the mandate (Article 812, paragraphs 3 and 4)";
}
pub relation duree_maximale_du_mandat(m: Mandat, jour: Date) kind derived {
    key(m);
    label fr official "dernier jour de la durée maximale du mandat (article 812-1-1, alinéa 2)";
    label en unofficial "last day of the mandate's maximum duration (Article 812-1-1, paragraph 2)";
}
@source(CC_ART812_1_1)
pub relation duree_du_mandat_excessive(m: Mandat) kind derived {
    label fr official "le terme prévu excède la durée maximale du mandat (article 812-1-1, alinéa 2)";
    label en unofficial "the term set exceeds the mandate's maximum duration (Article 812-1-1, paragraph 2)";
}
pub relation mandat_valable(m: Mandat) kind derived {
    label fr official "le mandat à effet posthume est valable (articles 812, 812-1-1)";
    label en unofficial "the posthumous mandate is valid (Articles 812, 812-1-1)";
}
pub relation mandat_non_valable(m: Mandat) kind derived {
    label fr official "le mandat à effet posthume n'est pas valable (articles 812, 812-1-1)";
    label en unofficial "the posthumous mandate is not valid (Articles 812, 812-1-1)";
}
pub relation acceptation_d_un_heritier_vise(m: Mandat) kind derived {
    label fr official "un héritier visé par le mandat a accepté la succession (article 812-1-3)";
    label en unofficial "an heir covered by the mandate accepted the estate (Article 812-1-3)";
}
pub relation cause_limitee_a_un_heritier(m: Mandat) kind derived {
    label fr official "la cause d'extinction ne concerne qu'un héritier parmi plusieurs (article 812-4, dernier alinéa)";
    label en unofficial "the ground of extinction concerns only one of several heirs (Article 812-4, last paragraph)";
}
@source(CC_ART812_1_3)
pub relation pouvoirs_du_mandataire_limites_a_784(m: Mandat) kind derived {
    label fr official "tant qu'aucun héritier visé n'a accepté, le mandataire ne dispose que des pouvoirs de l'article 784 (article 812-1-3)";
    label en unofficial "until a covered heir accepts, the agent has only the powers of Article 784 (Article 812-1-3)";
}
pub relation mandat_gratuit(m: Mandat) kind derived {
    label fr official "le mandat est gratuit (article 812-2, alinéa 1)";
    label en unofficial "the mandate is gratuitous (Article 812-2, paragraph 1)";
}
pub relation remuneration_due(m: Mandat) kind derived {
    label fr official "la rémunération prévue est due au mandataire (article 812-2, alinéa 2)";
    label en unofficial "the remuneration provided for is owed to the agent (Article 812-2, paragraph 2)";
}
pub relation remuneration_reclamee_par_le_mandataire(m: Mandat) kind institutional {
    label fr official "le mandataire a réclamé la rémunération prévue (article 812-2, alinéa 2)";
    label en unofficial "the agent has claimed the agreed remuneration (Article 812-2, paragraph 2)";
}
pub relation reduction_de_la_remuneration_ouverte(m: Mandat) kind derived {
    label fr official "la rémunération ouvre droit à réduction (article 812-3)";
    label en unofficial "the remuneration gives rise to a right of abatement (Article 812-3)";
}
pub relation reduction_de_la_remuneration_demandee(m: Mandat) kind institutional {
    label fr official "les héritiers ont demandé en justice la réduction de la rémunération (article 812-3)";
    label en unofficial "the heirs have sought a court reduction of the remuneration (Article 812-3)";
}
pub relation revision_de_la_remuneration_ouverte(m: Mandat) kind derived {
    label fr official "les héritiers peuvent demander en justice la révision de la rémunération (article 812-3)";
    label en unofficial "the heirs may apply to the court to have the remuneration revised (Article 812-3)";
}
pub relation revision_de_la_remuneration_demandee(m: Mandat) kind institutional {
    label fr official "les héritiers ont demandé en justice la révision de la rémunération (article 812-3)";
    label en unofficial "the heirs have sought a court revision of the remuneration (Article 812-3)";
}
@source(CC_ART812_4)
pub relation mandat_termine(m: Mandat) kind derived {
    label fr official "le mandat à effet posthume prend fin (article 812-4)";
    label en unofficial "the posthumous mandate ends (Article 812-4)";
}
pub relation mandat_maintenu_pour_les_autres_heritiers(m: Mandat) kind derived {
    label fr official "le mandat ne cesse pas entièrement, la cause ne concernant qu'un héritier (article 812-4, dernier alinéa)";
    label en unofficial "the mandate does not end entirely, the ground concerning only one heir (Article 812-4, last paragraph)";
}
pub relation restitution_de_la_remuneration_possible(m: Mandat) kind derived {
    label fr official "le mandataire peut être tenu de restituer tout ou partie des sommes perçues (article 812-5)";
    label en unofficial "the agent may be required to return all or part of the sums received (Article 812-5)";
}
@source(CC_ART812_5)
pub relation restitution_exclue(m: Mandat) kind derived {
    label fr official "la révocation ne donne pas lieu à restitution de la rémunération (article 812-5, alinéa 1)";
    label en unofficial "the revocation does not give rise to a return of the remuneration (Article 812-5, paragraph 1)";
}
pub relation renonciation_effective_le(m: Mandat, jour: Date) kind derived {
    key(m);
    label fr official "jour où la renonciation du mandataire prend effet (article 812-6, alinéa 2)";
    label en unofficial "day the agent's renunciation takes effect (Article 812-6, paragraph 2)";
}
pub relation revocation_judiciaire_possible(m: Mandat) kind derived {
    label fr official "une révocation judiciaire peut être demandée par tout intéressé (article 812-7)";
    label en unofficial "any interested person may apply for judicial revocation (Article 812-7)";
}
