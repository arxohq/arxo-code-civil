language "law.core" version "0.2";
package examples.fr.code_civil.oecd_prescription_axis version "0.1.0";
namespace "urn:law:examples:fr:code-civil:oecd-prescription-axis";

case MemeDette1804 {
    context {
        legal_time @1804-03-21;
        knowledge_time @2015-01-01T12:00:00Z;
        decision_time @2015-01-01T12:00:00Z;
        timezone "UTC";
        deadline_policy OECD_CODE_CIVIL_1804_PRESCRIPTION;
    }
    assert "dette-1804-exigible": fr.code_civil_1804::creance_exigible_depuis(entity_ref("urn:fr:oecd:debt:2000"), @2000-01-01) { origin case_input; }
    assert "dette-1804-action": fr.code_civil_1804::action_introduite_le(entity_ref("urn:fr:oecd:debt:2000"), @2015-01-01) { origin case_input; }
    assert "dette-1804-sans-interruption": fr.code_civil_1804::prescription_non_interrompue(entity_ref("urn:fr:oecd:debt:2000")) { origin case_input; }
}
