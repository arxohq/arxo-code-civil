language "law.core" version "0.2";
package examples.fr.code_civil.faute_et_reparation version "0.1.0";
namespace "urn:law:examples:fr:code-civil:faute-et-reparation";
import fr.code_civil.responsabilite version "0.1.0";
import fr.code_civil version "0.1.0";

deadline policy OECD_CODE_CIVIL_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
