language "law.core" version "0.2";
package examples.fr.code_civil.une_famille_deux_siecles version "0.1.0";
namespace "urn:law:examples:fr:code-civil:une-famille-deux-siecles";

case DeuxEnfants_1804 {
    context {
        legal_time @1804-03-21;
        knowledge_time @1804-03-21T12:00:00Z;
        decision_time @1804-03-21T12:00:00Z;
        timezone "UTC";
        deadline_policy OECD_CODE_CIVIL_1804_PRESCRIPTION;
    }
    assert "mort": doctrine.ius_privatum::mortuus(entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
    assert "intestat": doctrine.ius_privatum::sine_testamento(entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
    assert "mariage": doctrine.ius_privatum::coniuges(entity_ref("urn:fr:cc-p11:d"), entity_ref("urn:fr:cc-p11:e")) { origin case_input; }
    assert "fils-c1": doctrine.ius_privatum::filius(entity_ref("urn:fr:cc-p11:c1"), entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
    assert "fils-c2": doctrine.ius_privatum::filius(entity_ref("urn:fr:cc-p11:c2"), entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
    assert "vit-e": fr.code_civil_1804::existe_a_l_ouverture(entity_ref("urn:fr:cc-p11:e"), entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
    assert "vit-c1": fr.code_civil_1804::existe_a_l_ouverture(entity_ref("urn:fr:cc-p11:c1"), entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
    assert "vit-c2": fr.code_civil_1804::existe_a_l_ouverture(entity_ref("urn:fr:cc-p11:c2"), entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
    assert "concourt": fr.code_civil_1804::concourt(entity_ref("urn:fr:cc-p11:c1"), entity_ref("urn:fr:cc-p11:c2"), entity_ref("urn:fr:cc-p11:d")) { origin case_input; }
}
