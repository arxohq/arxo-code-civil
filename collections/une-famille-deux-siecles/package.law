language "law.core" version "0.2";
package examples.fr.code_civil.une_famille_deux_siecles version "0.1.0";
namespace "urn:law:examples:fr:code-civil:une-famille-deux-siecles";

import fr.code_civil_1804 version "0.1.0";
import fr.code_civil.successions version "0.1.0";
import fr.code_civil.core version "0.1.0";
import fr.code_civil.transitions version "0.1.0";
import doctrine.ius_privatum version "0.1.0";

// Case packages resolve deadline policies locally (§86/§168.2).
deadline policy OECD_CODE_CIVIL_1804_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// FIVE FILES, ONE FAMILY.
//
// Widow, two sons; one son may predecease and leave a grandchild.
// Each fact pattern is read by the 1804 monument and by today's Code.
// An opening on 31 December 2006 is former law (loi 2006-728, art. 47):
// the package does not execute 1891, 1972 or 2001. The shares shown for
// that file are today's articles 757 and 753. Partition is not computed.
// No norm is written here.
