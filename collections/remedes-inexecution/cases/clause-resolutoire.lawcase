language "law.core" version "0.2";
package examples.fr.code_civil.remedes_inexecution version "0.1.0";
namespace "urn:law:examples:fr:code-civil:remedes-inexecution";

case ClauseResolutoire {
    context {
        deadline_policy fr.code_civil.contrat::CC_CONTRAT_MOIS;
        legal_time @2026-06-01;
        knowledge_time @2026-06-01T10:00:00Z;
        decision_time @2026-06-01T10:00:00Z;
        timezone "Europe/Paris";
    }
    assert "conclu": fr.code_civil.transitions::contrat_conclu_le(entity_ref("urn:fr:cc-p3:c"), @2019-03-01) { origin case_input; }
    assert "acte": fr.code_civil.transitions::acte_juridique_conclu_ou_etabli_le(entity_ref("urn:fr:cc-p3:c"), @2019-03-01) { origin case_input; }
    assert "art": fr.code_civil.transitions::article_invoque(entity_ref("urn:fr:cc-p3:c"), "1145") { origin case_input; }
    assert "accord": fr.code_civil.contrat::accord_de_volontes(entity_ref("urn:fr:cc-p3:c")) { origin case_input; }
    assert "possible": fr.code_civil.contrat::prestation_possible(entity_ref("urn:fr:cc-p3:c")) { origin case_input; }
    assert "determinee": fr.code_civil.contrat::prestation_determinee(entity_ref("urn:fr:cc-p3:c")) { origin case_input; }
    assert "partie": fr.code_civil.contrat::partie_au_contrat(entity_ref("urn:fr:cc-p3:c"), entity_ref("urn:fr:cc-p3:creancier")) { origin case_input; }
    assert "physique": fr.code_civil.contrat::personne_physique(entity_ref("urn:fr:cc-p3:creancier")) { origin case_input; }
    assert "consentement": fr.code_civil.contrat::consentement_donne_par(entity_ref("urn:fr:cc-p3:c"), entity_ref("urn:fr:cc-p3:creancier")) { origin case_input; }
    assert "esprit": fr.code_civil.contrat::sain_d_esprit(entity_ref("urn:fr:cc-p3:c"), entity_ref("urn:fr:cc-p3:creancier")) { origin case_input; }
    assert "oblig": fr.code_civil.contrat::obligation_du_contrat(entity_ref("urn:fr:cc-p3:o"), entity_ref("urn:fr:cc-p3:c")) { origin case_input; }
    assert "creancier": fr.code_civil.contrat::creancier_de_l_obligation(entity_ref("urn:fr:cc-p3:o"), entity_ref("urn:fr:cc-p3:creancier")) { origin case_input; }
    assert "debiteur": fr.code_civil.contrat::debiteur_de_l_obligation(entity_ref("urn:fr:cc-p3:o"), entity_ref("urn:fr:cc-p3:debiteur")) { origin case_input; }
    assert "inexec": fr.code_civil.contrat::engagement_non_execute(entity_ref("urn:fr:cc-p3:o")) { origin case_input; }
    assert "clause": fr.code_civil.contrat::clause_du_contrat(entity_ref("urn:fr:cc-p3:clause"), entity_ref("urn:fr:cc-p3:c")) { origin case_input; }
    assert "resolutoire": fr.code_civil.contrat::clause_resolutoire(entity_ref("urn:fr:cc-p3:clause")) { origin case_input; }
    assert "vise": fr.code_civil.contrat::clause_resolutoire_vise_l_engagement(entity_ref("urn:fr:cc-p3:clause"), entity_ref("urn:fr:cc-p3:o")) { origin case_input; }
    assert "dispense": fr.code_civil.contrat::dispense_conventionnelle_de_mise_en_demeure(entity_ref("urn:fr:cc-p3:clause")) { origin case_input; }
}
