language "law.core" version "0.2";
package examples.fr.code_civil.reserve_hereditaire version "0.1.0";
namespace "urn:law:examples:fr:code-civil:reserve-hereditaire";

import fr.code_civil.liberalites version "0.1.0";
import fr.code_civil.successions version "0.1.0";
import fr.code_civil.core version "0.1.0";
import calc.kinship version "0.1.0";

// The §86 policy is declared by the package that executes the case
// (LDC-E1332). These parameters repeat CC_LIBERALITES_CALENDRIER:
// same-day start, last day included, no roll to a business day.
deadline policy OECD_CODE_CIVIL_RESERVE {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// Six dossiers for the reserved-share calculator (plan 06, P6). Family
// composition and values belong to the cases; quotité, available value
// and reduction of a legacy come from the imported canon.
