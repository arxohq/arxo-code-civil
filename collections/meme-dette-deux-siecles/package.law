language "law.core" version "0.2";
package examples.fr.code_civil.meme_dette_deux_siecles version "0.1.0";
namespace "urn:law:examples:fr:code-civil:meme-dette-deux-siecles";

import fr.code_civil_1804 version "0.1.0";
import fr.code_civil version "0.1.0";
import doctrine.ius_privatum version "0.1.0";

// Case packages resolve deadline policies locally (§86/§168.2). Names
// mirror the imported canons and keep their boundary rules.
deadline policy OECD_CODE_CIVIL_1804_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

deadline policy OECD_CODE_CIVIL_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// Six dossiers: three fact patterns, each under the 1804 monument and
// under the living Code. Dates belong to the cases; conclusions come
// from the imported canons. The OECD axis collection remains its own
// showcase and is not imported here.
