language "law.core" version "0.2";
package examples.fr.code_civil.meme_dette_deux_siecles version "0.1.0";
namespace "urn:law:examples:fr:code-civil:meme-dette-deux-siecles";

case Dette2000Action2015_Actuel {
    context {
        legal_time @2015-01-01;
        knowledge_time @2015-01-01T12:00:00Z;
        decision_time @2015-01-01T12:00:00Z;
        timezone "UTC";
        deadline_policy OECD_CODE_CIVIL_PRESCRIPTION;
    }
    assert "exigible": fr.code_civil::creance_exigible_depuis(entity_ref("urn:fr:cc-p1:debt:2000"), @2000-01-01) { origin case_input; }
    assert "action": fr.code_civil::action_introduite_le(entity_ref("urn:fr:cc-p1:debt:2000"), @2015-01-01) { origin case_input; }
    assert "sans-interruption": fr.code_civil::prescription_non_interrompue(entity_ref("urn:fr:cc-p1:debt:2000")) { origin case_input; }
    assert "petitio": doctrine.ius_privatum::petitio(entity_ref("urn:fr:cc-p1:debt:2000"), entity_ref("urn:fr:cc-p1:creditor"), entity_ref("urn:fr:cc-p1:debtor")) { origin case_input; }
}
