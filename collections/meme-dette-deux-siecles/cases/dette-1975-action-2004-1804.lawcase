language "law.core" version "0.2";
package examples.fr.code_civil.meme_dette_deux_siecles version "0.1.0";
namespace "urn:law:examples:fr:code-civil:meme-dette-deux-siecles";

case Dette1975Action2004_1804 {
    context {
        legal_time @1804-03-21;
        knowledge_time @2004-01-01T12:00:00Z;
        decision_time @2004-01-01T12:00:00Z;
        timezone "UTC";
        deadline_policy OECD_CODE_CIVIL_1804_PRESCRIPTION;
    }
    assert "exigible": fr.code_civil_1804::creance_exigible_depuis(entity_ref("urn:fr:cc-p1:debt:1975"), @1975-01-01) { origin case_input; }
    assert "action": fr.code_civil_1804::action_introduite_le(entity_ref("urn:fr:cc-p1:debt:1975"), @2004-01-01) { origin case_input; }
    assert "sans-interruption": fr.code_civil_1804::prescription_non_interrompue(entity_ref("urn:fr:cc-p1:debt:1975")) { origin case_input; }
}
