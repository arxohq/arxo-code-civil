    context { legal_time @2026-06-01; knowledge_time @2026-06-01T10:00:00Z; decision_time @2026-06-01T10:00:00Z; timezone "Europe/Paris"; deadline_policy OECD_CODE_CIVIL_PRESCRIPTION; }
    assert "exigible": fr.code_civil::creance_exigible_depuis(entity_ref("urn:fr:dupont:pret"), @2020-01-01) { origin case_input; }
