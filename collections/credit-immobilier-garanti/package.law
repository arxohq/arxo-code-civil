language "law.core" version "0.2";
package examples.fr.code_civil.credit_immobilier_garanti version "0.1.0";
namespace "urn:law:examples:fr:code-civil:credit-immobilier-garanti";

import fr.code_civil.suretes version "0.1.0";
import fr.code_civil.transitions version "0.1.0";
import fr.code_civil.core version "0.1.0";
import fr.code_civil version "0.1.0";
import fr.code_civil.vente_louage version "0.1.0";

// Les politiques de délai sont résolues localement par les paquets-cas.
deadline policy OECD_CODE_CIVIL_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}
import calc.allocation version "0.1.0";

// UN SEUL DOSSIER, DEUX GÉNÉRATIONS DE CAUTIONNEMENT, UN ORDRE. La banque
// prête à la société Dupont ; Monsieur Dupont se porte caution en juin 2021,
// Madame Dupont en février 2023. Une hypothèque garantit le prêt ; à la vente
// de l'immeuble, le prix est distribué entre un salarié privilégié, la banque,
// un second créancier hypothécaire et un chirographaire. Aucune norme ici :
// le paquet-cas ne porte que les faits et les questions.
