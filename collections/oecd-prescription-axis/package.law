language "law.core" version "0.2";
package examples.fr.code_civil.oecd_prescription_axis version "0.1.0";
namespace "urn:law:examples:fr:code-civil:oecd-prescription-axis";

import fr.code_civil_1804 version "0.1.0";
import fr.code_civil version "0.1.0";
import doctrine.ius_privatum version "0.1.0";

// Case packages resolve deadline policies locally (§86/§168.2). These names
// deliberately mirror the two imported canons and keep their boundary rules.
deadline policy OECD_CODE_CIVIL_1804_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

deadline policy OECD_CODE_CIVIL_PRESCRIPTION {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// Un même litige (créance exigible en 2000, action en 2015) est relu sous
// l'article 2262 de 1804, sous la réforme de 2008, puis dans le vocabulaire
// comparatif de doctrine.ius_privatum. Les normes restent dans leurs paquets.
